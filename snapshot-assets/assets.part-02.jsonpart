on()||{}}catch{}const id=typeof data.id==='string'&&/^[0-9a-f-]{36}$/i.test(data.id)?data.id:null;const options={body:String(data.body||'Vous avez une nouvelle notification.').slice(0,500),icon:new URL('./monavenir-icon-192.png',ROOT).href,badge:new URL('./monavenir-icon-192.png',ROOT).href,tag:id||'monbac-notification',data:{id}};if(typeof data.image==='string'&&data.image.startsWith('https://'))options.image=data.image;await self.registration.showNotification(String(data.title||'monAvenir').slice(0,100),options)})())});\nself.addEventListener('notificationclick',event=>{event.notification.close();event.waitUntil((async()=>{const id=event.notification.data?.id,url=new URL(ROOT);if(id&&/^[0-9a-f-]{36}$/i.test(id))url.searchParams.set('notification',id);const clients=await self.clients.matchAll({type:'window',includeUncontrolled:true});const client=clients.find(c=>new URL(c.url).origin===url.origin);if(client){await client.focus();if(id)client.postMessage({type:'monbac-push-click',id});return}await self.clients.openWindow(url.href)})())});\nself.addEventListener('install',event=>event.waitUntil((async()=>{const c=await caches.open(CACHE);const urls=[...new Set(ASSETS)];const essential=new Set([ROOT,new URL('./app-2027.html',ROOT).href]);const save=async url=>{try{const res=await fetch(new Request(url,{cache:'reload'}));if(!res.ok)throw Error('HTTP '+res.status);await c.put(url,res)}catch(err){if(essential.has(url))throw err;console.warn('monAvenir shell asset skipped:',url,err)}};for(const u of essential)await save(u);for(let j=0;j<urls.length;j+=6)await Promise.all(urls.slice(j,j+6).filter(u=>!essential.has(u)).map(save));for(const u of OPTIONAL){const hit=await caches.match(u);if(hit)await c.put(u,hit).catch(()=>{})}await self.skipWaiting()})()));\nself.addEventListener('activate',event=>event.waitUntil(Promise.all([caches.keys().then(keys=>Promise.all(keys.filter(k=>k.startsWith('ege-gfm-2027-shell-')&&k!==CACHE).map(k=>caches.delete(k)))),self.clients.claim()])));\nself.addEventListener('fetch',event=>{\n const req=event.request;if(req.method!=='GET')return;\n const url=new URL(req.url);if(url.origin!==self.location.origin)return;\n const canonical=new URL(url);canonical.search='';canonical.hash='';\n const page=req.mode==='navigate'&&ASSETS.includes(canonical.href);\n const shell=ASSETS.includes(canonical.href)||OPTIONAL.includes(canonical.href);if(!page&&!shell)return;\n if(page){\n  event.respondWith(fetch(req).then(res=>{if(res.ok){const copy=res.clone();event.waitUntil(caches.open(CACHE).then(c=>c.put(canonical.href,copy)).catch(()=>{}))}return res}).catch(async()=>await caches.match(canonical.href)||new Response('Page indisponible hors connexion.',{status:503,headers:{'content-type':'text/plain; charset=utf-8'}})));\n  return;\n }\n event.respondWith(caches.open(CACHE).then(async cache=>{const hit=await cache.match(canonical.href);if(hit)return hit;const res=await fetch(req);if(res.ok){const copy=res.clone();event.waitUntil(cache.put(canonical.href,copy).catch(()=>{}))}return res}));\n});\n\nASSETS.push(...[\"./mon-bac-language-welcome-maquette3-20261119.js\",\"./mon-bac-language-secondary-20261118.css\"].map(p=>new URL(p,self.registration.scope).href));\n\nASSETS.push(...[\"./mon-bac-ege-ai-article-r2.js\",\"./mon-bac-v92-article-r2-teacher-clean-r1.js\",\"./mon-bac-v92-article-r2.css\",\"./app-2027-views-article-r2-sort-r1.js\"].map(p=>new URL(p,self.registration.scope).href));\n\nASSETS.push(...[\"./mon-bac-ege-ai-article-r2-interview-r1.js\",\"./ege-terrain-interview-r1.js\",\"./app-2027-interview-r1.js\"].map(p=>new URL(p,self.registration.scope).href));\n\nASSETS.push(new URL(\"./mon-bac-ege-ai-article-r2-interview-r1-titles-r1.js\",self.registration.scope).href);\n\nASSETS.push(new URL(\"./mon-bac-ege-ai-article-r2-interview-r1-titles-r1-sources-r2.js\",self.registration.scope).href);\n\nASSETS.push(new URL('./mon-bac-facture-20261119.css',self.registration.scope).href);\n\nASSETS.push(...[\"./mon-bac-encadreme