 56%,#fff3 56.3% 56.8%,transparent 57%);border-radius:inherit}.mb100-brand{display:flex;align-items:center;gap:9px;min-width:0}.mb100-brand img{width:36px;height:36px;object-fit:contain;border:1px solid #ffffffae;border-radius:10px}.mb100-brand strong{font-weight:800;font-size:22px;letter-spacing:-.5px;line-height:1.2;color:#fff}.mb100-label{align-self:flex-start;padding:5px 10px;border-radius:99px;background:white;color:#a4092b;font-size:11px;font-weight:850;letter-spacing:1px;line-height:1.25}.mb100-poster h2{font-size:clamp(22px,6.8vw,34px);font-weight:850;line-height:1.14;letter-spacing:-.7px;color:white;margin:0;overflow-wrap:anywhere}.mb100-photo{position:relative;height:clamp(120px,35dvh,260px);width:100%;flex-shrink:0;overflow:hidden;display:grid;place-items:center;border-radius:12px}.mb100-photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;mask-image:radial-gradient(ellipse 65% 66% at 50% 50%,#000 50%,#000d 70%,transparent 98%)}.mb100-sponsored .mb100-photo img{object-fit:contain;mask-image:none;border-radius:9px}.mb100-poster p{margin:0;color:#fff;font-size:clamp(14px,4.1vw,19px);font-weight:650;line-height:1.35;overflow-wrap:anywhere;text-align:center;white-space:pre-line}.mb100-sponsored h2{font-size:clamp(20px,5.7vw,30px)}.mb100-sponsored p{font-size:14px}.mb100-details{display:flex;align-items:center;justify-content:center;gap:6px;min-height:42px;border:0;border-radius:10px;background:#fff;color:#a4092b;font:inherit;font-size:13px;font-weight:750;padding:8px 12px}.mb100-details svg{width:17px;height:17px}.mb100-close{display:grid;place-items:center;width:46px;height:46px;min-width:46px;min-height:46px;border-radius:50%;border:2px solid #fff;background:#ffffff10;color:#fff;padding:0;cursor:pointer;box-shadow:0 3px 10px #0003}.mb100-close svg{width:27px;height:27px;stroke:#fff;fill:none}.mb100-close:focus-visible,.mb100-details:focus-visible{outline:3px solid #fff;outline-offset:4px}@media(max-height:550px){.mb100-poster{padding:14px 17px;gap:7px}.mb100-photo{height:clamp(90px,25dvh,180px)}.mb100-poster h2{font-size:21px}.mb100-brand img{width:28px;height:28px}.mb100-brand strong{font-size:18px}.mb100-poster p{font-size:13px}}@media(max-width:340px){.mb100-poster{padding:17px 16px;gap:9px}}\n:root[data-mb-role]{--mb:#c60835;--mb-dark:#a20a29;--mb-soft:#fff0f3}\n:root[data-mb-role]{--red:var(--mb);--red-dark:var(--mb-dark);--red-light:var(--mb-soft);--ink:#14233a;background-color:var(--mb)}\nhtml[data-mb-role] .app .app-header,html[data-mb-role] .app .ege-shared-header{background:var(--mb)!important;color:#fff!important;border:0!important;}\nhtml[data-mb-role] .app .app-header .brand,html[data-mb-role] .app .app-header .brandmark,html[data-mb-role] .app .app-header .brand-sub,html[data-mb-role] .app .app-header .header-icon,html[data-mb-role] .app .app-header .ege-brand-text{color:white!important}\nhtml[data-mb-role] .app .app-header .brandmark{background:transparent!important;box-shadow:none!important}\nhtml[data-mb-role] .app .btn.primary,html[data-mb-role] .app .ege-ad-details{background:var(--mb)!important;border-color:var(--mb)!important;color:white!important;box-shadow:none!important}\nhtml[data-mb-role] .app .btn.primary:hover{background:var(--mb-dark)!important}\nhtml[data-mb-role] .app .bottomnav button.active,html[data-mb-role] .app .side-link.active,html[data-mb-role] .app .tab.active{background:var(--mb-soft)!important;color:var(--mb)!important}\nhtml[data-mb-role] .app .main{background:#f8f9fc}\nhtml[data-mb-role] .app .card{background:white;border:1px solid #e9edf1;border-radius:17px;box-shadow:0 5px 14px #15213c06}\n.mb-heading{margin:0 0 18px}\n.mb-heading h1{font-size:clamp(23px,4vw,32px);margin:0 0 7px;line-height:1.25}\n.mb-heading p{font-size:13px;color:#637083;margin:0}\n.mb-priority{position:relative;display:flex;align-items:center;justify-content:space-between;gap:12px;isolation:isolate;overflow:hidden;background:#fff;border:1px solid var(--mb-soft);box-shadow:0 4px 18px #15213c12;border-radius:20px;padding:22px;margin:0 0 16px}\n.mb-priority small{display:inline-block;background:var(--mb-soft);color:var(--mb);padding:5px 9px;border-radius:7px;font-weight:800;font-size:10px;text-transform:uppercase;letter-spacing:.5px}\n.mb-priority h2{font-size:clamp(20px,4vw,27px);margin:9px 0 5px}\n.mb-priority p{font-size:13px;color:#5d6978;margin:0 0 12px}\n.mb-hero-icon{background:var(--mb-soft);color:var(--mb);width:70px;height:70px;border-radius:21px;display:grid;place-items:center;flex:none}\n.mb-hero-icon svg{width:38px;height:38px}\n.mb-quick{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 12px}.mb-quick .btn{flex:1;background:#fff;border:0;color:var(--mb);box-shadow:0 4px 12px #14233a12;font-size:12px;min-width:0}\n.mb-search{display:flex;align-items:end;gap:8px}.mb-search .field{flex:1;margin:0;min-width:0}.mb-search .btn{flex:none}\n.mb-sim-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr) minmax(0,.8fr) 40px;gap:6px;align-items:center;margin:14px 0;font-size:11px;color:#637083}.mb-sim-grid .input{min-width:0;width:100%;padding:9px 6px;font-size:13px}.mb-icon-btn{display:grid;place-items:center;background:#fff;color:var(--mb);border:0;border-radius:10px;width:40px;min-height:44px}.mb-icon-btn svg{width:20px;height:20px}.mb-sim-result{margin:16px 0;text-align:center;background:var(--mb-soft);border-radius:16px;padding:18px;display:grid;gap:7px}.mb-sim-result strong{font-size:32px;color:var(--mb)}.mb-sim-result p{margin:4px 0;font-size:13px}.mb-list-row{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;align-items:center;border-bottom:1px solid #edf0f3;padding:12px 0}.mb-list-row:last-child{border:0}.mb-list-row .btn{font-size:12px;padding:8px}.mb-calc-display{display:block;text-align:right;overflow-wrap:anywhere;background:var(--mb-soft);color:var(--mb);font-size:25px;font-weight:800;border-radius:12px;padding:14px;margin:10px 0}.mb-calc-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin:12px 0}.mb-calc-key{border:0;box-shadow:0 2px 8px #14233a16;background:white;color:var(--mb);font-size:15px;border-radius:11px;min-height:47px;font-weight:700}.mb-calc-key:focus-visible,.mb-icon-btn:focus-visible{outline:2px solid var(--mb)}\n.mbt-float{position:fixed;z-index:80;right:14px;bottom:calc(86px + env(safe-area-inset-bottom));width:min(300px,calc(100vw - 28px));background:white;color:#14233a;border-radius:18px;box-shadow:0 8px 32px #14233a38;padding:8px 12px}.mbt-float-head{display:flex;align-items:center;justify-content:space-between;color:#637083;font-size:11px}.mbt-float-head button{border:0;background:white;min-height:40px;min-width:40px;font-size:26px;color:#637083;border-radius:12px}.mbt-float-link{width:100%;display:flex;align-items:center;text-align:left;border:0;background:white;gap:10px;padding:0 0 9px;color:#14233a}.mbt-float-link img{width:52px;height:52px;border-radius:50%;object-fit:cover;flex:none}.mbt-float-link span{min-width:0;display:grid;gap:4px}.mbt-float-link strong,.mbt-float-link small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mbt-float-link small{color:#637083;font-size:11px}.mbt-float-link b{color:#C60835;font-size:12px}.mbt-float button:focus-visible{outline:2px solid #C60835}\n.mb-tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:18px}\n.mb-tile{min-width:0;min-height:86px;background:#fff;border:0;border-radius:15px;box-shadow:0 4px 14px #14233a12;color:var(--mb);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:12px 6px;font-size:13px;font-weight:700;text-align:center;cursor:pointer;line-height:1.25}\n.mb-tile:hover{box-shadow:0 6px 18px #14233a20}.mb-tile:focus-visible{outline:2px solid var(--mb);outline-offset:2px}\n.mb-tile svg{width:26px;height:26px;stroke-width:1.7}\nhtml[data-mb-role] .app .bottomnav button.active,html[data-mb-role] .app .side-link.active{background:#fff!important;box-shadow:0 3px 12px #14233a12;color:var(--mb)!important}\n.mb-actions{display:flex;gap:9px;flex-wrap:wrap;margin:12px 0}\n.mb-filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}\n.mb-filters .field{margin:0;min-width:0}\n.mb-filters .select{min-width:0}\n.mb-exam{margin:12px 0}\n.mb-exam-top{display:flex;justify-content:space-between;align-items:center}\n.mb-exam h3{margin:12px 0 5px}\n.mb-exam p{font-size:12px;color:#637083;margin:0 0 8px;overflow-wrap:anywhere}\n.mb-favorite{background:transparent;border:0;color:var(--mb);padding:5px 8px;font-size:26px;line-height:1;cursor:pointer}\n.mb-week{margin:12px 0}\n.mb-week small{color:var(--mb);font-weight:800}\n.mb-background{display:grid;gap:10px;padding:14px 0;border-top:1px solid #e8edf0}\n.mb-background img{width:min(100%,320px);height:95px;object-fit:cover;border-radius:10px}\n.ege-ad-banner.ege-ad-essential{position:relative;isolation:isolate;background:#fff!important;overflow:hidden}\n.ege-ad-banner.ege-ad-essential::before{content:\"\";position:absolute;inset:0;z-index:-1;background-image:linear-gradient(90deg,#fff9,#fffffff2),var(--mb-ad-image,none);background-size:cover;background-position:center;pointer-events:none}\n.mb-reader{border:0;border-radius:17px;padding:12px;width:min(96vw,960px);height:min(95dvh,1000px);max-height:95dvh;overflow:auto;color:#17243a;background:#f5f6f8}\n.mb-reader::backdrop{background:#1c253ccc}\n.mb-reader header{display:flex;justify-content:space-between;align-items:center;gap:12px;position:sticky;top:0;background:#f5f6f8;z-index:1;padding:6px 0}\n.mb-reader-bar{display:flex;justify-content:space-between;align-items:center;gap:5px;padding:10px 0;font-size:13px}\n#mbCanvasWrap{min-height:180px;display:grid;place-items:center;background:#dde3ec;border-radius:10px;padding:8px;overflow:auto}\n#mbCanvas{display:block;background:white;box-shadow:0 4px 14px #17243a16}\n@media(max-width:810px){\n html[data-mb-role] .app .bottomnav{height:calc(68px + env(safe-area-inset-bottom));padding:5px 8px env(safe-area-inset-bottom)}\n html[data-mb-role] .app .bottomnav button{font-size:11px;white-space:normal;min-width:0}\n html[data-mb-role] .app .main{padding:16px 13px calc(94px + env(safe-area-inset-bottom))}\n html[data-mb-role] .app.ege-intro-app .main{padding-bottom:28px}\n .mb-priority{padding:17px 13px;gap:8px}\n .mb-hero-icon{width:55px;height:55px;border-radius:16px}\n .mb-hero-icon svg{width:30px;height:30px}\n .mb-tile{min-height:78px;font-size:12px}\n .mb-priority .btn{white-space:normal;font-size:12px}\n .mb-reader{width:100vw;height:100dvh;max-width:100vw;max-height:100dvh;border-radius:0}\n}\n"],"/mon-bac-next.js":["application/javascript; charset=utf-8",false,"/* monAvenir — extension du portail EGE existant. Aucun accès aux sujets hors RLS. */\n(()=>{'use strict';\nconst SERIES=['GFM','OGRH','IAG','S','ES','L'];\nconst LEVELS=['Première','Terminale'];\nconst EGE_SERIES=['GFM','OGRH','IAG'];\nconst EXAM_TABLE='mon_bac_exams', PROGRESS_TABLE='mon_bac_exam_progress', BUCKET='mon-bac-exams';\nconst examScreens=['student-exams','student-corrections','student-favorites','teacher-exams','admin-exams','teacher-exam-edit','admin-exam-edit'];\nconst dossierScreens=['student-ege','student-docs','student-wizard','student-annex','student-terrain','student-service','student-group-corrections'];\nconst titles={draft:'Brouillon',pending:'En attente',published:'Publié',changes_requested:'À corriger'};\nconst mb={rows:[],progress:[],owner:null,loading:false,error:'',filterSubject:'',filterYear:'',filterSeries:'',filterLevel:'',query:'',edit:null,reader:null,reading:false,version:0,loaded:false};\nconst level=p=>p?.academic_level||(String(p?.class_name||'').startsWith('Première ')?'Première':p?.class_name?'Terminale':'');\nconst ege=()=>(st.profile?.academic_level==='Terminale'&&EGE_SERIES.includes(st.profile?.series));\nconst approved=()=>st.role==='admin'||st.role==='enseignant'&&st.teacher?.status==='approved';\nconst allowed=()=>st.user&&!EGEAccount.blocked(st.profile);\nconst examiner=()=>allowed()&&approved();\nconst who=()=>st.profile?.full_name||vGreeting();\nconst goTo=(screen,label,icon)=>btn(label,'goto','btn primary',icon,'data-to=\"'+screen+'\"');\nconst optionList=(values,selected,placeholder)=>'<option value=\"\">'+esc(placeholder)+'</option>'+values.map(x=>'<option value=\"'+esc(x)+'\"'+(String(selected)===String(x)?' selected':'')+'>'+esc(x)+'</option>').join('');\nfunction tileMB(label,icon,screen){return '<button type=\"button\" class=\"mb-tile\" data-act=\"goto\" data-to=\"'+screen+'\">'+I(icon)+'<span>'+esc(label)+'</span></button>'}\nfunction hero(label,name,details,action,icon){return '<section class=\"mb-priority\"><div><small>'+esc(label)+'</small><h2>'+esc(name)+'</h2><p>'+esc(details)+'</p>'+action+'</div><div class=\"mb-hero-icon\">'+I(icon)+'</div></section>'}\nfunction heading(text,sub){return '<div class=\"mb-heading\"><h1>'+esc(text)+'</h1><p>'+esc(sub)+'</p></div>'}\nfunction examTitle(r){return r?.title||'Sujet d’examen'}\nfunction isValidPdf(f){return !!f && f.size>4 && f.size<=25*1024*1024 && /\\.pdf$/i.test(f.name)}\nasync function validatedPdf(f){if(!isValidPdf(f)||new TextDecoder().decode(await f.slice(0,5).arrayBuffer())!=='%PDF-')throw Error('Sélectionnez un PDF valide de 25 Mo maximum.');return f}\nfunction clearState(){mb.rows=[];mb.progress=[];mb.owner=null;mb.loaded=false;mb.error='';mb.edit=null;mb.pendingDraftId=null;mb.multiCreated=[];mb.version++;closeReader();}\n// A retry never changes the exam UUID or the storage path. Only transient errors are retried.\nfunction examTransient(error){const code=String(error?.statusCode??error?.status??error?.code??'');return /^(408|429|5\\d\\d|57014|40001|40P01)$/.test(code)||/timeout|timed out|database.?timeout|networkerror|failed to fetch|connection reset|temporarily unavailable|canceling statement/i.test(String(error?.message||error?.error||''));}\nfunction examSaveStatus(message){const el=$('mbSaveStatus');if(el)el.textContent=message;}\nasync function examRetry(label,operation){\n const uid=st.user?.id;if(!uid)throw Error('Connexion obligatoire.');\n for(let attempt=1;attempt<=3;attempt++){\n  if(st.user?.id!==uid||!examiner())throw Error('Connexion interrompue.');\n  try{const result=await operation();if(result?.error)throw result.error;return result;}\n  catch(error){if(attempt===3||!examTransient(error))throw error;examSaveStatus(label+' : reprise automatique '+(attempt+1)+'/3…');await new Promise(resolve=>setTimeout(resolve,attempt*1500));}\n }\n}\nfunction rememberExam(row){if(row?.id){mb.edit=row;mb.rows=mb.rows.filter(item=>item.id!==row.id).concat(row);}}\nasync function insertExamDraft(payload,id){return examRetry('Création du brouillon',async()=>{\n const result=await st.db.from(EXAM_TABLE).insert({...payload,id}).select().single();\n if(result.error?.code!=='23505')return result;\n const existing=await st.db.from(EXAM_TABLE).select('*').eq('id',id).single();\n if(existing.error)return existing;\n if(existing.data?.created_by!==st.user?.id||existing.data?.status!=='draft')throw Error('Impossible de reprendre ce brouillon.');\n return existing;\n});}\nasync function uploadExamPdf(id,kind,file){examSaveStatus('Transfert du '+(kind==='sujet'?'sujet':'corrigé')+'…');return examRetry('Transfert du '+(kind==='sujet'?'sujet':'corrigé'),()=>st.db.storage.from(BUCKET).upload(id+'/'+kind+'.pdf',file,{contentType:'application/pdf',upsert:true,cacheControl:'0'}));}\nconst previousLogout=signOut;signOut=async function(){clearState();return previousLogout()};\nasync function loadExams(){\n if(!allowed()||st.role==='enseignant'&&!approved()){clearState();return}\n const uid=st.user.id,ticket=++mb.version;if(mb.owner!==uid){mb.rows=[];mb.progress=[];mb.loaded=false;mb.owner=uid}\n mb.loading=true;mb.error='';\n try{\n  let q=st.db.from(EXAM_TABLE).select('*').order('exam_year',{ascending:false}).order('updated_at',{ascending:false}).limit(500);\n  if(st.role==='eleve')q=q.eq('status','published').eq('series',st.profile?.series||'').eq('academic_level',level(st.profile));\n  const [a,b]=await Promise.all([q,st.role==='eleve'?st.db.from(PROGRESS_TABLE).select('*').eq('user_id',uid):Promise.resolve({data:[]})]);\n  if(a.error)throw a.error;if(b.error)throw b.error;\n  if(ticket!==mb.version||st.user?.id!==uid)return;\n  mb.rows=a.data||[];mb.progress=b.data||[];mb.loaded=true;\n }catch(e){if(ticket===mb.version){mb.error='Actualisation du catalogue indisponible. Réessayez plus tard.';mb.loaded=false}}\n finally{if(ticket===mb.version){mb.loading=false;if(examScreens.includes(st.screen)||st.screen==='student-home')render()}}\n}\nconst previousLoad=loadAll;loadAll=async function(){await previousLoad();await loadExams()};\nconst previousGo=go;go=function(screen){\n if(st.role==='eleve'&&!ege()&&dossierScreens.includes(screen)){toast('Mon EGE est réservé aux élèves de Terminale SG (GFM, OGRH, IAG).');return}\n if(examScreens.includes(screen)&&!allowed()){toast('Connectez-vous avec un compte actif.');return}\n if((screen.startsWith('admin-exam')||screen.startsWith('teacher-exam'))&&!examiner()){toast('Compte enseignant approuvé ou administrateur requis.');return}\n if(screen.endsWith('-edit')&&!mb.edit)mb.edit={};\n if(screen==='teacher-students'&&!st.selectedGroupId){if(st.groups.length===1)st.selectedGroupId=st.groups[0].id;else screen='teacher-groups';}\n previousGo(screen);\n if(examScreens.includes(screen)&&!mb.loaded&&!mb.loading&&allowed())loadExams();\n};\nscreenList.push(...[\n ['student-ege','Mon EGE'],['student-exams','Sujets du bac'],['student-corrections','Corrigés du bac'],['student-favorites','Mes favoris'],\n ['student-progress','Mes progrès'],['student-help','Aide et assistance'],['teacher-exams','Sujets pour ma classe'],['teacher-exam-edit','Proposer un sujet'],\n ['teacher-announcements','Mon annonce'],['teacher-invites','Inviter mes élèves'],['admin-exams','Catalogue des sujets'],['admin-exam-edit','Ajouter un sujet'],\n ['admin-announcements','Annonces'],['admin-settings','Paramètres']\n]);\nnavs.eleve.splice(0,navs.eleve.length,['student-home','Accueil','home'],['student-exams','Réviser','book'],['student-group','Ma classe','users'],['profile','Profil','user']);\nnavs.enseignant.splice(0,navs.enseignant.length,['teacher-home','Accueil','home'],['teacher-groups','Classes','users'],['teacher-exams','Sujets','file'],['profile','Profil','user']);\nnavs.admin.splice(0,navs.admin.length,['admin-home','Accueil','home'],['admin-users','Gestion','users'],['admin-monitor','Contrôle','shield'],['profile','Profil','user']);\nconst prevMenu=menu;menu=function(){\n let html=prevMenu();\n if(st.role==='eleve'&&!ege())html=html.replace(/<button[^>]*data-to=\"student-(?:wizard|annex|terrain|docs|service)\"[^>]*>[\\s\\S]*?<\\/button>/g,'');\n return html;\n};\nconst oldStudentHome=studentHome,oldTeacherHome=teacherHome,oldAdminHome=adminHome,oldStudentGroup=studentGroup;\nfunction studentHomeMB(){\n const p=st.profile||{},d=currentDoc()||st.docs[0],last=mb.progress.slice().sort((a,b)=>String(b.updated_at).localeCompare(String(a.updated_at)))[0],exam=mb.rows.find(r=>r.id===last?.exam_id);\n const featured=mb.rows.find(r=>r.has_subject!==false&&r.featured&&r.status==='published');\n const action=ege()?goTo('student-ege',d?'Continuer mon dossier':'Préparer mon dossier','arrow'):exam?'<button class=\"btn primary\" data-mb=\"read\" data-id=\"'+esc(exam.id)+'\" data-kind=\"'+esc(last.last_kind)+'\">Reprendre le sujet '+I('arrow')+'</button>':goTo('student-exams','Explorer les sujets','arrow');\n return heading('Bonjour, '+who(),[level(p),p.series].filter(Boolean).join(' · '))+\n hero('À reprendre',ege()?'Mon dossier EGE':exam?exam.subject:'Mes révisions',ege()?'Préparer et suivre mon étude de gestion.':exam?examTitle(exam):'Des sujets et corrigés adaptés à votre parcours.',action,ege()?'edit':'book')+\n '<div class=\"mb-tiles\">'+[\n ['Sujets','file','student-exams'],['Corrigés','clipboard-check','student-corrections'],['Simulateur Bac','calculator','student-simulator'],['Favoris','bookmark','student-favorites'],['Mes progrès','chart','student-progress'],['Aide','help-circle','student-help']\n ].map(a=>tileMB(...a)).join('')+'</div>'+\n (featured?'<section class=\"card mb-week\"><small>SUJET DE LA SEMAINE</small><h3>'+esc(examTitle(featured))+'</h3><button class=\"btn primary\" data-mb=\"read\" data-id=\"'+esc(featured.id)+'\" data-kind=\"sujet\">Consulter '+I('arrow')+'</button></section>':'')+\n adBanner('student_home');\n}\nfunction teacherHomeMB(){\n if(!approved())return oldTeacherHome();\n const g=st.groups[0];\n return heading('Mon espace enseignant','Bonjour, '+who())+hero('Ma classe',g?.name||'Créer ma classe',st.docs.length+' dossier(s) à suivre',goTo(g?'teacher-review':'teacher-groups',g?'Voir les dossiers':'Créer une classe','arrow'),'users')+\n '<div class=\"mb-tiles\">'+[['Mes classes','cap','teacher-groups'],['Mes élèves','users','teacher-students'],['Sujets','file','teacher-exams'],['Corrections','clipboard-check','teacher-review'],['Mon annonce','megaphone','teacher-announcements'],['Mon soutien','hand-heart','teacher-support']].map(a=>tileMB(...a)).join('')+'</div>'+\n '<div class=\"mb-actions\">'+goTo('teacher-invites','Inviter mes élèves','plus')+goTo('teacher-notices','Messages aux classes','bell')+'</div>'+\n '<section class=\"card\"><h3>Activité récente</h3>'+reviewList(st.reviews.slice(0,3))+'</section>';\n}\nfunction adminHomeMB(){\n const pend=st.requests.filter(r=>r.status==='pending').length,adPending=st.ads.filter(r=>r.status==='pending').length;\n return heading('Piloter monAvenir','Administration')+hero('À examiner','Inscriptions enseignants',pend+' compte(s) et '+adPending+' annonce(s) en attente',goTo('admin-users','Examiner','arrow'),'shield')+\n '<div class=\"mb-tiles\">'+[['Utilisateurs','users','admin-users'],['Classes','cap','admin-groups'],['Dossiers et sujets','folder-open','admin-exams'],['Enseignants','user-check','admin-users'],['Annonces','megaphone','admin-announcements'],['Paramètres','settings','admin-settings']].map(a=>tileMB(...a)).join('')+'</div>'+\n '<section class=\"card\"><h3>Activité récente</h3><p>'+pend+' inscription(s) à vérifier</p><p>'+adPending+' annonce(s) à approuver</p>'+goTo('admin-announcements','Examiner les annonces','megaphone')+'</section>'+\n '<div class=\"mb-actions\">'+goTo('admin-support','Soutien scolaire','hand-heart')+goTo('admin-notices','Notifications','bell')+goTo('admin-simulations','Simulations','calculator')+'</div>';\n}\nfunction studentGroupMB(){\n if(ege())return oldStudentGroup();\n return title('Ma classe','Ma classe','Rejoignez votre enseignant avec son code.')+\n st.groups.map(g=>'<section class=\"card\"><h3>'+esc(g.name)+'</h3><p>'+esc(g.school)+'</p></section>').join('')+\n '<section class=\"card\"><h3>Rejoindre une classe</h3><form id=\"groupJoinForm\"><label class=\"field\"><span>Code de classe</span><input class=\"input\" id=\"joinCode\" required maxlength=\"20\"></label><button class=\"btn primary\">Rejoindre</button></form></section>';\n}\nfunction examList(kind){\n const student=st.role==='eleve',own=st.role==='enseignant',admin=st.role==='admin';\n let rows=mb.rows.filter(r=>student?r.status==='published'&&r.series===st.profile?.series&&r.academic_level===level(st.profile):true);\n const correctionAllowed=r=>!student||r.visibility!=='restricted'||window.MB69?.canReadCorrection(r.id);\n if(kind==='corrige')rows=rows.filter(r=>r.has_correction&&r.status==='published'&&correctionAllowed(r));\n if(kind==='sujet'&&!admin)rows=rows.filter(r=>r.has_subject!==false);\n if(own&&mb.onlyMine)rows=rows.filter(r=>r.created_by===st.user?.id);\n if(kind==='favoris')rows=rows.filter(r=>mb.progress.some(p=>p.exam_id===r.id&&p.favorite));\n const subjects=[...new Set(rows.map(r=>r.subject))].sort(),years=[...new Set(rows.map(r=>r.exam_year))].sort((a,b)=>b-a);\n if(mb.filterSubject)rows=rows.filter(r=>r.subject===mb.filterSubject);\n if(mb.filterYear)rows=rows.filter(r=>String(r.exam_year)===mb.filterYear);\n if(mb.filterSeries)rows=rows.filter(r=>student||r.series===mb.filterSeries);\n if(mb.filterLevel)rows=rows.filter(r=>student||r.academic_level===mb.filterLevel);\n if(mb.query&&window.MBTools)rows=rows.filter(r=>MBTools.matches(r,mb.query));\n const label=kind==='corrige'?'Corrigés du bac':kind==='favoris'?'Mes favoris':admin?'Dossiers et sujets':own?'Sujets et propositions':'Sujets du bac';\n const lead=title('monAvenir',label,student?[level(st.profile),st.profile?.series].filter(Boolean).join(' · '):'Catalogue et suivi des publications');\n const filters='<div class=\"card mb-filters\"><label class=\"field\"><span>Matière</span><select class=\"select\" data-mb-filter=\"filterSubject\">'+optionList(subjects,mb.filterSubject,'Toutes les matières')+'</select></label><label class=\"field\"><span>Année</span><select class=\"select\" data-mb-filter=\"filterYear\">'+optionList(years,mb.filterYear,'Toutes les années')+'</select></label>'+(!student?'<label class=\"field\"><span>Série</span><select class=\"select\" data-mb-filter=\"filterSeries\">'+optionList(SERIES,mb.filterSeries,'Toutes les séries')+'</select></label><label class=\"field\"><span>Niveau</span><select class=\"select\" data-mb-filter=\"filterLevel\">'+optionList(LEVELS,mb.filterLevel,'Tous les niveaux')+'</select></label>':'')+'</div>';\n const create=student?'':'<div class=\"mb-actions\"><button class=\"btn primary\" data-mb=\"new\">'+I('plus')+' Ajouter un sujet</button>'+(admin?'<button class=\"btn\" data-mb=\"new-correction\">'+I('plus')+' Ajouter un corrigé seul</button>'+goTo('admin-monitor','Dossiers EGE','folder'):'')+'</div>';\n if(mb.loading)return lead+create+(student?adBanner('student_catalog'):'')+emptyCard('Chargement des sujets…');\n if(mb.error)return lead+create+(student?adBanner('student_catalog'):'')+emptyCard(mb.error)+'<button class=\"btn\" data-mb=\"refresh\">Réessayer</button>';\n return lead+create+'<form class=\"card mb-search\" id=\"mbSearchForm\"><label class=\"field\"><span>Rechercher un sujet ou corrigé</span><input type=\"search\" class=\"input\" id=\"mbQuery\" maxlength=\"150\" placeholder=\"Ex. maths 2025\" value=\"'+esc(mb.query)+'\"></label><button class=\"btn primary\" type=\"submit\">'+I('search')+' Rechercher</button></form>'+filters+(student?adBanner('student_catalog'):'')+(rows.length?rows.map(r=>{\n  const fav=mb.progress.some(p=>p.exam_id===r.id&&p.favorite),ownDraft=r.created_by===st.user?.id&&r.status!=='published';\n  return '<article class=\"card mb-exam\"><div class=\"mb-exam-top\"><span class=\"badge red\">BAC '+esc(r.exam_year)+'</span>'+(!student?badge(titles[r.status]||r.status,r.status==='published'?'green':'orange'):'<button class=\"mb-favorite\" data-mb=\"favorite\" data-id=\"'+esc(r.id)+'\" aria-label=\"'+(fav?'Retirer des favoris':'Ajouter aux favoris')+'\" aria-pressed=\"'+fav+'\">'+(fav?'★':'☆')+'</button>')+'</div><h3>'+esc(examTitle(r))+'</h3><p>'+esc([r.subject,r.academic_level,r.series,r.session].join(' · '))+'</p>'+\n   (r.review_comment&&!student?'<p class=\"form-note\">'+esc(r.review_comment)+'</p>':'')+\n   (r.has_subject===false?'<p class=\"form-note\">Corrigé seul</p>':'')+\n   '<div class=\"mb-actions\">'+((r.has_subject!==false||r.has_correction)?'<button class=\"btn primary\" data-mb=\"read\" data-kind=\"'+(kind==='corrige'||r.has_subject===false?'corrige':'sujet')+'\" data-id=\"'+esc(r.id)+'\">Consulter '+I('arrow')+'</button>':'')+\n   (r.has_subject!==false&&r.has_correction&&kind!=='corrige'&&correctionAllowed(r)?'<button class=\"btn\" data-mb=\"read\" data-kind=\"corrige\" data-id=\"'+esc(r.id)+'\">Corrigé</button>':'')+\n   ((admin&&r.status!=='published'||ownDraft)?'<button class=\"btn\" data-mb=\"edit\" data-id=\"'+esc(r.id)+'\">Modifier / vérifier</button>':'')+\n   ((admin||r.created_by===st.user?.id)&&!student&&r.status==='published'?'<button class=\"btn\" data-mb=\"unpublish\" data-id=\"'+esc(r.id)+'\">Retirer</button>'+(admin&&r.has_subject!==false?'<button class=\"btn\" data-mb=\"feature\" data-id=\"'+esc(r.id)+'\">'+(r.featured?'Retirer de la semaine':'Sujet de la semaine')+'</button>':''):'')+'</div></article>';\n }).join(''):emptyCard('Aucun sujet disponible pour ces critères.'))+\n '<p class=\"form-note\">'+(student?'Les documents sont réservés aux élèves inscrits de votre série et niveau.':'Les enseignants approuvés publient directement leurs sujets.')+'</p>';\n}\nfunction field(label,id,value,extra=''){return '<label class=\"field\"><span>'+esc(label)+'</span><input class=\"input\" id=\"'+id+'\" value=\"'+esc(value??'')+'\" '+extra+'></label>'}\nfunction selectField(label,id,values,value){return '<label class=\"field\"><span>'+esc(label)+'</span><select class=\"select\" id=\"'+id+'\" required>'+optionList(values,value,'Choisir')+'</select></label>'}\nfunction editPage(){\n const r=mb.edit||{},admin=st.role==='admin',only=admin&&r.has_subject===false;\n return title('Documents',only?'Ajouter / vérifier un corrigé seul':admin?'Ajouter / vérifier un sujet':'Proposer un sujet',only?'Importez le corrigé PDF. Le sujet peut être ajouté plus tard.':'Le PDF du sujet est obligatoire ; le corrigé est facultatif.')+\n '<section class=\"card\"><form id=\"mbExamForm\">'+field('Titre du sujet','mbTitle',r.title,'required maxlength=\"160\"')+'<div class=\"mb-filters\">'+selectField('Série','mbSeries',SERIES,r.series)+selectField('Niveau','mbLevel',LEVELS,r.academic_level)+'</div>'+field('Matière','mbSubject',r.subject,'required maxlength=\"120\"')+'<div class=\"mb-filters\">'+field('Année','mbYear',r.exam_year||new Date().getFullYear(),'type=\"number\" min=\"1990\" max=\"2100\" required')+selectField('Session','mbSession',['Principale','Rattrapage','Bac blanc','Autre'],r.session||'Principale')+'</div>'+\n '<label class=\"field\"><span>Sujet PDF'+(only?' (facultatif)':'')+'</span><input class=\"input\" id=\"mbSubjectFile\" type=\"file\" accept=\"application/pdf,.pdf\" '+(!r.id&&!only?'required':'')+'></label><label class=\"field\"><span>Corrigé PDF'+(only?'':' (facultatif)')+'</span><input class=\"input\" id=\"mbCorrectionFile\" type=\"file\" accept=\"application/pdf,.pdf\" '+(only&&!r.has_correction?'required':'')+'></label>'+\n (r.id?'<label><input type=\"checkbox\" id=\"mbKeepCorrection\" '+(r.has_correction?'checked':'')+'> Conserver le corrigé déjà enregistré</label>':'')+\n '<p class=\"form-note\">Enregistrez le brouillon pour vérifier l’aperçu des documents. Les élèves ne le voient pas encore.</p><p class=\"form-note\" id=\"mbSaveStatus\" role=\"status\" aria-live=\"polite\"></p><button class=\"btn primary full\" type=\"submit\">Enregistrer en brouillon</button></form></section>'+\n (r.id?'<section class=\"card\"><h3>Aperçu avant publication</h3><p>'+esc(r.series)+' · '+esc(r.academic_level)+' · '+esc(titles[r.status])+'</p><div class=\"mb-actions\">'+(!only?'<button class=\"btn\" data-mb=\"read\" data-id=\"'+esc(r.id)+'\" data-kind=\"sujet\">Voir le sujet</button>':'')+(r.has_correction?'<button class=\"btn\" data-mb=\"read\" data-id=\"'+esc(r.id)+'\" data-kind=\"corrige\">Voir le corrigé</button>':'')+'</div>'+\n (admin?'<label class=\"field\"><span>Commentaire à l’enseignant (facultatif)</span><textarea id=\"mbReviewComment\" class=\"textarea\" maxlength=\"1000\">'+esc(r.review_comment||'')+'</textarea></label><button class=\"btn primary full\" data-mb=\"publish\" data-id=\"'+esc(r.id)+'\">Publier '+(only?'le corrigé':'le sujet')+'</button>':'<button class=\"btn primary full\" data-mb=\"submit\" data-id=\"'+esc(r.id)+'\">Publier le sujet</button>')+'</section>':'');\n}\nasync function saveExam(){\n if(!examiner())throw Error('Accès interdit.');\n const old=mb.edit||{},file=$('mbSubjectFile').files[0],correction=$('mbCorrectionFile').files[0],keepCorrection=!!$('mbKeepCorrection')?.checked;\n const only=st.role==='admin'&&old.has_subject===false;\n if(!old.id&&!file&&!only)throw Error('Importez le PDF du sujet.');\n if(only&&!correction&&!(keepCorrection&&old.has_correction))throw Error('Importez le PDF du corrigé.');\n if(file)await validatedPdf(file);if(correction)await validatedPdf(correction);\n const payload={title:cleaned($('mbTitle').value),series:$('mbSeries').value,academic_level:$('mbLevel').value,subject:cleaned($('mbSubject').value),exam_year:Number($('mbYear').value),session:$('mbSession').value,status:'draft',visibility:mb.edit?.visibility||(st.role==='admin'?'catalogue':'restricted')};\n if(only)payload.has_subject=false;\n if(!old.id&&document.querySelector('[data-mb70-specialty]')){\n  const selected=[...document.querySelectorAll('[data-mb70-specialty]:checked')].map(n=>JSON.parse(n.value));\n  if(!selected.length)throw Error('Choisissez au moins une spécialité approuvée.');\n  if(!file)throw Error('Importez le PDF du sujet.');\n  mb.multiCreated=[];\n  try{for(const [series,academic_level,subject] of selected){\n   const inserted=await insertExamDraft({...payload,series,academic_level,subject},crypto.randomUUID());\n   const row=inserted.data;rememberExam(row);\n   for(const [kind,f] of [['sujet',file],['corrige',correction]])if(f)await uploadExamPdf(row.id,kind,f);\n   const done=await examRetry('Finalisation du brouillon',()=>st.db.from(EXAM_TABLE).update({has_correction:!!correction}).eq('id',row.id).select().single());\n   rememberExam(done.data);mb.multiCreated.push(done.data);\n  }}catch(e){await loadExams();render();throw Error(mb.multiCreated.length+' brouillon(s) enregistré(s). Vérifiez le dernier brouillon et reprenez les spécialités restantes. '+(e.message||''));}\n  toast(mb.multiCreated.length+' brouillon(s) enregistré(s).');await loadExams();render();return;\n }\n examSaveStatus('Enregistrement du brouillon…');\n const draftId=old.id||(mb.pendingDraftId??=crypto.randomUUID());\n let result=old.id?await examRetry('Enregistrement du brouillon',()=>st.db.from(EXAM_TABLE).update(payload).eq('id',draftId).select().single()):await insertExamDraft(payload,draftId);\n let r=result.data;rememberExam(r);mb.pendingDraftId=null;\n for(const [kind,f] of [['sujet',file],['corrige',correction]])if(f){\n  await uploadExamPdf(r.id,kind,f);\n }\n const has=!!correction||keepCorrection&&!!old.has_correction;\n examSaveStatus('Finalisation du brouillon…');\n result=await examRetry('Finalisation du brouillon',()=>st.db.from(EXAM_TABLE).update({has_correction:has,...(only?{has_subject:!!file}:{})}).eq('id',r.id).select().single());\n rememberExam(result.data);toast('Brouillon enregistré. Vérifiez l’aperçu.');await loadExams();render();\n}\nasync function changeExam(id,patch){\n if(!examiner())throw Error('Accès interdit.');\n const r=await st.db.from(EXAM_TABLE).update(patch).eq('id',id).select().single();if(r.error)throw r.error;\n mb.edit=r.data;await loadExams();render();\n}\nasync function setProgress(id,patch){\n if(st.role!=='eleve'||!allowed())return;\n const old=mb.progress.find(x=>x.exam_id===id);\n const payload={user_id:st.user.id,exam_id:id,favorite:old?.favorite||false,subject_page:old?.subject_page||1,correction_page:old?.correction_page||1,last_kind:old?.last_kind||'sujet',...patch,updated_at:new Date().toISOString()};\n const r=await st.db.from(PROGRESS_TABLE).upsert(payload,{onConflict:'user_id,exam_id'}).select().single();if(r.error)throw r.error;\n mb.progress=mb.progress.filter(x=>x.exam_id!==id).concat(r.data);\n}\nlet pdfLib,readerSerial=0;\nasync function pdfModule(){if(!pdfLib){pdfLib=await import('./vendor/mon-bac-pdf-5.6.205.mjs');pdfLib.GlobalWorkerOptions.workerSrc=new URL('./vendor/mon-bac-pdf-worker-5.6.205.mjs',location.href).href}return pdfLib}\nfunction closeReader(){readerSerial++;mb.reader?.task?.destroy?.().catch?.(()=>{});mb.reader=null;const d=$('mbReader');if(d){if(d.open)d.close();d.remove()}}\nasync function openReader(id,kind){\n const r=mb.rows.find(x=>x.id===id)||mb.edit?.id===id&&mb.edit;\n if(!r||!allowed()||!['sujet','corrige'].includes(kind)||kind==='sujet'&&r.has_subject===false||kind==='corrige'&&(!r.has_correction||st.role==='eleve'&&r.visibility==='restricted'&&!window.MB69?.canReadCorrection(id)))throw Error('Document indisponible.');\n if(st.role==='eleve'&&(r.status!=='published'||r.series!==st.profile?.series||r.academic_level!==level(st.profile)))throw Error('Document indisponible pour votre série et niveau.');\n closeReader();const serial=++readerSerial;\n document.body.insertAdjacentHTML('beforeend','<dialog id=\"mbReader\" class=\"mb-reader\"><header><strong>'+esc(examTitle(r))+'</strong><button class=\"btn\" data-mb=\"close-reader\" aria-label=\"Fermer le lecteur\">Fermer</button></header><div class=\"mb-reader-bar\"><button class=\"btn\" data-mb=\"prev-page\">Précédente</button><span id=\"mbPageLabel\" role=\"status\">Chargement…</span><button class=\"btn\" data-mb=\"next-page\">Suivante</button></div><div id=\"mbCanvasWrap\"><canvas id=\"mbCanvas\"></canvas></div><p class=\"form-note\">Document réservé à votre usage personnel.</p></dialog>');\n const d=$('mbReader');d.showModal();d.addEventListener('close',()=>{if(mb.reader||d.isConnected)closeReader()},{once:true});\n try{\n  const result=await st.db.storage.from(BUCKET).download(id+'/'+kind+'.pdf');\n  if(result.error)throw result.error;\n  if(serial!==readerSerial)return;\n  const module=await pdfModule();if(serial!==readerSerial)return;\n  const task=module.getDocument({data:new Uint8Array(await result.data.arrayBuffer()),isEvalSupported:false});\n  mb.reader={task,id,kind,page:1,pdf:null,serial};\n  const pdf=await task.promise;if(serial!==readerSerial){task.destroy();return}\n  const p=mb.progress.find(x=>x.exam_id===id);mb.reader.pdf=pdf;mb.reader.page=Math.min(pdf.numPages,Math.max(1,p?.[kind==='sujet'?'subject_page':'correction_page']||1));await drawPage();\n }catch(e){if(serial===readerSerial){$('mbPageLabel').textContent='Lecture impossible. Fermez puis réessayez.';toast(e.message)}}\n}\nasync function drawPage(){\n const r=mb.reader;if(!r?.pdf||mb.reading)return;mb.reading=true;\n try{\n  const p=await r.pdf.getPage(r.page);if(r!==mb.reader)return;\n  const raw=p.getViewport({scale:1}),width=Math.max(240,Math.min(850,$('mbCanvasWrap').clientWidth-16)),scale=Math.min(2.25,width/raw.width*Math.min(devicePixelRatio||1,2));\n  const vp=p.getViewport({scale}),canvas=$('mbCanvas'),ctx=canvas.getContext('2d');\n  canvas.width=Math.ceil(vp.width);canvas.height=Math.ceil(vp.height);canvas.style.width=width+'px';canvas.style.maxWidth='100%';\n  await p.render({canvas,canvasContext:ctx,viewport:vp}).promise;if(r!==mb.reader)return;\n  ctx.save();ctx.fillStyle='rgba(130,130,130,0.18)';ctx.font=Math.max(13,Math.floor(canvas.width/27))+'px sans-serif';ctx.translate(canvas.width/2,canvas.height/2);ctx.rotate(-Math.PI/5);ctx.textAlign='center';\n  for(let offset=-canvas.height;offset<=canvas.height;offset+=Math.max(95,canvas.height/5))ctx.fillText('monAvenir · '+who(),0,offset,canvas.width*.85);\n  ctx.restore();$('mbPageLabel').textContent='Page '+r.page+' / '+r.pdf.numPages;\n  if(st.role==='eleve')await setProgress(r.id,{last_kind:r.kind,[r.kind==='sujet'?'subject_page':'correction_page']:r.page});\n }catch(e){if(r===mb.reader)toast('Lecture : '+e.message)}finally{mb.reading=false}\n}\nfunction invitePage(){return title('Classes','Inviter mes élèves','Partagez le code, le lien ou le QR code de votre classe.')+st.groups.filter(g=>g.active&&!g.deleted_at&&!g.suspended_at).map(g=>'<section class=\"card\"><h3>'+esc(g.name)+'</h3><div class=\"codebox\"><strong>'+esc(g.join_code)+'</strong>'+btn('Copier','copy','btn','copy','data-code=\"'+esc(g.join_code)+'\"')+'</div><button type=\"button\" class=\"btn primary\" data-study=\"invite\" data-id=\"'+esc(g.id)+'\">Lien et QR code</button></section>').join('')+(st.groups.length?'':emptyCard('Créez une classe pour inviter vos élèves.'))}\nfunction progressPage(){return title('Révisions','Mes progrès','Retrouvez votre activité.')+'<div class=\"grid2\">'+stat('Sujets consultés',mb.progress.length,'file')+stat('Favoris',mb.progress.filter(p=>p.favorite).length,'book')+'</div>'+(ege()?goTo('student-ege','Mon dossier EGE','folder'):'')+mb.progress.map(p=>{const x=mb.rows.find(r=>r.id===p.exam_id);return x?'<section class=\"card\"><h3>'+esc(x.title)+'</h3><p>Dernière page : '+(p.last_kind==='sujet'?p.subject_page:p.correction_page)+'</p><button class=\"btn primary\" data-mb=\"read\" data-id=\"'+esc(x.id)+'\" data-kind=\"'+esc(p.last_kind)+'\">Reprendre</button></section>':''}).join('')}\nfunction backgroundEditor(){\n const ads=st.ads.filter(a=>st.role==='admin'||a.submitted_by===st.user?.id);\n return ads.length?'<section class=\"card\"><h3>Images d’arrière-plan facultatives</h3>'+ads.map(a=>'<div class=\"mb-background\"><strong>'+esc(a.subjects||a.title)+'</strong>'+(a.background_path?'<img src=\"'+esc(backgroundURL(a))+'\" alt=\"Image d’arrière-plan actuelle\">':'<p class=\"form-note\">Sans image : carte blanche.</p>')+'<input class=\"input\" type=\"file\" accept=\"image/jpeg,image/png,image/webp\" data-mb-bg=\"'+esc(a.id)+'\"><button class=\"btn\" data-mb=\"background-save\" data-id=\"'+esc(a.id)+'\">Enregistrer l’image</button>'+(a.background_path?'<button class=\"btn\" data-mb=\"background-remove\" data-id=\"'+esc(a.id)+'\">Retirer</button>':'')+'</div>').join('')+'</section>':'';\n}\nfunction backgroundURL(ad){return /^[0-9a-f-]{36}\\/[0-9a-f-]{36}\\.jpg$/.test(ad?.background_path||'')?DB_URL+'/storage/v1/object/public/ege2027-annonce-photos/'+ad.background_path:''}\nasync function saveBackground(id,remove){\n if(!examiner())throw Error('Accès interdit.');let path=null;\n if(!remove){const file=document.querySelector('[data-mb-bg=\"'+CSS.escape(id)+'\"]')?.files[0];if(!file)throw Error('Choisissez une image.');EGEAccount.photo.check(file);\n const body=await EGEAccount.photo.jpeg(file,{size:1200,square:false,max:3*1024*1024});path=st.user.id+'/'+EGEAccount.photo.uuid()+'.jpg';const res=await st.db.storage.from('ege2027-annonce-photos').upload(path,body,{contentType:'image/jpeg',upsert:false});if(res.error)throw res.error;}\n const res=await st.db.rpc('mon_bac_ad_background',{p_ad:id,p_path:path});if(res.error)throw res.error;await loadAds();render();toast('Image enregistrée.');\n}\nconst prevBanner=adBanner;adBanner=function(place){const html=prevBanner(place),url=backgroundURL(egeAdFor(place));return url?html.replace('data-ege-ad-slot=','style=\"--mb-ad-image:url(\\''+esc(url)+'\\')\" data-ege-ad-slot='):html};\nconst oldView=view;\nview=function(){\n if(!allowed()||st.role==='eleve'&&EGEAccount.incomplete(st.profile,'eleve'))return oldView();\n if(st.role==='enseignant'&&!approved())return oldView();\n if(st.role==='eleve'&&!ege()&&dossierScreens.includes(st.screen))return studentHomeMB();\n switch(st.screen){\n  case 'student-home':return studentHomeMB();case 'student-ege':return oldStudentHome();case 'student-group':return studentGroupMB();\n  case 'student-exams':return examList('sujet');case 'student-corrections':return examList('corrige');case 'student-favorites':return examList('favoris');\n  case 'student-progress':return progressPage();case 'student-help':return title('Aide','Aide et assistance','Contactez l’administration si vous rencontrez une difficulté.')+box(contactAdmin('Bonjour, j’ai besoin d’aide pour monAvenir.')+(ege()?goTo('student-service','Aide au dossier','chat'):''));\n  case 'teacher-home':return teacherHomeMB();case 'teacher-exams':return examList('sujet');case 'teacher-invites':return invitePage();\n  case 'teacher-announcements':return title('Publicité','Mon annonce','Proposez vos cours de soutien.')+teacherAdPanel()+backgroundEditor();\n  case 'admin-home':return adminHomeMB();case 'admin-exams':return examList('sujet');\n  case 'teacher-exam-edit':case 'admin-exam-edit':return editPage();\n  case 'admin-announcements':return title('Gestion','Annonces','Validez les annonces avant publication.')+egeAdminAdPanel()+backgroundEditor();\n  case 'admin-settings':return title('Gestion','Paramètres','Tarifs, accès et confidentialité.')+box(goTo('admin-monitor','Outils et tarifs','settings'));\n  default:return oldView();\n }\n};\nconst oldRender=render;render=function(){\n const role=st.user?st.role:st.desired||'eleve';\n document.documentElement.dataset.mbRole=role;\n const color='#c60835';\n document.querySelector('meta[name=\"theme-color\"]')?.setAttribute('content',color);\n oldRender();\n document.title='monAvenir — Votre espace pédagogique';\n};\ndocument.addEventListener('change',e=>{\n const key=e.target.dataset.mbFilter;if(key){mb[key]=e.target.value;render()}\n const id=e.target.dataset.mbBg;if(id&&e.target.files[0]){const old=e.target.parentElement.querySelector('img');if(old)old.remove();const img=document.createElement('img');img.alt='Aperçu de l’image';const url=URL.createObjectURL(e.target.files[0]);img.src=url;img.onload=img.onerror=()=>URL.revokeObjectURL(url);e.target.before(img)}\n});\ndocument.addEventListener('submit',async e=>{if(e.target.id==='mbSearchForm'){e.preventDefault();mb.query=$('mbQuery').value.trim();render();return}if(e.target.id!=='mbExamForm')return;e.preventDefault();if(mb.saving)return;mb.saving=true;const button=e.target.querySelector('button[type=\"submit\"]');if(button)button.disabled=true;try{await saveExam()}catch(error){const message=examTransient(error)?'Connexion temporairement indisponible. Réessayez : le même brouillon sera utilisé.':(error.message||'Le dépôt a échoué.');examSaveStatus(message);toast(message)}finally{mb.saving=false;if(button)button.disabled=false}});\ndocument.addEventListener('click',async e=>{\n const button=e.target.closest?.('[data-mb]');if(!button)return;e.preventDefault();\n const a=button.dataset.mb,id=button.dataset.id,kind=button.dataset.kind;\n if(button.disabled)return;\n try{\n  if(a==='close-reader'){closeReader();return}\n  if(a==='prev-page'||a==='next-page'){if(!mb.reader?.pdf||mb.reading)return;mb.reader.page=Math.max(1,Math.min(mb.reader.pdf.numPages,mb.reader.page+(a==='next-page'?1:-1)));await drawPage();return}\n  if(a==='read'){await openReader(id,kind);return}\n  if(a==='refresh'){await loadExams();return}\n  if(a==='favorite'){const fav=mb.progress.find(p=>p.exam_id===id)?.favorite;await setProgress(id,{favorite:!fav});render();return}\n  if(a==='invite'){const text='https://monavenir.janagaleh.com/?classe='+encodeURIComponent(button.dataset.code);if(navigator.share){await navigator.share({title:'monAvenir',text:'Code de classe : '+button.dataset.code,url:text})}else{await navigator.clipboard.writeText(text);toast('Lien copié.')}return}\n  if(!examiner())throw Error('Accès interdit.');\n  if(a==='new'||a==='new-correction'||a==='edit'){if(a==='new-correction'&&st.role!=='admin')throw Error('Accès interdit.');if(mb.saving){toast('Le transfert est en cours.');return}mb.pendingDraftId=null;if(a!=='edit')mb.multiCreated=[];mb.edit=a==='new'?{}:a==='new-correction'?{has_subject:false}:mb.rows.find(r=>r.id===id);if(!mb.edit)throw Error('Document inaccessible.');go(st.role==='admin'?'admin-exam-edit':'teacher-exam-edit');return}\n  if(a==='submit'){window.MB69?.openShare(id);return}\n  if(a==='publish'||a==='request'||a==='unpublish'||a==='feature'){\n   if(st.role!=='admin'&&!(a==='unpublish'&&mb.rows.some(r=>r.id===id&&r.created_by===st.user?.id)))throw Error('Accès interdit.');\n   if(a==='publish'){if(!await window.MBDialog.confirm('Publier ce document pour la série et le niveau sélectionnés ?'))return;await changeExam(id,{status:'published',review_comment:cleaned($('mbReviewComment')?.value)});go('admin-exams')}\n   if(a==='request'){await changeExam(id,{status:'changes_requested',review_comment:cleaned($('mbReviewComment')?.value)});go('admin-exams')}\n   if(a==='unpublish'){if(await window.MBDialog.confirm('Retirer ce sujet du catalogue ?'))await changeExam(id,{status:'draft'})}\n   if(a==='feature')await changeExam(id,{featured:!mb.rows.find(r=>r.id===id)?.featured});\n   return;\n  }\n  if(a==='background-save'||a==='background-remove'){await saveBackground(id,a==='background-remove');return}\n }catch(error){if(error?.name!=='AbortError')toast(error.message)}\n});\ndocument.addEventListener('click',e=>{const b=e.target.closest?.('[data-act]');if(st.role==='eleve'&&!ege()&&b&&['newdoc','opendoc','legacy','annex'].includes(b.dataset.act)){e.preventDefault();e.stopImmediatePropagation();toast('Mon EGE est réservé aux élèves de Terminale SG (GFM, OGRH, IAG).')}},true);\nwindow.MonBac={level,series:SERIES,egeSeries:EGE_SERIES,loadExams,state:mb,changeExam};\n})();\n\n"],"/mon-bac-tools.js":["application/javascript; charset=utf-8",false,"/* Outils monAvenir, phase 1. Pas de paiement en ligne, de suivi publicitaire individuel ni d'IA externe. */\n(()=>{'use strict';\nObject.assign(paths,{\n calculator:'<rect x=\"5\" y=\"2\" width=\"14\" height=\"20\" rx=\"3\"/><path d=\"M8 7h8M8 12h2m4 0h2M8 16h2m4 0h2M8 19h2m4 0h2\"/>',\n 'clipboard-check':'<rect x=\"5\" y=\"5\" width=\"14\" height=\"17\" rx=\"2\"/><rect x=\"9\" y=\"2\" width=\"6\" height=\"5\" rx=\"1\"/><path d=\"m8 14 3 3 5-6\"/>',\n bookmark:'<path d=\"M6 4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18l-6-4-6 4z\"/>',\n 'help-circle':'<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9.3 9a2.7 2.7 0 1 1 4.4 2.1c-1 .7-1.7 1.4-1.7 3M12 17h.01\"/>',\n 'folder-open':'<path d=\"M3 19V6a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v2M3 19l3-8h16l-3 8z\"/>',\n 'user-check':'<circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M2 21v-2a7 7 0 0 1 12-5m1 2 3 3 5-6\"/>',\n megaphone:'<path d=\"M3 10v4a2 2 0 0 0 2 2h3l11 5V3L8 8H5a2 2 0 0 0-2 2zM8 16l2 5h3m6-9h3\"/>',\n 'hand-heart':'<path d=\"M3 13h4l4 3h4a2 2 0 0 1 0 4H9l-6-4M15 16l5-3a2 2 0 0 1 2 3l-7 5H8M12 11 7 6a3 3 0 0 1 5-4 3 3 0 0 1 5 4z\"/>',\n wallet:'<rect x=\"3\" y=\"5\" width=\"18\" height=\"15\" rx=\"3\"/><path d=\"M3 8h15m3 4h-6a3 3 0 0 0 0 6h6M16 15h.01\"/>'\n});\nconst norm=x=>String(x??'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();\nfunction matches(row,query){const hay=norm([row.title,row.subject,row.series,row.academic_level,row.exam_year,row.session,row.has_correction?'corrigé':''].join(' '));return norm(query).split(' ').filter(Boolean).every(q=>hay.includes(q==='maths'?'math':q==='gf'?'gestion':q==='pg'?'principes':q));}\nconst number=v=>String(v??'').trim()===''?null:Number(String(v).replace(',','.'));\nfunction weighted(subjects,goal=10){\n let sum=0,known=0,total=0;const invalid=[];\n subjects.forEach((r,i)=>{const c=number(r.coef),n=number(r.note);if(!String(r.name??'').trim()||!Number.isFinite(c)||c<=0||c>100||n!==null&&(!Number.isFinite(n)||n<0||n>20)){invalid.push(i);return}total+=c;if(n!==null){known+=c;sum+=c*n}});\n const missing=total-known,needed=missing>0&&Number.isFinite(goal)?(goal*total-sum)/missing:null;\n return {invalid,sum,known,total,missing,average:known?sum/known:null,needed};\n}\n// Parseur mathématique borné, pas d'eval, Function, accès aux objets ni code externe.\nfunction calculate(source,degrees=true){\n const src=String(source).replace(/\\s+/g,'').replace(/,/g,'.').replace(/×/g,'*').replace(/÷/g,'/').replace(/−/g,'-').replace(/π/g,'pi').toLowerCase();\n if(!src||src.length>220)throw Error('Expression vide ou trop longue.');\n const tokens=src.match(/(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?|[a-z]+|[+*/^()%-]/g)||[];\n if(tokens.join('')!==src||tokens.length>160)throw Error('Expression invalide.');let i=0;\n const angle=x=>degrees?x*Math.PI/180:x;\n const funcs={sin:x=>Math.sin(angle(x)),cos:x=>Math.cos(angle(x)),tan:x=>Math.tan(angle(x)),sqrt:Math.sqrt,log:Math.log10,ln:Math.log,abs:Math.abs,exp:Math.exp};\n function atom(){const t=tokens[i++];if(t==='('){const n=expr(0);if(tokens[i++]!==')')throw Error('Parenthèse manquante.');return n}if(t==='-'||t==='+')return (t==='-'?-1:1)*expr(3);if(t==='pi')return Math.PI;if(t==='e')return Math.E;if(Object.hasOwn(funcs,t)){if(tokens[i++]!=='(')throw Error('Ajoutez une parenthèse.');const n=expr(0);if(tokens[i++]!==')')throw Error('Parenthèse manquante.');return funcs[t](n)}if(/^(?:\\d|\\.)/.test(t||''))return Number(t);throw Error('Expression invalide.')}\n function expr(min){let left=atom();while(i<tokens.length){const op=tokens[i];if(op==='%'){if(4<min)break;i++;left/=100;continue}const p={'+':1,'-':1,'*':2,'/':2,'^':3}[op];if(p===undefined||p<min)break;i++;const right=expr(p+(op==='^'?0:1));left=op==='+'?left+right:op==='-'?left-right:op==='*'?left*right:op==='/'?left/right:left**right}return left}\n const value=expr(0);if(i!==tokens.length||!Number.isFinite(value))throw Error('Calcul impossible. Vérifiez l’expression.');return Number(value.toPrecision(12));\n}\nconst money=x=>new Intl.NumberFormat('fr-DJ',{maximumFractionDigits:2}).format(x||0)+' FDJ';\nconst fmt=x=>x===null?'—':new Intl.NumberFormat('fr-FR',{maximumFractionDigits:2,minimumFractionDigits:2}).format(x);\nconst date=()=>new Date(Date.now()+3*3600000).toISOString().slice(0,10);\nconst btnGo=(screen,label,icon)=>btn(label,'goto','btn',icon,'data-to=\"'+screen+'\"');\nconst action=(a,label,data='',primary=false)=>'<button type=\"button\" class=\"btn'+(primary?' primary':'')+'\" data-mbt=\"'+a+'\" '+data+'>'+esc(label)+'</button>';\nconst field=(label,name,value='',attrs='')=>'<label class=\"field\"><span>'+esc(label)+'</span><input class=\"input\" name=\"'+name+'\" value=\"'+esc(value??'')+'\" '+attrs+'></label>';\nconst select=(label,name,options,value='')=>'<label class=\"field\"><span>'+esc(label)+'</span><select class=\"select\" name=\"'+name+'\">'+options.map(([v,t])=>'<option value=\"'+esc(v)+'\" '+(v===value?'selected':'')+'>'+esc(t)+'</option>').join('')+'</select></label>';\nconst state={owner:null,loading:false,error:'',simulations:[],subjects:[{name:'',note:'',coef:1}],simName:'Ma simulation',simId:null,goal:10,expression:'',answer:'',degrees:true,courses:[],members:[],records:[],course:null,mode:'groupe',month:date().slice(0,7),notices:[],reads:[],loaded:new Set(),serial:0};\nconst supportUI={tab:'students',form:'',query:'',status:'all',page:0};\nconst resetSupport=()=>Object.assign(supportUI,{tab:'students',form:'',query:'',status:'all',page:0});\nconst student=()=>!!st.user&&st.role==='eleve'&&!EGEAccount.blocked(st.profile)&&!EGEAccount.incomplete(st.profile,'eleve');\nconst teacher=()=>!!st.user&&st.role==='enseignant'&&st.teacher?.status==='approved'&&!EGEAccount.blocked(st.profile);\nconst admin=()=>!!st.user&&st.role==='admin'&&!EGEAccount.blocked(st.profile);\nconst schoolTools=['student-simulator','student-calculator','student-notices','teacher-support','teacher-notices','admin-support','admin-notices','admin-simulations'];\nconst permission=s=>s.startsWith('student-')?student():s.startsWith('teacher-')?teacher():admin();\nscreenList.push(...schoolTools.map((s,i)=>[s,['Simulateur Bac','Calculatrice scientifique','Notifications','Mon soutien scolaire','Messages aux classes','Soutien scolaire','Notifications ciblées','Simulations Bac'][i]]));\nfunction resetOwner(){if(state.owner===st.user?.id)return;resetSupport();Object.assign(state,{owner:st.user?.id||null,loading:false,error:'',simulations:[],subjects:[{name:'',note:'',coef:1}],simName:'Ma simulation',simId:null,goal:10,expression:'',answer:'',degrees:true,courses:[],members:[],records:[],course:null,mode:'groupe',month:date().slice(0,7),notices:[],reads:[],loaded:new Set(),serial:state.serial+1});}\nasync function rows(table){const r=await st.db.from(table).select('*').limit(1000);if(r.error)throw r.error;return r.data||[]}\nasync function load(kind){resetOwner();if(!st.db||!st.user)return;const serial=state.serial,uid=st.user.id;state.error='';try{let result;\n if(kind==='support')result=await Promise.all(['mon_bac_support_courses','mon_bac_support_members','mon_bac_support_records'].map(rows));\n else if(kind==='sim')result=[await rows('mon_bac_simulations')];\n else result=await Promise.all([rows('mon_bac_notices'),student()?rows('mon_bac_notice_reads'):Promise.resolve([])]);\n if(serial!==state.serial||uid!==st.user?.id)return;\n if(kind==='support')[state.courses,state.members,state.records]=result;\n else if(kind==='sim')[state.simulations]=result;\n else [state.notices,state.reads]=result;\n state.loaded.add(kind);\n }catch(e){if(serial===state.serial)state.error='Impossible de charger les données : '+(e?.message||'réessayez.')}\n if(serial===state.serial&&(schoolTools.includes(st.screen)||st.screen==='student-home'))render();\n}\nfunction saveOrThrow(r){if(r.error)throw r.error;return r.data}\nconst oldGo=go;go=function(screen){if(schoolTools.includes(screen)&&!permission(screen)){toast('Accès réservé à votre espace.');return}resetOwner();if(['teacher-support','admin-support'].includes(screen)&&screen!==st.screen){state.course=null;resetSupport()}oldGo(screen);if(screen.includes('support'))load('support');else if(screen.includes('simulat'))load('sim');else if(screen.includes('notices'))load('notices')};\nconst oldLoad=loadAll;loadAll=async function(){resetOwner();await oldLoad();if(student())await load('notices')};\nconst oldSignOut=signOut;signOut=async function(){try{return await oldSignOut()}finally{resetOwner();if(!st.user)hideFloat()}};\nfunction simResult(){const r=weighted(state.subjects,number(state.goal));if(r.invalid.length)return '<p class=\"form-note\">Renseignez chaque matière et un coefficient positif (maximum 100). Note facultative de 0 à 20.</p>';\n let advice=r.needed===null?'Toutes les notes sont saisies.':r.needed>20?'Objectif impossible avec les notes restantes.':r.needed<=0?'Objectif déjà atteint, même avec 0 aux matières restantes.':'Moyenne nécessaire sur les matières restantes : '+fmt(r.needed)+' / 20.';\n return '<div class=\"mb-sim-result\"><small>'+ (r.missing?'Moyenne provisoire':'Moyenne estimée')+'</small><strong>'+fmt(r.average)+' / 20</strong><span>'+fmt(r.sum)+' points · '+fmt(r.known)+' / '+fmt(r.total)+' coefficients</span><p>'+esc(advice)+'</p></div>';\n}\nfunction simPage(){return title('Mes outils','Simulateur Bac','Vos matières, notes et coefficients. Simulation indicative, pas un résultat officiel.')+\n '<form id=\"mbtSim\" class=\"card\">'+field('Nom de la simulation','name',state.simName,'maxlength=\"100\" required')+'<div class=\"mb-sim-grid\"><span>Matière</span><span>Note /20</span><span>Coef.</span><span></span>'+state.subjects.map((r,i)=>'<input class=\"input\" aria-label=\"Matière '+(i+1)+'\" data-sim=\"name\" data-index=\"'+i+'\" value=\"'+esc(r.name)+'\" maxlength=\"100\" placeholder=\"Matière\"><input class=\"input\" type=\"number\" inputmode=\"decimal\" aria-label=\"Note '+(i+1)+'\" data-sim=\"note\" data-index=\"'+i+'\" value=\"'+esc(r.note)+'\" min=\"0\" max=\"20\" step=\"0.01\" placeholder=\"—\"><input class=\"input\" type=\"number\" aria-label=\"Coefficient '+(i+1)+'\" data-sim=\"coef\" data-index=\"'+i+'\" value=\"'+esc(r.coef)+'\" min=\"0.01\" max=\"100\" step=\"0.01\"><button type=\"button\" class=\"mb-icon-btn\" data-mbt=\"sim-remove\" data-index=\"'+i+'\" aria-label=\"Retirer la matière\">'+I('trash')+'</button>').join('')+'</div>'+action('sim-add','+ Ajouter une matière')+field('Objectif de moyenne /20','goal',state.goal,'type=\"number\" min=\"0\" max=\"20\" step=\"0.01\" required')+'<div id=\"mbtResult\" aria-live=\"polite\">'+simResult()+'</div><div class=\"mb-actions\"><button class=\"btn primary\" type=\"submit\">Enregistrer</button>'+action('sim-new','Nouvelle simulation')+'</div></form>'+\n '<div class=\"mb-actions\">'+btnGo('student-calculator','Calculatrice scientifique','calculator')+'</div><section class=\"card\"><h3>Mes simulations</h3>'+ (state.simulations.length?state.simulations.map(s=>'<div class=\"mb-list-row\"><strong>'+esc(s.name)+'</strong><div>'+action('sim-open','Ouvrir','data-id=\"'+esc(s.id)+'\"')+action('sim-delete','Supprimer','data-id=\"'+esc(s.id)+'\"')+'</div></div>').join(''):'<p>Pas encore de simulation enregistrée.</p>')+'</section>';\n}\nfunction calcPage(){const keys=['sin(','cos(','tan(','sqrt(','log(','ln(','π','e','(',')','^','%','7','8','9','÷','4','5','6','×','1','2','3','−','0','.','⌫','+'];return title('Mes outils','Calculatrice scientifique','Angles en degrés ou radians. Aucun calcul envoyé sur Internet.')+'<form class=\"card\" id=\"mbtCalc\">'+field('Expression','expression',state.expression,'maxlength=\"220\" autocomplete=\"off\" placeholder=\"ex. sqrt(25)+2^3\"')+'<output class=\"mb-calc-display\" id=\"mbtAnswer\" aria-live=\"polite\">'+esc(state.answer||'0')+'</output><div class=\"mb-actions\">'+action('calc-mode',state.degrees?'DEG':'RAD')+action('calc-clear','AC')+action('calc-copy','Réutiliser le résultat')+'</div><div class=\"mb-calc-grid\">'+keys.map(k=>'<button class=\"mb-calc-key\" type=\"button\" data-mbt=\"calc-key\" data-key=\"'+esc(k)+'\">'+esc(k)+'</button>').join('')+'</div><button class=\"btn primary full\" type=\"submit\">= Calculer</button></form>'+btnGo('student-simulator','Simulateur Bac','calculator');}\nfunction feed(){const items=state.notices.filter(n=>n.active).map(n=>({key:'notice:'+n.id,title:n.title,body:n.body,time:n.created_at}));if(student()){for(const r of MonBac.state.rows.filter(r=>r.status==='published'&&r.visibility!=='restricted'&&r.series===st.profile.series&&r.academic_level===MonBac.level(st.profile)&&r.published_at&&Date.now()-new Date(r.published_at).getTime()<30*864e5))items.push({key:'exam:'+r.id,title:'Nouveau sujet : '+r.title,body:r.subject+' · '+r.exam_year,time:r.published_at,exam:r.id});for(const s of window.MB69?.state.shares||[]){const r=MonBac.state.rows.find(x=>x.id===s.exam_id);if(r)items.push({key:'share:'+s.id,title:'Sujet partagé : '+r.title,body:s.message||r.subject,time:s.starts_at,exam:r.id})}}return items.sort((a,b)=>String(b.time).localeCompare(String(a.time)));}\nconst unread=()=>feed().filter(n=>!state.reads.some(r=>r.notice_key===n.key)).length;\nfunction noticePage(){if(student())return title('Messages','Notifications','Les sujets et messages de votre classe et de votre série.')+ (feed().length?feed().map(n=>'<article class=\"card\"><div class=\"mb-list-row\"><strong>'+esc(n.title)+'</strong>'+(!state.reads.some(r=>r.notice_key===n.key)?'<span class=\"badge red\">Nouveau</span>':'')+'</div><p>'+esc(n.body)+'</p><small>'+esc(String(n.time||'').slice(0,10))+'</small><div class=\"mb-actions\">'+action('notice-read','Marquer comme lu','data-key=\"'+esc(n.key)+'\"')+(n.exam?'<button class=\"btn primary\" data-mb=\"read\" data-id=\"'+esc(n.exam)+'\" data-kind=\"sujet\">Consulter le sujet</button>':'')+'</div></article>').join(''):box('Aucune notification pour le moment.'));\n const groups=st.groups.filter(g=>g.active&&!g.deleted_at&&!g.suspended_at&&(!teacher()||g.teacher_id===st.user.id));return title('Messages','Notifications ciblées',teacher()?'Envoyez un message aux membres d’une de vos classes.':'Adressez un message aux élèves d’une série ou d’une classe.')+'<form class=\"card\" id=\"mbtNotice\">'+(admin()?select('Public','audience',[['series','Série'],['group','Classe']]):'')+(groups.length?select('Classe','group_id',[['','Choisir une classe'],...groups.map(g=>[g.id,g.name])]):'<p class=\"form-note\">Vous n’avez pas encore de classe active.</p>')+(admin()?select('Série','series',MonBac.series.map(s=>[s,s]))+select('Niveau','level',[['','Tous les niveaux'],['Première','Première'],['Terminale','Terminale']]):'')+field('Titre','title','','required maxlength=\"100\"')+'<label class=\"field\"><span>Message</span><textarea name=\"body\" class=\"textarea\" maxlength=\"800\" required></textarea></label><button class=\"btn primary\" type=\"submit\">Envoyer</button></form>'+state.notices.map(n=>'<article class=\"card\"><strong>'+esc(n.title)+'</strong><p>'+esc(n.body)+'</p><p class=\"small\">'+esc(n.series||groups.find(g=>g.id===n.group_id)?.name||'Classe')+'</p>'+action('notice-toggle',n.active?'Retirer':'Réactiver','data-id=\"'+esc(n.id)+'\"')+'</article>').join('');}\nfunction balances(course,member,month){const matching=state.records.filter(r=>r.member_id===member.id&&r.for_month===month&&!r.cancelled);const paid=matching.filter(r=>r.kind==='paiement').reduce((s,r)=>s+Number(r.amount),0);const hours=matching.filter(r=>r.kind==='seance'&&r.attendance!=='absent').reduce((s,r)=>s+Number(r.hours),0);const due=course.fee_period==='heure'?hours*Number(course.fee):member.joined_on.slice(0,7)<=month&&member.active?Number(course.fee):0;return{paid,hours,due,balance:Math.max(0,due-paid)};}\nconst supportHead=(name,sub='')=>`<div class=\"mb77-heading\"><h1>${esc(name)}</h1><p>${esc(sub)}</p></div>`;\nconst supportBtn=(a,label,extra='',primary=false,icon='')=>`<button type=\"button\" class=\"mb77-btn${primary?' primary':''}\" data-mbt=\"${a}\" ${extra}>${icon?I(icon):''}<span>${esc(label)}</span></button>`;\nconst supportTabs=(items,active,act,attr)=>`<nav class=\"mb77-tabs\" aria-label=\"Rubriques du soutien\">${items.map(([key,label])=>`<button type=\"button\" data-mbt=\"${act}\" data-${attr}=\"${key}\" ${key===active?'aria-current=\"page\"':''}>${esc(label)}</button>`).join('')}</nav>`;\nconst supportStatus=x=>`<span class=\"mb77-status ${x?'live':'archived'}\">${x?'Actif':'Archivé'}</span>`;\nconst supportEmpty=msg=>`<div class=\"mb77-empty\">${I('folder')}<p>${esc(msg)}</p></div>`;\nconst supportMatch=(...v)=>norm(supportUI.query).split(' ').filter(Boolean).every(q=>norm(v.join(' ')).includes(q));\nconst supportActive=x=>supportUI.status==='all'||(supportUI.status==='active'?!!x.active:!x.active);\nfunction supportFilter(opts=[['all','Tous'],['active','Actifs'],['archived','Archivés']],placeholder='Rechercher…'){return `<form id=\"mb77Filter\" class=\"mb77-filter\"><label class=\"mb77-search\">${I('search')}<input type=\"search\" name=\"query\" value=\"${esc(supportUI.query)}\" placeholder=\"${esc(placeholder)}\" aria-label=\"Rechercher\"></label>${opts.length?`<select name=\"status\" aria-label=\"Statut\">${opts.map(([k,l])=>`<option value=\"${k}\" ${supportUI.status===k?'selected':''}>${l}</option>`).join('')}</select>`:''}<button type=\"submit\" aria-label=\"Rechercher\">${I('search')}</button></form>`;}\nfunction supportList(rows,make,empty){const n=Math.max(1,Math.ceil(rows.length/5));supportUI.page=Math.max(0,Math.min(supportUI.page,n-1));return `<section class=\"mb77-list\" aria-label=\"Résultats\"><div class=\"mb77-list-label\">${rows.length} résultat(s)</div>${rows.length?rows.slice(supportUI.page*5,(supportUI.page+1)*5).map(make).join(''):supportEmpty(empty)}${n>1?`<div class=\"mb77-pager\">${supportBtn('support-page','Précédent','data-delta=\"-1\" '+(supportUI.page===0?'disabled':''))}<span>${supportUI.page+1} / ${n}</span>${supportBtn('support-page','Suivant','data-delta=\"1\" '+(supportUI.page===n-1?'disabled':''))}</div>`:''}</section>`;}\nfunction supportPage(){const isAdmin=admin(),c=state.courses.find(c=>c.id===state.course),u=supportUI;\n if(!c){const name=state.mode==='groupe'?'Créer un groupe':'Ajouter un soutien à domicile';if(u.form==='course'&&!isAdmin)return supportHead(name,'Renseignez les informations essentielles.')+`<form class=\"card mb77-form\" id=\"mbtCourse\">${courseFields({mode:state.mode})}<button class=\"btn primary full\" type=\"submit\">Créer</button></form>`;\n const all=state.courses.filter(x=>x.mode===state.mode&&supportActive(x)&&supportMatch(x.name,x.subject,x.address,x.schedule,isAdmin?st.profiles?.find(p=>p.user_id===x.teacher_id)?.full_name:'')).sort((a,b)=>Number(b.active)-Number(a.active)||String(a.name).localeCompare(String(b.name),'fr'));\n return supportHead(isAdmin?'Gestion du soutien scolaire':'Mon soutien scolaire','Gérez vos cours, élèves et règlements.')+supportTabs([['groupe','En groupe'],['domicile','À domicile']],state.mode,'support-mode','mode')+(!isAdmin?supportBtn('support-form',name,'data-form=\"course\"',true,'plus'):'')+supportFilter()+supportList(all,x=>`<button type=\"button\" class=\"mb77-course\" data-mbt=\"support-open\" data-id=\"${esc(x.id)}\"><span class=\"mb77-icon\">${I(x.mode==='groupe'?'users':'home')}</span><span class=\"mb77-info\"><strong>${esc(x.name)}</strong><small>${esc(x.subject)}${x.schedule?' · '+esc(x.schedule):''}</small>${isAdmin?`<small>${esc(st.profiles?.find(p=>p.user_id===x.teacher_id)?.full_name||x.teacher_id)}</small>`:''}<b>${money(x.fee)} / ${esc(x.fee_period)}</b></span><span class=\"mb77-side\">${supportStatus(x.active)}${I('chevron')}</span></button>`,'Aucun soutien trouvé.');}\n const members=state.members.filter(m=>m.course_id===c.id),activeMembers=members.filter(m=>m.active),records=state.records.filter(r=>r.course_id===c.id&&r.for_month===state.month),tot=members.reduce((a,m)=>{const b=balances(c,m,state.month);return{paid:a.paid+b.paid,balance:a.balance+b.balance}},{paid:0,balance:0});\n const month=`<label class=\"mb77-month\"><span>Mois suivi</span><input id=\"mbtMonth\" type=\"month\" value=\"${esc(state.month)}\"></label>`;\n if(u.form==='member'&&c.active&&(!isAdmin||c.teacher_id))return supportHead('Ajouter un élève',c.name)+`<form class=\"card mb77-form\" id=\"mbtMember\">${field('Nom complet','full_name','','required maxlength=\"160\"')}${field('Date d’entrée','joined_on',date(),'type=\"date\" required')}<button class=\"btn primary full\">Ajouter</button></form>`;\n if(u.form==='record'&&c.active&&activeMembers.length){const pay=u.tab==='payments',kind=pay?'paiement':'seance';return supportHead(pay?'Enregistrer un règlement':'Enregistrer une séance',c.name)+`<form class=\"card mb77-form\" id=\"mbtRecord\"><input type=\"hidden\" name=\"kind\" value=\"${kind}\">${select('Élève','member_id',activeMembers.map(m=>[m.id,m.full_name]))}${field('Date','day',date(),'type=\"date\" required')}${field('Mois concerné','for_month',pay?state.month:date().slice(0,7),'type=\"month\" required')}<div class=\"mbt-session\" ${pay?'hidden':''}>${field('Durée (heures)','hours','1','type=\"number\" step=\"0.25\" min=\"0.25\" max=\"24\"')}${select('Présence','attendance',[['present','Présent'],['absent','Absent'],['retard','En retard']])}</div><div class=\"mbt-payment\" ${pay?'':'hidden'}>${field('Montant encaissé (FDJ)','amount','','type=\"number\" min=\"1\" step=\"0.01\" '+(pay?'required':''))}</div>${field('Note facultative','note','','maxlength=\"250\"')}<button class=\"btn primary full\">Enregistrer</button></form>`;}\n let html=supportHead(c.name,[c.subject,c.address,c.schedule].filter(Boolean).join(' · '))+`<div class=\"mb77-meta\">${supportStatus(c.active)}<span>${money(c.fee)} / ${esc(c.fee_period)}</span><span>${activeMembers.length} élève(s)</span></div>`+supportTabs([['students','Élèves'],['sessions','Séances'],['payments','Règlements'],...(!isAdmin?[['access','Accès']]:[]),['settings','Paramètres']],u.tab,'support-tab','tab');\n if(u.tab==='settings')return html+`<form class=\"card mb77-form\" id=\"mbtCourse\">${courseFields(c)}<button class=\"btn primary full\">Enregistrer</button></form>`+supportBtn('support-archive',c.active?'Archiver le soutien':'Réactiver le soutien',`data-id=\"${esc(c.id)}\"`);\n if(u.tab==='access')return html+`<p class=\"mb77-note\">Rattachez les comptes monAvenir de vos élèves avec leur code individuel.</p><div id=\"mb77Access\"></div>`;\n if(u.tab==='students'){html+=month+(c.active&&(!isAdmin||c.teacher_id)?supportBtn('support-form','Ajouter un élève','data-form=\"member\"',true,'plus'):'')+supportFilter(undefined,'Nom de l’élève…');const rows=members.filter(m=>supportActive(m)&&supportMatch(m.full_name)).sort((a,b)=>Number(b.active)-Number(a.active)||String(a.full_name).localeCompare(String(b.full_name),'fr'));return html+supportList(rows,m=>{const b=balances(c,m,state.month);return `<div class=\"mb77-row\"><span class=\"mb77-icon\">${I('user')}</span><div class=\"mb77-info\"><strong>${esc(m.full_name)}</strong><small>Payé ${money(b.paid)} · Reste ${money(b.balance)}</small><small>${fmt(b.hours)} h présentes</small></div><div class=\"mb77-side\">${supportStatus(m.active)}${supportBtn('member-toggle',m.active?'Archiver':'Réactiver',`data-id=\"${esc(m.id)}\"`)}</div></div>`},'Aucun élève trouvé.');}\n const pay=u.tab==='payments';html+=month+(pay?`<div class=\"mb77-stats\"><div><small>Encaissé</small><strong>${money(tot.paid)}</strong></div><div><small>Reste à régler</small><strong>${money(tot.balance)}</strong></div></div>`:'')+(c.active&&activeMembers.length?supportBtn('support-form',pay?'Ajouter un règlement':'Ajouter une séance','data-form=\"record\"',true,'plus'):'')+supportFilter([['all','Tous'],['active','Validés'],['archived','Annulés']],'Nom de l’élève…');\n const rows=records.filter(r=>r.kind===(pay?'paiement':'seance')&&(u.status==='all'||(u.status==='active'?!r.cancelled:r.cancelled))&&supportMatch(members.find(m=>m.id===r.member_id)?.full_name,r.day,r.note)).sort((a,b)=>String(b.day).localeCompare(String(a.day)));\n return html+supportList(rows,r=>`<div class=\"mb77-row\"><span class=\"mb77-icon\">${I(pay?'wallet':'clock')}</span><div class=\"mb77-info\"><strong>${esc(members.find(m=>m.id===r.member_id)?.full_name||'Élève')}</strong><small>${esc(r.day)} · ${pay?money(r.amount):esc(({present:'Présent',absent:'Absent',retard:'En retard'})[r.attendance]||r.attendance)+' · '+fmt(Number(r.hours))+' h'}</small>${r.note?`<small>${esc(r.note)}</small>`:''}</div><div class=\"mb77-side\">${r.cancelled?'<span class=\"mb77-status archived\">Annulé</span>':supportBtn('record-cancel','Annuler',`data-id=\"${esc(r.id)}\"`)}</div></div>`,pay?'Aucun règlement pour ce mois.':'Aucune séance pour ce mois.')+(pay?'<p class=\"mb77-note\">Suivi manuel, sans paiement en ligne. La somme due est calculée selon le tarif du soutien.</p>':'');}\nfunction courseFields(c){return field('Nom du '+(c.mode==='groupe'?'groupe':'soutien'),'name',c.name,'required maxlength=\"120\"')+field('Matière','subject',c.subject,'required maxlength=\"120\"')+field('Adresse / lieu','address',c.address,'maxlength=\"240\"')+field('Jours et horaires','schedule',c.schedule,'maxlength=\"180\"')+field('Tarif (FDJ)','fee',c.fee??0,'type=\"number\" min=\"0\" max=\"100000000\" step=\"0.01\" required')+select('Tarification','fee_period',[['mois','Par mois'],['heure','Par heure']],c.f