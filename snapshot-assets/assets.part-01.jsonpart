ions>.btn:last-child:nth-child(odd){grid-column:1/-1}\n .record-row>.row-content strong{font-size:16px}\n .app-header{min-height:68px;padding:12px 17px}\n .app-header .brandname{font-size:17px}.app-header .brand-sub{font-size:10px}\n .app-header .header-right .btn{min-height:42px;padding:9px 10px}\n .ege-intro-app .main,.ege-intro-app .main.intro-main,.ege-intro-app .main.login-main{padding:28px 17px 36px}\n .ege-onboard-new .onboard-top{margin:0 0 22px}\n .ege-onboard-new .rolecards{grid-template-columns:1fr;gap:12px}\n .ege-onboard-new .rolecard{padding:19px 18px;min-height:100px}\n .ege-onboard-new .onlead{font-size:13px}\n .tabset{gap:6px;background:transparent;padding:0}\n .tabset>.btn,.tabset>.tab{min-height:44px;font-size:12px;padding:10px 12px;border:1px solid var(--line);background:#fff}\n .tabset>.btn.primary,.tabset>.tab.active{background:var(--navy);color:#fff;border-color:var(--navy)}\n .card-head{align-items:flex-start;flex-wrap:wrap}\n .stage-review>.inline-actions{grid-template-columns:minmax(0,1fr)}\n}\n@media(max-width:360px){.app-header .brand-sub{display:none}.app-header .brandname{font-size:16px}.card{padding:16px}.page-head h1{font-size:25px}.record-row>.inline-actions>.btn{font-size:11px}}\n@media(max-width:800px){.btn.smol,.tab,.step,.backbtn,.inline-link{min-height:44px}.password-toggle{width:44px;height:44px}.password-wrap input{padding-right:56px}.ege-onboard-new .ege-install-entry .btn{width:100%}}\n\n/* En-tête commun : connexion directe et aide sur toutes les vues sauf l’accueil. */\n.app-header.ege-shared-header{height:auto;min-height:72px;width:100%;max-width:none;margin:0;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 24px;background:#fff;color:var(--ink);border:0;border-bottom:1px solid var(--line);box-shadow:none;position:relative;z-index:40}\n.ege-shared-header .brand{display:flex;align-items:center;gap:11px;min-width:0;flex:0 1 auto;margin:0;padding:0;color:#15283f;text-decoration:none;background:none;border:0}\n.ege-shared-header .brandmark{display:grid;place-items:center;background:#c91b2c;color:#fff;width:40px;height:40px;flex:0 0 40px;border-radius:12px;font:850 14px/1 system-ui}\n.ege-shared-header .brandname{display:block;font-size:18px;font-weight:800;line-height:1.3;white-space:nowrap;letter-spacing:-.5px}\n.ege-shared-header .brand-sub{display:block;font-size:10px;color:#66768a;line-height:1.5;margin-top:2px}\n.ege-header-actions{display:flex;align-items:center;gap:8px;flex:0 0 auto}\n.ege-header-auth,.ege-header-help{display:inline-flex;align-items:center;justify-content:center;min-height:44px;border:1px solid #dfe5ee;border-radius:11px;background:#fff;color:#24364c;font-size:12px;line-height:1.35;font-weight:750;padding:10px 12px;text-decoration:none;box-shadow:none;white-space:nowrap;cursor:pointer}\n.ege-header-help{width:44px;min-width:44px;padding:0;font-size:19px;color:#52647c}\n.ege-header-auth:hover,.ege-header-help:hover{background:#f5f7fb}\n.ege-help-dialog{width:min(440px,calc(100vw - 32px));max-height:calc(100dvh - 40px);overflow:auto;margin:auto;padding:24px;border:1px solid #e5eaf1;border-radius:20px;background:#fff;color:#24364c;box-shadow:0 20px 70px #172a4133;z-index:9999;font:14px/1.7 system-ui}\n.ege-help-dialog::backdrop{background:#14233870;backdrop-filter:blur(3px)}\n.ege-help-heading{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:16px}\n.ege-help-heading h2{margin:0;font-size:23px;line-height:1.3;letter-spacing:-.5px}\n.ege-help-close{display:grid;place-items:center;min-height:44px;width:44px;flex:0 0 44px;border:0;border-radius:11px;background:#f1f4f8;color:#52647c;font-size:26px;padding:0}\n.ege-help-dialog p{font-size:13px;line-height:1.7;margin:0 0 16px}\n.ege-help-contact,.ege-help-profile{display:block;border:1px solid #dfe5ee;border-radius:11px;padding:12px 14px;min-height:44px;margin:12px 0;text-align:center;text-decoration:none;line-height:1.5;font-size:13px;font-weight:750;c