profile[hidden]{display:none}\n\n/* Demandes et devis : résumé lisible, une action principale, modification à la demande. */\n.service-requests{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px;align-items:start}\n.service-card.card{padding:24px;margin:0;border:1px solid #e3e8ef;border-radius:20px;background:#fff;box-shadow:0 3px 14px #20334b04;min-width:0}\n.service-card-header{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:22px;flex-wrap:wrap}\n.service-card-header>div{min-width:0;flex:1 1 160px}\n.service-eyebrow{display:block;font-size:10px;line-height:1.5;font-weight:750;color:#738095;letter-spacing:.6px;text-transform:uppercase;margin-bottom:5px}\n.service-card-header h2{margin:0;font-size:21px;line-height:1.35;letter-spacing:-.5px;overflow-wrap:break-word}\n.service-card-header>.badge{flex:0 0 auto;font-size:10px;line-height:1.4;padding:6px 10px;margin-top:3px}\n.service-field-label{display:block;font-size:11px;font-weight:700;line-height:1.5;color:#738095;margin-bottom:5px}\n.service-brief{margin-bottom:20px}\n.service-brief p{font-size:14px;line-height:1.65;margin:0;white-space:pre-wrap;overflow-wrap:anywhere;color:#33465f}\n.service-quote-summary{padding:18px;border:1px solid #e8ecf2;border-radius:14px;background:#f8fafc}\n.service-price-row{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}\n.service-card .quote-price{font-size:30px;font-weight:850;line-height:1.2;letter-spacing:-1px;margin:0;color:#15283f;overflow-wrap:anywhere}\n.service-quote-version{font-size:11px;line-height:1.4;white-space:nowrap;color:#66768a;background:#fff;border:1px solid #e5eaf1;border-radius:7px;padding:5px 8px}\n.service-card .service-quote-details{font-size:13px;line-height:1.65;white-space:pre-wrap;overflow-wrap:anywhere;color:#52647c;margin:14px 0 0}\n.service-card .service-quote-date{font-size:11px;line-height:1.6;color:#738095;margin:12px 0 0}\n.service-card-actions{display:grid;gap:10px;margin-top:20px;padding-top:20px;border-top:1px solid #edf0f5}\n.service-secondary-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;min-width:0}\n.service-secondary-actions>.btn:only-child{grid-column:1/-1}\n.service-card .btn,.service-new-request .btn{min-height:46px;border-radius:11px;font-size:12px;font-weight:750;line-height:1.45;max-width:100%;white-space:normal;padding:11px 12px;overflow-wrap:break-word}\n.service-card .service-main-action,.service-new-request .service-main-action{width:100%;min-height:48px;font-size:13px;padding:13px 16px;box-shadow:none;margin:0}\n.service-card .service-secondary{background:#fff;color:#33465f;border:1px solid #dfe5ee}\n.service-card .service-danger{background:#fff8f9;color:#a82034;border:1px solid #f0dde1}\n.service-card .service-cancel{background:transparent;border-color:transparent;color:#8c5360;min-height:44px}\n.service-quote-editor{margin-top:20px;padding-top:20px;border-top:1px solid #edf0f5}\n.service-quote-editor[hidden]{display:none!important}\n.service-quote-editor h3,.service-initial-quote h3{font-size:16px;margin:0 0 18px;line-height:1.4}\n.service-quote-form{gap:18px}\n.service-quote-form .field{margin:0;gap:8px}\n.service-quote-form .field>span{font-size:12px;line-height:1.5}\n.service-quote-form .textarea{min-height:120px}\n.service-card .service-quote-warning{font-size:11px;line-height:1.65;padding:12px 14px;border-radius:10px;background:#fff8e9;color:#805f24;margin:0}\n.service-form-actions{display:grid;gap:8px}\n.service-card .service-waiting{font-size:12px;line-height:1.6;color:#805f24;margin:14px 0 0}\n.service-acceptance{display:grid;gap:14px;margin-top:20px}\n.service-acceptance .form-note{margin:0}\n.service-acceptance .form-check{font-size:12px;line-height:1.7}\n.service-new-request{max-width:740px;margin-bottom:24px}\n.service-new-request h2{margin-bottom:20px}\n@media(max-width:600px){\n .service-requests{grid-template-columns:minmax(0,1fr);gap:16px}\n .service-card.card{padding:20px;border-radius:18px}\n .service-card-header{gap:10px;margin-bottom:20px}\n .service-card-header>div{flex-basis:140px}.service-card-header h2{font-size:20px}\n .service-quote-summary{padding:16px}.service-card .quote-price{font-size:29px}\n .service-secondary-actions{gap:8px}\n .service-card-actions{margin-top:18px;padding-top:18px}\n .service-card .btn{min-height:46px;font-size:12px;padding:11px 10px}\n .service-card .service-main-action{min-height:48px;font-size:13px;padding:13px 12px}\n .service-quote-form .input,.service-quote-form .textarea{font-size:16px}\n}\n@media(max-width:340px){.service-card.card{padding:17px}.service-secondary-actions{grid-template-columns:minmax(0,1fr)}.service-card-header>div{flex-basis:120px}}\n.service-card.service-editing>.service-card-actions{display:none}\n\n/* Information de confidentialité, publique et lisible sur téléphone. */\n.privacy-page{max-width:780px;margin:0 auto;color:#33465f}\n.privacy-page .page-head{margin-bottom:12px}\n.privacy-updated{font-size:12px;color:#738095;margin:0 0 22px}\n.privacy-summary{padding:20px;border:1px solid #dfe8f5;border-radius:15px;background:#f0f5fc;margin-bottom:22px}\n.privacy-summary strong{color:#15283f;font-size:15px}.privacy-summary p{font-size:14px;line-height:1.75;margin:8px 0 0}\n.privacy-toc{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 14px;padding:18px;border:1px solid #e5eaf1;border-radius:14px;background:#fff;margin-bottom:28px}\n.privacy-toc a{display:flex;align-items:center;font-size:12px;line-height:1.5;min-height:40px;color:#405d7c;text-decoration:underline;text-underline-offset:3px}\n.privacy-section{padding:24px 0;border-bottom:1px solid #e5eaf1;scroll-margin-top:20px}\n.privacy-section h2{font-size:21px;line-height:1.35;letter-spacing:-.4px;margin:0 0 14px;color:#15283f}\n.privacy-section p,.privacy-section li{font-size:14px;line-height:1.8;overflow-wrap:break-word}\n.privacy-section p{margin:0 0 14px}.privacy-section p:last-child{margin-bottom:0}.privacy-section ul{padding-left:21px;margin:0 0 16px}.privacy-section li+li{margin-top:10px}\n.privacy-back{margin-top:26px}\n.privacy-footer{margin:28px auto 0;padding:18px 0 0;border-top:1px solid #edf0f5;text-align:center}\n.privacy-footer a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;font-size:12px;line-height:1.5;color:#66768a;text-decoration:underline;text-underline-offset:3px}\n.signup-privacy-note{padding:12px 14px;border-radius:11px;background:#f7f9fc}.signup-privacy-note a{color:#a91e32;text-decoration:underline}\n@media(max-width:600px){.privacy-toc{grid-template-columns:minmax(0,1fr);gap:4px;padding:14px}.privacy-toc a{min-height:44px}.privacy-section{padding:22px 0}.privacy-section h2{font-size:20px}.privacy-summary{padding:17px}.privacy-page .page-head h1{font-size:27px}.privacy-footer{margin-top:24px}}\n\n/* Mentions discrètes en pied de page. */\n.privacy-footer{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:4px 18px}\n.ege-copyright{font-size:11px;line-height:1.7;color:#738095;margin:0;overflow-wrap:break-word}\n.privacy-footer a{font-size:11px}\n.ege-legacy-footer{margin:26px 18px 0;padding:18px 0 24px}\n.ege-legacy-credit{flex-basis:100%;font-size:10px;line-height:1.6;color:#8a96a7;margin:0 0 6px}\n@media(max-width:600px){.privacy-footer{flex-direction:column;gap:2px}.ege-copyright{font-size:10px}.ege-legacy-footer{padding-bottom:calc(92px + env(safe-area-inset-bottom))}}\n.ege-footer-identity{display:grid;gap:2px;text-align:center;max-width:100%}\n.ege-design-credit{margin:0;font-size:11px;line-height:1.7;color:#738095}\n.ege-design-credit span{font-weight:650;color:#52647c}\n\n.admin-resource-tabs{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 24px}.admin-group-filters{margin:20px 0}.admin-group-filters>.field{max-width:560px}.admin-teacher-name{display:flex;gap:10px;align-items:center}.admin-teacher-name svg{width:22px;height:22px;flex:0 0 22px}.admin-teacher-name span{min-width:0;overflow-wrap:anywhere}.admin-group-primary{margin:18px 0}.admin-manage-details{margin-top:22px;padding-top:18px;border-top:1px solid #e5e9ef}.admin-manage-details>summary{cursor:pointer;font-weight:700;line-height:1.6;min-height:28px}.admin-manage-details[open]>summary{margin-bottom:14px}.admin-action-grid{display:flex;flex-wrap:wrap;gap:10px}.admin-action-grid .btn{white-space:normal}.admin-trash{color:#aa1330;border-color:#e7c6ce;background:white}.admin-code-setting{margin-top:20px}.admin-person-contact{line-height:1.9;overflow-wrap:anywhere}.admin-student-doc{padding:22px 0;border-bottom:1px solid #e5e9ef}.admin-student-doc:first-of-type{padding-top:10px}.admin-student-doc:last-child{border:0}.admin-linked-group{display:flex;gap:14px;justify-content:space-between;align-items:center;padding:12px 0}.admin-linked-group span{min-width:0;overflow-wrap:anywhere}.admin-linked-group .btn{flex:0 0 auto}.admin-group-card h2,.admin-student-doc h3{overflow-wrap:anywhere}.admin-group-card .card-head>div,.admin-student-doc .card-head>div{min-width:0}.admin-resource-tabs .btn{white-space:normal}@media(max-width:480px){.admin-action-grid>.btn{flex:1 1 calc(50% - 10px);min-width:0}.admin-group-primary>.btn{width:100%}.admin-resource-tabs>.btn{flex:1 1 0;min-width:0;padding-inline:10px}.admin-linked-group{flex-wrap:wrap}.admin-student-doc .card-head{align-items:flex-start}.admin-group-card .card-head{align-items:flex-start}}\n@media(max-width:480px){.codebox{flex-wrap:wrap;gap:12px}.codebox>div{min-width:0;max-width:100%}.codebox strong{overflow-wrap:anywhere}.codebox>.inline-actions{flex-wrap:wrap}}\n\n/* Identité commune : rectangle rouge, logo et texte blancs. */\n.app-header.ege-shared-header{background:#c8102e;color:#fff;min-height:88px;border:0;border-radius:0;padding:14px 24px;gap:12px}\n.ege-shared-header .brand{color:#fff}.ege-shared-header .brandmark{background:#ffffff0a;border:1.5px solid #ffffffb3;color:#fff;border-radius:10px;width:42px;height:44px;flex-basis:42px}.ege-shared-header .brandname{color:#fff}.ege-shared-header .brand-sub{color:#ffffffe6}\n.ege-header-actions{display:flex;align-items:center;gap:12px;min-width:0;flex:0 1 auto}.ege-header-person{display:flex;align-items:center;gap:9px;min-width:0}.ege-header-avatar{display:grid;place-items:center;position:relative;width:32px;height:32px;flex:0 0 32px;background:#ffffff24;color:#fff;border:1px solid #ffffff88;border-radius:50%;overflow:hidden;font-size:11px;font-weight:750}.ege-header-avatar img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}.ege-header-usertext{display:flex;flex-direction:column;align-items:flex-end;gap:3px;min-width:0;text-align:right}.ege-header-name{color:#fff;font-size:13px;line-height:1.4;max-width:18ch;overflow-wrap:anywhere;font-weight:750}.ege-header-person .ege-header-auth{border:0;border-radius:6px;padding:4px 0;background:transparent;color:#fff;font-size:11px;min-height:32px;text-decoration:underline;text-underline-offset:3px}.ege-header-auth{background:transparent;color:#fff;border-color:#ffffff66}.ege-header-help{width:36px;min-width:36px;min-height:36px;padding:0;border-color:#ffffff66;color:#fff;background:transparent}.ege-header-auth:hover,.ege-header-help:hover{background:#ffffff14;color:#fff}\n.ege-header-avatar [hidden]{display:none}.profile-photo-panel{display:flex;align-items:center;gap:18px;margin:0 0 24px;padding-bottom:24px;border-bottom:1px solid var(--line)}.profile-photo-portrait{position:relative;width:84px;height:84px;flex:0 0 84px;display:grid;place-items:center;border-radius:50%;overflow:hidden;background:#f4e7eb;color:#a51c34;font-size:23px;font-weight:800;border:1px solid #ead7dd}.profile-photo-portrait img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.profile-photo-body{min-width:0;flex:1}.profile-photo-body h2{font-size:17px;margin:0 0 6px}.profile-photo-body p{font-size:12px;color:var(--muted);line-height:1.65;margin:0 0 10px}.profile-photo-body input{width:100%;max-width:100%;font-size:12px}.profile-photo-body .btn{margin-top:10px}.profile-photo-state{min-height:20px;font-size:12px;line-height:1.6;margin:10px 0 0;color:#56677c}.profile-photo-error{color:#ab1831}.ege-ad-image-editor{margin:15px 0;padding:14px;border:1px solid var(--line);border-radius:12px}.ege-ad-image-editor>summary{font-weight:700}.ege-ad-image-editor input[type=file]{max-width:100%;width:100%;margin:12px 0}.ege-ad-image-editor .ege-ad-photo-preview{margin:12px 0}.ege-owned-ad-entry{padding:18px 0;border-bottom:1px solid var(--line)}.ege-owned-ad-entry>.list-row{border:0;padding:0}.ege-ad-thumb{width:64px;max-height:72px;object-fit:contain;border-radius:8px;flex:0 0 64px}.ege-ad-art img{object-fit:contain!important}.ege-ad-directory-image{object-fit:contain;background:#f7f9fc}\n.ege-class-start{max-width:510px;margin:0 auto}.ege-class-start>.ege-confirmed{display:flex;align-items:center;gap:7px;color:#147c50;font-size:12px;font-weight:700;margin-bottom:12px}.ege-class-start h1{font-size:30px;letter-spacing:-.8px;margin:0 0 12px}.ege-class-start>.intro{color:var(--muted);line-height:1.7;margin:0 0 24px}.ege-class-start .card{padding:24px}.ege-class-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px}.ege-class-head h2{font-size:18px;margin:0}.ege-class-head span{font-size:12px;color:var(--muted)}.ege-class-fields{display:grid;gap:20px}.ege-class-fields .btn.primary{width:100%}.ege-class-privacy{font-size:12px;line-height:1.7;color:var(--muted);margin-top:20px}.ege-class-free p{font-size:14px;line-height:1.8;color:var(--muted)}.ege-class-free .support-link{display:flex;background:#147c50;color:white;border:0;justify-content:center;text-align:center;padding:14px;width:100%;line-height:1.6}.ege-class-later{display:block;margin:12px auto 0}.ege-class-code{letter-spacing:1px;text-transform:uppercase}.ege-class-warning{color:#a71830;font-size:13px;line-height:1.7}.ege-class-private-note{font-size:12px;color:var(--muted);line-height:1.8;margin-top:14px}\n@media(max-width:740px){.app-header.ege-shared-header{padding:14px;gap:10px;min-height:88px}.ege-shared-header .brand{gap:8px}.ege-shared-header .brandname{font-size:16px}.ege-shared-header .brandmark{width:36px;height:40px;flex-basis:36px;font-size:14px}.ege-header-actions{gap:8px}.ege-header-name{max-width:14ch;font-size:12px}.ege-header-avatar{width:28px;height:28px;flex-basis:28px}.ege-header-person{gap:7px}.ege-header-help{width:32px;min-width:32px;min-height:36px}.ege-header-person .ege-header-auth{font-size:11px;min-height:34px;padding:4px 0}.profile-photo-panel{align-items:flex-start;gap:14px}.profile-photo-portrait{width:68px;height:68px;flex-basis:68px}.profile-photo-body input{font-size:12px}.ege-class-start h1{font-size:26px}.ege-class-start .card{padding:21px}.ege-class-start>.intro{font-size:14px}}\n@media(max-width:360px){.app-header.ege-shared-header{padding:12px 10px;gap:6px}.ege-shared-header .brandname{font-size:14px}.ege-shared-header .brand{gap:6px}.ege-shared-header .brandmark{width:32px;height:36px;flex-basis:32px;font-size:13px}.ege-header-name{max-width:12ch;font-size:11px}.ege-header-avatar{width:26px;height:26px;flex-basis:26px}.ege-header-person{gap:6px}.ege-header-actions{gap:6px}.ege-header-person .ege-header-auth{font-size:10px}.profile-photo-panel{flex-wrap:wrap}.profile-photo-body{flex-basis:180px}.ege-class-start .card{padding:18px}}\n@media(pointer:coarse){.ege-header-person .ege-header-auth{min-height:44px}.ege-header-help{min-height:44px}}\n\n@media(min-width:361px){.ege-shared-header .brand-sub{display:block!important;max-width:135px}}\n.ege-shared-header .brandmark{aspect-ratio:1;height:auto;border:0;background:transparent;box-shadow:none;overflow:hidden}\n.ege-shared-header .brandmark img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:contain;border-radius:24%;outline:1px solid #ffffff80;outline-offset:-1px}\n\n/* Connexion élève et inscription en deux étapes. */\n.phone-auth-links{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-top:16px}\n.phone-auth-note{padding:10px 12px;background:#f6f7fa;border-radius:10px;line-height:1.5}\n.phone-legacy-link{display:block;margin:22px auto 0;padding:8px;background:none;border:0;color:#677582;font:inherit;font-size:13px;text-decoration:underline;text-underline-offset:3px;cursor:pointer}\n.phone-auth-back{max-width:435px;margin:0 auto 24px;text-align:center}\n#phoneEnrollmentForm .field small{font-size:13px;color:#677582;line-height:1.5}\n#phoneEnrollmentForm .ege-class-free{padding:16px;border-radius:14px;background:#f8f9fc}\n#phoneEnrollmentForm .ege-class-free h2{font-size:20px;margin-bottom:8px}\n@media(max-width:480px){.phone-auth-links{display:grid;justify-items:start}.phone-auth-links .btn{padding-left:0}.login-card .ege-forms{gap:16px}}\n\n/* Récupération personnelle, hors de la navigation principale. */\n.recovery-dialog{width:min(470px,calc(100vw - 32px));max-height:calc(100dvh - 40px);overflow:auto;border:1px solid #e8eaf0;border-radius:20px;padding:24px;color:var(--ink);box-shadow:0 24px 80px #17202b33}\n.recovery-dialog::backdrop{background:#17202b88;backdrop-filter:blur(3px)}\n.recovery-dialog-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}\n.recovery-dialog-head h2{margin:0;font-size:22px;line-height:1.25}\n.recovery-check{display:flex;align-items:flex-start;gap:12px;line-height:1.5;font-size:14px;padding:14px;background:#f6f7fa;border-radius:12px}\n.recovery-check input{width:20px;height:20px;flex:none;accent-color:#c8102e;margin:1px 0 0}\n.recovery-link{font-size:13px;min-width:0;width:100%}\n.recovery-error{color:#a02037;font-size:14px;line-height:1.5;margin:12px 0 0}\n.recovery-profile-action{border-top:1px solid #e8eaf0;margin-top:20px;padding-top:18px}\n.recovery-help{margin-top:22px}.recovery-help .btn{font-size:13px}\n@media(max-width:420px){.recovery-dialog{padding:20px}.recovery-dialog-head h2{font-size:20px}}\n\n.onboarding-photo{max-width:640px;margin:20px auto;padding:16px 18px;border:1px solid var(--line);border-radius:16px;background:#fff}\n.onboarding-photo>summary{font-size:14px;font-weight:700;cursor:pointer}.onboarding-photo>summary span{font-weight:400;color:var(--muted)}\n.onboarding-photo .profile-photo-panel{margin:18px 0 0;border:0;padding:0}.onboarding-photo .profile-photo-body h2{display:none}\n\n/* Une annonce compacte ; les horaires et le texte complet restent dans la fiche. */\n.ege-ad-title-button{display:block;max-width:100%;padding:0;background:none;border:0;text-align:left;color:inherit;cursor:pointer}\n.ege-ad-title-button:focus-visible{outline:3px solid #e6a0ab;outline-offset:3px;border-radius:4px}\n.ege-ad-teacher-name{display:block;font-size:12px;font-weight:650;color:#4e5d6e;white-space:nowrap;text-overflow:ellipsis;overflow:hidden;margin-top:5px}\n.ege-ad-essentials{display:flex;gap:5px 10px;flex-wrap:wrap;margin-top:6px;min-width:0;color:#637182;font-size:11px}\n.ege-ad-essentials>span{display:block;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.ege-ad-fee{display:block;font-size:12px;font-weight:750;color:#90233b;margin-top:6px}\n.ege-ad-label{letter-spacing:.2px}.ege-directory-teacher{font-weight:650;color:#526174}\n.ege-ad-dialog-copy{white-space:normal}.ege-ad-detail-text{white-space:pre-wrap;overflow-wrap:anywhere}\n.ege-ad-detail-image{display:block;max-width:100%;width:100%;max-height:260px;object-fit:contain;border-radius:14px;margin-bottom:18px;background:#f7f8fa}\n.ege-ad-detail-name{font-weight:750;color:#263547}.ege-ad-all-link{display:inline-block;margin-top:20px;color:#9c2139;font-size:13px;text-decoration:underline;text-underline-offset:3px}\n.ege-ad-info-dialog{max-width:min(560px,calc(100vw - 30px));max-height:calc(100dvh - 40px);overflow:auto}\n@media(max-width:480px){.ege-ad-banner .ege-ad-art{width:72px;height:82px}.ege-ad-teacher-name{font-size:11px}.ege-ad-essentials{font-size:10.5px}.ege-ad-fee{font-size:11px}}\n\n/* Le nom public du professeur accompagne uniquement l’image de la bannière. */\n.ege-ad-visual{margin:0;min-width:0;width:100%;max-width:101px;display:flex;flex-direction:column;align-items:center;align-self:center}\n.ege-ad-visual .ege-ad-art{max-width:100%;flex:none}\n.ege-ad-visual .ege-ad-teacher-name{width:100%;max-width:100%;margin:7px 0 0;white-space:normal;text-align:center;font-size:11px;font-weight:700;line-height:1.35;overflow-wrap:anywhere;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;line-clamp:3;overflow:hidden}\n@media(max-width:740px){.ege-ad-visual{grid-row:span 2;align-self:start}}\n@media(max-width:480px){.ege-ad-visual .ege-ad-teacher-name{font-size:10.5px}}\n\n/* Soutenance EGE : décor léger, voile rouge et contraste blanc conservé. */\n.app-header.ege-shared-header{\n background-color:#a40d2b;\n background-image:linear-gradient(90deg,rgba(164,13,43,.94) 0%,rgba(164,13,43,.80) 38%,rgba(164,13,43,.80) 62%,rgba(164,13,43,.94) 100%),url('/ege-header-soutenance-v1.webp');\n background-repeat:no-repeat;\n background-size:cover;\n background-position:center 46%;\n}\n\n/* Photo et nom sur la même ligne ; déconnexion sous le nom. */\n.app-header.ege-shared-header{padding-top:10px;padding-bottom:10px}\n.ege-header-person{--ege-avatar-size:32px;display:grid;grid-template-columns:var(--ege-avatar-size) minmax(0,1fr);grid-template-rows:auto auto;column-gap:9px;row-gap:2px;align-items:center}\n.ege-header-person .ege-header-avatar{grid-column:1;grid-row:1;align-self:center;width:var(--ege-avatar-size);height:var(--ege-avatar-size);min-width:var(--ege-avatar-size)}\n.ege-header-person .ege-header-usertext{display:contents}\n.ege-header-person .ege-header-name{grid-column:2;grid-row:1;justify-self:end;text-align:right}\n.ege-header-person .ege-header-auth{grid-column:2;grid-row:2;justify-self:end}\n@media(max-width:740px){.ege-header-person{--ege-avatar-size:28px;column-gap:7px}}\n@media(max-width:360px){.ege-header-person{--ege-avatar-size:26px;column-gap:6px}}\n@media(pointer:coarse){.app-header.ege-shared-header{padding-top:9px;padding-bottom:9px}}\n\n/* Installation accessible depuis chaque en-tête, sans déplacer le profil. */\n.ege-header-install{display:inline-flex;align-items:center;justify-content:center;gap:7px;flex:0 0 auto;min-height:44px;padding:8px 12px;border:1px solid #ffffff8c;border-radius:11px;background:#ffffff16;color:#fff;font:750 12px/1.3 system-ui;white-space:nowrap;cursor:pointer}\n.ege-header-install svg{width:19px;height:19px;flex:none}.ege-header-install:hover{background:#ffffff26}.ege-header-install:focus-visible{outline:3px solid #fff;outline-offset:3px}\n.ege-header-install[hidden]{display:none!important}\n@media(max-width:740px){.ege-header-install{width:40px;padding:0}.ege-header-install-label{display:none}.ege-header-install--label{width:auto;padding:8px 11px}.ege-header-install--label .ege-header-install-label{display:inline}}\n@media(display-mode:standalone){.ege-header-install{display:none!important}}\n\n/* Bannière Essentielle : une photo, les repères utiles, une seule action. */\n.ege-ad-banner.ege-ad-essential{display:grid;grid-template-columns:96px minmax(0,1fr);column-gap:20px;row-gap:10px;align-items:center;width:100%;max-width:740px;margin:24px auto 0;padding:20px;border:1px solid #ece2e6;border-radius:20px;background:#fff;box-shadow:0 5px 24px #46203106;box-sizing:border-box}\n.ege-ad-essential .ege-ad-visual{grid-column:1;grid-row:1;align-self:center;width:96px;max-width:100%;margin:0}\n.ege-ad-essential .ege-ad-art{width:88px;height:94px;max-width:100%;padding:0;border-radius:14px;background:#f8f4f5;overflow:hidden}\n.ege-ad-essential .ege-ad-art img{display:block;width:100%;height:100%;object-fit:contain!important;border-radius:14px}\n.ege-ad-essential .ege-ad-teacher-name{font-size:12px;line-height:1.4;color:#283442;margin-top:9px;font-weight:700;white-space:normal;overflow-wrap:anywhere}\n.ege-ad-essential .ege-ad-copy{min-width:0;width:auto;display:flex;flex-direction:column;align-items:flex-start;border-left:2px solid #c8102e;padding-left:19px;gap:8px}\n.ege-ad-essential .ege-ad-label{font-size:10px;line-height:1.4;font-weight:600;color:#7f6871;letter-spacing:0;text-transform:none;margin:0}\n.ege-ad-essential .ege-ad-subject{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-clamp:2;overflow:hidden;overflow-wrap:anywhere;color:#232f3c;font-size:21px;line-height:1.25;letter-spacing:-.5px;font-weight:750;margin:0;max-width:100%}\n.ege-ad-essential .ege-ad-level{font-size:11px;line-height:1.4;font-weight:650;color:#ac1831;background:#fff0f3;border-radius:7px;padding:5px 8px;max-width:100%;overflow-wrap:anywhere;box-sizing:border-box}\n.ege-ad-essential .ege-ad-location{display:flex;align-items:flex-start;gap:6px;max-width:100%;font-size:12px;line-height:1.5;color:#627080}\n.ege-ad-location svg{width:15px;height:15px;flex:none;margin-top:2px}\n.ege-ad-location>span{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-clamp:2;overflow:hidden;overflow-wrap:anywhere}\n.ege-ad-essential .ege-ad-bottom{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between;width:100%;margin-top:3px}\n.ege-ad-essential .ege-ad-fee{font-size:12px;line-height:1.5;color:#812039;font-weight:750;margin:0;overflow-wrap:anywhere;min-width:0}\n.ege-ad-essential .ege-ad-details{display:inline-flex;gap:7px;align-items:center;justify-content:center;max-width:100%;min-height:44px;padding:10px 13px;border:0;border-radius:10px;background:#c8102e;color:#fff;font:700 12px/1.4 system-ui;cursor:pointer;margin-left:auto;box-sizing:border-box}\n.ege-ad-details svg{width:16px;height:16px;flex:none}\n.ege-ad-details:hover{background:#ab102a}.ege-ad-details:focus-visible,.ege-ad-filter:focus-visible,.ege-ad-select-all:focus-visible{outline:3px solid #db8d9b;outline-offset:3px}\n.ege-ad-essential .ege-ad-controls{grid-column:1/-1;display:flex;justify-content:flex-end;padding:0;border:0}\n.ege-ad-essential .ege-ad-carousel-nav{display:flex;gap:8px;align-items:center;justify-content:flex-end;margin:0;padding:0}\n.ege-ad-essential .ege-ad-arrow{width:36px;height:36px;min-width:36px;border:1px solid #eee3e6;background:#fff;color:#a71c34;border-radius:10px;font-size:22px;line-height:1;padding:0;cursor:pointer}\n.ege-ad-essential .ege-ad-dots{display:flex;gap:0;flex-wrap:wrap;justify-content:center;max-width:160px}\n.ege-ad-essential .ege-ad-dot{position:relative;display:block;min-width:24px;width:24px;height:30px;padding:0;border:0;background:transparent;border-radius:5px;cursor:pointer}\n.ege-ad-essential .ege-ad-dot::after{content:'';position:absolute;top:12px;left:9px;width:6px;height:6px;border-radius:50%;background:#d9cbd0}\n.ege-ad-essential .ege-ad-dot.active::after{background:#c8102e}\n.ege-ad-banner.ege-ad-neutral{display:flex;align-items:center;justify-content:space-between;gap:12px;max-width:740px;margin:24px auto 0;background:#fff;padding:18px;border:1px solid #e9e6eb;border-radius:16px}\n.ege-ad-neutral-copy{min-width:0}.ege-ad-neutral-copy strong{font-size:14px}.ege-ad-neutral-copy p{font-size:12px;line-height:1.6;color:#677484;margin:6px 0 0}.ege-ad-neutral .ege-ad-link{display:inline-flex;align-items:center;gap:5px;white-space:normal;font-size:12px}.ege-ad-neutral .ege-ad-link svg{width:16px;height:16px;flex:none}\n.ege-ad-targeting{border:0;padding:0;margin:16px 0}.ege-ad-targeting legend{font-size:13px;font-weight:700;margin:0 0 10px}.ege-ad-series-choices{display:flex;flex-wrap:wrap;gap:8px}.ege-ad-series-choices label{display:inline-flex;gap:8px;align-items:center;min-height:42px;padding:8px 11px;border:1px solid #e1e5ec;border-radius:10px;font-size:13px;background:#fff;cursor:pointer;box-sizing:border-box}.ege-ad-series-choices label:has(input:checked){border-color:#d48c9a;background:#fff3f5;color:#a5122e}.ege-ad-series-choices input,.ege-ad-fee-choice input{width:17px;height:17px;accent-color:#c8102e;flex:none;margin:0}\n.ege-ad-select-all{padding:9px 0;min-height:40px;border:0;background:transparent;font:650 12px/1.4 system-ui;color:#ac1b35;cursor:pointer;text-decoration:underline;text-underline-offset:3px}\n.ege-ad-fee-choice{display:flex;gap:10px;align-items:flex-start;font-size:13px;line-height:1.5;margin:0 0 12px}.ege-ad-fee-choice input{margin-top:2px}\n.ege-ad-directory-filters{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 26px}.ege-ad-filter{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:9px 15px;background:#fff;color:#5a6777;border:1px solid #e2e5ec;border-radius:100px;font:650 13px/1.4 system-ui;cursor:pointer}.ege-ad-filter.active{background:#c8102e;border-color:#c8102e;color:white}\n.ege-ad-details-editor{margin:14px 0;padding:14px;border:1px solid var(--line);border-radius:12px}.ege-ad-details-editor>summary{font-weight:700;cursor:pointer}.ege-ad-details-editor[open]>summary{margin-bottom:18px}.ege-ad-details-editor .ege-ad-practical{margin:0}.ege-ad-details-editor .ege-forms{margin-top:12px}.ege-ad-edit-status{font-size:13px;line-height:1.5;overflow-wrap:anywhere}.ege-ad-edit-error{color:#a51b32}\n@media(max-width:480px){.ege-ad-banner.ege-ad-essential{grid-template-columns:76px minmax(0,1fr);gap:10px 13px;padding:16px;border-radius:17px}.ege-ad-essential .ege-ad-visual{width:76px;grid-row:1}.ege-ad-essential .ege-ad-art{width:74px;height:82px}.ege-ad-essential .ege-ad-teacher-name{font-size:11px}.ege-ad-essential .ege-ad-copy{min-width:0;padding-left:12px;gap:7px}.ege-ad-essential .ege-ad-subject{font-size:18px}.ege-ad-essential .ege-ad-label{font-size:9px}.ege-ad-essential .ege-ad-level{font-size:10px}.ege-ad-essential .ege-ad-location{font-size:11px}.ege-ad-essential .ege-ad-details{padding:9px 11px;font-size:11px}.ege-ad-essential .ege-ad-fee{font-size:11px}.ege-ad-banner.ege-ad-neutral{align-items:flex-start;flex-direction:column}.ege-ad-filter{padding:9px 12px;font-size:12px}}\n"],"/ege-header.js":["application/javascript; charset=utf-8",false,"/* Fenêtres monAvenir communes : confirmation, résultat et saisie, sans dialogue navigateur. */\n(()=>{'use strict';\n const icons={confirm:'<path d=\"M10 4H4v16h6M13 8l4 4-4 4m-8-4h12\"/>',success:'<path d=\"m5 12 4 4 10-10\"/>',error:'<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6m0 4h.01\"/>',info:'<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6m0-10h.01\"/>',warning:'<path d=\"M12 3 2 21h20L12 3Zm0 6v5m0 3h.01\"/>'};\n let active=false;const queue=[];\n function next(){if(active||!queue.length)return;active=true;const {options:o,resolve}=queue.shift(),focus=document.activeElement,d=document.createElement('dialog');d.className='mb98-dialog mb98-'+o.kind;d.setAttribute('aria-labelledby','mb98-title');d.setAttribute('aria-describedby','mb98-text');\n  d.innerHTML=`<div class=\"mb98-mark\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">${icons[o.kind]||icons.info}</svg></div><h2 id=\"mb98-title\"></h2><p id=\"mb98-text\"></p><div class=\"mb98-input-wrap\" hidden><input class=\"mb98-input\" type=\"text\" aria-label=\"Votre réponse\"></div><div class=\"mb98-actions\"><button class=\"mb98-cancel\" type=\"button\"></button><button class=\"mb98-primary\" type=\"button\"></button></div>`;\n  d.querySelector('h2').textContent=o.title;d.querySelector('p').textContent=o.message;const cancel=d.querySelector('.mb98-cancel'),ok=d.querySelector('.mb98-primary'),input=d.querySelector('input');cancel.textContent=o.cancel||'Annuler';ok.textContent=o.action||'Compris';cancel.hidden=!o.choice;d.querySelector('.mb98-input-wrap').hidden=!o.input;if(o.input){input.value=o.value||'';input.setAttribute('aria-label',o.message)}\n  let finished=false;function finish(value){if(finished)return;finished=true;d.close();d.remove();if(focus?.isConnected)focus.focus();active=false;resolve(value);queueMicrotask(next)}\n  const declined=o.input?null:false;cancel.addEventListener('click',()=>finish(declined));ok.addEventListener('click',()=>finish(o.input?input.value:true));d.addEventListener('cancel',e=>{e.preventDefault();finish(declined)});d.addEventListener('close',()=>finish(declined));input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();finish(input.value)}});document.body.append(d);d.showModal();(o.input?input:o.choice?cancel:ok).focus();\n }\n function show(options){return new Promise(resolve=>{queue.push({options,resolve});next()})}\n function confirm(message,custom={}){const raw=String(message);const logout=/déconnecter de monAvenir/i.test(raw),associate=/Autoriser l'enseignant de cette classe|Associer le dossier/i.test(raw),danger=/supprimer|effacer|archiver|suspendre|retirer|quitter|remplac/i.test(raw);const title=logout?'Se déconnecter ?':associate?'Associer le dossier ?':raw.split('?')[0].length<65&&raw.includes('?')?raw.split('?')[0].trim()+' ?':'Confirmer l’action';const body=logout?'Voulez-vous quitter votre espace monAvenir ?':raw;return show({kind:logout?'confirm':danger?'warning':'info',title,message:body,choice:true,action:logout?'Se déconnecter':associate?'Associer':'Confirmer',...custom})}\n function prompt(message,value=''){return show({kind:'info',title:'Votre réponse',message:String(message),input:true,value:String(value??''),choice:true,action:'Valider'})}\n function notice(title,message,kind='info'){return show({kind,title,message:String(message),choice:false,action:kind==='error'?'Fermer':'Compris'})}\n window.MBDialog=Object.freeze({show,confirm,prompt,notice});\n})();\n/* En-tête EGE commun : aucune bibliothèque et aucun nouveau client de connexion. */\n(()=>{'use strict';\nconst subtitle='Votre réussite, étape par étape';\nconst escape=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nlet identity={id:'',name:'',path:'',db:null},identityTicket=0,lastHome=false;\nconst initials=name=>String(name||'Mon compte').trim().split(/\\s+/).slice(0,2).map(x=>x[0]||'').join('').toUpperCase();\nlet handlers={},logged=false,busy=false,legacyButton=null,returnFocus=null;\nlet fallbackInstallPrompt=null,nativelyInstalled=false,installReturnFocus=null;\nconst isInstalled=()=>nativelyInstalled||window.matchMedia?.('(display-mode: standalone)')?.matches===true||navigator.standalone===true;\nfunction refreshHeaderInstall(){document.querySelectorAll('[data-ege-header=install]').forEach(button=>{button.hidden=isInstalled()})}\nconst installIcon='<svg viewBox=\"0 0 24 24\" width=\"19\" height=\"19\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3v13m-5-5 5 5 5-5M4 20h16\"/></svg>';\nfunction configure(next){handlers=next||{}}\nfunction footer({showPrivacy=true,legacy=false}={}){return `<footer class=\"privacy-footer${legacy?' ege-legacy-footer':''}\"><div class=\"ege-footer-identity\"><p class=\"ege-copyright\">© ${new Date().getFullYear()} monAvenir — Tous droits réservés.</p><p class=\"ege-design-credit\">Conçu par <span>Jana Galeh</span></p></div>${showPrivacy?`<a href=\"/confidentialite.html\"${legacy?'':' data-act=\"goto\" data-to=\"privacy\"'}>Confidentialité et données personnelles</a>`:''}</footer>`}\n\nfunction markup({signedIn=false,home=false,userName='',avatarPath='',userId='',db=null}={}){\n logged=!!signedIn;lastHome=home;\n if(logged&&userId)identity={id:userId,name:userName||'Mon compte',path:avatarPath||'',db};\n if(!logged){identity={id:'',name:'',path:'',db:null};window.EGEAccount?.photo?.clear()}\n const account=logged?`<div class=\"ege-header-person\"><span class=\"ege-header-avatar\"><span class=\"ege-header-initials\">${escape(initials(identity.name))}</span>${identity.path?`<img data-ege-avatar-path=\"${escape(identity.path)}\" alt=\"Photo de profil\" hidden>`:''}</span><div class=\"ege-header-usertext\"><span class=\"ege-header-name\">${escape(identity.name||'Mon compte')}</span><button type=\"button\" class=\"ege-header-auth\" data-ege-header=\"logout\">Se déconnecter</button></div></div>`:`<button type=\"button\" class=\"ege-header-auth\" data-ege-header=\"login\">Se connecter</button>`;\n const install=`<button type=\"button\" class=\"ege-header-install${home&&!logged?' ege-header-install--label':''}\" data-ege-header=\"install\" aria-label=\"Installer l’App\" title=\"Installer l’App\" ${isInstalled()?'hidden':''}>${installIcon}<span class=\"ege-header-install-label\">Installer l’App</span></button>`;\n return `<header class=\"app-header ege-shared-header${home?' ege-header-home':''}\"><a class=\"brand\" href=\"/\" data-ege-header=\"home\" aria-label=\"Accueil monAvenir\"><span class=\"brandmark\"><img src=\"./mon-bac-icon.svg\" width=\"40\" height=\"40\" alt=\"\"></span><span class=\"ege-brand-text\"><span class=\"brandname\">monAvenir</span><span class=\"brand-sub\">${subtitle}</span></span></a><div class=\"ege-header-actions\">${home&&!logged?'':account}${install}</div></header>`;\n}\nasync function refresh(){\n const id=identity.id,path=identity.path,db=identity.db;if(!logged||!id||!path||!db||!navigator.onLine)return;\n const image=document.querySelector('.ege-shared-header [data-ege-avatar-path]');if(!image)return;\n try{const url=await EGEAccount.photo.signed(db,path);if(!url||!image.isConnected||identity.id!==id||identity.path!==path)return;image.onerror=()=>{image.hidden=true;const text=image.parentElement?.querySelector('.ege-header-initials');if(text)text.hidden=false};image.src=url;image.hidden=false;const text=image.parentElement?.querySelector('.ege-header-initials');if(text)text.hidden=true}catch(_){}\n}\nfunction replaceHeader(){const current=document.querySelector('.ege-shared-header');if(!current)return;current.outerHTML=markup({signedIn:logged,home:lastHome,userName:identity.name,userId:identity.id,avatarPath:identity.path,db:identity.db});refresh()}\nasync function setUser(user,db){const ticket=++identityTicket;if(!user){setSignedIn(false);return}identity={id:user.id,name:user.user_metadata?.full_name||'Mon compte',path:'',db};logged=true;replaceHeader();if(!db||!navigator.onLine)return;try{const p=await EGEAccount.current(db);if(ticket!==identityTicket||identity.id!==user.id||(p.user_id&&p.user_id!==user.id))return;identity={id:user.id,name:p.full_name||identity.name,path:EGEAccount.blocked(p)?'':p.avatar_path||'',db};replaceHeader()}catch(_){} }\nfunction installInstructions(){\n let d=document.getElementById('egeHeaderInstallDialog');if(!d){d=document.createElement('dialog');d.id='egeHeaderInstallDialog';d.className='ege-help-dialog';d.setAttribute('aria-labelledby','egeHeaderInstallTitle');d.innerHTML='<div class=\"ege-help-heading\"><h2 id=\"egeHeaderInstallTitle\">Installer l’App</h2><button type=\"button\" class=\"ege-help-close\" data-ege-header=\"install-close\" aria-label=\"Fermer\">×</button></div><p id=\"egeHeaderInstallText\"></p><button type=\"button\" class=\"btn primary full\" data-ege-header=\"install-close\">Compris</button>';d.addEventListener('close',()=>installReturnFocus?.isConnected&&installReturnFocus.focus());document.body.append(d)}\n const ios=/iPad|iPhone|iPod/.test(navigator.userAgent)||navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1;\n d.querySelector('p').textContent=ios?'Sur iPhone ou iPad : ouvrez EGE 2027 dans Safari, appuyez sur Partager, choisissez « Sur l’écran d’accueil », puis « Ajouter ».':/Android/i.test(navigator.userAgent)?'Sur Android : ouvrez EGE 2027 dans Chrome, appuyez sur le menu ⋮, puis sur « Installer l’application » ou « Ajouter à l’écran d’accueil ». Depuis un navigateur intégré, ouvrez d’abord le lien dans Chrome.':'Dans Chrome ou Edge, utilisez l’option « Installer l’application » de la barre d’adresse ou du menu du navigateur.';\n if(!d.open)d.showModal();\n}\nasync function installApp(target){\n installReturnFocus=target;\n if(typeof installEGE==='function'){await installEGE();return}\n const old=document.getElementById('egeInstallButton');if(old){old.click();return}\n if(isInstalled()){refreshHeaderInstall();return}\n if(fallbackInstallPrompt){const prompt=fallbackInstallPrompt;fallbackInstallPrompt=null;try{await prompt.prompt();await prompt.userChoice;return}catch(_){}}\n installInstructions();\n}\nwindow.addEventListener('beforeinstallprompt',event=>{if(!document.getElementById('app')&&!document.getElementById('egeInstallButton')){event.preventDefault();fallbackInstallPrompt=event;refreshHeaderInstall()}});\nwindow.addEventListener('appinstalled',()=>{nativelyInstalled=true;fallbackInstallPrompt=null;document.getElementById('egeHeaderInstallDialog')?.close();refreshHeaderInstall()});\nwindow.matchMedia?.('(display-mode: standalone)')?.addEventListener?.('change',refreshHeaderInstall);\nfunction dialog(){\n let d=document.getElementById('egeHeaderHelpDialog');if(d)return d;\n d=document.createElement('dialog');d.id='egeHeaderHelpDialog';d.className='ege-help-dialog';d.setAttribute('aria-labelledby','egeHeaderHelpTitle');\n d.innerHTML=`<div class=\"ege-help-heading\"><h2 id=\"egeHeaderHelpTitle\">Besoin d’aide ?</h2><button type=\"button\" class=\"ege-help-close\" data-ege-header=\"help-close\" aria-label=\"Fermer l’aide\">×</button></div><p>Retrouvez vos dossiers dans votre espace personnel. Pour rejoindre une classe, demandez le code à votre professeur.</p><p>En cas de difficulté avec votre compte ou votre dossier, contactez l’administrateur.</p><a class=\"ege-help-contact\" href=\"https://wa.me/25377441633?text=Bonjour%2C%20j%E2%80%99ai%20besoin%20d%E2%80%99aide%20pour%20EGE%202027.\" target=\"_blank\" rel=\"noopener\">Contacter l’administrateur sur WhatsApp</a><a class=\"ege-help-profile\" href=\"/?profil=1\">Mon profil</a><a class=\"ege-help-profile\" href=\"/confidentialite.html\">Confidentialité et données personnelles</a><p class=\"ege-help-phone\">WhatsApp : +253 77 44 16 33</p>`;\n d.addEventListener('close',()=>returnFocus?.isConnected&&returnFocus.focus());\n d.addEventListener('click',e=>{if(e.target!==d)return;const r=d.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)d.close()});\n document.body.append(d);return d;\n}\nfunction setSignedIn(value){logged=!!value;if(!logged){identityTicket++;identity={id:'',name:'',path:'',db:null};window.EGEAccount?.photo?.clear()}replaceHeader()}\nfunction errorMessage(error){if(handlers.error){handlers.error(error);return}const d=dialog();d.querySelector('[data-header-error]')?.remove();const p=document.createElement('p');p.dataset.headerError='';p.setAttribute('role','alert');p.textContent=error?.message||'L’opération n’a pas abouti. Réessayez.';d.append(p);if(!d.open)d.showModal()}\ndocument.addEventListener('click',async e=>{\n const target=e.target.closest('[data-ege-header]');if(!target)return;\n const action=target.dataset.egeHeader;e.preventDefault();\n if(action==='install-close'){document.getElementById('egeHeaderInstallDialog')?.close();return}\n if(action==='help'){returnFocus=target;const d=dialog();d.querySelector('.ege-help-profile').hidden=!logged;if(!d.open)d.showModal();return}\n if(action==='help-close'){document.getElementById('egeHeaderHelpDialog')?.close();return}\n if(busy)return;busy=true;target.disabled=true;\n try{if(action==='install'){await installApp(target)}\n else if(action==='home'){if(handlers.home)await handlers.home();else location.assign('/')}\n else if(action==='login'){if(handlers.login)await handlers.login();else location.assign('/?connexion=1')}\n else if(action==='logout'){if(handlers.logout)await handlers.logout();else if(legacyButton)legacyButton.click();else throw Error('Actualisez la page pour vous déconnecter.')}\n }catch(error){errorMessage(error)}finally{busy=false;target.disabled=false}\n});\nfunction mountLegacy(){\n if(document.getElementById('app')||document.querySelector('.ege-shared-header'))return;\n const old=document.querySelector('body>header');if(!old)return;\n const word=!!document.getElementById('egeCloudOpen');\n if(!document.getElementById('egeInstallButton')){if(!document.querySelector('link[rel=manifest]')){const link=document.createElement('link');link.rel='manifest';link.href='/manifest-ege-2027.webmanifest';document.head.append(link)}if('serviceWorker' in navigator&&location.protocol==='https:')navigator.serviceWorker.register('/service-worker-ege-2027.js',{scope:'/'}).catch(()=>{})}\n legacyButton=document.getElementById('signOut');\n let initial=legacyButton?!legacyButton.hidden:false;\n if(word&&typeof egeCloudUser!=='undefined')initial=!!egeCloudUser;\n old.insertAdjacentHTML('beforebegin',markup({signedIn:initial}));\n const tools=document.createElement('details');tools.className='ege-legacy-tools';const summary=document.createElement('summary');summary.textContent=word?'Outils du dossier':'Navigation';tools.append(summary);old.before(tools);tools.append(old);\n if(word&&typeof egeCloudUser!=='undefined'&&egeCloudUser)setUser(egeCloudUser,typeof egeSupabaseClient!=='undefined'?egeSupabaseClient:null);\n if(word)configure({login:()=>document.getElementById('egeCloudOpen')?.click(),logout:async()=>{if(typeof egeCloudLogout!=='function')throw Error('Actualisez la page.');await egeCloudLogout();setSignedIn(typeof egeCloudUser!=='undefined'&&!!egeCloudUser)}});\n const box=document.createElement('div');box.innerHTML=footer({legacy:true});const legalFooter=box.firstElementChild;const oldFooter=document.querySelector('body>footer');if(oldFooter)oldFooter.replaceWith(legalFooter);else document.body.append(legalFooter);\n if(legacyButton)new MutationObserver(()=>setSignedIn(!legacyButton.hidden)).observe(legacyButton,{attributes:true,attributeFilter:['hidden']});\n}\nwindow.EGEHeader={render:markup,footer,configure,setSignedIn,setUser,refresh,mountLegacy};\ndocument.addEventListener('DOMContentLoaded',mountLegacy);\n})();\n"],"/study.css":["text/css; charset=utf-8",false,"/* Outils discrets, adaptés au téléphone et au clavier. */\n.study-tools{margin-top:24px;padding:20px!important}.study-tools summary,.study-details summary{cursor:pointer;font-weight:700;line-height:1.5;min-height:28px}.study-tools[open] summary,.study-details[open] summary{margin-bottom:18px}.study-tool-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.study-tool-grid .btn{justify-content:flex-start;white-space:normal;text-align:left}.study-next{font-size:15px;line-height:1.6;background:#fff9;padding:12px 15px;border-radius:12px;margin:18px 0}.study-status{display:flex;justify-content:space-between;gap:16px;align-items:center;padding:15px;border-radius:12px;background:#fff4e5;color:#70470c}.study-status.is-ready{background:#eaf7f1;color:#1b6651}.study-status strong{font-size:18px}.study-check{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:14px;padding:17px 0;border-bottom:1px solid #e7ebef}.study-check strong{display:block;line-height:1.6;overflow-wrap:anywhere}.study-check p,.study-pending p{font-size:14px;line-height:1.7;color:#596473;margin:5px 0 0}.study-details{margin-top:20px}.study-details li{margin-bottom:12px;line-height:1.7}.study-letter,.study-text{white-space:pre-wrap;overflow-wrap:anywhere;font-family:inherit;line-height:1.8}.study-letter{font-size:14px;background:#f8fafc;border:1px solid #e1e6ec;border-radius:12px;padding:18px}.study-checkbox{display:flex;align-items:flex-start;gap:12px;margin:18px 0;line-height:1.65;cursor:pointer}.study-checkbox input{width:20px;height:20px;flex:0 0 20px;margin-top:3px;accent-color:#c8102e}.study-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}.study-actions .btn{white-space:normal}.study-export-options{display:grid;gap:12px;max-width:420px;margin:22px 0}.study-timer{font-variant-numeric:tabular-nums;font-size:44px;font-weight:750;text-align:center;letter-spacing:.04em}.study-pending{padding:16px 0;border-top:1px solid #e7ebef}.study-pending .btn{margin:12px 8px 0 0}.study-offline{margin-bottom:20px}.study-offline[hidden]{display:none}.study-invite{border:1px solid #e1e6ec;border-radius:22px;padding:24px;width:min(520px,calc(100% - 32px));max-height:calc(100dvh - 32px);overflow:auto;color:#172533;box-shadow:0 24px 80px #17253333}.study-invite::backdrop{background:#16253870}.study-invite-head{display:flex;gap:12px;align-items:center;justify-content:space-between}.study-invite h2{font-size:24px;margin:0}.study-qr{width:min(240px,100%);margin:20px auto}.study-qr svg{display:block;width:100%;shape-rendering:crispEdges}.study-code{text-align:center;font-size:24px;font-weight:750;letter-spacing:.08em}.study-offline span{flex:1}.study-offline .btn{flex:0 0 auto}.study-tools .btn:focus-visible,.study-details summary:focus-visible,[data-study]:focus-visible{outline:3px solid #2774bc;outline-offset:3px}@media(max-width:480px){.study-check{grid-template-columns:minmax(0,1fr);gap:8px}.study-check .btn{justify-self:start}.study-tool-grid{grid-template-columns:minmax(0,1fr)}.study-actions>.btn{flex:1 1 100%}.study-invite-head{align-items:flex-start}.study-status{align-items:flex-start}.study-offline{flex-wrap:wrap}.study-offline .btn{margin-left:0}.study-letter{padding:12px}.study-tools{padding:18px!important}}\n"],"/study-core.js":["application/javascript; charset=utf-8",false,"/* Vérifications et outils pédagogiques : uniquement les faits saisis par l'élève. */\n(()=>{'use strict';\nconst clean=v=>String(v??'').trim(),count=p=>p.mode==='binome'?4:3;\nfunction topic(p,catalog){const t=EGEAcademic.catalogFor(p,catalog)[p.theme];return {theme:t?.title||'',subtheme:t?.subthemes?.[p.subtheme]||''}}\nfunction report(p,catalog,reviews=[]){const t=EGETerrain.normalize(p.terrain,p),subject=topic(p,catalog),items=[];\n const add=(key,label,error,target,tab,annex)=>items.push({key,label,ok:!error,detail:error||'Renseigné et vérifié automatiquement',target,tab,annex});\n add('identity','Identité et scolarité',EGEStage.check('identity',p)||(!EGEAcademic.classes[EGEAcademic.seriesOf(p)]?.includes(p.className)?'Choisissez une classe de votre série.':''),'student-wizard',1);\n add('subject','Thème et sous-thème',!subject.theme||!subject.subtheme?'Choisissez un thème et un sous-thème du catalogue de votre série.':'','student-wizard',2);\n add('problem','Problématique',EGEStage.check('problem',p),'student-wizard',3);\n for(let n=1;n<=count(p);n++)add('annex_'+n,'Annexe '+n+' et sa source',EGEStage.check('annex_'+n,p),'student-annex',null,n);\n for(const [key,label,tab] of [['enterprise','Entreprise et historique','enterprise'],['professional','Professionnel et entretien réalisé','professional'],['interview','Questions et réponses','interview']])add('terrain_'+key,label,EGEStage.check('terrain_'+key,p),'student-terrain',tab);\n add('terrain_comparison','Tableau comparatif relu',t.comparisons.length!==count(p)||t.comparisons.some(r=>!clean(r.theory)||!clean(r.practice))?'Complétez les deux colonnes pour chaque annexe.':!t.comparisonReviewed||t.comparisonSignature!==EGETerrain.comparisonSignature(p)?'Relisez le tableau après les dernières modifications et validez cette étape.':'','student-terrain','comparison');\n add('terrain_synthesis','Synthèse relue',!clean(t.synthesis)?'Rédigez la synthèse.':!t.synthesisReviewed||t.synthesisSignature!==EGETerrain.synthesisSignature(p)?'Actualisez, relisez et validez la synthèse.':'','student-terrain','synthesis');\n const latest=new Map();for(const r of [...reviews].sort((a,b)=>String(b.created_at).localeCompare(String(a.created_at)))){const k=r.annex_number||0;if(!latest.has(k))latest.set(k,r)}\n const corrections=[...latest.values()].filter(r=>r.decision==='a_corriger');for(const r of corrections)add('review_'+r.id,r.annex_number?'Correction du professeur — annexe '+r.annex_number:'Correction du professeur',clean(r.observation)||'Consultez les corrections du professeur.','student-group');\n const ready=items.every(i=>i.ok);return {items,ready,done:items.filter(i=>i.ok).length,total:items.length,next:items.find(i=>!i.ok)||null,teacherValidated:latest.get(0)?.decision==='valide',advice:[!t.logo?'Logo à joindre si l’entreprise l’autorise.':'',!t.organizationChart&&!clean(t.organizationChartText)?'Ajoutez l’organigramme ou sa description.':''].filter(Boolean)};\n}\nconst visit=[['appointment','Confirmer le rendez-vous et la fonction du professionnel'],['questions','Préparer les questions en lien avec les annexes'],['permission','Demander l’accord pour les notes, les images et l’enregistrement éventuel'],['documents','Prévoir de quoi noter et les documents utiles'],['facts','Vérifier le nom, la date, les réponses et leurs sources'],['thanks','Remercier le professionnel et respecter la confidentialité']];\nfunction letter(p,catalog){const t=EGETerrain.normalize(p.terrain,p),s=topic(p,catalog),v=p.study?.letter||{};return `${clean(p.student)||'[Nom de l’élève]'}${p.mode==='binome'?' et '+(clean(p.partner)||'[Binôme]'):''}\\n${clean(p.className)||'[Classe]'} — ${clean(p.school)||'[Établissement]'}\\n\\nÀ l’attention de ${clean(t.professionalName)||'[Professionnel / responsable]'}\\n${clean(t.organizationName)||'[Entreprise]'}\\n\\n${clean(v.place)||'[Lieu]'}, le ${clean(v.date)||new Date().toLocaleDateString('fr-FR')}\\n\\nObjet : demande d’entretien dans le cadre de mon étude de gestion\\n\\nMadame, Monsieur,\\n\\nDans le cadre de mon étude de gestion en série ${EGEAcademic.seriesOf(p)}, je travaille sur « ${s.subtheme||'[Sous-thème à choisir]'} » avec la problématique suivante : « ${clean(p.problem)||'[Problématique à préciser]'} ».\\n\\nJe souhaite vous rencontrer afin de recueillir votre expérience professionnelle et de rapprocher mes recherches documentaires des pratiques de votre entreprise. ${clean(v.availability)||'Je reste disponible pour convenir avec vous d’une date et d’une durée adaptées.'}\\n\\nLes informations seront utilisées dans mon dossier scolaire. Je respecterai vos consignes de confidentialité et demanderai votre accord avant tout enregistrement ou utilisation d’image.\\n\\nJe vous remercie de l’attention portée à ma demande.\\n\\n${clean(p.student)||'[Signature]'}${clean(v.contact)?'\\nContact : '+clean(v.contact):''}`}\nfunction oral(p,catalog){const t=EGETerrain.normalize(p.terrain,p),s=topic(p,catalog);return {sections:[['Mon sujet',s.subtheme||'À choisir'],['Ma problématique',clean(p.problem)||'À préciser'],['Mon plan documentaire',Array.from({length:count(p)},(_,i)=>'Annexe '+(i+1)+' — '+(clean(p.annexTitles?.[i+1])||['Les notions générales','Comprendre le sous-thème','Éléments de réponse','Conditions et limites'][i])).join('\\n')],['Mon terrain',[t.organizationName,t.professionalName,t.professionalRole,t.interviewStatus==='done'?t.interviewDate:'Entretien à réaliser'].filter(Boolean).join(' · ')||'À compléter'],['Mes constats', [t.similarities,t.differences].filter(clean).join('\\n\\n')||'À rédiger à partir des réponses réelles'],['Ma synthèse',clean(t.synthesis)||'À rédiger']],questions:['Pourquoi avez-vous choisi ce sous-thème ?',`Comment vos sources vous aident-elles à répondre à « ${clean(p.problem)||'votre problématique'} » ?`,'Comment avez-vous vérifié la fiabilité de vos sources ?',`Qu’avez-vous appris auprès de ${t.organizationName||'l’entreprise'} ?`,'Quelle réponse de l’entretien éclaire le mieux une annexe ?','Quels écarts observez-vous entre la théorie et le terrain ?','Quelles sont les limites de votre enquête ?','Quelle est votre réponse personnelle à la problématique ?']}}\nfunction invitation(code,origin=location.origin){if(!/^[A-Z0-9-]{4,40}$/i.test(code))throw Error('Code de classe non valide.');const u=new URL('/',origin);u.searchParams.set('classe',code.toUpperCase());return u.href}\nwindow.EGEStudy={report,topic,letter,oral,visit,invitation,count};\n})();\n"],"/study-offline.js":["application/javascript; charset=utf-8",false,"/* EGE 2027 — coffre local facultatif, limité aux dossiers de l'élève vérifié. */\n(()=>{'use strict';\nconst NAME='ege2027-offline-v1',COL='vault',MAX_IMAGES=20*1024*1024;\nlet database,config=null,key=null,chain=Promise.resolve(),message='',urls=new Map();\nconst clone=x=>JSON.parse(JSON.stringify(x)),same=(a,b)=>JSON.stringify(a)===JSON.stringify(b);\nconst emit=()=>window.dispatchEvent(new Event('ege-offline-change'));\nfunction open(){if(database)return Promise.resolve(database);return new Promise((resolve,reject)=>{if(!window.indexedDB||!window.crypto?.subtle)return reject(Error('Le stockage hors connexion sécurisé n’est pas disponible dans ce navigateur.'));const req=indexedDB.open(NAME,1);req.onupgradeneeded=()=>req.result.createObjectStore(COL);req.onerror=()=>reject(req.error);req.onsuccess=()=>{database=req.result;resolve(database)}})}\nasync function record(id,value,remove=false){const db=await open();return new Promise((resolve,reject)=>{const tx=db.transaction(COL,value===undefined&&!remove?'readonly':'readwrite'),s=tx.objectStore(COL),req=remove?s.delete(id):value===undefined?s.get(id):s.put(value,id);let result;req.onsuccess=()=>result=req.result;tx.oncomplete=()=>resolve(result);tx.onerror=()=>reject(tx.error);tx.onabort=()=>reject(tx.error||Error('Stockage interrompu.'))})}\nasync function setup(){if(config)return config;config=await record('config')||null;key=await record('key')||null;return config}\nasync function read(id){await setup();const v=await record(id);if(!v||!key)return null;const clear=await crypto.subtle.decrypt({name:'AES-GCM',iv:v.iv,additionalData:new TextEncoder().encode(id)},key,v.bytes);return JSON.parse(new TextDecoder().decode(clear))}\nasync function write(id,value){const iv=crypto.getRandomValues(new Uint8Array(12));const bytes=await crypto.subtle.encrypt({name:'AES-GCM',iv,additionalData:new TextEncoder().encode(id)},key,new TextEncoder().encode(JSON.stringify(value)));await record(id,{iv,bytes})}\nfunction serial(fn){const promise=chain.then(()=>navigator.locks?.request?navigator.locks.request('ege2027-offline-vault',fn):fn());chain=promise.catch(e=>{message=e.message;emit()});return promise}\nconst enabled=uid=>!!config&&config.uid===uid&&!config.locked;\nasync function pending(){await chain;return await read('pending')||{}}\nasync function enable(bundle){\n if(bundle.role!=='eleve'||!bundle.user?.id||!bundle.profile||bundle.profile.account_status!=='active'||bundle.profile.deleted_at)throw Error('Un compte élève actif et vérifié est nécessaire.');\n await setup();if(config&&config.uid!==bundle.user.id)throw Error('Effacez d’abord la préparation de l’autre compte sur cet appareil.');\n if(!key){key=await crypto.subtle.generateKey({name:'AES-GCM',length:256},false,['encrypt','decrypt']);await record('key',key)}\n config={uid:bundle.user.id,preparedAt:Date.now(),locked:false};await record('config',config);await capture(bundle);message='Préparation enregistrée sur cet appareil.';emit();\n try{await navigator.storage?.persist?.()}catch(_){}\n}\nasync function capture(bundle){return serial(async()=>{\n await setup();if(!enabled(bundle.user?.id))return;\n const docs=bundle.docs.filter(d=>d.owner_id===config.uid&&!d.deleted_at&&!d.archived_at&&!d.suspended_at);\n if(docs.length>100||JSON.stringify(docs).length>12*1024*1024)throw Error('Préparation trop volumineuse. Archivez les anciens dossiers puis recommencez.');\n const ids=new Set(docs.map(d=>d.id));\n await write('snapshot',{user:{id:bundle.user.id,email:bundle.user.email,user_metadata:bundle.user.user_metadata},role:'eleve',profile:bundle.profile,docs,reviews:(bundle.reviews||[]).filter(r=>ids.has(r.dossier_id)),selectedDocId:bundle.selectedDocId,preparedAt:Date.now()});\n config.preparedAt=Date.now();await record('config',config);emit();\n })}\nfunction stage(uid,doc,payload){if(!enabled(uid)||!doc||doc.owner_id!==uid)return Promise.resolve(false);const copy=clone(payload);return serial(async()=>{const rows=await read('pending')||{};const previous=rows[doc.id];rows[doc.id]={...previous,id:doc.id,base:previous?.base||doc.updated_at,payload:copy,modifiedAt:Date.now()};await write('pending',rows);emit();return true})}\nfunction ack(uid,docId,payload,saved){if(!enabled(uid))return Promise.resolve();return serial(async()=>{const rows=await read('pending')||{};if(rows[docId]){if(same(rows[docId].payload,payload))delete rows[docId];else rows[docId].base=saved.updated_at;await write('pending',rows)}const snap=await read('snapshot');if(snap){const i=snap.docs.findIndex(d=>d.id===docId);if(i>=0)snap.docs[i]=saved;else snap.docs.unshift(saved);snap.selectedDocId=docId;await write('snapshot',snap)}emit()})}\nasync function boot(){try{await setup();if(!config||config.locked)return null;await chain;const snap=await read('snapshot');if(!snap||snap.user?.id!==config.uid)return null;const rows=await read('pending')||{};snap.docs=snap.docs.map(d=>rows[d.id]?{...d,payload:rows[d.id].payload}:d);snap.pending=rows;return snap}catch(e){message=e.message;return null}}\nasync function conflict(id,reason){return serial(async()=>{const rows=await read('pending')||{};if(rows[id]){rows[id].conflict=reason;await write('pending',rows)}message=reason;emit()})}\nasync function discard(id){return serial(async()=>{const rows=await read('pending')||{};delete rows[id];await write('pending',rows);emit()})}\nasync function lock(){await setup();if(config){config.locked=true;await record('config',config)}emit()}\nasync function clear(){await chain;const uid=config?.uid;const db=await open();await new Promise((resolve,reject)=>{const tx=db.transaction(COL,'readwrite');tx.objectStore(COL).clear();tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)});for(const u of urls.values())URL.revokeObjectURL(u);urls.clear();config=null;key=null;message='';if(uid)try{for(const k of Object.keys(localStorage))if(k.startsWith('ege27_draft_'+uid+'_')||k==='ege2027_local_draft_'+uid||k==='ege2027_dossier_selection_'+uid)localStorage.removeItem(k);localStorage.removeItem('ege-gfm-2027-v3')}catch(_){}emit()}\nasync function cacheImages(db,bundle){await setup();if(!enabled(bundle.user?.id))return;let size=0,images={},missing=0;\n const old=await read('images')||{};\n for(const d of bundle.docs.filter(d=>d.owner_id===config.uid&&!d.deleted_at&&!d.archived_at&&!d.suspended_at))for(const kind of ['logo','organizationChart']){const asset=d.payload?.terrain?.[kind];if(!asset||!asset.path.startsWith(config.uid+'/'+d.id+'/'))continue;message='Préparation des images : '+Object.keys(images).length+' disponible(s)…';emit();let value=old[asset.path];try{if(!value){const r=await db.storage.from(EGETerrain.BUCKET).download(asset.path);if(r.error)throw r.error;const blob=r.data;value={type:blob.type||'image/jpeg',base64:await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onerror=reject;reader.onload=()=>resolve(reader.result.split(',')[1]);reader.readAsDataURL(blob)})}}if(size+value.base64.length*0.75>MAX_IMAGES){missing++;continue}images[asset.path]=value;size+=value.base64.length*0.75}catch(_){missing++}}\n await serial(()=>write('images',images));config.imageCount=Object.keys(images).length;config.missingImages=missing;message=missing?'Textes préparés. '+missing+' image(s) indisponible(s) : reconnectez-vous pour les reprendre.':'Préparation terminée : textes, outils et images disponibles.';await record('config',config);emit();return {count:config.imageCount,missing};\n}\nasync function image(path){await setup();if(!config||config.locked||!path.startsWith(config.uid+'/'))return null;await chain;const v=(await read('images'))?.[path];if(!v)return null;const raw=atob(v.base64),bytes=Uint8Array.from(raw,c=>c.charCodeAt(0));return new Blob([bytes],{type:v.type})}\nasync function imageURL(path){if(urls.has(path))return urls.get(path);const blob=await image(path);if(!blob)return null;const url=URL.createObjectURL(blob);urls.set(path,url);return url}\nasync function status(){try{await setup();const rows=await pending();return {config,pending:Object.values(rows),message}}catch(e){return {config:null,pending:[],message:e.message}}}\nwindow.EGEOffline={enable,capture,stage,ack,boot,pending,conflict,discard,lock,clear,cacheImages,image,imageURL,status,enabled,flush:()=>chain,same};\n})();\n"],"/study-pdf.js":["application/javascript; charset=utf-8",false,"/* Export PDF local : données réelles du dossier, images privées autorisées. */\n(()=>{'use strict';\nconst pending={};\nfunction load(src){return pending[src]||(pending[src]=new Promise((resolve,reject)=>{const s=document.createElement('script');s.src=src;s.onload=resolve;s.onerror=()=>{delete pending[src];s.remove();reject(Error('Outil indisponible. Préparez-le avec Internet depuis votre profil.'))};document.head.append(s)}))}\nasync function prepare(){await load('/study-jspdf.js');await load('/study-fonts.js')}\nasync function build(p,{kind='dossier',catalog=[],reviews=[],db=null}={}){\n await prepare();const pdf=new jspdf.jsPDF({unit:'mm',format:'a4',compress:true});for(const [style,value] of Object.entries(EGEFonts)){pdf.addFileToVFS('EGE-'+style+'.ttf',value);pdf.addFont('EGE-'+style+'.ttf','EGE',style)}pdf.setFont('EGE','normal');pdf.setProperties({title:kind==='letter'?'Demande d’entretien':'Dossier EGE 2027',author:String(p.student||'Élève'),creator:'EGE 2027'});\n const W=174,LEFT=18,BOTTOM=276;let y=22;\n function page(){pdf.addPage();y=22}\n function room(h){if(y+h>BOTTOM)page()}\n function text(value,size=10,bold=false){pdf.setFont('EGE',bold?'bold':'normal');pdf.setFontSize(size);const lines=pdf.splitTextToSize(String(value||'À renseigner').replace(/\\t/g,'  '),W);const h=size*.44;for(const line of lines){room(h);pdf.text(line,LEFT,y);y+=h}y+=3}\n function heading(value,major=false){room(18);if(major){y+=3;pdf.setDrawColor(212,218,225);pdf.line(LEFT,y,192,y);y+=9}text(value,major?15:12,true)}\n async function image(asset,label){if(!asset)return;let blob=await window.EGEOffline?.image(asset.path);if(!blob&&db&&navigator.onLine){const r=await db.storage.from(EGETerrain.BUCKET).download(asset.path);if(r.error)throw r.error;blob=r.data}if(!blob)throw Error(label+' indisponible hors connexion. Préparez les images depuis votre profil ou reconnectez-vous.');const bytes=new Uint8Array(await blob.arrayBuffer()),width=Math.min(label==='Logo'?45:W,asset.width*.264),height=width*asset.height/asset.width,scale=Math.min(1,220/height),w=width*scale,h=height*scale;room(h+13);heading(label);room(h+5);pdf.addImage(bytes,'JPEG',LEFT,y,w,h);y+=h+7}\n function table(rows){const cw=83,lh=4.4;function head(){room(20);pdf.setFillColor(239,242,246);pdf.rect(LEFT,y-4,W,10,'F');pdf.setFont('EGE','bold');pdf.setFontSize(9);pdf.text('Recherche documentaire',LEFT+3,y+2);pdf.text('Contextualisation sur le terrain',LEFT+90,y+2);y+=12}head();for(const row of rows){heading('Annexe '+row.annex);pdf.setFont('EGE','normal');pdf.setFontSize(9);let left=pdf.splitTextToSize(row.theory||'À renseigner',cw-5),right=pdf.splitTextToSize(row.practice||'À renseigner',cw-5);for(let i=0;i<Math.max(left.length,right.length);i++){if(y+lh>BOTTOM){page();head();pdf.setFont('EGE','normal');pdf.setFontSize(9)}if(left[i])pdf.text(left[i],LEFT+2,y);if(right[i])pdf.text(right[i],LEFT+90,y);y+=lh}y+=6}}\n const t=EGETerrain.normalize(p.terrain,p),report=EGEStudy.report(p,catalog,reviews),topic=EGEStudy.topic(p,catalog);\n if(kind==='letter'){text(EGEStudy.letter(p,catalog),11)}\n else if(kind==='oral'){heading('Préparer ma soutenance',true);text('Fiche personnelle d’entraînement — à adapter aux consignes du professeur.',9);const o=EGEStudy.oral(p,catalog);for(const [label,value] of o.sections){heading(label);text(value)}heading('Questions pour m’entraîner',true);o.questions.forEach((q,i)=>text((i+1)+'. '+q))}\n else{\n  heading('ÉTUDE DE GESTION — EGE 2027',true);text(report.ready?'Vérifications automatiques complètes — validation pédagogique distincte.':'BROUILLON — des éléments restent à compléter ou à corriger.',9,true);text('Série '+EGEAcademic.seriesOf(p)+' · '+(p.mode==='binome'?'Travail en binôme':'Travail individuel'),11);\n  for(const [label,value] of [['Élève',p.student],...(p.mode==='binome'?[['Binôme',p.partner]]:[]),['Classe',p.className],['Établissement',p.school],['Professeur',p.teacher],['Thème',topic.theme],['Sous-thème',topic.subtheme],['Problématique',p.problem]]){heading(label);text(value)}\n  if(Array.isArray(p.candidates)&&p.candidates.some(Boolean)){heading('Informations des candidats');text(p.candidates.filter(Boolean).join(' · '))}\n  page();heading('I. Recherche documentaire',true);for(let n=1;n<=EGEStudy.count(p);n++){heading('Annexe '+n+' — '+(p.annexTitles?.[n]||['Les notions générales','Comprendre le sous-thème','Éléments de réponse','Conditions et limites'][n-1]),true);text(p.annexes?.[n]);text('Source : '+(p.sources?.[n]||'À renseigner'),9);text(p.sourceChecks?.[n]?'Source déclarée consultée par l’élève.':'Source à vérifier par l’élève.',8)}\n  page();heading('II. Présentation de l’entreprise',true);await image(t.logo,'Logo');for(const [key,[label]] of Object.entries(EGETerrain.fields)){if(['professionalName','professionalRole','interviewDate','interviewMethod','interviewDifficulties','similarities','differences','synthesis'].includes(key))continue;heading(label);text(t[key])}await image(t.organizationChart,'Organigramme');\n  heading('III. Entretien avec le professionnel',true);text(t.interviewStatus==='done'?'Entretien déclaré réalisé.':'Entretien à réaliser.',9,true);for(const key of ['professionalName','professionalRole','interviewDate','interviewMethod','interviewDifficulties']){heading(EGETerrain.fields[key][0]);text(t[key])}t.questions.filter(q=>q.question||q.answer).forEach((q,i)=>{heading('Question '+(i+1)+(q.annex?' — annexe '+q.annex:''));text(q.question);text('Réponse : '+(q.answer||'À renseigner'))});\n  heading('IV. Comparaison de la théorie et du terrain',true);table(t.comparisons.length?t.comparisons:Array.from({length:EGEStudy.count(p)},(_,i)=>({annex:i+1})));for(const key of ['similarities','differences']){heading(EGETerrain.fields[key][0]);text(t[key])}\n  heading('V. Synthèse',true);text(t.synthesis);\n }\n const pages=pdf.getNumberOfPages();for(let i=1;i<=pages;i++){pdf.setPage(i);pdf.setFont('EGE','normal');pdf.setFontSize(8);pdf.setTextColor(100,110,120);pdf.text('EGE 2027 · '+String(p.student||'Mon étude').slice(0,65),LEFT,287);pdf.text(i+' / '+pages,192,287,{align:'right'})}\n return pdf;\n}\nasync function download(p,opts={}){const pdf=await build(p,opts),name=String(p.student||'eleve').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').replace(/[^a-z0-9_-]+/ig,'-').slice(0,60);pdf.save('EGE-2027-'+(opts.kind||'dossier')+'-'+name+'.pdf')}\nwindow.EGEPDF={load,prepare,build,download};\n})();\n"],"/study-ui.js":["application/javascript; charset=utf-8",false,"/* Outils du dossier : navigation existante conservée, fonctions secondaires repliées. */\n(()=>{'use strict';\nlet cache={config:null,pending:[],message:''},reconnecting=false,preparing=false,invitationCode='',invitationGroup=null,timerId=null,seconds=300,running=false,pdfBusy=false;\nconst B=(label,action,cls='btn',attrs='')=>`<button type=\"button\" class=\"${cls}\" data-study=\"${action}\" ${attrs}>${esc(label)}</button>`;\nconst own=()=>st.user&&st.role==='eleve'&&st.draft&&currentDoc()?.owner_id===st.user.id;\nconst bundle=()=>({user:st.user,role:st.role,profile:st.profile,docs:st.docs,reviews:st.reviews,selectedDocId:st.selectedDocId});\nconst reviews=()=>st.reviews.filter(r=>r.dossier_id===st.selectedDocId);\nconst report=()=>EGEStudy.report(st.draft,official,reviews());\nfunction tools(){return own()?`<details class=\"study-tools card\"><summary>Outils du dossier</summary><div class=\"study-tool-grid\">${[['Bilan prêt à remettre','student-ready'],['Préparer ma visite','student-kit'],['Préparer ma soutenance','student-oral'],['Exporter mon dossier','student-export']].map(([label,screen])=>B(label,'screen','btn',`data-screen=\"${screen}\"`)).join('')}</div></details>`:''}\nfunction heading(label,desc){return title('Mon dossier',label,desc,B('Retour au dossier','resume','btn'))}\nfunction readiness(){if(!own())return emptyCard('Ouvrez votre dossier pour afficher son bilan.');const r=report();return `${heading('Mon bilan prêt à remettre','Un contrôle de préparation pour retrouver ce qui manque.')}<section class=\"card\"><div class=\"study-status ${r.ready?'is-ready':''}\"><strong>${r.ready?'Vérifications complètes':'Encore '+(r.total-r.done)+' point(s) à vérifier'}</strong><span>${r.done} / ${r.total}</span></div><p class=\"small muted\">${r.ready?'Les rubriques vérifiées sont présentes. Relisez le PDF et respectez les consignes de votre professeur.':'Complétez les éléments ci-dessous puis revenez au bilan.'} Ce contrôle automatique ne garantit ni l’exactitude des informations ni la validation pédagogique.</p>${r.items.map((item,i)=>`<div class=\"study-check\"><div><strong>${item.ok?'✓':'À compléter'} · ${esc(item.label)}</strong>${!item.ok?`<p>${esc(item.detail)}</p>`:''}</div>${B(item.ok?'Relire':'Compléter','item','btn smol',`data-index=\"${i}\"`)}</div>`).join('')}<details class=\"study-details\"><summary>Relecture finale et avis du professeur</summary><p>Vérifiez l’orthographe, les faits, les autorisations concernant les images et la présentation imprimée.</p>${r.advice.map(a=>`<p>${esc(a)}</p>`).join('')}<p>${r.teacherValidated?'Un avis « validé » figure dans l’historique du dossier. Il concerne la version examinée par le professeur.':'Aucune validation globale du professeur ne figure dans les derniers avis.'}</p><p>Les nouvelles corrections demandées par le professeur restent à traiter avec lui, même après votre relecture.</p></details><div class=\"study-actions\">${B('Exporter mon dossier','screen','btn primary','data-screen=\"student-export\"')}</div></section>`}\nfunction kit(){if(!own())return emptyCard('Ouvrez un dossier.');const p=st.draft,letter=p.study?.letter||{},visit=p.study?.visit||{};return `${heading('Préparer ma visite','Une demande d’entretien personnalisée et quelques repères utiles.')}<section class=\"card ege-forms\"><h2>Avant le rendez-vous</h2>${EGEStudy.visit.map(([key,label])=>`<label class=\"study-checkbox\"><input type=\"checkbox\" data-study-visit=\"${key}\" ${visit[key]?'checked':''}><span>${esc(label)}</span></label>`).join('')}</section><details class=\"card study-details\"><summary>Ma lettre de demande d’entretien</summary><p class=\"small muted\">La lettre reprend l’identité, le sujet et l’entreprise du dossier. Complétez les informations entre crochets avant de l’utiliser.</p>${[['place','Lieu'],['date','Date à afficher'],['contact','Contact à communiquer (facultatif)'],['availability','Disponibilités et durée souhaitée (facultatif)']].map(([key,label])=>`<label class=\"field\"><span>${label}</span><input class=\"input\" maxlength=\"${key==='availability'?500:180}\" data-study-letter=\"${key}\" value=\"${esc(letter[key]||'')}\"></label>`).join('')}<pre class=\"study-letter\" id=\"studyLetter\">${esc(EGEStudy.letter(p,official))}</pre><div class=\"study-actions\">${B('Télécharger la lettre en PDF','pdf','btn primary','data-kind=\"letter\"')}${B('Copier le texte','copy-letter','btn')}</div><p class=\"small muted\">Aucun message n’est envoyé automatiquement à l’entreprise.</p></details>${B('Ouvrir le guide d’entretien','terrain-interview','btn')}`}\nfunction oral(){if(!own())return emptyCard('Ouvrez un dossier.');const o=EGEStudy.oral(st.draft,official);return `${heading('Préparer ma soutenance','Une fiche personnelle et des questions pour vous entraîner.')}<section class=\"card\"><h2>Les repères de mon étude</h2>${o.sections.map(([label,value])=>`<details class=\"study-details\"><summary>${esc(label)}</summary><p class=\"study-text\">${esc(value)}</p></details>`).join('')}${B('Télécharger ma fiche en PDF','pdf','btn','data-kind=\"oral\"')}</section><details class=\"card study-details\"><summary>Questions pour m’entraîner</summary><p class=\"small muted\">Répondez avec vos propres arguments. Ces questions ne préjugent pas de celles du jury.</p><ol>${o.questions.map(q=>`<li>${esc(q)}</li>`).join('')}</ol></details><details class=\"card study-details\"><summary>Chronomètre d’entraînement (facultatif)</summary><p class=\"small muted\">Choisissez une durée selon les consignes de votre professeur.</p><label class=\"field\"><span>Durée en minutes</span><input class=\"input\" id=\"studyMinutes\" type=\"number\" min=\"1\" max=\"60\" value=\"5\"></label><div class=\"study-timer\" id=\"studyTimer\" aria-label=\"Temps restant\">${clock()}</div><p role=\"status\" id=\"studyTimerStatus\"></p><div class=\"study-actions\">${B(running?'Pause':'Démarrer / reprendre','timer','btn primary','id=\"studyTimerButton\"')}${B('Réinitialiser','timer-reset','btn')}</div></details>`}\nfunction exports(){return `${heading('Exporter mon dossier','Choisissez le format dont vous avez besoin.')}<section class=\"card\"><h2>Une version à relire avant de remettre</h2><p class=\"small muted\">Le PDF rassemble la partie théorique, l’entreprise, les images jointes, l’entretien, le tableau comparatif et la synthèse. Un dossier incomplet porte la mention « Brouillon ».</p><div class=\"study-export-options\">${B('Télécharger le PDF','pdf','btn primary','data-kind=\"dossier\"')}${B('Ouvrir l’export Word','word','btn')}${B('Sauvegarder en JSON','backup','btn')}</div><p class=\"small muted\">Le Word reste modifiable. Le JSON sert à conserver une copie de travail. Les exports contiennent des données personnelles : partagez-les avec les destinataires souhaités.</p>${B('Vérifier mon bilan','screen','btn ghost','data-screen=\"student-ready\"')}<p class=\"small muted\">Pour exporter hors connexion, préparez d’abord les outils et les images depuis « Mon profil ».</p></section>`}\nfunction offlineSettings(){if(st.role!=='eleve'||!st.user)return '';const active=cache.config?.uid===st.user.id;return `<details class=\"card study-details\" id=\"studyOfflineSettings\"><summary>Travailler hors connexion</summary><p>Sur votre appareil personnel, préparez une copie de vos dossiers, des derniers avis et des images disponibles. Vous pourrez continuer à rédiger après avoir fermé l’application.</p><p class=\"small muted\">La copie préparée est chiffrée dans le stockage du navigateur. Elle reste accessible à une personne utilisant votre session sur cet appareil. La connexion, les nouveaux dossiers, l’envoi d’images et les opérations de compte nécessitent Internet.</p>${active?`<p>${cache.config.locked?'Préparation verrouillée.':'Préparé le '+longDate(cache.config.preparedAt)} · ${cache.config.imageCount||0} image(s)${cache.config.missingImages?' · '+cache.config.missingImages+' image(s) non disponible(s)':''}</p>`:'<label class=\"study-checkbox\"><input type=\"checkbox\" id=\"studyDeviceConsent\"><span>Ceci est mon appareil personnel. J’accepte d’y conserver mes dossiers.</span></label>'}<div class=\"study-actions\">${B(preparing?'Préparation en cours…':active?'Actualiser la préparation':'Préparer cet appareil','prepare','btn primary',preparing?'disabled':'')}${cache.config?B('Effacer la copie de cet appareil','erase','btn'):''}</div><p role=\"status\" id=\"studyOfflineMessage\">${esc(cache.message||'')}</p>${cache.pending.length?`<h3>${cache.pending.length} dossier(s) à synchroniser</h3>${cache.pending.map(row=>`<div class=\"study-pending\"><strong>${esc(st.docs.find(d=>d.id===row.id)?.title||row.payload.student||'Dossier')}</strong><p>${esc(row.conflict||'Modifications conservées sur cet appareil.')}</p>${B('Sauvegarder la copie locale','backup-pending','btn smol',`data-id=\"${esc(row.id)}\"`)}${row.conflict?B('Reprendre la version en ligne','discard','btn smol',`data-id=\"${esc(row.id)}\"`):''}</div>`).join('')}${B('Synchroniser maintenant','sync','btn')}`:''}<p class=\"small muted\">Conservez aussi une sauvegarde JSON. Le navigateur peut effacer son stockage si l’espace manque. La déconnexion efface la préparation hors connexion.</p></details>`}\nfunction clock(){return Math.floor(seconds/60).toString().padStart(2,'0')+':'+(seconds%60).toString().padStart(2,'0')}\nfunction stop(){clearInterval(timerId);timerId=null;running=false}\nfunction tick(){const e=$('studyTimer');if(e)e.textContent=clock();if(!seconds){stop();if($('studyTimerStatus'))$('studyTimerStatus').textContent='Temps écoulé. Vous pouvez recommencer.';if($('studyTimerButton'))$('studyTimerButton').textContent='Démarrer / reprendre'}}\nfunction readInvite(){invitationCode='';try{const q=new URLSearchParams(location.search).get('classe');if(q&&/^[A-Z0-9-]{4,40}$/i.test(q)){localStorage.setItem('ege2027_invitation',JSON.stringify({code:q.toUpperCase(),expires:Date.now()+7*86400000}));const u=new URL(location.href);u.searchParams.delete('classe');history.replaceState(null,'',u.pathname+u.search+u.hash)}const saved=JSON.parse(localStorage.getItem('ege2027_invitation')||'null');if(saved?.expires>Date.now()&&/^[A-Z0-9-]{4,40}$/i.test(saved.code))invitationCode=saved.code;else localStorage.removeItem('ege2027_invitation')}catch(_){}}\nreadInvite();\nfor(const [name,label] of [['student-ready','Bilan'],['student-kit','Préparer ma visite'],['student-oral','Soutenance'],['student-export','Exporter']])screenList.push([name,label]);\nconst previousView=view;view=function(){if(st.screen==='student-ready')return readiness();if(st.screen==='student-kit')return kit();if(st.screen==='student-oral')return oral();if(st.screen==='student-export')return exports();return previousView()+(['student-home','student-wizard','student-annex','student-terrain'].includes(st.screen)?tools():'')};\nconst previousProfile=profile;profile=function(){return previousProfile()+offlineSettings()};\nconst previousHome=studentHome;studentHome=function(){let html=previousHome();if(own()){const next=report().next;html=html.replace(/data-act=\"opendoc\"/,'data-study=\"next\"').replace('Continuer mon travail',next?'Continuer mon étude':'Voir mon bilan');html=html.replace('<div class=\"feature-bottom\">',`<div class=\"feature-bottom\"><div class=\"mb99-next\"><small>À faire ensuite</small><strong>${esc(next?next.label:'Relire mon dossier')}</strong></div>`)}return html};\nconst previousGo=go;go=function(screen){if(own()&&['student-wizard','student-annex','student-terrain'].includes(st.screen)){st.draft.study||={};st.draft.study.resume={screen:st.screen,wizardStep:st.wizardStep,annex:st.annex,terrainTab:egeTerrainTab};saveLocalDraft()}if(screen!=='student-oral')stop();previousGo(screen)};\nconst previousSelect=selectDoc;selectDoc=function(id){previousSelect(id);const row=cache.pending.find(p=>p.id===id);if(row&&own()){st.draft=structuredClone(row.payload);st.localCandidate=null;st.saveBadge=row.conflict?'Conflit à résoudre':'Conservé sur cet appareil';st.warning=row.conflict||''}const pos=st.draft?.study?.resume;if(pos){st.wizardStep=Math.min(4,Math.max(1,Number(pos.wizardStep)||1));st.annex=Math.min(EGEStudy.count(st.draft),Math.max(1,Number(pos.annex)||1));if(egeTerrainTabs.some(t=>t[0]===pos.terrainTab))egeTerrainTab=pos.terrainTab}};\nfunction remember(){if(own()&&['student-wizard','student-annex','student-terrain'].includes(st.screen)){st.draft.study||={};st.draft.study.resume={screen:st.screen,wizardStep:st.wizardStep,annex:st.annex,terrainTab:egeTerrainTab}}}\nconst previousLocal=saveLocalDraft;saveLocalDraft=function(){remember();if(own()&&EGEOffline.enabled(st.user.id)){EGEOffline.stage(st.user.id,currentDoc(),st.draft).catch(e=>{fail(e);st.warning='La copie locale n’a pas pu être enregistrée. Exportez une sauvegarde JSON.'})}else previousLocal()};\nconst previousSave=saveDoc;saveDoc=async function(opts={}){remember();if(!own())return previousSave(opts);if(EGEOffline.enabled(st.user.id)){const snapshot=structuredClone(st.draft),doc=currentDoc();await EGEOffline.stage(st.user.id,doc,snapshot);if(!navigator.onLine||st.offlineSession){markPending('Hors connexion — conservé sur cet appareil');return false}const rows=await EGEOffline.pending();if(rows[doc.id]?.conflict){markPending('Conflit à résoudre');return false}const ok=await previousSave(opts);if(ok)await EGEOffline.ack(st.user.id,doc.id,snapshot,currentDoc());return ok}return previousSave(opts)};\nconst previousLoad=loadAll;loadAll=async function(){const before=await EGEOffline.status();if(st.user&&before.config&&before.config.uid!==st.user.id)await EGEOffline.lock();await previousLoad();if(st.user&&st.role==='eleve'&&!st.lastError&&!EGEAccount.blocked(st.profile)&&!EGEAccount.incomplete(st.profile,st.role)&&st.loaded){st.offlineSession=false;await EGEOffline.capture(bundle()).catch(()=>{});await refreshStatus();if(cache.config&&cache.config.uid!==st.user.id)await EGEOffline.lock();if(!reconnecting&&cache.pending.length)await reconnect();}render()};\nconst previousSwitch=selectAndGoDoc;selectAndGoDoc=async function(id,screen='student-wizard'){if(own()&&st.selectedDocId!==id&&EGEOffline.enabled(st.user.id)&&(!navigator.onLine||st.offlineSession)){await EGEOffline.stage(st.user.id,currentDoc(),st.draft);await refreshStatus();selectDoc(id);go(screen);return}return previousSwitch(id,screen)};\nconst previousLogout=signOut;signOut=async function(){if(st.user&&EGEOffline.enabled(st.user.id)){saveLocalDraft();await EGEOffline.flush();const rows=await EGEOffline.pending();if(Object.keys(rows).length&&!await window.MBDialog.confirm('Des modifications locales ne sont pas encore synchronisées. Annulez pour les exporter ou les synchroniser. Continuer et effacer la copie de cet appareil ?'))return;await EGEOffline.clear()}await previousLogout();st.offlineSession=false;};\nasync function boot(){const snap=await EGEOffline.boot();if(!snap)return false;Object.assign(st,{user:snap.user,role:'eleve',profile:snap.profile,docs:snap.docs,reviews:snap.reviews,selectedDocId:snap.selectedDocId||snap.docs[0]?.id,groups:[],members:[],shares:[],loaded:true,offlineSession:true,screen:location.pathname.endsWith('/confidentialite.html')?'privacy':'student-home'});await refreshStatus();if(currentDoc())selectDoc(st.selectedDocId);st.saveBadge='Hors connexion — copie de cet appareil';st.lastError='';render();return true}\nasync function reconnect(){if(reconnecting||!navigator.onLine||!st.db||!EGEOffline.enabled(st.user?.id))return;const wasOffline=st.offlineSession||/Hors connexion|Conservé sur/.test(st.saveBadge);reconnecting=true;try{\n await EGEOffline.flush();const auth=await st.db.auth.getUser();if(auth.error)throw auth.error;if(!auth.data?.user||auth.data.user.id!==st.user?.id)throw Error('Reconnectez-vous avec le compte qui a préparé cet appareil avant de synchroniser.');\n st.user=auth.data.user;st.role=await resolveRole();st.profile=await EGEAccount.current(st.db);if(st.role!=='eleve'||EGEAccount.blocked(st.profile)){await EGEOffline.lock();st.docs=[];st.draft=null;st.screen='profile';throw Error('L’accès a changé. La synchronisation est suspendue.')}st.user=EGEAccount.userWithProfile(st.user,st.profile);st.offlineSession=false;\n const rows=await EGEOffline.pending();for(const local of Object.values(rows)){\n const r=await st.db.from('ege2027_dossiers').select('id,owner_id,title,student,payload,updated_at,archived_at,suspended_at,deleted_at').eq('id',local.id).eq('owner_id',st.user.id).maybeSingle();if(r.error)throw r.error;const remote=r.data;\n if(!remote||remote.deleted_at||remote.suspended_at||remote.archived_at){await EGEOffline.conflict(local.id,'Dossier inaccessible, archivé ou suspendu. La copie locale est conservée ; contactez l’administration.');continue}\n let saved=remote;if(!EGEOffline.same(remote.payload,local.payload)){if(remote.updated_at!==local.base){await EGEOffline.conflict(local.id,'Une autre version existe en ligne. Exportez la copie locale avant de choisir la version à reprendre.');continue}\n const result=await st.db.from('ege2027_dossiers').update({payload:local.payload,student:cleaned(local.payload.student),updated_at:new Date().toISOString()}).eq('id',local.id).eq('owner_id',st.user.id).eq('updated_at',local.base).select('id,owner_id,title,student,payload,updated_at,archived_at,suspended_at,deleted_at').maybeSingle();if(result.error)throw result.error;if(!result.data){await EGEOffline.conflict(local.id,'Une autre version vient d’être enregistrée. Votre copie locale est conservée.');continue}saved=result.data}\n await EGEOffline.ack(st.user.id,local.id,local.payload,saved);const i=st.docs.findIndex(d=>d.id===local.id);if(i>=0)st.docs[i]=saved;if(st.selectedDocId===local.id&&EGEOffline.same(st.draft,local.payload)){st.draft=structuredClone(saved.payload);clearLocalDraft();markPending('Enregistré en ligne');st.warning=''}\n }\n await refreshStatus();if(wasOffline){const beforeRefresh=JSON.stringify(st.draft);await previousLoad();await refreshStatus();if(JSON.stringify(st.draft)===beforeRefresh&&entityDoc(st.selectedDocId)&&!st.lastError)selectDoc(st.selectedDocId)}await EGEOffline.capture(bundle());if(!cache.pending.length){if(EGEOffline.same(st.draft,currentDoc()?.payload))markPending('Enregistré en ligne');toast('Vos modifications sont synchronisées.');}\n }catch(e){fail(e)}finally{reconnecting=false;await refreshStatus();render()}}\nasync function refreshStatus(){cache=await EGEOffline.status();if(cache.config&&cache.config.uid!==st.user?.id){cache.pending=[];cache.message='Un autre compte a préparé cet appareil. Effacez cette préparation avant de préparer votre propre compte.'}const msg=$('studyOfflineMessage');if(msg)msg.textContent=cache.message;const banner=$('studyOfflineBanner');if(banner){banner.hidden=!(st.user&&st.role==='eleve'&&(st.offlineSession||!navigator.onLine||cache.pending.some(r=>r.conflict)));banner.querySelector('span').textContent=cache.pending.some(r=>r.conflict)?'Une version locale doit être vérifiée.':'Hors connexion · les modifications restent sur cet appareil.'}}\nconst previousRender=render;render=function(){previousRender();if(st.role==='eleve'&&st.user){const section=document.querySelector('#content > .screen');if(section)section.insertAdjacentHTML('afterbegin',`<div class=\"notice info study-offline\" id=\"studyOfflineBanner\" hidden role=\"status\"><span></span>${B('Voir la sauvegarde','screen','btn smol','data-screen=\"profile\"')}</div>`)}if(['student-group','student-group-join','welcome'].includes(st.screen))readInvite();if(invitationCode&&['student-group','student-group-join'].includes(st.screen)){const input=$('joinCode');if(input&&!input.value)input.value=invitationCode}if(invitationCode&&st.screen==='welcome'){const content=document.querySelector('#content > .screen');content?.insertAdjacentHTML('afterbegin',`<div class=\"notice info\"><span>Invitation de classe : <strong>${esc(invitationCode)}</strong>. Créez votre compte, puis rejoignez la classe quand vous le souhaitez depuis « Ma classe ».</span></div>`)}refreshStatus().catch(()=>{});};\nconst previousJoin=joinGroup;joinGroup=async function(){await previousJoin();invitationCode='';try{localStorage.removeItem('ege2027_invitation')}catch(_){}};\nfunction backup(payload,name='dossier'){const blob=new Blob([JSON.stringify({app:'EGE 2027',exportedAt:new Date().toISOString(),data:payload},null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='EGE-2027-'+name+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}\nfunction item(item){if(!item)return go('student-ready');if(item.target==='student-wizard')st.wizardStep=item.tab;if(item.target==='student-annex')st.annex=item.annex;if(item.target==='student-terrain')egeTerrainTab=item.tab;go(item.target)}\nfunction resume(){const pos=st.draft?.study?.resume;go(['student-wizard','student-terrain','student-annex'].includes(pos?.screen)?pos.screen:'student-wizard')}\nasync function invite(id){const g=st.groups.find(g=>g.id===id);if(st.role!=='enseignant'||!g||!g.active||g.suspended_at||g.deleted_at)throw Error('Ce code de classe est désactivé.');invitationGroup=g;await EGEPDF.load('/study-qr.js');const link=EGEStudy.invitation(g.join_code),qr=qrcodegen.QrCode.encodeText(link,qrcodegen.QrCode.Ecc.MEDIUM),border=4,size=qr.size+border*2;let path='';for(let y=0;y<qr.size;y++)for(let x=0;x<qr.size;x++)if(qr.getModule(x,y))path+=`M${x+border},${y+border}h1v1h-1z `;const svg=`<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ${size} ${size}\" role=\"img\" aria-label=\"QR code pour rejoindre la classe\"><rect width=\"100%\" height=\"100%\" fill=\"white\"/><path d=\"${path}\" fill=\"black\"/></svg>`;let dialog=$('studyInvite');if(dialog)dialog.remove();document.body.insertAdjacentHTML('beforeend',`<dialog id=\"studyInvite\" class=\"study-invite\" aria-labelledby=\"studyInviteTitle\"><div class=\"study-invite-head\"><h2 id=\"studyInviteTitle\">Inviter ma classe</h2>${B('Fermer','close-invite','btn smol')}</div><p><strong>${esc(g.name)}</strong> · ${esc(g.school)}</p><div class=\"study-qr\">${svg}</div><p class=\"study-code\">${esc(g.join_code)}</p><label class=\"field\"><span>Lien d’invitation</span><input class=\"input\" readonly id=\"studyInviteLink\" value=\"${esc(link)}\"></label><p class=\"small muted\">L’élève se connecte puis confirme son inscription. Son dossier reste privé jusqu’à son association au groupe.</p><div class=\"study-actions\">${B('Copier le lien','copy-invite','btn primary')}${B('Télécharger le QR code','download-qr','btn')}</div></dialog>`);$('studyInvite').showModal();$('studyInvite').dataset.svg=svg;}\nasync function action(el){const a=el.dataset.study;if(a==='screen'){go(el.dataset.screen);return}if(a==='next'){item(report().next);return}if(a==='item'){item(report().items[Number(el.dataset.index)]);return}if(a==='resume'){resume();return}if(a==='terrain-interview'){egeTerrainTab='interview';go('student-terrain');return}\n if(a==='word'){await legacyEditor();return}if(a==='backup'){backup(st.draft);return}if(a==='backup-pending'){const row=cache.pending.find(r=>r.id===el.dataset.id);if(row)backup(row.payload,'copie-locale');return}\n if(a==='pdf'){if(pdfBusy)return;pdfBusy=true;el.disabled=true;try{await EGEPDF.download(structuredClone(st.draft),{kind:el.dataset.kind,catalog:official,reviews:reviews(),db:st.db});toast('PDF téléchargé. Vérifiez-le avant de le remettre.')}finally{pdfBusy=false;el.disabled=false}return}\n if(a==='copy-letter'){await navigator.clipboard.writeText(EGEStudy.letter(st.draft,official));toast('Lettre copiée.');return}\n if(a==='prepare'){if(preparing)return;if(!navigator.onLine||st.offlineSession)throw Error('Reconnectez-vous à Internet pour préparer cet appareil.');if(cache.config?.uid!==st.user?.id&&!$('studyDeviceConsent')?.checked)throw Error('Confirmez que vous utilisez votre appareil personnel.');preparing=true;el.disabled=true;el.textContent='Préparation en cours…';try{const auth=await st.db.auth.getUser();if(auth.error||auth.data.user?.id!==st.user.id)throw Error('Reconnectez-vous pour préparer cet appareil.');st.role=await resolveRole();st.profile=await EGEAccount.current(st.db);if(EGEAccount.blocked(st.profile)||st.role!=='eleve')throw Error('Un compte élève actif est nécessaire.');await EGEOffline.enable(bundle());if(!EGEOffline.same(currentDoc()?.payload,st.draft))saveLocalDraft();await EGEOffline.flush();await EGEPDF.prepare();await EGEPDF.load('/study-qr.js');if('caches' in window){const shell=await caches.open('ege-gfm-2027-shell-v45');await shell.addAll(['/study-jspdf.js','/study-fonts.js','/study-qr.js'])}const prepared=await EGEOffline.boot();const images=await EGEOffline.cacheImages(st.db,{...bundle(),docs:prepared?.docs||st.docs});if(!navigator.serviceWorker?.controller){if(navigator.serviceWorker)await Promise.race([navigator.serviceWorker.ready,new Promise(resolve=>setTimeout(resolve,10000))]);toast('Préparation enregistrée. Rechargez une fois avec Internet pour activer l’ouverture hors connexion.')}else toast(images.missing?'Textes préparés. Certaines images restent indisponibles.':'Appareil préparé : textes, images et outils disponibles.');}finally{preparing=false;await refreshStatus();render();$('studyOfflineSettings')?.setAttribute('open','')}return}\n if(a==='sync'){await reconnect();return}if(a==='erase'){if(await window.MBDialog.confirm('Effacer la préparation et les modifications non synchronisées de cet appareil ? Exportez une sauvegarde JSON auparavant si nécessaire.')){await EGEOffline.clear();await refreshStatus();render()}return}\n if(a==='discard'){if(!navigator.onLine)throw Error('Internet est nécessaire pour recharger la version en ligne.');if(await window.MBDialog.confirm('Reprendre la version en ligne et supprimer les modifications locales de ce dossier ? Téléchargez la copie locale avant de continuer.')){await EGEOffline.discard(el.dataset.id);if(st.selectedDocId===el.dataset.id){st.draft=null;clearLocalDraft()}await loadAll();await refreshStatus();render()}return}\n if(a==='timer'){if(running){stop();el.textContent='Démarrer / reprendre'}else{if(!seconds)seconds=Math.min(60,Math.max(1,Number($('studyMinutes')?.value)||5))*60;running=true;el.textContent='Pause';timerId=setInterval(()=>{seconds=Math.max(0,seconds-1);tick()},1000)}return}if(a==='timer-reset'){stop();seconds=Math.min(60,Math.max(1,Number($('studyMinutes')?.value)||5))*60;tick();$('studyTimerButton').textContent='Démarrer / reprendre';$('studyTimerStatus').textContent='';return}\n if(a==='invite'){await invite(el.dataset.id);return}if(a==='close-invite'){$('studyInvite')?.close();return}if(a==='copy-invite'){try{await navigator.clipboard.writeText($('studyInviteLink').value);toast('Lien copié.')}catch(_){$('studyInviteLink').select();toast('Copiez le lien sélectionné.')}return}if(a==='download-qr'){const blob=new Blob([$('studyInvite').dataset.svg],{type:'image/svg+xml'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='EGE-2027-classe-'+invitationGroup.join_code+'.svg';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}\n}\ndocument.addEventListener('click',event=>{const el=event.target.closest?.('[data-study]');if(!el)return;event.preventDefault();action(el).catch(e=>{fail(e);const out=$('studyOfflineMessage');if(out)out.textContent=e.message})});\ndocument.addEventListener('input',event=>{const el=event.target;if(!own()||!el?.dataset?.studyLetter)return;st.draft.study||={};st.draft.study.letter||={};st.draft.study.letter[el.dataset.studyLetter]=el.value;touchTerrain();if($('studyLetter'))$('studyLetter').textContent=EGEStudy.letter(st.draft,official)});\ndocument.addEventListener('change',event=>{const el=event.target;if(el?.id==='studyMinutes'&&!running){seconds=Math.min(60,Math.max(1,Number(el.value)||5))*60;tick()}if(!own()||!el?.dataset?.studyVisit)return;st.draft.study||={};st.draft.study.visit||={};st.draft.study.visit[el.dataset.studyVisit]=el.checked;touchTerrain()});\nwindow.addEventListener('ege-offline-change',()=>refreshStatus().catch(()=>{}));window.addEventListener('offline',()=>{if(own()){saveLocalDraft();markPending('Hors connexion — brouillon conservé')}refreshStatus().catch(()=>{})});\ndocument.addEventListener('submit',event=>{if(st.offlineSession||!navigator.onLine){event.preventDefault();event.stopImmediatePropagation();toast('Cette opération nécessite Internet. Vos textes peuvent être modifiés dans le dossier.')}},true);\ndocument.addEventListener('click',event=>{if(!st.offlineSession&&navigator.onLine)return;const a=event.target.closest?.('[data-act]')?.dataset?.act;if(['newdoc','archive','join-group','associate','profile-save','resend-confirm','annex-research','research','design-request'].includes(a)){event.preventDefault();event.stopImmediatePropagation();toast('Cette opération nécessite Internet. Vous pouvez continuer à rédiger les dossiers préparés.')}},true);\nwindow.EGEStudyUI={boot,reconnect,refreshStatus,backup,tools};\n})();\n"],"/study-legacy.js":["application/javascript; charset=utf-8",false,"/* Le Word conserve le même dossier préparé ; le retour au parcours vérifie le compte avant synchronisation. */\n(()=>{'use strict';\nlet owner=null,doc=null;\nasync function boot(){if(navigator.onLine)return false;const snap=await EGEOffline.boot();if(!snap||snap.role!==\"eleve\"||snap.profile?.academic_level!==\"Terminale\"||![\"GFM\",\"OGRH\",\"IAG\"].includes(snap.profile?.series))return false;let selected;try{selected=JSON.parse(localStorage.getItem('ege2027_dossier_selection_'+snap.user.id)||'null')}catch(_){}doc=snap.docs.find(d=>d.id===selected?.id)||snap.docs.find(d=>d.id===snap.selectedDocId)||snap.docs[0];if(!doc)return false;owner=snap.user.id;window.EGELegacyOffline=true;egeCloudUser=snap.user;egeCloudStaff=null;data={...empty(),...doc.payload};localStorage.setItem(KEY,JSON.stringify(data));localStorage.setItem('ege2027_dossier_selection_'+owner,JSON.stringify({id:doc.id,title:doc.title,updated_at:doc.updated_at}));egeCloudRefresh();render();const host=document.createElement('div');host.className='ege-offline-word';host.setAttribute('role','status');host.style.cssText='padding:14px 20px;background:#edf6ff;color:#254967;font:14px/1.6 system-ui';host.append(document.createTextNode('Hors connexion : rédaction et export disponibles. Pour synchroniser, revenez au parcours avec Internet. '));const a=document.createElement('a');a.href='/';a.textContent='Retour à mon dossier';host.append(a);document.body.prepend(host);return true}\nasync function stage(){if(typeof egeCloudUser==='undefined'||!egeCloudUser)return;const uid=egeCloudUser.id;if(!EGEOffline.enabled(uid))return;let selection;try{selection=JSON.parse(localStorage.getItem('ege2027_dossier_selection_'+uid)||'null')}catch(_){}if(selection?.id)await EGEOffline.stage(uid,{id:selection.id,owner_id:uid,updated_at:selection.updated_at},data)}\nwindow.EGEStudyLegacy={boot,stage};\nEGEOffline.status().catch(()=>{});\n})();\n"],"/study-fonts.js":["application/javascript; charset=utf-8",false,"/* DejaVu Sans — licence Bitstream Vera, voir /study-licenses.txt */\nwindow.EGEFonts={\"normal\": \"\", \"bold\": \"