ementById(id);\nconst cleaned=v=>String(v??\"\").trim();\nconst shortDate=v=>v?new Date(v).toLocaleDateString(\"fr-FR\"):\"—\";\nconst longDate=v=>v?new Date(v).toLocaleString(\"fr-FR\"):\"—\";\nconst badge=(t,type=\"\")=>`<span class=\"badge ${type}\">${esc(t)}</span>`;\nconst btn=(text,act,cls=\"btn\",icon=\"\",data=\"\")=>`<button type=\"button\" class=\"${cls}\" data-act=\"${esc(act)}\" ${data}>${icon?I(icon):\"\"}${esc(text)}</button>`;\nconst title=(eyebrow,name,desc,tools=\"\")=>`<div class=\"page-head\"><div><div class=\"page-eyebrow\">${esc(eyebrow)}</div><h1>${esc(name)}</h1><p>${esc(desc)}</p></div><div class=\"inline-actions\">${tools}</div></div>`;\nconst box=(s)=>`<div class=\"card\">${s}</div>`;\nconst emptyCard=(msg)=>`<div class=\"empty\">${esc(msg)}</div>`;\nconst stateSafe=()=>st.db&&st.user;\nconst currentDoc=()=>st.docs.find(d=>d.id===st.selectedDocId)||null;\nconst currentGroup=()=>st.groups.find(g=>g.id===st.selectedGroupId)||null;\nconst currentTeacherDoc=()=>st.docs.find(d=>d.id===st.selectedDocId)||null;\nconst entityDoc=(id)=>st.docs.find(d=>d.id===id)||null;\nconst docTitle=d=>cleaned(d?.title)||cleaned(d?.payload?.problem)||\"Mon dossier EGE\";\nconst displayStudent=d=>cleaned(d?.payload?.student)||cleaned(d?.student)||\"Élève\";\nconst status=v=>{st.notice=String(v||\"\");st.lastError=\"\";if(st.notice===\"Connexion réussie.\")window.MBTools?.beginLoginMessage?.();};\nconst fail=e=>{st.lastError=String(e?.message||e||\"Erreur inconnue\");st.notice=\"\";if(window.MBDialog)void window.MBDialog.notice('Une erreur est survenue',st.lastError,'error');else toast(\"Opération non aboutie : \"+st.lastError);};\nconst toast=s=>{const message=String(s);if(window.MBDialog&&/^(Dossier (?:archivé|créé|associé)|Travail validé|Correction transmise|Décision enregistrée|Modification enregistrée|Demande envoyée|Classe (?:créée|rejointe)|Groupe créé|Élève retiré)/i.test(message)){void window.MBDialog.notice(message.split(/[.!]/)[0],message,'success');return}const el=$(\"toast\");if(!el)return;el.textContent=message;el.classList.add(\"show\");clearTimeout(window.__egeToastTimer);window.__egeToastTimer=setTimeout(()=>el.classList.remove(\"show\"),3500)};\nconst markPending=s=>{st.saveBadge=s;const b=$(\"saveState\");if(b)b.textContent=s;};\nconst csvCount=n=>Number(n||0).toLocaleString(\"fr-FR\");\nconst emptyPayload=()=>({study:{},series:EGEAcademic.seriesOf(st.user?.user_metadata),mode:\"individuel\",student:cleaned(st.user?.user_metadata?.full_name),partner:\"\",className:cleaned(st.user?.user_metadata?.class_name),school:cleaned(st.user?.user_metadata?.school),teacher:\"\",theme:null,subtheme:null,problem:\"\",problemMode:\"custom\",annexes:{},annexTitles:{},sources:{},sourceChecks:{},researchEvidence:{},annexBackup:{},company:\"\",terrain:EGETerrain.empty(),candidates:Array(7).fill(\"\"),resumeAt:\"student\",step:\"welcome\"});\nfunction docProgress(d){\n const p=d?.payload||{},items=[!!cleaned(p.student),Number.isInteger(p.theme),Number.isInteger(p.subtheme),!!cleaned(p.problem)];\n const count=p.mode===\"binome\"?4:3;\n for(let n=1;n<=count;n++)items.push(!!cleaned(p.annexes?.[n])&&!!cleaned(p.sources?.[n]));\n return Math.round(items.filter(Boolean).length/items.length*100);\n}\nfunction getTitle(n,p){return cleaned(p?.annexTitles?.[n])||([\"\",\"Les notions générales\",\"Comprendre le sous-thème\",\"Éléments de réponse à la problématique\",\"Conditions et limites\"][n]);}\nfunction saveLocalDraft(){\n if(!st.user||!st.draft||!st.selectedDocId)return;\n try{localStorage.setItem(`ege27_draft_${st.user.id}_${st.selectedDocId}`,JSON.stringify({payload:st.draft,modifiedAt:Date.now()}))}catch(_){}\n}\nfunction clearLocalDraft(){\n if(!st.user||!st.selectedDocId)return;\n try{localStorage.removeItem(`ege27_draft_${st.user.id}_${st.selectedDocId}`)}catch(_){}\n}\nfunction restoreLocalDraft(){\n if(!st.user||!st.selectedDocId||!st.draft)return;\n try{\n  const data=JSON.parse(localStorage.getItem(`ege27_draft_${st.user.id}_${st.selectedDocId}`)||\"null\");\n  if(data?.payload&&JSON.stringify(data.payload)!==JSON.stringify(st.draft)){\n   st.warning=\"Un brouillon local différent existe. Vous pouvez l'importer sans écraser le dossier en ligne.\";\n   st.localCandidate=data.payload; markPending(\"Brouillon local à récupérer\");\n  }else{st.localCandidate=null;st.warning=\"\";}\n }catch(_){}\n}\nfunction selectDoc(id){\n const d=entityDoc(id);if(!d)throw Error(\"Ce dossier n'est pas accessible.\");\n st.selectedDocId=d.id;st.draft=JSON.parse(JSON.stringify(d.payload||emptyPayload()));st.wizardStep=1;st.annex=1;\n st.draft.series=EGEAcademic.seriesOf(d.payload);\n st.draft.terrain=EGETerrain.normalize(d.payload?.terrain,d.payload);\n st.saveBadge=\"Enregistré en ligne\";st.warning=\"\";st.localCandidate=null;restoreLocalDraft();\n}\nfunction go(screen){\n if(!screenList.some(x=>x[0]===screen))return;\n if(st.busy)return;\n const scope=screen.split(\"-\")[0];\n if([\"student\",\"teacher\",\"admin\"].includes(scope)){\n  const role={student:\"eleve\",teacher:\"enseignant\",admin:\"admin\"}[scope];\n  if(!st.user){st.desired=role;st.screen=\"auth\";render();return;}\n  if(st.role!==role){toast(\"Cet espace n'est pas autorisé pour ce compte.\");return}\n }\n st.screen=screen;st.notice=\"\";st.lastError=\"\";render();\n if(typeof scrollTo===\"function\")scrollTo({top:0,behavior:\"instant\"});\n}\nasync function resolveRole(){\n if(!st.user)return null;\n const [a,b]=await Promise.all([\n  st.db.from(\"ege2027_staff\").select(\"role\").eq(\"user_id\",st.user.id).maybeSingle(),\n  st.db.from(\"ege2027_teacher_requests\").select(\"user_id,full_name,school,status,rejection_reason\").eq(\"user_id\",st.user.id).maybeSingle()\n ]);\n if(a.error)throw a.error;if(b.error)throw b.error;\n st.staff=a.data||null;st.teacher=b.data||null;\n if(a.data?.role===\"admin\")return \"admin\";\n if(b.data||a.data?.role===\"enseignant\"||st.user.app_metadata?.ege2027_account_kind===\"enseignant\"||st.user.user_metadata?.requested_role===\"enseignant\")return \"enseignant\";\n return \"eleve\";\n}\nasync function readRows(table,columns=\"*\",configure=null){\n let q=st.db.from(table).select(columns);\n if(configure)q=configure(q);\n const {data,error}=await q;if(error)throw error;return data||[];\n}\nasync function loadAll(){\n if(!st.user)return;\n st.loaded=false;\n const role=st.role;\n try{\n  if(role===\"eleve\"){\n   st.docs=await readRows(\"ege2027_dossiers\",\"id,owner_id,title,student,payload,updated_at,archived_at,suspended_at,deleted_at\",q=>q.eq(\"owner_id\",st.user.id).is(\"archived_at\",null).order(\"updated_at\",{ascending:false}).limit(300));\n   st.members=await readRows(\"ege2027_group_members\",\"group_id,student_id,student_name,teacher_id,joined_at\",q=>q.eq(\"student_id\",st.user.id));\n   const gids=[...new Set(st.members.map(m=>m.group_id))];\n   st.groups=gids.length?await readRows(\"ege2027_teacher_groups\",\"id,name,school,subject,teacher_id,join_code,active,archived_at,suspended_at,deleted_at,updated_at\",q=>q.in(\"id\",gids)):[];\n   st.shares=await readRows(\"ege2027_group_submissions\",\"id,group_id,dossier_id,student_id\",q=>q.eq(\"student_id\",st.user.id));\n   const ids=st.docs.map(d=>d.id);\n   st.reviews=ids.length?await readRows(\"ege2027_reviews\",\"id,dossier_id,decision,observation,annex_number,created_at\",q=>q.in(\"dossier_id\",ids).order(\"created_at\",{ascending:false}).limit(500)):[];\n  } else if(role===\"enseignant\"){\n   const request=await st.db.from(\"ege2027_teacher_requests\").select(\"user_id,full_name,school,status,rejection_reason\").eq(\"user_id\",st.user.id).maybeSingle();if(request.error)throw request.error;st.teacher=request.data||null;\n   if(st.teacher?.status!==\"approved\"){st.docs=[];st.groups=[];st.members=[];st.shares=[];st.reviews=[];await loadAds();st.loaded=true;render();return;}\n   st.groups=await readRows(\"ege2027_teacher_groups\",\"id,name,school,subject,join_code,active,archived_at,suspended_at,deleted_at,updated_at,teacher_id,created_at\",q=>q.eq(\"teacher_id\",st.user.id).order(\"created_at\",{ascending:false}));\n   const gids=st.groups.map(x=>x.id);\n   st.members=gids.length?await readRows(\"ege2027_group_members\",\"group_id,student_id,student_name,joined_at\",q=>q.in(\"group_id\",gids)):[];\n   st.shares=gids.length?await readRows(\"ege2027_group_submissions\",\"group_id,student_id,dossier_id,submitted_at\",q=>q.in(\"group_id\",gids)):[];\n   const ids=[...new Set(st.shares.map(x=>x.dossier_id))];\n   st.docs=ids.length?await readRows(\"ege2027_dossiers\",\"id,owner_id,title,student,payload,updated_at,archived_at,suspended_at,deleted_at\",q=>q.in(\"id\",ids).is(\"archived_at\",null).limit(500)):[];\n   st.reviews=ids.length?await readRows(\"ege2027_reviews\",\"id,dossier_id,decision,observation,annex_number,created_at\",q=>q.in(\"dossier_id\",ids).order(\"created_at\",{ascending:false}).limit(500)):[];\n  } else {\n   st.requests=await readRows(\"ege2027_teacher_requests\",\"user_id,full_name,school,status,created_at,reviewed_at,rejection_reason\",q=>q.order(\"created_at\",{ascending:false}).limit(300));\n   st.docs=await readRows(\"ege2027_dossiers\",\"id,owner_id,title,student,payload,updated_at,archived_at,suspended_at,deleted_at\",q=>q.order(\"updated_at\",{ascending:false}).limit(1000));\n   st.groups=await readRows(\"ege2027_teacher_groups\",\"id,teacher_id,name,school,subject,join_code,active,archived_at,suspended_at,deleted_at,updated_at,created_at\",q=>q.order(\"created_at\",{ascending:false}).limit(500));\n   st.members=await readRows(\"ege2027_group_members\",\"group_id,student_id,student_name,joined_at\",q=>q.limit(1000));\n   st.shares=await readRows(\"ege2027_group_submissions\",\"group_id,student_id,dossier_id\",q=>q.limit(1500));\n   st.reviews=await readRows(\"ege2027_reviews\",\"id,dossier_id,decision,observation,annex_number,created_at\",q=>q.order(\"created_at\",{ascending:false}).limit(500));\n   st.audit=await readRows(\"ege2027_audit_log\",\"id,action,entity_type,created_at,details\",q=>q.order(\"created_at\",{ascending:false}).limit(70));\n   const sets=await readRows(\"ege2027_settings\",\"app_title,academic_year,student_message\",q=>q.eq(\"id\",1).limit(1));\n   st.settings=sets[0]||null;\n  }\n  if(!entityDoc(st.selectedDocId)){\n   st.selectedDocId=st.docs[0]?.id||null;\n   st.draft=null;\n  }\n  if(st.selectedDocId&&st.role===\"eleve\"&&!st.draft)selectDoc(st.selectedDocId);\n  if(!st.groups.some(g=>g.id===st.selectedGroupId))st.selectedGroupId=st.groups[0]?.id||null;\n  await Promise.all([loadAds(),loadPricing()]);\n  st.loaded=true;render();\n }catch(e){st.loaded=true;fail(e);render()}\n}\nasync function initApp(){\n const privacyRoute=location.pathname.endsWith(\"/confidentialite.html\");\n if(privacyRoute)st.screen=\"privacy\";\n render();\n const factory=window.supabase?.createClient;\n if(!factory){st.lastError=\"Impossible de charger le service de connexion. Vérifiez Internet.\";render();return}\n st.db=factory(DB_URL,DB_PUBLIC,{auth:{experimental:{passkey:true}}});\n if(!navigator.onLine&&await window.EGEStudyUI?.boot())return;\n if(initialAuthHash.has(\"error\")){st.mode=\"confirm\";st.screen=\"auth\";st.lastError=EGEAccount.authMessage(initialAuthHash.get(\"error_description\")||\"Lien expiré\");history.replaceState(null,\"\",location.pathname);}\n await Promise.all([loadAds(),loadPricing()]);\n st.db.auth.onAuthStateChange((event)=>{if(event===\"PASSWORD_RECOVERY\"){st.pendingPasswordReset=true;st.screen=\"auth\";render()}});\n try{\n  const {data,error}=await st.db.auth.getUser();\n  if(error&&error.name!==\"AuthSessionMissingError\"&&!/auth session missing/i.test(error.message||\"\"))throw error;\n  st.user=data?.user||null;\n  if(st.user){\n   st.role=await resolveRole();\n   if(st.role===\"enseignant\"&&!st.teacher){\n    const m=st.user.user_metadata||{};\n    if(m.full_name&&m.school){\n     const {error:reqError}=await st.db.from(\"ege2027_teacher_requests\").insert({user_id:st.user.id,full_name:m.full_name,school:m.school,status:\"pending\"});\n     if(reqError)throw reqError;st.role=await resolveRole();\n    }\n   }\n   if(privacyRoute){st.screen=\"privacy\";}\n   else if(st.pendingPasswordReset||initialAuthHash.get(\"type\")===\"recovery\"){st.pendingPasswordReset=true;st.screen=\"auth\";}\n   else if(new URLSearchParams(location.search).get(\"profil\")===\"1\"){st.screen=\"profile\";}\n   else if(new URLSearchParams(location.search).get(\"choisir\")===\"1\"){st.screen=\"welcome\";}\n   else if(new URLSearchParams(location.hash.slice(1)).get(\"type\")===\"recovery\"){st.pendingPasswordReset=true;st.screen=\"auth\";}\n   else st.screen=location.pathname.endsWith(\"/annonces.html\")?\"ads-directory\":homes[st.role];\n   await loadAll();\n   const request=new URLSearchParams(location.search),requestedDoc=request.get('dossier');\n   if(st.role==='eleve'&&request.get('vue')==='terrain'&&entityDoc(requestedDoc)){selectDoc(requestedDoc);st.screen='student-terrain';render()}\n  } else {\n   if(privacyRoute)st.screen=\"privacy\";\n   else if(location.pathname.endsWith(\"/annonces.html\"))st.screen=\"ads-directory\";\n   else if(new URLSearchParams(location.search).get(\"connexion\")===\"1\"){st.screen=\"auth\";st.mode=\"login\";}\n   else if(new URLSearchParams(location.search).get(\"inscription\")===\"1\"){st.screen=\"auth\";st.mode=\"signup\";st.desired=\"eleve\"}\n   render();\n  }\n }catch(e){if(!await window.EGEStudyUI?.boot()){fail(e);render();}}\n if(\"serviceWorker\" in navigator)navigator.serviceWorker.register(\"./service-worker-ege-2027.js\").catch(()=>{});\n}\nasync function doLogin(mode){\n const email=cleaned($(\"authEmail\")?.value).toLowerCase();\n const password=$(\"authPassword\")?.value||\"\";\n const full_name=cleaned($(\"authFullName\")?.value);\n const school=cleaned($(\"authSchool\")?.value);\n const series=cleaned($(\"authSeries\")?.value);\n const class_name=cleaned($(\"authClass\")?.value);\n if(!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email))throw Error(\"Saisissez une adresse e-mail valide.\");\n if(mode!==\"forgot\"&&password.length<(mode===\"signup\"?12:6))throw Error(mode===\"signup\"?\"Le mot de passe doit contenir au moins 12 caractères.\":\"Vérifiez votre mot de passe.\");\n if(mode===\"forgot\"){\n  const {error}=await st.db.auth.resetPasswordForEmail(email,{redirectTo:appBase});if(error)throw error;\n  status(\"Si le compte existe, un e-mail de réinitialisation a été demandé. Vérifiez votre boîte de réception et les courriers indésirables.\");return;\n }\n if(mode===\"signup\"){\n  if(!full_name||!EGEAcademic.schools.includes(school))throw Error(\"Indiquez votre nom et choisissez votre établissement.\");\n  if(st.desired===\"eleve\"&&(!EGEAcademic.series.includes(series)||!EGEAcademic.classes[series].includes(class_name)))throw Error(\"Choisissez votre série et une classe de cette série.\");\n  const metadata={requested_role:st.desired,full_name,school};\n  if(st.desired===\"eleve\")metadata.whatsapp_number=EGEAccount.whatsapp($(\"authWhatsApp\")?.value);\n  if(st.desired===\"eleve\")Object.assign(metadata,{series,class_name});\n  const {data,error}=await st.db.auth.signUp({email,password,options:{emailRedirectTo:appBase,data:metadata}});\n  if(error)throw error;\n  if(!data.session){st.confirmEmail=email;st.mode=\"confirm\";st.confirmSentAt=Date.now();return}\n }else{\n  const {error}=await st.db.auth.signInWithPassword({email,password});\n  if(error){if(/email.*not.*confirmed/i.test(error.message)){st.confirmEmail=email;st.mode=\"confirm\";st.screen=\"auth\";render()}throw Error(EGEAccount.authMessage(error));}\n }\n const {data,error}=await st.db.auth.getUser();if(error)throw error;\n st.user=data.user;st.role=await resolveRole();\n if(st.desired===\"admin\"&&st.role!==\"admin\")throw Error(\"Ce compte ne possède pas les droits administrateur.\");\n if(st.desired===\"enseignant\"&&st.role===\"eleve\")throw Error(\"Ce compte n'a pas de profil enseignant.\");\n if(st.role===\"enseignant\"&&!st.teacher){\n  const info=st.user.user_metadata||{};\n  if(info.full_name&&info.school){\n   const {error:requestError}=await st.db.from(\"ege2027_teacher_requests\").insert({user_id:st.user.id,full_name:info.full_name,school:info.school,status:\"pending\"});\n   if(requestError)throw requestError;\n   st.role=await resolveRole();\n  }\n }\n st.screen=homes[st.role];status(\"Connexion réussie.\");await loadAll();\n}\nasync function recoverPassword(){\n const password=$(\"newPassword\")?.value||\"\";\n if(password.length<12)throw Error(\"Le nouveau mot de passe doit contenir au moins 12 caractères.\");\n const {error}=await st.db.auth.updateUser({password});if(error)throw error;\n history.replaceState(null,\"\",location.pathname);st.pendingPasswordReset=false;\n toast(\"Mot de passe modifié.\");st.screen=homes[st.role]||\"welcome\";render();\n}\nasync function signOut(){\n if(st.db){const {error}=await st.db.auth.signOut({scope:st.offlineSession?\"local\":\"global\"});if(error)throw error}\n clearTimeout(st.saveTimer);\n egeTerrainImages.clear();\n Object.assign(st,{user:null,staff:null,teacher:null,role:\"eleve\",desired:\"eleve\",docs:[],groups:[],members:[],shares:[],reviews:[],requests:[],audit:[],ads:[],selectedDocId:null,selectedGroupId:null,draft:null,screen:\"welcome\",loaded:false});\n await loadAds();\n render();\n}\nasync function createDoc(){\n if(!stateSafe()||st.role!==\"eleve\")throw Error(\"Connectez-vous dans l'espace élève.\");\n const payload=emptyPayload();\n const {data,error}=await st.db.from(\"ege2027_dossiers\").insert({owner_id:st.user.id,title:\"Nouveau dossier EGE\",student:\"\",payload}).select(\"id,owner_id,title,student,payload,updated_at,archived_at,suspended_at,deleted_at\").single();\n if(error)throw error;\n st.docs.unshift(data);selectDoc(data.id);st.wizardStep=1;go(\"student-wizard\");toast(\"Nouveau dossier créé.\");\n}\nasync function setDraftField(name,value){\n if(!st.draft||st.role!==\"eleve\")return;\n const map={dMode:\"mode\",dStudent:\"student\",dPartner:\"partner\",dClass:\"className\",dSchool:\"school\",dTeacher:\"teacher\",dProblem:\"problem\"};\n if(map[name])st.draft[map[name]]=value;\n if(name===\"dSeries\"){\n  const old=EGEAcademic.seriesOf(st.draft);\n  if(!EGEAcademic.series.includes(value)||value===old)return;\n  const hasStudy=Number.isInteger(st.draft.theme)||cleaned(st.draft.problem)||Object.values(st.draft.annexes||{}).some(v=>cleaned(v));\n  if(hasStudy&&!await window.MBDialog.confirm(\"Changer la série de ce dossier effacera son sujet, sa problématique et ses annexes. Pour conserver ce travail, créez plutôt un nouveau dossier. Continuer ?\")){\n   const select=$(\"dSeries\");if(select)select.value=old;return;\n  }\n  Object.assign(st.draft,{series:value,className:\"\",theme:null,subtheme:null,problem:\"\",annexes:{},annexTitles:{},sources:{},sourceChecks:{},researchEvidence:{},annexBackup:{}});\n  render();\n }\n if(name===\"dTheme\"){st.draft.theme=value===\"\"?null:Number(value);st.draft.subtheme=null}\n if(name===\"dSubtheme\")st.draft.subtheme=value===\"\"?null:Number(value);\n const annex=/^annex_(title|body|source|checked)_(\\d+)$/.exec(name);\n if(annex){const type=annex[1],n=annex[2];\n  if(type===\"title\")st.draft.annexTitles[n]=value;\n  if(type===\"body\")st.draft.annexes[n]=value;\n  if(type===\"source\")st.draft.sources[n]=value;\n  if(type===\"checked\")st.draft.sourceChecks[n]=Boolean(value);\n }\n saveLocalDraft();markPending(navigator.onLine?\"Modifications en attente\":\"Hors connexion\");\n clearTimeout(st.saveTimer);st.saveTimer=setTimeout(()=>saveDoc().catch(fail),1300);\n}\nasync function saveDoc(opts={}){\n if(!st.user||st.role!==\"eleve\"||!st.draft)return false;\n if(st.saving)return false;\n if(!navigator.onLine){markPending(\"Hors connexion — brouillon conservé\");saveLocalDraft();return false;}\n const d=currentDoc();if(!d)return false;\n const cloned=JSON.parse(JSON.stringify(st.draft));\n st.saving=true;markPending(\"Enregistrement en cours…\");\n try{\n  const changes={payload:cloned,student:cleaned(cloned.student),title:cleaned(d.title)||\"Dossier EGE\",updated_at:new Date().toISOString()};\n  const {data,error}=await st.db.from(\"ege2027_dossiers\").update(changes).eq(\"id\",d.id).eq(\"owner_id\",st.user.id).eq(\"updated_at\",d.updated_at).select(\"id,owner_id,title,student,payload,updated_at,archived_at,suspended_at,deleted_at\").maybeSingle();\n  if(error)throw error;\n  if(!data){st.warning=\"Une autre version a été enregistrée sur un autre appareil. Votre brouillon local est conservé : ne l'écrasez pas.\";markPending(\"Conflit de sauvegarde\");saveLocalDraft();throw Error(st.warning)}\n  const idx=st.docs.findIndex(x=>x.id===d.id);st.docs[idx]=data;\n  if(JSON.stringify(st.draft)===JSON.stringify(cloned)){clearLocalDraft();st.warning=\"\";markPending(\"Enregistré en ligne\");}\n  else{markPending(\"Modifications en attente\");clearTimeout(st.saveTimer);st.saveTimer=setTimeout(()=>saveDoc().catch(fail),800);}\n  if(!opts.silent)toast(\"Enregistré en ligne.\");return true;\n }catch(e){saveLocalDraft();fail(e);return false;}\n finally{st.saving=false;}\n}\nasync function archiveDoc(id){\n if(!await window.MBDialog.confirm(\"Archiver ce dossier ? Il ne sera pas supprimé et restera récupérable dans les archives.\"))return;\n const {error}=await st.db.from(\"ege2027_dossiers\").update({archived_at:new Date().toISOString()}).eq(\"id\",id).eq(\"owner_id\",st.user.id);if(error)throw error;\n if(st.selectedDocId===id){st.selectedDocId=null;st.draft=null}await loadAll();toast(\"Dossier archivé.\");\n}\nasync function selectAndGoDoc(id,screen=\"student-wizard\"){\n if(st.draft&&st.selectedDocId!==id&&st.saveBadge!==\"Enregistré en ligne\"){\n  const ok=await saveDoc({silent:true});if(!ok)throw Error(\"Le brouillon précédent n'est pas synchronisé. Sauvegardez-le avant de changer de dossier.\");\n }\n selectDoc(id);go(screen);\n}\nasync function legacyEditor(){\n if(st.role!==\"eleve\"||!currentDoc()||!st.draft)throw Error(\"Ouvrez un dossier avant de l'exporter.\");\n if(st.saveBadge!==\"Enregistré en ligne\"){\n  const ok=await saveDoc({silent:true});if(!ok&&!window.EGEOffline?.enabled(st.user.id))throw Error(\"Le dossier n'est pas synchronisé. Sauvegardez ou résolvez le conflit avant l'export.\");\n  await window.EGEOffline?.flush();\n }\n const d=currentDoc();\n localStorage.setItem(\"ege-gfm-2027-v3\",JSON.stringify({...emptyPayload(),...st.draft}));\n localStorage.setItem(\"ege2027_dossier_selection_\"+st.user.id,JSON.stringify({id:d.id,title:d.title,updated_at:d.updated_at}));\n location.assign(new URL(\"./assistant-dossier-gfm-2027.html\",location.href).href);\n}\nasync function joinGroup(){\n const p_code=cleaned($(\"joinCode\")?.value).toUpperCase(),p_student_name=cleaned(st.draft?.student)||cleaned(st.user?.email?.split(\"@\")[0]);\n if(!p_code)throw Error(\"Saisissez le code transmis par votre enseignant.\");\n const {error}=await st.db.rpc(\"ege2027_join_group\",{p_code,p_student_name});\n if(error)throw error;\n await loadAll();toast(\"Classe rejointe. Associez votre dossier pour que le professeur puisse le consulter.\");\n}\nasync function associateDoc(){\n const gid=$(\"shareGroup\")?.value,did=$(\"shareDoc\")?.value;\n if(!gid||!did)throw Error(\"Choisissez votre groupe et un dossier.\");\n if(!st.docs.some(d=>d.id===did)||!st.members.some(m=>m.group_id===gid))throw Error(\"L'accès à ce groupe ou dossier n'est pas autorisé.\");\n if(!await window.MBDialog.confirm(\"Autoriser l'enseignant de cette classe à consulter ce dossier et toutes ses futures sauvegardes ? Vos autres dossiers resteront privés.\"))return;\n const {error}=await st.db.from(\"ege2027_group_submissions\").insert({group_id:gid,dossier_id:did,student_id:st.user.id});\n if(error&&error.code!==\"23505\")throw error;\n await loadAll();void window.MBDialog.notice('Dossier associé','Votre dossier EGE est désormais associé à votre enseignant.','success');\n}\nasync function leaveGroup(groupId){\n if(!await window.MBDialog.confirm(\"Quitter ce groupe ? L'enseignant perdra l'accès aux dossiers associés à ce groupe. Vos dossiers restent enregistrés.\"))return;\n const {error}=await st.db.from(\"ege2027_group_members\").delete().eq(\"group_id\",groupId).eq(\"student_id\",st.user.id);\n if(error)throw error;await loadAll();toast(\"Vous avez quitté le groupe.\");\n}\nasync function createGroup(){\n if(st.role!==\"enseignant\"||st.teacher?.status!==\"approved\")throw Error(\"Votre compte enseignant doit être approuvé.\");\n const name=cleaned($(\"groupName\")?.value),school=cleaned($(\"groupSchool\")?.value);\n if(name.length<2)throw Error(\"Indiquez le nom de la classe.\");\n const subject=cleaned($(\"groupSubject\")?.value);\n if(!subject)throw Error(\"Choisissez la matière de cette classe.\");\n const {error}=await st.db.from(\"ege2027_teacher_groups\").insert({teacher_id:st.user.id,name,school,subject});\n if(error)throw error;st.teacherOpen=false;await loadAll();toast(\"Groupe créé.\");\n}\nasync function teacherDecision(docId,decision){\n const doc=entityDoc(docId);if(!doc)throw Error(\"Le dossier n'est pas accessible.\");\n const observation=cleaned($(\"teacherComment\")?.value),annex=$(\"reviewAnnex\")?.value;\n if(decision===\"a_corriger\"&&!observation)throw Error(\"Indiquez l'observation à transmettre.\");\n const payload={dossier_id:docId,staff_id:st.user.id,decision,observation,annex_number:annex?Number(annex):null};\n const {error}=await st.db.from(\"ege2027_reviews\").insert(payload);if(error)throw error;\n await loadAll();toast(decision===\"valide\"?\"Travail validé.\":\"Correction transmise à l'élève.\");\n}\nasync function removeStudent(groupId,studentId){\n if(!await window.MBDialog.confirm(\"Retirer cet élève de la classe ? Ses dossiers personnels seront conservés et l'accès enseignant sera révoqué.\"))return;\n const {error}=await st.db.from(\"ege2027_group_members\").delete().eq(\"group_id\",groupId).eq(\"student_id\",studentId);\n if(error)throw error;await loadAll();toast(\"Élève retiré du groupe.\");\n}\nasync function changeGroup(groupId,action){\n const g=st.groups.find(x=>x.id===groupId);if(!g)throw Error(\"Groupe introuvable.\");\n if(st.role!==\"admin\"&&(g.suspended_at||g.deleted_at))throw Error(\"Ce groupe a été suspendu ou supprimé par l’administration.\");\n let changes;\n if(action===\"rename\"){const name=await window.MBDialog.prompt(\"Nom du groupe\",g.name);if(name===null)return;const v=cleaned(name);if(v.length<2)throw Error(\"Nom trop court.\");changes={name:v}}\n else {if(!await window.MBDialog.confirm(g.active?\"Suspendre les nouvelles inscriptions dans ce groupe ?\":\"Réactiver les inscriptions ?\"))return;changes={active:!g.active}}\n const {error}=await st.db.from(\"ege2027_teacher_groups\").update(changes).eq(\"id\",g.id);if(error)throw error;\n await loadAll();toast(\"Groupe mis à jour.\");\n}\nasync function approveTeacher(userId,status){\n if(st.role!==\"admin\")throw Error(\"Droits administrateur nécessaires.\");\n const r=st.requests.find(x=>x.user_id===userId);if(!r)throw Error(\"Demande introuvable.\");\n if(!await window.MBDialog.confirm((status===\"approved\"?\"Approuver\":status===\"suspended\"?\"Suspendre\":\"Refuser\")+\" l'enseignant \"+r.full_name+\" ?\"))return;\n let rejection_reason=\"\";\n if(status!==\"approved\"){const reason=await window.MBDialog.prompt(\"Motif à communiquer à l'enseignant\",r.rejection_reason||\"\");if(reason===null)return;if(!cleaned(reason))throw Error(\"Indiquez un motif.\");rejection_reason=cleaned(reason)}\n const {error}=await st.db.from(\"ege2027_teacher_requests\").update({status,rejection_reason,reviewed_at:new Date().toISOString(),reviewed_by:st.user.id}).eq(\"user_id\",userId);\n if(error)throw error;await loadAll();toast(\"Décision enregistrée.\");\n}\nasync function adminGroupCreate(){\n const teacher_id=$(\"adminTeacher\")?.value,name=cleaned($(\"adminGroupName\")?.value),school=cleaned($(\"adminGroupSchool\")?.value);\n if(!st.requests.some(r=>r.user_id===teacher_id&&r.status===\"approved\")||name.length<2)throw Error(\"Choisissez un enseignant approuvé et un nom de classe.\");\n const {error}=await st.db.from(\"ege2027_teacher_groups\").insert({teacher_id,name,school});if(error)throw error;\n st.adminOpen=false;await loadAll();toast(\"Groupe créé.\");\n}\nasync function saveSettings(){\n if(st.role!==\"admin\")throw Error(\"Accès administrateur requis.\");\n const academic_year=cleaned($(\"settingsYear\")?.value),student_message=cleaned($(\"settingsMessage\")?.value);\n if(!academic_year)throw Error(\"Indiquez l'année scolaire.\");\n const {error}=await st.db.from(\"ege2027_settings\").update({academic_year,student_message,updated_at:new Date().toISOString(),updated_by:st.user.id}).eq(\"id\",1);\n if(error)throw error;await loadAll();toast(\"Paramètres enregistrés.\");\n}\nfunction choiceRole(role){\n st.desired=role;\n if(st.user){\n  if(st.role!==role){toast(\"Ce compte est lié à un autre espace. Utilisez un compte autorisé pour ce rôle.\");st.screen=\"auth\";}\n  else st.screen=homes[role];\n }else {st.screen=\"auth\";st.mode=\"login\";}\n render();\n}\n// Installation PWA : le prompt natif ne peut être déclenché que par un clic réel.\nlet egeInstallPrompt=null;\nlet egeInstallInProgress=false;\nlet egeAppInstalled=false;\nconst egeIsInstalled=()=>egeAppInstalled||window.matchMedia?.(\"(display-mode: standalone)\")?.matches===true||navigator.standalone===true;\nconst egeIsIOS=()=>/iPad|iPhone|iPod/.test(navigator.userAgent)||navigator.platform===\"MacIntel\"&&navigator.maxTouchPoints>1;\nfunction refreshInstallButtons(){\n const installed=egeIsInstalled();\n for(const el of document.querySelectorAll('[data-act=\"install\"],[data-ege-header=\"install\"]')){\n  el.hidden=installed;\n  el.disabled=egeInstallInProgress;\n }\n}\nfunction explainInstall(){\n const content=document.getElementById(\"egeInstallInstructions\");\n const dialog=document.getElementById(\"egeInstallDialog\");\n if(!content||!dialog){toast(\"Ouvrez cette page dans Safari ou Chrome, puis utilisez le menu du navigateur pour l’ajouter à l’écran d’accueil.\");return}\n if(egeIsIOS()){\n  content.textContent=\"Sur iPhone ou iPad : ouvrez cette adresse dans Safari, appuyez sur Partager, choisissez « Sur l’écran d’accueil », puis « Ajouter ».\";\n }else if(/Android/i.test(navigator.userAgent)){\n  content.textContent=\"Sur Android : ouvrez EGE 2027 dans Chrome, appuyez sur le menu ⋮, puis choisissez « Installer l’application » ou « Ajouter à l’écran d’accueil ». Si vous utilisez un navigateur intégré à une autre application, ouvrez d’abord le lien dans Chrome.\";\n }else{\n  content.textContent=\"Ouvrez EGE 2027 dans un navigateur compatible. Utilisez l’option « Installer l’application » dans la barre d’adresse ou dans le menu du navigateur.\";\n }\n if(typeof dialog.showModal===\"function\")dialog.showModal();\n else dialog.setAttribute(\"open\",\"\");\n}\nasync function installEGE(){\n if(egeIsInstalled()){toast(\"EGE 2027 est déjà installée sur cet appareil.\");refreshInstallButtons();return}\n if(egeInstallInProgress)return;\n if(!egeInstallPrompt){explainInstall();return}\n const prompt=egeInstallPrompt;egeInstallPrompt=null;\n egeInstallInProgress=true;\n refreshInstallButtons();\n try{\n  await prompt.prompt();\n  const result=await prompt.userChoice;\n  if(result?.outcome===\"accepted\")toast(\"Installation acceptée. Suivez les indications de votre appareil.\");\n  else toast(\"Installation annulée. Vous pouvez réessayer depuis le navigateur.\");\n }catch(err){egeInstallPrompt=null;explainInstall()}\n finally{egeInstallInProgress=false;refreshInstallButtons()}\n}\nwindow.addEventListener(\"beforeinstallprompt\",event=>{\n event.preventDefault();\n egeInstallPrompt=event;\n refreshInstallButtons();\n});\nwindow.addEventListener(\"appinstalled\",()=>{\n egeAppInstalled=true;egeInstallPrompt=null;\n toast(\"EGE 2027 est installée.\");\n refreshInstallButtons();\n});\n\nasync function dispatchClick(e){\n const el=e.target.closest(\"[data-act]\");if(!el)return;\n e.preventDefault();const a=el.dataset.act,id=el.dataset.id,mode=el.dataset.mode;\n if(st.terrainUploading){toast('Patientez pendant l’importation de l’image.');return}\n try{\n  if(a.startsWith('terrain-')){await terrainAction(a,el);return}\n  if(a===\"toggle-password\"){\n   const input=$(el.dataset.target);\n   if(!input||![\"authPassword\",\"newPassword\"].includes(input.id))return;\n   const visible=input.type===\"password\";\n   input.type=visible?\"text\":\"password\";\n   el.setAttribute(\"aria-label\",visible?\"Masquer le mot de passe\":\"Afficher le mot de passe\");\n   el.setAttribute(\"title\",visible?\"Masquer le mot de passe\":\"Afficher le mot de passe\");\n   el.setAttribute(\"aria-pressed\",visible?\"true\":\"false\");\n   el.innerHTML=I(visible?\"eye-off\":\"eye\");\n   input.focus({preventScroll:true});\n   return;\n  }\n  if(a===\"install\"){await installEGE();return}\n  if(a===\"close-install\"){\n   const dialog=document.getElementById(\"egeInstallDialog\");\n   if(dialog?.close)dialog.close();else dialog?.removeAttribute(\"open\");\n   return;\n  }\n  if(a===\"ad-next\"||a===\"ad-prev\"||a===\"ad-slide\"){\n   const place=el.dataset.slot;\n   if(!EGE_AD_SLOTS.some(item=>item.id===place))return;\n   const step=a===\"ad-prev\"?-1:1;\n   const ix=a===\"ad-slide\"?Number(el.dataset.slide):null;\n   if(ix!==null&&!Number.isInteger(ix))return;\n   egeMoveCarousel(place,step,ix,true,e.detail===0);\n   return;\n  }\n  if(a===\"refresh-ads\"){await loadAds();render();return}\n  if(a===\"ad-info\"){egeShowAdInfo(id);return}\n  if(a===\"ad-close\"){const dialog=document.getElementById(\"egeAdDialog\");if(dialog?.close)dialog.close();else dialog?.removeAttribute(\"open\");return}\n  if([\"ad-approve\",\"ad-save-positions\",\"ad-pause\",\"ad-reject\"].includes(a)){\n   await egeAdminUpdateAd(id,a===\"ad-approve\"?\"approve\":a===\"ad-pause\"?\"pause\":a===\"ad-reject\"?\"reject\":\"save\");\n   return;\n  }\n  if(a===\"goto\"){go(el.dataset.to);return}\n  if(a===\"role\"){choiceRole(el.dataset.role);return}\n  if(a===\"mode\"){st.mode=mode;if(st.screen===\"profile\"){st.screen=\"auth\";st.desired=st.role}render();return}\n  if(a===\"refresh\"){await loadAll();toast(\"Données actualisées.\");return}\n  if(a===\"logout\"){if(await window.MBDialog.confirm('Voulez-vous vous déconnecter de monAvenir ?'))await signOut();return}\n  if(a===\"newdoc\"){\n   if(st.draft&&st.saveBadge!==\"Enregistré en ligne\"){\n    const done=await saveDoc({silent:true});if(!done)throw Error(\"Votre brouillon actuel n'est pas synchronisé. Sauvegardez-le avant de créer un autre dossier.\");\n   }\n   await createDoc();return\n  }\n  if(a===\"opendoc\"){await selectAndGoDoc(id,el.dataset.to||\"student-wizard\");return}\n  if(a===\"annex\"){st.annex=Number(el.dataset.n)||1;if(st.screen!==\"student-annex\")st.screen=\"student-annex\";render();return}\n  if(a===\"legacy\"){await legacyEditor();return}\n  if(a===\"archive\"){await archiveDoc(id);return}\n  if(a===\"wizard\"){st.wizardStep=Number(el.dataset.n)||1;render();return}\n  if(a===\"wizard-next\"){EGEStage.mark([\"\",\"identity\",\"subject\",\"problem\"][st.wizardStep],st.draft);st.wizardStep=Math.min(4,st.wizardStep+1);await saveDoc({silent:true});render();return}\n  if(a===\"wizard-prev\"){st.wizardStep=Math.max(1,st.wizardStep-1);render();return}\n  if(a===\"save\"){await saveDoc();render();return}\n  if(a===\"restore-draft\"){if(!st.localCandidate)return;st.draft=st.localCandidate;st.localCandidate=null;st.warning=\"Brouillon local récupéré, à synchroniser.\";markPending(\"À synchroniser\");saveLocalDraft();render();return}\n  if(a===\"join\"){await joinGroup();return}\n  if(a===\"associate\"){await associateDoc();return}\n  if(a===\"leave\"){await leaveGroup(id);return}\n  if(a===\"teacher-create\"){st.teacherOpen=!st.teacherOpen;if(st.screen!==\"teacher-groups\"){st.screen=\"teacher-groups\"}render();return}\n  if(a===\"teacher-select\"){st.selectedGroupId=id;go(\"teacher-students\");return}\n  if(a===\"teacher-review\"){st.selectedDocId=id;st.reviewAnnex=1;go(\"teacher-review\");return}\n  if(a===\"teacher-annex\"){st.reviewAnnex=Number(el.dataset.n)||1;render();return}\n  if(a===\"remove-student\"){await removeStudent(el.dataset.group,id);return}\n  if(a===\"group-rename\"||a===\"group-toggle\"){await changeGroup(id,a===\"group-rename\"?\"rename\":\"toggle\");return}\n  if(a===\"copy\"){const code=el.dataset.code;if(!code)return;if(navigator.clipboard?.writeText)await navigator.clipboard.writeText(code);toast(\"Code copié : \"+code);return}\n  if(a===\"request-status\"){await approveTeacher(id,el.dataset.status);return}\n  if(a===\"review\"){await teacherDecision(id,el.dataset.decision);return}\n  if(a===\"admin-create\"){st.adminOpen=!st.adminOpen;render();return}\n  if(a===\"admin-group\"){st.selectedGroupId=id;go(\"admin-groups\");return}\n  if(a===\"admin-tab\"){st.adminTab=mode;render();return}\n  if(a===\"admin-read\"){st.selectedDocId=id;st.adminTab=\"preview\";go(\"admin-monitor\");return}\n  if(a===\"save-settings\"){await saveSettings();return}\n  if(a===\"reset-password\"){await recoverPassword();return}\n  if(a===\"profile-changepass\"){st.pendingPasswordReset=true;go(\"auth\");return}\n  if(a===\"preview\"){document.querySelector(\"#paper\")?.scrollIntoView({block:\"start\",behavior:\"smooth\"});return}\n  if(a===\"signup-info\"){toast(\"Utilisez le formulaire d'inscription pour créer votre compte.\");return}\n }catch(error){fail(error);render()}\n}\nasync function dispatchSubmit(e){\n if(![\"authForm\",\"studentProfileForm\",\"pricingAdminForm\",\"groupJoinForm\",\"groupShareForm\",\"teacherNewGroupForm\",\"adminNewGroupForm\",\"egeAdTeacherForm\",\"egeAdAdminForm\"].includes(e.target.id))return;\n e.preventDefault();\n if(st.busy)return;st.busy=true;\n const adForm=[\"egeAdTeacherForm\",\"egeAdAdminForm\"].includes(e.target.id)?e.target:null;\n const retainedForm=adForm||([\"authForm\",\"studentProfileForm\",\"pricingAdminForm\"].includes(e.target.id)?e.target:null);\n let succeeded=false;\n const submitButton=retainedForm?.querySelector('[type=\"submit\"]');\n const buttonLabel=submitButton?.textContent;\n retainedForm?.querySelector('[data-ad-error]')?.remove();\n if(submitButton){submitButton.disabled=true;submitButton.textContent=\"Envoi en cours…\"}\n try{\n  if(e.target.id===\"authForm\"){await doLogin(st.mode)}\n  else if(e.target.id===\"studentProfileForm\")await saveStudentProfile();\n  else if(e.target.id===\"pricingAdminForm\")await savePricing();\n  else if(e.target.id===\"groupJoinForm\")await joinGroup();\n  else if(e.target.id===\"groupShareForm\")await associateDoc();\n  else if(e.target.id===\"teacherNewGroupForm\")await createGroup();\n  else if(e.target.id===\"adminNewGroupForm\")await adminGroupCreate();\n  else if(e.target.id===\"egeAdTeacherForm\")await egeSubmitTeacherAd();\n  else if(e.target.id===\"egeAdAdminForm\")await egeAdminCreateAd();\n  succeeded=true;\n }catch(error){\n  fail(error);\n  if(retainedForm){\n   const message=document.createElement(\"p\");message.dataset.adError=\"\";\n   message.setAttribute(\"role\",\"alert\");message.textContent=error.message||\"L’envoi a échoué. Vos informations sont conservées. Réessayez.\";\n   retainedForm.append(message);\n  }\n }\n finally{\n  st.busy=false;\n  if(submitButton){submitButton.disabled=false;submitButton.textContent=buttonLabel}\n  if(!adForm&&(succeeded||!retainedForm))render();\n }\n}\nfunction dispatchInput(e){\n const el=e.target,field=el.dataset.field;\n if(field){void setDraftField(field,el.type===\"checkbox\"?el.checked:el.value).catch(fail);\n  if(field.startsWith(\"annex_\")){\n   const key=field.split(\"_\")[1],v=el.value,previewEl=key===\"title\"?$(\"paperTitle\"):key===\"body\"?$(\"paperBody\"):key===\"source\"?$(\"paperSource\"):null;\n   if(previewEl)previewEl.textContent=v||\"À renseigner\";\n   const wc=$(\"wordCount\");if(wc&&key===\"body\")wc.textContent=(cleaned(v).match(/\\S+/g)||[]).length+\" mots\";\n  }\n }\n if(el.id===\"docSearch\"){st.filter=el.value;const list=$(\"docsList\");if(list)list.innerHTML=docRows()}\n if(el.id===\"groupSelect\"){st.selectedGroupId=el.value;render();}\n if(el.id===\"adminTeacherFilter\"){st.selectedGroupId=el.value;render();}\n}\ndocument.addEventListener(\"click\",dispatchClick);\ndocument.addEventListener(\"submit\",dispatchSubmit);\ndocument.addEventListener(\"input\",dispatchInput);\ndocument.addEventListener(\"change\",e=>{\n const el=e.target;\n if(el.id===\"authSeries\"||el.id===\"profileSeries\"){\n  const select=$(el.id===\"authSeries\"?\"authClass\":\"profileClass\");\n  if(select){select.innerHTML=EGEAcademic.options(EGEAcademic.classes[el.value]||[],\"\",\"Choisir une classe\");select.disabled=!EGEAcademic.series.includes(el.value)}\n }\n if(el.id===\"annexTab\"){st.annex=Number(el.value);render()}\n if(el.id===\"groupSelect\"){st.selectedGroupId=el.value;render()}\n if(el.id===\"dTheme\"){render()}\n if(el.dataset.field===\"dMode\"){render()}\n});\nasync function saveStudentProfile(){\n if(!st.user||st.role!==\"eleve\")throw Error(\"Connectez-vous à votre espace élève.\");\n const series=cleaned($(\"profileSeries\")?.value),class_name=cleaned($(\"profileClass\")?.value),school=cleaned($(\"profileSchool\")?.value);\n if(!EGEAcademic.series.includes(series)||!EGEAcademic.classes[series].includes(class_name))throw Error(\"Choisissez votre série et une classe de cette série.\");\n if(!EGEAcademic.schools.includes(school))throw Error(\"Choisissez votre établissement.\");\n const {data,error}=await st.db.auth.updateUser({data:{series,class_name,school}});\n if(error)throw error;\n st.user=data.user;toast(\"Profil enregistré. Ces informations seront reprises dans vos nouveaux dossiers.\");\n}\nwindow.addEventListener(\"online\",()=>{if(window.EGEStudyUI&&window.EGEOffline?.enabled(st.user?.id)){EGEStudyUI.reconnect();return}if(st.role===\"eleve\"&&st.draft&&st.saveBadge!==\"Enregistré en ligne\")saveDoc({silent:true}).then(()=>render())});\ndocument.addEventListener(\"DOMContentLoaded\",()=>initApp());\n\n// Tarifs futurs. Cette version ne contient aucun encaissement ni contrôle d'accès payant.\nconst EGE_PRICING_COLUMNS='student_monthly_fdj,premium_weekly_fdj,premium_monthly_fdj,standard_ad_fdj,payment_methods,payment_instructions,monetization_enabled';\nconst EGE_PRICING_DEFAULTS=Object.freeze({student_monthly_fdj:300,premium_weekly_fdj:1000,premium_monthly_fdj:3000,standard_ad_fdj:500,payment_methods:[],payment_instructions:'',monetization_enabled:false});\nasync function loadPricing(){\n if(!st.db)return;\n try{\n  const {data,error}=await st.db.from('ege2027_settings').select(EGE_PRICING_COLUMNS).eq('id',1).single();\n  if(error)throw error;\n  st.pricing={...EGE_PRICING_DEFAULTS,...data,monetization_enabled:false};st.pricingError='';\n }catch(error){st.pricing={...EGE_PRICING_DEFAULTS};st.pricingError='Les tarifs enregistrés sont momentanément indisponibles.';}\n}\nfunction egePricing(){return st.pricing||EGE_PRICING_DEFAULTS}\nfunction egeFDJ(amount){return new Intl.NumberFormat('fr-FR').format(amount)+' FDJ'}\nasync function savePricing(){\n if(st.role!=='admin'||!st.user||!st.db)throw Error('Accès administrateur nécessaire.');\n if(st.pricingError)throw Error('Actualisez les tarifs enregistrés avant de les modifier.');\n const changes={updated_by:st.user.id,updated_at:new Date().toISOString()};\n for(const field of ['student_monthly_fdj','premium_weekly_fdj','premium_monthly_fdj','standard_ad_fdj']){\n  const raw=cleaned($('fee_'+field)?.value);\n  const value=Number(raw);\n  if(raw===''||!Number.isInteger(value)||value<0||value>100000000)throw Error('Saisissez des montants entiers entre 0 et 100 000 000 FDJ.');\n  changes[field]=value;\n }\n const methods=[...new Set(cleaned($('fee_payment_methods')?.value).split(/\\r?\\n/).map(cleaned).filter(Boolean))];\n if(methods.length>5||methods.some(value=>value.length>80))throw Error('Indiquez au maximum cinq moyens de paiement, un par ligne (80 caractères chacun).');\n const instructions=cleaned($('fee_payment_instructions')?.value);\n if(instructions.length>1200)throw Error('Les consignes doivent contenir au maximum 1 200 caractères.');\n changes.payment_methods=methods;changes.payment_instructions=instructions;\n // Aucun champ d'activation n'est transmis. La gratuité est également imposée en base.\n const {data,error}=await st.db.from('ege2027_settings').update(changes).eq('id',1).select(EGE_PRICING_COLUMNS).single();\n if(error)throw error;\n st.pricing={...data,monetization_enabled:false};st.pricingError='';\n toast('Tarifs futurs enregistrés. L’application reste gratuite.');render();\n}\n\nconst egeTerrainTabs=[['enterprise','Entreprise'],['professional','Professionnel'],['interview','Guide d’entretien'],['comparison','Tableau comparatif'],['synthesis','Synthèse']];\nlet egeTerrainTab='enterprise';\nconst egeTerrainImages=new Map();\nfunction terrainTopic(payload){const series=EGEAcademic.seriesOf(payload),catalog=EGEAcademic.catalogFor(payload,official);return catalog[payload.theme]?.subthemes?.[payload.subtheme]||''}\nfunction terrainField(key,t,{type='text',textarea=false,help=''}={}){\n const [label,max]=EGETerrain.fields[key];\n return `<label class=\"field\"><span>${esc(label)}</span>${textarea?`<textarea class=\"textarea\" data-terrain-field=\"${key}\" maxlength=\"${max}\" rows=\"${key==='synthesis'?18:4}\">${esc(t[key])}</textarea>`:`<input class=\"input\" type=\"${type}\" data-terrain-field=\"${key}\" maxlength=\"${max}\" value=\"${esc(t[key])}\">`}${help?`<small class=\"muted\">${esc(help)}</small>`:''}</label>`;\n}\nfunction terrainImagePicker(kind,label,t){\n return `<div class=\"card\" style=\"padding:16px\"><h3>${label}</h3>${t[kind]?`<img data-terrain-imagepath=\"${esc(t[kind].path)}\" alt=\"${label} fourni par l’élève\" style=\"display:block;max-width:100%;max-height:330px;object-fit:contain;margin:12px auto\"><button type=\"button\" class=\"btn smol\" data-act=\"terrain-remove-image\" data-kind=\"${kind}\">Retirer cette image du dossier</button>`:''}<label class=\"field\"><span>${t[kind]?'Remplacer':'Importer'} l’image</span><input type=\"file\" data-terrain-file=\"${kind}\" accept=\"image/jpeg,image/png,image/webp\" ${st.terrainUploading?'disabled':''}><small class=\"muted\">JPG, PNG ou WebP. Image stockée dans l’espace privé du dossier.</small></label></div>`;\n}\nfunction terrainPage(){\n if(!st.draft)return `${title('Partie terrain','Ouvrir un dossier','Choisissez le dossier auquel rattacher votre entreprise et votre entretien.')}${box(btn('Mes dossiers','goto','btn primary','folder','data-to=\"student-docs\"'))}`;\n const p=st.draft,t=EGETerrain.normalize(p.terrain,p),progress=EGETerrain.progress(p),count=p.mode==='binome'?4:3;\n let content='';\n if(egeTerrainTab==='enterprise')content=`<h2>Présentation de l’entreprise</h2><p class=\"small muted\">Historique, fiche d’identité, vision et stratégie, logo et organigramme, selon la structure du modèle Nassima.</p>${['organizationName','legalForm','creationDate','address','employees','turnover','activities','scope','history','visionStrategy','organizationSource'].map(key=>terrainField(key,t,{textarea:['activities','history','visionStrategy','organizationSource'].includes(key)})).join('')}${terrainImagePicker('logo','Logo de l’entreprise',t)}${terrainImagePicker('organizationChart','Organigramme',t)}${terrainField('organizationChartText',t,{textarea:true,help:'Décrivez la direction, les services et les liens hiérarchiques, notamment si vous n’avez pas d’image.'})}`;\n if(egeTerrainTab==='professional')content=`<h2>Le professionnel interrogé</h2>${terrainField('professionalName',t)}${terrainField('professionalRole',t)}<label class=\"field\"><span>Statut de l’entretien</span><select class=\"select\" data-terrain-field=\"interviewStatus\"><option value=\"planned\" ${t.interviewStatus!=='done'?'selected':''}>À préparer</option><option value=\"done\" ${t.interviewStatus==='done'?'selected':''}>Réalisé</option></select></label>${terrainField('interviewDate',t,{type:'date',help:'Indiquez la date réelle une fois l’entretien effectué.'})}${terrainField('interviewMethod',t,{help:'Ex. : face à face, téléphone ou visioconférence.'})}${terrainField('interviewDifficulties',t,{textarea:true})}`;\n if(egeTerrainTab==='interview')content=`<h2>Guide d’entretien</h2><p class=\"small muted\">Saisissez vos propres questions et les réponses réellement données par le professionnel. Le rattachement à une annexe permet de préparer un tableau comparatif pertinent.</p>${t.questions.map((q,i)=>`<fieldset style=\"border:1px solid #dbe2ea;border-radius:14px;padding:16px;margin:10px 0\"><legend>Question ${i+1}</legend><label class=\"field\"><span>Question de l’élève</span><textarea class=\"textarea\" rows=\"2\" data-terrain-question=\"${i}\" data-part=\"question\" maxlength=\"1200\">${esc(q.question)}</textarea></label><label class=\"field\"><span>Réponse du professionnel</span><textarea class=\"textarea\" rows=\"4\" data-terrain-question=\"${i}\" data-part=\"answer\" maxlength=\"6000\">${esc(q.answer)}</textarea></label><label class=\"field\"><span>Annexe concernée</span><select class=\"select\" data-terrain-question=\"${i}\" data-part=\"annex\"><option value=\"0\">${q.question.trim().replace(/’/g,\"'\")===\"Quelle est l'activité principale de votre entreprise ?\"?'Présentation de l’entreprise':'Proposer un rapprochement, à vérifier'}</option>${Array.from({length:count},(_,n)=>`<option value=\"${n+1}\" ${q.annex===n+1?'selected':''}>Annexe ${n+1} — ${esc(getTitle(n+1,p))}</option>`).join('')}</select></label><button class=\"btn smol\" type=\"button\" data-act=\"terrain-remove-question\" data-index=\"${i}\">Retirer cette question</button></fieldset>`).join('')}<button type=\"button\" class=\"btn\" data-act=\"terrain-add-question\" ${t.questions.length>=20?'disabled':''}>Ajouter une question</button>`;\n if(egeTerrainTab==='comparison'){\n  const stale=!!(t.comparisonSignature&&t.comparisonSignature!==EGETerrain.comparisonSignature(p));\n  content=`<h2>Tableau comparatif</h2><p class=\"small muted\">L’application rapproche les extraits de vos annexes et les réponses de l’entretien. Vérifiez chaque rapprochement et corrigez les textes. Les similitudes et différences doivent décrire ce que vos informations permettent réellement de constater.</p>${stale?'<p class=\"ege-feedback\" role=\"status\">Les sources ont changé depuis la préparation du tableau. Actualisez-le ou relisez et corrigez ses lignes.</p>':''}<button type=\"button\" class=\"btn primary\" data-act=\"terrain-generate-comparison\">${t.comparisons.length?'Actualiser':'Préparer'} le tableau</button>${t.comparisons.map((r,i)=>`<section style=\"border:1px solid #dbe2ea;border-radius:14px;padding:16px;margin:15px 0\"><h3>Annexe ${i+1} — ${esc(getTitle(i+1,p))}</h3><label class=\"field\"><span>Recherches documentaires</span><textarea class=\"textarea\" data-terrain-comparison=\"${i}\" data-part=\"theory\" maxlength=\"6000\" rows=\"5\">${esc(r.theory)}</textarea></label><label class=\"field\"><span>Contextualisation sur le terrain</span><textarea class=\"textarea\" data-terrain-comparison=\"${i}\" data-part=\"practice\" maxlength=\"12000\" rows=\"5\" placeholder=\"Rattachez une réponse du professionnel à cette annexe.\">${esc(r.practice)}</textarea></label></section>`).join('')}${terrainField('similarities',t,{textarea:true})}${terrainField('differences',t,{textarea:true})}<label style=\"display:flex;gap:10px;align-items:flex-start\"><input type=\"checkbox\" data-terrain-review=\"comparisonReviewed\" ${t.comparisonReviewed&&!stale?'checked':''}> J’ai relu les deux colonnes et vérifié que les réponses correspondent aux annexes.</label>`;\n }\n if(egeTerrainTab==='synthesis'){\n  const stale=!!(t.synthesisSignature&&t.synthesisSignature!==EGETerrain.synthesisSignature(p));\n  content=`<h2>Synthèse rédigée</h2><p class=\"small muted\">Introduction, recherche documentaire, contextualisation sur le terrain et conclusion, selon le modèle Nassima. La proposition reprend vos informations et vos réponses ; complétez la réponse personnelle à la problématique et vérifiez les conclusions.</p>${stale?'<p class=\"ege-feedback\" role=\"status\">Des informations ont changé depuis la dernière synthèse. Relisez et actualisez ce texte.</p>':''}<button class=\"btn primary\" type=\"button\" data-act=\"terrain-generate-synthesis\">Préparer une proposition de synthèse</button>${terrainField('synthesis',t,{textarea:true})}<label style=\"display:flex;gap:10px;align-items:flex-start\"><input type=\"checkbox\" data-terrain-review=\"synthesisReviewed\" ${t.synthesisReviewed&&!stale?'checked':''}> J’ai relu, corrigé et complété la synthèse et sa conclusion.</label><p class=\"small muted\">La relecture de l’élève ne remplace pas la validation du professeur.</p>`;\n }\n const issues=EGETerrain.interviewIssues(t);\n return `${title('Contextualisation de la théorie','Ma partie terrain','Entreprise → professionnel → entretien → comparaison → synthèse.',btn('Enregistrer','save','btn primary','check'))}${st.warning?`<div class=\"ege-feedback\" role=\"status\">${esc(st.warning)}</div>`:''}<div class=\"notice info\"><span>Avancement : ${progress.done} / ${progress.total} rubriques préparées et relues. <strong id=\"saveState\">${esc(st.saveBadge)}</strong></span></div><div class=\"tabset\" style=\"flex-wrap:wrap\">${egeTerrainTabs.map(([key,label])=>`<button type=\"button\" class=\"tab ${egeTerrainTab===key?'active':''}\" data-act=\"terrain-tab\" data-tab=\"${key}\">${label}</button>`).join('')}</div>${issues.length?`<p class=\"ege-feedback\" role=\"status\">${issues.map(esc).join(' ')}</p>`:''}${st.terrainUploading?'<p role=\"status\">Importation de l’image en cours…</p>':''}<section class=\"card ege-forms\" style=\"max-width:960px\">${content}</section><div class=\"inline-actions\" style=\"margin-top:18px\">${btn('Ouvrir le Word complet','legacy','btn primary','download')}${btn('Mes annexes','goto','btn','file','data-to=\"student-annex\"')}</div>`;\n}\nfunction touchTerrain(){\n saveLocalDraft();markPending(navigator.onLine?'Modifications en attente':'Hors connexion — brouillon conservé');\n clearTimeout(st.saveTimer);st.saveTimer=setTimeout(()=>saveDoc({silent:true}).catch(fail),1300);\n}\nfunction terrainInput(event){\n const el=event.target;if(!el?.dataset||st.role!=='eleve'||!st.draft)return;\n const d=el.dataset;if(!('terrainField' in d||'terrainQuestion' in d||'terrainComparison' in d||'terrainReview' in d))return;\n const t=EGETerrain.normalize(st.draft.terrain,st.draft);\n if(d.terrainField){\n  const key=d.terrainField;\n  if(key==='interviewStatus')t[key]=el.value==='done'?'done':'planned';\n  else if(EGETerrain.fields[key])t[key]=el.value.slice(0,EGETerrain.fields[key][1]);else return;\n  if(key==='organizationName')st.draft.company=t.organizationName;\n  t.synthesisReviewed=false;\n }\n if('terrainQuestion' in d){const q=t.questions[Number(d.terrainQuestion)];if(!q||!['question','answer','annex'].includes(d.part))return;q[d.part]=d.part==='annex'?Number(el.value):el.value.slice(0,d.part==='question'?1200:6000);t.comparisonReviewed=false;t.synthesisReviewed=false;}\n if('terrainComparison' in d){const row=t.comparisons[Number(d.terrainComparison)];if(!row||!['theory','practice'].includes(d.part))return;row[d.part]=el.value.slice(0,d.part==='theory'?6000:12000);t.comparisonReviewed=false;t.synthesisReviewed=false;}\n if('terrainReview' in d){\n  if(d.terrainReview==='comparisonReviewed'){if(!t.comparisons.length){el.checked=false;toast('Préparez d’abord le tableau.');return}t.comparisonReviewed=el.checked;t.comparisonSignature=EGETerrain.comparisonSignature({...st.draft,terrain:t});t.synthesisReviewed=false;}\n  else if(d.terrainReview==='synthesisReviewed'){if(!t.synthesis.trim()){el.checked=false;toast('Préparez d’abord la synthèse.');return}t.synthesisReviewed=el.checked;t.synthesisSignature=EGETerrain.synthesisSignature({...st.draft,terrain:t});}\n }\n st.draft.terrain=t;\n if(d.terrainField==='synthesis')t.synthesisSignature=EGETerrain.synthesisSignature(st.draft);\n touchTerrain();\n}\nasync function terrainAction(action,el){\n if(st.role!=='eleve'||!st.draft)throw Error('Ouvrez votre dossier dans l’espace élève.');\n if(st.terrainUploading)throw Error('Patientez pendant l’importation de l’image.');\n if(action==='terrain-tab'){egeTerrainTab=egeTerrainTabs.some(([k])=>k===el.dataset.tab)?el.dataset.tab:'enterprise';render();return}\n const t=EGETerrain.normalize(st.draft.terrain,st.draft);\n if(action==='terrain-add-question'){if(t.questions.length>=20)return;t.questions.push({question:'',answer:'',annex:0})}\n if(action==='terrain-remove-question'){const i=Number(el.dataset.index),q=t.questions[i];if(!q)return;if((q.question||q.answer)&&!await window.MBDialog.confirm('Retirer cette question et sa réponse du dossier ?'))return;t.questions.splice(i,1);t.comparisonReviewed=false;t.synthesisReviewed=false;}\n if(action==='terrain-remove-image'){const kind=el.dataset.kind;if(!['logo','organizationChart'].includes(kind))return;t[kind]=null;t.synthesisReviewed=false;}\n if(action==='terrain-generate-comparison'){\n  if(t.comparisons.some(r=>r.theory||r.practice)&&!await window.MBDialog.confirm('Remplacer les lignes actuelles du tableau par une nouvelle proposition à partir des annexes et de l’entretien ?'))return;\n  const result=EGETerrain.prepareComparison(st.draft);st.draft.terrain=result.terrain;\n  touchTerrain();render();toast(result.unmatched.length?'Tableau préparé. Réponses à rattacher : '+result.unmatched.join(', ')+'.':'Tableau préparé : relisez les rapprochements proposés.');return;\n }\n if(action==='terrain-generate-synthesis'){\n  if(t.synthesis&&!await window.MBDialog.confirm('Remplacer la synthèse actuelle par une nouvelle proposition ?'))return;\n  st.draft.terrain=EGETerrain.generateSynthesis(st.draft,terrainTopic(st.draft));touchTerrain();render();toast('Proposition préparée. Relisez, complétez et validez le texte.');return;\n }\n st.draft.terrain=t;touchTerrain();render();\n}\nasync function terrainFile(event){\n const el=event.target,kind=el?.dataset?.terrainFile,file=el?.files?.[0];\n if(!navigator.onLine||st.offlineSession){toast('L’ajout d’images nécessite Internet. Vous pouvez continuer à rédiger.');return}\n if(!kind||!file)return;\n if(st.role!=='eleve'||!st.draft||st.terrainUploading){el.value='';return}\n const dossierId=st.selectedDocId,userId=st.user?.id;st.terrainUploading=true;el.disabled=true;\n try{\n  const asset=await EGETerrain.uploadImage(file,kind,{db:st.db,userId,dossierId});\n  if(st.selectedDocId!==dossierId||st.user?.id!==userId)throw Error('Le dossier ouvert a changé. Rouvrez le dossier initial pour y ajouter cette image.');\n  st.draft.terrain=EGETerrain.normalize(st.draft.terrain,st.draft);st.draft.terrain[kind]=asset;touchTerrain();\n  await saveDoc({silent:true});toast('Image ajoutée au dossier.');\n }catch(error){fail(error)}finally{st.terrainUploading=false;el.disabled=false;el.value='';render()}\n}\nasync function refreshTerrainImages(){\n const nodes=[...document.querySelectorAll('[data-terrain-imagepath]')];\n await Promise.allSettled(nodes.map(async node=>{\n  const path=node.dataset.terrainImagepath;let cached=egeTerrainImages.get(path);\n  if(!navigator.onLine||st.offlineSession){const local=await window.EGEOffline?.imageURL(path);if(local&&node.isConnected){node.src=local;return}if(node.isConnected)node.alt=\"Image non préparée sur cet appareil. Reconnectez-vous pour la charger.\";return}\n  try{\n   if(!cached||cached.expires<Date.now()){\n    const {data,error}=await st.db.storage.from(EGETerrain.BUCKET).createSignedUrl(path,120);if(error)throw error;\n    cached={url:data.signedUrl,expires:Date.now()+90000};egeTerrainImages.set(path,cached);\n   }\n   if(node.isConnected)node.src=cached.url;\n  }catch(_){if(node.isConnected)node.alt='Image privée indisponible : reconnectez-vous ou ajoutez-la de nouveau.';}\n }));\n}\ndocument.addEventListener('input',terrainInput);\ndocument.addEventListener('change',event=>{if(event.target?.dataset?.terrainFile)terrainFile(event);else if(event.target?.type==='checkbox')terrainInput(event)});\n"],"/app-2027-ads.js":["application/javascript; charset=utf-8",false,"/* EGE 2027 — annonces pédagogiques modérées, sans suivi individuel des élèves. */\nconst EGE_AD_SLOTS=[\n  {id:\"home\",name:\"Accueil général\"},\n  {id:\"auth\",name:\"Connexion et inscription\"},\n  {id:\"student_home\",name:\"Accueil élève\"},\n  {id:\"student_docs\",name:\"Mes dossiers\"},\n  {id:\"student_group\",name:\"Mon groupe\"},\n  {id:\"student_catalog\",name:\"Catalogue des sujets\"},\n  {id:\"student_progress\",name:\"Mes progrès\"},\n  {id:\"student_float\",name:\"Message flottant après connexion (Premium)\"}\n];\nfunction egeAdSafeURL(url){\n  if(!url)return \"\";\n  try{const u=new URL(url);return u.protocol===\"https:\"&&u.hostname?u.href:\"\"}catch(_){return \"\"}\n}\nfunction egeAdLive(ad){\n  if(!ad||ad.status!==\"approved\")return false;\n  const t=Date.now();\n  return (!ad.start_at||new Date(ad.start_at).getTime()<=t)\n    &&Boolean(ad.end_at)&&new Date(ad.end_at).getTime()>t;\n}\nasync function loadAds(){\n  if(!st.db)return;\n  try{\n    const {data,error}=await st.db.from(\"ege2027_ads\")\n      .select(\"id,submitted_by,title,description,details,destination_url,placements,status,is_premium,priority,start_at,end_at,created_at,updated_at,whatsapp_number,subjects,fee_amount,fee_period,teaching_days,teaching_hours,teaching_mode,course_address,image_url,teacher_display_name,target_series,ad_level,show_fee_in_banner,background_path,float_cooldown_hours\")\n      .order(\"is_premium\",{ascending:false}).order(\"priority\",{ascending:false}).order(\"created_at\",{ascending:false}).limit(150);\n    if(error)throw error;\n    st.ads=data||[];\n    st.adError=\"\";\n  }catch(e){st.ads=[];st.adError=e.message||\"Annonces indisponibles.\";}\n}\n\nconst EGE_AD_SERIES=['GFM','OGRH','IAG','S','ES','L','Autres'];\nconst egeAdDirectoryChoices=Object.create(null);\nconst egeAdOwnerTurns=Object.create(null);\nfunction egeAdStudentSeries(){\n return st.user&&st.role==='eleve'&&EGE_AD_SERIES.includes(st.profile?.series)?st.profile.series:null;\n}\nfunction egeAdMatchesSeries(ad,series){\n return !series||series==='all'||Array.isArray(ad.target_series)&&(ad.target_series.includes(series)||['S','ES','L'].includes(series)&&ad.target_series.includes('Autres'));\n}\nfunction egeAdMatchesLevel(ad){\n if(!st.user||st.role!=='eleve')return true;\n const norm=s=>String(s||'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase();\n const level=norm(st.profile?.academic_level||window.MonBac?.level(st.profile)),target=norm(ad.ad_level);\n return !level||!target||target.includes(level)||/tous|toutes|tout niveau/.test(target);\n}\nfunction egeAdDirectorySeries(){\n return egeAdDirectoryChoices[st.user?.id||'public']||egeAdStudentSeries()||'all';\n}\nfunction egeAdSeriesFields(prefix,selected=[]){\n return '<fieldset class=\"ege-ad-targeting\"><legend>Séries concernées</legend><div class=\"ege-ad-series-choices\">'\n  +EGE_AD_SERIES.map(series=>'<label><input type=\"checkbox\" data-ad-series=\"'+esc(prefix)+'\" value=\"'+series+'\" '+(selected.includes(series)?'checked':'')+'><span>'+series+'</span></label>').join('')\n  +'</div><button type=\"button\" class=\"ege-ad-select-all\" data-ad-series-all=\"'+esc(prefix)+'\">Toutes les séries</button></fieldset>';\n}\n\n// Rotation Premium : 1 bannière par emplacement, toutes les 5 secondes.\n// Les publicités classiques restent dans l'annuaire, jamais dans les bannières tournantes.\nconst egeCarouselIndex=Object.create(null);\nconst egeCarouselPausedUntil=Object.create(null);\nconst EGE_CAROUSEL_DELAY=5000;\nlet egeCarouselInterval=null;\nlet egeCarouselPauseWired=false;\nfunction egePremiumSlides(place){\n const eligible=(st.ads||[]).filter(a=>egeAdLive(a)&&a.is_premium===true\n  &&Array.isArray(a.placements)&&a.placements.includes(place)&&egeAdMatchesSeries(a,egeAdStudentSeries())&&egeAdMatchesLevel(a)).sort(egeAdRank);\n const owners=new Map();\n for(const ad of eligible){const key=ad.submitted_by||ad.id;if(!owners.has(key))owners.set(key,[]);owners.get(key).push(ad)}\n if(owners.size<2)return eligible;\n // Chaque enseignant occupe un seul tour, même s’il possède plusieurs annonces.\n const turns=egeAdOwnerTurns[place]||{};\n return Array.from(owners,([owner,ads])=>ads[(turns[owner]||0)%ads.length]);\n}\nfunction egeAdPhoto(ad){\n const url=egeAdSafeURL(ad?.image_url);\n return url||\"./ad-learning.svg\";\n}\nfunction egeAdFor(place){\n const items=egePremiumSlides(place);\n const current=Number(egeCarouselIndex[place]||0);\n return items.length?items[((current%items.length)+items.length)%items.length]:null;\n}\nfunction adBanner(place){\n const slides=egePremiumSlides(place),active=egeAdFor(place);\n if(!active&&place!==\"home\"&&place!==\"auth\")return \"\";\n if(!active)return '<aside class=\"ege-ad-banner ege-ad-neutral\" data-ege-ad-slot=\"'+esc(place)+'\"><div class=\"ege-ad-neutral-copy\"><strong>Annonces des enseignants</strong><p>Découvrez les cours de soutien et les accompagnements.</p></div><a class=\"ege-ad-link\" href=\"./annonces.html\">Consulter les annonces '+I('arrow')+'</a></aside>';\n const count=slides.length,idx=((Number(egeCarouselIndex[place]||0)%count)+count)%count;\n const period={seance:'séance',semaine:'semaine',mois:'mois',trimestre:'trimestre'}[active.fee_period]||'mois';\n const fee=active.show_fee_in_banner===true&&active.fee_amount!==null&&active.fee_amount!==undefined?new Intl.NumberFormat('fr-FR').format(active.fee_amount)+' FDJ / '+period:'';\n const locationText=active.course_address||(active.teaching_mode==='domicile'?'À domicile':'Adresse dans la fiche');\n const controls=count>1?'<nav class=\"ege-ad-carousel-nav\" aria-label=\"Annonces Premium\"><button class=\"ege-ad-arrow\" type=\"button\" data-act=\"ad-prev\" data-slot=\"'+esc(place)+'\" aria-label=\"Annonce précédente\">‹</button><div class=\"ege-ad-dots\">'\n  +slides.map((_,n)=>'<button class=\"ege-ad-dot '+(n===idx?'active':'')+'\" type=\"button\" data-act=\"ad-slide\" data-slot=\"'+esc(place)+'\" data-slide=\"'+n+'\" aria-label=\"Annonce '+(n+1)+' sur '+count+'\" aria-current=\"'+(n===idx?'true':'false')+'\"></button>').join('')\n  +'</div><button class=\"ege-ad-arrow\" type=\"button\" data-act=\"ad-next\" data-slot=\"'+esc(place)+'\" aria-label=\"Annonce suivante\">›</button></nav>':'';\n return '<aside class=\"ege-ad-banner ege-ad-essential ege-ad-banner--'+esc(place)+'\" data-ege-ad-slot=\"'+esc(place)+'\" data-ege-ad-id=\"'+esc(active.id)+'\" aria-label=\"Annonce Premium\">'\n  +'<figure class=\"ege-ad-visual\"><div class=\"ege-ad-art\"><img data-ege-ad-image src=\"'+esc(egeAdPhoto(active))+'\" alt=\"\" loading=\"lazy\"></div>'\n  +'<figcaption class=\"ege-ad-teacher-name\" title=\"'+esc(active.teacher_display_name||'')+'\">'+esc(active.teacher_display_name||'Enseignant')+'</figcaption></figure>'\n  +'<div class=\"ege-ad-copy\"><span class=\"ege-ad-label\">Cours de soutien · Premium</span><strong class=\"ege-ad-subject\" title=\"'+esc(active.subjects||active.title)+'\">'+esc(active.subjects||active.title)+'</strong>'\n  +((active.ad_level||active.target_series?.length)?'<span class=\"ege-ad-level\">'+esc([active.ad_level,...(active.target_series||[])].filter(Boolean).join(' · '))+'</span>':'')\n  +'<span class=\"ege-ad-location\" title=\"'+esc(locationText)+'\">'+I('home')+'<span>'+esc(locationText)+'</span></span>'\n  +'<div class=\"ege-ad-bottom\">'+(fee?'<span class=\"ege-ad-fee\">'+esc(fee)+'</span>':'')+'<button type=\"button\" class=\"ege-ad-details\" data-act=\"ad-info\" data-id=\"'+esc(active.id)+'\">Voir les détails '+I('arrow')+'</button></div></div>'\n  +(controls?'<div class=\"ege-ad-controls\">'+controls+'</div>':'')+'</aside>';\n}\nfunction egeReplaceBanner(place){\n const old=document.querySelector('[data-ege-ad-slot=\"'+place+'\"]');\n if(!old)return;\n const markup=adBanner(place);\n if(!markup){old.remove();return}\n const template=document.createElement(\"template\");\n template.innerHTML=markup;\n old.replaceWith(template.content.firstElementChild);\n}\nfunction egeMoveCarousel(place,step,index=null,manual=false,focusControl=false){\n const list=egePremiumSlides(place);\n if(list.length<2)return;\n const current=Number(egeCarouselIndex[place]||0);\n const next=index!==null?((index%list.length)+list.length)%list.length:((current+step+list.length)%list.length);\n if(next!==((current%list.length)+list.length)%list.length){\n  const owners=new Set(list.map(a=>a.submitted_by||a.id));\n  if(owners.size>1){const owner=list[((current%list.length)+list.length)%list.length].submitted_by||list[((current%list.length)+list.length)%list.length].id;\n   const turns=egeAdOwnerTurns[place]||(egeAdOwnerTurns[place]=Object.create(null));turns[owner]=(turns[owner]||0)+1;}\n }\n egeCarouselIndex[place]=next;\n if(manual)egeCarouselPausedUntil[place]=Date.now()+12000;\n egeReplaceBanner(place);\n if(manual&&focusControl){\n  const btn=document.querySelector('[data-ege-ad-slot=\"'+place+'\"] [data-act=\"'+(step<0?'ad-prev':index!==null?'ad-slide':'ad-next')+'\"]');\n  btn?.focus?.({preventScroll:true});\n }\n}\nfunction egeStartAdCarousel(){\n if(egeCarouselPauseWired===false){\n  egeCarouselPauseWired=true;\n  document.addEventListener(\"pointerdown\",e=>{\n   const target=e.target.closest?.(\"[data-ege-ad-slot]\");\n   if(target)egeCarouselPausedUntil[target.dataset.egeAdSlot]=Date.now()+12000;\n  },{passive:true});\n }\n if(egeCarouselInterval!==null)return;\n egeCarouselInterval=window.setInterval(()=>{\n  if(document.visibilityState===\"hidden\"||document.getElementById(\"egeAdDialog\")?.open)return;\n  const reduceMotion=window.matchMedia?.(\"(prefers-reduced-motion: reduce)\")?.matches;\n  if(st.screen==='ads-directory'&&Array.from(document.querySelectorAll('.ege-directory-card[data-ege-ad-id]')).some(node=>!egeAdLive((st.ads||[]).find(a=>a.id===node.dataset.egeAdId)))){render();return;}\n  const pointerHover=window.matchMedia?.(\"(hover: hover)\")?.matches;\n  document.querySelectorAll(\"[data-ege-ad-slot]\").forEach(node=>{\n   const place=node.dataset.egeAdSlot;\n   if((node.dataset.egeAdId||'')!==(egeAdFor(place)?.id||'')){egeReplaceBanner(place);return;}\n   if(reduceMotion)return;\n   if(egePremiumSlides(place).length<2)return;\n   if((egeCarouselPausedUntil[place]||0)>Date.now())return;\n   if(pointerHover&&node.matches(\":hover\"))return;\n   if(node.contains(document.activeElement))return;\n   if(node.getBoundingClientRect().bottom<0||node.getBoundingClientRect().top>innerHeight)return;\n   egeMoveCarousel(place,1);\n  });\n },EGE_CAROUSEL_DELAY);\n}\n\nfunction egeAdRank(a,b){\n const premium=Number(Boolean(b.is_premium))-Number(Boolean(a.is_premium));\n if(premium)return premium;\n const rank=Number(b.priority||0)-Number(a.priority||0);\n if(rank)return rank;\n return new Date(b.created_at||0).getTime()-new Date(a.created_at||0).getTime();\n}\n\nfunction egeAdPracticalFields(prefix,ad={},includePhoto=true){\n const select=(suffix,label,options,current)=>'<label class=\"field\"><span>'+label+'</span><select class=\"select\" id=\"'+prefix+suffix+'\">'+options.map(([key,name])=>'<option value=\"'+key+'\" '+(current===key?'selected':'')+'>'+name+'</option>').join('')+'</select></label>';\n return '<fieldset class=\"ege-ad-practical\"><legend>Informations pratiques</legend>'\n  +egeAdField(prefix+'DisplayName','Nom de l’enseignant affiché dans l’annonce','Nom ou nom professionnel',ad.teacher_display_name||(prefix==='egeAdTeacher'?st.profile?.full_name||'':''),true)\n  +egeAdField(prefix+'Subjects','Matières proposées','Ex. Gestion, mathématiques',ad.subjects||'',true)\n  +egeAdField(prefix+'Level','Niveau','Ex. Terminale, première',ad.ad_level||'',true)\n  +egeAdSeriesFields(prefix,ad.target_series||[])\n  +'<div class=\"ege-ad-fields-row\">'+egeAdField(prefix+'Fee','Frais en FDJ (facultatif)','Ex. 12000',ad.fee_amount??'')\n  +select('FeePeriod','Tarification',[['mois','Par mois'],['seance','Par séance'],['semaine','Par semaine'],['trimestre','Par trimestre']],ad.fee_period||'mois')+'</div>'\n  +'<label class=\"ege-ad-fee-choice\"><input type=\"checkbox\" id=\"'+prefix+'ShowFee\" '+(ad.show_fee_in_banner===true?'checked':'')+'><span>Afficher les frais dans la bannière</span></label>'\n  +'<div class=\"ege-ad-fields-row\">'+egeAdField(prefix+'Days','Jours','Ex. Samedi, lundi',ad.teaching_days||'')\n  +egeAdField(prefix+'Hours','Heures','Ex. 16h30 – 18h30',ad.teaching_hours||'')+'</div>'\n  +select('Mode','Modalité des cours',[['','Non précisé'],['groupe','En groupe'],['domicile','À domicile'],['mixte','Groupe et domicile']],ad.teaching_mode||'')\n  +egeAdField(prefix+'Address','Adresse ou secteur des cours','Ex. Hayableh, Djibouti',ad.course_address||'',true)\n  +egeAdField(prefix+'WhatsApp','WhatsApp (indicatif pays inclus)','Ex. +253 77 12 34 56',ad.whatsapp_number||'')\n  +(includePhoto?(egeAdField(prefix+'ImageURL','Lien HTTPS vers une image de cours (facultatif)','https://...')\n  +'<label class=\"field ege-ad-upload\"><span>Ou choisir une photo sur votre appareil</span><input type=\"file\" id=\"'+prefix+'Photo\" data-ad-photo=\"'+prefix+'\" accept=\"image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp\" aria-describedby=\"'+prefix+'PhotoHelp\"><small id=\"'+prefix+'PhotoHelp\" style=\"display:block;color:#66758b;margin-top:6px\">JPG, PNG ou WebP, jusqu’à 20 Mo avant compression. La photo choisie remplace le lien HTTPS et sera visible avec votre annonce après validation.</small></label>'\n  +'<div id=\"'+prefix+'PhotoPreview\" class=\"ege-ad-photo-preview\" hidden><img alt=\"Aperçu de la photo choisie\" style=\"display:block;max-width:100%;width:240px;max-height:180px;object-fit:contain;border-radius:12px\"><button class=\"btn smol\" type=\"button\" data-ad-photo-clear=\"'+prefix+'\">Retirer la photo</button></div>'\n  +'<p class=\"small muted\">Ne publiez pas de photos d’élèves sans autorisation. Un lien d’image doit être accessible publiquement.</p>'):'')+'</fieldset>';\n}\nfunction egeAdPracticalPayload(prefix){\n const value=suffix=>cleaned(document.getElementById(prefix+suffix)?.value);\n const teacher_display_name=value(\"DisplayName\");\n if(teacher_display_name.length<2||teacher_display_name.length>120)throw Error(\"Le nom public doit contenir entre 2 et 120 caractères.\");\n const subjects=value('Subjects'),ad_level=value('Level'),course_address=value('Address');\n if(!subjects||subjects.length>180)throw Error('Renseignez les matières (180 caractères maximum).');\n if(!ad_level||ad_level.length>120)throw Error('Renseignez le niveau (120 caractères maximum).');\n if(!course_address||course_address.length>200)throw Error('Renseignez l’adresse ou le secteur des cours (200 caractères maximum).');\n const target_series=Array.from(document.querySelectorAll('[data-ad-series=\"'+CSS.escape(prefix)+'\"]:checked')).map(x=>x.value).filter(x=>EGE_AD_SERIES.includes(x));\n if(!target_series.length)throw Error('Choisissez au moins une série.');\n\n const rawWA=value(\"WhatsApp\");\n const whatsapp_number=rawWA?rawWA.replace(/[+().\\s-]/g,\"\"):null;\n if(whatsapp_number&&!/^[0-9]{8,15}$/.test(whatsapp_number))\n  throw Error(\"Le numéro WhatsApp doit inclure l’indicatif pays et compter 8 à 15 chiffres.\");\n const rawFee=value(\"Fee\");\n const fee_amount=rawFee===\"\"?null:Number(rawFee);\n if(fee_amount!==null&&(!Number.isInteger(fee_amount)||fee_amount<0||fee_amount>100000000))\n  throw Error(\"Saisissez des frais valides en FDJ.\");\n const rawImage=document.getElementById(prefix+\"Photo\")?.files?.length?\"\":value(\"ImageURL\");\n const image_url=egeAdSafeURL(rawImage);\n if(rawImage&&!image_url)throw Error(\"Le lien de l’image doit commencer par https://.\");\n return {\n  teacher_display_name:teacher_display_name||null,\n  whatsapp_number,\n  subjects,ad_level,target_series:[...new Set(target_series)],\n  show_fee_in_banner:Boolean(document.getElementById(prefix+\"ShowFee\")?.checked),\n  fee_amount,\n  fee_period:fee_amount===null?null:(value(\"FeePeriod\")||\"mois\"),\n  teaching_days:value(\"Days\")||null,\n  teaching_hours:value(\"Hours\")||null,\n  teaching_mode:value(\"Mode\")||null,\n  course_address,\n  image_url:image_url||null\n };\n}\n\nconst egeAdPhotoUploads=new WeakMap();\nconst egeAdPhotoPreviews=new Map();\nfunction egeAdClearPhotoPreview(prefix){\n const url=egeAdPhotoPreviews.get(prefix);\n if(url)URL.revokeObjectURL(url);\n egeAdPhotoPreviews.delete(prefix);\n const preview=document.getElementById(prefix+\"PhotoPreview\");\n if(preview){preview.hidden=true;preview.querySelector(\"img\")?.removeAttribute(\"src\")}\n}\nfunction egeAdCheckPhoto(file){EGEAccount.photo.check(file)}\ndocument.addEventListener(\"change\",event=>{\n const input=event.target,prefix=input?.dataset?.adPhoto;\n if(!prefix)return;\n egeAdClearPhotoPreview(prefix);\n const file=input.files?.[0];if(!file)return;\n try{\n  egeAdCheckPhoto(file);\n  const url=URL.createObjectURL(file),preview=document.getElementById(prefix+\"PhotoPreview\");\n  egeAdPhotoPreviews.set(prefix,url);\n  if(preview){preview.querySelector(\"img\").src=url;preview.hidden=false}\n }catch(error){input.value=\"\";toast(error.message)}\n});\ndocument.addEventListener(\"click\",event=>{\n const prefix=event.target.closest?.(\"[data-ad-photo-clear]\")?.dataset.adPhotoClear;\n if(!prefix)return;\n const input=document.getElementById(prefix+\"Photo\");if(input)input.value=\"\";\n egeAdClearPhotoPreview(prefix);\n});\n// Libère les aperçus lorsque l'utilisateur quitte un formulaire.\nnew MutationObserver(()=>{\n for(const prefix of egeAdPhotoPreviews.keys()){\n  const preview=document.getElementById(prefix+\"PhotoPreview\");\n  if(!preview||!preview.querySelector(\"img\")?.hasAttribute(\"src\"))egeAdClearPhotoPreview(prefix);\n }\n}).observe(document.documentElement,{childList:true,subtree:true});\n\n/* Images décodées puis réencodées : taille réduite et métadonnées de la photo supprimées. */\nasync function egeAdUploadPhoto(prefix){\n const input=document.getElementById(prefix+\"Photo\"),file=input?.files?.[0];\n if(!file)return \"\";\n if(!st.db||!st.user?.id)throw Error(\"Connexion nécessaire pour importer une photo.\");\n egeAdCheckPhoto(file);\n const edited=await window.MB72?.photoFor(input,file);\n const previous=egeAdPhotoUploads.get(file);\n if(previous?.userId===st.user.id&&previous.edited===edited)return previous.url;\n const body=edited||await EGEAccount.photo.jpeg(file,{size:1600,square:false,max:3*1024*1024});\n const objectPath=st.user.id+\"/\"+EGEAccount.photo.uuid()+\".jpg\";\n const {error}=await st.db.storage.from(\"ege2027-annonce-photos\").upload(objectPath,body,{contentType:body.type||file.type,cacheControl:\"3600\",upsert:false});\n if(error)throw Error(\"Importation de la photo : \"+error.message);\n const {data}=st.db.storage.from(\"ege2027-annonce-photos\").getPublicUrl(objectPath);\n if(!egeAdSafeURL(data?.publicUrl))throw Error(\"Adresse de photo invalide après importation.\");\n egeAdPhotoUploads.set(file,{userId:st.user.id,url:data.publicUrl,edited});\n return data.publicUrl;\n}\n\nfunction egeAdWhatsAppURL(ad){\n const number=String(ad?.whatsapp_number||\"\");\n if(!/^[0-9]{8,15}$/.test(number))return \"\";\n const message=\"Bonjour, je souhaite des informations sur vos cours : \"+String(ad.title||\"Soutien scolaire\").slice(0,80);\n return \"https://wa.me/\"+number+\"?text=\"+encodeURIComponent(message);\n}\nfunction egeAdFacts(ad){\n const list=[];\n if(ad.subjects)list.push([\"Matières\",ad.subjects]);\n if(ad.ad_level)list.push([\"Niveau\",ad.ad_level]);\n if(ad.target_series?.length)list.push([\"Séries\",ad.target_series.join(' · ')]);\n if(ad.teaching_days)list.push([\"Jours\",ad.teaching_days]);\n if(ad.teaching_hours)list.push([\"Horaires\",ad.teaching_hours]);\n const mode={groupe:\"En groupe\",domicile:\"À domicile\",mixte:\"Groupe et domicile\"}[ad.teaching_mode];\n if(mode)list.push([\"Mode\",mode+(ad.course_address&&ad.teaching_mode!==\"domicile\"?\" · \"+ad.course_address:\"\")]);\n else if(ad.course_address)list.push([\"Adresse\",ad.course_address]);\n const period={seance:\"séance\",semaine:\"semaine\",mois:\"mois\",trimestre:\"trimestre\"}[ad.fee_period]||\"mois\";\n if(ad.fee_amount!==null&&ad.fee_amount!==undefined)list.push([\"Frais\",new Intl.NumberFormat(\"fr-FR\").format(ad.fee_amount)+\" FDJ / \"+period]);\n return list.length?'<dl class=\"ege-directory-facts\">'+list.map(([key,val])=>\n  '<div><dt>'+esc(key)+'</dt><dd>'+esc(val)+'</dd></div>').join(\"\")+'</dl>':\"\";\n}\n\n\nfunction egeTeacherAdCard(ad){\n const url=egeAdSafeURL(ad.destination_url);\n const whatsApp=egeAdWhatsAppURL(ad);\n const cta=url\n  ?'<a class=\"ege-directory-link\" href=\"'+esc(url)+'\" target=\"_blank\" rel=\"noopener noreferrer\">Plus d’informations '+I(\"arrow\")+'</a>'\n  :'<button type=\"button\" class=\"ege-directory-link\" data-act=\"ad-info\" data-id=\"'+esc(ad.id)+'\">Voir les détails '+I(\"arrow\")+'</button>';\n const whatsappButton=whatsApp?'<a class=\"ege-wa-button\" target=\"_blank\" rel=\"noopener noreferrer\" href=\"'+esc(whatsApp)+'\" aria-label=\"Contacter cet enseignant sur WhatsApp\">'\n  +I(\"chat\")+' WhatsApp</a>':\"\";\n return '<article class=\"ege-directory-card\" data-ege-ad-id=\"'+esc(ad.id)+'\">'\n  +'<div class=\"ege-directory-icon\"><img data-ege-ad-image src=\"'+esc(egeAdPhoto(ad))+'\" width=\"94\" height=\"80\" alt=\"\" loading=\"lazy\"></div>'\n  +'<div class=\"ege-directory-content\"><div class=\"ege-directory-overline\">'\n  +(ad.is_premium?'<span class=\"ege-premium-pill\">Premium</span>':'<span>Annonce pédagogique</span>')\n  +'</div><h3>'+esc(ad.title)+'</h3>'+(ad.teacher_display_name?'<p class=\"ege-directory-teacher\">'+esc(ad.teacher_display_name)+'</p>':'')+'<p>'+esc(ad.description)+'</p>'\n  +egeAdFacts(ad)\n  +'<div class=\"ege-directory-actions\">'+whatsappButton+cta+'</div></div></article>';\n}\n\nfunction egeAdsDirectory(){\n const selected=egeAdDirectorySeries();\n const ads=(st.ads||[]).filter(a=>egeAdLive(a)&&egeAdMatchesSeries(a,selected)).sort(egeAdRank);\n const premium=ads.filter(a=>a.is_premium),standard=ads.filter(a=>!a.is_premium);\n const block=(name,caption,rows)=>rows.length?'<section class=\"ege-directory-section\"><div class=\"ege-directory-section-head\"><h2>'+name+'</h2><span>'+caption+'</span></div><div class=\"ege-directory-grid\">'+rows.map(egeTeacherAdCard).join('')+'</div></section>':'';\n const filters='<div class=\"ege-ad-directory-filters\" role=\"group\" aria-label=\"Filtrer les annonces par série\">'+[['all','Toutes'],...EGE_AD_SERIES.map(x=>[x,x])].map(([value,label])=>'<button type=\"button\" data-ad-directory-series=\"'+value+'\" class=\"ege-ad-filter '+(selected===value?'active':'')+'\" aria-pressed=\"'+(selected===value)+'\">'+label+'</button>').join('')+'</div>';\n const empty=st.adError?'<div class=\"ege-directory-empty\" role=\"status\"><h2>Annonces momentanément indisponibles</h2><p>Réessayez en actualisant la page.</p><button type=\"button\" data-act=\"refresh-ads\" class=\"btn primary\">Actualiser</button></div>':'<div class=\"ege-directory-empty\"><div class=\"ege-directory-empty-icon\">'+I('cap')+'</div><h2>'+(selected==='all'?'Aucune annonce publiée pour le moment':'Aucune annonce pour cette série')+'</h2><p>'+(selected==='all'?'Les annonces apparaîtront après validation de l’administration.':'Choisissez « Toutes » pour consulter les autres annonces approuvées.')+'</p></div>';\n return '<div class=\"ege-directory-page\"><div class=\"ege-directory-top\"><a class=\"ege-directory-back\" href=\"./\">'+I('left')+' Retour à l’accueil</a><span class=\"ege-directory-top-label\">Soutien scolaire et accompagnement</span><h1>Annonces des enseignants</h1><p>Des cours adaptés à votre série. Tous les détails dans chaque annonce.</p></div>'+filters+egeFreeNotice()\n  +(ads.length?block('Annonces Premium','En tête des résultats',premium)+block('Autres annonces','Annonces approuvées',standard):empty)+'</div>';\n}\n\nfunction egeAdDialogHTML(){\n  return '<dialog id=\"egeAdDialog\" class=\"ege-ad-info-dialog\" aria-labelledby=\"egeAdDialogTitle\">'\n    +'<div class=\"ege-ad-dialog-head\"><h2 id=\"egeAdDialogTitle\">Annonce pédagogique</h2>'\n    +'<button type=\"button\" class=\"ege-install-close\" data-act=\"ad-close\" aria-label=\"Fermer\">'+I(\"plus\")+'</button></div>'\n    +'<div id=\"egeAdDialogCopy\" class=\"ege-ad-dialog-copy\"></div>'\n    +'<button class=\"btn primary full\" type=\"button\" data-act=\"ad-close\">Fermer</button></dialog>';\n}\nfunction egeShowAdInfo(id){\n  const ad=(st.ads||[]).find(a=>a.id===id&&egeAdLive(a));\n  const dlg=document.getElementById(\"egeAdDialog\");\n  if(!dlg)return;\n  const label=document.getElementById(\"egeAdDialogTitle\");\n  const content=document.getElementById(\"egeAdDialogCopy\");\n  label.textContent=ad?.title||\"Espace de publicité pédagogique\";\n  if(ad){const whatsapp=egeAdWhatsAppURL(ad),destination=egeAdSafeURL(ad.destination_url);content.innerHTML=(ad.image_url?'<img class=\"ege-ad-detail-image\" data-ege-ad-image src=\"'+esc(egeAdPhoto(ad))+'\" alt=\"Image de l’annonce\">':'')+(ad.teacher_display_name?'<p class=\"ege-ad-detail-name\">'+esc(ad.teacher_display_name)+'</p>':'')+'<p class=\"ege-ad-detail-text\">'+esc(ad.description||'')+'</p>'+(ad.details&&ad.details!==ad.description?'<p class=\"ege-ad-detail-text\">'+esc(ad.details)+'</p>':'')+egeAdFacts(ad)+'<div class=\"ege-directory-actions\">'+(whatsapp?'<a class=\"ege-wa-button\" href=\"'+esc(whatsapp)+'\" target=\"_blank\" rel=\"noopener noreferrer\">'+I('chat')+'Contacter sur WhatsApp</a>':'')+(destination?'<a class=\"btn\" href=\"'+esc(destination)+'\" target=\"_blank\" rel=\"noopener noreferrer\">Lien de l’enseignant</a>':'')+'</div><a class=\"ege-ad-all-link\" href=\"./annonces.html\">Toutes les annonces des enseignants</a>'}else content.textContent=\"Cet emplacement est réservé aux annonces pédagogiques approuvées.\";\n  if(dlg.showModal)dlg.showModal();else dlg.setAttribute(\"open\",\"\");\n}\nfunction egeAdField(name,label,placeholder,value=\"\",required=false){\n  return '<label class=\"field\"><span>'+esc(label)+'</span><input class=\"input\" id=\"'+name+'\" '\n    +(required?\"required \":\"\")+'placeholder=\"'+esc(placeholder)+'\" value=\"'+esc(value)+'\"></label>';\n}\nfunction teacherAdPanel(){\n if(st.teacher?.status!==\"approved\")return \"\";\n const mine=(st.ads||[]).filter(a=>a.submitted_by===st.user?.id);\n return '<section class=\"card ege-ad-manager\"><div class=\"card-head\"><div><h3>Proposer une publicité</h3><p class=\"small muted\">Présentez vos cours de soutien. L’administrateur choisit l’emplacement et autorise la publication.</p></div>'+badge(\"Validation requise\",\"orange\")+'</div>'\n  +'<form id=\"egeAdTeacherForm\" class=\"ege-forms\">'\n  +egeAdField(\"egeAdTeacherTitle\",\"Titre de l’annonce\",\"Ex. Cours de soutien en gestion\",\"\",true)\n  +'<label class=\"field\"><span>Description courte</span><textarea id=\"egeAdTeacherDesc\" class=\"textarea\" maxlength=\"180\" required placeholder=\"Une phrase claire sur les cours proposés.\"></textarea></label>'\n  +'<label class=\"field\"><span>Informations complémentaires (facultatif)</span><textarea id=\"egeAdTeacherDetails\" class=\"textarea\" maxlength=\"1200\" placeholder=\"Niveaux, matières, horaires ou conditions.\"></textarea></label>'\n  +egeAdPracticalFields(\"egeAdTeacher\")\n  +egeAdField(\"egeAdTeacherURL\",\"Lien HTTPS de contact (facultatif)\",\"https://...\")\n  +'<button class=\"btn primary\" type=\"submit\">'+I(\"check\")+' Envoyer à l’administration</button></form>'\n  +(mine.length?'<h4 style=\"margin:22px 0 8px\">Mes annonces</h4>'+mine.map(egeOwnedAdCard).join(\"\"):\"\")\n  +'</section>';\n}\nfunction egeAdPlacesChecks(prefix,selected=[\"home\"]){\n return '<div class=\"ege-ad-checks\">'+EGE_AD_SLOTS.map(p=>'<label><input type=\"checkbox\" data-ad-slot=\"'+esc(prefix)+'\" value=\"'+p.id+'\" '+(selected.includes(p.id)?\"checked\":\"\")+'><span>'+esc(p.name)+'</span></label>').join(\"\")+'</div>';\n}\nfunction egeAdFloatFrequency(id,value=24){return '<label class=\"field\"><span>Publicité flottante : délai minimal entre deux affichages de cette annonce</span><select class=\"select\" data-ad-cooldown=\"'+esc(id)+'\">'+[1,6,12,24,48,72,168].map(h=>'<option value=\"'+h+'\" '+(Number(value)===h?'selected':'')+'>'+h+' h</option>').join('')+'</select></label><p class=\"form-note\">À chaque connexion, une annonce Premium éligible ou le message monAvenir est affiché. La croix est la seule commande de fermeture.</p>';}\nlet egeAdAdminFilter=\"all\";\nfunction egeAdminAdPanel(){\n const all=st.ads||[],now=Date.now();\n const active=all.filter(a=>egeAdLive(a)).length;\n const pending=all.filter(a=>a.status===\"pending\").length;\n const premium=all.filter(a=>egeAdLive(a)&&a.is_premium).length;\n const expired=all.filter(a=>a.status===\"approved\"&&a.end_at&&new Date(a.end_at).getTime()<=now).length;\n const records=all.filter(a=>egeAdAdminFilter===\"all\"||\n   (egeAdAdminFilter===\"pending\"&&a.status===\"pending\")||\n   (egeAdAdminFilter===\"active\"&&egeAdLive(a))||\n   (egeAdAdminFilter===\"premium\"&&egeAdLive(a)&&a.is_premium)||\n   (egeAdAdminFilter===\"expired\"&&a.status===\"approved\"&&a.end_at&&new Date(a.end_at).getTime()<=now)||\n   (egeAdAdminFilter===\"paused\"&&a.status===\"paused\"))\n   .sort((a,b)=>Number(b.status===\"pending\")-Number(a.status===\"pending\")||egeAdRank(a,b));\n const stats='<div style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:18px 0\">'+\n   [['Total',all.length],['À valider',pending],['En cours',active],['Premium',premium],['Terminées',expired]].map(([label,num])=>\n    '<div style=\"background:#f7f9fd;border:1px solid #e0e7f1;border-radius:13px;padding:13px\"><strong style=\"display:block;font-size:23px;color:#223b60\">'+num+'</strong><small>'+label+'</small></div>').join('')+'</div>';\n const filter='<label class=\"field\" style=\"margin:15px 0\"><span>Afficher les annonces</span><select class=\"select\" id=\"egeAdAdminFilter\">'+\n   [['all','Toutes'],['pending','En attente'],['active','En cours'],['premium','Premium'],['expired','Expirées'],['paused','Suspendues']].map(([key,label])=>\n   '<option value=\"'+key+'\" '+(egeAdAdminFilter===key?'selected':'')+'>'+label+'</option>').join('')+'</select></label>';\n return '<section class=\"card ege-ad-manager\"><div class=\"card-head\"><div><h3>Gérer les annonces</h3><p class=\"small muted\">Créez, approuvez et positionnez les bannières. Aucune publicité dans la rédaction ou la correction.</p></div>'+badge(pending+\" à examiner\",\"orange\")+'</div>'+stats+filter\n  +'<details class=\"ege-ad-create\"><summary>'+I(\"plus\")+' Créer une annonce administrative</summary>'\n  +'<form id=\"egeAdAdminForm\" class=\"ege-forms\" style=\"margin-top:15px\">'\n  +egeAdField(\"egeAdAdminTitle\",\"Titre\",\"Ex. Cours de soutien\",\"\",true)\n  +'<label class=\"field\"><span>Description courte</span><textarea class=\"textarea\" maxlength=\"180\" required id=\"egeAdAdminDesc\" placeholder=\"Phrase courte, adaptée aux élèves.\"></textarea></label>'\n  +'<label class=\"field\"><span>Informations complémentaires</span><textarea class=\"textarea\" maxlength=\"1200\" id=\"egeAdAdminDetails\"></textarea></label>'\n  +egeAdPracticalFields(\"egeAdAdmin\")\n  +egeAdField(\"egeAdAdminURL\",\"Lien externe HTTPS (facultatif)\",\"https://...\")\n  +'<p class=\"small\" style=\"font-weight:700\">Afficher à ces emplacements</p>'+egeAdPlacesChecks(\"new\",[\"home\"])\n  +'<label class=\"ege-ad-premium-choice\"><input id=\"egeAdAdminPremium\" type=\"checkbox\"> Mettre en Premium (affiché en premier)</label>'\n  +egeAdFloatFrequency('new')\n  +'<div class=\"ege-ad-schedule\"><label>Début (facultatif)<input type=\"datetime-local\" data-ad-start=\"new\"></label><label>Fin de publication (obligatoire)<input type=\"datetime-local\" data-ad-end=\"new\" required></label></div>'\n  +'<button class=\"btn primary\" type=\"submit\">Créer et publier</button></form></details>'\n  +(records.length?records.map(a=>{\n    const tag=a.status===\"approved\"?\"Publiée\":a.status===\"pending\"?\"À valider\":a.status===\"paused\"?\"Suspendue\":\"Refusée\";\n    return '<div class=\"ege-ad-admin-entry\"><div class=\"card-head\"><div><strong>'+esc(a.title)+'</strong><p class=\"small muted\">'+esc(a.description)+'</p></div>'+badge(tag,a.status===\"approved\"?\"green\":\"orange\")+'</div>'\n     +'<img data-ege-ad-image src=\"'+esc(egeAdPhoto(a))+'\" alt=\"Visuel de l’annonce à examiner\" loading=\"lazy\" style=\"display:block;max-width:100%;width:240px;max-height:180px;object-fit:contain;border-radius:12px;margin:12px 0\">'\n     +egeAdPhotoEditor(a)+egeAdDetailsEditor(a)\n     +(a.details?'<p class=\"small\">'+esc(a.details)+'</p>':'')+egeAdFacts(a)\n     +'<label class=\"ege-ad-premium-choice\"><input type=\"checkbox\" data-ad-premium=\"'+esc(a.id)+'\" '+(a.is_premium?'checked':'')+'> Afficher en Premium (avant les annonces classiques)</label>'\n     +'<p class=\"small muted\">Matières : '+esc(a.subjects||\"Non renseignées\")+' · WhatsApp : '+esc(a.whatsapp_number||\"Non renseigné\")+'</p>'\n     +'<p class=\"small\" style=\"font-weight:700;margin:13px 0 7px\">Emplacements de diffusion</p>'\n     +egeAdPlacesChecks(a.id,Array.isArray(a.placements)?a.placements:[\"home\"])\n     +egeAdFloatFrequency(a.id,a.float_cooldown_hours)\n     +'<div class=\"ege-ad-schedule\"><label>Début (facultatif)<input type=\"datetime-local\" data-ad-start=\"'+esc(a.id)+'\" value=\"'+egeAdLocalTime(a.start_at)+'\"></label>'\n     +'<label>Fin de publication (obligatoire)<input type=\"datetime-local\" required data-ad-end=\"'+esc(a.id)+'\" value=\"'+egeAdLocalTime(a.end_at)+'\"></label>'\n     +'<label>Priorité <select data-ad-priority=\"'+esc(a.id)+'\">'+[0,5,10,15,20].map(n=>'<option value=\"'+n+'\" '+(a.priority===n?\"selected\":\"\")+'>'+n+'</option>').join(\"\")+'</select></label></div>'\n     +'<div class=\"inline-actions\" style=\"margin-top:15px\">'\n     +'<button type=\"button\" class=\"btn primary smol\" data-act=\"ad-approve\" data-id=\"'+esc(a.id)+'\">'+I(\"check\")+' Approuver / enregistrer</button>'\n     +'<button type=\"button\" class=\"btn smol\" data-act=\"ad-save-positions\" data-id=\"'+esc(a.id)+'\">Enregistrer les emplacements</button>'\n     +(a.status!==\"paused\"?'<button type=\"button\" class=\"btn smol\" data-act=\"ad-pause\" data-id=\"'+esc(a.id)+'\">Suspendre</button>':'')\n     +(a.status===\"pending\"?'<button type=\"button\" class=\"btn smol\" data-act=\"ad-reject\" data-id=\"'+esc(a.id)+'\">Refuser</button>':'')\n     +'</div></div>';\n  }).join(\"\"):'<p class=\"small muted\" style=\"margin-top:18px\">Aucune annonce enregistrée pour le moment. Vous pouvez publier une première annonce ci-dessus.</p>')\n  +'</section>';\n}\nfunction egeAdLocalTime(date){\n if(!date)return \"\";\n const d=new Date(date);\n const local=new Date(d.getTime()-d.getTimezoneOffset()*60000);\n return Number.isNaN(local.getTime())?\"\":local.toISOString().slice(0,16);\n}\nfunction egeAdSelectedSlots(prefix){\n return Array.from(document.querySelectorAll('[data-ad-slot=\"'+CSS.escape(prefix)+'\"]:checked')).map(x=>x.value);\n}\nfunction egeAdDate(id,key){\n const raw=cleaned(document.querySelector('[data-ad-'+key+'=\"'+CSS.escape(id)+'\"]')?.value);\n if(!raw)return null;\n const d=new Date(raw);\n if(Number.isNaN(d.getTime()))throw Error(\"Date incorrecte.\");\n return d.toISOString();\n}\nasync function egeSubmitTeacherAd(){\n if(st.role!==\"enseignant\"||st.teacher?.status!==\"approved\")throw Error(\"Compte enseignant non approuvé.\");\n const title=cleaned(document.getElementById(\"egeAdTeacherTitle\")?.value);\n const description=cleaned(document.getElementById(\"egeAdTeacherDesc\")?.value);\n const details=cleaned(document.getElementById(\"egeAdTeacherDetails\")?.value);\n const rawURL=cleaned(document.getElementById(\"egeAdTeacherURL\")?.value);\n if(title.length<4||description.length<8)throw Error(\"Saisissez un titre et une description.\");\n const url=egeAdSafeURL(rawURL);\n if(rawURL&&!url)throw Error(\"L'adresse doit commencer par https://.\");\n const fields=egeAdPracticalPayload(\"egeAdTeacher\");\n const uploaded=await egeAdUploadPhoto(\"egeAdTeacher\");if(uploaded)fields.image_url=uploaded;\n const {error}=await st.db.from(\"ege2027_ads\").insert({\n  submitted_by:st.user.id,title,description,details,destination_url:url||null,status:\"pending\",is_premium:false,placements:[\"home\"],...fields\n });\n if(error)throw error;\n await loadAds();toast(\"Annonce envoyée à l’administrateur pour validation.\");render();\n}\nasync function egeAdminCreateAd(){\n if(st.role!==\"admin\")throw Error(\"Accès administrateur nécessaire.\");\n const title=cleaned(document.getElementById(\"egeAdAdminTitle\")?.value);\n const description=cleaned(document.getElementById(\"egeAdAdminDesc\")?.value);\n const details=cleaned(document.getElementById(\"egeAdAdminDetails\")?.value);\n const rawURL=cleaned(document.getElementById(\"egeAdAdminURL\")?.value);\n const placements=egeAdSelectedSlots(\"new\");\n if(placements.includes('student_float')&&!document.getElementById('egeAdAdminPremium')?.checked)throw Error('Le message flottant est réservé aux annonces Premium.');\n if(title.length<4||description.length<8)throw Error(\"Saisissez un titre et une description.\");\n if(!placements.length)throw Error(\"Choisissez au moins un emplacement.\");\n const url=egeAdSafeURL(rawURL);\n if(rawURL&&!url)throw Error(\"Seules les adresses HTTPS sont acceptées.\");\n const start_at=egeAdDate('new','start'),end_at=egeAdDate('new','end');\n egeAdCheckPublicationDates(start_at,end_at);\n const fields=egeAdPracticalPayload(\"egeAdAdmin\");\n const uploaded=await egeAdUploadPhoto(\"egeAdAdmin\");if(uploaded)fields.image_url=uploaded;\n const {error}=await st.db.from(\"ege2027_ads\").insert({\n  submitted_by:st.user.id,title,description,details,destination_url:url||null,\n  status:\"approved\",approved_by:st.user.id,is_premium:Boolean(document.getElementById(\"egeAdAdminPremium\")?.checked),placements,float_cooldown_hours:Number(document.querySelector('[data-ad-cooldown=\"new\"]')?.value||24),\n  start_at,end_at,...fields\n });\n if(error)throw error;\n await loadAds();toast(\"Annonce créée et publiée.\");render();\n}\nasync function egeAdminUpdateAd(id,action){\n if(st.role!==\"admin\")throw Error(\"Accès administrateur nécessaire.\");\n const target=(st.ads||[]).find(a=>a.id===id);\n if(!target)throw Error(\"Annonce introuvable.\");\n if(action==='pause'||action==='reject'){\n  if(!await window.MBDialog.confirm((action==='pause'?'Suspendre':'Refuser')+' cette annonce ?'))return;\n  const {error}=await st.db.from('ege2027_ads').update({status:action==='pause'?'paused':'rejected',updated_at:new Date().toISOString()}).eq('id',id);\n  if(error)throw error;await loadAds();toast('Annonce mise à jour.');render();return;\n }\n const placements=egeAdSelectedSlots(id);\n if(!placements.length)throw Error(\"Choisissez au moins un emplacement.\");\n const start_at=egeAdDate(id,\"start\"),end_at=egeAdDate(id,\"end\");\n if(action==='approve'||target.status==='approved')egeAdCheckPublicationDates(start_at,end_at);\n if(action==='approve'&&(!target.teacher_display_name||!target.subjects||!target.ad_level||!target.course_address))throw Error('Complétez le nom, les matières, le niveau et l’adresse dans « Modifier les informations » avant de publier.');\n if(start_at&&end_at&&new Date(start_at)>=new Date(end_at))throw Error(\"La date de fin doit être après le début.\");\n const priority=Number(document.querySelector('[data-ad-priority=\"'+CSS.escape(id)+'\"]')?.value||\"0\");\n const is_premium=Boolean([...document.querySelectorAll(\"[data-ad-premium]\")].find(x=>x.dataset.adPremium===id)?.checked);\n if(placements.includes('student_float')&&!is_premium)throw Error('Retirez l’emplacement flottant ou activez Premium.');\n const changes={placements,start_at,end_at,priority,is_premium,float_cooldown_hours:Number(document.querySelector('[data-ad-cooldown=\"'+CSS.escape(id)+'\"]')?.value||24),updated_at:new Date().toISOString()};\n if(action===\"approve\"){changes.status=\"approved\";changes.approved_by=st.user.id}\n const {error}=await st.db.from(\"ege2027_ads\").update(changes).eq(\"id\",id);\n if(error)throw error;\n await loadAds();toast(\"Annonce mise à jour.\");render();\n}\n\n// Filtre administrateur persistant pendant la session.\ndocument.addEventListener(\"change\",event=>{if(event.target?.id===\"egeAdAdminFilter\"){egeAdAdminFilter=event.target.value;render();}});\n\n/* Une image modifiée par l'enseignant repasse systématiquement en validation. */\nfunction egeAdPhotoEditor(ad){const prefix='egeAdEdit_'+ad.id;return '<details class=\"ege-ad-image-editor\"><summary>'+(ad.image_url?'Remplacer ou retirer l’image':'Ajouter une image')+'</summary>'+(!ad.image_url?'<p class=\"small muted\">Choisissez une photo sur votre appareil.</p>':'')+'<input type=\"file\" id=\"'+prefix+'Photo\" data-ad-photo=\"'+prefix+'\" accept=\"image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp\" aria-label=\"Choisir l’image de cette annonce\"><div id=\"'+prefix+'PhotoPreview\" class=\"ege-ad-photo-preview\" hidden><img alt=\"Aperçu de la photo choisie\" style=\"max-width:100%;width:240px;max-height:180px;object-fit:contain;border-radius:12px\"><button class=\"btn smol\" type=\"button\" data-ad-photo-clear=\"'+prefix+'\">Retirer la sélection</button></div>'+(ad.image_url?'<label class=\"form-check\"><input type=\"checkbox\" data-ad-remove-image=\"'+ad.id+'\"> Retirer l’image actuelle</label>':'')+'<p class=\"small muted\">'+(st.role==='admin'?'La modification conserve le statut actuel de l’annonce.':'La nouvelle image sera soumise à l’administration avant publication.')+'</p><button type=\"button\" class=\"btn\" data-ad-image-save=\"'+ad.id+'\">Enregistrer l’image</button><p role=\"status\" data-ad-image-status=\"'+ad.id+'\" class=\"small\"></p></details>'}\nfunction egeOwnedAdCard(ad){return '<section class=\"ege-owned-ad-entry\"><div class=\"list-row\">'+(ad.image_url?'<img class=\"ege-ad-thumb\" data-ege-ad-image src=\"'+esc(egeAdPhoto(ad))+'\" alt=\"Photo de mon annonce\">':'')+'<div class=\"row-content\"><strong>'+esc(ad.title)+'</strong><small>'+esc(ad.description)+'</small></div>'+badge(ad.status==='approved'?'Publiée':ad.status==='pending'?'En attente':ad.status==='paused'?'Suspendue':'Refusée',ad.status==='approved'?'green':'orange')+'</div>'+egeAdPhotoEditor(ad)+egeAdDetailsEditor(ad)+'</section>'}\nasync function egeSaveAdImage(id){const ad=st.ads.find(a=>a.id===id);if(!ad||!(st.role==='admin'||st.role==='enseignant'&&ad.submitted_by===st.user?.id))throw Error('Annonce inaccessible.');const button=document.querySelector('[data-ad-image-save=\"'+id+'\"]'),status=document.querySelector('[data-ad-image-status=\"'+id+'\"]');if(button?.disabled)return;if(!navigator.onLine)throw Error('Internet est nécessaire pour modifier l’image.');if(button)button.disabled=true;if(status)status.textContent='Préparation et enregistrement de l’image…';try{const prefix='egeAdEdit_'+id,remove=document.querySelector('[data-ad-remove-image=\"'+id+'\"]')?.checked;let path=null;if(!remove){const url=await egeAdUploadPhoto(prefix);if(!url)throw Error('Choisissez une photo, ou cochez le retrait de l’image actuelle.');const u=new URL(url),marker='/storage/v1/object/public/ege2027-annonce-photos/';if(!u.pathname.startsWith(marker))throw Error('Image importée invalide.');path=decodeURIComponent(u.pathname.slice(marker.length))}const r=await st.db.rpc('ege2027_ad_photo',{p_ad:id,p_path:path});if(r.error)throw r.error;await loadAds();toast(st.role==='admin'?'Image enregistrée.':'Image enregistrée et envoyée pour validation.');render()}catch(e){if(status)status.textContent='L’image n’a pas été enregistrée : '+e.message;throw e}finally{if(button)button.disabled=false}}\ndocument.addEventListener('click',event=>{const b=event.target.closest?.('[data-ad-image-save]');if(!b)return;event.preventDefault();egeSaveAdImage(b.dataset.adImageSave).catch(e=>toast(e.message))});\ndocument.addEventListener('error',event=>{const img=event.target;if(!(img instanceof HTMLImageElement)||!img.hasAttribute('data-ege-ad-image')||img.dataset.adImageFallback)return;img.dataset.adImageFallback='true';img.src='/ad-learning.svg';img.alt='Illustration des cours de soutien';},true);\n\n\nfunction egeAdCheckPublicationDates(start,end){\n if(!end)throw Error('Fixez une date de fin de publication.');\n if(new Date(end).getTime()<=Date.now())throw Error('La date de fin doit être dans le futur.');\n if(start&&new Date(start)>=new Date(end))throw Error('La date de fin doit être après le début.');\n}\nfunction egeAdDetailsEditor(ad){\n const prefix='egeAdDetails_'+ad.id;\n return '<details class=\"ege-ad-details-editor\"><summary>Modifier les informations</summary><form data-ad-details-form=\"'+esc(ad.id)+'\" class=\"ege-forms\">'+egeAdPracticalFields(prefix,ad,false)\n  +'<p class=\"small muted\">'+(st.role==='admin'?'Les changements sont enregistrés dans cette annonce.':'Toute modification doit être approuvée par l’administration avant publication.')+'</p><button class=\"btn primary\" type=\"submit\">Enregistrer les informations</button><p class=\"ege-ad-edit-status\" role=\"status\"></p></form></details>';\n}\nasync function egeSaveAdDetails(id,form){\n const ad=(st.ads||[]).find(a=>a.id===id);\n if(!ad||!(st.role==='admin'||st.role==='enseignant'&&ad.submitted_by===st.user?.id))throw Error('Annonce inaccessible.');\n const fields=egeAdPracticalPayload('egeAdDetails_'+id);delete fields.image_url;\n const {error}=await st.db.rpc('ege2027_ad_details',{p_ad:id,p_fields:fields});\n if(error)throw error;\n await loadAds();toast(st.role==='admin'?'Informations enregistrées.':'Informations envoyées pour validation.');render();\n}\ndocument.addEventListener('submit',event=>{\n const form=event.target;if(!form.matches?.('[data-ad-details-form]'))return;event.preventDefault();\n const button=form.querySelector('[type=\"submit\"]'),status=form.querySelector('[role=\"status\"]');if(button.disabled)return;button.disabled=true;status.textContent='Enregistrement…';\n egeSaveAdDetails(form.dataset.adDetailsForm,form).catch(e=>{status.textContent=e.message;status.classList.add('ege-ad-edit-error')}).finally(()=>{button.disabled=false});\n});\ndocument.addEventListener('click',event=>{\n const all=event.target.closest?.('[data-ad-series-all]');\n if(all){event.preventDefault();document.querySelectorAll('[data-ad-series=\"'+CSS.escape(all.dataset.adSeriesAll)+'\"]').forEach(input=>{input.checked=true});return;}\n const filter=event.target.closest?.('[data-ad-directory-series]');if(!filter)return;\n const series=filter.dataset.adDirectorySeries;if(series!=='all'&&!EGE_AD_SERIES.includes(series))return;\n egeAdDirectoryChoices[st.user?.id||'public']=series;render();document.querySelector('[data-ad-directory-series=\"'+series+'\"]')?.focus({preventScroll:true});\n});\n"],"/app-2027-views.js":["application/javascript; charset=utf-8",false,"const official=[{\"title\":\"La fidélisation et la rentabilité financière\",\"subthemes\":[\"L’importance de la fidélisation dans la rentabilité de l’entreprise\",\"L’impact de la satisfaction client sur la rentabilité\",\"Le rôle et les coûts du service après-vente\",\"La politique de prix et la fidélité des clients\",\"Les programmes de fidélité et leur retour sur investissement\",\"Les indicateurs de mesure de la fidélisation\",\"Les limites et risques des stratégies de fidélisation\",\"La personnalisation de l’expérience client et la fidélisation\",\"Le rôle de la fidélisation dans la pérennité de l’entreprise\",\"La maîtrise des coûts de fidélisation et l’augmentation des bénéfices\",\"La fidélisation de la clientèle comme avantage concurrentiel durable\"]},{\"title\":\"Financement et développement des organisations (publiques et privées)\",\"subthemes\":[\"Les moyens de financement des organisations\",\"Le financement du cycle d’exploitation\",\"Le financement des organisations publiques\",\"Financement et stratégie de développement de l’organisation\",\"Le choix d’un mode de financement adapté\",\"L’investissement comme moteur du développement des organisations\",\"Les différentes sources de financement et la pérennité des organisations\",\"Le financement externe et le développement des organisations\",\"Le financement de l’innovation\",\"Les stratégies de financement des entreprises nationales\",\"L’équilibre financier et le développement commercial des organisations\"]},{\"title\":\"La gestion de la marque et du capital\",\"subthemes\":[\"La valeur perçue de la marque et la fidélisation de la clientèle\",\"Les investissements mercatiques et leur rentabilité\",\"La compétitivité et les stratégies de positionnement des marques locales face aux marques internationales\",\"La croissance de la marque et la rentabilité de l’entreprise\",\"Les stratégies de construction de l’image, de la notoriété et de la communication commerciale\",\"La protection juridique de la marque et la lutte contre la contrefaçon\",\"L’impact des réseaux sociaux et du numérique sur la marque\",\"La notoriété de la marque et son impact sur la rentabilité de l’entreprise\"]},{\"title\":\"La politique de prix et la rentabilité\",\"subthemes\":[\"Le prix de vente et la rentabilité\",\"L’influence de la politique de prix sur le comportement des consommateurs\",\"Les stratégies de prix face à la concurrence\",\"La politique de prix et le cycle de vie du produit\",\"Les promotions, les réductions de prix et leur impact sur la rentabilité\",\"Les différentes stratégies de prix et leur impact sur le bénéfice\",\"La maîtrise des coûts dans la fixation des prix\"]},{\"title\":\"L’utilisation de l’IA dans la gestion financière et la mercatique\",\"subthemes\":[\"L’impact global de l’intelligence artificielle sur la gestion financière et la performance mercatique\",\"L’IA dans la prévision des ventes\",\"L’IA et la sécurisation des transactions financières\",\"L’utilisation de l’IA dans l’analyse du marché\",\"L’IA, la communication commerciale et la relation client\",\"L’IA dans la fixation des prix et l’optimisation de la rentabilité\",\"La contribution de l’IA à la maîtrise des coûts et à l’automatisation de la comptabilité\",\"La protection des données et le coût de l’utilisation de l’IA dans la gestion\",\"Les métiers de la finance et du marketing à l’ère de l’IA\"]},{\"title\":\"La gestion des risques financiers et mercatiques\",\"subthemes\":[\"La gestion des impayés clients et les risques financiers\",\"Les risques d’insolvabilité et d’endettement liés à la gestion de la trésorerie\",\"Les devises étrangères et la gestion des risques financiers\",\"Les stratégies de prévention et de couverture des risques\",\"La gestion des risques financiers et mercatiques sur la rentabilité de l’entreprise\"]}];\n\n'use strict';\nfunction vGreeting(){\n const email=cleaned(st.user?.email||\"\");\n const first=st.role===\"enseignant\"?cleaned(st.teacher?.full_name):st.role===\"admin\"?\"Administration\":cleaned(st.draft?.student||currentDoc()?.payload?.student);\n return first||email.split(\"@\")[0]||\"Bienvenue\";\n}\nfunction renderHeader(){\n const intro=st.screen===\"welcome\"||st.screen===\"auth\"||st.screen===\"ads-directory\"||(st.screen===\"pricing\"||st.screen===\"privacy\"||st.screen===\"student-class-start\"||st.screen===\"student-enrollment\"||st.screen===\"account-recovery\"||st.screen===\"teacher-enrollment\");\n if(intro)return `<header class=\"ege-red-hero\" aria-label=\"EGE 2027\">\n  <div class=\"ege-hero-actions\"><span class=\"ege-hero-edition\">Études de Gestion Encadrées</span>\n   <button class=\"ege-hero-install\" type=\"button\" data-act=\"install\">${I(\"download\")} <span>Installer</span></button>\n  </div>\n  <div class=\"ege-hero-brand\"><div class=\"ege-hero-symbol\" aria-hidden=\"true\">${I(\"cap\")}${I(\"book\")}</div>\n   <h1>EGE 2027</h1><p>Votre espace pédagogique</p></div>\n  <svg class=\"ege-hero-wave\" viewBox=\"0 0 1000 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n   <path d=\"M0 53 C160 -5 325 101 520 78 S875 0 1000 40 L1000 100 L0 100Z\" fill=\"#ffffff\"/>\n  </svg></header>`;\n const role={eleve:\"Élève\",enseignant:\"Enseignant\",admin:\"Administration\"}[st.role];\n return `<header class=\"app-header\"><a class=\"brand\" href=\"./\" aria-label=\"Accueil EGE 2027\" style=\"text-decoration:none\">\n <img class=\"brandmark ege-brand-icon\" src=\"./icon-ege-2027.svg\" width=\"43\" height=\"43\" alt=\"EGE 2027\"><span><span class=\"brandname\">EGE 2027</span><br><span class=\"brand-sub\">Encadrement pédagogique · ${role}</span></span></a>\n <div class=\"header-right\"><button type=\"button\" class=\"btn ege-install-header\" data-act=\"install\" aria-label=\"Installer EGE 2027\">${I(\"download\")}<span>Installer</span></button><span class=\"version-pill\">2026–2027</span>${st.user?`<button class=\"header-icon\" data-act=\"refresh\" aria-label=\"Actualiser\">${I(\"clock\")}</button><button class=\"avatar\" data-act=\"goto\" data-to=\"profile\" aria-label=\"Ouvrir mon profil\">${esc((vGreeting()||\"U\").charAt(0).toUpperCase())}</button>`:badge(\"Bienvenue\",\"red\")}</div></header>`;\n}\nfunction menu(){\n const items=navs[st.role]||[],active=st.screen;\n return `<aside class=\"sidebar\" aria-label=\"Navigation\"><div class=\"sectionlabel\">Mon espace</div>\n ${items.map(([id,label,icon])=>`<button type=\"button\" class=\"side-link ${(id===active)?\"active\":\"\"}\" data-act=\"goto\" data-to=\"${id}\"><span class=\"ico\">${I(icon)}</span><span class=\"txt\">${esc(label)}</span></button>`).join(\"\")}\n <div class=\"sectionlabel\">Outils</div>\n ${st.role===\"eleve\"?`<button class=\"side-link\" data-act=\"goto\" data-to=\"student-wizard\"><span class=\"ico\">${I(\"edit\")}</span><span class=\"txt\">Assistant EGE</span></button>\n <button class=\"side-link\" data-act=\"goto\" data-to=\"student-terrain\"><span class=\"ico\">${I(\"monitor\")}</span><span class=\"txt\">Ma partie terrain</span></button><button class=\"side-link\" data-act=\"goto\" data-to=\"student-annex\"><span class=\"ico\">${I(\"file\")}</span><span class=\"txt\">Mes annexes</span></button>`:st.role===\"enseignant\"?`<button class=\"side-link\" data-act=\"goto\" data-to=\"teacher-students\"><span class=\"ico\">${I(\"cap\")}</span><span class=\"txt\">Mes élèves</span></button>`:`<button class=\"side-link\" data-act=\"goto\" data-to=\"admin-groups\"><span class=\"ico\">${I(\"users\")}</span><span class=\"txt\">Groupes</span></button><button class=\"side-link\" data-act=\"goto\" data-to=\"admin-monitor\"><span class=\"ico\">${I(\"shield\")}</span><span class=\"txt\">Audit et sécurité</span></button>`}\n <div class=\"side-spacer\"></div><div class=\"side-hint\"><b>Votre travail reste personnel.</b><p>${st.role===\"eleve\"?\"L’enseignant ne voit que le dossier associé à son groupe.\":st.role===\"admin\"?\"Les opérations sensibles sont enregistrées.\":\"Chaque groupe conserve ses propres membres et dossiers.\"}</p></div>\n </aside>`;\n}\nfunction bottomNav(){\n return `<nav class=\"bottomnav\" aria-label=\"Navigation rapide\">${(navs[st.role]||[]).map(([id,name,icon])=>`<button type=\"button\" data-act=\"goto\" data-to=\"${id}\" class=\"${st.screen===id?\"active\":\"\"}\" aria-label=\"${esc(name)}\">${I(icon)}<span>${esc(name)}</span></button>`).join(\"\")}</nav>`;\n}\nfunction feedback(){\n if(st.lastError)return `<div class=\"ege-feedback\" role=\"alert\">${esc(st.lastError)}</div>`;\n if(st.notice)return `<div class=\"ege-feedback good\" role=\"status\">${esc(st.notice)}</div>`;\n return \"\";\n}\nfunction welcome(){\n const roles=[\n  [\"eleve\",\"Élève\",\"Mes sujets, mes corrigés et mon EGE\",\"cap\"],\n  [\"enseignant\",\"Enseignant\",\"Mes classes, mes élèves et mes sujets\",\"users\"],\n  [\"admin\",\"Administrateur\",\"Gestion de la plateforme\",\"shield\"]\n ];\n return `<div class=\"onboard ege-onboard-new\">${egeFreeNotice()}\n  <div class=\"onboard-top\"><h2>Choisissez votre espace</h2><p class=\"onlead\">Préparez votre bac : sujets, corrigés, classes et études de gestion. GFM · OGRH · IAG · S · ES · L.</p></div>\n  <div class=\"rolecards\">\n   ${roles.map(([id,name,desc,icon])=>`<button type=\"button\" class=\"rolecard\" data-act=\"role\" data-role=\"${id}\" aria-label=\"Accéder à l'espace ${esc(name)}\">\n     <span class=\"roleicon\">${I(icon)}</span><h3>${name}</h3><p>${desc}</p>\n   </button>`).join(\"\")}\n  </div>\n  ${adBanner(\"home\")}\n  <div class=\"ege-install-entry\"><button type=\"button\" class=\"btn primary ege-install-button\" data-act=\"install\">${I(\"download\")} Installer l’application</button></div>\n  <div class=\"onboard-bottom\">Connexion sécurisée · Confidentialité des dossiers · Accompagnement scolaire</div>\n </div>`;\n}\nfunction auth(){\n const role={eleve:\"élève\",enseignant:\"enseignant\",admin:\"administrateur\"}[st.desired]||\"élève\";\n const isSign=st.mode===\"signup\",isForgot=st.mode===\"forgot\";\n return `<div class=\"ege-auth-stage\"><div class=\"login-card\">${egeFreeNotice()}<button class=\"backbtn\" data-act=\"goto\" data-to=\"welcome\">${I(\"left\")} Changer d’espace</button>\n <span class=\"login-badge\">${esc(role.toUpperCase())}</span><h1>${st.pendingPasswordReset?\"Changer votre mot de passe\":isSign?\"Créer mon compte\":isForgot?\"Récupérer mon compte\":\"Connexion\"}</h1>\n <p class=\"muted small\">${st.pendingPasswordReset?\"Définissez un nouveau mot de passe pour votre compte.\":isForgot?\"Recevez un lien de réinitialisation par e-mail.\":\"Retrouvez vos dossiers, classes et corrections.\"}</p>\n ${st.pendingPasswordReset?`<div class=\"field\"><label class=\"password-label\" for=\"newPassword\">Nouveau mot de passe</label><div class=\"password-wrap\"><input id=\"newPassword\" class=\"input\" type=\"password\" minlength=\"12\" autocomplete=\"new-password\" placeholder=\"12 caractères minimum\"><button class=\"password-toggle\" type=\"button\" data-act=\"toggle-password\" data-target=\"newPassword\" aria-label=\"Afficher le mot de passe\" aria-pressed=\"false\" title=\"Afficher le mot de passe\">${I(\"eye\")}</button></div></div>${btn(\"Enregistrer le nouveau mot de passe\",\"reset-password\",\"btn primary full\",\"check\")}`:\n `<form id=\"authForm\" class=\"ege-forms\">\n <label class=\"field\"><span>Adresse e-mail</span><input id=\"authEmail\" class=\"input\" type=\"email\" required autocomplete=\"email\" placeholder=\"prenom@exemple.com\"></label>\n ${!isForgot?`<div class=\"field\"><label class=\"password-label\" for=\"authPassword\">Mot de passe</label><div class=\"password-wrap\"><input id=\"authPassword\" class=\"input\" type=\"password\" minlength=\"${isSign?12:6}\" required autocomplete=\"${isSign?\"new-password\":\"current-password\"}\" placeholder=\"Votre mot de passe\"><button class=\"password-toggle\" type=\"button\" data-act=\"toggle-password\" data-target=\"authPassword\" aria-label=\"Afficher le mot de passe\" aria-pressed=\"false\" title=\"Afficher le mot de passe\">${I(\"eye\")}</button></div></div>`:\"\"}\n ${isSign?`<label class=\"field\"><span>Nom complet</span><input id=\"authFullName\" class=\"input\" required maxlength=\"120\" autocomplete=\"name\" placeholder=\"Nom et prénom\"></label>${st.desired===\"eleve\"?`<label class=\"field\"><span>Série</span><select id=\"authSeries\" class=\"select\" required>${EGEAcademic.options(EGEAcademic.series,\"\",\"Choisir une série\")}</select></label><label class=\"field\"><span>Classe</span><select id=\"authClass\" class=\"select\" required disabled><option value=\"\">Choisir d’abord une série</option></select></label>`:\"\"}<label class=\"field\"><span>Établissement</span><select id=\"authSchool\" class=\"select\" required>${EGEAcademic.options(EGEAcademic.schools,\"\",\"Choisir un établissement\")}</select></label>`:\"\"}\n ${isSign?`<p class=\"form-note signup-privacy-note\">Votre nom, votre e-mail et votre scolarité servent à gérer votre compte et vos dossiers. Le WhatsApp est obligatoire pour les élèves. <a href=\"/confidentialite.html\" target=\"_blank\" rel=\"noopener\">Lire les informations de confidentialité</a>.</p>`:\"\"}\n <button type=\"submit\" class=\"btn primary full\">${isForgot?\"Envoyer un lien\":isSign?\"M'inscrire\":\"Se connecter\"} ${I(\"arrow\")}</button></form>\n <div class=\"inline-actions\" style=\"justify-content:space-between;margin-top:16px\">\n ${st.desired!==\"admin\"?btn(isSign||isForgot?\"Déjà inscrit ?\":\"Créer un compte\",\"mode\",\"btn ghost smol\",\"\",`data-mode=\"${isSign||isForgot?\"login\":\"signup\"}\"`):\"\"}\n ${btn(isForgot?\"Retour\":\"Mot de passe oublié ?\",\"mode\",\"btn ghost smol\",\"\",`data-mode=\"${isForgot?\"login\":\"forgot\"}\"`)}\n </div>${st.desired===\"enseignant\"?`<p class=\"form-note\">Votre compte enseignant sera actif après validation par l'administrateur.</p>`:\"\"}`}\n </div><div class=\"ege-auth-ad\">${adBanner(\"auth\")}</div></div>`;\n}\nfunction stat(label,num,icon){return `<div class=\"stat\"><div class=\"stat-row\"><span class=\"stat-label\">${esc(label)}</span><span class=\"stat-icon\">${I(icon)}</span></div><div class=\"stat-num\">${csvCount(num)}</div></div>`}\nfunction tile(name,sub,icon,screen){return `<button class=\"tile\" data-act=\"goto\" data-to=\"${screen}\"><span class=\"tile-icon\">${I(icon)}</span><span><span class=\"tile-title\">${esc(name)}</span><br><span class=\"tile-sub\">${esc(sub)}</span></span></button>`}\nfunction reviewBadge(r){return badge(r.decision===\"valide\"?\"Validé\":\"À corriger\",r.decision===\"valide\"?\"green\":\"orange\")}\nfunction reviewList(rows){\n if(!rows.length)return emptyCard(\"Aucune correction reçue pour le moment.\");\n return rows.map(r=>`<div class=\"list-row\"><span class=\"row-icon red\">${I(\"chat\")}</span><div class=\"row-content\"><strong>${r.annex_number?\"Annexe \"+r.annex_number:\"Dossier complet\"}</strong><small>${esc(r.observation||\"Travail validé\")} · ${longDate(r.created_at)}</small></div>${reviewBadge(r)}</div>`).join(\"\");\n}\nfunction studentHome(){\n const d=currentDoc(),groups=st.groups.filter(g=>!g.deleted_at),groupNames=[...new Set(groups.map(g=>g.name).filter(Boolean))],rev=d?st.reviews.filter(r=>r.dossier_id===d.id):st.reviews,progress=docProgress(d);\n const meta=d?[Number.isInteger(d.payload?.theme)?`Thème ${d.payload.theme+1}`:\"Sujet à préciser\",d.payload?.className||groupNames[0]||st.profile?.class_name].filter(Boolean).join(\" · \"):\"Préparez votre étude étape par étape.\";\n const shortcut=(name,sub,ico,to)=>`<button type=\"button\" class=\"mb99-shortcut\" data-act=\"goto\" data-to=\"${to}\"><span class=\"mb99-shortcut-icon\">${I(ico)}</span><strong>${esc(name)}</strong><small>${esc(sub)}</small></button>`;\n const correction=r=>`<div class=\"mb99-review-row\"><div class=\"mb99-review-text\"><strong>${r.annex_number?\"Annexe \"+esc(r.annex_number):\"Dossier complet\"}</strong><small title=\"${esc(r.observation||\"Travail validé\")}\">${esc(r.observation||\"Travail validé\")}</small></div>${reviewBadge(r)}</div>`;\n return `<div class=\"mb99-ege\"><div class=\"mb99-heading\"><div><h1>Mon EGE</h1><p>Bonjour ${esc(vGreeting())}</p></div><div class=\"mb99-status\">${st.localCandidate?btn(\"Récupérer le brouillon\",\"restore-draft\",\"mb99-recover\",\"cloud\"):badge(st.saveBadge,st.saveBadge===\"Enregistré en ligne\"?\"green\":\"orange\")}</div></div>\n ${st.warning&&!st.localCandidate?`<p class=\"mb99-warning\" role=\"status\">${I(\"info\")} ${esc(st.warning)}</p>`:\"\"}\n <div class=\"mb99-layout\"><div class=\"mb99-primary\">\n <section class=\"feature mb99-feature\"><div class=\"feature-label\">${I(\"folder\")} ${d?\"Dossier en cours\":\"Commencer mon étude\"}</div>\n <h2>${esc(d?docTitle(d):\"Mon premier dossier EGE\")}</h2><p class=\"mb99-meta\">${esc(meta)}</p>\n ${d?`<div class=\"compact-legend\"><strong>Partie théorique</strong><strong>${progress}%</strong></div><div class=\"progress-track\" role=\"progressbar\" aria-label=\"Progression de la partie théorique\" aria-valuenow=\"${progress}\" aria-valuemin=\"0\" aria-valuemax=\"100\"><div class=\"progress-bar\" style=\"width:${progress}%\"></div></div>`:\"\"}\n <div class=\"feature-bottom\">${d?btn(\"Continuer mon travail\",\"opendoc\",\"btn primary\",\"arrow\",`data-id=\"${esc(d.id)}\"`):btn(\"Créer mon dossier\",\"newdoc\",\"btn primary\",\"plus\")}</div></section>\n <nav class=\"mb99-shortcuts\" aria-label=\"Accès rapides EGE\">${shortcut(\"Mes dossiers\",st.docs.length+\" dossier\"+(st.docs.length!==1?\"s\":\"\"),\"folder\",\"student-docs\")}${shortcut(\"Mon groupe\",groupNames.length>1?groupNames.length+\" classes\":groupNames[0]||\"Rejoindre\",\"users\",\"student-group\")}${shortcut(\"Partie terrain\",\"Enquête & synthèse\",\"monitor\",d?\"student-terrain\":\"student-docs\")}</nav>\n </div><section class=\"card mb99-reviews\"><div class=\"mb99-review-head\"><h2>Corrections <span>${rev.length}</span></h2>${btn(\"Tout voir\",\"goto\",\"mb99-see\",\"chevron\",'data-to=\"student-group-corrections\"')}</div>\n ${rev.length?rev.slice(0,3).map(correction).join(\"\"):`<p class=\"mb99-empty\">Aucune correction reçue.</p>`}</section></div></div>\n ${adBanner(\"student_home\")}`;\n}\nfunction docRows(){\n const docs=st.docs.filter(d=>docTitle(d).toLowerCase().includes(st.filter.toLowerCase()));\n if(!docs.length)return emptyCard(\"Aucun dossier trouvé. Créez votre premier dossier EGE.\");\n return docs.map(d=>`<div class=\"list-row ege-list-row\"><span class=\"row-icon red\">${I(\"file\")}</span><div class=\"row-content\"><strong>${esc(docTitle(d))}</strong><small>${esc(displayStudent(d))} · Modifié le ${shortDate(d.updated_at)}</small><div class=\"meta\">${badge(docProgress(d)+\" % terminé\",\"red\")}</div></div>\n <div class=\"inline-actions\">${btn(\"Ouvrir\",\"opendoc\",\"btn primary smol\",\"chevron\",`data-id=\"${d.id}\"`)}${btn(\"Archiver\",\"archive\",\"btn smol\",\"\",`data-id=\"${d.id}\"`)}</div></div>`).join(\"\");\n}\nfunction studentDocs(){\n return `${title(\"Mes documents\",\"Mes dossiers EGE\",\"Ouvrez, continuez ou créez un dossier sans perdre les travaux existants.\",btn(\"Nouveau dossier\",\"newdoc\",\"btn primary\",\"plus\"))}\n <div class=\"card\"><div class=\"mini-filter\"><div class=\"search\">${I(\"search\")}<input id=\"docSearch\" class=\"input\" placeholder=\"Rechercher un dossier\" value=\"${esc(st.filter)}\" aria-label=\"Rechercher un dossier\"></div>${badge(st.docs.length+\" dossier(s)\")}</div><div id=\"docsList\">${docRows()}</div></div>\n <p class=\"form-note\">Seuls les dossiers volontairement associés à un groupe sont accessibles à l'enseignant de ce groupe.</p>\n ${adBanner(\"student_docs\")}`;\n}\nfunction teacherPending(){\n return `${title(\"Espace enseignant\",\"Validation du compte\",\"L'accès aux classes nécessite l'approbation administrative.\")}\n <div class=\"card\" style=\"max-width:660px\"><div class=\"notice info\">${I(\"clock\")}<span>${st.teacher?.status===\"pending\"?\"Votre demande est enregistrée. Elle attend la validation de l'administrateur.\":st.teacher?.status===\"rejected\"?\"Votre demande a été refusée. Contactez l'administrateur.\":st.teacher?.status===\"suspended\"?\"Votre accès enseignant est suspendu.\":\"Le profil enseignant est incomplet. Complétez votre demande.\"}</span></div>\n ${st.teacher?.rejection_reason?`<p class=\"ege-feedback\">${esc(st.teacher.rejection_reason)}</p>`:\"\"}\n ${!st.teacher?`<p class=\"small muted\">Vérifiez votre nom et votre établissement dans votre inscription ou contactez l'administrateur.</p>`:\"\"}\n <div class=\"inline-actions\" style=\"margin-top:17px\">${btn(\"Actualiser\",\"refresh\",\"btn primary\",\"clock\")}${btn(\"Mon profil\",\"goto\",\"btn\",\"user\",'data-to=\"profile\"')}</div></div>`;\n}\nfunction studentWizard(){\n if(!st.draft)return `${title(\"Parcours guidé\",\"Créer mon dossier\",\"Commencez par créer un dossier personnel.\")}${box(btn(\"Nouveau dossier\",\"newdoc\",\"btn primary\",\"plus\"))}`;\n const p=st.draft,step=st.wizardStep,series=EGEAcademic.seriesOf(p),catalog=EGEAcademic.catalogFor(p,official),nSub=Number.isInteger(p.theme)?catalog[p.theme]?.subthemes||[]:[];\n const steps=[\"Identification\",\"Sujet\",\"Problématique\",\"Annexes\"];\n let content=\"\";\n if(step===1)content=`<label class=\"field\"><span>Travail</span><select class=\"select\" data-field=\"dMode\"><option value=\"individuel\" ${p.mode!==\"binome\"?\"selected\":\"\"}>Individuel</option><option value=\"binome\" ${p.mode===\"binome\"?\"selected\":\"\"}>Binôme</option></select></label>\n <label class=\"field\"><span>Nom du candidat</span><input class=\"input\" data-field=\"dStudent\" value=\"${esc(p.student||\"\")}\" placeholder=\"Votre nom et prénom\"></label>\n ${p.mode===\"binome\"?`<label class=\"field\"><span>Nom du binôme</span><input class=\"input\" data-field=\"dPartner\" value=\"${esc(p.partner||\"\")}\" placeholder=\"Nom du deuxième candidat\"></label>`:\"\"}\n <label class=\"field\"><span>Série</span><select id=\"dSeries\" class=\"select\" data-field=\"dSeries\">${EGEAcademic.options(EGEAcademic.series,series,\"Choisir une série\")}</select></label>\n <label class=\"field\"><span>Classe</span><select class=\"select\" data-field=\"dClass\">${EGEAcademic.options(EGEAcademic.classes[series],p.className,\"Choisir une classe\",true)}</select></label>\n <label class=\"field\"><span>Établissement</span><select class=\"select\" data-field=\"dSchool\">${EGEAcademic.options(EGEAcademic.schools,p.school,\"Choisir un établissement\",true)}</select></label>\n <label class=\"field\"><span>Enseignant encadrant${p.className==='Candidat libre'?' (facultatif)':''}</span><input class=\"input\" data-field=\"dTeacher\" value=\"${esc(p.teacher||\"\")}\" placeholder=\"Nom du professeur\"></label>`;\n if(step===2)content=catalog.length?`<label class=\"field\"><span>Thème officiel ${series} · 2026–2027</span><select class=\"select\" id=\"dTheme\" data-field=\"dTheme\"><option value=\"\">Choisir un thème</option>${catalog.map((x,i)=>`<option value=\"${i}\" ${p.theme===i?\"selected\":\"\"}>${esc((i+1)+\". \"+x.title)}</option>`).join(\"\")}</select></label>\n <label class=\"field\"><span>Sous-thème officiel</span><select class=\"select\" id=\"dSubtheme\" data-field=\"dSubtheme\"><option value=\"\">Choisir un sous-thème</option>${nSub.map((x,i)=>`<option value=\"${i}\" ${p.subtheme===i?\"selected\":\"\"}>${esc(x)}</option>`).join(\"\")}</select></label>\n <p class=\"small muted\">Les thèmes et sous-thèmes respectent le référentiel de l'Inspection du 3 novembre 2026.</p>`:`<div class=\"notice info\">Les thèmes et sous-thèmes officiels IAG 2026–2027 seront disponibles après réception du référentiel validé. Vous pouvez déjà renseigner votre identité.</div>`;\n if(step===3)content=`<label class=\"field\"><span>Ma problématique</span><textarea class=\"textarea\" data-field=\"dProblem\" rows=\"4\" placeholder=\"Quelle question souhaitez-vous étudier ?\">${esc(p.problem||\"\")}</textarea></label><div class=\"notice info\">${I(\"book\")}<span>Votre problématique doit être précise, courte et en rapport avec le sous-thème.</span></div>`;\n if(step===4)content=`<p class=\"small muted\">Préparez chaque annexe : titre, texte et source, puis vérifiez son aperçu.</p>${Array.from({length:p.mode===\"binome\"?4:3},(_,i)=>i+1).map(n=>`<div class=\"list-row\"><span class=\"row-icon red\">${I(\"file\")}</span><div class=\"row-content\"><strong>Annexe ${n} — ${esc(getTitle(n,p))}</strong><small>${cleaned(p.annexes?.[n])?\"Contenu rédigé\":\"À préparer\"} · ${cleaned(p.sources?.[n])?\"Source renseignée\":\"Source manquante\"}</small></div>${btn(\"Modifier\",\"annex\",\"btn smol\",\"edit\",`data-n=\"${n}\"`)}</div>`).join(\"\")}`;\n return `${title(\"Assistant EGE\",\"Mon étude guidée\",\"Une seule étape à la fois : vous pouvez revenir modifier votre travail.\",badge(step+\" / 4\",\"red\"))}\n <div class=\"stepper\">${steps.map((x,i)=>`<button class=\"step ${step===i+1?\"active\":step>i+1?\"done\":\"\"}\" data-act=\"wizard\" data-n=\"${i+1}\"><em>${step>i+1?\"✓\":i+1}</em>${x}</button>`).join(\"\")}</div>\n <div class=\"card\" style=\"max-width:770px\"><h2>${[\"\",\"Identifions votre dossier\",\"Choisissons votre sujet\",\"Rédigeons votre problématique\",\"Préparons vos annexes\"][step]}</h2>\n <div class=\"ege-forms\" style=\"margin-top:23px\">${content}</div>\n <div class=\"form-footer\">${step>1?btn(\"Précédent\",\"wizard-prev\",\"btn\",\"left\"):\"<span class='small muted'>Étape 1</span>\"}${step<4?btn(\"Valider et continuer\",\"wizard-next\",\"btn primary\",\"arrow\"):btn(\"Voir mes annexes\",\"goto\",\"btn primary\",\"arrow\",'data-to=\"student-annex\"')}</div></div>\n <div class=\"notice info\" style=\"margin-top:16px;max-width:770px\">${I(\"cloud\")}<span id=\"saveState\">${esc(st.saveBadge)}</span></div>`;\n}\nfunction annexPaper(n,p){\n return `<div class=\"paper\" id=\"paper\"><div class=\"paper-kicker\">EGE 2027 · ANNEXE ${n}</div>\n <h3 id=\"paperTitle\">${esc(getTitle(n,p))}</h3><div id=\"paperBody\" class=\"paper-text ege-paper-text\">${esc(p.annexes?.[n]||\"Le contenu apparaîtra ici.\")}</div>\n <div class=\"paper-source ege-source\"><strong>Source : </strong><span id=\"paperSource\">${esc(p.sources?.[n]||\"À renseigner\")}</span></div>\n <div class=\"paper-note\">Aperçu de lecture · contrôle pédagogique avant l'export Word</div></div>`;\n}\nfunction studentAnnex(){\n if(!st.draft)return `${title(\"Mes annexes\",\"Aucun dossier ouvert\",\"Choisissez d'abord un dossier dans Mes dossiers.\")}${box(btn(\"Mes dossiers\",\"goto\",\"btn primary\",\"folder\",'data-to=\"student-docs\"'))}`;\n const p=st.draft,n=st.annex,max=p.mode===\"binome\"?4:3;\n return `${title(\"Rédaction\",\"Mes annexes\",\"Copiez-collez votre texte, ajoutez sa source et contrôlez l'aperçu.\",btn(\"Enregistrer\",\"save\",\"btn primary\",\"check\"))}\n ${st.warning?`<p class=\"ege-feedback warn\">${esc(st.warning)} ${st.localCandidate?btn(\"Récupérer le brouillon\",\"restore-draft\",\"btn smol\"):\"\"}</p>`:\"\"}\n <div class=\"tabset\">${Array.from({length:max},(_,i)=>i+1).map(i=>`<button class=\"tab ${i===n?\"active\":\"\"}\" data-act=\"annex\" data-n=\"${i}\">Annexe ${i}</button>`).join(\"\")}</div>\n <div class=\"layout-editor\"><div class=\"card ege-forms\"><div class=\"card-head\"><h3>Modifier l'annexe ${n}</h3>${badge(p.sourceChecks?.[n]?\"Source vérifiée\":\"Source à vérifier\",p.sourceChecks?.[n]?\"green\":\"orange\")}</div>\n <label class=\"field\"><span>1. Titre de l'annexe</span><input class=\"input\" data-field=\"annex_title_${n}\" value=\"${esc(getTitle(n,p))}\" maxlength=\"190\"></label>\n <label class=\"field\"><span>2. Contenu (copier-coller autorisé)</span><textarea class=\"textarea tall\" data-field=\"annex_body_${n}\" placeholder=\"Collez ou rédigez votre texte. Séparez les paragraphes par une ligne vide.\">${esc(p.annexes?.[n]||\"\")}</textarea></label>\n <div class=\"compact-legend\"><span>Texte de l'annexe</span><span id=\"wordCount\">${(cleaned(p.annexes?.[n]).match(/\\S+/g)||[]).length} mots</span></div>\n <label class=\"field\"><span>3. Source documentaire (HTTPS)</span><textarea class=\"textarea\" style=\"min-height:86px\" data-field=\"annex_source_${n}\" placeholder=\"https://…\">${esc(p.sources?.[n]||\"\")}</textarea></label>${window.MBEgeAI?.sourceField(n,p)||''}\n <label class=\"small\" style=\"display:flex;gap:9px;align-items:center\"><input type=\"checkbox\" data-field=\"annex_checked_${n}\" ${p.sourceChecks?.[n]?\"checked\":\"\"}> J'ai réellement consulté et vérifié cette source.</label>\n <div class=\"form-footer\">${btn(\"Voir l'aperçu\",\"preview\",\"btn\",\"eye\")}${btn(\"Enregistrer\",\"save\",\"btn primary\",\"check\")}</div></div>\n <div class=\"section-stack\"><div class=\"textline\"><h3>Aperçu de l'annexe</h3>${badge(\"Lecture A4\",\"red\")}</div>${annexPaper(n,p)}\n <div class=\"inline-actions\">${btn(\"Ma partie terrain\",\"goto\",\"btn primary\",\"monitor\",'data-to=\"student-terrain\"')}${btn(\"Ouvrir le Word complet\",\"legacy\",\"btn\",\"download\")}</div>\n <p class=\"form-note\">L'enseignant voit cette présentation lorsque le dossier est associé à son groupe.</p></div></div>`;\n}\nfunction studentGroup(){\n const groups=st.groups,docs=st.docs,shared=st.shares,rows=st.reviews;\n return `${title(\"Mon espace élève\",\"Mon groupe et mes corrections\",\"Suivez votre classe, vos partages et les observations de votre professeur.\",badge(groups.length+\" groupe(s)\",\"red\"))}\n <div class=\"layout-side\"><div class=\"section-stack\">\n ${groups.map(g=>`<div class=\"card\"><div class=\"card-head\"><div><h2>${esc(g.name)}</h2><p class=\"small muted\">${esc(g.school||\"Établissement non renseigné\")}</p></div>${badge(g.suspended_at?\"Groupe suspendu\":\"Inscrit\",g.suspended_at?\"orange\":\"green\")}</div>\n <p class=\"small\">Dossiers associés : ${st.shares.filter(x=>x.group_id===g.id).length}</p>\n ${st.shares.filter(x=>x.group_id===g.id).map(x=>`<div class=\"list-row\"><span class=\"row-icon\">${I(\"folder\")}</span><div class=\"row-content\"><strong>${esc(docTitle(entityDoc(x.dossier_id)))}</strong><small>Les mises à jour sauvegardées sont visibles par cet enseignant.</small></div></div>`).join(\"\")}\n ${btn(\"Quitter le groupe\",\"leave\",\"btn smol\",\"\",`data-id=\"${g.id}\"`)}</div>`).join(\"\")}\n <div class=\"card\"><h3>Rejoindre un groupe</h3><form id=\"groupJoinForm\"><label class=\"field\"><span>Code transmis par le professeur</span><input class=\"input\" id=\"joinCode\" placeholder=\"Code du groupe\" maxlength=\"20\" required></label><button type=\"submit\" class=\"btn primary\">${I(\"users\")} Rejoindre</button></form></div>\n ${groups.some(g=>!g.suspended_at&&!g.deleted_at)&&docs.length?`<div class=\"card\"><h3>Associer un dossier à une classe</h3><p class=\"small muted\">Cette association se fait avec votre accord initial et reste active pour les sauvegardes futures.</p>\n <form id=\"groupShareForm\"><label class=\"field\"><span>Groupe</span><select class=\"select\" id=\"shareGroup\">${groups.filter(g=>!g.suspended_at&&!g.deleted_at).map(g=>`<option value=\"${g.id}\">${esc(g.name)}</option>`).join(\"\")}</select></label>\n <label class=\"field\"><span>Dossier</span><select class=\"select\" id=\"shareDoc\">${docs.map(d=>`<option value=\"${d.id}\">${esc(docTitle(d))}</option>`).join(\"\")}</select></label><button type=\"submit\" class=\"btn primary\">${I(\"check\")} Associer ce dossier</button></form></div>`:\"\"}\n </div><div class=\"card\"><div class=\"card-head\"><h3>Corrections reçues</h3>${badge(rows.length+\" avis\")}</div>${reviewList(rows)}</div></div>\n ${adBanner(\"student_group\")}`;\n}\nfunction teacherHome(){\n if(st.teacher?.status!==\"approved\")return teacherPending();\n const count=st.members.length,assigned=st.docs.length;\n return `${title(\"Espace enseignant\",\"Bonjour \"+vGreeting(),\"Retrouvez vos groupes et les travaux associés.\",btn(\"Mes groupes\",\"goto\",\"btn primary\",\"users\",'data-to=\"teacher-groups\"'))}\n <div class=\"grid3\" style=\"margin-bottom:18px\">${stat(\"Groupes actifs\",st.groups.filter(g=>g.active&&!g.suspended_at&&!g.deleted_at).length,\"users\")}${stat(\"Élèves inscrits\",count,\"cap\")}${stat(\"Dossiers associés\",assigned,\"file\")}</div>\n <div class=\"layout-side\"><div class=\"card\"><div class=\"card-head\"><h3>Mes classes</h3>${badge(st.groups.length+\" groupe(s)\")}</div>${st.groups.length?st.groups.map(g=>`<div class=\"list-row\"><span class=\"row-icon red\">${I(\"users\")}</span><div class=\"row-content\"><strong>${esc(g.name)}</strong><small>${esc(g.school)} · ${st.members.filter(m=>m.group_id===g.id).length} élève(s)</small></div>${btn(\"Ouvrir\",\"teacher-select\",\"btn smol\",\"arrow\",`data-id=\"${g.id}\"`)}</div>`).join(\"\"):emptyCard(\"Aucun groupe : créez une classe pour commencer.\")}\n <div class=\"form-footer\">${btn(\"Créer un groupe\",\"teacher-create\",\"btn primary\",\"plus\")}</div></div>\n <div class=\"card\"><div class=\"card-head\"><h3>Derniers avis</h3>${badge(st.reviews.length+\" correction(s)\")}</div>${reviewList(st.reviews.slice(0,5))}</div></div>\n ${teacherAdPanel()}`;\n}\nfunction teacherGroups(){\n if(st.teacher?.status!==\"approved\")return teacherPending();\n return `${title(\"Encadrement\",\"Mes groupes\",\"Un code par classe, avec des dossiers visibles uniquement après association.\",btn(\"Nouveau groupe\",\"teacher-create\",\"btn primary\",\"plus\"))}\n ${st.teacherOpen?`<div class=\"card\" style=\"margin-bottom:17px\"><h3>Créer une classe</h3><form id=\"teacherNewGroupForm\"><label class=\"field\"><span>Nom du groupe</span><select id=\"groupName\" class=\"select\" required>${EGEAcademic.allClassOptions()}</select></label><label class=\"field\"><span>Établissement</span><select id=\"groupSchool\" class=\"select\" required>${EGEAcademic.options(EGEAcademic.schools,st.teacher?.school,\"Choisir un établissement\",true)}</select></label><button class=\"btn primary\" type=\"submit\">Créer le groupe</button></form></div>`:\"\"}\n ${st.groups.length?st.groups.map(g=>`<section class=\"card\"><div class=\"card-head\"><div><h2>${esc(g.name)}</h2><p class=\"small muted\">${esc(g.school||\"—\")}</p></div>${badge(g.suspended_at?\"Suspendu\":g.active?\"Actif\":\"Inscriptions fermées\",g.suspended_at||!g.active?\"orange\":\"green\")}</div>\n <div class=\"codebox\"><div><small>Code de la classe</small><strong>${esc(g.join_code)}</strong></div><div class=\"inline-actions\">${btn(\"Copier\",\"copy\",\"btn smol\",\"copy\",`data-code=\"${esc(g.join_code)}\"`)}${g.active&&!g.suspended_at&&!g.deleted_at?`<button type=\"button\" class=\"btn smol\" data-study=\"invite\" data-id=\"${g.id}\">Inviter</button>`:''}</div></div>\n ${g.suspended_at?'<p class=\"notice info\">Ce groupe est suspendu par l’administration. Les inscriptions, les partages et les corrections sont indisponibles.</p>':`<div class=\"grid2\" style=\"margin:18px 0\">${stat(\"Élèves inscrits\",st.members.filter(m=>m.group_id===g.id).length,\"users\")}${stat(\"Dossiers associés\",st.shares.filter(x=>x.group_id===g.id).length,\"folder\")}</div>\n <div class=\"inline-actions\">${btn(\"Voir les élèves\",\"teacher-select\",\"btn primary\",\"users\",`data-id=\"${g.id}\"`)}${btn(\"Renommer\",\"group-rename\",\"btn\",\"edit\",`data-id=\"${g.id}\"`)}${btn(g.active?\"Fermer inscriptions\":\"Réactiver\",\"group-toggle\",\"btn\",\"\",`data-id=\"${g.id}\"`)}</div>`}</section>`).join(\"\"):box(emptyCard(\"Aucun groupe créé pour le moment.\"))}`;\n}\nfunction teacherStudents(){\n if(st.teacher?.status!==\"approved\")return teacherPending();\n const g=currentGroup(),ms=st.members.filter(m=>m.group_id===st.selectedGroupId);\n return `${title(\"Suivi des élèves\",g?.name||\"Mes élèves\",\"Consultez les dossiers associés à votre groupe et gérez les inscriptions.\",btn(\"Mes groupes\",\"goto\",\"btn\",\"left\",'data-to=\"teacher-groups\"'))}\n <div class=\"card\"><div class=\"card-head\"><h3>${esc(g?.school||\"Groupe non sélectionné\")}</h3>${badge(ms.length+\" élève(s)\")}</div>\n ${ms.length?ms.map(m=>{const shares=st.shares.filter(s=>s.group_id===m.group_id&&s.student_id===m.student_id),docs=shares.map(s=>entityDoc(s.dossier_id)).filter(Boolean);\n return `<div class=\"list-row\"><span class=\"avatar\">${esc((m.student_name||\"E\").slice(0,1))}</span><div class=\"row-content\"><strong>${esc(m.student_name||\"Élève\")}</strong><small>${docs.length} dossier(s) associé(s) · Inscrit le ${shortDate(m.joined_at)}</small></div>\n <div class=\"inline-actions\">${docs.map(d=>btn(\"Consulter : \"+docTitle(d),\"teacher-review\",\"btn smol\",\"file\",`data-id=\"${d.id}\"`)).join(\"\")}${btn(\"Retirer\",\"remove-student\",\"btn smol\",\"trash\",`data-group=\"${m.group_id}\" data-id=\"${m.student_id}\"`)}</div></div>`}).join(\"\"):emptyCard(\"Aucun élève inscrit dans ce groupe. Transmettez le code d'inscription.\")}\n </div>`;\n}\nfunction teacherReview(){\n const d=currentTeacherDoc();\n if(st.teacher?.status!==\"approved\")return teacherPending();\n if(!d)return `${title(\"Relecture\",\"Dossiers à corriger\",\"Sélectionnez un dossier associé à votre groupe.\")}\n ${box(st.docs.length?st.docs.map(d=>`<div class=\"list-row\"><span class=\"row-icon red\">${I(\"file\")}</span><div class=\"row-content\"><strong>${esc(docTitle(d))}</strong><small>${esc(displayStudent(d))}</small></div>${btn(\"Lire\",\"teacher-review\",\"btn primary smol\",\"arrow\",`data-id=\"${d.id}\"`)}</div>`).join(\"\"):emptyCard(\"Aucun dossier associé pour le moment.\"))}`;\n const p=d.payload||{},n=st.reviewAnnex,max=p.mode===\"binome\"?4:3,rev=st.reviews.filter(r=>r.dossier_id===d.id);\n return `${title(\"Suivi pédagogique\",displayStudent(d)+\" · Dossier EGE\",\"Consultez le travail complet et transmettez vos observations.\",badge(\"Dossier associé\",\"green\"))}\n <div class=\"layout-editor\"><div class=\"section-stack\"><div class=\"card\"><h3>${esc(docTitle(d))}</h3>\n <div class=\"meta\">${esc(p.className||\"Classe non renseignée\")} · ${esc(p.school||\"Établissement non renseigné\")}</div>\n ${p.problem?`<p class=\"small\" style=\"margin-top:14px\"><strong>Problématique : </strong>${esc(p.problem)}</p>`:\"\"}\n </div><div class=\"tabset\">${Array.from({length:max},(_,i)=>i+1).map(i=>`<button class=\"tab ${i===n?\"active\":\"\"}\" data-act=\"teacher-annex\" data-n=\"${i}\">Annexe ${i}</button>`).join(\"\")}</div>\n ${annexPaper(n,p)}<details class=\"card\"><summary><strong>Lire la partie terrain du dossier</strong></summary>${EGETerrain.preview(p)}</details></div>\n <div class=\"section-stack\"><div class=\"card ege-forms\"><h3>Évaluer le travail</h3>\n <label class=\"field\"><span>Travail concerné</span><select id=\"reviewAnnex\" class=\"select\"><option value=\"\">Dossier complet</option>${Array.from({length:max},(_,i)=>i+1).map(i=>`<option value=\"${i}\" ${i===n?\"selected\":\"\"}>Annexe ${i}</option>`).join(\"\")}</select></label>\n <label class=\"field\"><span>Votre observation</span><textarea id=\"teacherComment\" class=\"textarea\" rows=\"5\" placeholder=\"Précisez les points à corriger ou le motif de validation.\"></textarea></label>\n <div class=\"inline-actions\">${btn(\"Valider\",\"review\",\"btn primary\",\"check\",`data-id=\"${d.id}\" data-decision=\"valide\"`)}${btn(\"Demander une correction\",\"review\",\"btn\",\"edit\",`data-id=\"${d.id}\" data-decision=\"a_corriger\"`)}</div></div>\n <div class=\"card\"><div class=\"card-head\"><h3>Historique des corrections</h3>${badge(rev.length+\" avis\")}</div>${reviewList(rev)}</div></div></div>`;\n}\nfunction adminHome(){\n return `${title(\"Administration\",\"Vue générale\",\"Suivez les dossiers, les enseignants et les groupes de la plateforme.\",badge(\"Super-administrateur\",\"red\")+btn(\"Groupes et élèves\",\"goto\",\"btn primary\",\"users\",'data-to=\"admin-groups\"'))}\n <div class=\"grid4\" style=\"margin-bottom:20px\">${stat(\"Dossiers\",st.docs.length,\"file\")}${stat(\"Enseignants\",st.requests.length,\"cap\")}${stat(\"Groupes\",st.groups.length,\"users\")}${stat(\"Corrections\",st.reviews.length,\"check\")}</div>\n <div class=\"layout-side\"><div class=\"card\"><div class=\"card-head\"><h3>Demandes des enseignants</h3>${badge(st.requests.filter(r=>r.status===\"pending\").length+\" en attente\",\"orange\")}</div>\n ${st.requests.length?st.requests.slice(0,6).map(r=>`<div class=\"list-row\"><span class=\"avatar\">${esc((r.full_name||\"P\").slice(0,1))}</span><div class=\"row-content\"><strong>${esc(r.full_name)}</strong><small>${esc(r.school)} · ${esc(r.status)}</small></div>\n <div class=\"inline-actions\">${r.status!==\"approved\"?btn(\"Approuver\",\"request-status\",\"btn primary smol\",\"check\",`data-id=\"${r.user_id}\" data-status=\"approved\"`):btn(\"Suspendre\",\"request-status\",\"btn smol\",\"\",`data-id=\"${r.user_id}\" data-status=\"suspended\"`)}</div></div>`).join(\"\"):emptyCard(\"Aucune demande d'enseignant.\")}\n <div class=\"form-footer\">${btn(\"Gérer les utilisateurs\",\"goto\",\"btn\",\"users\",'data-to=\"admin-users\"')}</div></div>\n <div class=\"card\"><div class=\"card-head\"><h3>Dernières opérations</h3>${badge(st.audit.length+\" entrées\")}</div>\n ${st.audit.length?st.audit.slice(0,5).map(a=>`<div class=\"list-row\"><span class=\"row-icon\">${I(\"clock\")}</span><div class=\"row-content\"><strong>${esc(a.entity_type.replace(\"ege2027_\",\"\"))}</strong><small>${esc(a.action)} · ${longDate(a.created_at)}</small></div></div>`).join(\"\"):emptyCard(\"Aucune opération enregistrée.\")}\n ${btn(\"Journal et sécurité\",\"goto\",\"btn ghost smol\",\"arrow\",'data-to=\"admin-monitor\"')}</div></div>`;\n}\nfunction adminUsers(){\n return `${title(\"Administration\",\"Gestion des utilisateurs\",\"Approuvez ou suspendez les enseignants, sans accéder aux mots de passe.\",btn(\"Actualiser\",\"refresh\",\"btn primary\",\"clock\"))}\n <div class=\"card\"><div class=\"card-head\"><h3>Enseignants</h3>${badge(st.requests.length+\" demande(s)\")}</div>\n ${st.requests.length?st.requests.map(r=>`<div class=\"list-row\"><span class=\"avatar\">${esc((r.full_name||\"P\").slice(0,1))}</span><div class=\"row-content\"><strong>${esc(r.full_name||\"Professeur\")}</strong><small>${esc(r.school||\"—\")} · Demande du ${shortDate(r.created_at)}</small></div><div class=\"inline-actions\">\n ${badge(r.status,r.status===\"approved\"?\"green\":r.status===\"pending\"?\"orange\":\"red\")}\n ${r.status!==\"approved\"?btn(\"Approuver\",\"request-status\",\"btn primary smol\",\"check\",`data-id=\"${r.user_id}\" data-status=\"approved\"`):btn(\"Suspendre\",\"request-status\",\"btn smol\",\"\",`data-id=\"${r.user_id}\" data-status=\"suspended\"`)}\n ${r.status===\"pending\"?btn(\"Refuser\",\"request-status\",\"btn smol\",\"\",`data-id=\"${r.user_id}\" data-status=\"rejected\"`):\"\"}\n </div></div>`).join(\"\"):emptyCard(\"Aucune inscription enseignant pour le moment.\")}</div>\n <div class=\"notice info\" style=\"margin-top:18px\">${I(\"shield\")}<span>Les profils élèves sont visibles via leurs groupes et leurs dossiers autorisés. Aucun mot de passe n'est accessible à l'administrateur.</span></div>`;\n}\nfunction adminGroups(){\n const groups=st.groups;\n return `${title(\"Administration\",\"Groupes et établissements\",\"Gestion des classes et affectations.\",btn(\"Créer un groupe\",\"admin-create\",\"btn primary\",\"plus\"))}\n ${st.adminOpen?`<div class=\"card\" style=\"margin-bottom:15px\"><h3>Nouveau groupe</h3><form id=\"adminNewGroupForm\" class=\"ege-forms\">\n <label class=\"field\"><span>Enseignant approuvé</span><select id=\"adminTeacher\" class=\"select\" required>${st.requests.filter(x=>x.status===\"approved\").map(r=>`<option value=\"${r.user_id}\">${esc(r.full_name)}</option>`).join(\"\")}</select></label>\n <label class=\"field\"><span>Nom de la classe</span><select id=\"adminGroupName\" class=\"select\" required>${EGEAcademic.allClassOptions()}</select></label>\n <label class=\"field\"><span>Établissement</span><select id=\"adminGroupSchool\" class=\"select\" required>${EGEAcademic.options(EGEAcademic.schools,\"\",\"Choisir un établissement\")}</select></label>\n <button type=\"submit\" class=\"btn primary\">Créer</button></form></div>`:\"\"}\n ${groups.length?groups.map(g=>`<div class=\"card\"><div class=\"card-head\"><div><h3>${esc(g.name)}</h3><p class=\"small muted\" style=\"margin:0\">${esc(g.school||\"—\")}</p></div>${badge(g.active?\"Actif\":\"Inscriptions fermées\",g.active?\"green\":\"orange\")}</div>\n <div class=\"codebox\"><div><small>Code de classe</small><strong>${esc(g.join_code)}</strong></div>${btn(\"Copier\",\"copy\",\"btn smol\",\"copy\",`data-code=\"${esc(g.join_code)}\"`)}</div>\n <div class=\"list-row\"><span class=\"row-icon red\">${I(\"users\")}</span><div class=\"row-content\"><strong>${st.members.filter(m=>m.group_id===g.id).length} élève(s) inscrit(s)</strong><small>${st.shares.filter(x=>x.group_id===g.id).length} dossier(s) associé(s)</small></div></div>\n <div class=\"inline-actions\">${btn(\"Renommer\",\"group-rename\",\"btn smol\",\"edit\",`data-id=\"${g.id}\"`)}${btn(g.active?\"Fermer le code\":\"Réactiver\",\"group-toggle\",\"btn smol\",\"\",`data-id=\"${g.id}\"`)}</div>\n ${st.members.filter(m=>m.group_id===g.id).map(m=>`<div class=\"list-row\"><span class=\"avatar\">${esc((m.student_name||\"E\")[0])}</span><div class=\"row-content\"><strong>${esc(m.student_name||\"Élève\")}</strong></div>${btn(\"Retirer\",\"remove-student\",\"btn smol\",\"trash\",`data-group=\"${g.id}\" data-id=\"${m.student_id}\"`)}</div>`).join(\"\")}\n </div>`).join(\"\"):box(emptyCard(\"Aucun groupe créé.\"))}`;\n}\nfunction adminMonitor(){\n const tab=st.adminTab;\n return `${title(\"Supervision\",\"Dossiers, statistiques et sécurité\",\"Contrôlez les travaux et les paramètres généraux.\",badge(\"Accès administrateur\",\"red\"))}\n <div class=\"tabset\">${[[\"dossiers\",\"Dossiers\"],[\"stats\",\"Statistiques\"],[\"security\",\"Sécurité\"],[\"ads\",\"Publicités\"],[\"pricing\",\"Tarifs et paiements\"],[\"preview\",\"Lire un dossier\"]].map(([id,label])=>`<button class=\"tab ${tab===id?\"active\":\"\"}\" data-act=\"admin-tab\" data-mode=\"${id}\">${label}</button>`).join(\"\")}</div>\n ${tab===\"dossiers\"?`<div class=\"card\"><div class=\"card-head\"><h3>Dossiers enregistrés</h3>${badge(st.docs.length+\" dossier(s)\")}</div>\n ${st.docs.length?st.docs.map(d=>`<div class=\"list-row\"><span class=\"row-icon red\">${I(\"file\")}</span><div class=\"row-content\"><strong>${esc(docTitle(d))}</strong><small>${esc(displayStudent(d))} · ${shortDate(d.updated_at)}</small></div>${btn(\"Consulter\",\"admin-read\",\"btn primary smol\",\"eye\",`data-id=\"${d.id}\"`)}</div>`).join(\"\"):emptyCard(\"Aucun dossier.\")}</div>`:tab===\"stats\"?`<div class=\"grid3\">${stat(\"Dossiers\",st.docs.length,\"file\")}${stat(\"Élèves en groupe\",new Set(st.members.map(m=>m.student_id)).size,\"users\")}${stat(\"Enseignants\",st.requests.length,\"cap\")}</div><div class=\"card\" style=\"margin-top:15px\"><h3>Statistiques réelles</h3><p class=\"muted small\">Comptages calculés à partir des lignes visibles à l'administrateur (pagination limitée).</p></div>`:tab===\"security\"?`<div class=\"layout-side\">\n <div class=\"card\"><h3>Paramètres généraux</h3><label class=\"field\"><span>Année scolaire</span><input class=\"input\" id=\"settingsYear\" value=\"${esc(st.settings?.academic_year||\"2026–2027\")}\"></label><label class=\"field\"><span>Message aux élèves</span><textarea class=\"textarea\" id=\"settingsMessage\">${esc(st.settings?.student_message||\"\")}</textarea></label>${btn(\"Enregistrer les paramètres\",\"save-settings\",\"btn primary\",\"check\")}</div>\n <div class=\"card\"><h3>Historique des actions</h3>${st.audit.length?st.audit.map(a=>`<div class=\"list-row\"><span class=\"row-icon\">${I(\"clock\")}</span><div class=\"row-content\"><strong>${esc(a.action+\" · \"+a.entity_type.replace(\"ege2027_\",\"\"))}</strong><small>${longDate(a.created_at)}</small></div></div>`).join(\"\"):emptyCard(\"Aucune opération enregistrée.\")}</div></div>`:tab===\"ads\"?egeAdminAdPanel():tab===\"pricing\"?adminPricingPanel():\n (()=>{const d=currentDoc();if(!d)return box(emptyCard(\"Sélectionnez un dossier dans l'onglet Dossiers.\"));\n const p=d.payload||{},len=p.mode===\"binome\"?4:3;\n return `<div class=\"card\"><h3>${esc(docTitle(d))} · ${esc(displayStudent(d))}</h3>${p.problem?`<p>${esc(p.problem)}</p>`:\"\"}\n ${Array.from({length:len},(_,i)=>i+1).map(n=>`<details class=\"card\" style=\"margin-top:14px\" ${n===1?\"open\":\"\"}><summary><strong>Annexe ${n} — ${esc(getTitle(n,p))}</strong></summary>${annexPaper(n,p)}</details>`).join(\"\")}\n <details class=\"card\"><summary><strong>Partie terrain</strong></summary>${EGETerrain.preview(p)}</details>\n <div class=\"form-footer\">${btn(\"Retour aux dossiers\",\"admin-tab\",\"btn\",\"left\",'data-mode=\"dossiers\"')}</div></div>`})()}`;\n}\nfunction studentProfilePanel(){\n const meta=st.user?.user_metadata||{},series=EGEAcademic.seriesOf(meta);\n return `<section class=\"card\" style=\"margin-bottom:20px;max-width:770px\"><h2>Ma scolarité</h2><p class=\"small muted\">Ces informations seront reprises dans vos nouveaux dossiers. Les dossiers existants conservent leur série et leur sujet.</p><form id=\"studentProfileForm\" class=\"ege-forms\">\n <label class=\"field\"><span>Série</span><select id=\"profileSeries\" class=\"select\" required>${EGEAcademic.options(EGEAcademic.series,series,\"Choisir une série\")}</select></label>\n <label class=\"field\"><span>Classe</span><select id=\"profileClass\" class=\"select\" required>${EGEAcademic.options(EGEAcademic.classes[series],meta.class_name,\"Choisir une classe\")}</select></label>\n <label class=\"field\"><span>Établissement</span><select id=\"profileSchool\" class=\"select\" required>${EGEAcademic.options(EGEAcademic.schools,meta.school,\"Choisir un établissement\")}</select></label>\n <button class=\"btn primary\" type=\"submit\">Enregistrer ma scolarité</button></form></section>`;\n}\nfunction profile(){\n const who=st.user,role={eleve:\"Élève\",enseignant:\"Enseignant\",admin:\"Super-administrateur\"}[st.role];\n return `${title(\"Mon compte\",\"Profil et paramètres\",\"Retrouvez les informations de votre compte et vos options de travail.\")}\n ${egeFreeNotice()}${st.role===\"eleve\"?studentProfilePanel():\"\"}\n <div class=\"layout-side\"><div class=\"card\"><div class=\"card-head\"><h3>Mon compte</h3>${badge(role,\"red\")}</div>\n <div class=\"list-row\"><span class=\"avatar\">${esc((vGreeting()||\"U\")[0].toUpperCase())}</span><div class=\"row-content\"><strong>${esc(vGreeting())}</strong><small>${esc(who?.email||\"—\")}</small></div></div>\n <div class=\"list-row\"><span class=\"row-icon red\">${I(\"shield\")}</span><div class=\"row-content\"><strong>Accès sécurisé</strong><small>Vos accès sont protégés.</small></div></div>\n <div class=\"inline-actions\" style=\"margin-top:17px\">${btn(\"Se déconnecter\",\"logout\",\"btn primary\",\"logout\")}${btn(\"Actualiser\",\"refresh\",\"btn\",\"clock\")}</div></div>\n <div class=\"card\"><h3>Mon travail</h3><div class=\"ege-actions\" style=\"margin-bottom:14px\">${btn(\"Installer l’application\",\"install\",\"btn primary\",\"download\")}</div>${st.role===\"eleve\"?`<p class=\"small muted\">Synchronisation actuelle : ${esc(st.saveBadge)}</p>${btn(\"Mes dossiers\",\"goto\",\"btn\",\"folder\",'data-to=\"student-docs\"')}${currentDoc()?btn(\"Exporter / Word\",\"legacy\",\"btn primary\",\"download\"):\"\"}`:\n st.role===\"enseignant\"?`<p class=\"small muted\">${esc(st.teacher?.status===\"approved\"?\"Compte enseignant approuvé.\":\"Validation en attente.\")}</p>${btn(\"Mes groupes\",\"goto\",\"btn primary\",\"users\",'data-to=\"teacher-groups\"')}`:btn(\"Superviser les comptes\",\"goto\",\"btn primary\",\"users\",'data-to=\"admin-users\"')}\n <hr class=\"subtle-divider\"><p class=\"small muted\">Les mots de passe ne sont jamais consultables par l'administrateur. Pour changer votre mot de passe, utilisez le lien de récupération.</p>\n ${btn(\"Récupération du mot de passe\",\"mode\",\"btn smol\",\"lock\",'data-mode=\"forgot\"')}</div></div>`;\n}\nfunction view(){\n switch(st.screen){\n  case\"welcome\":return welcome();case\"pricing\":return pricingPage();case\"auth\":return auth();case\"ads-directory\":return egeAdsDirectory();\n  case\"student-home\":return studentHome();case\"student-terrain\":return terrainPage();case\"student-docs\":return studentDocs();case\"student-wizard\":return studentWizard();case\"student-annex\":return studentAnnex();case\"student-group\":return studentGroup();\n  case\"teacher-home\":return teacherHome();case\"teacher-groups\":return teacherGroups();case\"teacher-students\":return teacherStudents();case\"teacher-review\":return teacherReview();\n  case\"admin-home\":return adminHome();case\"admin-users\":return adminUsers();case\"admin-groups\":return adminGroups();case\"admin-monitor\":return adminMonitor();case\"profile\":return profile();\n  default:return welcome();\n }\n}\nfunction render(){\n const host=$(\"app\");if(!host)return;\n host.className=\"app\"+((st.screen===\"welcome\"||st.screen===\"auth\"||st.screen===\"ads-directory\"||(st.screen===\"pricing\"||st.screen===\"privacy\"||st.screen===\"student-class-start\"||st.screen===\"student-enrollment\"||st.screen===\"account-recovery\"||st.screen===\"teacher-enrollment\"))?\" ege-intro-app\":\"\");\n const intro=st.screen===\"welcome\"||st.screen===\"auth\"||st.screen===\"ads-directory\"||(st.screen===\"pricing\"||st.screen===\"privacy\"||st.screen===\"student-class-start\"||st.screen===\"student-enrollment\"||st.screen===\"account-recovery\"||st.screen===\"teacher-enrollment\");\n host.innerHTML=renderHeader()+`<div class=\"app-body\">${intro?\"\":menu()}<main class=\"main ${intro?(st.screen===\"welcome\"?\"intro-main\":\"login-main\"):\"\"}\" id=\"content\"><section class=\"screen\">${feedback()}${view()}${EGEHeader.footer({showPrivacy:st.screen!==\"privacy\"})}</section></main></div>${intro?\"\":bottomNav()}\n <dialog id=\"egeInstallDialog\" class=\"ege-install-dialog\" aria-labelledby=\"egeInstallTitle\">\n  <div class=\"ege-install-dialog-head\"><h2 id=\"egeInstallTitle\">Installer EGE 2027</h2><button type=\"button\" class=\"ege-install-close\" data-act=\"close-install\" aria-label=\"Fermer\">${I(\"plus\")}</button></div>\n  <p id=\"egeInstallInstructions\" class=\"ege-install-instructions\"></p>\n  <button type=\"button\" class=\"btn primary full\" data-act=\"close-install\">Compris</button>\n </dialog>${egeAdDialogHTML()}`;\n refreshInstallButtons();\n egeStartAdCarousel();\n refreshTerrainImages();\n window.EGEHeader?.refresh();\n}\n\nfunction egeFreeNotice(){return ''}\nfunction pricingPage(){\n const p=egePricing();\n const offers=[['Compte élève',egeFDJ(p.student_monthly_fdj),'par mois'],['Compte enseignant','Gratuit',''],['Annonce Premium',egeFDJ(p.premium_weekly_fdj),'par semaine'],['Annonce Premium',egeFDJ(p.premium_monthly_fdj),'par mois'],['Annonce classique',egeFDJ(p.standard_ad_fdj),'par annonce']];\n return `<div style=\"max-width:900px;margin:auto\">${title('Informations','Tarifs prévus','Les abonnements et paiements intégrés sont désactivés.')}\n <section class=\"card\"><h2>Tarifs prévus pour plus tard</h2><p class=\"small muted\" id=\"futureFeesNote\">Ces tarifs sont inactifs et pourront être modifiés par l’administration avant une éventuelle activation. Le compte enseignant est gratuit.</p>\n ${st.pricingError?`<p role=\"status\">${esc(st.pricingError)} Les montants ci-dessous sont les tarifs de préparation initiaux.</p>`:''}\n <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:14px;margin:20px 0;color:#626b78\" aria-describedby=\"futureFeesNote\">${offers.map(([name,price,period])=>`<div style=\"background:#f1f3f5;border:1px solid #d8dde3;border-radius:14px;padding:20px\"><h3>${name}</h3><p style=\"font-size:25px;font-weight:800;margin:12px 0 4px\">${price}</p><p class=\"small\">${period||'Compte gratuit'}</p><span class=\"badge\">${name==='Compte enseignant'?'Gratuit':'Tarif inactif'}</span></div>`).join('')}</div>\n <fieldset disabled style=\"border:0;padding:0;margin:20px 0 0\"><legend style=\"font-weight:700;margin-bottom:10px\">Paiement désactivé</legend><label class=\"field\"><span>Moyen de paiement futur</span><select class=\"select\" aria-label=\"Moyens de paiement désactivés\"><option>${p.payment_methods?.length?'Choisir un moyen (indisponible)':'Moyens de paiement à configurer'}</option>${(p.payment_methods||[]).map(method=>`<option>${esc(method)}</option>`).join('')}</select></label><button class=\"btn\" type=\"button\" disabled aria-disabled=\"true\">Paiements désactivés</button></fieldset>\n ${p.payment_instructions?`<details style=\"margin-top:16px;color:#626b78\"><summary>Consignes préparées pour une activation future</summary><p style=\"white-space:pre-wrap\">${esc(p.payment_instructions)}</p></details>`:''}\n <p class=\"small muted\" style=\"margin-top:20px\">Les annonces restent soumises à la validation administrative, à chaque publication.</p></section>\n <div style=\"margin-top:18px\">${btn(st.user?'Retour à mon espace':'Retour à l’accueil','goto','btn','left','data-to=\"'+(st.user?homes[st.role]:'welcome')+'\"')}</div></div>`;\n}\nfunction adminPricingPanel(){\n if(st.role!=='admin')return '';\n const p=egePricing(),fields=[['student_monthly_fdj','Élève — par mois'],['premium_weekly_fdj','Premium — par semaine'],['premium_monthly_fdj','Premium — par mois'],['standard_ad_fdj','Annonce classique — par annonce']];\n return `<section class=\"card\" style=\"max-width:780px\"><h2>Tarifs et paiements futurs</h2>${egeFreeNotice()}<p class=\"small\">Vous pouvez modifier les tarifs et préparer les modalités. Leur enregistrement ne met pas fin à la gratuité.</p>${st.pricingError?`<p role=\"alert\">${esc(st.pricingError)} Actualisez avant de modifier les montants.</p>`:''}\n <form id=\"pricingAdminForm\" class=\"ege-forms\"><p><strong>Compte enseignant : gratuit.</strong></p>${fields.map(([key,label])=>`<label class=\"field\"><span>${label} (FDJ)</span><input class=\"input\" type=\"number\" id=\"fee_${key}\" min=\"0\" max=\"100000000\" step=\"1\" required value=\"${p[key]}\"></label>`).join('')}\n <label class=\"field\"><span>Moyens de paiement futurs — un par ligne, cinq maximum</span><textarea class=\"textarea\" id=\"fee_payment_methods\" rows=\"3\" maxlength=\"404\" placeholder=\"À renseigner avant l’activation\">${esc((p.payment_methods||[]).join('\\n'))}</textarea></label>\n <label class=\"field\"><span>Consignes de paiement futures (facultatif)</span><textarea class=\"textarea\" id=\"fee_payment_instructions\" maxlength=\"1200\" rows=\"4\" placeholder=\"Modalités et références à communiquer lors d’une activation future\">${esc(p.payment_instructions||'')}</textarea></label>\n <button type=\"submit\" class=\"btn primary\" ${st.pricingError?'disabled':''}>Enregistrer les tarifs futurs</button><p class=\"small muted\">La monétisation est désactivée. Aucun paiement ne peut être encaissé depuis cet écran. Son activation nécessitera votre décision ultérieure.</p></form></section>`;\n}\n"],"/portail.html":["text/html; charset=utf-8",false,"<!doctype html><html lang=\"fr\"><head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#c8102e\">\n<meta name=\"description\" content=\"EGE 2027 · Études de Gestion Encadrées pour les élèves et les enseignants.\">\n<title>EGE 2027 — Études de Gestion Encadrées</title><link rel=\"manifest\" href=\"./manifest-ege-2027.webmanifest\">\n<link rel=\"icon\" type=\"image/png\" href=\"/monavenir-icon-192.png\"><link rel=\"apple-touch-icon\" sizes=\"192x192\" href=\"/monavenir-icon-192.png\">\n<style>\n:root{--red:#c8102e;--red-dark:#ab1028;--red-light:#fff1f3;--red-line:#f2d8dd;--ink:#1c2431;--muted:#738093;--subtle:#929ba9;--canvas:#f5f6f9;--line:#e8eaf0;--white:#fff;--green:#167c59;--greenlight:#e9f7f0;--shadow:0 8px 30px rgba(31,37,56,.045);--radius:18px;--font:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",Arial,sans-serif}\n*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f1f2f6;color:var(--ink);font-family:var(--font);-webkit-font-smoothing:antialiased}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.45}a{color:inherit;text-decoration:none}svg{width:21px;height:21px;flex:none;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round}h1,h2,h3,h4,p{margin-top:0}h1{font-size:clamp(27px,3vw,35px);letter-spacing:-1.2px;line-height:1.18;font-weight:750;margin-bottom:10px}h2{font-size:22px;letter-spacing:-.65px;margin-bottom:8px}h3{font-size:17px;letter-spacing:-.3px;margin-bottom:8px}p{line-height:1.57}.muted{color:var(--muted)}.small{font-size:13px}.tiny{font-size:11px}.bold{font-weight:700}.icon{display:inline-flex;align-items:center;justify-content:center}.prebar{min-height:56px;background:#171e2b;color:#f5f5f8;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:9px max(20px,calc((100vw - 1500px)/2));font-size:12px;position:relative;z-index:20}.pre-left{display:flex;align-items:center;gap:10px}.pulse{width:9px;height:9px;border-radius:99px;background:#f46377;box-shadow:0 0 0 4px #f4637726}.prebar strong{font-size:13px}.pre-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.prebar select{max-width:230px;background:#252f40;color:white;border:1px solid #3c4657;padding:8px 10px;border-radius:9px;font-size:12px}.prebar label{color:#b9c2d0}.device-controls{display:flex;align-items:center;border:1px solid #3d4657;padding:3px;border-radius:9px}.device-controls button{display:flex;gap:5px;align-items:center;background:transparent;border:0;border-radius:6px;color:#c3cad6;padding:6px 9px;font-weight:600}.device-controls button svg{width:15px;height:15px}.device-controls button.active{background:#fff;color:#1e2632}.app{max-width:1540px;margin:24px auto 50px;min-height:850px;background:var(--white);box-shadow:0 20px 70px #1d223014;border:1px solid #e6e8ee;border-radius:24px;overflow:hidden;container:app/inline-size;transition:max-width .2s}.app.mode-mobile{max-width:415px;min-height:844px}.app.mode-tablet{max-width:830px}.app-header{height:78px;displa