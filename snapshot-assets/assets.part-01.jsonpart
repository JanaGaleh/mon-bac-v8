:2;overflow:hidden;\n}\n.ege-ad-banner .ege-ad-copy p{\n display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;\n line-clamp:2;overflow:hidden;\n}\n.ege-ad-carousel-nav{display:flex;align-items:center;justify-content:flex-start;gap:6px;min-height:27px;margin-top:6px}\n.ege-ad-arrow{width:27px;height:27px;display:grid;place-items:center;padding:0;border:1px solid #f1d6dc;border-radius:50%;color:#a40824;background:#fff;font-size:20px;line-height:1;cursor:pointer}\n.ege-ad-arrow:hover{background:#ffedf0}\n.ege-ad-arrow:focus-visible{outline:3px solid #e89eaa;outline-offset:2px}\n.ege-ad-dots{display:flex;align-items:center;gap:5px;padding:0 2px;flex-wrap:wrap}\n.ege-ad-dot{width:9px;height:9px;padding:0;flex-shrink:0;border:0;border-radius:50%;background:#e6bdc4;cursor:pointer}\n.ege-ad-dot.active{width:19px;border-radius:20px;background:#bb1030}\n.ege-ad-dot:focus-visible{outline:3px solid #e89eaa;outline-offset:2px}\n.ege-ad-practical{margin:16px 0;padding:14px 15px 17px;background:#fafbfc;border:0;border-radius:14px}\n.ege-ad-practical legend{font-weight:800;color:#263748;font-size:14px;padding:0 8px}\n.ege-ad-fields-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}\n.ege-ad-practical .field{margin-bottom:12px}\n.ege-ad-practical .small{font-size:11px;margin:3px 0 0}\n.ege-directory-facts{margin:9px 0 11px;display:grid;gap:5px}\n.ege-directory-facts div{display:flex;gap:5px;font-size:12px;line-height:1.4;align-items:flex-start;min-width:0}\n.ege-directory-facts dt{font-weight:800;color:#263748;flex-shrink:0}\n.ege-directory-facts dd{margin:0;min-width:0;color:#586577;overflow-wrap:anywhere}\n.ege-directory-actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap}\n.ege-wa-button{display:inline-flex;align-items:center;gap:6px;background:#119c55;color:#fff;border-radius:10px;padding:10px 13px;font:800 12px system-ui,sans-serif;text-decoration:none;white-space:nowrap}\n.ege-wa-button:hover{background:#087b43}\n.ege-wa-button:focus-visible{outline:3px solid #5add98;outline-offset:2px}\n.ege-wa-button svg{width:16px;height:16px;stroke:#fff;fill:none}\n@media(max-width:700px){\n .ege-ad-fields-row{grid-template-columns:1fr;gap:0}\n .ege-directory-facts div{font-size:11px}\n .ege-directory-actions{gap:8px}\n .ege-wa-button{padding:8px 10px}\n .ege-ad-carousel-nav{gap:5px;margin-top:5px}\n .ege-ad-arrow{width:26px;height:26px}\n .ege-ad-dot{width:8px;height:8px}\n .ege-ad-dot.active{width:16px}\n}\n@media(max-width:380px){\n .ege-ad-banner .ege-ad-copy strong{font-size:13px}\n .ege-ad-banner .ege-ad-copy p{font-size:10.5px}\n .ege-ad-carousel-nav{min-height:23px}\n .ege-ad-arrow{width:23px;height:23px;font-size:18px}\n .ege-ad-practical{padding:12px 10px}\n}\n@media(prefers-reduced-motion:reduce){\n .ege-ad-dot,.ege-ad-arrow{transition:none}\n}\n\n</style>\n<script defer src=\"./vendor/supabase-2.57.4.js\"></script>\n<script defer src=\"./app-2027.js\"></script>\n<script defer src=\"./app-2027-ads.js\"></script>\n<script defer src=\"./app-2027-views.js\"></script>\n<script defer src=\"/ege-interface.js\"></script>\n<script defer src=\"/study-offline.js\"></script>\n<script defer src=\"/study-core.js\"></script>\n<script defer src=\"/study-pdf.js\"></script>\n<script defer src=\"/study-ui.js\"></script>\n<link rel=\"stylesheet\" href=\"/study.css\">\n<script src=\"./ege-academic.js\"></script>\n<script src=\"./ege-terrain.js\"></script>\n<script src=\"/ege-account.js\"></script>\n<link rel=\"stylesheet\" href=\"/ege-interface.css\">\n<script defer src=\"/ege-header-avenir-brand-r1.js\"></script>\n<link rel=\"stylesheet\" href=\"./mon-bac-language-secondary-20261118.css\"><script defer src=\"./mon-bac-language-audit-20261118-r2.js\"></script><link rel=\"stylesheet\" href=\"/monavenir-brand-r1.css\"></head><body><div class=\"app\" id=\"app\"></div><div role=\"status\" aria-live=\"polite\" class=\"toast\" id=\"toast\"></div></body></html>\n"],"/portail.js":["application/javascript; charset=utf-8",false,"/* Portail par rôles — ne confère jamais de privilèges à partir d'un choix utilisateur. */\n(()=>{'use strict';\nconst PROJECT='https://nwcatsmfbkcgvgbanwyl.supabase.co';\nconst PUBLIC_KEY='sb_publishable_vXuRHP_lqGqtV9d1C_oZWw_SetdoY7L';\nconst PATHS={eleve:'./assistant-dossier-gfm-2027.html',enseignant:'./enseignant.html',admin:'./admin.html'};\nconst $=id=>document.getElementById(id);\nlet api=null,requested='eleve',user=null,actual='eleve',busy=false;\nconst originUrl=new URL('./',location.href).href;\nfunction notice(txt,good=false){const e=$('notice');e.textContent=txt;e.classList.toggle('ok',good)}\nfunction panel(view){$('choose').hidden=view!=='choose';$('loginPanel').hidden=view!=='login';$('resetPanel').hidden=view!=='reset';}\nfunction safeStore(r){try{sessionStorage.setItem('ege2027_last_role',r)}catch(_){}}\nfunction safeRead(){try{return sessionStorage.getItem('ege2027_last_role')}catch(_){return null}}\nfunction go(role){location.assign(new URL(PATHS[role]||PATHS.eleve,location.href).href)}\nasync function resolveRole(){\n if(!user)return 'eleve';\n const admin=await api.from('ege2027_staff').select('role').eq('user_id',user.id).maybeSingle();\n if(admin.error)throw admin.error;\n if(admin.data?.role==='admin')return 'admin';\n const teacher=await api.from('ege2027_teacher_requests').select('status').eq('user_id',user.id).maybeSingle();\n if(teacher.error)throw teacher.error;\n if(teacher.data||admin.data?.role==='enseignant')return 'enseignant';\n return (user.user_metadata?.requested_role==='enseignant'||safeRead()==='enseignant')?'enseignant':'eleve';\n}\nfunction openRole(role){\n requested=role;\n safeStore(role);\n panel('login');\n const names={eleve:'Élève',enseignant:'Enseignant',admin:'Administration'};\n $('loginTitle').textContent='Espace '+names[role];\n $('loginHelp').textContent=role==='admin'?'Accès réservé aux administrateurs autorisés.':'Connectez-vous pour retrouver votre travail.';\n $('teacherNotice').hidden=role!=='enseignant';\n $('signup').hidden=role==='admin';\n notice('');\n if(user){go(actual==='enseignant'&&role==='eleve'?'enseignant':actual==='admin'?'admin':role==='enseignant'?'enseignant':'eleve');}\n}\nasync function refresh({auto=true}={}){\n if(!api)return;\n try{\n  const {data,error}=await api.auth.getUser();\n  if(error)throw error;\n  user=data.user||null;\n  if(!user)return;\n  actual=await resolveRole();\n  const reset=(new URLSearchParams(location.hash.slice(1)).get('type')==='recovery');\n  if(reset){panel('reset');return}\n  if(auto&&new URLSearchParams(location.search).get('choisir')!=='1')go(actual);\n }catch(e){notice('Impossible de vérifier le compte : '+(e.message||e))}\n}\nasync function submit(e){\n e.preventDefault();\n if(!api||busy)return;\n const email=$('userEmail').value.trim().toLowerCase(),password=$('userPassword').value;\n if(password.length<6){notice('Entrez votre mot de passe.');return}\n busy=true;$('submitLogin').disabled=true;notice('Connexion en cours…');\n try{\n  const {error}=await api.auth.signInWithPassword({email,password});\n  if(error)throw error;\n  const {data}=await api.auth.getUser();\n  user=data.user;\n  actual=await resolveRole();\n  if(requested==='admin'&&actual!=='admin'){notice('Ce compte ne dispose pas des droits administrateur.');return}\n  go(actual==='enseignant'?'enseignant':actual==='admin'?'admin':requested==='enseignant'?'enseignant':'eleve');\n }catch(err){notice('Connexion impossible : '+(err?.message||err))}\n finally{busy=false;$('submitLogin').disabled=false}\n}\nasync function signup(){\n if(!api||busy)return;\n const email=$('userEmail').value.trim().toLowerCase(),password=$('userPassword').value;\n if(!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)||password.length<12){notice('Renseignez un e-mail valide et un mot de passe d’au moins 12 caractères.');return}\n busy=true;$('signup').disabled=true;\n try{\n  const {data,error}=await api.auth.signUp({email,password,options:{emailRedirectTo:originUrl,data:{requested_role:requested==='enseignant'?'enseignant':'eleve'}}});\n  if(error)throw error;\n  if(data.session){user=data.user;go(requested)}\n  else notice('Inscription enregistrée. Confirmez votre adresse à l’aide du message de Prof. Jana Galeh puis revenez vous connecter.',true);\n }catch(err){notice('Inscription impossible : '+(err?.message||err))}\n finally{busy=false;$('signup').disabled=false}\n}\nasync function forgot(){\n if(!api)return;\n const email=$('userEmail').value.trim().toLowerCase();\n if(!email.includes('@')){notice('Indiquez d’abord votre adresse e-mail.');return}\n try{const {error}=await api.auth.resetPasswordForEmail(email,{redirectTo:originUrl});if(error)throw error;notice('Si le compte existe, un e-mail de récupération vous sera envoyé.',true)}\n catch(e){notice('Réinitialisation indisponible : '+e.message)}\n}\nasync function reset(e){\n e.preventDefault();\n const password=$('newPassword').value;\n if(password.length<12){notice('Saisissez au moins 12 caractères.');return}\n try{const {error}=await api.auth.updateUser({password});if(error)throw error;history.replaceState(null,'',location.pathname);notice('Mot de passe modifié. Vous pouvez accéder à votre espace.',true);await refresh({auto:true})}\n catch(err){notice('Modification impossible : '+err.message)}\n}\nasync function boot(){\n document.querySelectorAll('[data-role]').forEach(btn=>btn.addEventListener('click',()=>openRole(btn.dataset.role)));\n $('goBack').addEventListener('click',()=>{panel('choose');notice('')});\n $('eye').addEventListener('click',()=>{let input=$('userPassword');input.type=input.type==='password'?'text':'password';$('eye').textContent=input.type==='password'?'Voir':'Masquer';});\n $('loginForm').addEventListener('submit',submit);\n $('signup').addEventListener('click',signup);\n $('forgot').addEventListener('click',forgot);\n $('resetForm').addEventListener('submit',reset);\n if(!window.supabase?.createClient){notice('Connexion impossible. Vérifiez votre accès à Internet.');return}\n api=window.supabase.createClient(PROJECT,PUBLIC_KEY);\n if('serviceWorker' in navigator)navigator.serviceWorker.register('./service-worker-ege-2027.js').catch(()=>{});\n api.auth.onAuthStateChange(event=>{if(event==='PASSWORD_RECOVERY')panel('reset');});\n if(new URLSearchParams(location.hash.slice(1)).get('type')==='recovery')panel('reset');\n await refresh({auto:true});\n}\ndocument.addEventListener('DOMContentLoaded',boot);\n})();"],"/assistant-dossier-gfm-2027.html":["text/html; charset=utf-8",false,"<!doctype html>\n<html lang=\"fr\" data-mb-legacy-work=\"yes\">\n<head><style id=\"egeEligibilityGate\">body{visibility:hidden!important}</style>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#c91b2c\"><title>EGE 2027 · Mon dossier guidé</title><link rel=\"manifest\" href=\"./manifest-ege-2027.webmanifest\"><link rel=\"icon\" type=\"image/png\" href=\"/monavenir-icon-192.png\"><link rel=\"apple-touch-icon\" sizes=\"192x192\" href=\"/monavenir-icon-192.png\">\n<script defer src=\"./auth-feedback.js\"></script>\n<style>\n:root{--ink:#14253c;--muted:#607189;--line:#e3eaf4;--blue:#245ed7;--bluelight:#edf3ff;--navy:#123d66;--bg:#f5f7fb;--white:#fff;--green:#147958;--amber:#a76514;--shadow:0 12px 38px rgba(31,57,93,.065)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 system-ui,-apple-system,\"Segoe UI\",Arial,sans-serif;-webkit-font-smoothing:antialiased}button,input,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.48}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #a7c7ff;outline-offset:2px}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(28px,4vw,42px);line-height:1.15;letter-spacing:-.045em}h2{font-size:25px;line-height:1.25;letter-spacing:-.025em}h3{font-size:16px}small,.small{font-size:12px}.muted{color:var(--muted)}a{color:var(--blue)}.topbar{height:72px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(18px,3vw,48px);position:sticky;top:0;z-index:20}.brand{display:flex;align-items:center;gap:12px;color:var(--ink);text-decoration:none;cursor:pointer}.brandlogo{width:41px;height:41px;border-radius:13px;display:grid;place-items:center;background:var(--navy);color:white;font-weight:850;letter-spacing:-.03em;font-size:14px;box-shadow:0 6px 18px #123d6633}.brand b{font-size:16px;display:block;line-height:1.2}.brand small{color:var(--muted);display:block;margin-top:2px}.topright{display:flex;align-items:center;gap:10px}.pill{font-size:11px;border-radius:50px;padding:6px 12px;background:var(--bluelight);color:#215cb8;font-weight:750;letter-spacing:.035em}.textbutton{border:1px solid var(--line);padding:9px 13px;border-radius:11px;background:#fff;color:var(--ink);font-weight:650;display:inline-flex;gap:8px;align-items:center}.textbutton:hover{border-color:#b4c7e9;background:#f9fbff}.bodygrid{max-width:1510px;margin:0 auto;padding:34px clamp(14px,3vw,44px) 75px;display:grid;grid-template-columns:224px minmax(0,740px) 290px;gap:25px;align-items:start}.rail,.aside,.workspace{min-width:0}.sidebox,.paperbox,.questionbox,.welcome,.reviewbox{background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)}.sidebox{padding:21px 14px;position:sticky;top:100px}.railtitle{padding:0 12px 8px;font-size:11px;text-transform:uppercase;letter-spacing:.11em;color:#748198;font-weight:800}.railitem{display:flex;align-items:center;gap:11px;color:#687994;padding:13px 10px;border-radius:11px;margin:3px 0;font-size:13px;font-weight:700}.railitem.active{background:var(--bluelight);color:#1b57c9}.railitem.done{color:#176956}.railnum{width:28px;height:28px;border-radius:9px;background:#ecf0f6;color:#6f8098;display:grid;place-items:center;font-weight:850;flex-shrink:0}.railitem.active .railnum{background:var(--blue);color:#fff}.railitem.done .railnum{background:#def4e9;color:var(--green)}.railinfo{display:block;font-weight:500;font-size:11px;color:#8a98a9;line-height:1.3}.railfoot{margin:19px 8px 2px;border-top:1px solid var(--line);padding-top:18px;color:#667891;font-size:12px}.railfoot p{margin-bottom:10px}.railfoot .textbutton{width:100%;justify-content:center;margin-top:7px}.phasehead{display:flex;align-items:center;justify-content:space-between;margin:0 0 16px}.phaselabel{font-size:12px;font-weight:800;color:#4870a5;text-transform:uppercase;letter-spacing:.075em}.progresspct{font-size:12px;color:var(--muted);font-weight:750}.progressbar{height:6px;border-radius:10px;background:#e6edf7;overflow:hidden}.progressbar>span{display:block;height:100%;background:linear-gradient(90deg,#2865df,#44a4d0);border-radius:10px;transition:width .3s}.questionbox{overflow:hidden}.qcontent{padding:36px clamp(22px,4vw,43px) 28px}.eyebrow{font-size:11px;color:#3466b9;font-weight:850;text-transform:uppercase;letter-spacing:.1em;margin-bottom:19px;display:flex;align-items:center;gap:9px}.eyebrow .number{width:25px;height:25px;border-radius:8px;background:var(--bluelight);display:grid;place-items:center}.questionbox h1{font-size:clamp(26px,3vw,33px);letter-spacing:-.035em;margin:0 0 12px}.intro{color:var(--muted);line-height:1.65;margin-bottom:24px;max-width:630px}.qfoot{border-top:1px solid var(--line);padding:16px clamp(22px,4vw,43px);display:flex;justify-content:space-between;align-items:center;gap:10px;background:#fdfefe}.stepcount{font-size:12px;color:#8c9aae}.btn{border:0;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:12px 19px;font-weight:780;transition:background .2s,transform .2s}.btn:hover:not(:disabled){transform:translateY(-1px)}.btn-primary{background:var(--blue);color:white;box-shadow:0 5px 15px #215ddd25}.btn-primary:hover:not(:disabled){background:#154fc4}.btn-quiet{background:#f4f7fb;color:#4d5e75}.btn-outline{background:#fff;border:1px solid #bcd0ee;color:#215ab7}.btn-block{width:100%}.choice{width:100%;border:1.5px solid var(--line);border-radius:15px;padding:17px 19px;margin:9px 0;text-align:left;background:white;display:flex;gap:14px;align-items:flex-start;color:var(--ink);transition:.15s}.choice:hover{border-color:#a3c0f2;background:#fbfdff}.choice.selected{border-color:var(--blue);background:#f3f7ff;box-shadow:0 0 0 2px #d8e7ff inset}.roundcheck{width:22px;height:22px;border:2px solid #cbd6e6;border-radius:50%;flex-shrink:0;margin-top:1px;display:grid;place-items:center;background:#fff}.choice.selected .roundcheck{background:var(--blue);border-color:var(--blue);color:#fff}.choicetitle{font-weight:800;font-size:15px;line-height:1.4}.choicedesc{color:#6d7c92;font-size:13px;margin-top:4px;line-height:1.45}.choicegrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.choicegrid .choice{height:100%}.topicnum{font-size:13px;color:#2b64c9;background:#ecf3ff;padding:5px 9px;border-radius:9px;font-weight:850;min-width:37px;text-align:center}.choice.topic{align-items:start}.topic .choicetitle{font-size:14px}.field,.area{width:100%;border:1.5px solid #d8e3f1;border-radius:13px;background:#fff;color:var(--ink);padding:14px 16px;outline:0}.field:focus,.area:focus{border-color:var(--blue);box-shadow:0 0 0 3px #dce8ff}.field{height:54px}.area{min-height:120px;resize:vertical;line-height:1.6}.area.tall{min-height:335px;font-size:14px;line-height:1.75}.fieldlabel{display:block;font-weight:750;margin-bottom:9px;font-size:13px}.help{margin-top:10px;color:#728399;font-size:12px}.notice{display:flex;gap:10px;background:#f2f6fc;border:1px solid #dce8f8;border-radius:13px;color:#4e6886;padding:12px 14px;font-size:13px;line-height:1.5;margin-top:16px}.notice strong{color:#234365}.notice.warn{background:#fff9ed;border-color:#f2dfba;color:#8c611f}.minihead{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:16px 0 8px}.wordcount{font-size:12px;font-weight:800;color:#587295}.wordcount.over{color:#b24639}.sourcecheck{display:flex;gap:10px;align-items:start;padding:13px 0;color:#50627b;font-size:13px;cursor:pointer}.sourcecheck input{accent-color:var(--blue);width:18px;height:18px;flex-shrink:0}.searchwrap{position:relative}.searchwrap .field{padding-left:39px}.searchico{position:absolute;left:16px;top:15px;color:#7387a2}.suboptions{max-height:440px;overflow:auto;padding-right:4px}.suboptions .choice{padding:13px 14px}.minor{font-size:12px;color:#7989a0}.aside{position:sticky;top:100px}.paperbox{padding:18px}.asidehead{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.asidehead h3{margin:0;font-size:14px}.paper{background:#fff;border:1px solid #e0e5ed;box-shadow:0 4px 16px #203b5610;border-radius:5px;padding:17px 15px;aspect-ratio:210/270;overflow:hidden}.paperhead{text-align:center;color:#193c65;font-size:8px;font-weight:850;border-bottom:1px solid #d5aa5d;padding-bottom:7px;margin-bottom:15px;text-transform:uppercase}.papertitle{text-align:center;color:#123d66;font-family:Georgia,serif;font-size:14px;line-height:1.3;letter-spacing:.005em;margin-bottom:17px}.paperlabel{font-size:8px;text-transform:uppercase;font-weight:800;color:#56718e;letter-spacing:.07em;margin:12px 0 3px}.papervalue{font-size:9.5px;line-height:1.4;overflow-wrap:anywhere;color:#24394e}.papersplit{height:5px;background:#123d66;border-radius:2px;margin:18px 0}.statuscard{margin-top:13px;border-top:1px solid var(--line);padding-top:14px}.statusrow{display:flex;align-items:start;justify-content:space-between;gap:8px;margin:10px 0;font-size:12px;color:#60728a}.statusrow b{font-weight:780;text-align:right;color:#273c54}.dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#2aab83;margin-right:5px}.welcome{padding:44px clamp(24px,5vw,53px);border-radius:24px;overflow:hidden;position:relative}.welcome:before{content:'';position:absolute;width:240px;height:240px;border-radius:50%;background:radial-gradient(circle,#e9f1ff 3%,transparent 70%);right:-90px;top:-100px;pointer-events:none}.welcome h1{max-width:550px}.welcome p{max-width:550px;color:var(--muted);font-size:16px}.hero-kicker{color:#245bc5;font-size:12px;text-transform:uppercase;font-weight:820;letter-spacing:.1em;margin-bottom:20px}.quickpoints{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:28px 0}.quickpoint{border:1px solid var(--line);border-radius:13px;padding:13px;font-size:12px;color:#516781;background:#fff}.quickpoint b{display:block;color:#173750;font-size:20px;margin-bottom:3px}.welcome-actions{display:flex;flex-wrap:wrap;gap:11px}.reviewbox{padding:20px;margin:12px 0}.reviewtitle{font-weight:850;font-size:14px;margin-bottom:10px}.reviewrow{display:flex;align-items:start;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid #edf1f6;font-size:13px}.reviewrow:last-child{border-bottom:0}.ok{color:var(--green);font-weight:800}.todo{color:var(--amber);font-weight:800}.dlcard{background:#f3f7ff;border:1px solid #dce8ff;border-radius:15px;padding:19px;margin-top:15px}.dlcard h3{font-size:16px;margin-bottom:6px}.dlcard p{font-size:13px;color:#617590;margin-bottom:13px}.dlcard .btn{min-height:45px}.empty{color:#b4becb}.bottomnotice{max-width:1510px;margin:0 auto;padding:0 44px 30px;font-size:12px;color:#77889b}.toast{position:fixed;bottom:25px;left:50%;transform:translate(-50%,30px);background:#142f4d;color:white;padding:13px 18px;border-radius:13px;z-index:60;opacity:0;pointer-events:none;transition:.2s;box-shadow:0 14px 40px #09203b50;max-width:90vw}.toast.show{opacity:1;transform:translate(-50%,0)}.candidatefields{display:grid;gap:10px}.candidatefield{display:flex;align-items:center;gap:12px}.candidatefield span{width:25px;color:#55759e;font-weight:850;font-size:12px;text-align:center}.candidatefield input{flex:1;min-width:0}.smalllink{border:0;color:#225bc0;background:none;font-weight:750;padding:6px 0;font-size:12px}.sujetinfo{border-left:3px solid #8ab4ff;background:#f5f8fd;border-radius:0 10px 10px 0;padding:12px 14px;font-size:12px;color:#536d89;margin-bottom:15px}.sujetinfo b{display:block;color:#244b7b;margin-bottom:4px}.subinfo{font-size:13px;color:#627893;margin-bottom:10px}.phaseprogress{display:none}\n@media(max-width:1260px){.bodygrid{grid-template-columns:205px minmax(0,740px);max-width:1060px}.aside{display:none}.phaseprogress{display:block}}\n@media(max-width:740px){body{font-size:14px}.topbar{height:65px;padding:0 16px}.brand small{font-size:10px}.topright .pill{display:none}.topright .textbutton{padding:8px 10px;font-size:12px}.bodygrid{display:block;padding:17px 12px 45px}.rail{display:none}.phaseprogress{display:block;margin:0 4px 16px}.questionbox{border-radius:17px}.qcontent{padding:26px 19px 25px}.questionbox h1{font-size:26px}.qfoot{padding:14px 17px}.stepcount{display:none}.choicegrid{grid-template-columns:1fr}.choice{padding:14px}.welcome{padding:32px 23px;border-radius:18px}.welcome h1{font-size:33px}.quickpoints{grid-template-columns:1fr;gap:7px}.quickpoint{display:flex;gap:10px;align-items:center;padding:10px}.quickpoint b{margin:0;min-width:52px;font-size:17px}.bottomnotice{padding:0 18px 24px}.area.tall{min-height:300px}}\n@media print{.topbar,.rail,.aside,.phaseprogress,.qfoot,.bottomnotice{display:none!important}.bodygrid{display:block;margin:0;padding:0;background:#fff}.questionbox{border:0;box-shadow:none}.qcontent{padding:1cm}body{background:white}}\n\n/* Export Word Android — two-step real user gesture */\n.word-overlay[hidden],.word-actions [hidden]{display:none!important}\n.word-overlay{position:fixed;inset:0;z-index:6000;background:rgba(11,30,55,.64);display:flex;align-items:flex-end;justify-content:center;padding:16px;overflow-y:auto}\n.word-modal{width:min(100%,540px);background:#fff;border:1px solid #dbe6f3;border-radius:22px;padding:23px;box-shadow:0 24px 70px #0e2d5370;max-height:calc(100dvh - 30px);overflow-y:auto;color:#18334d}\n.word-modal h2{margin:0 0 9px;font-size:23px;line-height:1.22}\n.word-modal p{margin:10px 0;line-height:1.52;color:#50667f}\n.word-modal .word-state{font-size:14px;color:#2460a0;font-weight:700;display:block;margin:3px 0 8px}\n.word-modal .word-file{padding:10px 12px;border-radius:10px;background:#f0f5fb;border:1px solid #dce5f0;font-size:13px;overflow-wrap:anywhere;margin:14px 0}\n.word-modal .word-actions{display:grid;gap:10px;margin:15px 0}\n.word-modal .word-actions a,.word-modal .word-actions button{min-height:52px;text-align:center;display:flex;justify-content:center;align-items:center;border-radius:12px;font-size:16px;font-weight:750;line-height:1.28;text-decoration:none;cursor:pointer;padding:12px;border:1px solid #b8cbe5;background:white;color:#1b59a3}\n.word-modal .word-actions .word-primary{background:#2057c9;color:#fff;border-color:#2057c9;box-shadow:0 6px 12px #1649a51a}\n.word-modal .word-actions button:disabled{opacity:.55;cursor:default}\n.word-modal .word-info{font-size:13px;background:#fff8ec;border:1px solid #ebdab0;padding:12px;border-radius:11px;color:#6c5224;line-height:1.48}\n.word-modal .word-error{display:none;background:#fff0f0;color:#8d282c;border:1px solid #f0c8c8;font-size:14px;padding:12px;border-radius:10px;white-space:pre-wrap}\n.word-modal .word-error:not(:empty){display:block}\n.word-modal .word-close{border:0;background:#eaf0f8;color:#284766;border-radius:11px;padding:11px 16px;font-weight:700;cursor:pointer;width:100%}\n@media(min-width:690px){.word-overlay{align-items:center}.word-modal{padding:27px}}\n\n\n\n/* Recherche documentaire connectée */\n.researchbox{border:1px solid #c9dcf5;background:linear-gradient(150deg,#f2f7ff 0%,#fff 75%);border-radius:17px;padding:18px;margin:16px 0 23px}\n.research-title{font-size:16px;font-weight:850;color:#183e69;margin-bottom:5px}\n.research-sub{font-size:12.5px;color:#526b86;line-height:1.55;margin-bottom:15px}\n.research-actions{display:flex;gap:9px;flex-wrap:wrap}.research-actions .btn{font-size:13px;padding:11px 13px}\n.research-status{font-size:13px;line-height:1.5;margin:12px 0;color:#395d7d;min-height:12px}\n.research-result{border:1px solid #dbe5f1;background:#fff;border-radius:12px;padding:13px;margin:10px 0}\n.research-result-head{display:flex;align-items:flex-start;gap:10px}\n.research-result input{flex-shrink:0;width:19px;height:19px;margin-top:3px;accent-color:#245ed7}\n.research-result-title{font-weight:800;font-size:14px;color:#203c5b}.research-result-desc{font-size:12px;color:#536a83;line-height:1.6;margin:8px 0}\n.research-result a{font-size:12px;font-weight:750;overflow-wrap:anywhere}\n.research-bottom{display:flex;gap:9px;margin-top:15px;flex-wrap:wrap}\n.research-bottom .btn{font-size:13px}.research-config{margin-top:12px;border-top:1px dashed #bbcee7;padding-top:13px}\n.research-config summary{font-size:12px;color:#39679c;font-weight:730;cursor:pointer}\n.research-config label{font-size:12px;font-weight:750;display:block;margin:10px 0 5px}\n.research-config input{width:100%;border:1px solid #ccd9eb;padding:11px 12px;border-radius:9px;background:white}\n.research-config .btn{margin-top:10px}\n.research-references{font-size:12px;color:#51718c;margin-top:8px}\n@media(max-width:740px){.research-actions,.research-bottom{display:grid;grid-template-columns:1fr}.research-actions button,.research-bottom button{width:100%}}\n\n\n/* Extension Supabase : pas d'influence sur le parcours et la création Word */\n.ege-cloud-overlay[hidden],.ege-cloud-auth[hidden],.ege-cloud-actions[hidden],.ege-cloud-admin[hidden]{display:none!important}\n.ege-cloud-overlay{position:fixed;inset:0;z-index:600;overflow-y:auto;background:rgba(10,25,51,.64);display:flex;align-items:flex-start;justify-content:center;padding:20px 12px}\n.ege-cloud-dialog{width:min(100%,520px);max-height:calc(100vh - 40px);overflow-y:auto;background:#fff;border-radius:17px;padding:23px;box-shadow:0 24px 70px rgba(3,16,40,.2);color:#153353}\n.ege-cloud-dialog h2{margin:0 0 8px;font-size:22px;color:#15345c}.ege-cloud-dialog h3{font-size:16px;margin:20px 0 10px}\n.ege-cloud-dialog p{font-size:13px;line-height:1.55;color:#557086;margin:0 0 13px}\n.ege-cloud-dialog label{display:block;font-size:13px;font-weight:700;margin:12px 0 5px}\n.ege-cloud-dialog input,.ege-cloud-dialog textarea,.ege-cloud-dialog select{width:100%;padding:12px;border:1px solid #c4d2e4;border-radius:10px;background:#fff;color:#17304f;font:inherit}\n.ege-cloud-dialog textarea{min-height:90px;resize:vertical}\n.ege-cloud-buttons{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px}\n.ege-cloud-buttons button,.ege-cloud-close{border:1px solid #c7d8ee;background:#eef4fd;color:#2459a2;padding:10px 13px;border-radius:10px;font-weight:750;cursor:pointer}\n.ege-cloud-buttons .ege-cloud-primary{background:#245ed7;color:#fff;border-color:#245ed7}\n.ege-cloud-message{font-size:13px;white-space:pre-wrap;border-top:1px solid #e2eaf6;margin-top:15px;padding-top:13px;min-height:48px;color:#325f8b}\n.ege-cloud-admin{border-top:1px solid #d6e2ee;margin-top:18px;padding-top:8px}\n.ege-cloud-admin pre{white-space:pre-wrap;word-break:break-word;border:1px solid #d7e2f1;border-radius:10px;max-height:260px;overflow-y:auto;padding:12px;background:#f6f9fe;font:12px/1.55 system-ui;color:#2c4566}\n@media(max-width:740px){.ege-cloud-dialog{padding:17px}.ege-cloud-buttons button{flex:1;min-width:135px}}\n\n/* Installation facultative (PWA), indépendante de l'accès aux dossiers */\n.ege-install-button{background:#e9f1ff!important;color:#1656b8!important;border-color:#c8d9fa!important;font-weight:800}\n.ege-install-button:hover{background:#dceaff!important}\n.ege-install-overlay[hidden]{display:none!important}\n.ege-install-overlay{position:fixed;inset:0;z-index:750;display:grid;place-items:center;padding:16px;background:rgba(13,32,65,.65)}\n.ege-install-panel{width:min(100%,450px);background:#fff;border:1px solid #d7e3f3;border-radius:20px;box-shadow:0 24px 68px rgba(9,25,50,.25);padding:25px;color:#142d4c}\n.ege-install-panel h2{font-size:23px;margin:0 0 10px}\n.ege-install-panel p{font-size:14px;line-height:1.65;color:#52657b}\n.ege-install-panel button{padding:11px 17px;border:1px solid #c7d8ed;border-radius:10px;background:#eef4fc;color:#1c518f;font-weight:800;cursor:pointer}\n.ege-install-panel button:focus-visible{outline:3px solid #6ca2ed}\n@media(max-width:740px){.topbar{height:auto;min-height:65px;flex-wrap:wrap;gap:8px;padding:9px 12px}.brand{min-width:150px}.topright{margin-left:auto;gap:6px}.ege-install-button{padding:8px 9px!important;font-size:12px!important}.ege-install-panel{padding:20px}}\n@media(display-mode:standalone){.ege-install-button{display:none!important}}\n\n.ege-student-note{max-width:1380px;margin:18px auto 0;padding:13px 19px;background:#eaf3ff;border:1px solid #cfe2fa;border-radius:14px;color:#245487;font-size:13px;display:flex;gap:15px;align-items:start}.ege-student-note strong{white-space:nowrap}.ege-admin-link{background:#e8f6ef!important;border-color:#bfe2d0!important;color:#146b4c!important;text-decoration:none}@media(max-width:740px){.ege-student-note{margin:10px 14px 0;display:block}.ege-student-note strong{display:block;margin-bottom:2px}.ege-admin-link{font-size:12px;padding:8px 9px}}[hidden]{display:none!important}\n\n/* Correctif mobile : fenêtre utilisable avec clavier et barre Android. */\n.ege-cloud-overlay{\n  inset:0;\n  height:100vh;\n  height:100dvh;\n  overflow-y:auto;\n  overscroll-behavior:contain;\n  -webkit-overflow-scrolling:touch;\n  padding: max(12px,env(safe-area-inset-top)) 12px max(16px,env(safe-area-inset-bottom));\n}\n.ege-cloud-dialog{\n  max-height:calc(100vh - 32px);\n  max-height:calc(100dvh - max(12px,env(safe-area-inset-top)) - max(16px,env(safe-area-inset-bottom)));\n  min-height:0;\n  overflow-x:hidden;\n  overflow-y:auto;\n  overscroll-behavior:contain;\n  -webkit-overflow-scrolling:touch;\n  scroll-padding-bottom:90px;\n}\n.ege-cloud-dialog > .ege-cloud-buttons:last-child{\n  position:sticky;\n  bottom:0;\n  z-index:2;\n  background:#fff;\n  padding:10px 0 max(4px,env(safe-area-inset-bottom));\n  margin-bottom:-3px;\n  border-top:1px solid #e2eaf6;\n}\n.ege-cloud-dialog > .ege-cloud-buttons:last-child .ege-cloud-close{\n  flex:1;\n  min-height:46px;\n}\n.ege-cloud-admin > .ege-cloud-buttons:last-child{\n  position:sticky;\n  bottom:64px;\n  background:#fff;\n  z-index:1;\n  padding:8px 0;\n}\n.ege-cloud-admin-shortcut{\n  border-top:1px solid #d6e2ee;\n  margin-top:18px;\n  padding-top:18px;\n}\n.ege-cloud-admin-shortcut h3{margin:0 0 7px;font-size:16px}\n.ege-cloud-admin-shortcut p{margin:0 0 10px;color:#60758c;font-size:13px}\n.ege-cloud-admin-shortcut a{display:flex;align-items:center;justify-content:center;min-height:48px;background:#245ed7;color:#fff;border-radius:12px;font-weight:750;text-decoration:none;padding:11px 16px}\nbody:has(.ege-cloud-overlay:not([hidden])){overflow:hidden}\n@media(max-width:740px){\n  .ege-cloud-overlay{padding:8px 8px max(10px,env(safe-area-inset-bottom));}\n  .ege-cloud-dialog{\n    max-height:calc(100vh - 20px);\n    max-height:calc(100dvh - 12px - env(safe-area-inset-bottom));\n    border-radius:18px;\n    padding:17px 17px 12px;\n  }\n  .ege-cloud-dialog > .ege-cloud-buttons:last-child{padding-top:10px;}\n  .ege-cloud-admin > .ege-cloud-buttons:last-child{bottom:64px;}\n}\n\n\n/* Barre de navigation mobile : contrôle d'accès conservé côté Supabase */\n.ege-bottom-nav{display:none}\n@media(max-width:760px){\n body{padding-bottom:calc(90px + env(safe-area-inset-bottom))}\n .bodygrid{padding-bottom:45px}\n .bottomnotice{padding-bottom:24px}\n .ege-bottom-nav{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:120;align-items:stretch;justify-content:space-around;gap:2px;padding:7px max(8px,env(safe-area-inset-left)) calc(8px + env(safe-area-inset-bottom)) max(8px,env(safe-area-inset-right));border-top:1px solid #dce6f1;background:rgba(255,255,255,.98);box-shadow:0 -7px 25px rgba(20,46,80,.08)}\n .ege-bottom-nav .ege-bottom-item{appearance:none;-webkit-appearance:none;flex:1;min-width:0;max-width:132px;min-height:57px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;border:0;border-radius:12px;background:transparent;color:#5a708a;text-decoration:none;font:700 11px/1.2 system-ui,-apple-system,\"Segoe UI\",sans-serif;padding:6px 3px;cursor:pointer}\n .ege-bottom-nav .ege-bottom-item svg{width:23px;height:23px;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;fill:none}\n .ege-bottom-nav .ege-bottom-item.is-current{background:#e9f1ff;color:#2059b9}\n .ege-bottom-nav .ege-bottom-item:active{background:#e4efff;color:#164eaa}\n .ege-bottom-nav .ege-bottom-item[hidden]{display:none!important}\n .topright #egeAdminPageLink{display:none!important}\n body.ege-keyboard-open .ege-bottom-nav{display:none!important}\n body:has(.ege-cloud-overlay:not([hidden])) .ege-bottom-nav,\n body:has(.word-overlay:not([hidden])) .ege-bottom-nav,\n body:has(.ege-install-overlay:not([hidden])) .ege-bottom-nav{display:none!important}\n .ege-cloud-admin > .ege-cloud-buttons:last-child{bottom:calc(6px + env(safe-area-inset-bottom))!important}\n}\n@media print{.ege-bottom-nav{display:none!important}body{padding-bottom:0}}\n\n\n/* Import local de Word, aperçu éditable avant remplacement de la sauvegarde */\n.word-import-overlay[hidden],.word-import-annex[hidden],.word-import-loose[hidden]{display:none!important}\n.word-import-overlay{position:fixed;inset:0;z-index:6200;background:rgba(11,32,57,.72);display:flex;align-items:center;justify-content:center;padding:15px;overflow-y:auto}\n.word-import-panel{width:min(100%,720px);max-height:calc(100dvh - 30px);overflow-y:auto;overscroll-behavior:contain;border-radius:22px;background:#fff;color:#1e3852;padding:25px;box-shadow:0 20px 80px #071b3460}\n.word-import-head{display:flex;align-items:start;justify-content:space-between;gap:16px}\n.word-import-head h2{margin:3px 0 4px;font-size:25px;line-height:1.2}\n.word-import-head p{font-size:12px;color:#60758c;margin:0}\n.word-import-eyebrow{font-size:11px;color:#2c69bd;letter-spacing:.09em;font-weight:850}\n.word-import-close{background:#f0f5fc;color:#37546d;border:0;border-radius:12px;font-size:29px;line-height:1;width:40px;height:40px;flex-shrink:0}\n.word-import-lead{font-size:13px;line-height:1.65;color:#5c7187;margin:15px 0}\n.word-import-status{background:#eaf3fe;color:#1c557c;border:1px solid #d0e2f5;border-radius:12px;padding:12px 13px;font-size:12px;line-height:1.6;margin-bottom:15px}\n.word-import-status.error{background:#fff1ee;border-color:#f6d6cb;color:#a04431}\n.word-import-group{border:1px solid #dce5f1;border-radius:16px;padding:15px 16px 17px;margin:0 0 15px}\n.word-import-group legend{font-weight:800;font-size:14px;color:#245484;padding:0 6px}\n.word-import-group label{display:block;margin:11px 0 5px;font-size:12px;font-weight:750;color:#39516b}\n.word-import-group input,.word-import-group select,.word-import-group textarea{box-sizing:border-box;width:100%;border:1px solid #cbd9e8;background:#fff;color:#213950;border-radius:11px;padding:11px 12px;font:14px/1.5 system-ui,-apple-system,\"Segoe UI\",sans-serif;min-height:44px}\n.word-import-group textarea{min-height:70px;resize:vertical;white-space:pre-wrap}\n.word-import-group input:focus,.word-import-group select:focus,.word-import-group textarea:focus{border-color:#245ed7;outline:2px solid #dce9ff}\n.word-import-two{display:grid;grid-template-columns:1fr 1.2fr;gap:12px}\n.word-import-hint{font-size:12px;color:#62788b;line-height:1.6;margin:5px 0}\n.word-import-annex{margin:10px 0;background:#f8fbff;border:1px solid #dce6f3;border-radius:12px;padding:8px 12px}\n.word-import-annex summary{padding:8px 2px;cursor:pointer;font-size:13px;color:#245484;font-weight:750}\n.word-import-annex[open] summary{margin-bottom:6px}\n.word-import-loose{margin-top:15px;border:1px dashed #abc0db;border-radius:12px;background:#fbfcff;padding:12px}\n.word-import-loose p{font-size:12px}\n.word-import-loose textarea{max-height:160px}\n.word-import-footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:11px;background:#fff;padding:11px 0 5px;border-top:1px solid #e2eaf4}\n.word-import-actions{display:flex;gap:9px;align-items:center}\n.word-import-outline,.word-import-primary{border:1px solid #c8d8ed;border-radius:11px;padding:11px 15px;font-weight:750;font-size:13px;cursor:pointer;min-height:44px}\n.word-import-outline{background:#f1f6fc;color:#245684}\n.word-import-primary{background:#245ed7;border-color:#245ed7;color:#fff}\nbody:has(.word-import-overlay:not([hidden])){overflow:hidden}\nbody:has(.word-import-overlay:not([hidden])) .ege-bottom-nav{display:none!important}\n@media(max-width:740px){.word-import-overlay{padding:6px 6px calc(6px + env(safe-area-inset-bottom))}.word-import-panel{padding:16px;max-height:calc(100dvh - 12px - env(safe-area-inset-bottom));border-radius:16px}.word-import-head h2{font-size:21px}.word-import-group{padding:12px}.word-import-two{grid-template-columns:1fr}.word-import-actions{width:100%}.word-import-actions button{flex:1}.word-import-footer>#wordImportSaveCurrent{width:100%}}\n@media print{.word-import-overlay{display:none!important}}\n\n\n.ege-annex-edit{display:grid;gap:11px}.ege-annex-edit .fieldlabel{font-weight:750}\n.ege-annex-preview{margin-top:12px;border:1px solid #d6e3f1;border-radius:14px;background:#f4f8fd;overflow:hidden}\n.ege-annex-preview>summary{padding:14px 16px;font-weight:800;color:#1f5ab0;cursor:pointer;list-style:revert}\n.ege-annex-preview[open]>summary{border-bottom:1px solid #d6e3f1}\n.ege-annex-paper{margin:13px;padding:25px clamp(14px,3vw,28px);background:#fff;border:1px solid #dfe5ec;border-radius:7px;color:#24384b;box-shadow:0 5px 15px rgba(30,60,90,.05);font:14px/1.62 Georgia,\"Times New Roman\",serif;overflow-wrap:anywhere}\n.ege-annex-paper-head{text-align:center;font:700 10px/1.6 system-ui,sans-serif;letter-spacing:1.3px;color:#68798b}\n.ege-annex-paper h3{text-align:center;margin:14px 0;font:700 17px/1.4 Georgia,serif}\n.ege-annex-paper-body{white-space:pre-wrap;min-height:110px}\n.ege-annex-paper-source{margin-top:20px;border-top:1px solid #e4e8ed;padding-top:10px;font-size:12px;white-space:pre-wrap}\n.ege-annex-paper-state{font:11px/1.5 system-ui,sans-serif;color:#68788c;margin-top:8px}\n</style>\n<link rel=\"stylesheet\" href=\"./theme-rouge.css\"><script src=\"./ege-academic.js\"></script>\n<script src=\"./ege-terrain.js\"></script>\n<script src=\"/ege-account.js\"></script>\n<link rel=\"stylesheet\" href=\"/ege-interface.css\">\n<script defer src=\"/ege-header-avenir-brand-r1.js\"></script>\n<script defer src=\"/study-offline.js\"></script>\n<script defer src=\"/study-legacy.js\"></script>\n<link rel=\"stylesheet\" href=\"./mon-bac-language-secondary-20261118.css\"><script defer src=\"./mon-bac-language-audit-20261118-r2.js\"></script><link rel=\"stylesheet\" href=\"./mon-bac-work-white-20261119.css\"><link rel=\"stylesheet\" href=\"/monavenir-brand-r1.css\"></head><body>\n<header class=\"topbar\"><a class=\"brand\" id=\"brand\"><span class=\"brandlogo\">EGE</span><span><b>Mon dossier EGE</b><small>Gestion Financière & Mercatique · 2027</small></span></a><div class=\"topright\"><span class=\"pill\">RÉFÉRENTIEL OFFICIEL · 51 SOUS-THÈMES</span><button type=\"button\" class=\"textbutton ege-install-button\" id=\"egeInstallButton\" title=\"Installer EGE 2027 sur cet appareil\"><span aria-hidden=\"true\">↓ </span><span>Installer l’app</span></button><a class=\"textbutton\" href=\"./mes-groupes.html\" title=\"Rejoindre une classe et partager mes dossiers avec mon enseignant\">Mes groupes</a><a class=\"textbutton\" href=\"./?choisir=1\" title=\"Choisir un espace utilisateur\">Changer d'espace</a><a class=\"textbutton ege-admin-link\" id=\"egeAdminPageLink\" href=\"./admin.html\" hidden title=\"Accéder aux paramètres et à l’administration EGE\">Administration</a><button type=\"button\" class=\"textbutton\" id=\"egeCloudOpen\" title=\"Compte EGE et sauvegarde Supabase\"><span id=\"egeCloudBadge\">☁ En ligne</span></button><button type=\"button\" class=\"textbutton\" id=\"backupTop\" title=\"Sauvegarder le projet en fichier JSON\">↓ Sauvegarder</button></div></header>\n<nav class=\"ege-bottom-nav\" id=\"egeBottomNav\" aria-label=\"Navigation élève\">\n<button type=\"button\" id=\"egeNavHome\" class=\"ege-bottom-item is-current\" aria-label=\"Accueil élève\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 10.5 12 3l9 7.5V21h-6v-7H9v7H3z\"/></svg><span>Accueil</span></button>\n<button type=\"button\" id=\"egeNavFiles\" class=\"ege-bottom-item\" aria-label=\"Mes dossiers\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 6h7l2 2h9v12H3z\"/></svg><span>Dossiers</span></button>\n<a id=\"egeNavGroup\" class=\"ege-bottom-item\" href=\"./mes-groupes.html\" aria-label=\"Mon groupe\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 20v-3c0-2 2-3 5-3m6 0c3 0 5 1 5 3v3M9 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6z\"/></svg><span>Groupe</span></a>\n<button type=\"button\" id=\"egeNavSave\" class=\"ege-bottom-item\" aria-label=\"Mon profil et ma sauvegarde\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21c0-5 3-7 8-7s8 2 8 7\"/></svg><span>Profil</span></button>\n<a id=\"egeNavAdmin\" class=\"ege-bottom-item\" href=\"./admin.html\" aria-label=\"Administration\" hidden><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 2 8 4v6c0 5-3 8-8 10-5-2-8-5-8-10V6z\"/></svg><span>Admin</span></a>\n</nav>\n<aside class=\"ege-student-note\" id=\"egeStudentNotice\" hidden><strong>Information EGE</strong><span id=\"egeStudentNoticeText\"></span></aside><main class=\"bodygrid\"><aside class=\"rail\"><div class=\"sidebox\"><div class=\"railtitle\">Mon parcours</div><div id=\"railList\"></div><div class=\"railfoot\"><p>Enregistrement automatique sur cet appareil.</p><button class=\"textbutton\" id=\"importBtn\">↥ Importer Word / JSON</button><button class=\"textbutton\" id=\"resetBtn\">↺ Nouveau dossier</button></div></div></aside><section class=\"workspace\"><div class=\"phaseprogress\"><div class=\"phasehead\"><span class=\"phaselabel\" id=\"phaseName\">Mon dossier</span><span class=\"progresspct\" id=\"progressText\">0 %</span></div><div class=\"progressbar\"><span id=\"progressLine\" style=\"width:0%\"></span></div></div><div id=\"content\"></div></section><aside class=\"aside\"><div class=\"paperbox\"><div class=\"asidehead\"><h3>Aperçu du dossier</h3><span class=\"pill\" id=\"draftLabel\">BROUILLON</span></div><div class=\"paper\" id=\"paper\"></div><div class=\"statuscard\" id=\"statusPanel\"></div></div></aside></main><div class=\"bottomnotice\">Recherche documentaire en ligne disponible avec Internet · Sources à vérifier par le candidat · Aucun fait de terrain n’est inventé · Données conservées localement sur cet appareil.</div><input type=\"file\" id=\"importFile\" hidden accept=\".json,.docx,application/json,application/vnd.openxmlformats-officedocument.wordprocessingml.document\"><div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n<script defer src=\"./vendor/supabase-2.57.4.js\"></script>\n<script>const GFM_CATALOG=[{\"title\":\"La fidélisation et la rentabilité financière\",\"subthemes\":[{\"name\":\"L’importance de la fidélisation dans la rentabilité de l’entreprise\",\"questions\":[\"Comment la fidélité des clients peut-elle améliorer la rentabilité d’une entreprise ?\",\"Pourquoi une entreprise cherche-t-elle à conserver ses clients ?\",\"Dans quelle mesure la fidélisation aide-t-elle une entreprise à réaliser des bénéfices ?\"],\"notes\":[\"Un client fidèle réalise plusieurs achats sur une période et peut recommander l'enseigne\",\"La répétition des achats peut stabiliser les recettes et limiter certains efforts de prospection\",\"On peut comparer le nombre de clients revenus, leur fréquence d'achat et les dépenses de fidélisation\",\"Une fidélité coûteuse n'améliore pas nécessairement la marge\"],\"short_explanation\":\"Un client fidèle réalise plusieurs achats sur une période et peut recommander l'enseigne. La répétition des achats peut stabiliser les recettes et limiter certains efforts de prospection.\"},{\"name\":\"L’impact de la satisfaction client sur la rentabilité\",\"questions\":[\"Comment la satisfaction des clients peut-elle améliorer la rentabilité d’une entreprise ?\",\"Pourquoi la satisfaction des clients est-elle importante pour les ventes ?\",\"Comment une entreprise peut-elle mesurer les effets de la satisfaction sur ses résultats ?\"],\"notes\":[\"La satisfaction dépend notamment du produit, du prix, de l'accueil et du traitement des réclamations\",\"Une expérience satisfaisante peut favoriser un nouvel achat et une recommandation\",\"Un questionnaire simple et l'observation des retours clients permettent de suivre son évolution\",\"Une satisfaction élevée ne signifie pas toujours que l'activité est rentable\"],\"short_explanation\":\"La satisfaction dépend notamment du produit, du prix, de l'accueil et du traitement des réclamations. Une expérience satisfaisante peut favoriser un nouvel achat et une recommandation.\"},{\"name\":\"Le rôle et les coûts du service après-vente\",\"questions\":[\"Comment le service après-vente influence-t-il la satisfaction des clients et les coûts de l’entreprise ?\",\"Pourquoi une entreprise investit-elle dans le service après-vente ?\",\"Comment maîtriser les coûts du service après-vente tout en satisfaisant les clients ?\"],\"notes\":[\"Le service après-vente comprend l'assistance, les réparations ou les réponses après l'achat\",\"Un SAV efficace peut rassurer les clients et éviter leur départ vers un concurrent\",\"On suit le nombre de demandes, le délai de réponse et le coût du traitement\",\"Un service mal organisé peut faire augmenter les charges sans améliorer la relation client\"],\"short_explanation\":\"Le service après-vente comprend l'assistance, les réparations ou les réponses après l'achat. Un SAV efficace peut rassurer les clients et éviter leur départ vers un concurrent.\"},{\"name\":\"La politique de prix et la fidélité des clients\",\"questions\":[\"Comment les prix pratiqués influencent-ils la fidélité des clients ?\",\"Un prix bas suffit-il à fidéliser la clientèle ?\",\"Comment fixer des prix attractifs sans diminuer excessivement la rentabilité ?\"],\"notes\":[\"La politique de prix rassemble les décisions concernant le niveau et l'évolution des prix\",\"Un prix jugé équitable peut encourager le retour du consommateur\",\"On peut comparer prix affichés, fréquence d'achat et réaction aux changements tarifaires\",\"Le prix le plus faible n'est pas toujours synonyme de confiance ou de bénéfice\"],\"short_explanation\":\"La politique de prix rassemble les décisions concernant le niveau et l'évolution des prix. Un prix jugé équitable peut encourager le retour du consommateur.\"},{\"name\":\"Les programmes de fidélité et leur retour sur investissement\",\"questions\":[\"Comment mesurer l’intérêt financier d’un programme de fidélité ?\",\"Les cartes de fidélité peuvent-elles augmenter les ventes d’une entreprise ?\",\"Comment une entreprise peut-elle limiter les coûts de son programme de fidélité ?\"],\"notes\":[\"Une carte de fidélité ou une récompense vise à encourager la répétition des achats\",\"Le programme peut augmenter les visites mais entraîne des remises et des frais de gestion\",\"On compare les ventes additionnelles et la marge aux coûts des récompenses\",\"Le retour sur investissement doit être évalué et non supposé\"],\"short_explanation\":\"Une carte de fidélité ou une récompense vise à encourager la répétition des achats. Le programme peut augmenter les visites mais entraîne des remises et des frais de gestion.\"},{\"name\":\"Les indicateurs de mesure de la fidélisation\",\"questions\":[\"Quels indicateurs permettent de mesurer la fidélité des clients ?\",\"Comment une entreprise peut-elle savoir si ses clients reviennent régulièrement ?\",\"Pourquoi suivre la fidélité de sa clientèle aide-t-il à décider ?\"],\"notes\":[\"Le taux de réachat mesure la part des clients ayant acheté plusieurs fois\",\"D'autres indicateurs, comme la fréquence ou la durée de la relation, éclairent la fidélité\",\"On peut suivre les achats réguliers dans une période déterminée en respectant la confidentialité\",\"Un seul indicateur ne suffit pas à expliquer les motivations des clients\"],\"short_explanation\":\"Le taux de réachat mesure la part des clients ayant acheté plusieurs fois. D'autres indicateurs, comme la fréquence ou la durée de la relation, éclairent la fidélité.\"},{\"name\":\"Les limites et risques des stratégies de fidélisation\",\"questions\":[\"Quels risques une stratégie de fidélisation peut-elle présenter pour une entreprise ?\",\"Les réductions accordées aux clients fidèles peuvent-elles réduire les bénéfices ?\",\"Comment fidéliser les clients sans engager des dépenses trop élevées ?\"],\"notes\":[\"Une stratégie de fidélisation mobilise du temps et de l'argent\",\"Des cadeaux et remises trop généreux peuvent réduire la marge\",\"Il convient de mesurer les dépenses par client et les effets sur les achats\",\"Une dépendance aux promotions peut fragiliser l'entreprise\"],\"short_explanation\":\"Une stratégie de fidélisation mobilise du temps et de l'argent. Des cadeaux et remises trop généreux peuvent réduire la marge.\"},{\"name\":\"La personnalisation de l’expérience client et la fidélisation\",\"questions\":[\"Comment un accueil personnalisé peut-il renforcer la fidélité des clients ?\",\"Pourquoi les clients apprécient-ils un service adapté à leurs besoins ?\",\"Comment personnaliser la relation client sans augmenter excessivement les coûts ?\"],\"notes\":[\"La personnalisation consiste à adapter l'accueil, le conseil ou l'offre à un besoin exprimé\",\"Une relation attentive peut renforcer la confiance et encourager le retour du client\",\"On peut observer la satisfaction après un conseil adapté et la fréquence d'achat\",\"L'entreprise doit respecter la vie privée et éviter des coûts excessifs\"],\"short_explanation\":\"La personnalisation consiste à adapter l'accueil, le conseil ou l'offre à un besoin exprimé. Une relation attentive peut renforcer la confiance et encourager le retour du client.\"},{\"name\":\"Le rôle de la fidélisation dans la pérennité de l’entreprise\",\"questions\":[\"Comment la fidélisation contribue-t-elle à la survie d’une entreprise ?\",\"Pourquoi conserver ses clients est-il important face à la concurrence ?\",\"Comment une clientèle fidèle peut-elle stabiliser les ventes ?\"],\"notes\":[\"La pérennité désigne la capacité de l'entreprise à poursuivre son activité dans le temps\",\"Une clientèle régulière peut contribuer à limiter les fortes variations des ventes\",\"On étudie la stabilité des recettes et le maintien du portefeuille de clients\",\"La fidélité ne protège pas de tous les risques économiques\"],\"short_explanation\":\"La pérennité désigne la capacité de l'entreprise à poursuivre son activité dans le temps. Une clientèle régulière peut contribuer à limiter les fortes variations des ventes.\"},{\"name\":\"La maîtrise des coûts de fidélisation et l’augmentation des bénéfices\",\"questions\":[\"Comment réduire les coûts de fidélisation tout en maintenant la satisfaction des clients ?\",\"Quels coûts une entreprise doit-elle surveiller dans sa stratégie de fidélisation ?\",\"Peut-on augmenter les bénéfices sans réduire les avantages offerts aux clients ?\"],\"notes\":[\"Le coût de fidélisation regroupe les avantages accordés et les moyens de relation client\",\"La maîtrise des dépenses permet de conserver les actions réellement utiles\",\"Une comparaison entre coût du programme et marge obtenue peut éclairer la décision\",\"Réduire les coûts au détriment du service peut faire partir les clients\"],\"short_explanation\":\"Le coût de fidélisation regroupe les avantages accordés et les moyens de relation client. La maîtrise des dépenses permet de conserver les actions réellement utiles.\"},{\"name\":\"La fidélisation de la clientèle comme avantage concurrentiel durable\",\"questions\":[\"Comment la fidélité des clients peut-elle différencier une entreprise de ses concurrents ?\",\"Pourquoi des clients fidèles constituent-ils un avantage durable ?\",\"Comment maintenir la fidélité de la clientèle face à de nouveaux concurrents ?\"],\"notes\":[\"Un avantage concurrentiel permet à l'entreprise de se différencier durablement\",\"Une relation client de qualité peut être plus difficile à imiter qu'une remise temporaire\",\"On peut étudier les recommandations, la réputation et le retour des clients\",\"L'avantage doit être entretenu car les besoins des consommateurs évoluent\"],\"short_explanation\":\"Un avantage concurrentiel permet à l'entreprise de se différencier durablement. Une relation client de qualité peut être plus difficile à imiter qu'une remise temporaire.\"}],\"general\":[\"La fidélisation désigne l'ensemble des actions mises en œuvre pour encourager un client à revenir. Elle repose sur la confiance, la qualité de l'accueil, la satisfaction et la régularité du service.\",\"La rentabilité compare les résultats obtenus aux ressources engagées. Une hausse du nombre de clients ne garantit pas à elle seule des bénéfices : les coûts doivent être maîtrisés.\",\"La satisfaction correspond à l'écart entre ce que le client attend et ce qu'il perçoit. Une réclamation bien traitée peut contribuer à préserver la relation commerciale.\",\"Pour étudier la fidélisation, on peut observer le retour des clients, la fréquence d'achat, le panier moyen et le coût des avantages accordés. Ces indicateurs doivent être interprétés ensemble.\",\"Une stratégie commerciale doit distinguer la fidélité réelle, fondée sur la confiance, et les achats uniquement motivés par une promotion temporaire.\",\"Dans une entreprise de Djibouti, les principes sont les mêmes, mais leur application dépend du type de commerce, des habitudes de consommation et des moyens disponibles. Aucun résultat local ne peut être affirmé sans enquête.\"]},{\"title\":\"Financement et développement des organisations (publiques et privées)\",\"subthemes\":[{\"name\":\"Les moyens de financement des organisations\",\"questions\":[\"Quels moyens une organisation peut-elle utiliser pour financer ses activités ?\",\"Comment une organisation choisit-elle entre ses différentes sources de financement ?\",\"Pourquoi les besoins financiers varient-ils d’une organisation à l’autre ?\"],\"notes\":[\"Les ressources internes incluent notamment les fonds propres et l'autofinancement\",\"Les ressources externes peuvent inclure emprunt, apport nouveau ou financement spécialisé\",\"On compare durée, coût, garantie et utilisation du financement\",\"Il n'existe pas de mode universellement préférable\"],\"short_explanation\":\"Les ressources internes incluent notamment les fonds propres et l'autofinancement. Les ressources externes peuvent inclure emprunt, apport nouveau ou financement spécialisé.\"},{\"name\":\"Le financement du cycle d’exploitation\",\"questions\":[\"Comment une entreprise finance-t-elle ses dépenses courantes avant d’encaisser ses ventes ?\",\"Pourquoi le cycle d’exploitation crée-t-il des besoins de trésorerie ?\",\"Quels moyens permettent de couvrir un manque temporaire de trésorerie ?\"],\"notes\":[\"Le cycle d'exploitation comprend les achats, le stockage, la vente et le règlement\",\"Les décaissements peuvent précéder les encaissements et créer un besoin de trésorerie\",\"On peut examiner les délais clients, fournisseurs et stocks pour comprendre ce besoin\",\"Une entreprise rentable peut malgré tout manquer temporairement de liquidités\"],\"short_explanation\":\"Le cycle d'exploitation comprend les achats, le stockage, la vente et le règlement. Les décaissements peuvent précéder les encaissements et créer un besoin de trésorerie.\"},{\"name\":\"Le financement des organisations publiques\",\"questions\":[\"Comment une organisation publique finance-t-elle ses missions ?\",\"Quelles sont les principales ressources financières d’une organisation publique ?\",\"Pourquoi une organisation publique doit-elle planifier ses dépenses ?\"],\"notes\":[\"Une organisation publique mobilise des ressources selon ses missions et son cadre juridique\",\"L'affectation des ressources dépend notamment des budgets, des recettes et des règles applicables\",\"On peut analyser un budget public publié et les catégories de dépenses autorisées\",\"Les modalités exactes doivent être vérifiées dans les documents officiels\"],\"short_explanation\":\"Une organisation publique mobilise des ressources selon ses missions et son cadre juridique. L'affectation des ressources dépend notamment des budgets, des recettes et des règles applicables.\"},{\"name\":\"Financement et stratégie de développement de l’organisation\",\"questions\":[\"Comment le financement peut-il soutenir le développement d’une organisation ?\",\"Pourquoi un projet de croissance nécessite-t-il des ressources financières adaptées ?\",\"Comment le choix d’un financement peut-il modifier une stratégie de développement ?\"],\"notes\":[\"La stratégie de développement peut viser de nouvelles activités ou davantage de capacités\",\"Le financement conditionne la réalisation d'investissements et le rythme de croissance\",\"On peut mettre en relation projet, échéancier de dépenses et ressources disponibles\",\"Une croissance mal financée peut fragiliser la trésorerie\"],\"short_explanation\":\"La stratégie de développement peut viser de nouvelles activités ou davantage de capacités. Le financement conditionne la réalisation d'investissements et le rythme de croissance.\"},{\"name\":\"Le choix d’un mode de financement adapté\",\"questions\":[\"Comment choisir un financement adapté aux besoins d’une entreprise ?\",\"Quels critères permettent de comparer deux modes de financement ?\",\"Pourquoi le coût du financement est-il important dans une décision ?\"],\"notes\":[\"Un besoin à court terme ne se finance pas toujours comme un investissement durable\",\"Le choix dépend du montant, de la durée, des garanties et du coût total\",\"Un tableau comparatif peut présenter avantages, limites et capacité de remboursement\",\"Le financement le moins cher en apparence n'est pas nécessairement le plus adapté\"],\"short_explanation\":\"Un besoin à court terme ne se finance pas toujours comme un investissement durable. Le choix dépend du montant, de la durée, des garanties et du coût total.\"},{\"name\":\"L’investissement comme moteur du développement des organisations\",\"questions\":[\"Comment l’investissement contribue-t-il au développement d’une organisation ?\",\"Pourquoi une entreprise investit-elle dans de nouveaux équipements ?\",\"Quels bénéfices une organisation peut-elle attendre d’un investissement ?\"],\"notes\":[\"L'investissement correspond à l'acquisition de moyens destinés à servir durablement l'organisation\",\"Un équipement peut améliorer la capacité de production, le service ou l'efficacité\",\"On compare dépenses engagées et avantages attendus sur plusieurs périodes\",\"Les résultats futurs restent incertains et doivent être estimés avec prudence\"],\"short_explanation\":\"L'investissement correspond à l'acquisition de moyens destinés à servir durablement l'organisation. Un équipement peut améliorer la capacité de production, le service ou l'efficacité.\"},{\"name\":\"Les différentes sources de financement et la pérennité des organisations\",\"questions\":[\"Comment les sources de financement contribuent-elles à la continuité des activités ?\",\"Pourquoi diversifier les ressources financières d’une organisation ?\",\"Quels risques apparaissent lorsqu’une organisation dépend d’un seul financement ?\"],\"notes\":[\"Une ressource financière durable aide à poursuivre l'activité et à absorber certains imprévus\",\"La diversification peut éviter une dépendance excessive à un partenaire\",\"On observe échéances, charges financières et marge de sécurité\",\"Multiplier les financements sans contrôle peut augmenter l'endettement\"],\"short_explanation\":\"Une ressource financière durable aide à poursuivre l'activité et à absorber certains imprévus. La diversification peut éviter une dépendance excessive à un partenaire.\"},{\"name\":\"Le financement externe et le développement des organisations\",\"questions\":[\"Comment un financement externe peut-il aider une organisation à se développer ?\",\"Quels avantages et limites présente le recours à l’emprunt ?\",\"Pourquoi une entreprise fait-elle appel à des partenaires financiers ?\"],\"notes\":[\"Le financement externe apporte des moyens issus de prêteurs ou de partenaires\",\"Il peut accélérer un projet lorsque les ressources internes ne suffisent pas\",\"On étudie mensualités, taux, garanties, durée et capacité de remboursement\",\"L'endettement accroît les engagements futurs de l'entreprise\"],\"short_explanation\":\"Le financement externe apporte des moyens issus de prêteurs ou de partenaires. Il peut accélérer un projet lorsque les ressources internes ne suffisent pas.\"},{\"name\":\"Le financement de l’innovation\",\"questions\":[\"Comment une entreprise peut-elle financer un projet innovant ?\",\"Pourquoi l’innovation demande-t-elle parfois des financements particuliers ?\",\"Quels obstacles financiers peuvent ralentir un projet d’innovation ?\"],\"notes\":[\"L'innovation exige parfois des recherches, tests, outils ou formations\",\"Le financement peut être étalé selon les phases et les risques du projet\",\"On identifie besoins au démarrage, dépenses de test et ressources possibles\",\"Une idée nouvelle ne garantit ni ventes ni remboursement\"],\"short_explanation\":\"L'innovation exige parfois des recherches, tests, outils ou formations. Le financement peut être étalé selon les phases et les risques du projet.\"},{\"name\":\"Les stratégies de financement des entreprises nationales\",\"questions\":[\"Comment les entreprises djiboutiennes peuvent-elles financer leurs projets ?\",\"Quels critères influencent le financement d’une entreprise nationale ?\",\"Comment une entreprise nationale peut-elle limiter ses difficultés de financement ?\"],\"notes\":[\"Les entreprises nationales peuvent mobiliser divers moyens adaptés à leur statut et à leurs activités\",\"Le coût du crédit et les conditions d'accès influencent leurs décisions\",\"Il faut vérifier localement les offres existantes avant de citer une aide ou un dispositif\",\"Aucune banque ou subvention ne doit être présentée comme acquise\"],\"short_explanation\":\"Les entreprises nationales peuvent mobiliser divers moyens adaptés à leur statut et à leurs activités. Le coût du crédit et les conditions d'accès influencent leurs décisions.\"},{\"name\":\"L’équilibre financier et le développement commercial des organisations\",\"questions\":[\"Comment maintenir l’équilibre financier pendant le développement commercial ?\",\"Pourquoi la croissance des ventes peut-elle augmenter les besoins de trésorerie ?\",\"Comment une entreprise peut-elle se développer sans fragiliser ses finances ?\"],\"notes\":[\"L'équilibre financier suppose une cohérence entre ressources, emplois et échéances\",\"Une hausse des ventes peut accroître les stocks et les créances clients\",\"On analyse besoins de financement, trésorerie et délais de paiement\",\"Le chiffre d'affaires seul ne décrit pas la solidité financière\"],\"short_explanation\":\"L'équilibre financier suppose une cohérence entre ressources, emplois et échéances. Une hausse des ventes peut accroître les stocks et les créances clients.\"}],\"general\":[\"Le financement consiste à réunir les moyens nécessaires au fonctionnement et au développement d'une organisation. Il peut provenir de ses propres ressources ou de partenaires extérieurs.\",\"Les besoins ne sont pas tous de même nature : les dépenses de fonctionnement reviennent régulièrement, tandis que l'investissement concerne des équipements ou des projets durables.\",\"L'autofinancement repose sur les ressources conservées par l'organisation. Le crédit, les apports et certaines aides peuvent compléter les ressources internes, mais chacun présente des conditions et des coûts.\",\"Le cycle d'exploitation crée souvent un décalage entre les décaissements et les encaissements. Ce décalage explique certains besoins de trésorerie.\",\"Un financement adapté dépend notamment du montant, de la durée du besoin, de la capacité de remboursement et du risque accepté.\",\"Le développement doit rester compatible avec l'équilibre financier : une organisation peut augmenter son activité tout en rencontrant des difficultés de trésorerie.\"]},{\"title\":\"La gestion de la marque et du capital\",\"subthemes\":[{\"name\":\"La valeur perçue de la marque et la fidélisation de la clientèle\",\"questions\":[\"Comment l’image d’une marque peut-elle fidéliser les clients ?\",\"Pourquoi certains consommateurs préfèrent-ils une marque à une autre ?\",\"Comment améliorer la valeur perçue d’une marque auprès des clients ?\"],\"notes\":[\"La valeur perçue est l'appréciation que le consommateur porte sur les avantages d'une marque\",\"Une bonne perception peut justifier la préférence et favoriser de nouveaux achats\",\"On peut recueillir des avis sur qualité, confiance et satisfaction\",\"L'image déclarée ne remplace pas l'observation des achats réels\"],\"short_explanation\":\"La valeur perçue est l'appréciation que le consommateur porte sur les avantages d'une marque. Une bonne perception peut justifier la préférence et favoriser de nouveaux achats.\"},{\"name\":\"Les investissements mercatiques et leur rentabilité\",\"questions\":[\"Comment mesurer la rentabilité d’une dépense publicitaire ?\",\"Pourquoi une entreprise investit-elle dans la mercatique ?\",\"Comment une campagne commerciale peut-elle influencer les ventes ?\"],\"notes\":[\"Les investissements mercatiques peuvent concerner la publicité, la présentation ou l'étude des clients\",\"Ils cherchent à stimuler les ventes ou à améliorer la notoriété\",\"On rapproche la marge supplémentaire estimée du coût de la campagne\",\"Une augmentation des vues ne prouve pas un bénéfice financier\"],\"short_explanation\":\"Les investissements mercatiques peuvent concerner la publicité, la présentation ou l'étude des clients. Ils cherchent à stimuler les ventes ou à améliorer la notoriété.\"},{\"name\":\"La compétitivité et les stratégies de positionnement des marques locales face aux marques internationales\",\"questions\":[\"Comment une marque locale peut-elle se différencier des marques internationales ?\",\"Quels atouts permettent à une marque djiboutienne de rester compétitive ?\",\"Comment le positionnement d’une marque influence-t-il le choix des consommateurs ?\"],\"notes\":[\"Le positionnement précise la différence que la marque souhaite faire percevoir\",\"Une marque locale peut valoriser la proximité, le service ou l'adaptation aux besoins\",\"On compare les critères de choix des clients et les messages concurrents\",\"La réussite face aux marques internationales ne peut être affirmée sans enquête\"],\"short_explanation\":\"Le positionnement précise la différence que la marque souhaite faire percevoir. Une marque locale peut valoriser la proximité, le service ou l'adaptation aux besoins.\"},{\"name\":\"La croissance de la marque et la rentabilité de l’entreprise\",\"questions\":[\"Comment le développement d’une marque peut-il améliorer les bénéfices ?\",\"Pourquoi une marque connue peut-elle attirer davantage de clients ?\",\"Comment une entreprise peut-elle développer sa marque sans trop augmenter ses dépenses ?\"],\"notes\":[\"Une marque qui se développe peut gagner en visibilité et conquérir de nouveaux clients\",\"Les ventes peuvent progresser mais la communication et la distribution coûtent aussi de l'argent\",\"On compare évolution de la marge et dépenses de développement\",\"Une marque connue n'est pas automatiquement rentable\"],\"short_explanation\":\"Une marque qui se développe peut gagner en visibilité et conquérir de nouveaux clients. Les ventes peuvent progresser mais la communication et la distribution coûtent aussi de l'argent.\"},{\"name\":\"Les stratégies de construction de l’image, de la notoriété et de la communication commerciale\",\"questions\":[\"Comment une entreprise peut-elle faire connaître sa marque à Djibouti ?\",\"Quel rôle joue la communication commerciale dans l’image d’une marque ?\",\"Comment une entreprise peut-elle construire une image positive auprès des clients ?\"],\"notes\":[\"La notoriété signifie qu'une marque est connue; l'image correspond à la façon dont elle est perçue\",\"La communication cherche à rendre l'identité de l'entreprise claire et mémorisable\",\"On peut observer les supports utilisés et interroger les clients sur leur perception\",\"Un message publicitaire ne suffit pas à établir une réputation durable\"],\"short_explanation\":\"La notoriété signifie qu'une marque est connue; l'image correspond à la façon dont elle est perçue. La communication cherche à rendre l'identité de l'entreprise claire et mémorisable.\"},{\"name\":\"La protection juridique de la marque et la lutte contre la contrefaçon\",\"questions\":[\"Pourquoi une entreprise doit-elle protéger juridiquement sa marque ?\",\"Quels risques la contrefaçon fait-elle courir aux entreprises ?\",\"Comment la protection d’une marque peut-elle préserver la confiance des clients ?\"],\"notes\":[\"La protection de marque concerne la défense de signes distinctifs dans un cadre juridique\",\"La contrefaçon peut tromper les clients et porter atteinte à la réputation\",\"Les règles et démarches locales doivent être vérifiées auprès des organismes compétents\",\"On ne peut supposer qu'une marque est enregistrée sans preuve\"],\"short_explanation\":\"La protection de marque concerne la défense de signes distinctifs dans un cadre juridique. La contrefaçon peut tromper les clients et porter atteinte à la réputation.\"},{\"name\":\"L’impact des réseaux sociaux et du numérique sur la marque\",\"questions\":[\"Comment les réseaux sociaux influencent-ils l’image d’une marque ?\",\"Pourquoi les entreprises utilisent-elles les réseaux sociaux pour communiquer ?\",\"Quels risques numériques une marque doit-elle surveiller ?\"],\"notes\":[\"Les réseaux sociaux diffusent des contenus et permettent des échanges avec le public\",\"Un avis partagé peut améliorer ou détériorer rapidement l'image\",\"On peut examiner publication, interaction et traitement des commentaires\",\"Le nombre d'abonnés ne mesure pas directement la rentabilité\"],\"short_explanation\":\"Les réseaux sociaux diffusent des contenus et permettent des échanges avec le public. Un avis partagé peut améliorer ou détériorer rapidement l'image.\"},{\"name\":\"La notoriété de la marque et son impact sur la rentabilité de l’entreprise\",\"questions\":[\"Comment la notoriété d’une marque peut-elle augmenter les ventes ?\",\"Une marque connue est-elle toujours plus rentable ?\",\"Comment une entreprise peut-elle mesurer l’effet de sa notoriété sur ses résultats ?\"],\"notes\":[\"La notoriété peut aider des consommateurs à reconnaître et envisager une marque\",\"Cet avantage peut soutenir les ventes si l'offre répond aux attentes\",\"On distingue reconnaissance de la marque, achats réels et marge dégagée\",\"Une communication coûteuse peut réduire le gain obtenu\"],\"short_explanation\":\"La notoriété peut aider des consommateurs à reconnaître et envisager une marque. Cet avantage peut soutenir les ventes si l'offre répond aux attentes.\"}],\"general\":[\"Une marque permet d'identifier les produits ou les services d'une entreprise et de les distinguer de ceux des concurrents. Elle peut être composée d'un nom, d'un signe ou d'éléments visuels.\",\"L'image de marque correspond aux idées et aux impressions que le public associe à cette marque. La notoriété désigne plutôt le degré auquel elle est connue.\",\"Le positionnement consiste à donner à l'offre une place claire dans l'esprit des clients, par exemple autour de la qualité, de la proximité ou du prix.\",\"La communication commerciale contribue à faire connaître une offre. Elle doit rester cohérente avec la qualité réelle des produits et l'expérience des clients.\",\"La valeur d'une marque ne se confond pas avec le chiffre d'affaires : la construction de sa réputation entraîne des coûts, et son effet sur les bénéfices doit être mesuré.\",\"L'étude d'une marque locale doit distinguer les informations publiques, les impressions des clients et les pratiques effectivement confirmées par l'entreprise.\"]},{\"title\":\"La politique de prix et la rentabilité\",\"subthemes\":[{\"name\":\"Le prix de vente et la rentabilité\",\"questions\":[\"Comment le prix de vente influence-t-il la rentabilité d’une entreprise ?\",\"Pourquoi une entreprise ne peut-elle pas fixer ses prix au hasard ?\",\"Comment fixer un prix permettant de couvrir les coûts et de dégager un bénéfice ?\"],\"notes\":[\"Le prix de vente contribue au chiffre d'affaires et influence la marge par unité\",\"Une augmentation du prix peut améliorer la marge unitaire mais réduire les quantités vendues\",\"On peut comparer coût unitaire, prix hors taxes et quantités vendues\",\"Le bénéfice dépend aussi des autres charges et des ventes réalisées\"],\"short_explanation\":\"Le prix de vente contribue au chiffre d'affaires et influence la marge par unité. Une augmentation du prix peut améliorer la marge unitaire mais réduire les quantités vendues.\"},{\"name\":\"L’influence de la politique de prix sur le comportement des consommateurs\",\"questions\":[\"Comment le prix influence-t-il les décisions d’achat des consommateurs ?\",\"Pourquoi certains clients réagissent-ils aux changements de prix ?\",\"Comment les consommateurs perçoivent-ils les prix promotionnels ?\"],\"notes\":[\"Le consommateur compare le prix à ses moyens, ses besoins et à la qualité perçue\",\"Une variation de prix peut modifier l'intention d'achat\",\"On peut utiliser une enquête simple pour repérer les prix jugés acceptables\",\"Une intention d'achat déclarée ne garantit pas une vente\"],\"short_explanation\":\"Le consommateur compare le prix à ses moyens, ses besoins et à la qualité perçue. Une variation de prix peut modifier l'intention d'achat.\"},{\"name\":\"Les stratégies de prix face à la concurrence\",\"questions\":[\"Comment une entreprise adapte-t-elle ses prix face à la concurrence ?\",\"Un prix inférieur à celui des concurrents garantit-il plus de ventes ?\",\"Comment défendre ses ventes sans engager une guerre des prix ?\"],\"notes\":[\"La concurrence peut pousser une entreprise à différencier ses prix ou sa qualité\",\"Une stratégie d'alignement, de pénétration ou de distinction n'a pas les mêmes effets\",\"On compare plusieurs prix observables et les caractéristiques des offres\",\"La guerre des prix peut entraîner une baisse des marges\"],\"short_explanation\":\"La concurrence peut pousser une entreprise à différencier ses prix ou sa qualité. Une stratégie d'alignement, de pénétration ou de distinction n'a pas les mêmes effets.\"},{\"name\":\"La politique de prix et le cycle de vie du produit\",\"questions\":[\"Pourquoi le prix d’un produit peut-il changer au cours de sa vie ?\",\"Comment adapter les prix lors du lancement d’un produit ?\",\"Comment une entreprise fixe-t-elle les prix d’un produit en déclin ?\"],\"notes\":[\"Le cycle de vie distingue généralement lancement, croissance, maturité et déclin\",\"Les objectifs de prix peuvent évoluer selon la demande et la concurrence\",\"On peut étudier les évolutions de prix d'un produit à plusieurs périodes\",\"Tous les produits ne suivent pas le même parcours\"],\"short_explanation\":\"Le cycle de vie distingue généralement lancement, croissance, maturité et déclin. Les objectifs de prix peuvent évoluer selon la demande et la concurrence.\"},{\"name\":\"Les promotions, les réductions de prix et leur impact sur la rentabilité\",\"questions\":[\"Comment les promotions influencent-elles les bénéfices d’une entreprise ?\",\"Une réduction de prix augmente-t-elle toujours les ventes ?\",\"Comment organiser une promotion sans compromettre la rentabilité ?\"],\"notes\":[\"Une promotion correspond à une diminution temporaire du prix ou à un avantage commercial\",\"Elle peut attirer des clients, écouler des stocks et stimuler les achats\",\"On calcule la nouvelle marge et le volume supplémentaire nécessaire\",\"Une forte hausse des ventes peut s'accompagner d'une baisse du bénéfice\"],\"short_explanation\":\"Une promotion correspond à une diminution temporaire du prix ou à un avantage commercial. Elle peut attirer des clients, écouler des stocks et stimuler les achats.\"},{\"name\":\"Les différentes stratégies de prix et leur impact sur le bénéfice\",\"questions\":[\"Quelle stratégie de prix peut améliorer le bénéfice d’une entreprise ?\",\"Comment comparer les effets de plusieurs stratégies de prix ?\",\"Pourquoi une même stratégie de prix ne convient-elle pas à tous les produits ?\"],\"notes\":[\"Une stratégie de prix détermine la place du produit sur son marché\",\"Prix bas, premium ou différenciés peuvent produire des résultats différents\",\"On compare marge, volume de ventes et image perçue\",\"La stratégie choisie doit rester compatible avec les coûts\"],\"short_explanation\":\"Une stratégie de prix détermine la place du produit sur son marché. Prix bas, premium ou différenciés peuvent produire des résultats différents.\"},{\"name\":\"La maîtrise des coûts dans la fixation des prix\",\"questions\":[\"Comment les coûts influencent-ils la fixation du prix de vente ?\",\"Pourquoi connaître le coût de revient avant de fixer un prix ?\",\"Comment une entreprise peut-elle protéger sa marge lorsque les coûts augmentent ?\"],\"notes\":[\"Les coûts d'achat et les autres charges doivent être pris en compte dans la fixation du prix\",\"Une hausse des charges peut réduire la marge si le prix reste inchangé\",\"On peut construire un exemple chiffré de coût de revient et de marge\",\"Un prix calculé sur le seul coût ne tient pas compte de la demande\"],\"short_explanation\":\"Les coûts d'achat et les autres charges doivent être pris en compte dans la fixation du prix. Une hausse des charges peut réduire la marge si le prix reste inchangé.\"}],\"general\":[\"Le prix de vente est la somme demandée au client en échange d'un produit ou d'un service. Il joue un rôle commercial, puisqu'il influence le choix du consommateur.\",\"Le prix doit être rapproché des coûts : la marge représente la différence entre un prix de vente hors taxes et le coût pertinent retenu pour l'analyse.\",\"Une entreprise peut pratiquer différents prix selon ses objectifs, ses clients, la concurrence, le cycle de vie du produit et les contraintes réglementaires applicables.\",\"Les promotions peuvent augmenter temporairement les quantités vendues, mais elles diminuent le revenu unitaire lorsque le prix baisse.\",\"L'effet d'un changement de prix doit être observé sur le chiffre d'affaires, les volumes et la marge ; une augmentation des ventes ne prouve pas automatiquement une augmentation du bénéfice.\",\"L'analyse doit utiliser des exemples chiffrés présentés comme hypothétiques lorsque les prix et les coûts réels de l'entreprise ne sont pas disponibles.\"]},{\"title\":\"L’utilisation de l’IA dans la gestion financière et la mercatique\",\"subthemes\":[{\"name\":\"L’impact global de l’intelligence artificielle sur la gestion financière et la performance mercatique\",\"questions\":[\"Comment l’intelligence artificielle peut-elle aider à prendre des décisions de gestion ?\",\"Quels avantages et limites l’IA présente-t-elle pour une entreprise ?\",\"Dans quelles activités financières et commerciales l’IA pourrait-elle être utile ?\"],\"notes\":[\"L'IA peut analyser des données, classer des éléments ou proposer des prévisions\",\"Elle peut faciliter certaines tâches financières et commerciales répétitives\",\"On identifie les données d'entrée, le résultat attendu et le contrôle humain nécessaire\",\"La qualité du résultat dépend des données et des outils\"],\"short_explanation\":\"L'IA peut analyser des données, classer des éléments ou proposer des prévisions. Elle peut faciliter certaines tâches financières et commerciales répétitives.\"},{\"name\":\"L’IA dans la prévision des ventes\",\"questions\":[\"Comment l’intelligence artificielle peut-elle aider à prévoir les ventes ?\",\"Quelles données seraient nécessaires pour utiliser l’IA dans les prévisions ?\",\"Quels risques apparaissent lorsque les prévisions produites par l’IA sont inexactes ?\"],\"notes\":[\"La prévision des ventes cherche à estimer la demande future à partir d'informations disponibles\",\"L'IA peut détecter des tendances saisonnières ou des variations répétées\",\"On compare les prévisions aux ventes effectivement constatées\",\"Une crise ou un changement de comportement peut rendre les prévisions inexactes\"],\"short_explanation\":\"La prévision des ventes cherche à estimer la demande future à partir d'informations disponibles. L'IA peut détecter des tendances saisonnières ou des variations répétées.\"},{\"name\":\"L’IA et la sécurisation des transactions financières\",\"questions\":[\"Comment l’IA peut-elle contribuer à détecter des opérations financières inhabituelles ?\",\"Quels risques financiers une entreprise pourrait-elle réduire grâce à l’IA ?\",\"Pourquoi le contrôle humain reste-t-il nécessaire dans la sécurisation des paiements ?\"],\"notes\":[\"La sécurisation vise à repérer des anomalies dans les transactions\",\"Des modèles peuvent signaler des mouvements atypiques à vérifier\",\"On étudie les alertes, leur vérification et le risque de fausses alertes\",\"L'IA ne remplace ni les contrôles internes ni la vigilance humaine\"],\"short_explanation\":\"La sécurisation vise à repérer des anomalies dans les transactions. Des modèles peuvent signaler des mouvements atypiques à vérifier.\"},{\"name\":\"L’utilisation de l’IA dans l’analyse du marché\",\"questions\":[\"Comment l’IA peut-elle aider une entreprise à mieux connaître son marché ?\",\"Quelles informations du marché l’IA pourrait-elle analyser ?\",\"Quelles limites faut-il considérer avant d’utiliser l’IA pour étudier les clients ?\"],\"notes\":[\"L'analyse du marché consiste à étudier les clients, la demande et la concurrence\",\"L'IA peut aider à classer de nombreuses réponses ou à dégager des tendances\",\"On vérifie l'origine, la fraîcheur et la représentativité des données\",\"Des données incomplètes peuvent produire une analyse trompeuse\"],\"short_explanation\":\"L'analyse du marché consiste à étudier les clients, la demande et la concurrence. L'IA peut aider à classer de nombreuses réponses ou à dégager des tendances.\"},{\"name\":\"L’IA, la communication commerciale et la relation client\",\"questions\":[\"Comment l’IA peut-elle améliorer la communication avec les clients ?\",\"Quels usages de l’IA sont possibles dans la relation client ?\",\"Pourquoi l’intervention humaine reste-t-elle importante malgré l’utilisation de l’IA ?\"],\"notes\":[\"La communication commerciale informe le public et entretient la relation client\",\"L'IA peut aider à préparer des messages et à trier des demandes fréquentes\",\"On observe temps de réponse, clarté et satisfaction après échange\",\"Un message automatisé erroné peut nuire à la confiance\"],\"short_explanation\":\"La communication commerciale informe le public et entretient la relation client. L'IA peut aider à préparer des messages et à trier des demandes fréquentes.\"},{\"name\":\"L’IA dans la fixation des prix et l’optimisation de la rentabilité\",\"questions\":[\"Comment l’IA pourrait-elle aider une entreprise à fixer ses prix ?\",\"Quels risques présente une fixation automatisée des prix ?\",\"Comment l’analyse des ventes pourrait-elle améliorer les décisions de prix ?\"],\"notes\":[\"Des outils peuvent suggérer des prix à partir de ventes, coûts et demande\",\"Le décideur doit examiner l'effet attendu sur les marges et sur les clients\",\"On compare les propositions avec les contraintes et les résultats réels\",\"Les prix automatiques doivent rester contrôlés et conformes aux règles applicables\"],\"short_explanation\":\"Des outils peuvent suggérer des prix à partir de ventes, coûts et demande. Le décideur doit examiner l'effet attendu sur les marges et sur les clients.\"},{\"name\":\"La contribution de l’IA à la maîtrise des coûts et à l’automatisation de la comptabilité\",\"questions\":[\"Comment l’IA peut-elle simplifier certaines tâches comptables ?\",\"Dans quelles conditions l’IA pourrait-elle réduire des coûts administratifs ?\",\"Quels contrôles sont nécessaires avant de valider une écriture proposée par l’IA ?\"],\"notes\":[\"L'automatisation comptable peut classer des justificatifs et aider à la saisie\",\"Elle pourrait réduire certaines tâches répétitives et faciliter les contrôles\",\"On vérifie les erreurs, le temps gagné et le coût du logiciel\",\"Une écriture comptable doit être validée par une personne compétente\"],\"short_explanation\":\"L'automatisation comptable peut classer des justificatifs et aider à la saisie. Elle pourrait réduire certaines tâches répétitives et faciliter les contrôles.\"},{\"name\":\"La protection des données et le coût de l’utilisation de l’IA dans la gestion\",\"questions\":[\"Quels coûts une entreprise doit-elle prévoir avant d’utiliser l’IA ?\",\"Comment protéger les données des clients lors de l’utilisation de l’IA ?\",\"Pourquoi une entreprise doit-elle comparer les avantages et les risques de l’IA ?\"],\"notes\":[\"Les données sont nécessaires à de nombreux systèmes d'IA\",\"Le coût comprend parfois licences, formation, contrôle, sécurité et maintenance\",\"On identifie les données nécessaires et les mesures de protection prévues\",\"Une solution inadaptée peut coûter davantage qu'elle ne rapporte\"],\"short_explanation\":\"Les données sont nécessaires à de nombreux systèmes d'IA. Le coût comprend parfois licences, formation, contrôle, sécurité et maintenance.\"},{\"name\":\"Les métiers de la finance et du marketing à l’ère de l’IA\",\"questions\":[\"Comment l’IA peut-elle transformer les métiers de la finance et du marketing ?\",\"Quelles compétences deviennent importantes avec l’usage de l’IA ?\",\"Pourquoi les professionnels doivent-ils apprendre à vérifier les résultats de l’IA ?\"],\"notes\":[\"Les métiers financiers et commerciaux évoluent lorsque de nouveaux outils apparaissent\",\"Les professionnels doivent apprendre à interpréter, contrôler et expliquer les résultats\",\"On peut distinguer tâches automatisables et tâches exigeant jugement ou relation humaine\",\"La maîtrise des outils ne remplace pas la connaissance du métier\"],\"short_explanation\":\"Les métiers financiers et commerciaux évoluent lorsque de nouveaux outils apparaissent. Les professionnels doivent apprendre à interpréter, contrôler et expliquer les résultats.\"}],\"general\":[\"L'intelligence artificielle désigne des techniques informatiques capables de produire des prévisions, des classements ou des propositions à partir de données et de modèles.\",\"En gestion financière, certains outils peuvent aider à repérer des anomalies, classer des écritures ou analyser des informations. Les résultats doivent être contrôlés.\",\"En mercatique, l'IA peut servir à explorer les ventes, étudier des tendances et adapter des messages commerciaux, à condition de disposer de données adaptées.\",\"Une solution d'IA comporte des coûts : logiciel, matériel, formation, vérification des résultats et protection des données.\",\"L'IA peut commettre des erreurs, reproduire des biais ou produire des réponses convaincantes mais fausses. La responsabilité de la décision reste humaine.\",\"Dans une étude à Djibouti, on ne doit pas déclarer qu'une entreprise utilise effectivement l'IA sans preuve ou entretien. Les exemples théoriques doivent rester clairement hypothétiques.\"]},{\"title\":\"La gestion des risques financiers et mercatiques\",\"subthemes\":[{\"name\":\"La gestion des impayés clients et les risques financiers\",\"questions\":[\"Comment une entreprise peut-elle réduire les impayés de ses clients ?\",\"Pourquoi les retards de paiement présentent-ils un risque pour la trésorerie ?\",\"Quels moyens permettent de suivre et de relancer les clients débiteurs ?\"],\"notes\":[\"Un impayé est une somme due qui n'a pas été réglée à la date prévue\",\"Les retards de paiement peuvent réduire les liquidités disponibles\",\"On suit échéances, relances et ancienneté des créances clients\",\"Une vente à crédit n'est pas un encaissement immédiat\"],\"short_explanation\":\"Un impayé est une somme due qui n'a pas été réglée à la date prévue. Les retards de paiement peuvent réduire les liquidités disponibles.\"},{\"name\":\"Les risques d’insolvabilité et d’endettement liés à la gestion de la trésorerie\",\"questions\":[\"Comment une mauvaise trésorerie peut-elle conduire à l’insolvabilité ?\",\"Pourquoi un endettement excessif peut-il fragiliser une entreprise ?\",\"Comment surveiller la trésorerie pour prévenir les difficultés financières ?\"],\"notes\":[\"L'insolvabilité désigne l'incapacité à faire face aux dettes exigibles\",\"Des remboursements excessifs ou des recettes insuffisantes peuvent aggraver les tensions\",\"On étudie encaissements, décaissements et échéances de dettes\",\"Le niveau d'endettement doit être apprécié avec la capacité de remboursement\"],\"short_explanation\":\"L'insolvabilité désigne l'incapacité à faire face aux dettes exigibles. Des remboursements excessifs ou des recettes insuffisantes peuvent aggraver les tensions.\"},{\"name\":\"Les devises étrangères et la gestion des risques financiers\",\"questions\":[\"Comment les variations des devises peuvent-elles affecter les coûts d’une entreprise ?\",\"Quels risques une entreprise rencontre-t-elle lorsqu’elle paie en monnaie étrangère ?\",\"Comment anticiper les conséquences d’une variation des taux de change ?\"],\"notes\":[\"Une opération en devise étrangère peut comporter un risque de variation de change\",\"Le coût en monnaie de référence peut évoluer entre commande et règlement\",\"On distingue taux de change, frais et conditions du contrat\",\"La mesure du risque dépend notamment de la devise et de la période concernées\"],\"short_explanation\":\"Une opération en devise étrangère peut comporter un risque de variation de change. Le coût en monnaie de référence peut évoluer entre commande et règlement.\"},{\"name\":\"Les stratégies de prévention et de couverture des risques\",\"questions\":[\"Comment une entreprise peut-elle anticiper ses principaux risques financiers ?\",\"Quelles mesures simples permettent de limiter les risques commerciaux ?\",\"Pourquoi prévenir un risque peut-il coûter moins cher que réparer ses conséquences ?\"],\"notes\":[\"La prévention cherche à limiter la possibilité d'une perte; la couverture vise à en atténuer les conséquences\",\"Le choix dépend du type de risque, de son importance et du budget disponible\",\"On peut construire un tableau risque, conséquence, prévention et suivi\",\"Aucune mesure ne supprime tous les risques\"],\"short_explanation\":\"La prévention cherche à limiter la possibilité d'une perte; la couverture vise à en atténuer les conséquences. Le choix dépend du type de risque, de son importance et du budget disponible.\"},{\"name\":\"La gestion des risques financiers et mercatiques sur la rentabilité de l’entreprise\",\"questions\":[\"Comment la gestion des risques peut-elle protéger la rentabilité d’une entreprise ?\",\"Quels risques financiers et commerciaux peuvent réduire les bénéfices ?\",\"Pourquoi identifier les risques aide-t-il une entreprise à prendre de meilleures décisions ?\"],\"notes\":[\"La rentabilité peut diminuer si des clients ne paient pas ou si les coûts augmentent\",\"Une gestion des risques organisée peut éviter certaines pertes\",\"On rapproche risques identifiés, mesures engagées et évolution des charges\",\"Une mesure de protection a elle-même un coût à prendre en compte\"],\"short_explanation\":\"La rentabilité peut diminuer si des clients ne paient pas ou si les coûts augmentent. Une gestion des risques organisée peut éviter certaines pertes.\"}],\"general\":[\"Un risque correspond à la possibilité qu'un événement entraîne une perte ou empêche d'atteindre un objectif. En entreprise, certains risques concernent les paiements, les coûts, les ventes ou la trésorerie.\",\"Le risque financier peut apparaître lors d'un retard de paiement, d'un endettement excessif, d'une mauvaise prévision de trésorerie ou d'une exposition aux devises.\",\"Le risque mercatique concerne notamment l'évolution de la demande, la concurrence, les défauts de qualité et la perte de confiance des clients.\",\"La gestion des risques suit une démarche simple : identifier le danger, évaluer ses conséquences, choisir une mesure de prévention et vérifier son efficacité.\",\"Il est utile de distinguer la prévention, qui cherche à réduire la probabilité d'un problème, et la couverture, qui vise à limiter ses conséquences financières.\",\"Une entreprise ne peut pas supprimer tous les risques. Elle doit choisir des mesures proportionnées à ses moyens et suivre régulièrement sa situation.\"]}];</script>\n<script>const TEMPLATES={\"individuel_theory\":\"\",\"individuel_full\":\"\",\"binome_theory\":\"\",\"binome_full\":\"\"};</script>\n<script>/*!\n\nJSZip v3.10.1 - A JavaScript class for generating and reading zip files\n<http://stuartk.com/jszip>\n\n(c) 2009-2016 Stuart Knightley <stuart [at] stuartk.com>\nDual licenced under the MIT license or GPLv3. See https://raw.github.com/Stuk/jszip/main/LICENSE.markdown.\n\nJSZip uses the library pako released under the MIT license :\nhttps://github.com/nodeca/pako/blob/main/LICENSE\n*/\n\n!function(e){if(\"object\"==typeof exports&&\"undefi