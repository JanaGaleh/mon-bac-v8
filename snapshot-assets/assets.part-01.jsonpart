ap:5px;padding:0 2px;flex-wrap:wrap}\n.ege-ad-dot{width:9px;height:9px;padding:0;flex-shrink:0;border:0;border-radius:50%;background:#e6bdc4;cursor:pointer}\n.ege-ad-dot.active{width:19px;border-radius:20px;background:#bb1030}\n.ege-ad-dot:focus-visible{outline:3px solid #e89eaa;outline-offset:2px}\n.ege-ad-practical{margin:16px 0;padding:14px 15px 17px;background:#fafbfc;border:0;border-radius:14px}\n.ege-ad-practical legend{font-weight:800;color:#263748;font-size:14px;padding:0 8px}\n.ege-ad-fields-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}\n.ege-ad-practical .field{margin-bottom:12px}\n.ege-ad-practical .small{font-size:11px;margin:3px 0 0}\n.ege-directory-facts{margin:9px 0 11px;display:grid;gap:5px}\n.ege-directory-facts div{display:flex;gap:5px;font-size:12px;line-height:1.4;align-items:flex-start;min-width:0}\n.ege-directory-facts dt{font-weight:800;color:#263748;flex-shrink:0}\n.ege-directory-facts dd{margin:0;min-width:0;color:#586577;overflow-wrap:anywhere}\n.ege-directory-actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap}\n.ege-wa-button{display:inline-flex;align-items:center;gap:6px;background:#119c55;color:#fff;border-radius:10px;padding:10px 13px;font:800 12px system-ui,sans-serif;text-decoration:none;white-space:nowrap}\n.ege-wa-button:hover{background:#087b43}\n.ege-wa-button:focus-visible{outline:3px solid #5add98;outline-offset:2px}\n.ege-wa-button svg{width:16px;height:16px;stroke:#fff;fill:none}\n@media(max-width:700px){\n .ege-ad-fields-row{grid-template-columns:1fr;gap:0}\n .ege-directory-facts div{font-size:11px}\n .ege-directory-actions{gap:8px}\n .ege-wa-button{padding:8px 10px}\n .ege-ad-carousel-nav{gap:5px;margin-top:5px}\n .ege-ad-arrow{width:26px;height:26px}\n .ege-ad-dot{width:8px;height:8px}\n .ege-ad-dot.active{width:16px}\n}\n@media(max-width:380px){\n .ege-ad-banner .ege-ad-copy strong{font-size:13px}\n .ege-ad-banner .ege-ad-copy p{font-size:10.5px}\n .ege-ad-carousel-nav{min-height:23px}\n .ege-ad-arrow{width:23px;height:23px;font-size:18px}\n .ege-ad-practical{padding:12px 10px}\n}\n@media(prefers-reduced-motion:reduce){\n .ege-ad-dot,.ege-ad-arrow{transition:none}\n}\n\n</style>\n<script defer src=\"./monbac-sort-20261119.js\"></script>\n<script defer src=\"./vendor/supabase-2.105.0.js\"></script>\n<script defer src=\"./app-2027-interview-r1.js\"></script>\n<script defer src=\"./app-2027-ads-market-r1.js\"></script>\n<script defer src=\"./app-2027-views-article-r2-sort-r1.js\"></script>\n<script defer src=\"/ege-interface-four-cycles-r2.js\"></script>\n<script defer src=\"/study-offline.js\"></script>\n<script defer src=\"/study-core.js\"></script>\n<script defer src=\"/study-pdf.js\"></script>\n<script defer src=\"/study-ui.js\"></script>\n<link rel=\"stylesheet\" href=\"/study.css\">\n<script src=\"./ege-academic.js\"></script>\n<script src=\"./ege-terrain-interview-r1.js\"></script>\n<script src=\"/ege-account.js\"></script>\n<link rel=\"stylesheet\" href=\"/ege-interface.css\">\n<script defer src=\"/ege-header-avenir-brand-r1.js\"></script>\n<link rel=\"stylesheet\" href=\"./mon-bac-next.css\">\n<script defer src=\"./mon-bac-next-autopublish-20261119-sort-r1-market-r1.js?v=109\"></script>\n<script defer src=\"./mon-bac-tools-sort-r1-market-r1.js\"></script>\n<script defer src=\"./mon-bac-v69.js\"></script>\n<script defer src=\"./mon-bac-classroom.js\"></script>\n<link rel=\"stylesheet\" href=\"./mon-bac-v69.css\">\n<script defer src=\"./mon-bac-v70-compact-20261119-sort-r1.js\"></script>\n<link rel=\"stylesheet\" href=\"./mon-bac-v70.css\">\n<script defer src=\"./study-qr.js\"></script>\n<script defer src=\"./mon-bac-v72-teacher-clean-r1.js\"></script>\n<link rel=\"stylesheet\" href=\"./mon-bac-v72.css\">\n<script defer src=\"./mon-bac-v73-sort-r1.js\"></script>\n<link rel=\"stylesheet\" href=\"./mon-bac-v73.css\">\n<script defer src=\"./mon-bac-v74-teacher-clean-r1.js\"></script>\n<link rel=\"stylesheet\" href=\"./mon-bac-v74.css\">\n<script defer src=\".