-banner{width:91%;grid-template-columns:85px minmax(0,1fr);gap:8px;padding:9px}\n.ege-ad-art{width:85px;height:80px;grid-row:span 2}.ege-ad-action{grid-column:2;justify-self:start}\n.ege-ad-link{border:0;background:transparent;padding:5px 2px}\n.ege-auth-ad .ege-ad-banner{grid-template-columns:75px minmax(0,1fr)}.ege-auth-ad .ege-ad-art{width:75px;height:75px}\n.ege-ad-schedule{grid-template-columns:1fr 1fr}\n}\n@media(max-width:470px){\n.ege-red-hero{min-height:207px}.ege-hero-actions{padding:12px 16px}.ege-hero-edition{font-size:10px}\n.ege-hero-brand{padding-top:0;padding-bottom:60px}.ege-hero-symbol{height:53px}\n.ege-hero-symbol svg:first-child{height:36px;width:57px}.ege-hero-symbol svg:last-child{height:19px;width:64px}\n.ege-hero-brand h1{font-size:41px}.ege-hero-brand p{font-size:10px}\n.ege-hero-wave{height:48px}.ege-onboard-new{padding:4px 0 17px}.ege-onboard-new .onboard-top{margin-bottom:16px}\n.ege-onboard-new .onboard-top h2{font-size:17px}.ege-onboard-new .onlead{font-size:12px}\n.ege-onboard-new .rolecards{gap:9px}.ege-onboard-new .rolecard{min-height:136px;padding:13px 3px;border-radius:17px;gap:8px}\n.ege-onboard-new .rolecard h3{font-size:11.5px;overflow-wrap:anywhere;letter-spacing:-.2px}\n.ege-onboard-new .rolecard p{display:none}\n.ege-onboard-new .ege-install-entry{margin-top:16px}\n.ege-ad-banner{width:96%;min-height:108px;margin-top:19px;grid-template-columns:76px minmax(0,1fr);border-radius:17px}\n.ege-ad-art{width:76px;height:73px}.ege-ad-copy strong{font-size:14px}\n.ege-ad-copy p{font-size:11px;line-height:1.32}.ege-ad-copy .ege-ad-label{font-size:9px;margin-bottom:3px}\n.ege-auth-stage{padding:0 0 25px}.ege-auth-stage .login-card{padding:20px 19px 22px}.ege-auth-stage .login-card h1{font-size:27px}\n.ege-auth-ad .ege-ad-banner{width:100%;grid-template-columns:69px minmax(0,1fr)}\n.ege-auth-ad .ege-ad-art{width:69px}.ege-ad-schedule{grid-template-columns:1fr}\n}\n@media(prefers-reduced-motion:reduce){.ege-onboard-new .rolecard{transition:none}}\n\n\n/* EGE 2027 — une seule carte de rôle par ligne sur téléphone. */\n@media (max-width:640px){\n .ege-onboard-new .rolecards{\n  grid-template-columns:minmax(0,1fr);\n  gap:12px;\n }\n .ege-onboard-new .rolecard{\n  display:grid;\n  grid-template-columns:56px minmax(0,1fr);\n  grid-template-rows:auto auto;\n  align-items:center;\n  justify-items:start;\n  justify-content:stretch;\n  text-align:left;\n  min-height:92px;\n  padding:15px 18px;\n  gap:3px 15px;\n }\n .ege-onboard-new .rolecard .roleicon{\n  grid-column:1;\n  grid-row:1 / span 2;\n  width:52px;\n  height:52px;\n }\n .ege-onboard-new .rolecard h3{\n  grid-column:2;\n  grid-row:1;\n  font-size:17px;\n  line-height:1.3;\n  font-weight:800;\n  white-space:normal;\n  word-break:normal;\n  overflow-wrap:normal;\n  hyphens:none;\n  letter-spacing:0;\n }\n .ege-onboard-new .rolecard p{\n  grid-column:2;\n  grid-row:2;\n  display:block;\n  margin:0;\n  font-size:12px;\n  line-height:1.4;\n  text-align:left;\n }\n}\n\n/* Annuaire des enseignants : Premium d'abord, accès public, responsive. */\n.ege-directory-page{padding:18px 8px 58px;max-width:900px;margin:0 auto}\n.ege-directory-top{padding:4px 3px 26px}\n.ege-directory-back{display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:700;color:#9d1530;text-decoration:none;margin:4px 0 30px}\n.ege-directory-back svg{width:17px;height:17px}\n.ege-directory-back:hover{text-decoration:underline}\n.ege-directory-top-label{display:block;color:#b20d2c;font-weight:780;font-size:11px;letter-spacing:.8px;text-transform:uppercase;margin-bottom:9px}\n.ege-directory-top h1{font-size:clamp(24px,4vw,35px);line-height:1.2;font-weight:900;letter-spacing:-.8px;color:#202a37;margin:0 0 10px}\n.ege-directory-top p{font-size:14px;line-height:1.6;color:#728093;margin:0;max-width:620px}\n.ege-directory-section{margin-bottom:30px}\n.ege-directory-section-head{display:flex;align-items:baseline;gap:12px;justify-content:space-between;padding:0 3px;margin-bottom:15px}\n.ege-directory-section-head h2{font-size:19px;font-weight:850;margin:0;color:#293747}\n.ege-directory-section-head span{font-size:11px;color:#8a95a3}\n.ege-directory-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}\n.ege-directory-card{display:grid;grid-template-columns:100px minmax(0,1fr);align-items:start;gap:13px;min-height:155px;padding:19px 17px;border:0;border-radius:18px;background:#fff;box-shadow:0 7px 26px rgba(35,37,55,.09)}\n.ege-directory-icon{height:105px;width:100px;border-radius:13px;background:#fff4f6;display:grid;place-items:center}\n.ege-directory-icon img{max-width:94px;max-height:80px;object-fit:contain}\n.ege-directory-content{min-width:0}\n.ege-directory-overline{font-size:11px;color:#98a1ad;margin-bottom:8px;min-height:20px}\n.ege-premium-pill{display:inline-flex;align-items:center;padding:4px 9px;border-radius:8px;background:#fff1de;color:#8e5b0d;font-weight:800;font-size:11px}\n.ege-directory-card h3{font-size:17px;line-height:1.35;font-weight:820;color:#253242;margin:0 0 8px;overflow-wrap:break-word}\n.ege-directory-card p{font-size:12px;line-height:1.5;color:#68768a;margin:0 0 13px;overflow-wrap:anywhere;white-space:pre-wrap}\n.ege-directory-actions{margin-top:auto}\n.ege-directory-link{display:inline-flex;align-items:center;gap:6px;color:#b40d2c;background:transparent;border:0;font-size:12px;font-weight:800;text-align:left;text-decoration:none;padding:7px 0;cursor:pointer}\n.ege-directory-link svg{width:15px;height:15px}\n.ege-directory-link:hover{text-decoration:underline}\n.ege-directory-link:focus-visible{outline:3px solid #efadb6;outline-offset:3px}\n.ege-directory-empty{margin:4px auto 0;max-width:620px;text-align:center;border-radius:20px;padding:36px 24px;background:#fff;box-shadow:0 7px 27px rgba(36,37,52,.07)}\n.ege-directory-empty-icon{display:grid;place-items:center;width:58px;height:58px;margin:0 auto 18px;background:#fff0f3;border-radius:18px;color:#bd1030}\n.ege-directory-empty-icon svg{width:3