age-head{margin-bottom:22px}.page-head h1{font-size:26px}.page-head p{font-size:12px}.page-head .inline-actions .btn:not(.primary){display:none}.layout-side,.layout-editor{grid-template-columns:1fr}.grid3,.grid4{grid-template-columns:repeat(2,minmax(0,1fr))}.grid2{grid-template-columns:1fr}.card{padding:17px;border-radius:15px}.feature{padding:21px;border-radius:16px}.feature h2{font-size:21px}.feature-bottom{align-items:stretch}.feature-bottom>.btn{flex:1}.rolecards{grid-template-columns:1fr;gap:10px}.rolecard{min-height:unset;display:grid;grid-template-columns:44px 1fr;gap:4px 13px;padding:16px}.rolecard .roleicon{grid-row:span 3;width:44px;height:44px}.rolecard h3{margin-top:1px}.rolecard p{font-size:11px}.rolecard .rolelink{margin:4px 0 0}.onboard{padding:15px 0}.onboard-top{margin-bottom:25px}.onboard-logo{width:62px;height:62px}.onboard h1{font-size:26px}.stat{padding:15px}.stat-num{font-size:27px}.stat-icon{width:31px;height:31px}.paper{padding:22px 17px;min-height:400px}.login-card{margin:18px auto;padding:24px}.student-row{padding:13px}.textline{align-items:start}.inline-actions{gap:7px}.stepper{gap:6px}.step{font-size:10px;padding:6px 8px}.step em{width:19px;height:19px}.prebar{min-height:50px}.app{border-radius:0;box-shadow:none;margin:0;min-height:calc(100dvh - 60px)}.toast{bottom:90px;left:16px;right:16px;max-width:none;text-align:center}}\n@media(max-width:740px){.prebar{padding:10px 12px;gap:8px;align-items:flex-start}.pre-left span.detail,.device-controls,.prebar label{display:none}.pre-right{flex:1;justify-content:flex-end}.prebar select{max-width:min(215px,55vw)}.app{margin:0;border:0;border-radius:0}.prebar strong{font-size:11px}}@media(min-width:741px){.app.mode-mobile{margin:16px auto 40px;border-radius:27px;min-height:810px}.app.mode-mobile .app-body{min-height:750px}}\n@media(prefers-reduced-motion:reduce){*,*:before,*:after{transition:none!important;scroll-behavior:auto!important}}\n\n\n/* Production: même design que la maquette, sans commandes de démonstration. */\nhtml,body{min-height:100%;background:#fff}\n.prebar{display:none!important}\n.app{max-width:1600px;width:100%;min-height:100dvh;margin:0 auto;border:0;border-radius:0;box-shadow:none}\n.app-header{position:sticky;top:0;z-index:40}\n.app-body{min-height:calc(100dvh - 78px)}\n.main{background:#fafbfc}\n.intro-main{background:#fff}\n.rolecard:hover{border-color:#d93f51}\n.ege-feedback{background:#fff7f8;border:1px solid #f2d8dd;color:#8f2433;border-radius:12px;padding:11px 14px;margin:12px 0;font-size:13px}\n.ege-feedback.good{background:#edfaf3;border-color:#bce8d2;color:#146b48}\n.ege-feedback.warn{background:#fff9e8;border-color:#eed59a;color:#805c1b}\n.ege-a11y-status{font-size:12px;min-height:17px;color:#677486}\n.ege-clickable{cursor:pointer}\n.ege-forms input:focus-visible,.ege-forms select:focus-visible,.ege-forms textarea:focus-visible{outline:3px solid #f6b4c0;outline-offset:2px}\n.ege-spinner{width:18px;height:18px;border:2px solid #ead5d9;border-top-color:#c8102e;border-radius:50%;animation:ege-spin .8s linear infinite}\n@keyframes ege-spin{to{transform:rotate(360deg)}}\n.ege-unread{width:8px;height:8px;border-radius:50%;background:#c8102e}\n.ege-role-label{font-size:12px;color:#858f9e}\n.ege-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}\n.ege-source{white-space:pre-wrap;overflow-wrap:anywhere}\n.ege-paper-text{white-space:pre-wrap;overflow-wrap:anywhere}\n.ege-list-row{min-width:0}\n.ege-list-row .row-content{min-width:0}\n.ege-list-row .row-content strong,.ege-list-row small{overflow-wrap:anywhere}\n@media(max-width:810px){\n.bottomnav{display:flex!important;align-items:center;justify-content:space-around}\n.app{border-radius:0!important;min-height:100dvh}\n.app-header{height:66px;padding:0 17px}\n.app-body{display:block;min-height:calc(100dvh - 66px)}\n.sidebar{display:none!important}\n.main{padding:24px 17px calc(107px + env(safe-area-inset-bottom));min-height:calc(100dvh - 66px)}\n.main.intro-main,.main.login-main{padding-bottom:38px}\n.bottomnav{position:fixed;bottom:0;left:0;right:0;width:100%;z-index:50;background:#fff;box-shadow:0 -5px 25px #1f24300b;padding-bottom:env(safe-area-inset-bottom)}\n.page-head{gap:9px}\n.app-header .brand-sub{font-size:10px}\n.version-pill{display:none!important}\n.grid4{grid-template-columns:repeat(2,minmax(0,1fr))}\n}\n.brandmark.ege-brand-icon,.onboard-logo.ege-brand-icon{display:block;background:transparent;object-fit:contain;border:0;box-shadow:none;padding:0}\n.brandmark.ege-brand-icon{width:43px;height:43px;border-radius:13px}\n.onboard-logo.ege-brand-icon{width:76px;height:76px;border-radius:20px;box-shadow:0 10px 24px rgba(176,0,22,.12)}\n@media(max-width:470px){\n.main{padding-left:14px;padding-right:14px}\n.card{padding:17px}\n.feature{padding:21px}\n.btn{white-space:normal;text-align:center}\n.page-head h1{font-size:27px}\n.rolecards{grid-template-columns:1fr}\n.layout-editor,.layout-side,.grid3{grid-template-columns:1fr}\n}\n/* Champ de mot de passe — visibilité accessible, sans déplacer le curseur ni réinitialiser la saisie */\n.field>.password-label{display:block;color:#465063;font-size:12px;font-weight:750;margin-bottom:7px}\n.password-wrap{position:relative;display:flex;align-items:center;width:100%}\n.password-wrap .input{padding-right:58px}\n.password-toggle{position:absolute;right:3px;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;width:44px;height:44px;border:0;border-radius:10px;background:transparent;color:#a71229;cursor:pointer;touch-action:manipulation}\n.password-toggle:hover{background:#fff1f3}\n.password-toggle:focus-visible{outline:3px solid #e68c9c;outline-offset:-2px}\n.password-toggle svg{height:21px;width:21px;pointer-events:none}\n\n/* Installation PWA : action visible, sobre, mobile-first */\n.ege-install-entry{text-align:center;margin:27px auto 5px;max-width:380px}\n.ege-install-entry .ege-install-button{min-height:49px;padding:13px 22px;font-size:15px;width:100%}\n.ege-install-entry .small{line-height:1.5;margin:9px 0 0}\n.ege-install-header{min-height:38px;padding:7px 12px;gap:6px;font-size:12px;border-color:#f0cfd5;background:#fff9fa;color:#a8122b}\n.ege-install-header svg{width:17px;height:17px}\n.ege-install-dialog{border:1px solid #f0d8dd;border-radius:19px;padding:25px;background:#fff;color:var(--ink);box-shadow:0 25px 90px #1c243133;max-width:min(440px,calc(100vw - 30px));width:100%;line-height:1.55}\n.ege-install-dialog::backdrop{background:rgba(20,27,42,.48)}\n.ege-install-dialog-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}\n.ege-install-dialog h2{font-size:20px;line-height:1.3;margin:0}\n.ege-install-instructions{font-size:14px;margin:16px 0 24px;color:#566171}\n.ege-install-close{width:36px;height:36px;min-width:36px;display:grid;place-items:center;border:0;background:#fff3f5;border-radius:10px;color:#9d1529;cursor:pointer}\n.ege-install-close svg{width:19px;height:19px;transform:rotate(45deg)}\n.ege-install-dialog .btn.full{width:100%}\n[data-act=\"install\"][hidden]{display:none!important}\n@media(max-width:810px){.ege-install-header{min-height:42px;padding:8px 9px}.ege-install-header span{display:none}.ege-install-header svg{width:21px;height:21px}.header-right{gap:6px}.ege-install-entry{margin-top:19px}}\n\n/* EGE 2027 · Accueil / connexion — nouvelles maquettes rouge et blanc */\n.ege-intro-app{background:#fff}\n.ege-red-hero{position:relative;overflow:hidden;min-height:252px;color:#fff;background:linear-gradient(110deg,#e40025 0%,#c50825 47%,#9c001b 100%)}\n.ege-hero-actions{max-width:1060px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:15px;padding:15px 25px}\n.ege-hero-edition{color:#ffe7ea;font-size:12px;letter-spacing:.5px;font-weight:700}\n.ege-hero-install{border:1px solid #ffffff60;background:#ffffff1f;color:#fff;display:flex;align-items:center;gap:7px;border-radius:12px;min-height:40px;padding:9px 14px;font:700 12px system-ui;cursor:pointer}\n.ege-hero-install svg{width:18px;height:18px}\n.ege-hero-brand{text-align:center;padding:5px 12px 76px;color:#fff;position:relative;z-index:2}\n.ege-hero-symbol{display:flex;align-items:center;justify-content:center;flex-direction:column;height:65px;margin:0 auto;color:#fff}\n.ege-hero-symbol svg:first-child{height:43px;width:68px}.ege-hero-symbol svg:last-child{height:26px;width:68px;margin-top:-7px}\n.ege-hero-brand h1{font-size:clamp(38px,5vw,60px);letter-spacing:-1.5px;font-weight:900;margin:4px 0 2px;color:#fff}\n.ege-hero-brand p{font-size:12px;letter-spacing:.8px;color:#ffe3e9;margin:0}\n.ege-hero-wave{display:block;position:absolute;bottom:-1px;left:0;width:100%;height:72px;z-index:1}\n.ege-intro-app .app-body{display:block;min-height:0;background:#fff}\n.ege-intro-app .main,.ege-intro-app .main.intro-main,.ege-intro-app .main.login-main{display:block;min-height:0;background:#fff;padding:0 18px 42px}\n.ege-intro-app .screen{max-width:970px;margin:-10px auto 0;position:relative;z-index:2}\n.ege-onboard-new{max-width:900px;padding:12px 0 35px;margin:0 auto}\n.ege-onboard-new .onboard-top{text-align:center;margin-bottom:24px}\n.ege-onboard-new .onboard-top h2{font-size:20px;letter-spacing:-.4px;margin:0 0 7px;color:#202b38}\n.ege-onboard-new .onlead{font-size:13px;color:#798493;line-height:1.55}\n.ege-onboard-new .rolecards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}\n.ege-onboard-new .rolecard{min-height:165px;align-items:center;justify-content:center;text-align:center;gap:10px;padding:18px 12px;border:0;border-radius:20px;background:#fff;box-shadow:0 9px 28px #29233318;transition:transform .15s,box-shadow .15s}\n.ege-onboard-new .rolecard:hover{transform:translateY(-2px);box-shadow:0 14px 30px #29233323}\n.ege-onboard-new .rolecard:focus-visible{outline:3px solid #e48b9b;outline-offset:3px}\n.ege-onboard-new .rolecard .roleicon{display:grid;place-items:center;width:52px;height:52px;border-radius:15px;color:#c60927;background:#fff3f5}\n.ege-onboard-new .rolecard .roleicon svg{width:36px;height:36px}\n.ege-onboard-new .rolecard h3{font-size:16px;color:#1b2635;margin:0}\n.ege-onboard-new .rolecard p{font-size:12px;color:#798391;line-height:1.4}\n.ege-onboard-new .ege-install-entry{margin-top:23px}\n.ege-onboard-new .ege-install-entry .btn{max-width:310px;margin:auto}\n.ege-onboard-new .onboard-bottom{margin-top:20px}\n.ege-auth-stage{max-width:550px;margin:0 auto;padding:0 12px 26px}\n.ege-auth-stage .login-card{width:100%;max-width:none;margin:0 auto;border:0;border-radius:21px;padding:26px 29px 28px;background:#fff;box-shadow:0 15px 43px #2523331e}\n.ege-auth-stage .login-card h1{text-align:center;font-size:clamp(27px,3.5vw,34px);color:#202a38;font-weight:850;margin:6px 0 10px}\n.ege-auth-stage .login-card>.muted{text-align:center;margin-bottom:22px}\n.ege-auth-stage .backbtn{margin-bottom:14px}\n.ege-auth-stage .login-badge{display:table;margin:3px auto 8px}\n.ege-auth-stage .input{min-height:51px;border:1px solid #e3e3e8;border-radius:13px}\n.ege-auth-stage .field{margin-bottom:15px}\n.ege-auth-stage .btn.primary.full{min-height:52px;border-radius:13px;font-size:15px;font-weight:850}\n.ege-auth-ad{margin:18px auto 0}\n.ege-ad-banner{width:min(84%,710px);min-height:111px;margin:27px auto 0;display:grid;grid-template-columns:101px minmax(0,1fr) auto;align-items:center;gap:12px;padding:9px 14px 9px 8px;border:0;border-radius:19px;background:linear-gradient(105deg,#fff7f7,#fff);box-shadow:0 10px 32px #29233318;overflow:hidden}\n.ege-ad-art{width:101px;height:88px;display:grid;place-items:center;overflow:hidden}\n.ege-ad-art img{width:100%;height:100%;object-fit:contain}\n.ege-ad-copy{min-width:0}.ege-ad-copy .ege-ad-label{display:block;font-size:10px;color:#956572;margin-bottom:5px}\n.ege-ad-copy strong{display:block;color:#ac0020;font-weight:850;font-size:clamp(14px,2vw,18px);line-height:1.2}\n.ege-ad-copy p{margin:5px 0 0;font-size:12px;line-height:1.4;color:#3e4858;overflow-wrap:an