-1)}(e,e.l_desc.max_code+1,e.d_desc.max_code+1,a+1),K(e,e.dyn_ltree,e.dyn_dtree)),W(e),n&&M(e)},r._tr_tally=function(e,t,r){return e.pending_buf[e.d_buf+2*e.last_lit]=t>>>8&255,e.pending_buf[e.d_buf+2*e.last_lit+1]=255&t,e.pending_buf[e.l_buf+e.last_lit]=255&r,e.last_lit++,0===t?e.dyn_ltree[2*r]++:(e.matches++,t--,e.dyn_ltree[2*(A[r]+u+1)]++,e.dyn_dtree[2*N(t)]++),e.last_lit===e.lit_bufsize-1},r._tr_align=function(e){P(e,2,3),L(e,m,z),function(e){16===e.bi_valid?(U(e,e.bi_buf),e.bi_buf=0,e.bi_valid=0):8<=e.bi_valid&&(e.pending_buf[e.pending++]=255&e.bi_buf,e.bi_buf>>=8,e.bi_valid-=8)}(e)}},{\"../utils/common\":41}],53:[function(e,t,r){\"use strict\";t.exports=function(){this.input=null,this.next_in=0,this.avail_in=0,this.total_in=0,this.output=null,this.next_out=0,this.avail_out=0,this.total_out=0,this.msg=\"\",this.state=null,this.data_type=2,this.adler=0}},{}],54:[function(e,t,r){(function(e){!function(r,n){\"use strict\";if(!r.setImmediate){var i,s,t,a,o=1,h={},u=!1,l=r.document,e=Object.getPrototypeOf&&Object.getPrototypeOf(r);e=e&&e.setTimeout?e:r,i=\"[object process]\"==={}.toString.call(r.process)?function(e){process.nextTick(function(){c(e)})}:function(){if(r.postMessage&&!r.importScripts){var e=!0,t=r.onmessage;return r.onmessage=function(){e=!1},r.postMessage(\"\",\"*\"),r.onmessage=t,e}}()?(a=\"setImmediate$\"+Math.random()+\"$\",r.addEventListener?r.addEventListener(\"message\",d,!1):r.attachEvent(\"onmessage\",d),function(e){r.postMessage(a+e,\"*\")}):r.MessageChannel?((t=new MessageChannel).port1.onmessage=function(e){c(e.data)},function(e){t.port2.postMessage(e)}):l&&\"onreadystatechange\"in l.createElement(\"script\")?(s=l.documentElement,function(e){var t=l.createElement(\"script\");t.onreadystatechange=function(){c(e),t.onreadystatechange=null,s.removeChild(t),t=null},s.appendChild(t)}):function(e){setTimeout(c,0,e)},e.setImmediate=function(e){\"function\"!=typeof e&&(e=new Function(\"\"+e));for(var t=new Array(arguments.length-1),r=0;r<t.length;r++)t[r]=arguments[r+1];var n={callback:e,args:t};return h[o]=n,i(o),o++},e.clearImmediate=f}function f(e){delete h[e]}function c(e){if(u)setTimeout(c,0,e);else{var t=h[e];if(t){u=!0;try{!function(e){var t=e.callback,r=e.args;switch(r.length){case 0:t();break;case 1:t(r[0]);break;case 2:t(r[0],r[1]);break;case 3:t(r[0],r[1],r[2]);break;default:t.apply(n,r)}}(t)}finally{f(e),u=!1}}}}function d(e){e.source===r&&\"string\"==typeof e.data&&0===e.data.indexOf(a)&&c(+e.data.slice(a.length))}}(\"undefined\"==typeof self?void 0===e?this:e:self)}).call(this,\"undefined\"!=typeof global?global:\"undefined\"!=typeof self?self:\"undefined\"!=typeof window?window:{})},{}]},{},[10])(10)});</script>\n<script>\n'use strict';\nconst KEY='ege-gfm-2027-v3';\nconst $=id=>document.getElementById(id);\nconst h=x=>String(x??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst clean=s=>String(s??'').trim();\nconst wordcount=s=>(clean(s).match(/\\S+/g)||[]).length;\nconst escapeXml=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&apos;'}[c]));\nconst trimName=s=>String(s||'eleve').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').replace(/[^a-zA-Z0-9]+/g,'_').replace(/^_+|_+$/g,'').slice(0,55);\nconst PHASES=[{id:1,name:'Mon identité',desc:'Candidat et établissement'},{id:2,name:'Mon sujet',desc:'Thème et problématique'},{id:3,name:'Ma théorie',desc:'Annexes et références'},{id:4,name:'Mon terrain',desc:'Préparer la visite'},{id:5,name:'Mon dossier',desc:'Contrôle et fichier Word'}];\nconst TITLES=['Notions générales du thème','Approfondissement du sous-thème','Éléments de réponse à la problématique','Conditions et limites du sujet'];\nconst EXAMPLES=[\n\"Illustration hypothétique : un commerce peut comparer la fréquentation de ses clients avant et après une action de fidélisation. Le résultat doit être examiné en tenant compte des coûts engagés.\",\n\"Illustration hypothétique : une entreprise peut prévoir l'achat d'un équipement et comparer un financement sur ses fonds propres avec un emprunt. Les conditions financières réelles restent à rechercher.\",\n\"Illustration hypothétique : une boutique peut modifier la présentation de sa marque, puis interroger des clients sur leur perception. Une opinion favorable ne signifie pas automatiquement une augmentation du profit.\",\n\"Illustration chiffrée fictive : si le prix hors taxes passe de 1 000 à 900 FDJ et que le coût unitaire reste à 700 FDJ, la marge unitaire passe de 300 à 200 FDJ.\",\n\"Illustration hypothétique : un logiciel peut signaler une vente inhabituellement élevée. Une personne doit contrôler la facture et l'origine des données avant de prendre une décision.\",\n\"Illustration hypothétique : des factures non réglées à temps peuvent empêcher un commerce de payer ses fournisseurs. Un tableau des échéances aide à anticiper la difficulté.\"\n];\nconst EXPAND=[\n[\"Cette relation commerciale se construit dans la durée : un simple cadeau ne suffit pas à créer une fidélité durable.\",\"Il est donc nécessaire de comparer les recettes supplémentaires aux remises, aux dépenses de communication et aux autres charges supportées.\",\"Pour illustrer cette notion, un élève peut distinguer une attente avant achat et une appréciation après utilisation.\",\"L'étude doit toujours préciser la période mesurée et éviter de tirer une conclusion à partir de quelques clients seulement.\",\"Une entreprise doit donc rechercher un équilibre entre les actions qui attirent immédiatement et celles qui entretiennent durablement la confiance.\",\"Le futur entretien pourra servir à comprendre comment ces principes sont effectivement appliqués, sans supposer le résultat à l'avance.\"],\n[\"Avant de choisir une solution, le responsable doit formuler clairement le besoin et le moment où l'argent sera nécessaire.\",\"L'élève peut ainsi distinguer une dépense récurrente, comme l'achat de marchandises, d'une machine utilisée pendant plusieurs années.\",\"Pour comparer des solutions, il faut aussi tenir compte des remboursements et des intérêts, lorsqu'ils existent.\",\"Par exemple, une vente à crédit peut être comptabilisée avant que le client ne verse effectivement son règlement.\",\"Un tableau simple peut présenter pour chaque financement son objet, sa durée, ses avantages et ses limites.\",\"Le suivi de trésorerie permet de comprendre pourquoi le développement commercial exige parfois un financement complémentaire.\"],\n[\"La marque est donc un repère commercial qui peut guider les consommateurs lorsqu'ils hésitent entre plusieurs offres.\",\"Deux personnes peuvent connaître une même marque tout en en ayant une opinion différente.\",\"Une offre bien positionnée doit rester fidèle à la promesse exprimée dans ses messages commerciaux.\",\"Par exemple, une marque qui promet un service rapide doit être capable de le rendre dans la pratique.\",\"L'élève peut distinguer les dépenses qui visent la visibilité des résultats réellement constatés dans les ventes.\",\"La recherche documentaire prépare l'enquête, mais ne permet pas à elle seule de connaître les intentions des clients d'une marque précise.\"],\n[\"Un prix peut aussi transmettre une image de qualité, même s'il ne permet pas à lui seul de juger la valeur d'un produit.\",\"Lorsqu'on effectue un calcul, il faut expliquer les éléments compris dans le coût et préciser si les montants sont hors taxes.\",\"Les objectifs peuvent être différents : attirer de nouveaux clients, couvrir les coûts ou protéger une marge satisfaisante.\",\"Le responsable doit donc calculer combien d'unités supplémentaires il faudrait vendre pour compenser une réduction du prix.\",\"Les variations de coûts, de demande et de concurrence peuvent expliquer des résultats commerciaux différents d'une période à l'autre.\",\"Tout exemple fictif doit être annoncé comme tel afin de ne pas être confondu avec les prix d'une entreprise visitée.\"],\n[\"Une prévision calculée par un logiciel n'est pas une décision : une personne doit l'expliquer avant de l'utiliser.\",\"Par exemple, un document numérisé peut être mal lu ; il faut donc vérifier les montants et les dates.\",\"Les données analysées peuvent provenir d'activités précédentes, mais elles doivent rester exactes et pertinentes.\",\"Une dépense nouvelle n'est justifiée que si les bénéfices attendus sont suffisants par rapport aux risques.\",\"L'élève doit distinguer une démonstration théorique de l'usage réellement constaté d'un outil dans une entreprise.\",\"Le contrôle humain reste indispensable, y compris lorsqu'un outil présente son résultat avec un ton assuré.\"],\n[\"Identifier un risque dès sa naissance permet souvent de réagir avant que ses conséquences deviennent difficiles à supporter.\",\"Une même opération peut exposer l'entreprise à plusieurs risques qu'il convient d'analyser séparément.\",\"Par exemple, une baisse de qualité peut entraîner à la fois des retours de produits et une mauvaise réputation.\",\"Le responsable doit classer les risques selon leur importance et prévoir une personne chargée d'en suivre l'évolution.\",\"On peut utiliser une grille simple indiquant la probabilité du risque, son coût possible et la mesure choisie.\",\"L'enquête de terrain pourra ensuite vérifier les moyens réellement employés par l'organisation étudiée.\"]\n];\nconst ENRICH2=[\n\"Cette première explication sert à situer le sujet dans l'activité quotidienne de l'organisation et à comprendre le vocabulaire employé.\",\n\"Il est utile de présenter les étapes dans leur ordre logique, afin d'éviter de confondre l'objectif recherché et l'action concrètement réalisée.\",\n\"Un tableau ou une comparaison de périodes peut rendre ces observations plus compréhensibles, sans remplacer une analyse argumentée.\",\n\"L'exemple est volontairement construit pour apprendre à raisonner ; il ne décrit aucune entreprise visitée par le candidat.\",\n\"Le candidat devra confronter les informations théoriques à des documents fiables ou à des témoignages obtenus avec l'accord de l'organisation.\"\n];\nconst ENRICH3=[\n\"Il faut d'abord définir les termes de cette question et identifier précisément ce qui doit être expliqué ou comparé.\",\n\"Pour défendre cet argument, il faut montrer par quel mécanisme une action peut entraîner un résultat, puis préciser les conditions de cette relation.\",\n\"Si des chiffres sont employés, ils doivent être issus d'une source identifiable ou explicitement présentés comme des hypothèses de calcul.\",\n\"La réponse théorique constitue donc une base de raisonnement à confirmer, à nuancer ou à corriger après les investigations de terrain.\"\n];\nconst ENRICH4=[\n\"Les notions principales ont déjà été présentées dans les autres annexes ; cette partie apporte donc un éclairage complémentaire.\",\n\"Une information ancienne ou incomplète peut conduire à une décision différente de celle qui aurait été prise avec des données exactes.\",\n\"Une solution adaptée à une grande entreprise n'est pas forcément possible dans un petit commerce disposant de moyens limités.\",\n\"Le fait de reconnaître ces limites ne signifie pas que la stratégie est mauvaise : cela permet simplement d'en évaluer la pertinence.\",\n\"Les futurs documents de terrain devront préciser les pratiques réelles sans fabriquer de témoignage ni attribuer une décision à un dirigeant.\"\n];\nfunction egeCatalog(payload=data){return EGEAcademic.legacyCatalog(payload,GFM_CATALOG)}\nconst empty=()=>({study:{},validations:{},terrain:EGETerrain.empty(),series:'GFM',mode:'',student:'',partner:'',className:'',school:'',teacher:'',theme:null,subtheme:null,problem:'',problemMode:'',annexes:{},annexTitles:{},sources:{},sourceChecks:{},researchEvidence:{},annexBackup:{},company:'',candidates:Array(7).fill(''),resumeAt:'mode',step:'welcome'});\nlet data=empty(),maxReached=0;\ntry{const saved=JSON.parse(localStorage.getItem(KEY)||'null');if(saved&&typeof saved==='object')data={...empty(),...saved,terrain:EGETerrain.normalize(saved.terrain,saved),series:EGEAcademic.seriesOf(saved),annexes:{...(saved.annexes||{})},annexTitles:{...(saved.annexTitles||{})},sources:{...(saved.sources||{})},sourceChecks:{...(saved.sourceChecks||{})},researchEvidence:{...(saved.researchEvidence||{})},annexBackup:{...(saved.annexBackup||{})},candidates:Array.isArray(saved.candidates)?[...saved.candidates].slice(0,7):Array(7).fill('')}}catch(e){}\nconst subject=()=>Number.isInteger(data.theme)&&Number.isInteger(data.subtheme)&&egeCatalog()[data.theme]?.subthemes[data.subtheme]||null;\nconst theme=()=>Number.isInteger(data.theme)?egeCatalog()[data.theme]:null;\nfunction allSteps(){let z=[['welcome',0],['mode',1],['series',1],['student',1]];if(data.mode==='binome')z.push(['partner',1]);z.push(['className',1],['school',1],['teacher',1],['theme',2],['subtheme',2],['problem',2]);for(let i=1;i<=(data.mode==='binome'?4:3);i++)z.push(['annex'+i,3]);z.push(['company',4],['candidates',4],['finish',5]);return z.map(([id,phase])=>({id,phase}));}\nfunction activeIndex(){let idx=allSteps().findIndex(x=>x.id===data.step);return idx<0?0:idx;}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(data));window.EGEStudyLegacy?.stage?.().catch(()=>{if(typeof egeCloudMsg==='function')egeCloudMsg('Stockage hors connexion impossible : exportez une sauvegarde JSON.');});window.EGE2027Phase1?.scheduleSync?.();return true}catch(e){return false}}\nfunction toast(s){const el=$('toast');el.textContent=s;el.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>el.classList.remove('show'),2900)}\n/* Compléments théoriques pédagogiques pour enrichir les pages A4 sans données de terrain inventées.\n   Les explications suivent les six thèmes officiels; le sous-thème conserve son contenu spécifique. */\nconst DEVELOPPEMENTS = [\n { // 1 - Fidélisation\n a1:[\n  \"La fidélité se reconnaît à la continuité de la relation commerciale. Elle peut se manifester par le retour du client, sa préférence pour l'enseigne ou sa recommandation auprès de son entourage.\",\n  \"La rentabilité ne se confond pas avec le chiffre d'affaires : il faut retirer les charges supportées pour apprécier le résultat. Une hausse des ventes peut être insuffisante si les dépenses augmentent davantage.\",\n  \"La satisfaction résulte d'une comparaison entre les attentes du consommateur et son expérience réelle. Le prix, l'accueil, la qualité du produit et le traitement des réclamations peuvent influencer cette appréciation.\",\n  \"Le suivi de la fidélité exige une période d'observation et des critères identiques pour tous les clients. Il permet de distinguer un achat occasionnel d'une relation durable, sans attribuer automatiquement les évolutions à une seule action.\",\n  \"Les avantages offerts aux clients ont un coût qui doit être enregistré et comparé aux recettes. Une décision de fidélisation est donc à la fois mercatique, parce qu'elle concerne les clients, et financière.\",\n  \"Pour analyser une entreprise djiboutienne, il faudra notamment connaître le type de clientèle, les moyens de fidélisation utilisés et les difficultés rencontrées. Ces informations ne pourront être affirmées qu'après une recherche documentée ou une visite réelle.\"\n ],\n a2:[\n  \"Pour comprendre ce sous-thème, il convient de définir la clientèle concernée et de distinguer les nouveaux acheteurs des clients réguliers. Le responsable doit également préciser ce qu'il souhaite améliorer : les ventes, la fréquence des achats ou la confiance.\",\n  \"Une action de fidélisation peut agir progressivement : un accueil fiable encourage la satisfaction, laquelle peut favoriser un nouvel achat. Cette chaîne de relations reste une hypothèse de gestion tant que ses effets ne sont pas observés.\",\n  \"On peut suivre la fréquence d'achat, le nombre de réclamations, la part de clients qui reviennent et le coût des avantages proposés. Ces éléments deviennent utiles lorsqu'ils sont comparés sur des périodes similaires.\",\n  \"Un exemple pédagogique doit distinguer clairement les montants fictifs des résultats d'entreprise. Le calcul de la marge permet de vérifier qu'une augmentation du volume des ventes ne cache pas une baisse du bénéfice par produit.\",\n  \"En pratique, aucune stratégie ne convient à toutes les entreprises. Un commerce de proximité, une grande surface et une société de services n'ont ni les mêmes clients ni les mêmes dépenses de fidélisation.\"\n ],\n a3:[\n  \"La réponse doit identifier le mécanisme attendu : une relation satisfaisante peut conduire à des achats répétés, réduire certaines dépenses de prospection et améliorer la stabilité des recettes. Il reste à vérifier si cet avantage compense les coûts engagés.\",\n  \"Un argument solide relie une décision précise à un résultat mesurable. Par exemple, le responsable peut comparer la fréquentation avant et après une action, mais il doit aussi tenir compte de la concurrence et des variations saisonnières.\",\n  \"La rentabilité exige une analyse financière : un client peut acheter plus souvent sans être profitable si les remises ou les services accordés sont trop coûteux. Il faut donc croiser indicateurs commerciaux et informations comptables.\",\n  \"Ainsi, la fidélisation peut constituer un levier de performance, sans garantir mécaniquement un bénéfice. La conclusion de l'élève doit présenter les conditions de réussite, les limites et les informations qui restent à recueillir sur le terrain.\"\n ],\n a4:[\n  \"Une première condition est de proposer une offre conforme aux attentes du client. Une carte de fidélité ou une remise ne peuvent durablement compenser une qualité insuffisante ou un mauvais accueil.\",\n  \"Une deuxième condition est de maîtriser le coût du dispositif : communication, cadeaux, remises et temps du personnel. Ces charges doivent être comparées aux bénéfices supplémentaires espérés sur la même période.\",\n  \"La mesure comporte des difficultés. Les habitudes d'achat changent avec les saisons, les revenus, les prix concurrents ou les ruptures de stock. Il serait donc imprudent d'expliquer toutes les variations par la fidélisation.\",\n  \"Des choix alternatifs sont possibles : améliorer le service après-vente, rendre l'information plus claire ou résoudre plus vite les réclamations. L'entreprise doit retenir les actions cohérentes avec ses moyens.\",\n  \"L'enquête pourra demander aux responsables comment ils repèrent les clients réguliers, calculent les dépenses de fidélisation et évaluent leurs résultats. Les réponses ne devront être inscrites qu'après l'entretien réel.\"\n ]},\n { // 2 - Financement\n a1:[\n  \"Le financement correspond à l'ensemble des ressources permettant de payer une activité ou un projet. Il faut distinguer le besoin de financement, qui naît d'une dépense, de la source mobilisée pour y répondre.\",\n  \"La durée du besoin joue un rôle central : les achats courants nécessitent des liquidités disponibles rapidement, tandis qu'un équipement durable peut être financé sur plusieurs années. Confondre ces horizons fragilise la trésorerie.\",\n  \"Les ressources internes comprennent notamment les fonds apportés et les sommes dégagées par l'activité. Les ressources externes peuvent provenir d'un établissement financier, d'un fournisseur ou de partenaires, selon les situations.\",\n  \"Le coût du financement dépend des conditions acceptées : intérêts, frais, garanties ou perte d'autonomie éventuelle. Un choix apparemment simple doit donc être étudié sur l'ensemble de sa durée.\",\n  \"L'équilibre financier suppose une cohérence entre les ressources durables et les emplois durables, mais aussi une surveillance des encaissements et des décaissements. Une entreprise rentable peut rencontrer un manque temporaire de trésorerie.\",\n  \"Dans le cas des organismes publics, les règles de financement et de contrôle sont particulières. L'élève doit employer les termes adaptés à l'organisation réellement étudiée et ne pas transférer mécaniquement les pratiques d'une entreprise privée.\"\n ],\n a2:[\n  \"L'analyse du sous-thème commence par la nature du projet : fonctionnement courant, stock, investissement ou innovation. Chacun entraîne des paiements à des dates différentes et demande une solution financière appropriée.\",\n  \"Il faut ensuite rapprocher la durée de financement de celle du besoin. Payer un investissement de longue durée uniquement avec la trésorerie de la semaine peut créer une difficulté pour les charges habituelles.\",\n  \"Les éléments de comparaison sont le montant obtenu, son coût, les conditions de remboursement, les garanties exigées et la liberté de gestion conservée. Aucun critère isolé ne suffit à décider.\",\n  \"Dans un exemple hypothétique, l'entreprise peut comparer deux solutions pour acquérir le même équipement. La décision ne dépend pas seulement de la mensualité : la somme totale remboursée et le risque de trésorerie comptent également.\",\n  \"La décision retenue doit soutenir le développement sans déséquilibrer l'activité existante. Une prévision de trésorerie, même simple, aide à repérer les mois où les paiements pourraient dépasser les encaissements.\"\n ],\n a3:[\n  \"Une réponse à la problématique doit établir un lien entre le besoin de ressources et les objectifs de l'organisation. Sans moyens suffisants, elle peut reporter un achat, réduire sa production ou renoncer à un projet.\",\n  \"Toutefois, disposer d'un financement ne prouve pas la réussite d'un projet. Les recettes prévues doivent être réalistes et le remboursement compatible avec les liquidités que l'organisation peut générer.\",\n  \"L'élève peut raisonner à partir de trois questions : combien faut-il financer, pendant combien de temps et à quel coût ? Le rapprochement de ces réponses permet de comparer plusieurs décisions possibles.\",\n  \"La conclusion théorique doit donc souligner que le financement est un moyen au service du développement, non une fin en soi. Sa pertinence ne peut être appréciée pour une organisation précise sans documents fiables.\"\n ],\n a4:[\n  \"La fiabilité des prévisions constitue une condition préalable. Un montant sous-estimé risque de laisser le projet inachevé ; un besoin surestimé peut conduire à payer inutilement un financement coûteux.\",\n  \"L'adéquation de la durée est une autre condition : des échéances trop rapprochées peuvent provoquer des tensions de trésorerie, même lorsque l'investissement est utile sur plusieurs années.\",\n  \"Les garanties exigées, les frais supplémentaires et le niveau d'endettement doivent être examinés ensemble. Il faut aussi tenir compte de la capacité réelle de l'organisation à faire face à des ventes plus faibles que prévu.\",\n  \"Plusieurs solutions peuvent être envisagées : financement sur fonds propres, emprunt, crédit fournisseur ou report d'une partie du projet. Leurs avantages et leurs contraintes varient selon le contexte.\",\n  \"Pour vérifier la théorie, l'élève pourra demander les critères de choix d'un financement sans exiger de données confidentielles. Aucun montant ou contrat ne doit être inventé dans le dossier.\"\n ]},\n { // 3 - Marque\n a1:[\n  \"Une marque peut être constituée d'un nom, d'un signe ou d'éléments visuels qui distinguent une offre. Elle facilite l'identification, mais son importance dépend surtout de la confiance qu'elle inspire.\",\n  \"La notoriété mesure le fait d'être connu, alors que l'image correspond à l'ensemble des associations et jugements que les consommateurs attachent à la marque. Ces deux notions ne donnent pas toujours le même résultat.\",\n  \"Le positionnement désigne la place que l'entreprise cherche à occuper dans l'esprit de sa clientèle. Il peut reposer sur le prix, la qualité, le service, l'origine ou une caractéristique particulière de l'offre.\",\n  \"La communication commerciale transmet ce positionnement, mais elle doit rester cohérente avec les produits réellement proposés. Une promesse exagérée peut attirer une première attention puis dégrader la confiance.\",\n  \"Les dépenses de publicité et de développement de la marque doivent être suivies. Une meilleure visibilité n'entraîne pas automatiquement davantage de bénéfices : il faut examiner les ventes et les coûts correspondants.\",\n  \"Sur le marché djiboutien, l'élève pourra comparer des marques locales et internationales uniquement à partir de sources identifiables. Les préférences des consommateurs ne peuvent pas être déduites sans enquête.\"\n ],\n a2:[\n  \"L'étude précise d'abord le public visé et les éléments par lesquels la marque souhaite être reconnue. Une stratégie adaptée à une clientèle professionnelle peut différer de celle destinée à de jeunes consommateurs.\",\n  \"La cohérence des messages est essentielle : le nom, les visuels, le prix et le service doivent contribuer à une même promesse. Le client construit son opinion par l'ensemble de ces contacts.\",\n  \"Pour évaluer les résultats, on peut distinguer la reconnaissance de la marque, la perception de qualité et les achats réalisés. Il serait incorrect de traiter ces trois informations comme une seule mesure.\",\n  \"Un exemple théorique peut comparer deux offres similaires dont les marques occupent des positions différentes. L'élève doit expliquer les critères de comparaison et éviter d'attribuer des préférences à des personnes non interrogées.\",\n  \"Enfin, la marque doit évoluer avec prudence. Modifier une identité visuelle ou un slogan peut attirer l'attention, mais aussi désorienter les clients si les changements ne sont pas expliqués.\"\n ],\n a3:[\n  \"Le premier argument repose sur la capacité de la marque à simplifier le choix du consommateur. Une offre identifiable et crédible peut réduire l'hésitation au moment de l'achat, sans imposer automatiquement la préférence.\",\n  \"Le deuxième argument concerne la différenciation. Une entreprise peut défendre sa place sur le marché par une qualité de service, une origine, une garantie ou une expérience particulière, plutôt que par le seul prix.\",\n  \"Il convient ensuite de relier les effets commerciaux aux coûts : une campagne coûteuse peut augmenter la notoriété sans améliorer la rentabilité. Le raisonnement doit donc associer indicateurs de perception et résultats financiers.\",\n  \"La réponse finale reste conditionnelle : l'importance de la marque dépend de la cohérence de l'offre, de la confiance du public et de la concurrence. Les constatations sur une entreprise exigeant une enquête seront ajoutées plus tard.\"\n ],\n a4:[\n  \"La construction d'une marque exige des messages cohérents, une qualité régulière et une bonne connaissance de la clientèle. La publicité ne peut durablement remplacer un produit ou un service qui déçoit.\",\n  \"Le budget constitue une limite concrète : les grandes campagnes ne sont pas accessibles à toutes les organisations. Une petite entreprise peut privilégier la proximité et la qualité de la relation client.\",\n  \"Les résultats sont difficiles à attribuer à une seule décision. Une hausse des ventes peut dépendre des prix, des disponibilités, de la saison ou de la concurrence autant que de la communication.\",\n  \"La protection du nom, des signes distinctifs et de la réputation appelle également de la vigilance. Les exigences juridiques doivent être vérifiées dans les règles applicables au pays concerné.\",\n  \"Le terrain pourra éclairer la manière dont une marque choisit ses supports, suit son image et réagit aux critiques. Il ne faut ni inventer une campagne ni supposer qu'elle a réussi.\"\n ]},\n { // 4 - Prix\n a1:[\n  \"Le prix de vente représente la contrepartie demandée au consommateur pour obtenir un produit ou un service. Il contribue au chiffre d'affaires, mais la rentabilité dépend aussi du coût d'achat et des autres charges.\",\n  \"La marge unitaire peut être étudiée en rapprochant le prix de vente hors taxes et le coût pertinent. Pour raisonner correctement, l'élève doit indiquer les montants retenus et distinguer le calcul de la marge du résultat global.\",\n  \"La demande n'évolue pas toujours proportionnellement au prix. Certains clients sont sensibles à de petites variations, tandis que d'autres accordent davantage d'importance à la qualité, à l'habitude ou à la disponibilité.\",\n  \"Les stratégies de prix peuvent chercher à pénétrer un marché, à valoriser une offre ou à répondre à la concurrence. Leur intérêt dépend de la clientèle et de la situation financière de l'organisation.\",\n  \"Une promotion réduit souvent la marge par produit, mais peut accroître les quantités vendues. Il faut donc comparer les gains liés au volume aux diminutions de prix et aux dépenses de communication.\",\n  \"Les prix pratiqués à Djibouti varient selon les commerces, les coûts d'importation et les produits. Seules des observations ou des sources réelles permettront d'affirmer le prix d'une entreprise précise.\"\n ],\n a2:[\n  \"Le sous-thème exige de préciser l'objectif poursuivi : attirer des clients, écouler des stocks, maintenir une marge ou se positionner face à la concurrence. Le même changement de prix n'a pas le même sens dans tous les cas.\",\n  \"La fixation du prix doit prendre en compte les coûts utiles au raisonnement, le prix accepté par le marché et le niveau de concurrence. Aucun de ces facteurs, pris isolément, ne garantit la rentabilité.\",\n  \"Pour suivre les effets, l'élève peut comparer les quantités vendues, le chiffre d'affaires, la marge unitaire et les charges liées à l'opération. Les périodes comparées doivent être suffisamment proches et comparables.\",\n  \"Un exemple chiffré fictif peut montrer qu'une baisse du prix exige parfois de vendre davantage pour retrouver la marge totale initiale. Les calculs devront être présentés clairement avec leurs hypothèses.\",\n  \"Le prix a aussi une dimension psychologique : une offre bon marché peut attirer ou inquiéter selon les attentes de qualité. Cette perception doit être étudiée sans la supposer identique pour tous les acheteurs.\"\n ],\n a3:[\n  \"Le premier élément de réponse concerne l'effet du prix sur le choix du consommateur. Une modification peut encourager ou freiner l'achat, mais son intensité dépend du produit, des revenus et des offres concurrentes.\",\n  \"Le second concerne le résultat financier. Une diminution de prix réduit, toutes choses égales par ailleurs, la marge unitaire ; l'entreprise doit alors vendre un volume supplémentaire ou réduire ses coûts pour compenser.\",\n  \"La politique de prix doit être évaluée dans la durée. Une promotion peut améliorer temporairement les ventes tout en diminuant le résultat si elle attire surtout des clients qui auraient acheté au prix habituel.\",\n  \"La conclusion théorique doit donc confronter objectifs commerciaux et calculs financiers. Les données d'une entreprise djiboutienne ne seront intégrées qu'après collecte réelle des prix, coûts ou observations autorisées.\"\n ],\n a4:[\n  \"Une première limite est l'information disponible sur les coûts. Si une charge importante est oubliée, la marge calculée risque de donner une image trop favorable de l'opération.\",\n  \"Une deuxième limite vient du comportement des consommateurs : la réaction à une remise est difficile à prévoir sans observation. Les besoins et la sensibilité au prix diffèrent selon les clientèles.\",\n  \"La concurrence peut imposer des ajustements rapides. Toutefois, suivre systématiquement le prix le plus faible risque de fragiliser la marge et la qualité du service.\",\n  \"Il convient aussi de contrôler les effets dans le temps. Une hausse des ventes durant une promotion ne démontre pas, à elle seule, que le bénéfice annuel sera supérieur.\",\n  \"Pour relier les connaissances au terrain, l'élève pourra demander quels critères sont pris en compte pour fixer les prix. Aucun tarif ou résultat d'entreprise ne doit être présenté sans source.\"\n ]},\n { // 5 - IA\n a1:[\n  \"L'intelligence artificielle désigne des méthodes informatiques capables d'exploiter des données pour produire une classification, une prévision ou une proposition. L'outil fournit un résultat, mais l'organisation reste responsable de ses décisions.\",\n  \"En gestion financière, ces méthodes peuvent faciliter le classement de documents, le rapprochement de données ou la détection d'anomalies. Leur intérêt dépend de la qualité des informations introduites.\",\n  \"En mercatique, elles peuvent aider à analyser une clientèle, prévoir une demande ou préparer une communication. Les suggestions obtenues ne constituent pas des faits concernant les préférences d'un consommateur précis.\",\n  \"L'automatisation peut faire gagner du temps sur des tâches répétitives. Elle entraîne aussi des frais d'équipement, de formation, de maintenance et de contrôle qui doivent être étudiés.\",\n  \"La confidentialité, l'exactitude et la sécurité des données sont essentielles. Un résultat plausible peut contenir une erreur ; il faut donc toujours effectuer des vérifications humaines avant une utilisation professionnelle.\",\n  \"L'élève doit différencier les usages théoriquement possibles de l'IA et les pratiques effectivement présentes à Djibouti. L'existence d'un outil ou son efficacité ne peuvent être affirmées pour une entreprise sans enquête.\"\n ],\n a2:[\n  \"Pour comprendre l'usage étudié, il faut d'abord définir la tâche concernée : prévision des ventes, analyse des clients, saisie comptable ou recherche d'anomalies. Le résultat attendu doit être décrit avant le choix de l'outil.\",\n  \"L'outil dépend des données qui lui sont confiées. Une base incomplète ou mal classée peut entraîner des recommandations trompeuses ; la vérification de l'origine des informations reste donc indispensable.\",\n  \"On peut apprécier l'apport possible grâce au temps économisé, au nombre d'erreurs détectées et au coût d'utilisation. Ces indicateurs doivent être mesurés plutôt que supposés.\",\n  \"Une illustration hypothétique peut comparer le traitement manuel et le traitement assisté d'un document. Cette comparaison ne prouve pas que l'IA fonctionne mieux dans toutes les situations ou dans tous les secteurs.\",\n  \"La décision finale exige des règles précises : qui contrôle le résultat, comment corriger une erreur et quelles informations ne doivent pas être communiquées à un outil externe ?\"\n ],\n a3:[\n  \"L'argument principal est que l'IA peut accélérer certains traitements et rendre l'analyse plus régulière. Ce gain potentiel concerne surtout les tâches bien définies, fondées sur des données disponibles et vérifiables.\",\n  \"Cependant, une réponse rapide n'est pas nécessairement juste. Une prévision erronée peut entraîner des commandes inutiles ou un mauvais calcul financier ; la supervision humaine garde donc un rôle décisif.\",\n  \"L'évaluation doit confronter avantages et coûts : abonnement, équipement, formation, vérification et protection des informations. Une solution utile sur le plan technique n'est pas toujours rentable financièrement.\",\n  \"La réponse théorique sera donc nuancée : l'outil peut soutenir la gestion, à condition de maîtriser les données, les dépenses et les risques. L'usage réel d'une entreprise ne sera décrit qu'après vérification.\"\n ],\n a4:[\n  \"Une première condition est la fiabilité des données. Des factures en double, des dates incorrectes ou des catégories mal définies peuvent perturber les résultats sans que l'outil signale clairement la cause.\",\n  \"Une deuxième condition concerne la maîtrise des coûts. L'entreprise doit évaluer les dépenses d'abonnement, de formation, de contrôle et de sécurité avant d'attendre un bénéfice de l'automatisation.\",\n  \"Les risques portent sur les erreurs, la confidentialité et la dépendance à un fournisseur informatique. Des consignes claires doivent préciser les tâches que l'outil peut assister et celles qui exigent une validation humaine.\",\n  \"Une solution alternative peut consister à améliorer d'abord l'organisation des fichiers et des procédures comptables, avant d'introduire un logiciel complexe. Les objectifs doivent guider la technologie, et non l'inverse.\",\n  \"La visite pourra vérifier si l'organisation utilise réellement l'IA et dans quelles conditions. L'élève ne doit attribuer aucun outil, coût ou gain de productivité à une entreprise sans preuve.\"\n ]},\n { // 6 - Risques\n a1:[\n  \"Le risque correspond à la possibilité qu'un événement empêche l'organisation d'atteindre ses objectifs. Il se caractérise par une probabilité d'apparition et par des conséquences qui peuvent être financières ou commerciales.\",\n  \"Les risques financiers concernent notamment la trésorerie, les impayés, l'endettement et les variations de coûts. Un retard de règlement peut provoquer une difficulté même lorsque la vente a été enregistrée.\",\n  \"Les risques mercatiques peuvent venir de la concurrence, d'une baisse de la demande ou d'une perte de confiance. Ils sont liés à l'activité commerciale et peuvent ensuite affecter les résultats financiers.\",\n  \"La prévention consiste à réduire la probabilité d'un problème, tandis que la couverture cherche à limiter ses conséquences. Le choix dépend du coût des mesures et de la gravité possible du risque.\",\n  \"Un tableau de suivi peut réunir la nature du risque, son niveau d'importance, les personnes responsables et les mesures envisagées. Il facilite le contrôle sans éliminer totalement l'incertitude.\",\n  \"Dans une organisation djiboutienne, la gestion des risques doit être étudiée à partir de procédures réelles ou de documents fiables. Il faut éviter de supposer l'existence d'une assurance ou d'un dispositif de contrôle.\"\n ],\n a2:[\n  \"Pour traiter le sous-thème, il faut identifier l'événement redouté, les opérations exposées et les conséquences possibles. Un risque n'est pas la même chose qu'une perte déjà constatée.\",\n  \"L'analyse relie ensuite les causes aux effets : un retard de paiement peut ralentir les encaissements, déséquilibrer la trésorerie et gêner les règlements aux fournisseurs.\",\n  \"Les informations à rechercher dépendent du risque : échéances, montants à recevoir, niveau d'endettement, plaintes clients ou évolution des ventes. Elles doivent être datées et correctement classées.\",\n  \"Une illustration hypothétique peut présenter plusieurs factures arrivant à échéance à des dates différentes. Un tableau simple aide à repérer le risque de retard sans prétendre connaître les comptes d'une entreprise visitée.\",\n  \"Les mesures retenues doivent rester proportionnées aux capacités de l'organisation. Un suivi régulier et une procédure claire sont souvent plus utiles qu'une multiplication de contrôles difficiles à appliquer.\"\n ],\n a3:[\n  \"Le premier argument est que l'identification précoce des risques permet de préparer une réponse. Le responsable peut prévoir des contrôles ou répartir les tâches avant qu'une difficulté ne s'aggrave.\",\n  \"Le deuxième argument concerne la continuité de l'activité. Des retards d'encaissement, une forte dette ou des clients mécontents peuvent se traduire par des dépenses imprévues et une baisse des ventes.\",\n  \"Il faut néanmoins comparer le coût d'une mesure préventive avec les conséquences qu'elle cherche à éviter. Une protection trop coûteuse peut elle-même réduire la rentabilité de l'entreprise.\",\n  \"La conclusion théorique doit présenter la gestion des risques comme une démarche d'anticipation et de suivi. Les risques réellement rencontrés par l'organisation choisie devront être établis lors de l'enquête.\"\n ],\n a4:[\n  \"L'identification du risque repose sur des informations exactes et régulièrement mises à jour. Un incident rarement signalé peut donner une fausse impression de sécurité si les documents ne sont pas correctement tenus.\",\n  \"La responsabilité du suivi doit être clairement confiée. Sans calendrier ni personne chargée d'effectuer les vérifications, une mesure décidée sur le papier peut rester inefficace dans la pratique.\",\n  \"Les moyens financiers limitent aussi les choix. L'entreprise doit distinguer les risques les plus graves de ceux qu'elle peut accepter, puis concentrer ses efforts sur les priorités.\",\n  \"Certaines mesures peuvent se compléter : conditions de paiement, suivi de trésorerie, contrôle de qualité et dialogue avec la clientèle. Leurs effets doivent être évalués dans le temps.\",\n  \"L'enquête de terrain pourra documenter les procédures réellement utilisées, les difficultés signalées et les améliorations envisagées. Aucune perte ni mesure interne ne sera inventée.\"\n ]}\n];\n\n/* Développements additionnels : distincts selon les 6 thèmes et distribués sur les paragraphes. */\nconst APPROFONDISSEMENTS = [\n {a1:[\n \"On peut également différencier la fidélité comportementale, visible dans les achats répétés, et l'attachement à une enseigne. Une personne peut revenir par commodité sans être réellement satisfaite.\",\n \"Cette distinction conduit à une précaution méthodologique : l'élève doit justifier les critères retenus et distinguer les affirmations générales des constats réalisés auprès d'une entreprise précise.\"\n ],a2:[\n \"Le suivi peut être organisé de manière simple : déterminer une période, noter le nombre de retours des clients, recueillir les réclamations et mesurer le coût des avantages accordés. Ces informations n'ont de sens que si les conditions d'observation restent comparables. Une baisse des réclamations peut être favorable, mais elle ne remplace pas l'étude des ventes et des marges.\",\n \"Une stratégie efficace tient compte du comportement de la clientèle. Dans un commerce de produits courants, la disponibilité et la rapidité peuvent compter davantage qu'une remise exceptionnelle. Dans les services, la fiabilité, la ponctualité et la résolution des problèmes peuvent jouer un rôle déterminant. Ces comparaisons sont des hypothèses générales, non des résultats d'enquête.\"\n ],a3:[\n \"Pour aller plus loin, l'élève peut envisager deux situations opposées. Dans la première, les clients reviennent plus souvent et le supplément de marge dépasse les dépenses de fidélisation : l'opération contribue alors au résultat. Dans la seconde, les achats augmentent, mais les réductions absorbent le gain : le succès commercial n'est pas nécessairement un succès financier.\",\n \"Cette comparaison montre pourquoi une décision doit être appréciée avec plusieurs indicateurs et non avec le seul nombre de clients. Les coûts directs, les charges de service et la durée des relations commerciales comptent. Il faut enfin préciser qu'une enquête pourrait conduire à nuancer ces hypothèses selon les pratiques et les moyens de l'entreprise choisie.\"\n ],a4:[\n \"La qualité des informations collectées est essentielle. Si le nombre de clients fidèles est déduit de simples impressions du personnel, la mesure reste fragile. Un fichier tenu régulièrement ou une enquête transparente fournit un point de départ plus solide, sous réserve de respecter les données personnelles.\",\n \"Le candidat peut préparer un tableau à deux colonnes réunissant, d'un côté, les actions possibles et, de l'autre, leurs effets attendus et leurs coûts. Cette présentation permettra de poser des questions précises durant l'entretien, mais elle ne doit pas être remplie avec des faits non constatés.\"\n ]},\n {a1:[\n \"Le raisonnement doit distinguer la rentabilité d'un projet, sa capacité à générer des liquidités et la faculté de l'organisation à rembourser. Ces trois dimensions sont liées, mais ne sont pas identiques.\",\n \"L'analyse doit enfin préciser si l'organisation est publique ou privée, car les objectifs, les autorisations et les contraintes de financement peuvent différer sensiblement.\"\n ],a2:[\n \"Un outil utile est le calendrier prévisionnel : il indique quand les dépenses deviennent exigibles et quand les recettes sont attendues. La différence entre les dates peut créer un besoin de trésorerie temporaire. Pour un financement de longue durée, on peut également rapprocher la durée de remboursement de celle d'utilisation de l'investissement, sans oublier les charges d'entretien et de fonctionnement.\",\n \"La comparaison ne doit pas privilégier automatiquement la solution qui apporte le plus d'argent. L'endettement peut permettre d'agir plus vite, mais il impose des obligations futures. L'autofinancement évite certains frais, mais peut réduire les ressources disponibles pour l'activité courante. Le choix résulte d'un arbitrage entre coût, délai, autonomie et risque.\"\n ],a3:[\n \"On peut illustrer ce raisonnement en distinguant un besoin d'exploitation d'un investissement. Le premier dépend souvent du cycle achats, stocks, ventes et encaissements ; le second correspond à l'acquisition d'un moyen durable. Les ressources adaptées ne sont pas forcément les mêmes et leur remboursement ne doit pas compromettre le fonctionnement quotidien.\",\n \"Une décision raisonnable consiste donc à confronter le plan de développement à une prévision des flux monétaires. Si les entrées d'argent prévues ne couvrent pas les échéances, le responsable doit réduire le projet, modifier son calendrier ou chercher une autre solution. L'élève devra expliquer ces alternatives, sans supposer les décisions réelles de l'organisme étudié.\"\n ],a4:[\n \"Un financement peut aussi comporter une incertitude externe : hausse des coûts, demande moins forte, retard de livraison ou changement des conditions commerciales. La prudence consiste à préparer un scénario normal et un scénario moins favorable pour apprécier la capacité à poursuivre le projet.\",\n \"Dans un tableau d'analyse, le candidat peut mettre en regard chaque source de financement, sa durée probable, son avantage et sa principale contrainte. Ce travail sert à préparer la visite. Les données précises d'une organisation, notamment les montants empruntés, ne seront rapportées qu'avec son accord ou à partir de documents publiés.\"\n ]},\n {a1:[\n \"La valeur d'une marque ne se réduit donc pas à son logo. Elle dépend d'une expérience répétée, de l'image construite et de la reconnaissance acquise auprès d'une clientèle donnée.\",\n \"Il est important de séparer les caractéristiques que l'entreprise souhaite mettre en avant et l'image réellement perçue par les consommateurs. Seule une recherche peut établir cette dernière.\"\n ],a2:[\n \"Pour analyser un positionnement, l'élève peut définir quelques critères précis : niveau de prix, qualité perçue, service, accessibilité et originalité de l'offre. Une grille comparative aide à organiser l'information, mais les appréciations doivent provenir de sources consultées ou d'observations réalisées. La seule répétition d'un slogan ne prouve ni l'adhésion des clients ni la performance commerciale.\",\n \"Les réseaux sociaux peuvent accélérer la diffusion d'un message et permettre une interaction avec les consommateurs. Toutefois, les vues et les réactions ne correspondent pas toujours à des achats. Pour évaluer une action, il faut distinguer l'attention obtenue, la confiance créée et les résultats financiers observables, tout en tenant compte des dépenses engagées.\"\n ],a3:[\n \"La force d'une marque peut également se manifester lorsque les consommateurs reconnaissent rapidement une offre et comprennent ce qui la différencie. Cet avantage peut faciliter la communication commerciale et encourager une relation durable. Cependant, il suppose que l'expérience réelle confirme la promesse de qualité, de service ou d'accessibilité faite au client.\",\n \"La réussite ne peut pas être mesurée par la seule popularité. L'entreprise peut être connue sans réaliser suffisamment de ventes rentables. Une analyse pertinente croise donc des indices de notoriété, des éléments de satisfaction et, quand les documents le permettent, les marges et les dépenses de communication. Aucun chiffre ne doit être attribué à une marque sans preuve.\"\n ],a4:[\n \"Une difficulté supplémentaire tient à la rapidité des changements de réputation. Une expérience décevante relayée publiquement peut affaiblir la confiance, même lorsque l'entreprise a investi dans une communication soignée. La prévention passe par une qualité réelle et des réponses adaptées aux réclamations.\",\n \"Le candidat pourra distinguer dans son guide d'entretien les questions sur l'identité de marque, les méthodes de communication et l'évaluation des résultats. Le responsable peut ne pas communiquer de chiffres confidentiels ; une réponse qualitative et vérifiable sera alors préférable à une estimation inventée.\"\n ]},\n {a1:[\n \"La comparaison entre plusieurs politiques de prix suppose que les produits, les conditions de vente et les coûts soient clairement identifiés. Sans cela, les marges calculées ne seraient pas comparables.\",\n \"La TVA, les frais de transport et les remises peuvent modifier les montants présentés sur une facture. Il faut toujours indiquer sur quelle base le calcul est réalisé.\"\n ],a2:[\n \"Pour mesurer le résultat d'une politique de prix, le raisonnement doit distinguer les prix affichés, les prix effectivement payés et les quantités vendues. Une remise peut attirer l'attention, mais l'effet final dépend du nombre d'unités vendues et du coût total de l'opération. Le suivi sur plusieurs périodes aide à ne pas attribuer un changement saisonnier à une simple promotion.\",\n \"On peut également calculer le volume supplémentaire nécessaire pour retrouver la marge totale antérieure. Cette méthode rend les décisions plus concrètes pour l'élève : le prix baisse, la marge unitaire change, puis il faut examiner les ventes nécessaires pour compenser. Tous les chiffres utilisés à titre d'entraînement doivent être annoncés comme fictifs.\"\n ],a3:[\n \"Un prix bas peut favoriser la conquête d'une clientèle, mais il ne suffit pas à construire une rentabilité durable. Si le coût unitaire reste élevé, l'entreprise doit augmenter fortement les volumes ou améliorer son organisation pour préserver sa marge. Inversement, un prix plus élevé peut convenir à une offre perçue comme différente, sans garantir que les clients l'acceptent.\",\n \"Il faut donc rechercher une cohérence entre les coûts, la valeur perçue et les objectifs commerciaux. Une bonne politique de prix peut parfois privilégier une marge raisonnable et stable plutôt qu'une croissance rapide du chiffre d'affaires. La vérification doit porter sur des données réelles et comparables, lorsque l'organisation accepte de les communiquer.\"\n ],a4:[\n \"Une politique de prix comporte aussi un risque d'image. Des réductions très fréquentes peuvent inciter les clients à attendre la prochaine promotion au lieu d'acheter au prix habituel. Il faut donc réfléchir aux effets à court et à long terme.\",\n \"Une grille de préparation peut présenter, pour chaque stratégie, son objectif, ses avantages, ses limites et les informations nécessaires pour l'évaluer. Cette grille pourra ensuite guider les questions adressées au responsable commercial, sans anticiper ses réponses.\"\n ]},\n {a1:[\n \"Il est nécessaire de différencier les systèmes automatiques ordinaires des applications utilisant l'IA. Le simple fait d'employer un logiciel de comptabilité ne prouve pas qu'une entreprise utilise l'intelligence artificielle.\",\n \"Le candidat doit également savoir que des données d'entraînement anciennes ou déséquilibrées peuvent produire des résultats inadaptés à un marché ou à une entreprise donnée.\"\n ],a2:[\n \"L'analyse doit distinguer la collecte des données, le traitement effectué par l'outil et l'utilisation professionnelle du résultat. Cette succession d'étapes évite de croire qu'une prévision ou une recommandation constitue une décision certaine. Une entreprise peut obtenir une estimation correcte tout en faisant un mauvais choix si les coûts, les délais ou les risques ont été négligés.\",\n \"Il est possible de présenter un protocole de vérification : sélectionner un petit ensemble de documents, comparer les résultats automatisés à un contrôle humain et noter les écarts. Une telle proposition décrit une méthode théorique ; elle ne signifie pas qu'un test a effectivement été réalisé. Les données sensibles ou nominatives doivent rester protégées.\"\n ],a3:[\n \"Pour apprécier le gain potentiel, il faut choisir un indicateur adapté à la tâche. La rapidité peut être pertinente pour le classement des factures, tandis que la précision des estimations importe pour la prévision des ventes. Dans les deux cas, une amélioration mesurée sur un petit échantillon peut ne pas se reproduire dans toutes les situations.\",\n \"Le contrôle humain doit donc être organisé et budgété. La performance ne repose pas seulement sur l'outil, mais aussi sur la qualité des données, la formation du personnel et la correction des anomalies. La théorie conduit à envisager une adoption progressive, avec des objectifs vérifiables et un suivi des coûts réels.\"\n ],a4:[\n \"Une organisation peut également rencontrer une résistance au changement : certains collaborateurs redoutent de perdre leurs habitudes ou comprennent mal les résultats fournis. La formation et des règles de contrôle accessibles favorisent une utilisation plus prudente et mieux acceptée.\",\n \"Dans le dossier, il faudra séparer ce qui est techniquement possible de ce que fait véritablement l'entreprise choisie. Les entretiens pourront porter sur les outils, les tâches concernées, les validations humaines et les difficultés observées, sans demander de données confidentielles.\"\n ]},\n {a1:[\n \"Une perte n'est pas toujours immédiate : certains risques financiers apparaissent d'abord comme un retard, une incertitude ou une difficulté de paiement avant de se traduire dans les comptes.\",\n \"La hiérarchisation des risques repose sur leur probabilité et leur gravité. Cette évaluation aide à choisir les mesures de contrôle les plus importantes pour l'organisation.\"\n ],a2:[\n \"La prévention suppose de définir un seuil d'alerte et une manière de réagir. Par exemple, une échéance non respectée peut déclencher une relance, puis un contrôle plus approfondi. Il ne s'agit pas d'une pratique attribuée à une entreprise particulière, mais d'une méthode théorique de surveillance qui doit être adaptée au contexte et aux moyens disponibles.\",\n \"L'analyse peut distinguer les risques internes, liés à l'organisation des tâches ou au contrôle, et les risques externes, liés à la demande ou à l'environnement économique. Les responsables ne disposent pas des mêmes moyens d'action sur chacun d'eux. Cette distinction permet d'éviter de proposer des mesures de prévention qui ne répondraient pas aux causes réelles.\"\n ],a3:[\n \"Une démarche de gestion des risques peut être présentée en quatre temps : identifier le danger, estimer son importance, préparer une réponse et vérifier les résultats. Elle reste utile même pour une petite structure, à condition de conserver des outils simples. Un tableau d'échéances, par exemple, facilite le suivi des règlements sans garantir à lui seul leur paiement.\",\n \"Il faut enfin rappeler que le risque ne peut pas être supprimé entièrement. Une entreprise peut prendre une décision prudente et subir malgré tout un événement défavorable. La qualité de la gestion se juge donc aussi à la préparation, à la traçabilité et à la capacité de réaction, et pas seulement à l'absence d'incident.\"\n ],a4:[\n \"Un contrôle efficace doit être compréhensible par les personnes qui l'appliquent. Des procédures trop complexes risquent d'être abandonnées ; à l'inverse, l'absence de suivi peut laisser une difficulté se développer sans alerte.\",\n \"Dans la préparation de l'enquête, on peut établir la liste des principaux risques du thème, puis noter pour chacun les questions à poser et les documents éventuellement consultables. Les réponses de l'entreprise seront ajoutées seulement après une observation ou un entretien réel.\"\n ]}\n];\n\nconst COMPLEMENTS_BINOME = [\n\"Une démarche de suivi peut être construite autour de questions concrètes : l'action est-elle clairement identifiée, à quels clients s'adresse-t-elle, quelles dépenses entraîne-t-elle et quel résultat souhaite-t-on mesurer ? Il est également utile de prévoir une comparaison avant et après l'action, en signalant les changements de saison ou de concurrence qui pourraient influencer les chiffres. Ce raisonnement empêche de considérer toutes les ventes supplémentaires comme un effet certain de la fidélisation. Pour le dossier, les élèves pourront établir une grille réunissant les objectifs, les moyens et les indicateurs possibles. Cette grille reste théorique tant qu'elle n'a pas été confrontée aux documents ou aux réponses de l'entreprise visitée. Les résultats devront être présentés avec prudence, y compris lorsqu'ils ne correspondent pas aux attentes initiales.\",\n\"Il peut être utile de construire un tableau prévisionnel distinguant trois moments : le besoin de financement, l'obtention des ressources et les règlements à effectuer. Ce tableau permet de voir que les dépenses et les encaissements ne se produisent pas nécessairement le même jour. La décision peut ensuite être examinée selon plusieurs situations : ventes conformes aux attentes, retard d'encaissement ou augmentation imprévue du coût du projet. Ces scénarios n'ont pas pour but de prédire exactement l'avenir, mais de repérer les risques de trésorerie. Dans le dossier, les deux candidats peuvent également distinguer les informations financières publiques, consultables dans des documents officiels, et les données internes qui ne doivent être utilisées qu'avec l'accord de l'organisation. Cette précaution protège la crédibilité de leur étude.\",\n\"Pour prolonger l'analyse, on peut distinguer trois types de preuves : ce que la marque affirme dans ses propres messages, ce que le client déclare en penser et ce que les comportements d'achat permettent d'observer. Ces informations ne sont pas équivalentes. Une campagne peut être appréciée sans se traduire par des ventes ; une hausse de fréquentation peut survenir pour d'autres raisons que la publicité. Le candidat doit donc expliquer les limites de chaque indicateur et éviter les conclusions hâtives. Le dossier peut proposer une grille de lecture des supports utilisés par l'entreprise, comprenant le message, le public visé, le canal de diffusion et le coût éventuel. Cette grille sera remplie seulement à partir des documents disponibles ou de l'entretien. Une distinction claire entre hypothèse, preuve et interprétation facilitera la synthèse finale.\",\n\"Une méthode de contrôle simple consiste à présenter une situation initiale et deux hypothèses de prix, sans faire passer ces montants pour ceux d'une entreprise réelle. Pour chaque hypothèse, l'élève calcule la marge unitaire et explique quelles quantités il faudrait vendre pour obtenir la même marge totale. Ce raisonnement rend visible la relation entre prix, coût et volume. Il faut ensuite préciser les facteurs non chiffrés : qualité perçue, disponibilité, concurrence ou saison. Ces facteurs peuvent modifier les achats et rendent toute prévision incertaine. Le tableau comparatif préparé pour le terrain pourra distinguer la stratégie théorique et les pratiques réellement décrites par un responsable. Les élèves ne devront pas fabriquer de tarifs, de bénéfices ni de réactions de consommateurs. Une hypothèse doit toujours rester présentée comme une hypothèse.\",\n\"L'évaluation d'un outil d'IA peut être organisée autour de questions précises : quelle tâche doit-il accomplir, quelles données utilise-t-il, quelle personne contrôle ses résultats et quel coût entraîne son fonctionnement ? Cette grille permet de traiter ensemble les dimensions technique, humaine et financière. On peut ensuite imaginer trois situations : un résultat exact validé par l'utilisateur, une proposition imprécise nécessitant une correction et une donnée confidentielle qui ne doit pas être transmise. Il s'agit d'exemples pédagogiques et non d'observations réelles. Les élèves peuvent préparer un protocole de vérification sans réaliser de test sur des informations sensibles. La recherche de terrain devra distinguer les logiciels de gestion ordinaires des solutions utilisant véritablement l'intelligence artificielle. Une simple déclaration commerciale ne remplace pas une vérification des fonctionnalités annoncées.\",\n\"Pour compléter le raisonnement, on peut établir une matrice simple des risques : nature du danger, probabilité estimée, gravité possible, mesure de prévention et responsable du suivi. L'élève doit expliquer que ces appréciations reposent sur des informations disponibles et peuvent évoluer avec le temps. Un risque peu probable mais très grave peut mériter une attention particulière ; un risque fréquent mais limité peut être traité par une procédure quotidienne. Il convient ensuite de différencier la prévention, qui tente d'empêcher l'incident, de la réponse, qui cherche à réduire ses conséquences lorsqu'il survient. Cette distinction aide à poser des questions utiles durant l'entretien. Aucun montant de perte, incident ou dispositif interne ne sera présenté comme un fait sans preuve. Les propositions théoriques restent à confronter à l'organisation étudiée.\"\n];\n\nfunction generateTexts(){if(EGEAcademic.seriesOf(data)!=='GFM')return null;const t=theme(),s=subject();if(!t||!s||!data.problem)return null;let n=s.notes,k=t.title,topic=s.name,p=data.problem;\nlet a1=t.general.map((x,i)=>x+\" \"+EXPAND[data.theme][i]+\" \"+DEVELOPPEMENTS[data.theme].a1[i]);\nlet a2=[`Le sous-thème « ${topic} » précise une question de gestion étudiée dans le thème « ${k} ». ${n[0]}. L'objectif est de comprendre les notions essentielles et de relier les décisions prises aux résultats possibles.`,\n`Le mécanisme principal peut s'expliquer simplement. ${n[1]}. Pour comprendre ce lien, il faut identifier la décision de l'organisation, les ressources mobilisées et les effets recherchés.`,\n`Les informations utiles pour étudier ce sujet doivent pouvoir être décrites ou mesurées. ${n[2]}. Il convient de préciser la période observée et de ne pas confondre une opinion avec un fait établi.`,\nEXAMPLES[data.theme],\n`Cette analyse comporte des limites. ${n[3]}. Les pratiques réelles d'une entreprise ne pourront être décrites qu'après vérification auprès de cette organisation ou à partir de documents fiables.`];\nlet a3=[`La problématique retenue est : « ${p} » Elle invite à examiner les relations entre les décisions de gestion, les moyens utilisés et les résultats obtenus. La réponse théorique doit être argumentée, et non limitée à une définition.`,\n`Un premier élément de réponse repose sur les mécanismes étudiés. ${n[1]}. Lorsque l'organisation adapte ses moyens à ses objectifs, elle peut obtenir un effet favorable, mais ce résultat n'est jamais automatique.`,\n`Un deuxième élément concerne les critères de vérification. ${n[2]}. L'étude doit distinguer les indicateurs observables et les interprétations. ${EXAMPLES[data.theme]}`,\n`Enfin, la réponse doit tenir compte des limites du sujet. ${n[3]}. Sur le plan théorique, la décision doit être évaluée en fonction de son efficacité, de son coût et de ses risques. Une réponse définitive sur une entreprise précise exige une investigation réelle.`];\nlet a4=[`Cette annexe complète l'étude de « ${topic} » en examinant les conditions d'application et les limites de la démarche.`, `Une première condition est la qualité de l'information disponible. ${n[2]}.`, `Une deuxième condition est l'adéquation des moyens aux objectifs. ${n[1]}.`, `Le principal point de vigilance est le suivant : ${n[3]}.`, 'La conclusion d’une étude doit distinguer ce que la théorie permet d’expliquer, ce qui est seulement supposé et ce qui a été vérifié sur le terrain.'];\na1[1]+=' '+APPROFONDISSEMENTS[data.theme].a1[0];\na1[5]+=' '+APPROFONDISSEMENTS[data.theme].a1[1];\nlet A2=a2.map((x,i)=>x+' '+ENRICH2[i]+' '+DEVELOPPEMENTS[data.theme].a2[i]);\nA2[1]+=' '+APPROFONDISSEMENTS[data.theme].a2[0];\nA2[3]+=' '+APPROFONDISSEMENTS[data.theme].a2[1];\nlet A3=a3.map((x,i)=>x+' '+ENRICH3[i]+' '+DEVELOPPEMENTS[data.theme].a3[i]);\nA3[1]+=' '+APPROFONDISSEMENTS[data.theme].a3[0];\nA3[3]+=' '+APPROFONDISSEMENTS[data.theme].a3[1];\nlet A4=a4.map((x,i)=>x+' '+ENRICH4[i]+' '+DEVELOPPEMENTS[data.theme].a4[i]);\nA4[1]+=' '+APPROFONDISSEMENTS[data.theme].a4[0];\nA4[4]+=' '+APPROFONDISSEMENTS[data.theme].a4[1]+' '+COMPLEMENTS_BINOME[data.theme];\nreturn [a1,A2,A3,A4].map(a=>a.join('\\n\\n'));}\nfunction ensureAnnexes(){let gen=generateTexts();if(!gen)return;for(let i=1;i<=(data.mode==='binome'?4:3);i++){if(typeof data.annexes[i]!=='string'||!clean(data.annexes[i]))data.annexes[i]=gen[i-1];}}\n\n// Recherche directe : API MediaWiki avec CORS origin=*, sans clé secrète.\n// Le mode avancé appelle un backend séparé : aucune clé de modèle dans le HTML.\nconst RESEARCH_CONFIG_KEY='ege-gfm-recherche-config-v1';\nconst AXES_WEB=[\n ['fidélisation client','satisfaction client','rentabilité économique'],\n ['financement des entreprises','fonds de roulement','investissement'],\n ['image de marque','marketing','notoriété'],\n ['politique de prix','prix de vente','rentabilité'],\n ['intelligence artificielle','marketing numérique','comptabilité'],\n ['risque financier','trésorerie','gestion des risques']\n];\nlet researchResults={},researchBusy=false;\nlet researchConfig={endpoint:'',code:''};\ntry{researchConfig={...researchConfig,...JSON.parse(localStorage.getItem(RESEARCH_CONFIG_KEY)||'{}')}}catch(e){}\n// Ne jamais conserver le code d'accès dans un fichier de sauvegarde d'élève.\nresearchConfig.code='';\nfunction researchPanel(n){\n let existing=data.researchEvidence?.[n]?.length||0;\n return `<section class=\"researchbox\" aria-label=\"Recherche sur Internet\">\n <div class=\"research-title\">Recherche documentaire sur Internet</div>\n <div class=\"research-sub\">Recherche de documents réels liés à ton thème et ton sous-thème. Tu lis les résultats, choisis les documents pertinents et conserves leurs références.</div>\n <div class=\"research-actions\"><button type=\"button\" class=\"btn btn-primary\" id=\"webSearch\">⌕ Rechercher des documents</button><button type=\"button\" class=\"btn btn-outline\" id=\"deepResearch\">✦ Rédiger à partir du Web (IA)</button></div>\n <div class=\"research-status\" id=\"researchStatus\" role=\"status\" aria-live=\"polite\">${existing?existing+' source(s) déjà ajoutée(s).':''}</div>\n <div id=\"researchResults\"></div>\n <div class=\"research-bottom\" id=\"researchBottom\" hidden><button type=\"button\" id=\"insertSources\" class=\"btn btn-primary\">Ajouter les documents sélectionnés à l’annexe</button></div>\n <details class=\"research-config\"><summary>Configurer la recherche approfondie (facultatif)</summary>\n <div class=\"research-sub\" style=\"margin-top:9px\">La recherche gratuite utilise Wikipédia. Pour une synthèse plus complète avec recherches sur plusieurs sites, connecte un service sécurisé déployé sur Vercel. Ne saisis jamais de clé OpenAI ici.</div>\n <label for=\"researchEndpoint\">Adresse du service de recherche</label>\n <input type=\"url\" id=\"researchEndpoint\" placeholder=\"https://mon-site.vercel.app/api/ege-recherche\" value=\"${h(researchConfig.endpoint||'')}\">\n <label for=\"researchAccessCode\">Code d'accès du service (si configuré)</label>\n <input type=\"password\" id=\"researchAccessCode\" placeholder=\"Code du professeur (facultatif)\" autocomplete=\"off\">\n <button type=\"button\" class=\"btn btn-outline\" id=\"saveResearchConfig\">Enregistrer l’adresse</button></details>\n <div class=\"research-references\">Les données de l'élève ne sont pas transmises : seules les informations du sujet et le numéro de l'annexe sont utilisés.</div>\n </section>`;\n}\nconst WEB_STOP=new Set('la le les de des du d une un et sur pour dans par au aux avec son sa ses l en à comme quelles quels comment quel quelle sont est impact rôle gestion financières financière commercial commerciale entreprises entreprise organisations organisation leurs prix prix les peut elle leur quoi les sont'.split(' '));\nfunction subjectTerms(){let s=subject()?.name||'',k=s.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').replace(/[^a-z\\s-]/g,' '),terms=k.split(/\\s+/).filter(w=>w.length>3&&!WEB_STOP.has(w));return [...new Set(terms)].slice(0,5)}\nfunction wikiQueries(){const concepts=EGEAcademic.seriesOf(data)==='GFM'?(AXES_WEB[data.theme]||AXES_WEB[0]):[theme()?.title||'gestion des ressources humaines','organisation du travail','gestion des ressources humaines'],words=subjectTerms();return [...new Set([words.slice(0,3).join(' '),concepts[Math.min(2,Math.max(0,data.subtheme%3))],concepts[0]])].filter(Boolean).slice(0,3)}\nfunction shortenText(text,max=650){const t=String(text||'').replace(/\\s+/g,' ').trim();if(t.length<=max)return t;const cut=t.slice(0,max),p=Math.max(cut.lastIndexOf('. '),cut.lastIndexOf('; '));return cut.slice(0,p>max*.55?p+1:max).trim()+'…'}\nasync function wikiFetch(query,timeout=13000){\n const u=new URL('https://fr.wikipedia.org/w/api.php');\n const params={action:'query',generator:'search',gsrsearch:query,gsrnamespace:'0',gsrlimit:'7',prop:'extracts|info',exintro:'1',explaintext:'1',exchars:'1200',exlimit:'max',inprop:'url',format:'json',formatversion:'2',origin:'*'};\n Object.entries(params).forEach(([k,v])=>u.searchParams.set(k,v));\n const c=new AbortController();const t=setTimeout(()=>c.abort(),timeout);\n try{\n  const r=await fetch(u.toString(),{signal:c.signal,credentials:'omit',mode:'cors'});\n  if(!r.ok)throw new Error('Service Wikipédia indisponible ('+r.status+')');\n  const j=await r.json();if(j.error)throw Error(j.error.info||'Erreur du service documentaire');\n  return (j.query?.pages||[]).filter(x=>x.title&&x.extract&&x.extract.length>90).map(x=>({id:'w-'+x.pageid,title:x.title,url:x.fullurl||('https://fr.wikipedia.org/wiki/'+encodeURIComponent(x.title.replace(/ /g,'_'))),extract:shortenText(x.extract,1050),source:'Wikipédia (français)',licence:'CC BY-SA',score:x.index??100}));\n }finally{clearTimeout(t)}\n}\nasync function searchWebResearch(n){\n if(!navigator.onLine)throw Error('Internet semble désactivé. Active les données mobiles ou le Wi-Fi.');\n let errors=[],found=new Map();\n for(const q of wikiQueries()){\n  try{for(const item of await wikiFetch(q))if(!found.has(item.url))found.set(item.url,item)}\n  catch(e){errors.push(e.message)}\n  if(found.size>=8)break;\n }\n if(!found.size)throw Error(errors.length?errors[0]:'Aucun document trouvé. Essaie un autre sous-thème ou la recherche approfondie.');\n return [...found.values()].slice(0,9);\n}\nfunction setResearchStatus(text){const e=$('researchStatus');if(e)e.textContent=text}\nfunction showResearchResults(n,results){\n const el=$('researchResults');if(!el)return;\n el.innerHTML=results.map((r,i)=>`<article class=\"research-result\"><div class=\"research-result-head\"><input type=\"checkbox\" id=\"rcheck${i}\" data-research-check=\"${i}\" ${i<2?'checked':''}><div><label class=\"research-result-title\" for=\"rcheck${i}\">${h(r.title)}</label><div class=\"research-result-desc\">${h(shortenText(r.extract,380))}</div><a href=\"${h(r.url)}\" target=\"_blank\" rel=\"noopener noreferrer\">Ouvrir et vérifier ce document ↗</a></div></div></article>`).join('');\n $('researchBottom').hidden=false;setResearchStatus(results.length+' documents repérés. Ouvre les sources avant de les utiliser.');\n}\nfunction selectedResearchSources(n){let rs=researchResults[n]||[];return [...document.querySelectorAll('[data-research-check]:checked')].map(x=>rs[Number(x.dataset.researchCheck)]).filter(Boolean).slice(0,3)}\nfunction useSelectedDocumentarySources(n){\n let selected=selectedResearchSources(n);\n if(!selected.length){setResearchStatus('Sélectionne au moins un document.');return}\n const records=selected.map(r=>`Wikipédia, « ${r.title} », ${r.url} (CC BY-SA ; consulté le ${new Date().toLocaleDateString('fr-FR')}).`);\n const current=clean(data.sources[n]||'');\n data.sources[n]=[current,...records.filter(x=>!current.includes(x.match(/https?:\\/\\/[^ ]+/)?.[0]||'__absent__'))].filter(Boolean).join('\\n');\n data.sourceChecks[n]=false;\n const extracts=selected.map(r=>`Selon l'article « ${r.title} » publié sur Wikipédia, ${shortenText(r.extract,510)}\\n(Cette information est à confronter aux autres sources et à reformuler.)`);\n const old=clean(data.annexes[n]);\n // On ne remplace pas le travail personnel : les notes sont ajoutées seulement si la limite A4 le permet.\n const room=Math.max(0,700-wordcount(old)-10);let selectedTexts=[];\n for(const paragraph of extracts){if(wordcount([...selectedTexts,paragraph].join('\\n\\n'))<=room)selectedTexts.push(paragraph)}\n if(selectedTexts.length){data.annexes[n]=old+'\\n\\n'+selectedTexts.join('\\n\\n');}\n data.researchEvidence[n]=[...(data.researchEvidence[n]||[]),...selected.map(({title,url,source})=>({title,url,source}))].slice(-12);\n save();render();\n setResearchStatus(selected.length+' source(s) ajoutée(s) aux références.'+(selectedTexts.length?' Des passages documentaires ont été ajoutés au texte.':' Le texte était trop long : les références sont ajoutées, mais le contenu A4 reste inchangé.'));\n toast('Documents ajoutés. Ouvre les liens et vérifie leur contenu.');\n}\nfunction saveOnlineConfig(){let el=$('researchEndpoint'),code=$('researchAccessCode');researchConfig.endpoint=clean(el?.value||'');researchConfig.code=code?.value||researchConfig.code;try{localStorage.setItem(RESEARCH_CONFIG_KEY,JSON.stringify({endpoint:researchConfig.endpoint}))}catch(e){}toast('Adresse du service enregistrée. Le code n’est pas conservé.');}\nfunction getEndpoint(){\n if(researchConfig.endpoint)return researchConfig.endpoint;\n if(['http:','https:'].includes(location.protocol))return new URL('/api/ege-recherche',location.href).href;\n return '';\n}\nasync function deepResearch(n){\n const endpoint=getEndpoint();\n if(!endpoint){setResearchStatus('Pour la rédaction IA, renseigne l’adresse du service dans « Configurer la recherche approfondie ». La recherche Wikipédia reste accessible sans service.');return}\n if(!/^https:\\/\\//.test(endpoint)&&!/^http:\\/\\/localhost(?::\\d+)?\\//.test(endpoint)){setResearchStatus('L’adresse du service doit utiliser HTTPS (sauf localhost en test).');return}\n if(researchBusy)return;\n researchBusy=true;const button=$('deepResearch');if(button)button.disabled=true;\n setResearchStatus('Recherche approfondie en cours…');\n const ctrl=new AbortController(),timer=setTimeout(()=>ctrl.abort(),85000);\n try{\n  const r=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json',...(researchConfig.code?{'X-EGE-Access-Code':researchConfig.code}:{})},body:JSON.stringify({theme:theme()?.title,subtheme:subject()?.name,problematique:data.problem,annexe:n}),signal:ctrl.signal});\n  const response=await r.json().catch(()=>({error:'Réponse non valide du service'}));\n  if(!r.ok)throw Error(response.error||'Service indisponible (HTTP '+r.status+')');\n  if(!response.text||!Array.isArray(response.sources)||response.sources.length<1)throw Error('Aucune synthèse vérifiable reçue. Réessaie.');\n  const draft=clean(response.text);if(wordcount(draft)<170||wordcount(draft)>720)throw Error('La synthèse reçue ne respecte pas la longueur attendue (170–720 mots).');\n  if(!await window.MBDialog.confirm('Remplacer le texte de cette annexe par la synthèse documentée ? Ton texte actuel sera conservé en sauvegarde interne.'))return;\n  data.annexBackup[n]=data.annexes[n];data.annexes[n]=draft;\n  const refs=response.sources.slice(0,4).map(x=>`${x.title||'Document en ligne'} — ${x.url} (consulté le ${new Date().toLocaleDateString('fr-FR')})`);\n  data.sources[n]=refs.join('\\n');data.sourceChecks[n]=false;\n  data.researchEvidence[n]=response.sources.slice(0,4);save();render();setResearchStatus('Synthèse intégrée. Lis les sources en ouvrant leurs liens, puis vérifie la pertinence de chaque paragraphe.');\n  toast('Recherche approfondie intégrée dans l’annexe.');\n }catch(e){setResearchStatus('Recherche approfondie impossible : '+e.message+'. Tu peux toujours utiliser la recherche gratuite Wikipédia.');}\n finally{clearTimeout(timer);researchBusy=false;const b=$('deepResearch');if(b)b.disabled=false;}\n}\nfunction bindResearchPanel(){\n const search=$('webSearch');if(!search)return;\n const n=Number(data.step.slice(-1));\n if(researchResults[n]?.length)showResearchResults(n,researchResults[n]);\n search.onclick=async()=>{\n  if(researchBusy)return;researchBusy=true;search.disabled=true;setResearchStatus('Recherche sur Internet…');$('researchResults').innerHTML='';$('researchBottom').hidden=true;\n  try{const rs=await searchWebResearch(n);researchResults[n]=rs;showResearchResults(n,rs)}\n  catch(e){setResearchStatus('Recherche impossible : '+e.message+' Pour une recherche plus large, configure la recherche approfondie.')}\n  finally{researchBusy=false;if($('webSearch'))$('webSearch').disabled=false}\n };\n $('insertSources').onclick=()=>useSelectedDocumentarySources(n);\n $('saveResearchConfig').onclick=saveOnlineConfig;\n $('deepResearch').onclick=()=>deepResearch(n);\n}\nfunction valid(){if(data.step==='series')return EGEAcademic.series.includes(data.series);if(data.step==='mode')return !!data.mode;if(['student','partner','className','school'].includes(data.step))return clean(data[data.step]).length>=2;if(data.step==='theme')return Number.isInteger(data.theme);if(data.step==='subtheme')return !!subject();if(data.step==='problem')return wordcount(data.problem)>0;if(data.step.startsWith('annex')){const n=Number(data.step.slice(-1));return wordcount(data.annexes[n])>=75&&wordcount(data.annexes[n])<=720&&!!clean((data.annexTitles||{})[n]||titles()[n-1])&&!!clean(data.sources[n]);}return true}\nfunction next(){if(data.step!=='welcome'){try{EGEStage.mark('legacy_'+data.step,data)}catch(e){toast(e.message);return}}if(!valid()){toast('Cette réponse doit être complétée avant de continuer.');return}if(data.step==='problem')ensureAnnexes();let st=allSteps(),i=activeIndex();data.step=st[Math.min(i+1,st.length-1)].id;maxReached=Math.max(maxReached,i+1);save();render();window.scrollTo(0,0);}\nfunction prev(){let st=allSteps(),i=activeIndex();data.step=st[Math.max(0,i-1)].id;save();render();window.scrollTo(0,0);}\nfunction option(label,desc,selected,action,val,n){return `<button class=\"choice ${selected?'selected':''}\" data-choice=\"${action}\" data-value=\"${h(val)}\"><span class=\"${n?'topicnum':'roundcheck'}\">${n?h(n):selected?'✓':''}</span><span><span class=\"choicetitle\">${h(label)}</span>${desc?`<span class=\"choicedesc\" style=\"display:block\">${h(desc)}</span>`:''}</span></button>`;}\nfunction header(kicker,q,desc){return `<div class=\"eyebrow\"><span class=\"number\">✓</span>${h(kicker)}</div><h1>${h(q)}</h1>${desc?`<p class=\"intro\">${h(desc)}</p>`:''}`}\nfunction field(key,placeholder,help=''){return `<label class=\"fieldlabel\" for=\"inputVal\">Ta réponse</label><input class=\"field\" id=\"inputVal\" autocomplete=\"off\" data-key=\"${key}\" value=\"${h(data[key])}\" placeholder=\"${h(placeholder)}\" maxlength=\"180\">${help?`<div class=\"help\">${h(help)}</div>`:''}`}\nfunction sourceComplete(i){return /(?:^|\\s)https:\\/\\/[^\\s<>\"']+\\.[^\\s<>\"']+/i.test(clean(data.sources[i]))&&!!data.sourceChecks[i]}\nfunction documentReady(){let ct=data.mode==='binome'?4:3;return !!data.student&&!!subject()&&!!data.problem&&Array.from({length:ct},(_,j)=>sourceComplete(j+1)&&wordcount(data.annexes[j+1])>=75).every(Boolean)}\nfunction reviewList(){let ct=data.mode==='binome'?4:3;let items=[['Identité et établissement',!!data.student&&!!data.school],['Thème et sous-thème officiels',!!subject()],['Problématique',!!clean(data.problem)]];for(let i=1;i<=ct;i++)items.push(['Annexe '+i+' rédigée',wordcount(data.annexes[i])>=75]);for(let i=1;i<=ct;i++)items.push(['Source de l’annexe '+i+' déclarée vérifiée',sourceComplete(i)]);return items}\nfunction visitQuestions(){let n=subject()?.name||'ce sujet';return [\"Pouvez-vous présenter les activités principales de votre organisation ?\",`Quelle importance accordez-vous au sujet suivant : ${n} ?`,\"Quelles méthodes votre organisation utilise-t-elle dans ce domaine ?\",\"Quels avantages en attendez-vous ?\",\"Quels coûts ou difficultés rencontrez-vous ?\",\"Comment mesurez-vous les résultats des actions engagées ?\",\"Quelles améliorations envisagez-vous ?\"]}\nfunction screen(){let s=subject(),t=theme(),k=data.step;if((k==='subtheme'&&!t)||(k==='problem'&&!s)){data.step=t?'subtheme':'theme';return screen()}\nswitch(k){\ncase 'welcome':return `<div class=\"welcome\"><div class=\"hero-kicker\">Assistant pédagogique · Bac ${h(EGEAcademic.seriesOf(data))} 2027</div><h1>Ton dossier EGE, sans confusion.</h1><p>Choisis ton sujet, comprends-le et construis tes annexes théoriques. À la fin, récupère un vrai document Word fondé sur le modèle de référence.</p><div class=\"quickpoints\"><div class=\"quickpoint\"><b>${egeCatalog().reduce((n,t)=>n+t.subthemes.length,0)}</b><span>sous-thèmes disponibles pour ${h(EGEAcademic.seriesOf(data))}</span></div><div class=\"quickpoint\"><b>1</b><span>question à la fois</span></div><div class=\"quickpoint\"><b>Word</b><span>modifiable et fidèle au modèle</span></div></div><div class=\"welcome-actions\"><button class=\"btn btn-primary\" id=\"startBtn\">${data.student?'Reprendre mon dossier':'Commencer mon dossier'} →</button><button class=\"btn btn-outline\" id=\"importWelcome\">Importer Word / JSON</button></div><div class=\"notice\">ⓘ Le parcours et le Word restent utilisables hors connexion. Pour rechercher des documents réels, active Internet et utilise le bouton « Rechercher des documents » dans les annexes. Aucune visite n’est inventée.</div></div>`;\ncase 'mode':return header('Mon identité · 1/6','Tu travailles seul ou en binôme ?','Le nombre d’annexes et le dossier Word s’adapteront automatiquement.')+`<div class=\"choicegrid\">${option('Travail individuel','1 candidat · 3 annexes',data.mode==='individuel','mode','individuel')}${option('Travail en binôme','2 candidats · 4 annexes',data.mode==='binome','mode','binome')}</div>`;\ncase 'series':return header('Ma scolarité','Quelle est ta série ?','Les thèmes et les classes dépendent de ta série.')+`<div class=\"choicegrid\">${EGEAcademic.series.map(value=>option(value,value==='IAG'?'Thèmes officiels en attente de réception':'Thèmes officiels 2026–2027',EGEAcademic.seriesOf(data)===value,'series',value)).join('')}</div>`;\ncase 'student':return header('Mon identité','Quel est ton nom complet ?','Écris ton nom tel qu’il doit apparaître sur ta page de garde.')+field('student','Ex. : Ali Ahmed Mohamed');\ncase 'partner':return header('Mon identité','Quel est le nom de ton binôme ?','Le document Word présentera les deux candidats.')+field('partner','Nom complet du deuxième candidat');\ncase 'className':return header('Mon identité','Quelle est ta classe ?','Utilise l’intitulé exact de ta classe.')+`<label class=\"fieldlabel\" for=\"inputVal\">Classe · ${h(EGEAcademic.seriesOf(data))}</label><select class=\"field\" id=\"inputVal\" data-key=\"className\">${EGEAcademic.options(EGEAcademic.classes[EGEAcademic.seriesOf(data)],data.className,'Choisir une classe',true)}</select>`;\ncase 'school':return header('Mon identité','Quel est ton établissement ?','Le nom sera repris dans l’en-tête et sur la page de garde.')+`<label class=\"fieldlabel\" for=\"inputVal\">Établissement</label><select class=\"field\" id=\"inputVal\" data-key=\"school\">${EGEAcademic.options(EGEAcademic.schools,data.school,'Choisir un établissement',true)}</select>`;\ncase 'teacher':return header('Mon identité','Quel est le nom de ton professeur ?','Tu peux laisser cette réponse vide et revenir plus tard.')+field('teacher','Nom du professeur (facultatif)');\ncase 'theme':if(!egeCatalog().length)return header('Série IAG','Référentiel en attente','Les thèmes et sous-thèmes officiels seront proposés après réception du document validé. Tes informations sont conservées.');return header('Mon sujet · étape 1','Choisis ton thème officiel','Ces six thèmes proviennent du référentiel validé pour 2026-2027.')+`<div class=\"choicegrid\">${egeCatalog().map((v,i)=>option(v.title,v.subthemes.length+' sous-thèmes officiels',data.theme===i,'theme',i,'0'+(i+1))).join('')}</div>`;\ncase 'subtheme':return header('Mon sujet · étape 2','Quel sous-thème veux-tu étudier ?',`Thème ${data.theme+1} : ${t.title}`)+`<div class=\"searchwrap\"><span class=\"searchico\">⌕</span><input class=\"field\" id=\"subjectSearch\" placeholder=\"Rechercher dans la liste…\" aria-label=\"Rechercher un sous-thème\"></div><div class=\"minihead\"><span class=\"minor\">${t.subthemes.length} sous-thèmes validés</span></div><div class=\"suboptions\" id=\"suboptions\">${t.subthemes.map((v,i)=>option(v.name,v.short_explanation,data.subtheme===i,'subtheme',i,String(i+1))).join('')}</div>`;\ncase 'problem':return header('Mon sujet · étape 3','Quelle problématique retiens-tu ?','Choisis une question proposée ou rédige la tienne.')+`<div class=\"sujetinfo\"><b>Sous-thème retenu</b>${h(s.name)}</div>${s.questions.map((q,i)=>option(q,'Proposition '+(i+1),data.problem===q,'problem',i)).join('')}<div class=\"minihead\"><span class=\"fieldlabel\">Ou écris ta propre question</span><span class=\"wordcount \" id=\"probCount\">${wordcount(data.problem)} mots</span></div><textarea class=\"area\" id=\"customProblem\" rows=\"3\" placeholder=\"Comment... ?\">${data.problemMode==='custom'?h(data.problem):''}</textarea><div class=\"help\">Une problématique est une question précise à laquelle ton étude doit répondre.</div>`;\ncase 'company':return header('Préparation du terrain','Quelle entreprise envisages-tu de contacter ?','Ce choix est provisoire : aucune visite n’est considérée comme effectuée.')+field('company','Nom de l’entreprise (facultatif)','Ce champ ne sert pas à inventer des faits. Toutes les données de terrain resteront à compléter.')+`<div class=\"notice\">Saisis les informations de l’entreprise, tes propres questions et les réponses du professionnel dans la partie terrain. Le tableau comparatif et la synthèse seront préparés à partir de tes informations.</div><button class=\"btn btn-primary\" id=\"openTerrain\">Développer ma partie terrain</button>`;\ncase 'candidates':return header('Préparation du terrain','Quelles entreprises pourrais-tu visiter ?','Indique jusqu’à sept pistes. Tu peux aussi les ajouter plus tard ; aucune entreprise n’est supposée avoir accepté la visite.')+`<div class=\"candidatefields\">${Array.from({length:7},(_,i)=>`<label class=\"candidatefield\"><span>${i+1}</span><input class=\"field\" data-cand=\"${i}\" value=\"${h(data.candidates[i]||'')}\" placeholder=\"Entreprise potentielle ${i+1} (facultatif)\" maxlength=\"90\"></label>`).join('')}</div><div class=\"notice\">✓ Le Word présentera ces pistes sur une page séparée avec la mention « à contacter / à vérifier ».</div>`;\ncase 'finish':{let items=reviewList(),ready=documentReady();return header('Contrôle final','Ton dossier est prêt à être relu','Vérifie les éléments essentiels, puis choisis le fichier Word que tu souhaites créer.')+`<div class=\"reviewbox\"><div class=\"reviewtitle\">Contrôle pédagogique</div>${items.map(([label,ok])=>`<div class=\"reviewrow\"><span>${h(label)}</span><span class=\"${ok?'ok':'todo'}\">${ok?'✓ Présent':'À compléter'}</span></div>`).join('')}</div>${ready?'<div class=\"notice\">✓ Toutes les sources ont été déclarées vérifiées. Une relecture du professeur reste nécessaire.</div>':'<div class=\"notice warn\">ⓘ Tu peux exporter un brouillon maintenant. Pour une version prête à relire, ajoute et vérifie les références documentaires manquantes.</div>'}<div class=\"notice\">Contrôle A4 : vise une annexe développée de 460 à 630 mots selon l’annexe. Les dossiers trop courts laissent du blanc ; les dossiers très longs peuvent déborder. Vérifie les pages dans Word après l’export.</div><div class=\"dlcard\"><h3>1. Partie théorique · Word</h3><p>Page de garde, sommaire, remerciements, fiche d’étude, ${data.mode==='binome'?4:3} annexes rédigées et entreprises potentielles.</p><button id=\"docTheory\" class=\"btn btn-primary btn-block\">Préparer la partie théorique (.docx)</button></div><div class=\"dlcard\"><h3>2. Dossier avec préparation du terrain</h3><p>Conserve également la présentation, l’organigramme, le guide d’entretien, le tableau comparatif et la synthèse. Les données de visite restent à compléter.</p><button id=\"docFull\" class=\"btn btn-outline btn-block\">Préparer le dossier complet (.docx)</button></div><div class=\"notice\">Le document reste entièrement modifiable dans Word. L’application n’invente ni entretien, ni effectif, ni dirigeant, ni résultats financiers d’entreprise.</div>`}\n}\nif(/^annex[1-4]$/.test(k)){\n let n=Number(k.slice(-1)),txt=data.annexes[n]||'',max=690;\n let cible=['','430–480','430–480','430–480','430–480'][n];\n let title=(data.annexTitles||{})[n]||titles()[n-1];\n return header('Mon dossier · annexe '+n, 'Prépare ton annexe '+n, 'Renseigne le titre, colle ou rédige ton contenu et indique sa source. Un aperçu permet de vérifier le résultat avant de continuer.')\n +'<div class=\"ege-annex-edit\">'\n +'<label class=\"fieldlabel\" for=\"annexTitle\">Titre de l’annexe '+n+'</label>'\n +'<input class=\"field\" id=\"annexTitle\" maxlength=\"190\" value=\"'+h(title)+'\" placeholder=\"Titre clair de l’annexe\">'\n +'<div class=\"minihead\"><label class=\"fieldlabel\" for=\"annexEdit\" style=\"margin:0\">Contenu de l’annexe (copier-coller autorisé)</label><span id=\"annexCount\" class=\"wordcount '+(wordcount(txt)>max?'over':'')+'\">'+wordcount(txt)+' mots · cible A4 : '+cible+'</span></div>'\n +'<textarea class=\"area tall\" id=\"annexEdit\" spellcheck=\"true\" placeholder=\"Colle ou rédige le texte de ton annexe ici. Sépare tes paragraphes par une ligne vide.\">'+h(txt)+'</textarea>'\n +'<div class=\"minihead\"><span class=\"minor\">Tu peux coller un texte depuis Word ou une recherche, puis le vérifier et le reformuler.</span><span style=\"display:flex;gap:12px;flex-wrap:wrap\"><button class=\"smalllink\" id=\"enrichAnnex\">+ Enrichir</button><button class=\"smalllink\" id=\"restoreAnnex\">↺ Proposition initiale</button></span></div>'\n +'<label class=\"fieldlabel\" for=\"sourceValue\">Source documentaire (HTTPS)</label>'\n +'<textarea class=\"area\" id=\"sourceValue\" rows=\"3\" placeholder=\"Auteur ou organisme, titre, date, URL (uniquement si cette source a été consultée)\">'+h(data.sources[n]||'')+'</textarea>'\n +'<label class=\"sourcecheck\"><input type=\"checkbox\" id=\"sourceChecked\" '+(data.sourceChecks[n]?'checked':'')+'><span>J’ai consulté cette source et vérifié qu’elle correspond au contenu.</span></label>'\n +'<details class=\"ege-annex-preview\" id=\"annexPreviewBox\"><summary>Voir l’aperçu de l’annexe '+n+'</summary><div class=\"ege-annex-paper\"><div class=\"ege-annex-paper-head\">EGE GFM 2027 · ANNEXE '+n+'</div><h3 id=\"annexPreviewTitle\"></h3><div id=\"annexPreviewText\" class=\"ege-annex-paper-body\"></div><div class=\"ege-annex-paper-source\"><strong>Source : </strong><span id=\"annexPreviewSource\"></span><div id=\"annexPreviewState\" class=\"ege-annex-paper-state\"></div></div></div></details>'\n +'</div>';\n}\nif(/^source[1-4]$/.test(k)){let n=Number(k.slice(-1));return header('Recherche documentaire · références',`Quelle source justifie l’annexe ${n} ?`,'Indique la référence réellement consultée. Tu peux compléter plus tard, mais ton dossier restera un brouillon sans source.')+`<label class=\"fieldlabel\" for=\"sourceValue\">Auteur, titre, organisme, date et/ou URL</label><textarea class=\"area\" id=\"sourceValue\" rows=\"4\" placeholder=\"Ex. : Auteur, titre du document, année, lien...\">${h(data.sources[n]||'')}</textarea><label class=\"sourcecheck\"><input type=\"checkbox\" id=\"sourceChecked\" ${data.sourceChecks[n]?'checked':''}><span>J'ai personnellement consulté cette source et vérifié qu'elle correspond au contenu de mon annexe.</span></label><div class=\"notice warn\">Les liens issus de la recherche ne sont pas automatiquement validés : ouvre chaque document et vérifie sa pertinence avant de cocher cette case.</div>`;}\nreturn header('Étape inconnue','Reprendre le parcours','Clique sur Retour pour retrouver ton étape.');}\nfunction render(){if(/^source[1-4]$/.test(data.step))data.step='annex'+data.step.slice(-1);if(!allSteps().some(x=>x.id===data.step))data.step='welcome';ensureAnnexes();let st=allSteps(),i=activeIndex(),p=st[i].phase,progress=data.step==='welcome'?0:Math.round(100*i/(st.length-1));$('railList').innerHTML=PHASES.map(ph=>`<div class=\"railitem ${ph.id===p?'active':''} ${ph.id<p?'done':''}\"><span class=\"railnum\">${ph.id<p?'✓':ph.id}</span><span>${h(ph.name)}<span class=\"railinfo\">${h(ph.desc)}</span></span></div>`).join('');$('phaseName').textContent=PHASES.find(v=>v.id===p)?.name||'Mon parcours';$('progressText').textContent=progress+' %';$('progressLine').style.width=progress+'%';$('content').innerHTML=data.step==='welcome'?screen():`<article class=\"questionbox\"><div class=\"qcontent\">${screen()}</div>${data.step==='finish'?`<div class=\"qfoot\"><button class=\"btn btn-quiet\" id=\"prevBtn\">← Retour</button><span class=\"stepcount\">Étape ${i} sur ${st.length-2}</span><button class=\"btn btn-outline\" id=\"backupBottom\">Sauvegarder le projet</button></div>`:`<div class=\"qfoot\"><button class=\"btn btn-quiet\" id=\"prevBtn\">← Retour</button><button class=\"btn btn-quiet\" id=\"stageCorrection\">Apporter une correction</button><span class=\"stepcount\">${EGEStage.status('legacy_'+data.step,data)==='validated'?'Validée':'À relire'} · ${i} / ${st.length-2}</span><button class=\"btn btn-primary\" id=\"nextBtn\" ${valid()?'':'disabled'}>Valider et continuer →</button></div>`}</article>`;bind();preview();save();}\nfunction updateButton(){const b=$('nextBtn');if(b)b.disabled=!valid();}\nfunction bind(){bindResearchPanel();$('stageCorrection')?.addEventListener('click',()=>{EGEStage.mark('legacy_'+data.step,data,'correction');save();toast('Étape ouverte à la correction.');render()});$('openTerrain')?.addEventListener('click',async()=>{const button=$('openTerrain');button.disabled=true;try{const saved=await window.EGE2027Phase1?.saveDossier();const id=window.EGE2027Phase1?.getCurrentId();if(!saved||!id){toast('Enregistre et synchronise ton dossier en ligne avant de poursuivre.');return}location.assign(new URL('./?vue=terrain&dossier='+encodeURIComponent(id),location.href).href)}finally{button.disabled=false}});if(EGEAcademic.seriesOf(data)!=='GFM'){for(const id of ['enrichAnnex','restoreAnnex']){const button=$(id);if(button)button.hidden=true}};let id=$('startBtn');if(id)id.onclick=()=>{let target=data.resumeAt||'mode';data.step=allSteps().some(v=>v.id===target)?target:'mode';save();render();};\n$('importWelcome')?.addEventListener('click',()=> $('importFile').click());$('prevBtn')?.addEventListener('click',prev);$('nextBtn')?.addEventListener('click',next);$('backupBottom')?.addEventListener('click',backup);\ndocument.querySelectorAll('[data-choice]').forEach(b=>b.onclick=async()=>{let kind=b.dataset.choice,v=b.dataset.value; if(kind==='series'){if(EGEAcademic.seriesOf(data)!==v){if((data.theme!==null||data.problem||Object.values(data.annexes).some(Boolean))&&!await window.MBDialog.confirm('Changer de série effacera le sujet et les annexes de ce dossier. Crée plutôt un nouveau dossier pour conserver ce travail. Continuer ?'))return;Object.assign(data,{series:v,className:'',theme:null,subtheme:null,problem:'',annexes:{},annexTitles:{},sources:{},sourceChecks:{},researchEvidence:{},annexBackup:{}})}}else if(kind==='mode'){if(data.mode!==v){data.mode=v;data.partner='';data.annexes={};data.sources={};data.sourceChecks={}}}else if(kind==='theme'){let n=Number(v);if(data.theme!==n){data.theme=n;data.subtheme=null;data.problem='';data.annexes={};data.sources={};data.sourceChecks={}}}else if(kind==='subtheme'){let n=Number(v);if(data.subtheme!==n){data.subtheme=n;data.problem='';data.problemMode='';data.annexes={};data.sources={};data.sourceChecks={}}}else if(kind==='problem'){let newP=subject().questions[Number(v)];if(data.problem!==newP){data.problem=newP;data.problemMode='choice';data.annexes={};data.sources={};data.sourceChecks={}}}save();render();});\nconst input=$('inputVal');if(input){input.oninput=()=>{data[input.dataset.key]=input.value;if(input.dataset.key==='company'){data.terrain=EGETerrain.normalize(data.terrain,data);data.terrain.organizationName=input.value;data.terrain.synthesisReviewed=false}save();updateButton();preview()};input.onkeydown=e=>{if(e.key==='Enter'&&valid())next()}};\nconst ss=$('subjectSearch');if(ss)ss.oninput=()=>{let q=ss.value.toLocaleLowerCase('fr').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'');document.querySelectorAll('#suboptions [data-choice]').forEach(el=>{let t=el.textContent.toLocaleLowerCase('fr').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'');el.style.display=t.includes(q)?'':'none'})};\nconst problem=$('customProblem');if(problem)problem.oninput=()=>{let newP=problem.value;if(data.problem!==newP){data.problem=newP;data.problemMode='custom';data.annexes={};data.sources={};data.sourceChecks={}}save();$('probCount').textContent=wordcount(newP)+' mots';updateButton();preview();};\nconst titleInput=$('annexTitle');if(titleInput)titleInput.oninput=()=>{let n=Number(data.step.slice(-1));data.annexTitles={...(data.annexTitles||{}),[n]:titleInput.value};save();preview();updateButton()};\n const annex=$('annexEdit');if(annex)annex.oninput=()=>{let n=Number(data.step.slice(-1));data.annexes[n]=annex.value;data.sourceChecks[n]=false;const check=$('sourceChecked');if(check)check.checked=false;save();let max=690;let cible=['','430–480','430–480','430–480','430–480'][n];$('annexCount').textContent=wordcount(annex.value)+' mots · cible A4 : '+cible;$('annexCount').classList.toggle('over',wordcount(annex.value)>max);updateButton();preview()};\n$('enrichAnnex')?.addEventListener('click',()=>{\n  let n=Number(data.step.slice(-1)),k='a'+n,extra=[...(DEVELOPPEMENTS[data.theme]?.[k]||[]),...(APPROFONDISSEMENTS[data.theme]?.[k]||[]),...(n===4?[COMPLEMENTS_BINOME[data.theme]]:[])];\n  let text=clean(data.annexes[n]);\n  if(wordcount(text)>=(n===1?465:n===2?550:n===3?510:540)){toast('Cette annexe est déjà suffisamment développée pour un premier contrôle A4.');return}\n  for(const phrase of extra){\n   if(wordcount(text)>=(n===1?510:n===2?600:n===3?560:590))break;\n   if(!text.includes(phrase))text+=(text?'\\n\\n':'')+phrase;\n  }\n  data.annexes[n]=text;save();render();toast('Complément ajouté sans supprimer ton texte.');\n });\n $('restoreAnnex')?.addEventListener('click',async()=>{let n=Number(data.step.slice(-1));if(await window.MBDialog.confirm('Remplacer tes modifications par la proposition pédagogique ?')){data.annexes[n]=generateTexts()[n-1];save();render();}});\nconst src=$('sourceValue');if(src)src.oninput=()=>{let n=Number(data.step.slice(-1));data.sources[n]=src.value;data.sourceChecks[n]=false;const check=$('sourceChecked');if(check)check.checked=false;save();updateButton();preview()};\nconst sc=$('sourceChecked');if(sc)sc.onchange=()=>{let n=Number(data.step.slice(-1));if(sc.checked&&!clean(data.sources[n])){sc.checked=false;toast('Indique d’abord la référence consultée.');return}data.sourceChecks[n]=sc.checked;save();updateButton();preview()};\ndocument.querySelectorAll('[data-cand]').forEach(el=>el.oninput=()=>{data.candidates[Number(el.dataset.cand)]=el.value;save()});\n$('docTheory')?.addEventListener('click',()=>downloadDoc(false));$('docFull')?.addEventListener('click',()=>downloadDoc(true));}\nfunction updateAnnexPreview(){\n const match=/^annex([1-4])$/.exec(data.step);\n if(!match||!$('annexPreviewBox'))return;\n const n=Number(match[1]),title=clean((data.annexTitles||{})[n])||titles()[n-1];\n const put=(id,value)=>{const el=$(id);if(el)el.textContent=value};\n put('annexPreviewTitle',title);\n put('annexPreviewText',clean(data.annexes[n])||'Ton texte apparaîtra ici.');\n put('annexPreviewSource',clean(data.sources[n])||'Source à renseigner');\n put('annexPreviewState',data.sourceChecks[n]?'Source déclarée vérifiée par l’élève.':'Source à vérifier avant la validation du dossier.');\n}\nfunction preview(){let t=theme(),s=subject();$('draftLabel').textContent=documentReady()?'À RELIRE':'BROUILLON';$('paper').innerHTML=`<div class=\"paperhead\">République de Djibouti<br>Unité · Égalité · Paix</div><div class=\"papertitle\">DOSSIER D'ÉPREUVE DE GESTION ET D'ÉCONOMIE<br><span style=\"font:9px system-ui;color:#ba8b34\">Session 2027 · ${h(EGEAcademic.seriesOf(data))}</span></div><div class=\"papersplit\"></div><div class=\"paperlabel\">Thème</div><div class=\"papervalue ${t?'':'empty'}\">${h(t?.title||'À sélectionner')}</div><div class=\"paperlabel\">Sous-thème</div><div class=\"papervalue ${s?'':'empty'}\">${h(s?.name||'À sélectionner')}</div><div class=\"paperlabel\">Problématique</div><div class=\"papervalue ${data.problem?'':'empty'}\">${h(data.problem||'À choisir')}</div><div class=\"paperlabel\">Candidat${data.mode==='binome'?'s':''}</div><div class=\"papervalue ${data.student?'':'empty'}\">${h(data.student||'À renseigner')}${data.mode==='binome'?' · '+h(data.partner||'À renseigner'):''}</div><div class=\"paperlabel\">Établissement</div><div class=\"papervalue ${data.school?'':'empty'}\">${h(data.school||'À renseigner')}</div>`;let cnt=data.mode==='binome'?4:3;$('statusPanel').innerHTML=`<div class=\"statusrow\"><span>Annexes à rédiger</span><b>${cnt} au total</b></div><div class=\"statusrow\"><span>Annexes préparées</span><b>${Array.from({length:cnt},(_,i)=>wordcount(data.annexes[i+1])>=75).filter(Boolean).length} / ${cnt}</b></div><div class=\"statusrow\"><span>Sources déclarées vérifiées</span><b>${Array.from({length:cnt},(_,i)=>sourceComplete(i+1)).filter(Boolean).length} / ${cnt}</b></div><div class=\"statusrow\"><span>Sauvegarde</span><b><span class=\"dot\"></span>Locale</b></div>`;updateAnnexPreview();}\nfunction splitAnnex(text,count){let arr=clean(text).split(/\\n\\s*\\n/).map(clean).filter(Boolean);if(arr.length>count)arr=[...arr.slice(0,count-1),arr.slice(count-1).join(' ')];while(arr.length<count)arr.push('');return arr}\nfunction titles(){return ['Les notions générales : '+theme().title,'Comprendre : '+subject().name,'Éléments de réponse à la problématique','Conditions et limites du sujet étudié']}\nfunction replacements(full){let subj=subject(),th=theme(),ct=data.mode==='binome'?4:3,tt=titles(),result={STUDENT:clean(data.student)+(data.mode==='binome'&&clean(data.partner)?' et '+clean(data.partner):''),SCHOOL:clean(data.school)||'Établissement à préciser',CLASS:clean(data.className)||'Classe à préciser',TEACHER:clean(data.teacher)||'Professeur à préciser',THEME:th.title,SUBTHEME:subj.name,PROBLEM:clean(data.problem),COMPANY:clean(data.company)||'Entreprise à identifier',P8:String(8+(ct===4)),P9:String(9+(ct===4)),P10:String(10+(ct===4)),P12:String(11+(ct===4)),P13:String(12+(ct===4)),PCAND:String((full?13:8)+(ct===4))};\nfor(let i=1;i<=4;i++){result['TITLE'+i]=clean((data.annexTitles||{})[i])||tt[i-1];result['SOURCE'+i]=clean(data.sources[i])||'Référence documentaire à renseigner et vérifier';let arr=splitAnnex(data.annexes[i]||generateTexts()?.[i-1]||'',i===1?6:i===3?4:5);arr.forEach((x,j)=>result['A'+i+'_'+(j+1)]=x);result['SUMMARY'+i]=arr.slice(0,2).join(' ').slice(0,320)}\nresult.SUMMARYLONG=[1,2,3].flatMap(i=>splitAnnex(data.annexes[i],i===1?6:i===3?4:5).slice(0,2)).join(' ').slice(0,1100);\nvisitQuestions().forEach((x,i)=>result['QUESTION'+(i+1)]=x);\nfor(let i=1;i<=7;i++)result['CAND'+i]=clean(data.candidates[i-1])||'Entreprise à identifier';return result;}\nconst DOCX_MIME='application/vnd.openxmlformats-officedocument.wordprocessingml.document';\nlet lastWordFile=null;\nlet lastWordUrl=null;\nlet lastWordDataUrl='';\nfunction wordEl(id){return document.getElementById(id)}\nfunction setWordMsg(text){const el=wordEl('wordError');if(el)el.textContent=text||''}\nfunction wordDialog(open){const el=wordEl('wordExportOverlay');if(!el)return;el.hidden=!open; if(open)wordEl('wordClose').focus()}\nfunction base64DataUrl(blob){return new Promise((resolve,reject)=>{let reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(new Error('Conversion de fichier impossible'));reader.readAsDataURL(blob)})}\nfunction showGeneratedWord(file,blobUrl,dataUrl){\n const link=wordEl('wordDownloadLink');\n const alternate=wordEl('wordAlternativeLink');\n wordEl('wordTitle').textContent='Ton fichier Word est prêt';\n wordEl('wordState').textContent='Document .docx créé avec succès';\n wordEl('wordFilename').textContent=file.name+' · '+Math.round(file.size/1024)+' Ko';\n link.href=blobUrl;link.download=file.name;link.hidden=false;\n alternate.href=dataUrl;alternate.download=file.name;alternate.hidden=false;\n wordEl('wordShare').hidden=false;\n const secure=window.isSecureContext&&!!navigator.share&&!!navigator.canShare&&navigator.canShare({files:[file]});\n wordEl('wordShare').disabled=!secure;\n wordEl('wordShare').textContent=secure?'Partager / enregistrer avec mon téléphone':'Partage indisponible dans ce navigateur';\n const local=(location.protocol==='content:'||location.protocol==='file:');\n wordEl('wordHelp').textContent=local\n ?'Sur Android, ouvrir ce HTML depuis « Téléchargements » peut limiter l’enregistrement. Appuie directement sur le lien bleu. Si rien ne se passe, essaie le lien alternatif. Pour une compatibilité maximale, ouvre cette application depuis une adresse HTTPS (par exemple janagaleh.com).'\n :'Sur Android, appuie sur « Télécharger le Word ». Tu retrouveras ensuite ton fichier dans Téléchargements et tu pourras l’ouvrir dans Word ou WPS Office. Si besoin, utilise « Partager / enregistrer ». ';\n wordEl('wordClose').textContent='Fermer';\n setWordMsg('');\n}\n// Calibrage A4, conservant Times New Roman 11 et le modèle de référence.\n// Le moteur remplace uniquement les règles d'interligne des paragraphes d'annexes,\n// afin de répartir le texte sur la zone imprimable sans agrandir artificiellement la police.\nfunction annexLineRatio(i,n){\n let w=clean(data.annexes[i]||'').length;\n if(!w)return 1.12;\n const profile={1:[3600,1.18,.10],2:[4000,1.13,.08],3:[3600,1.31,.08],4:[3100,1.17,.10]}[i];\n let ratio=profile[1]+(profile[0]-w)/500*profile[2];\n // Avoid excessive leading or microscopic lines when the pupil edits the text.\n if(i===4)ratio=1.23-Math.max(0,w-4100)/500*.12;\n return Math.max(1.05,Math.min(1.36,ratio));\n}\nfunction formatAnnexesA4(xml){\n return xml.replace(/<w:p\\b[^>]*>[\\s\\S]*?<\\/w:p>/g,(paragraph)=>{\n   const m=paragraph.match(/\\[\\[A([1-4])_([1-6])\\]\\]/);\n   if(!m)return paragraph;\n   let i=Number(m[1]),n=Number(m[2]);\n   // The first annexe already contains blank separator paragraphs in the reference template.\n   let ratio=annexLineRatio(i,n),line=Math.round(ratio*240);\n   let before=i===3?100:0,after=i===3?100:i===4?170:i===2?60:0;\n   // Keep existing paragraph structure, indents, fonts and column widths.\n   let space=`<w:spacing w:before=\"${before}\" w:after=\"${after}\" w:line=\"${line}\" w:lineRule=\"auto\"/>`;\n   if(/<w:spacing\\b[^>]*\\/>/.test(paragraph))return paragraph.replace(/<w:spacing\\b[^>]*\\/>/,space);\n   if(paragraph.includes('<w:pPr>'))return paragraph.replace('<w:pPr>','<w:pPr>'+space);\n   return paragraph.replace(/(<w:p\\b[^>]*>)/,'$1<w:pPr>'+space+'</w:pPr>');\n });\n}\n\nasync function downloadDoc(full){\n const missing=[];\n if(!data.mode)missing.push('mode individuel ou binôme');\n if(!clean(data.student))missing.push('nom du candidat');\n if(data.mode==='binome'&&!clean(data.partner))missing.push('nom du binôme');\n if(!clean(data.className))missing.push('classe');\n if(!clean(data.school))missing.push('établissement');\n if(!clean(data.teacher)&&data.className!=='Candidat libre')missing.push('professeur');\n if(!subject())missing.push('sous-thème');\n if(!clean(data.problem))missing.push('problématique');\n if(missing.length){toast('À compléter avant l’export Word : '+missing.join(', ')+'.');return}\n\n if(full){\n  const required=data.mode==='binome'?4:3;\n  const incomplete=Array.from({length:required},(_,i)=>i+1).filter(n=>!clean(data.annexes[n]));\n  if(incomplete.length){toast('Rédige les annexes '+incomplete.join(', ')+' avant le dossier complet.');return}\n }\n // Preparing ZIP is async. On Android a synthetic click after await can silently fail:\n // never do a.click() after compression; reveal a genuine user-clickable download link.\n const pressed=full?$('docFull'):$('docTheory');\n let oldLabel=pressed?pressed.textContent:'';\n if(pressed){pressed.disabled=true;pressed.textContent='Création du fichier Word…'}\n wordDialog(true);\n wordEl('wordTitle').textContent='Préparation du fichier Word';\n wordEl('wordState').textContent='Création du document au format .docx';\n wordEl('wordFilename').textContent='';\n wordEl('wordDownloadLink').hidden=true;\n wordEl('wordAlternativeLink').hidden=true;\n wordEl('wordShare').hidden=true;\n wordEl('wordHelp').textContent='Le document Word est créé sur ton appareil. Pour la recherche web, seuls le thème, le sous-thème, la problématique et le numéro d’annexe sont envoyés au service choisi.';\n setWordMsg('');\n try{\n  const mode=data.mode==='binome'?'binome':'individuel';\n  const key=mode+'_'+(full?'full':'theory');\n  const b64=TEMPLATES[key];\n  if(!b64||typeof JSZip==='undefined')throw Error('Le modèle Word intégré est indisponible.');\n  let z=await JSZip.loadAsync(b64,{base64:true});\n  const terrainAssets=full?await EGETerrain.prepareWordAssets(z,data,typeof egeSupabaseClient!=='undefined'?egeSupabaseClient:null):{};\n  const vars=replacements(full);\n  const xmlfiles=Object.keys(z.files).filter(k=>k.endsWith('.xml')&&!z.files[k].dir);\n  for(const path of xmlfiles){\n    let value=await z.file(path).async('string');\n    if(path==='word/document.xml')value=formatAnnexesA4(value);\n    value=value.replace(/\\bGFM\\b/g,EGEAcademic.seriesOf(data));\n    if(value.includes('[['))value=value.replace(/\\[\\[([A-Z0-9_]+)\\]\\]/g,(all,key)=>escapeXml(vars[key]??'À compléter'));\n    if(full&&path==='word/document.xml')value=EGETerrain.applyToWord(value,data,terrainAssets);\n    z.file(path,value);\n  }\n  if(full)await EGETerrain.writeWordData(z,data);\n  if(!z.file('word/document.xml')||!z.file('[Content_Types].xml'))throw Error('Structure Word invalide.');\n  let blob=await z.generateAsync({type:'blob',mimeType:DOCX_MIME,compression:'DEFLATE',compressionOptions:{level:6}});\n  if(blob.size<1500)throw Error('Le document généré est anormalement petit.');\n  let name=`EGE_2027_${EGEAcademic.seriesOf(data)}_${trimName(data.student)}_${full?'dossier_avec_terrain':'partie_theorique'}.docx`;\n  // Keep object URL alive until next generation to permit delayed downloads.\n  if(lastWordUrl)URL.revokeObjectURL(lastWordUrl);\n  lastWordUrl=URL.createObjectURL(blob);\n  lastWordDataUrl=await base64DataUrl(blob);\n  lastWordFile=new File([blob],name,{type:DOCX_MIME});\n  showGeneratedWord(lastWordFile,lastWordUrl,lastWordDataUrl);\n  toast('Word prêt. Appuie maintenant sur « Télécharger le Word ».');\n }catch(e){\n  console.error('Échec de création Word',e);\n  wordEl('wordTitle').textContent='Le fichier n’a pas pu être créé';\n  wordEl('wordState').textContent='Erreur de génération';\n  wordEl('wordHelp').textContent='Tes réponses sont toujours enregistrées dans le projet. Réessaie ou ouvre ce HTML dans Chrome depuis un site HTTPS.';\n  setWordMsg(e?.message||String(e));\n }finally{\n  if(pressed){pressed.disabled=false;pressed.textContent=oldLabel}\n }\n}\nfunction shareGeneratedWord(){\n if(!lastWordFile){setWordMsg('Prépare le fichier Word avant de le partager.');return}\n if(!navigator.share||!navigator.canShare||!navigator.canShare({files:[lastWordFile]})){\n  setWordMsg('Le partage n’est pas disponible ici. Utilise le lien de téléchargement ou ouvre l’application sur un site HTTPS.');return;\n }\n // Must invoke directly in the tap handler to retain Android user activation.\n navigator.share({files:[lastWordFile],title:'Dossier EGE GFM 2027',text:'Fichier Word du dossier EGE'})\n .catch(e=>{if(e.name!=='AbortError')setWordMsg('Partage impossible : '+e.message)});\n}\nfunction downloadBlob(blob,name){let url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),7000)}\nfunction backup(){downloadBlob(new Blob([JSON.stringify({version:3,data},null,2)],{type:'application/json'}),'EGE_'+EGEAcademic.seriesOf(data)+'_2027_sauvegarde.json');toast('Projet sauvegardé dans un fichier JSON.');}\n$('backupTop').onclick=backup;$('importBtn').onclick=()=>$('importFile').click();$('resetBtn').onclick=async()=>{if(await window.MBDialog.confirm('Effacer le dossier actuel sur cet appareil ? Fais une sauvegarde si nécessaire.')){data=empty();window.EGE2027Phase1?.detachCurrent();localStorage.removeItem(KEY);render();toast('Nouveau dossier créé.')}};\n$('brand').onclick=e=>{e.preventDefault();if(data.step!=='welcome')data.resumeAt=data.step;data.step='welcome';render()};\n$('importFile').onchange=async e=>{let f=e.target.files?.[0];if(!f)return;try{let obj=JSON.parse(await f.text()),v=obj.data||obj;if(!v||!['individuel','binome'].includes(v.mode))throw Error('Format non reconnu');let n=empty();n.series=EGEAcademic.seriesOf(v);for(let k of Object.keys(n))if(Object.prototype.hasOwnProperty.call(v,k))n[k]=v[k];n.annexes=v.annexes&&typeof v.annexes==='object'?v.annexes:{};n.sources=v.sources&&typeof v.sources==='object'?v.sources:{};n.sourceChecks=v.sourceChecks&&typeof v.sourceChecks==='object'?v.sourceChecks:{};n.researchEvidence=v.researchEvidence&&typeof v.researchEvidence==='object'?v.researchEvidence:{};n.annexBackup=v.annexBackup&&typeof v.annexBackup==='object'?v.annexBackup:{};n.candidates=Array.isArray(v.candidates)?v.candidates.slice(0,7):Array(7).fill('');n.theme=Number.isInteger(v.theme)&&v.theme>=0&&v.theme<egeCatalog(n).length?v.theme:null;n.subtheme=n.theme!==null&&Number.isInteger(v.subtheme)&&v.subtheme>=0&&v.subtheme<egeCatalog(n)[n.theme].subthemes.length?v.subtheme:null;n.terrain=EGETerrain.normalize(v.terrain,v);n.step='finish';data=n;window.EGE2027Phase1?.detachCurrent();save();render();toast('Projet restauré.')}catch(err){toast('Impossible de restaurer ce fichier : '+err.message)}e.target.value=''};\ndocument.addEventListener('DOMContentLoaded',()=>{\n const overlay=wordEl('wordExportOverlay');\n if(!overlay)return;\n wordEl('wordClose').addEventListener('click',()=>wordDialog(false));\n wordEl('wordShare').addEventListener('click',shareGeneratedWord);\n overlay.addEventListener('click',e=>{if(e.target===overlay)wordDialog(false)});\n wordEl('wordDownloadLink').addEventListener('click',()=>{wordEl('wordState').textContent='Téléchargement demandé — consulte le dossier Téléchargements.'});\n wordEl('wordAlternativeLink').addEventListener('click',()=>{wordEl('wordState').textContent='Téléchargement alternatif demandé — consulte le dossier Téléchargements.'});\n});\n\nrender();\n</script>\n<div id=\"wordExportOverlay\" class=\"word-overlay\" hidden role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"wordTitle\">\n <div class=\"word-modal\">\n  <span id=\"wordState\" class=\"word-state\">Préparation du document</span>\n  <h2 id=\"wordTitle\">Préparation du Word</h2>\n  <p>La création est réalisée sur ton appareil. Une fois le fichier prêt, clique sur un lien de téléchargement ci-dessous.</p>\n  <div id=\"wordFilename\" class=\"word-file\" aria-live=\"polite\"></div>\n  <div class=\"word-actions\">\n   <a id=\"wordDownloadLink\" class=\"word-primary\" href=\"#\" download hidden>↓ Télécharger le fichier Word (.docx)</a>\n   <button type=\"button\" id=\"wordShare\" hidden>Partager / enregistrer sur mon téléphone</button>\n   <a id=\"wordAlternativeLink\" href=\"#\" download hidden>Autre méthode de téléchargement</a>\n  </div>\n  <p id=\"wordHelp\" class=\"word-info\">La génération utilise le modèle EGE fourni.</p>\n  <div id=\"wordError\" class=\"word-error\" aria-live=\"assertive\"></div>\n  <button id=\"wordClose\" type=\"button\" class=\"word-close\">Retourner au dossier</button>\n </div>\n</div>\n\n<div class=\"ege-cloud-overlay\" id=\"egeCloudOverlay\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Compte et administration EGE\" hidden>\n <section class=\"ege-cloud-dialog\">\n  <div class=\"modern-modal-header\"><h2>Mon espace</h2><a class=\"btn\" href=\"/?profil=1\">Mon profil</a></div>\n  <p>Enregistrez votre travail et retrouvez vos dossiers.</p>\n  <p id=\"egeCloudWho\">Aucun compte connecté</p>\n  <div class=\"ege-cloud-auth\" id=\"egeCloudAuth\">\n   <label for=\"egeCloudEmail\">Adresse e-mail</label><input id=\"egeCloudEmail\" type=\"email\" autocomplete=\"username\" placeholder=\"eleve@exemple.com\">\n   <label for=\"egeCloudPassword\">Mot de passe</label><input id=\"egeCloudPassword\" type=\"password\" autocomplete=\"current-password\" minlength=\"6\" placeholder=\"Mot de passe du compte\">\n   <div class=\"ege-cloud-buttons\"><button type=\"button\" class=\"ege-cloud-primary\" id=\"egeCloudSignIn\">Se connecter</button><button type=\"button\" id=\"egeCloudSignUp\">Créer un compte</button></div>\n   <div class=\"ege-cloud-buttons\"><button type=\"button\" id=\"egeCloudResend\">Renvoyer l’e-mail de confirmation</button></div>\n   <p>Après inscription, vérifie ta boîte e-mail et les courriers indésirables. Confirme ton adresse avant de te connecter. N’appuie pas plusieurs fois sur « Créer un compte » : Un délai est nécessaire entre deux envois.</p>\n  </div>\n  <div class=\"ege-cloud-actions\" id=\"egeCloudActions\" hidden>\n   <div class=\"ege-cloud-buttons\"><button type=\"button\" class=\"ege-cloud-primary\" id=\"egeCloudSave\">Enregistrer</button><button type=\"button\" id=\"egeCloudLoad\">Mes dossiers</button></div>\n   <div class=\"ege-cloud-buttons\"><button type=\"button\" id=\"egeCloudReviews\">Mes corrections</button><button type=\"button\" id=\"egeCloudSignOut\">Se déconnecter</button></div>\n  </div>\n  <div class=\"ege-cloud-admin-shortcut\" id=\"egeCloudAdminShortcut\" hidden>\n   <h3>Mon administration</h3>\n   <p>Les dossiers, corrections et paramètres sont regroupés sur une page dédiée, plus confortable sur téléphone.</p>\n   <a href=\"./admin.html\">Ouvrir l’administration</a>\n  </div>\n  <div class=\"ege-cloud-admin\" id=\"egeCloudAdmin\" hidden>\n   <h3>Administration · Enseignant autorisé</h3>\n   <p>Accès accordé uniquement aux utilisateurs présents dans la table sécurisée ege2027_staff.</p>\n   <div class=\"ege-cloud-buttons\"><button type=\"button\" id=\"egeCloudAdminRefresh\">Afficher les dossiers</button></div>\n   <label for=\"egeCloudDossierSelect\">Dossier à corriger</label><select id=\"egeCloudDossierSelect\"><option value=\"\">Choisir un dossier élève</option></select>\n   <pre id=\"egeCloudDossierText\">Sélectionne un dossier pour lire ses annexes.</pre>\n   <label for=\"egeCloudObservation\">Observation pédagogique</label><textarea id=\"egeCloudObservation\" placeholder=\"Commentaire clair et adapté au candidat\"></textarea>\n   <div class=\"ege-cloud-buttons\"><button type=\"button\" id=\"egeCloudApprove\">Valider</button><button type=\"button\" id=\"egeCloudRevise\">À corriger</button></div>\n  </div>\n  <div class=\"ege-cloud-buttons\"><button type=\"button\" id=\"egeCloudImportDoc\">Importer un dossier Word (.docx) ou JSON</button></div>\n  <div class=\"ege-cloud-message\" id=\"egeCloudMessage\" role=\"status\" aria-live=\"polite\">Connexion en cours…</div>\n  <div class=\"ege-cloud-buttons\"><button type=\"button\" id=\"egeCloudClose\" class=\"ege-cloud-close\">Retourner au dossier</button></div>\n </section>\n</div>\n<script>\n// EGE 2027 - module Supabase ajoute en extension du parcours existant.\n// Supabase project MON-BAC ; seules les tables ege2027_* sont utilisées.\nconst EGE_SUPABASE_URL = 'https://nwcatsmfbkcgvgbanwyl.supabase.co';\nconst EGE_SUPABASE_PUBLIC_KEY = 'sb_publishable_vXuRHP_lqGqtV9d1C_oZWw_SetdoY7L';\nlet egeSupabaseClient = null, egeCloudUser = null, egeCloudStaff = null;\nlet egeCloudRows = [], egeCloudSelected = null, egeCloudBusy = false;\nconst egeCloud = id => document.getElementById(id);\nconst egeCloudMsg = message => {const el=egeCloud('egeCloudMessage');if(el)el.textContent=message};\n\n// Lien de retour stable pour la confirmation d'e-mail.\n// Ajouter cette URL aux redirections autorisées dans Supabase Auth.\nconst EGE_AUTH_REDIRECT='https://ege-gfm-2027.janakaleh.workers.dev/';\nlet egeCloudNextEmailAt=0, egeCloudCooldownTimer=null;\ntry{egeCloudNextEmailAt=Math.max(0,Number(sessionStorage.getItem('ege2027_email_next')||0))}catch(_){}\nfunction egeCloudUpdateCooldown(){\n const remaining=Math.max(0,Math.ceil((egeCloudNextEmailAt-Date.now())/1000));\n const create=egeCloud('egeCloudSignUp'),resend=egeCloud('egeCloudResend');\n if(create){create.disabled=egeCloudBusy||remaining>0;create.textContent=remaining>0?'Patienter '+remaining+' s':'Créer un compte'}\n if(resend){resend.disabled=egeCloudBusy||remaining>0;resend.textContent=remaining>0?'Renvoi possible dans '+remaining+' s':'Renvoyer l’e-mail de confirmation'}\n if(egeCloudCooldownTimer)clearTimeout(egeCloudCooldownTimer);\n egeCloudCooldownTimer=remaining>0?setTimeout(egeCloudUpdateCooldown,1000):null;\n}\nfunction egeCloudStartCooldown(seconds=65){\n egeCloudNextEmailAt=Math.max(egeCloudNextEmailAt,Date.now()+Math.ceil(seconds)*1000);\n try{sessionStorage.setItem('ege2027_email_next',String(egeCloudNextEmailAt))}catch(_){}\n egeCloudUpdateCooldown();\n}\nfunction egeCloudFriendlyError(err,signup=false){\n const message=String(err?.message||err||'Erreur inconnue');\n const code=String(err?.code||'');\n if(code==='email_not_confirmed'||/email not confirmed/i.test(message))return 'Ton compte existe, mais ton adresse e-mail n’est pas confirmée. Ouvre le message de Supabase (vérifie aussi les spams), puis connecte-toi. Tu peux demander un renvoi après le délai indiqué.';\n if(code==='over_email_send_rate_limit'||err?.status===429||/rate limit|after \\d+ second|too many requests/i.test(message)){\n   const seconds=Number(message.match(/after (\\d+) seconds/i)?.[1]||65);\n   egeCloudStartCooldown(Math.max(65,seconds+2));\n   return 'Trop de demandes rapprochées. Attends le délai affiché avant un nouvel essai. Si ton premier envoi a réussi, regarde d’abord ta boîte e-mail.';\n }\n if(code==='user_already_exists'||/user already registered|already exists/i.test(message))return 'Un compte existe déjà avec cette adresse. Utilise « Se connecter » ou confirme le compte depuis ton e-mail.';\n if(/invalid login credentials/i.test(message))return 'Adresse ou mot de passe incorrect. Si tu viens de t’inscrire, confirme d’abord ton e-mail.';\n if(/weak.password|password.*(weak|short)|password should/i.test(message))return 'Choisis un mot de passe plus fort (au moins 12 caractères pour une inscription).';\n if(/failed to fetch|networkerror|network request failed/i.test(message))return 'Connexion au service impossible. Vérifie Internet et réessaie.';\n return (signup?'Inscription impossible : ':'Connexion impossible : ')+message;\n}\n\nconst egeCloudOpen = value => {\n const d=egeCloud('egeCloudOverlay');if(d){d.hidden=!value;if(value){d.scrollTop=0;d.querySelector('.ege-cloud-dialog')?.scrollTo(0,0);if(!egeCloudUser)egeCloud('egeCloudEmail')?.focus()}}\n};\nfunction egeCloudRefresh(){\n egeMobileNavUpdate();\n const logged=!!egeCloudUser;\n window.EGEHeader?.setSignedIn(logged);\n if(logged)window.EGEHeader?.setUser(egeCloudUser,egeSupabaseClient);\n egeCloud('egeCloudAuth')?.toggleAttribute('hidden',logged);\n egeCloud('egeCloudActions')?.toggleAttribute('hidden',!logged);\n egeCloud('egeCloudAdmin')?.toggleAttribute('hidden',!(logged&&egeCloudStaff?.role==='enseignant'));\n egeCloud('egeCloudAdminShortcut')?.toggleAttribute('hidden',!(logged&&egeCloudStaff?.role==='admin'));\n const who=egeCloud('egeCloudWho');if(who)who.textContent=logged?'Compte : '+(egeCloudUser.email||'utilisateur connecté'):'Aucun compte connecté';\n const small=egeCloud('egeCloudBadge');if(small)small.textContent=logged?'Compte connecté':'Sur cet appareil';\n const adminLink=egeCloud('egeAdminPageLink');if(adminLink)adminLink.hidden=!(logged&&egeCloudStaff?.role==='admin');\n window.EGE2027Phase1?.onAuthChanged(egeCloudUser);\n if(logged)egeRestorePersonalDraftIfNeeded();\n egeMobileNavUpdate();\n}\nasync function egeCloudLoadStaff(){\n egeCloudStaff=null;\n if(!egeSupabaseClient||!egeCloudUser){egeCloudRefresh();return}\n try{const profile=await EGEAccount.current(egeSupabaseClient);if(EGEAccount.blocked(profile)||EGEAccount.incomplete(profile,profile.account_kind)){location.assign('/?profil=1');return}egeCloudUser=EGEAccount.userWithProfile(egeCloudUser,profile)}catch(e){egeCloudMsg(e.message);return}\n const {data:member,error}=await egeSupabaseClient.from('ege2027_staff').select('role').eq('user_id',egeCloudUser.id).maybeSingle();\n if(error){egeCloudMsg('Les tables EGE ne sont pas encore opérationnelles : '+error.message)}\n else egeCloudStaff=member||null;\n egeCloudRefresh();\n}\nasync function egeCloudLogin(signup){\n if(egeCloudBusy||!egeSupabaseClient)return;\n if(signup&&egeCloudNextEmailAt>Date.now()){egeCloudUpdateCooldown();egeCloudMsg('Un e-mail a peut-être déjà été envoyé. Vérifie ta boîte de réception ou attends le délai affiché.');return}\n const email=egeCloud('egeCloudEmail')?.value.trim().toLowerCase()||'',password=egeCloud('egeCloudPassword')?.value||'';\n if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)||password.length<6){egeCloudMsg('Indique un e-mail valide et un mot de passe de 6 caractères minimum.');return}\n if(signup&&password.length<12){egeCloudMsg('Pour créer un compte, choisis un mot de passe de 12 caractères minimum.');return}\n egeCloudBusy=true;egeCloudUpdateCooldown();egeCloudMsg(signup?'Création du compte…':'Connexion en cours…');\n try{\n  const {data:result,error}=signup\n  ?await egeSupabaseClient.auth.signUp({email,password,options:{emailRedirectTo:EGE_AUTH_REDIRECT}})\n  :await egeSupabaseClient.auth.signInWithPassword({email,password});\n  if(error)throw error;\n  if(signup)egeCloudStartCooldown(70);\n  if(signup&&!result.session){\n   egeCloud('egeCloudPassword').value='';\n   egeCloudMsg('Inscription enregistrée. Un e-mail de confirmation a été demandé : vérifie ta boîte de réception et les spams. Clique sur le lien reçu, puis utilise « Se connecter ». Inutile de recréer le compte.');\n   return;\n  }\n  egeCloudUser=result.user||null;\n  egeCloudMsg('Connexion réussie. Tu peux sauvegarder ton dossier en ligne.');\n  await egeCloudLoadStaff();\n }catch(e){egeCloudMsg(egeCloudFriendlyError(e,signup))}\n finally{egeCloudBusy=false;egeCloudUpdateCooldown();}\n}\nasync function egeCloudResend(){\n if(egeCloudBusy||!egeSupabaseClient)return;\n if(egeCloudNextEmailAt>Date.now()){egeCloudUpdateCooldown();egeCloudMsg('Attends la fin du délai avant de demander un nouvel e-mail.');return}\n const email=egeCloud('egeCloudEmail')?.value.trim().toLowerCase()||'';\n if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)){egeCloudMsg('Indique d’abord l’adresse e-mail de ton compte.');return}\n egeCloudBusy=true;egeCloudUpdateCooldown();egeCloudMsg('Demande de renvoi…');\n try{\n  const {error}=await egeSupabaseClient.auth.resend({type:'signup',email,options:{emailRedirectTo:EGE_AUTH_REDIRECT}});\n  if(error)throw error;\n  egeCloudStartCooldown(70);\n  egeCloudMsg('Si ce compte attend une confirmation, un nouvel e-mail a été demandé. Vérifie la boîte de réception et les spams.');\n }catch(e){egeCloudMsg(egeCloudFriendlyError(e,true))}\n finally{egeCloudBusy=false;egeCloudUpdateCooldown();}\n}\nasync function egeCloudSave(){return window.EGE2027Phase1?.saveDossier()}\nasync function egeCloudLoad(){return window.EGE2027Phase1?.openDossiers()}\nasync function egeCloudReadReviews(){return window.EGE2027Phase1?.showReviews()}\nasync function egeCloudListAdmin(){\n if(!egeCloudStaff||!egeCloudUser||!egeSupabaseClient)return;\n const {data:rows,error}=await egeSupabaseClient.from('ege2027_dossiers').select('id,student,updated_at,payload').order('updated_at',{ascending:false}).limit(100);\n if(error){egeCloudMsg('Impossible de charger les dossiers : '+error.message);return}\n egeCloudRows=rows||[];\n const select=egeCloud('egeCloudDossierSelect');if(!select)return;\n select.replaceChildren();\n let prompt=document.createElement('option');prompt.value='';prompt.textContent='Choisir un dossier élève';select.append(prompt);\n for(const row of egeCloudRows){let item=document.createElement('option');item.value=row.id;item.textContent=(row.student||'Candidat sans nom').slice(0,70)+' · '+new Date(row.updated_at).toLocaleDateString('fr-FR');select.append(item)}\n egeCloudMsg(egeCloudRows.length+' dossier(s) accessibles pour la correction.');\n}\nfunction egeCloudSelectAdmin(){\n const id=egeCloud('egeCloudDossierSelect')?.value;\n egeCloudSelected=egeCloudRows.find(x=>x.id===id)||null;\n const display=egeCloud('egeCloudDossierText');\n if(!display)return;\n if(!egeCloudSelected){display.textContent='Sélectionne un dossier pour lire ses annexes.';return}\n const d=egeCloudSelected.payload||{},anns=d.annexes||{};\n display.textContent='Candidat : '+(d.student||'—')+'\\nClasse : '+(d.className||'—')+'\\nProblématique : '+(d.problem||'—')+'\\n\\n'+[1,2,3,4].filter(n=>String(anns[n]||'').trim()).map(n=>'ANNEXE '+n+'\\n'+String(anns[n]).slice(0,13000)).join('\\n\\n');\n}\nasync function egeCloudReview(decision){\n if(!egeCloudSelected||!egeCloudStaff||!egeSupabaseClient){egeCloudMsg('Sélectionne un dossier.');return}\n const observation=egeCloud('egeCloudObservation')?.value.trim()||'';\n if(decision==='a_corriger'&&!observation){egeCloudMsg('Indique une observation avant de demander des corrections.');return}\n const {error}=await egeSupabaseClient.from('ege2027_reviews').insert({dossier_id:egeCloudSelected.id,staff_id:egeCloudUser.id,decision,observation});\n egeCloudMsg(error?'Correction non enregistrée : '+error.message:decision==='valide'?'Dossier marqué validé, avis enregistré.':'Demande de correction enregistrée.');\n}\nlet egeDraftRestorePrompted='';\nasync function egeCloudLogout(){\n const previousId=egeCloudUser?.id||null;\n if(previousId)try{localStorage.setItem('ege2027_local_draft_'+previousId,JSON.stringify(data))}catch(_){}\n if(window.EGEOffline?.enabled(previousId)){await window.EGEStudyLegacy?.stage?.();await EGEOffline.flush();if(Object.keys(await EGEOffline.pending()).length&&!await window.MBDialog.confirm('Des modifications ne sont pas synchronisées. Annulez pour les exporter avant la déconnexion. Continuer et effacer la copie locale ?'))return;await EGEOffline.clear()}\n if(egeSupabaseClient)await egeSupabaseClient.auth.signOut({scope:window.EGELegacyOffline?'local':'global'});\n data=empty();try{localStorage.removeItem(KEY)}catch(_){}\n window.EGE2027Phase1?.detachCurrent();\n egeCloudUser=null;egeCloudStaff=null;egeCloudRefresh();render();\n egeCloudMsg('Déconnecté. Les dossiers en ligne restent dans votre compte. Le brouillon local est conservé séparément pour votre prochaine connexion.');\n}\nasync function egeRestorePersonalDraftIfNeeded(){\n const uid=egeCloudUser?.id;\n if(!uid||egeDraftRestorePrompted===uid)return;\n egeDraftRestorePrompted=uid;\n const existing=clean(data.student)||clean(data.problem)||Object.values(data.annexes||{}).some(Boolean);\n if(existing)return;\n try{\n  const raw=JSON.parse(localStorage.getItem('ege2027_local_draft_'+uid)||'null');\n  if(!raw||typeof raw!=='object'||Array.isArray(raw))return;\n  if(!await window.MBDialog.confirm('Un brouillon conservé sur cet appareil a été retrouvé pour votre compte. Souhaitez-vous le reprendre ?'))return;\n  data={...empty(),...raw,annexes:{...(raw.annexes||{})},annexTitles:{...(raw.annexTitles||{})},sources:{...(raw.sources||{})},sourceChecks:{...(raw.sourceChecks||{})}};\n  save();render();egeCloudMsg('Brouillon local retrouvé. Vérifiez son état de synchronisation avant de quitter.');\n  localStorage.removeItem('ege2027_local_draft_'+uid);\n }catch(e){egeCloudMsg('Restauration locale indisponible : '+e.message)}\n}\n\nasync function egeCloudLoadPublicSettings(){\n const {data:cfg,error}=await egeSupabaseClient.from('ege2027_settings').select('app_title,academic_year,student_message').eq('id',1).maybeSingle();\n if(error||!cfg)return;\n const brand=document.querySelector('#brand b');if(brand)brand.textContent=cfg.app_title;\n const year=document.querySelector('#brand small');if(year)year.textContent='Gestion Financière & Mercatique · '+cfg.academic_year;\n document.title=cfg.app_title+' · Mon dossier guidé';\n const notice=egeCloud('egeStudentNotice');\n const noticeText=egeCloud('egeStudentNoticeText');\n if(notice&&noticeText){noticeText.textContent=cfg.student_message||'';notice.hidden=!cfg.student_message;}\n}\n\nfunction egeMobileNavUpdate(){\n const admin=egeCloud('egeNavAdmin');\n if(admin)admin.hidden=!(egeCloudUser && egeCloudStaff?.role==='admin');\n const group=egeCloud('egeNavGroup');if(group)group.hidden=!!(egeCloudUser&&egeCloudStaff?.role==='admin');\n}\nfunction egeMobileNavInit(){\n const home=egeCloud('egeNavHome'),saveButton=egeCloud('egeNavSave'),files=egeCloud('egeNavFiles');\n if(!home||!saveButton||!files)return;\n home.addEventListener('click',()=>{\n  egeCloudOpen(false);\n  if(data.step!=='welcome')data.resumeAt=data.step;\n  data.step='welcome';render();\n  window.scrollTo({top:0,behavior:'smooth'});\n  home.classList.add('is-current');\n });\n saveButton.addEventListener('click',()=>{save();egeCloudOpen(true);if(!egeCloudUser)egeCloudMsg('Connecte-toi pour synchroniser ton dossier en ligne.');});\n files.addEventListener('click',()=>window.EGE2027Phase1?.openDossiers());\n document.addEventListener('focusin',ev=>{\n  if(ev.target?.matches?.('input:not([type=checkbox]):not([type=radio]),textarea,select,[contenteditable=true]'))document.body.classList.add('ege-keyboard-open');\n });\n document.addEventListener('focusout',()=>{\n  requestAnimationFrame(()=>{\n   const el=document.activeElement;\n   if(!el?.matches?.('input:not([type=checkbox]):not([type=radio]),textarea,select,[contenteditable=true]'))document.body.classList.remove('ege-keyboard-open');\n  });\n });\n egeMobileNavUpdate();\n}\n\nasync function egeCloudInit(){\n egeMobileNavInit();\n egeCloud('egeCloudOpen')?.addEventListener('click',()=>egeCloudOpen(true));\n egeCloud('egeCloudClose')?.addEventListener('click',()=>egeCloudOpen(false));\n egeCloud('egeCloudOverlay')?.addEventListener('click',ev=>{if(ev.target===egeCloud('egeCloudOverlay'))egeCloudOpen(false)});\n egeCloud('egeCloudSignIn')?.addEventListener('click',()=>egeCloudLogin(false));\n egeCloud('egeCloudSignUp')?.addEventListener('click',()=>{location.assign(new URL('./?inscription=1',location.href).href)});\n egeCloud('egeCloudResend')?.addEventListener('click',egeCloudResend);\n egeCloudUpdateCooldown();\n egeCloud('egeCloudSave')?.addEventListener('click',egeCloudSave);\n\n egeCloud('egeCloudReviews')?.addEventListener('click',egeCloudReadReviews);\n egeCloud('egeCloudSignOut')?.addEventListener('click',egeCloudLogout);\n egeCloud('egeCloudAdminRefresh')?.addEventListener('click',egeCloudListAdmin);\n egeCloud('egeCloudDossierSelect')?.addEventListener('change',egeCloudSelectAdmin);\n egeCloud('egeCloudApprove')?.addEventListener('click',()=>egeCloudReview('valide'));\n egeCloud('egeCloudRevise')?.addEventListener('click',()=>egeCloudReview('a_corriger'));\n if(!window.supabase?.createClient){location.replace('/');return}\n egeSupabaseClient=window.supabase.createClient(EGE_SUPABASE_URL,EGE_SUPABASE_PUBLIC_KEY);\n if(!navigator.onLine){if(await window.EGEStudyLegacy?.boot()){document.getElementById('egeEligibilityGate')?.remove();return;}location.replace('/');return;}\n try{const {data:auth,error:authError}=await egeSupabaseClient.auth.getUser();if(authError||!auth?.user){location.replace('/');return;}const {data:p,error}=await egeSupabaseClient.from('ege2027_profiles').select('account_kind,academic_level,series,account_status,deleted_at').eq('user_id',auth.user.id).maybeSingle();if(error||!p||p.account_status!=='active'||p.deleted_at||!(p.account_kind==='admin'||p.account_kind==='enseignant'||(p.account_kind==='eleve'&&p.academic_level==='Terminale'&&['GFM','OGRH','IAG'].includes(p.series)))){location.replace('/');return;}document.getElementById('egeEligibilityGate')?.remove();}catch(_){location.replace('/');return;}\n egeCloudLoadPublicSettings().catch(()=>{});\n egeSupabaseClient.auth.onAuthStateChange((_event,session)=>{if(_event==='SIGNED_OUT'){location.replace('/');return;}egeCloudUser=session?.user||null;egeCloudRefresh();if(_event==='PASSWORD_RECOVERY')setTimeout(()=>window.EGE2027Phase1?.showRecovery(),0);setTimeout(()=>egeCloudLoadStaff().catch(e=>egeCloudMsg(e.message)),0)});\n egeSupabaseClient.auth.getUser().then(({data:res,error})=>{if(!error&&res?.user){egeCloudUser=res.user;egeCloudLoadStaff().catch(e=>egeCloudMsg(e.message))}egeCloudRefresh()}).catch(e=>egeCloudMsg('Connexion au projet monAvenir impossible : '+e.message));\n egeCloudRefresh();\n}\ndocument.addEventListener('DOMContentLoaded',egeCloudInit);\n\n</script>\n<div id=\"egeInstallOverlay\" class=\"ege-install-overlay\" hidden>\n  <section class=\"ege-install-panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"egeInstallTitle\">\n    <h2 id=\"egeInstallTitle\">Installer EGE GFM 2027</h2>\n    <p id=\"egeInstallInfo\" role=\"status\">Ajoute l'application sur ton écran d'accueil pour l'ouvrir comme une application.</p>\n    <button type=\"button\" id=\"egeInstallClose\">Fermer</button>\n  </section>\n</div>\n<script>\n(function(){\nlet pendingInstall=null;\nconst installButton=document.getElementById('egeInstallButton');\nconst overlay=document.getElementById('egeInstallOverlay');\nconst info=document.getElementById('egeInstallInfo');\nconst close=document.getElementById('egeInstallClose');\nconst standalone=()=>window.matchMedia('(display-mode: standalone)').matches||window.navigator.standalone===true;\nconst show=message=>{if(info)info.textContent=message;if(overlay)overlay.hidden=false;close?.focus()};\nconst hide=()=>{if(overlay)overlay.hidden=true;installButton?.focus()};\nwindow.addEventListener('beforeinstallprompt',event=>{event.preventDefault();pendingInstall=event;if(installButton&&!standalone())installButton.hidden=false});\nwindow.addEventListener('appinstalled',()=>{pendingInstall=null;if(installButton)installButton.hidden=true;hide()});\nif(installButton&&standalone())installButton.hidden=true;\ninstallButton?.addEventListener('click',async()=>{\n if(standalone()){show(\"L'application est déjà installée sur cet appareil.\");return}\n if(pendingInstall){\n   const prompt=pendingInstall;pendingInstall=null;\n   try{await prompt.prompt();const choice=await prompt.userChoice;if(choice?.outcome==='accepted'){show(\"Installation acceptée. Retrouve EGE 2027 dans tes applications.\");return}}catch(e){}\n }\n const ua=navigator.userAgent||'';\n if(/iPhone|iPad|iPod/i.test(ua)){show(\"Sur iPhone ou iPad : ouvre cette page dans Safari, touche Partager puis « Sur l’écran d’accueil » et confirme « Ajouter ».\");return}\n if(/Android/i.test(ua)){show(\"Sur Android : ouvre cette page dans Chrome (pas dans un navigateur intégré à une autre application). Appuie sur ⋮, puis sur « Installer l’application » ou « Ajouter à l’écran d’accueil ».\");return}\n show(\"Sur ordinateur : ouvre la page dans Chrome ou Edge, puis utilise l’icône Installer dans la barre d’adresse ou le menu ⋮ > Installer cette application.\");\n});\nclose?.addEventListener('click',hide);\noverlay?.addEventListener('click',e=>{if(e.target===overlay)hide()});\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape'&&overlay&&!overlay.hidden)hide()});\nif('serviceWorker' in navigator && location.protocol==='https:'){\n window.addEventListener('load',()=>navigator.serviceWorker.register('./service-worker-ege-2027.js',{scope:'./'}).catch(()=>{}));\n}\n})();\n</script>\n<div id=\"wordImportOverlay\" class=\"word-import-overlay\" hidden role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"wordImportTitle\">\n<section class=\"word-import-panel\" tabindex=\"-1\">\n <div class=\"word-import-head\"><div><span class=\"word-import-eyebrow\">EGE GFM 2027 · RESTAURATION</span><h2 id=\"wordImportTitle\">Importer un dossier Word</h2><p id=\"wordImportFilename\">Choisis un fichier .docx sur ton appareil.</p></div><button type=\"button\" class=\"word-import-close\" id=\"wordImportClose\" aria-label=\"Fermer\">×</button></div>\n <p class=\"word-import-lead\">Vérifie le contenu récupéré avant de remplacer le dossier actuel. Le Word reste sur ton appareil ; seules les informations validées seront enregistrées dans EGE.</p>\n <div id=\"wordImportStatus\" class=\"word-import-status\" role=\"status\" aria-live=\"polite\">Lecture du fichier Word…</div>\n <fieldset class=\"word-import-group\">\n <legend>1. Identité et établissement</legend>\n <label for=\"wordImportMode\">Type de dossier</label><select id=\"wordImportMode\"><option value=\"individuel\">Individuel — 3 annexes</option><option value=\"binome\">Binôme — 4 annexes</option></select>\n <label for=\"wordImportStudent\">Nom du candidat</label><input id=\"wordImportStudent\" maxlength=\"180\" placeholder=\"Nom du candidat\">\n <label for=\"wordImportPartner\">Deuxième candidat, si binôme</label><input id=\"wordImportPartner\" maxlength=\"180\" placeholder=\"Nom du binôme\">\n <div><label for=\"wordImportSeries\">Série</label><select id=\"wordImportSeries\"></select></div><div class=\"word-import-two\"><div><label for=\"wordImportClass\">Classe</label><select id=\"wordImportClass\"></select></div><div><label for=\"wordImportSchool\">Établissement</label><select id=\"wordImportSchool\"></select></div></div>\n <label for=\"wordImportTeacher\">Professeur</label><input id=\"wordImportTeacher\" maxlength=\"180\" placeholder=\"Professeur encadrant\">\n </fieldset>\n <fieldset class=\"word-import-group\">\n <legend>2. Sujet officiel et problématique</legend>\n <label for=\"wordImportTheme\">Thème officiel 2026–2027</label><select id=\"wordImportTheme\"><option value=\"\">— Thème à choisir —</option></select>\n <label for=\"wordImportSubtheme\">Sous-thème officiel</label><select id=\"wordImportSubtheme\"><option value=\"\">— Sous-thème à choisir —</option></select>\n <label for=\"wordImportProblem\">Problématique</label><textarea id=\"wordImportProblem\" rows=\"2\" placeholder=\"Quelle question étudie ce dossier ?\"></textarea>\n </fieldset>\n <fieldset class=\"word-import-group\">\n <legend>3. Annexes et références documentaires</legend>\n <p class=\"word-import-hint\">Les annexes sont modifiables. Les sources importées devront être vérifiées à nouveau ; aucune source n'est automatiquement validée.</p>\n <details id=\"wordImportAnnexBox1\" class=\"word-import-annex\">\n  <summary>Annexe 1 — Afficher / corriger</summary>\n  <label for=\"wordImportTitle1\">Titre de l'annexe 1</label><input id=\"wordImportTitle1\" maxlength=\"190\" placeholder=\"Titre de l'annexe\"><label for=\"wordImportAnnex1\">Texte de l'annexe 1</label><textarea id=\"wordImportAnnex1\" rows=\"7\" placeholder=\"Le texte de l'annexe 1 apparaîtra ici s'il est reconnu.\"></textarea>\n  <label for=\"wordImportSource1\">Source de l'annexe 1 (à vérifier)</label><input id=\"wordImportSource1\" maxlength=\"1500\" placeholder=\"Référence documentaire réelle, non encore vérifiée\">\n </details><details id=\"wordImportAnnexBox2\" class=\"word-import-annex\">\n  <summary>Annexe 2 — Afficher / corriger</summary>\n  <label for=\"wordImportTitle2\">Titre de l'annexe 2</label><input id=\"wordImportTitle2\" maxlength=\"190\" placeholder=\"Titre de l'annexe\"><label for=\"wordImportAnnex2\">Texte de l'annexe 2</label><textarea id=\"wordImportAnnex2\" rows=\"7\" placeholder=\"Le texte de l'annexe 2 apparaîtra ici s'il est reconnu.\"></textarea>\n  <label for=\"wordImportSource2\">Source de l'annexe 2 (à vérifier)</label><input id=\"wordImportSource2\" maxlength=\"1500\" placeholder=\"Référence documentaire réelle, non encore vérifiée\">\n </details><details id=\"wordImportAnnexBox3\" class=\"word-import-annex\">\n  <summary>Annexe 3 — Afficher / corriger</summary>\n  <label for=\"wordImportTitle3\">Titre de l'annexe 3</label><input id=\"wordImportTitle3\" maxlength=\"190\" placeholder=\"Titre de l'annexe\"><label for=\"wordImportAnnex3\">Texte de l'annexe 3</label><textarea id=\"wordImportAnnex3\" rows=\"7\" placeholder=\"Le texte de l'annexe 3 apparaîtra ici s'il est reconnu.\"></textarea>\n  <label for=\"wordImportSource3\">Source de l'annexe 3 (à vérifier)</label><input id=\"wordImportSource3\" maxlength=\"1500\" placeholder=\"Référence documentaire réelle, non encore vérifiée\">\n </details><details id=\"wordImportAnnexBox4\" class=\"word-import-annex\">\n  <summary>Annexe 4 — Afficher / corriger</summary>\n  <label for=\"wordImportTitle4\">Titre de l'annexe 4</label><input id=\"wordImportTitle4\" maxlength=\"190\" placeholder=\"Titre de l'annexe\"><label for=\"wordImportAnnex4\">Texte de l'annexe 4</label><textarea id=\"wordImportAnnex4\" rows=\"7\" placeholder=\"Le texte de l'annexe 4 apparaîtra ici s'il est reconnu.\"></textarea>\n  <label for=\"wordImportSource4\">Source de l'annexe 4 (à vérifier)</label><input id=\"wordImportSource4\" maxlength=\"1500\" placeholder=\"Référence documentaire réelle, non encore vérifiée\">\n </details>\n <div id=\"wordImportLooseBox\" class=\"word-import-loose\" hidden><p><strong>Texte non classé</strong> — aucun titre « ANNEXE 1 » reconnu. Tu peux reprendre ce contenu manuellement.</p><textarea id=\"wordImportLoose\" rows=\"6\" readonly aria-label=\"Texte extrait du Word non classé\"></textarea><button type=\"button\" class=\"word-import-outline\" id=\"wordImportUseLoose\">Copier ce texte dans l'annexe 1</button></div>\n </fieldset>\n <div class=\"word-import-footer\">\n <button type=\"button\" id=\"wordImportSaveCurrent\" class=\"word-import-outline\">Sauvegarder le dossier actuel (JSON)</button>\n <div class=\"word-import-actions\"><button type=\"button\" id=\"wordImportCancel\" class=\"word-import-outline\">Annuler</button><button type=\"button\" id=\"wordImportConfirm\" class=\"word-import-primary\">Importer dans EGE</button></div>\n </div>\n <p class=\"word-import-hint\">La mise en page, les images, tableaux complexes et signatures du document d'origine ne sont pas conservés. Le nouvel export Word utilisera le modèle EGE de l'application. Les dossiers PDF et .doc anciens ne sont pas pris en charge.</p>\n</section>\n</div>\n<script defer src=\"./word-import.js\"></script>\n<script defer src=\"./phase1.js\"></script>\n</body></html>\n"],"/admin.html":["text/html; charset=utf-8",false,"<!doctype html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#c91b2c\"><meta name=\"robots\" content=\"noindex,nofollow\">\n<title>Administration | EGE GFM 2027</title>\n<link rel=\"icon\" type=\"image/png\" href=\"/monavenir-icon-192.png\">\n<link rel=\"stylesheet\" href=\"./admin.css\">\n<script defer src=\"./vendor/supabase-2.57.4.js\"></script>\n<script defer src=\"./admin.js\"></script>\n<link rel=\"stylesheet\" href=\"./theme-rouge.css\"><link rel=\"stylesheet\" href=\"/ege-interface.css\">\n<script defer src=\"/ege-header-avenir-brand-r1.js\"></script>\n<link rel=\"stylesheet\" href=\"./mon-bac-language-secondary-20261118.css\"><script defer src=\"./mon-bac-language-audit-20261118-r2.js\"></script><link rel=\"stylesheet\" href=\"/monavenir-brand-r1.css\"></head>\n<body>\n<header class=\"topbar\">\n <a class=\"identity\" href=\"./assistant-dossier-gfm-2027.html\"><span class=\"mark\">EGE</span><span><b>EGE GFM 2027</b><small>Administration sécurisée</small></span></a>\n <div class=\"toplinks\"><span id=\"connectionBadge\">Accès restreint</span><a class=\"outline\" href=\"./assistant-dossier-gfm-2027.html\">Ouvrir l'application</a><a class=\"outline\" href=\"./admin-enseignants.html\">Gérer les enseignants</a><button id=\"signOut\" class=\"outline\" hidden type=\"button\">Se déconnecter</button></div>\n</header>\n<div id=\"status\" class=\"status\" role=\"status\" aria-live=\"polite\">Contrôle de l'autorisation…</div>\n<main>\n <section id=\"gate\" class=\"gate\" hidden>\n  <div class=\"gateVisual\"><div class=\"gateSymbol\">EGE<span>27</span></div><h1>Votre espace<br>administrateur</h1><p>Suivez les dossiers des élèves, vérifiez leurs annexes et configurez l'application sans accès aux mots de passe.</p></div>\n  <form id=\"loginForm\" class=\"loginCard\">\n    <span class=\"eyebrow\">ACCÈS PROTÉGÉ</span><h2>Connexion administrateur</h2>\n    <p>Connecte-toi avec le compte EGE autorisé dans Supabase monAvenir.</p>\n    <label for=\"loginEmail\">Adresse e-mail</label><input id=\"loginEmail\" type=\"email\" autocomplete=\"username\" placeholder=\"Adresse du compte autorisé\" required>\n    <label for=\"loginPassword\">Mot de passe</label><div class=\"passwordField\"><input id=\"loginPassword\" type=\"password\" autocomplete=\"current-password\" required><button type=\"button\" id=\"togglePassword\" class=\"passwordToggle\" aria-label=\"Afficher le mot de passe\" title=\"Afficher le mot de passe\" aria-pressed=\"false\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/><path class=\"eyeStrike\" d=\"M3 3 21 21\"/></svg></button></div>\n    <button type=\"submit\" class=\"primary\" id=\"loginBtn\">Accéder à l'administration</button><button type=\"button\" id=\"adminPasswordReset\" class=\"outline\" style=\"width:100%;margin:10px 0\" >Mot de passe oublié ?</button>\n    <p class=\"tiny\">Cette page exige un compte authentifié possédant le rôle « admin ». Un simple compte élève ou enseignant ne donne pas cet accès.</p>\n  </form>\n </section>\n <section id=\"dashboard\" class=\"dashboard\" hidden>\n   <div class=\"intro\"><div><span class=\"eyebrow\">TABLEAU DE BORD</span><h1>Administration EGE</h1><p id=\"adminIdentity\">Administration</p></div><div><button class=\"outline\" type=\"button\" id=\"reload\">Actualiser</button></div></div>\n   <nav class=\"tabs\" aria-label=\"Rubriques de l'administration\">\n      <button type=\"button\" data-tab=\"overview\" class=\"active\" aria-pressed=\"true\">Vue d'ensemble</button>\n      <button type=\"button\" data-tab=\"dossiers\" aria-pressed=\"false\">Dossiers élèves</button>\n      <button type=\"button\" data-tab=\"settings\" aria-pressed=\"false\">Paramètres</button>\n      <button type=\"button\" data-tab=\"security\" aria-pressed=\"false\">Accès et sécurité</button>\n   </nav>\n   <section id=\"overview\" class=\"tabPanel\">\n     <div class=\"stats\"><article><small>Dossiers enregistrés</small><strong id=\"statDossiers\">—</strong><span>Dans l'espace EGE 2027</span></article>\n       <article><small>Corrections enregistrées</small><strong id=\"statReviews\">—</strong><span>Historique des avis</span></article>\n       <article><small>Année scolaire</small><strong id=\"statYear\">—</strong><span>Paramètres de l'application</span></article></div>\n     <div class=\"panel\"><h2>Activité récente</h2><p class=\"muted\">Derniers dossiers modifiés, sans divulgation aux autres élèves.</p><div id=\"recentList\" class=\"entries\"></div></div>\n   </section>\n   <section id=\"dossiers\" class=\"tabPanel\" hidden>\n     <div class=\"panel\"><div class=\"panelHead\"><div><h2>Dossiers des élèves</h2><p class=\"muted\">Affiche les 100 dossiers les plus récents. Les corrections sont conservées dans Supabase.</p></div><input type=\"search\" id=\"search\" placeholder=\"Rechercher un candidat\" aria-label=\"Rechercher un candidat\"></div>\n      <div id=\"dossierList\" class=\"entries\"></div></div>\n     <div id=\"reviewPanel\" class=\"panel\" hidden>\n      <div class=\"panelHead\"><div><span class=\"eyebrow\">RELECTURE</span><h2 id=\"selectedStudent\">Dossier</h2></div><button type=\"button\" class=\"outline\" id=\"closeReview\">Fermer</button></div>\n      <div id=\"studentMeta\" class=\"meta\"></div>\n      <div class=\"document\" id=\"studentDocument\"></div>\n      <h3>Historique des corrections</h3><div id=\"reviewHistory\" class=\"entries\"></div>\n      <label for=\"adminReviewAnnex\">Travail concerné</label><select id=\"adminReviewAnnex\"><option value=\"\">Dossier complet</option><option value=\"1\">Annexe 1</option><option value=\"2\">Annexe 2</option><option value=\"3\">Annexe 3</option><option value=\"4\">Annexe 4 (binôme)</option></select>\n<label for=\"observation\">Observation pédagogique</label><textarea id=\"observation\" maxlength=\"5000\" rows=\"4\" placeholder=\"Indique précisément les éléments à corriger ou le motif de validation.\"></textarea>\n      <div class=\"actions\"><button type=\"button\" class=\"primary\" id=\"markApproved\">Valider le dossier</button><button type=\"button\" class=\"secondary\" id=\"markRevision\">Demander une correction</button></div>\n     </div>\n   </section>\n   <section id=\"settings\" class=\"tabPanel\" hidden>\n    <div class=\"panel\">\n      <h2>Paramètres de l'application</h2><p class=\"muted\">Ces réglages sont enregistrés dans Supabase et affectent la présentation de l'application EGE accessible aux élèves.</p>\n      <form id=\"settingsForm\" class=\"settingsForm\">\n       <label for=\"appTitle\">Nom affiché de l'application</label><input id=\"appTitle\" maxlength=\"100\" minlength=\"3\" required>\n       <label for=\"academicYear\">Année scolaire</label><input id=\"academicYear\" maxlength=\"18\" minlength=\"4\" required placeholder=\"2026–2027\">\n       <label for=\"studentMessage\">Message affiché aux élèves</label><textarea id=\"studentMessage\" maxlength=\"650\" rows=\"4\" placeholder=\"Exemple : Pensez à vérifier vos annexes avant de soumettre votre dossier.\"></textarea>\n       <div class=\"actions\"><button type=\"submit\" class=\"primary\" id=\"saveSettings\">Enregistrer les paramètres</button><span id=\"settingsSaved\" class=\"tiny\"></span></div>\n      </form>\n    </div>\n   </section>\n   <section id=\"security\" class=\"tabPanel\" hidden>\n     <div class=\"panel\">\n       <h2>Accès et sécurité</h2><p>Les dossiers ne sont accessibles qu'à leur auteur et aux enseignants autorisés. Les modifications des paramètres sont réservées aux administrateurs EGE.</p>\n       <div class=\"securityList\">\n         <div><strong>Statut du compte</strong><span id=\"secureRole\">Administrateur</span></div>\n         <div><strong>Base de données</strong><span>Supabase monAvenir — tables EGE 2027 séparées</span></div>\n         <div><strong>Protection</strong><span>Authentification Supabase et politiques RLS</span></div>\n         <div><strong>Comptes des élèves</strong><span>Leurs mots de passe ne sont jamais consultables dans cet espace</span></div>\n       </div>\n       <p class=\"muted\">La nomination d'autres administrateurs se fait uniquement par une opération sécurisée dans Supabase ; aucun utilisateur ne peut se donner ce rôle depuis l'interface.</p>\n     </div>\n   </section>\n<nav class=\"admin-bottom-nav\" id=\"adminBottomNav\" aria-label=\"Navigation de l’administration\">\n <button type=\"button\" data-admin-bottom=\"overview\" aria-pressed=\"true\" class=\"active\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg><span>Accueil</span></button>\n <button type=\"button\" data-admin-bottom=\"dossiers\" aria-pressed=\"false\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 6h7l2 2h9v12H3z\"/></svg><span>Dossiers</span></button>\n <button type=\"button\" data-admin-bottom=\"settings\" aria-pressed=\"false\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16M8 5v4m8 1v4m-8 1v4\"/></svg><span>Paramètres</span></button>\n <button type=\"button\" data-admin-bottom=\"security\" aria-pressed=\"false\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 2 8 4v6c0 5-3 8-8 10-5-2-8-5-8-10V6zM9 12l2 2 4-4\"/></svg><span>Sécurité</span></button>\n</nav>\n </section>\n</main>\n<footer>Prof. Jana Galeh · Administration EGE GFM 2027 · Données protégées par Supabase</footer>\n<nav class=\"ege-admin-bottom\" aria-label=\"Navigation administration\"><a href=\"./?choisir=1\">Accueil</a><a href=\"./admin-enseignants.html\">Enseignants</a><button type=\"button\" data-open-tab=\"dossiers\">Dossiers</button><button type=\"button\" data-open-tab=\"settings\">Paramètres</button></nav></body>\n</html>\n"],"/admin-enseignants.html":["text/html; charset=utf-8",false,"<!doctype html>\n<html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#c91b2c\"><meta name=\"robots\" content=\"noindex,nofollow\">\n<title>Enseignants | Administration EGE GFM 2027</title><link rel=\"icon\" type=\"image/png\" href=\"/monavenir-icon-192.png\">\n<style>\n:root{font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;color:#19354f;background:#f5f7fb;font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:#205fba}button,input,select{font:inherit}button{cursor:pointer}button:disabled{opacity:.55;cursor:wait}[hidden]{display:none!important}\nbutton:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #9bc6fa;outline-offset:3px}\nheader{background:#fff;border-bottom:1px solid #e1e8f3}.head{max-width:1080px;margin:auto;padding:15px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.brand{font-weight:800;text-decoration:none;color:#173b62}.head nav{display:flex;align-items:center;gap:14px;flex-wrap:wrap;font-size:13px}\nmain{max-width:1080px;padding:26px 18px 55px;margin:auto}.eyebrow{font-size:11px;color:#265eb5;font-weight:800;letter-spacing:1px}h1{font-size:clamp(25px,4vw,35px);margin:6px 0 9px}h2{font-size:19px;margin:0 0 10px}.muted{color:#6e8297}\n.card{padding:23px;background:#fff;border:1px solid #dfe8f3;border-radius:17px;margin:16px 0;box-shadow:0 5px 22px #12345909}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px}.grid>.card{margin:0}\nlabel{font-size:13px;display:block;margin:12px 0 5px;font-weight:700}input,select{width:100%;min-height:44px;border:1px solid #c9d9e8;border-radius:9px;padding:10px 12px}\n.btn{border:1px solid #c9daee;color:#1f598a;background:#f2f7fc;border-radius:10px;padding:10px 14px;font-weight:750;min-height:42px}.btn.primary{background:#2065c7;border-color:#2065c7;color:#fff}.btn.warn{color:#9e3a3a;background:#fff6f4;border-color:#eec9c5}.btn.small{font-size:12px;min-height:35px;padding:6px 11px}\n.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:11px}.tag{font-size:12px;display:inline-block;color:#225ca8;background:#eaf3ff;padding:5px 10px;border-radius:10px;font-weight:800}.tag.pending{background:#fff4dd;color:#8c631d}.tag.rejected,.tag.suspended{background:#ffedeb;color:#9b4741}.tag.approved{background:#e8f6ef;color:#196a4b}\n#flash{max-width:1080px;margin:auto;padding:9px 18px;min-height:23px;color:#215c95;white-space:pre-wrap}#flash.error{color:#aa3535}.stat{font-size:12px;color:#6e8197}.stat strong{font-size:23px;display:block;color:#173d65}\n@media(max-width:640px){.card{padding:16px;border-radius:13px}.head nav{gap:8px}}\n</style>\n<script defer src=\"./vendor/supabase-2.57.4.js\"></script>\n<link rel=\"stylesheet\" href=\"./theme-rouge.css\"><link rel=\"stylesheet\" href=\"/ege-interface.css\">\n<script defer src=\"/ege-header-avenir-brand-r1.js\"></script>\n<link rel=\"stylesheet\" href=\"./mon-bac-language-secondary-20261118.css\"><script defer src=\"./mon-bac-language-audit-20261118-r2.js\"></script><link rel=\"stylesheet\" href=\"/monavenir-brand-r1.css\"></head><body>\n<header><div class=\"head\"><a href=\"./admin.html\" class=\"brand\">EGE GFM 2027 · Administration</a><nav><a href=\"./admin.html\">Tableau de bord</a><a href=\"./enseignant.html\">Espace enseignant</a><button id=\"signOut\" class=\"btn small\" hidden>Déconnexion</button></nav></div></header>\n<div id=\"flash\" role=\"status\" aria-live=\"polite\">Vérification de votre accès administrateur…</div>\n<main><div class=\"eyebrow\">CONTRÔLE DES ACCÈS</div><h1>Gestion des enseignants</h1><p class=\"muted\">Validez les demandes avant d’autoriser la création de groupes. Vous pouvez suspendre un accès sans supprimer les dossiers des élèves.</p>\n<section id=\"loginBox\" class=\"card\" hidden><h2>Connexion administrateur</h2><p class=\"muted\">Seuls les comptes autorisés dans EGE peuvent gérer les enseignants.</p>\n<form id=\"loginForm\"><label for=\"email\">Adresse e-mail</label><input id=\"email\" type=\"email\" autocomplete=\"username\" required>\n<label for=\"password\">Mot de passe</label><input id=\"password\" type=\"password\" autocomplete=\"current-password\" required>\n<button class=\"btn primary\" type=\"submit\" style=\"margin-top:14px\">Se connecter</button></form></section>\n<section id=\"adminBox\" hidden><div class=\"row\" style=\"justify-content:space-between\"><div class=\"grid\" style=\"flex:1;max-width:480px\"><div class=\"card stat\"><strong id=\"totalTeachers\">—</strong>Demandes enregistrées</div><div class=\"card stat\"><strong id=\"pendingTeachers\">—</strong>En attente</div></div><button id=\"reload\" class=\"btn\">Actualiser</button></div>\n<div class=\"card\"><label for=\"filter\">Filtrer les demandes</label><select id=\"filter\"><option value=\"\">Tous les statuts</option><option value=\"pending\">En attente</option><option value=\"approved\">Approuvés</option><option value=\"rejected\">Refusés</option><option value=\"suspended\">Suspendus</option></select></div>\n<div id=\"teacherList\" class=\"grid\" aria-live=\"polite\"></div>\n<section class=\"card\" id=\"groupsAdminSection\" style=\"margin-top:30px\">\n <h2>Groupes et affectations</h2><p class=\"muted\">Créez une classe, adaptez son intitulé ou retirez un élève sans supprimer ses documents.</p>\n <form id=\"adminCreateGroup\" class=\"grid\">\n  <div><label for=\"adminTeacher\">Enseignant approuvé</label><select id=\"adminTeacher\" required></select></div>\n  <div><label for=\"adminGroupName\">Classe ou groupe</label><input id=\"adminGroupName\" required minlength=\"2\" maxlength=\"90\" placeholder=\"Ex. TGFM6\"></div>\n  <div><label for=\"adminSchool\">Établissement</label><input id=\"adminSchool\" maxlength=\"160\" placeholder=\"Ex. Lycée d'État\"></div>\n  <div class=\"row\" style=\"align-items:end\"><button type=\"submit\" class=\"btn primary\">Créer ce groupe</button></div>\n </form>\n <div id=\"adminGroupsList\" class=\"grid\" style=\"margin-top:20px\" aria-live=\"polite\"></div>\n</section>\n<section class=\"card\"><h2>Historique administratif</h2><p class=\"muted\">Décisions importantes et retraits de membres.</p><div id=\"adminAuditList\" aria-live=\"polite\"></div></section>\n</section></main>\n<script>\n(()=>{'use strict';\nconst DB='https://nwcatsmfbkcgvgbanwyl.supabase.co',KEY='sb_publishable_vXuRHP_lqGqtV9d1C_oZWw_SetdoY7L';\nconst $=id=>document.getElementById(id);\nconst mk=(tag,cls,txt)=>{const e=document.createElement(tag);if(cls)e.className=cls;if(txt!==undefined)e.textContent=String(txt);return e};\nlet api,user,admin=false,requests=[],teacherGroups=[],groupMembers=[];\nfunction note(s,err=false){$('flash').textContent=s;$('flash').classList.toggle('error',err)}\nfunction show(id,v){$(id).hidden=!v}\nfunction date(s){return s?new Date(s).toLocaleDateString('fr-FR'):'—'}\nasync function check(){\n try{\n const auth=await api.auth.getUser();if(auth.error)throw auth.error;\n user=auth.data.user||null;admin=false;show('signOut',!!user);\n if(!user){show('loginBox',true);show('adminBox',false);note('Connexion administrateur nécessaire.');return}\n const role=await api.from('ege2027_staff').select('role').eq('user_id',user.id).maybeSingle();\n if(role.error)throw role.error;\n admin=role.data?.role==='admin';show('loginBox',!admin);show('adminBox',admin);\n if(!admin){note('Accès refusé : ce compte n’est pas administrateur EGE.',true);return}\n await load();\n }catch(e){show('adminBox',false);show('loginBox',true);note('Vérification impossible : '+e.message,true)}\n}\nasync function load(){\n if(!admin)return;\n const r=await api.from('ege2027_teacher_requests').select('user_id,full_name,school,status,created_at,reviewed_at,reviewed_by,rejection_reason').order('created_at',{ascending:false}).limit(500);\n if(r.error){note('Chargement impossible : '+r.error.message,true);return}\n requests=r.data||[];\n $('totalTeachers').textContent=requests.length+(requests.length===500?'+':'');\n $('pendingTeachers').textContent=requests.filter(x=>x.status==='pending').length;\n render();await loadGroupsAdmin();note('Administration actualisée.');\n}\nfunction action(txt,kind,fn){const b=mk('button','btn small'+(kind?' '+kind:''),txt);b.type='button';b.addEventListener('click',fn);return b}\nfunction render(){\n const host=$('teacherList');host.replaceChildren();\n const f=$('filter').value,list=requests.filter(r=>!f||r.status===f);\n if(!list.length){const empty=mk('div','card');empty.append(mk('p','muted','Aucune demande pour ce filtre.'));host.append(empty);return}\n const labels={pending:'En attente',approved:'Approuvé',rejected:'Refusé',suspended:'Suspendu'};\n for(const r of list){\n  const box=mk('article','card'),status=mk('span','tag '+r.status,labels[r.status]||r.status);\n  box.append(status,mk('h2','',r.full_name),mk('p','muted',r.school));\n  box.append(mk('p','stat','Demande du '+date(r.created_at)+(r.reviewed_at?' · Décision du '+date(r.reviewed_at):'')));\n  if(r.rejection_reason)box.append(mk('p','muted','Observation : '+r.rejection_reason));\n  const row=mk('div','row');\n  if(r.status!=='approved')row.append(action('Approuver','primary',()=>decide(r,'approved')));\n  if(r.status!=='rejected')row.append(action('Refuser','warn',()=>decide(r,'rejected')));\n  if(r.status==='approved')row.append(action('Suspendre','warn',()=>decide(r,'suspended')));\n  box.append(row);host.append(box);\n }\n}\nasync function decide(r,status){\n if(!admin||!user)return;\n const labels={approved:'approuver',rejected:'refuser',suspended:'suspendre'};\n let rejection_reason='';\n if(status==='approved'){\n  if(!await window.MBDialog.confirm('Approuver '+r.full_name+' et lui permettre de créer ses groupes d’élèves ?'))return;\n }else{\n  const text=await window.MBDialog.prompt('Motif de la décision (visible par l’enseignant) :','');\n  if(text===null)return;\n  rejection_reason=text.trim().slice(0,1000);\n  if(!rejection_reason){note('Indiquez un motif de refus ou suspension.',true);return}\n }\n try{\n  const {error}=await api.from('ege2027_teacher_requests').update({\n    status,rejection_reason,reviewed_at:new Date().toISOString(),reviewed_by:user.id\n   }).eq('user_id',r.user_id);\n  if(error)throw error;\n  await load();note('Demande de '+r.full_name+' : '+labels[status]+' — décision enregistrée.');\n }catch(e){note('Modification refusée : '+e.message,true)}\n}\nasync function loadGroupsAdmin(){\n if(!admin)return;\n const [g,m,a]=await Promise.all([\n  api.from('ege2027_teacher_groups').select('id,teacher_id,name,school,active,join_code,created_at').order('created_at',{ascending:false}).limit(500),\n  api.from('ege2027_group_members').select('group_id,student_id,student_name,joined_at').limit(2500),\n  api.from('ege2027_audit_log').select('action,entity_type,details,created_at').order('created_at',{ascending:false}).limit(35)\n ]);\n if(g.error||m.error||a.error){note('Supervision partiellement indisponible : '+(g.error||m.error||a.error).message,true);return}\n teacherGroups=g.data||[];groupMembers=m.data||[];renderGroupsAdmin(a.data||[]);\n}\nfunction renderGroupsAdmin(audit){\n const options=$('adminTeacher');options.replaceChildren();\n const approved=requests.filter(t=>t.status==='approved');\n options.add(new Option('Choisir un enseignant',''));\n approved.forEach(t=>options.add(new Option(t.full_name+' · '+t.school,t.user_id)));\n const names=new Map(requests.map(t=>[t.user_id,t.full_name]));\n const host=$('adminGroupsList');host.replaceChildren();\n if(!teacherGroups.length)host.append(mk('p','muted','Aucun groupe créé.'));\n for(const group of teacherGroups){\n  const box=mk('article','card');box.style.margin='0';\n  const label=mk('span','tag '+(group.active?'approved':'suspended'),group.active?'Inscriptions ouvertes':'Inscriptions arrêtées');\n  box.append(label,mk('h2','',group.name),mk('p','muted',(group.school||'Établissement à préciser')+' · '+(names.get(group.teacher_id)||'Enseignant')));\n  const members=groupMembers.filter(m=>m.group_id===group.id);\n  box.append(mk('p','stat',members.length+' élève(s) · Code de classe : '+group.join_code));\n  const actions=mk('div','row');\n  actions.append(action('Renommer','',()=>renameGroupAdmin(group)));\n  actions.append(action(group.active?'Suspendre les inscriptions':'Réactiver','',()=>toggleGroupAdmin(group)));\n  box.append(actions);\n  for(const m of members){\n   const line=mk('div','row');line.style.justifyContent='space-between';\n   line.append(mk('span','',m.student_name));\n   line.append(action('Retirer','warn',()=>removeStudentAdmin(group,m)));\n   box.append(line);\n  }\n  host.append(box);\n }\n const auditHost=$('adminAuditList');auditHost.replaceChildren();\n if(!audit.length)auditHost.append(mk('p','muted','Aucune intervention enregistrée pour le moment.'));\n for(const item of audit){\n  const line=mk('div','entry');\n  const title=item.entity_type==='ege2027_teacher_requests'?'Compte enseignant':item.entity_type==='ege2027_group_members'?'Affectation élève':'Gestion groupe';\n  line.append(mk('strong','',title+' · '+(item.action==='DELETE'?'Retrait':item.action==='UPDATE'?'Modification':'Création')));\n  line.append(mk('small','',date(item.created_at)));\n  auditHost.append(line);\n }\n}\nasync function createGroupAdmin(e){\n e.preventDefault();if(!admin)return;\n const teacher_id=$('adminTeacher').value,name=$('adminGroupName').value.trim(),school=$('adminSchool').value.trim();\n if(!requests.some(r=>r.user_id===teacher_id&&r.status==='approved')||name.length<2){note('Choisissez un enseignant approuvé et une classe.',true);return}\n const b=e.currentTarget.querySelector('[type=submit]');b.disabled=true;\n try{const {error}=await api.from('ege2027_teacher_groups').insert({teacher_id,name,school});\n  if(error)throw error;$('adminGroupName').value='';await loadGroupsAdmin();note('Groupe créé. Son code figure dans la liste.')}\n catch(err){note('Création impossible : '+err.message,true)}finally{b.disabled=false}\n}\nasync function renameGroupAdmin(g){\n const name=await window.MBDialog.prompt('Nouveau nom de la classe :',g.name);if(name===null)return;\n const next=name.trim();if(next.length<2||next.length>90){note('Le nom doit contenir 2 à 90 caractères.',true);return}\n const school=await window.MBDialog.prompt('Établissement :',g.school||'');if(school===null)return;\n const {error}=await api.from('ege2027_teacher_groups').update({name:next,school:school.trim().slice(0,160)}).eq('id',g.id);\n if(error){note('Modification impossible : '+error.message,true);return}\n await loadGroupsAdmin();note('Classe mise à jour.');\n}\nasync function toggleGroupAdmin(g){\n if(!await window.MBDialog.confirm((g.active?'Suspendre':'Réactiver')+' les inscriptions de « '+g.name+' » ?'))return;\n const {error}=await api.from('ege2027_teacher_groups').update({active:!g.active}).eq('id',g.id);\n if(error){note(error.message,true);return}\n await loadGroupsAdmin();note('Statut du groupe modifié.');\n}\nasync function removeStudentAdmin(g,m){\n if(!await window.MBDialog.confirm('Retirer « '+m.student_name+' » du groupe « '+g.name+' » ? Le dossier de cet élève sera conservé.'))return;\n const {error}=await api.from('ege2027_group_members').delete().eq('group_id',g.id).eq('student_id',m.student_id);\n if(error){note('Retrait impossible : '+error.message,true);return}\n await loadGroupsAdmin();note('Élève retiré. Ses dossiers restent dans son compte.');\n}\ndocument.addEventListener('DOMContentLoaded',async()=>{\n if(!window.supabase?.createClient){note('Supabase indisponible. Vérifiez la connexion Internet.',true);return}\n api=window.supabase.createClient(DB,KEY);\n $('loginForm').addEventListener('submit',async e=>{\n  e.preventDefault();const btn=e.currentTarget.querySelector('button');btn.disabled=true;\n  try{const {error}=await api.auth.signInWithPassword({email:$('email').value.trim().toLowerCase(),password:$('password').value});if(error)throw error;$('password').value='';await check()}\n  catch(x){note('Connexion impossible : '+x.message,true)}finally{btn.disabled=false}\n });\n $('signOut').addEventListener('click',async()=>{await api.auth.signOut();await check()});\n $('reload').addEventListener('click',load);$('filter').addEventListener('change',render);\n $('adminCreateGroup').addEventListener('submit',createGroupAdmin);\n api.auth.onAuthStateChange(e=>{if(e==='SIGNED_OUT')check()});\n await check();\n});\n})();\n</script></body></html>\n"],"/admin.js":["application/javascript; charset=utf-8",false,"'use strict';\nconst URL_DB='https://nwcatsmfbkcgvgbanwyl.supabase.co';\nconst PUBLIC_KEY='sb_publishable_vXuRHP_lqGqtV9d1C_oZWw_SetdoY7L';\nconst $=id=>document.getElementById(id);\nlet client=null,user=null,member=null,rows=[],selected=null,activeTab='overview';\nconst pad=(s)=>String(s||'').trim();\nconst date=v=>{try{return new Date(v).toLocaleString('fr-FR')}catch{return '—'}};\nfunction message(text,kind=''){const node=$('status');node.textContent=text;node.className='status'+(kind?' '+kind:'');}\nfunction node(tag,cls,text){const e=document.createElement(tag);if(cls)e.className=cls;if(text!==undefined)e.textContent=String(text);return e;}\nfunction visible(id,yes){$(id).hidden=!yes}\nfunction loginView(note){user=null;member=null;visible('gate',true);visible('dashboard',false);visible('signOut',false);$('connectionBadge').textContent='Accès restreint';message(note||'Connecte-toi avec ton compte administrateur.');}\nasync function ensureAdmin(){\n const {data:{user:who},error}=await client.auth.getUser();\n if(error||!who){loginView('Connexion requise. Aucun dossier n’est accessible avant authentification.');return false}\n const result=await client.from('ege2027_staff').select('role').eq('user_id',who.id).maybeSingle();\n if(result.error){loginView('Vérification du rôle impossible : '+result.error.message);return false}\n if(result.data?.role!=='admin'){loginView('Accès refusé. Ce compte ne possède pas le rôle administrateur EGE.');return false}\n user=who;member=result.data;window.EGEHeader?.setUser(user,client);\n visible('gate',false);visible('dashboard',true);visible('signOut',true);\n $('connectionBadge').textContent='Administrateur connecté';\n $('adminIdentity').textContent='Compte autorisé : '+(user.email||'administrateur');\n $('secureRole').textContent='Administrateur EGE authentifié';\n message('Accès administrateur vérifié.', 'ok');\n await refreshAll();return true;\n}\nasync function refreshAll(){\n if(!user||member?.role!=='admin')return;\n const [dossiers,reviews,settings]=await Promise.all([\n client.from('ege2027_dossiers').select('id,owner_id,student,created_at,updated_at,payload').order('updated_at',{ascending:false}).limit(100),\n client.from('ege2027_reviews').select('id,dossier_id,decision,observation,annex_number,created_at').order('created_at',{ascending:false}).limit(200),\n client.from('ege2027_settings').select('id,app_title,academic_year,student_message,updated_at').eq('id',1).single()\n ]);\n if(dossiers.error||reviews.error||settings.error){message('Erreur de chargement : '+(dossiers.error||reviews.error||settings.error).message,'error');return}\n rows=dossiers.data||[];\n $('statDossiers').textContent=String(rows.length)+(rows.length===100?' +':'');\n $('statReviews').textContent=String((reviews.data||[]).length)+(reviews.data?.length===200?' +':'');\n $('statYear').textContent=settings.data.academic_year;\n $('appTitle').value=settings.data.app_title;\n $('academicYear').value=settings.data.academic_year;\n $('studentMessage').value=settings.data.student_message;\n $('settingsSaved').textContent='Dernière mise à jour : '+date(settings.data.updated_at);\n showList($('recentList'),rows.slice(0,6),false);\n showList($('dossierList'),filtered(),true);\n if(selected){selected=rows.find(r=>r.id===selected.id)||null;if(selected)renderSelected((reviews.data||[]).filter(r=>r.dossier_id===selected.id));}\n message('Données actualisées. Accès réservé aux administrateurs EGE.', 'ok');\n}\nfunction filtered(){const q=pad($('search').value).toLocaleLowerCase('fr');return q?rows.filter(x=>(x.student||x.payload?.student||'').toLocaleLowerCase('fr').includes(q)):rows}\nfunction showList(parent,data,interactive){\n parent.replaceChildren();\n if(!data.length){parent.append(node('p','muted','Aucun dossier enregistré pour le moment.'));return}\n for(const row of data){\n  const b=node(interactive?'button':'div','entry');\n  if(interactive)b.type='button';\n  const left=node('div');left.append(node('b','',row.student||row.payload?.student||'Candidat sans nom'));\n  left.append(node('small','','Dernière modification : '+date(row.updated_at)));\n  b.append(left,node('span','pill',interactive?'Consulter':'Récemment modifié'));\n  if(interactive)b.addEventListener('click',()=>choose(row));\n  parent.append(b);\n }\n}\nasync function choose(row){\n selected=row;visible('reviewPanel',true);\n const resp=await client.from('ege2027_reviews').select('decision,observation,created_at').eq('dossier_id',row.id).order('created_at',{ascending:false}).limit(30);\n if(resp.error){message('Historique indisponible : '+resp.error.message,'error');return}\n renderSelected(resp.data||[]);\n $('reviewPanel').scrollIntoView({behavior:'smooth',block:'start'});\n}\nfunction renderSelected(history){\n if(!selected)return;\n const d=selected.payload||{};\n $('selectedStudent').textContent=selected.student||d.student||'Candidat sans nom';\n $('studentMeta').textContent='Classe : '+(d.className||'—')+' · Établissement : '+(d.school||'—')+' · Mis à jour : '+date(selected.updated_at);\n const doc=$('studentDocument');doc.replaceChildren();\n for(const [label,value] of [['Mode',d.mode],['Thème',d.theme],['Sous-thème',d.subtheme],['Problématique',d.problem],['Professeur',d.teacher]]){\n  const t=node('h3','',label);const p=node('p','',value===null||value===undefined||value===''?'—':String(value));doc.append(t,p)\n }\n const annexes=d.annexes||{},titles=d.annexTitles||{},sources=d.sources||{},sourceChecks=d.sourceChecks||{};\n const defaultTitles=['Les notions générales','Comprendre le sous-thème','Éléments de réponse à la problématique','Conditions et limites'];\n for(const [num,value] of Object.entries(annexes).sort(([a],[b])=>Number(a)-Number(b))){\n  const n=Number(num);if(!Number.isInteger(n)||n<1||n>4)continue;\n  const article=node('article','admin-annex-card');\n  article.append(node('small','admin-annex-label','ANNEXE '+n));\n  article.append(node('h3','admin-annex-title',String(titles[n]||defaultTitles[n-1])));\n  article.append(node('div','admin-annex-content',String(value||'Non rédigée').slice(0,40000)));\n  const source=node('div','admin-annex-source');\n  source.append(node('strong','','Source : '),node('span','',String(sources[n]||'À renseigner')));\n  article.append(source,node('small','admin-annex-check',sourceChecks[n]?'Source déclarée vérifiée par l’élève':'Source à vérifier'));\n  doc.append(article);\n }\n const historyDiv=$('reviewHistory');historyDiv.replaceChildren();\n if(!history.length)historyDiv.append(node('p','muted','Aucune correction enregistrée.'));\n for(const rev of history){\n  const e=node('div','entry review'),title=node('b','',(rev.decision==='valide'?'Validé':'À corriger')+(rev.annex_number?' · Annexe '+rev.annex_number:' · Dossier complet'));\n  e.append(title,node('small','',date(rev.created_at)),node('p','',rev.observation||'Aucune observation'));\n  historyDiv.append(e);\n }\n}\nasync function sendReview(decision){\n if(!selected||!user||member?.role!=='admin')return;\n const observation=pad($('observation').value);\n if(decision==='a_corriger'&&!observation){message('Indique une observation pour demander une correction.','error');return}\n if(decision==='valide'&&!await window.MBDialog.confirm('Confirmer la validation de ce dossier ?'))return;\n const buttons=[$('markApproved'),$('markRevision')];buttons.forEach(b=>b.disabled=true);\n try{\n  const {error}=await client.from('ege2027_reviews').insert({dossier_id:selected.id,staff_id:user.id,decision,observation,annex_number:$('adminReviewAnnex').value?Number($('adminReviewAnnex').value):null});\n  if(error)throw error;\n  $('observation').value='';\n  message(decision==='valide'?'Validation enregistrée.':'Demande de correction enregistrée.','ok');\n  await choose(selected);await refreshAll();\n }catch(e){message('Impossible d’enregistrer la correction : '+e.message,'error')}\n finally{buttons.forEach(b=>b.disabled=false)}\n}\nasync function saveSettings(event){\n event.preventDefault();if(!user||member?.role!=='admin')return;\n const app_title=pad($('appTitle').value),academic_year=pad($('academicYear').value),student_message=pad($('studentMessage').value);\n if(app_title.length<3||academic_year.length<4||student_message.length>650){message('Vérifie le nom, l’année scolaire et le message (650 caractères maximum).','error');return}\n $('saveSettings').disabled=true;\n try{\n  const {data,error}=await client.from('ege2027_settings').update({app_title,academic_year,student_message,updated_at:new Date().toISOString(),updated_by:user.id}).eq('id',1).select('updated_at').single();\n  if(error)throw error;\n  $('settingsSaved').textContent='Enregistré le '+date(data.updated_at);\n  $('statYear').textContent=academic_year;\n  message('Paramètres enregistrés. Les élèves verront les modifications à l’ouverture de l’application.','ok');\n }catch(e){message('Enregistrement refusé : '+e.message,'error')}finally{$('saveSettings').disabled=false}\n}\n\n/* Validation centrale des enseignants EGE (l'administration seule peut modifier le statut). */\nfunction installTeacherAdminUI(){\n if($('teachers'))return;\n const nav=document.querySelector('#dashboard .tabs');\n const tabButton=node('button','','Enseignants');tabButton.type='button';tabButton.dataset.tab='teachers';tabButton.setAttribute('aria-pressed','false');nav.append(tabButton);\n const panel=node('section','tabPanel');panel.id='teachers';panel.hidden=true;\n const content=node('div','panel');\n const heading=node('h2','','Validation des enseignants');\n const lead=node('p','muted','Approuvez les comptes enseignants avant qu’ils puissent créer des groupes ou consulter les dossiers de leurs propres élèves.');\n const reload=node('button','outline','Actualiser les demandes');reload.type='button';reload.addEventListener('click',loadTeacherRequests);\n const host=node('div','entries');host.id='egeTeacherRequests';\n content.append(heading,lead,reload,host);panel.append(content);\n const dash=$('dashboard');dash.insertBefore(panel,$('adminBottomNav'));\n const mobile=node('button');mobile.type='button';mobile.dataset.adminBottom='teachers';mobile.setAttribute('aria-pressed','false');\n mobile.innerHTML='<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"7\" r=\"3\"/><path d=\"M3 20v-2a6 6 0 0 1 12 0v2M18 9v8m-4-4h8\"/></svg><span>Profs</span>';\n $('adminBottomNav').append(mobile);\n}\nasync function loadTeacherRequests(){\n if(!user||member?.role!=='admin')return;\n const host=$('egeTeacherRequests');if(!host)return;\n host.replaceChildren(node('p','muted','Chargement…'));\n const {data,error}=await client.from('ege2027_teacher_requests')\n  .select('user_id,full_name,school,status,created_at,rejection_reason')\n  .order('created_at',{ascending:false}).limit(200);\n if(error){host.replaceChildren(node('p','muted','Chargement impossible : '+error.message));return}\n host.replaceChildren();\n if(!data?.length){host.append(node('p','muted','Aucune demande pour le moment.'));return}\n const labels={pending:'En attente',approved:'Approuvé',rejected:'Refusé',suspended:'Suspendu'};\n for(const t of data){\n  const item=node('article','entry');\n  const info=node('div');\n  info.append(node('b','',t.full_name+' · '+t.school));\n  info.append(node('small','','Statut : '+(labels[t.status]||t.status)+' · Demande du '+date(t.created_at)));\n  if(t.rejection_reason)info.append(node('small','','Observation : '+t.rejection_reason));\n  const buttons=node('div','actions');buttons.style.flexWrap='wrap';\n  const add=(label,status,cls)=>{\n   const b=node('button',cls,label);b.type='button';b.style.minHeight='38px';\n   b.addEventListener('click',()=>decideTeacher(t,status));buttons.append(b);\n  };\n  if(t.status!=='approved')add('Approuver','approved','primary');\n  if(t.status==='pending')add('Refuser','rejected','outline');\n  if(t.status==='approved')add('Suspendre','suspended','outline');\n  item.append(info,buttons);host.append(item);\n }\n}\nasync function decideTeacher(t,status){\n if(!user||member?.role!=='admin')return;\n let reason=null;\n if(status==='approved'){\n  if(!await window.MBDialog.confirm('Autoriser '+t.full_name+' à gérer ses classes et à corriger les dossiers de ses élèves ?'))return;\n }else{\n  reason=await window.MBDialog.prompt('Motif (visible par l’enseignant) :',status==='suspended'?'Accès temporairement suspendu.':'');\n  if(reason===null)return;\n  if(!reason.trim()){message('Indique un motif pour refuser ou suspendre.','error');return}\n }\n const payload={status,reviewed_at:new Date().toISOString(),reviewed_by:user.id,rejection_reason:status==='approved'?null:reason.trim().slice(0,500)};\n const {error}=await client.from('ege2027_teacher_requests').update(payload).eq('user_id',t.user_id);\n if(error){message('Décision non enregistrée : '+error.message,'error');return}\n message(status==='approved'?'Enseignant approuvé.':'Statut enseignant modifié.','ok');\n await loadTeacherRequests();\n}\n\nfunction tab(name){\n activeTab=name;\n for(const x of ['overview','dossiers','settings','security','teachers'])visible(x,x===name);\n document.querySelectorAll('[data-tab]').forEach(b=>{const on=b.dataset.tab===name;b.classList.toggle('active',on);b.setAttribute('aria-pressed',String(on))});\n document.querySelectorAll('[data-admin-bottom]').forEach(b=>{const on=b.dataset.adminBottom===name;b.classList.toggle('active',on);b.setAttribute('aria-pressed',String(on))});\n if(name==='dossiers')$('search').focus();\n if(name==='teachers')loadTeacherRequests();\n}\nasync function signOut(){await client.auth.signOut();loginView('Déconnexion effectuée.')}\nasync function start(){\n document.querySelectorAll('[data-open-tab]').forEach(b=>b.addEventListener('click',()=>document.querySelector('[data-tab=\"'+b.dataset.openTab+'\"]')?.click()));\n if(!window.supabase?.createClient){loginView('Bibliothèque Supabase indisponible. Vérifie ta connexion Internet.');return}\n client=window.supabase.createClient(URL_DB,PUBLIC_KEY);\n installTeacherAdminUI();\n const eye=$('togglePassword');\n eye?.addEventListener('click',()=>{\n  const field=$('loginPassword');\n  if(!field)return;\n  const show=field.type==='password';\n  field.type=show?'text':'password';\n  eye.setAttribute('aria-pressed',String(show));\n  eye.setAttribute('aria-label',show?'Masquer le mot de passe':'Afficher le mot de passe');\n  eye.title=show?'Masquer le mot de passe':'Afficher le mot de passe';\n  field.focus();\n });\n $('loginForm').addEventListener('submit',async event=>{\n  event.preventDefault();$('loginBtn').disabled=true;\n  message('Authentification en cours…');\n  try{\n   const email=pad($('loginEmail').value).toLowerCase(),password=$('loginPassword').value;\n   const {error}=await client.auth.signInWithPassword({email,password});\n   if(error)throw error;\n   $('loginPassword').value='';\n   await ensureAdmin();\n  }catch(e){message(/email not confirmed/i.test(e.message)?'Adresse e-mail non confirmée. Confirme-la avant de te connecter.':'Connexion impossible : '+e.message,'error')}\n  finally{$('loginBtn').disabled=false}\n });\n $('signOut').addEventListener('click',signOut);\n $('adminPasswordReset')?.addEventListener('click',async()=>{\n  const email=pad($('loginEmail')?.value).toLowerCase();\n  if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)){message('Entre ton adresse e-mail pour réinitialiser le mot de passe.','error');return;}\n  const btn=$('adminPasswordReset');btn.disabled=true;\n  try{\n   const {error}=await client.auth.resetPasswordForEmail(email,{redirectTo:'https://ege-gfm-2027.janakaleh.workers.dev/'});\n   if(error)throw error;\n   message('Un e-mail de réinitialisation a été demandé. Vérifie ta boîte et les spams. Le lien ouvre EGE 2027.','ok');\n  }catch(e){message('Réinitialisation impossible : '+e.message,'error');}\n  finally{btn.disabled=false;}\n });\n $('reload').addEventListener('click',refreshAll);\n $('search').addEventListener('input',()=>showList($('dossierList'),filtered(),true));\n $('closeReview').addEventListener('click',()=>{selected=null;visible('reviewPanel',false)});\n $('markApproved').addEventListener('click',()=>sendReview('valide'));\n $('markRevision').addEventListener('click',()=>sendReview('a_corriger'));\n $('settingsForm').addEventListener('submit',saveSettings);\n document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>tab(b.dataset.tab)));\n document.querySelectorAll('[data-admin-bottom]').forEach(b=>b.addEventListener('click',()=>{tab(b.dataset.adminBottom);window.scrollTo({top:0,behavior:'smooth'})}));\n document.addEventListener('focusin',ev=>{\n   if(ev.target?.matches?.('input:not([type=checkbox]):not([type=radio]),textarea,select,[contenteditable=true]'))document.body.classList.add('admin-keyboard-open');\n });\n document.addEventListener('focusout',()=>requestAnimationFrame(()=>{\n   if(!document.activeElement?.matches?.('input:not([type=checkbox]):not([type=radio]),textarea,select,[contenteditable=true]'))document.body.classList.remove('admin-keyboard-open');\n }));\n \n client.auth.onAuthStateChange((event)=>{if(event==='SIGNED_OUT')loginView('Tu as été déconnecté.')});\n await ensureAdmin();\n}\ndocument.addEventListener('DOMContentLoaded',start);\n"],"/enseignant.html":["text/html; charset=utf-8",false,"<!doctype html>\n<html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#c91b2c\"><meta name=\"robots\" content=\"noindex,nofollow\">\n<title>Espace enseignant | EGE GFM 2027</title><link rel=\"icon\" type=\"image/png\" href=\"/monavenir-icon-192.png\">\n<style>\n:root{font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;color:#163450;background:#f3f7fc;font-synthesis:none}\n*{box-sizing:border-box}body{margin:0;padding-bottom:env(safe-area-inset-bottom)}a{color:#1c5bb8}button,input,textarea{font:inherit}button{cursor:pointer}\nbutton:disabled{opacity:.55;cursor:not-allowed}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #90c4ff;outline-offset:2px}\nheader{background:#fff;border-bottom:1px solid #e0e9f5;box-shadow:0 2px 15px #12345b0d}\n.head{max-width:1060px;margin:auto;padding:14px 18px;display:flex;justify-content:space-between;gap:12px;align-items:center}\n.brand{text-decoration:none;color:#173b62;display:flex;align-items:center;gap:11px;font-weight:800}.logo{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:#1761c1;color:white}.brand small{display:block;font-weight:500;font-size:12px;color:#7a8a9d}\nmain{max-width:1060px;margin:22px auto;padding:0 16px 45px}.title{font-size:clamp(24px,4vw,34px);letter-spacing:-.7px;margin:2px 0 7px}\n.eyebrow{color:#2763b8;font-size:11px;font-weight:850;letter-spacing:1.2px}.lead,.muted{color:#6c8095}.lead{margin:0 0 20px}.card{background:white;border:1px solid #dfe9f4;border-radius:18px;padding:22px;box-shadow:0 6px 20px #12345b09;margin:14px 0}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:14px}.grid>.card{margin:0}\nlabel{display:block;font-size:13px;font-weight:750;margin:14px 0 5px}\ninput,textarea{width:100%;border:1px solid #cbdbea;border-radius:11px;background:white;color:#18344f;padding:12px;min-height:44px}textarea{resize:vertical}\ninput[readonly]{background:#f4f8fd;font-weight:800;letter-spacing:1px}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.row>*{min-width:0}\n.btn{border:1px solid #c7d8ee;background:#f0f6fc;color:#235987;border-radius:11px;padding:11px 16px;min-height:44px;font-weight:750}\n.btn.primary{background:#2064c6;color:white;border-color:#2064c6}.btn.danger{background:#fff5f4;color:#a44747;border-color:#f1c9c5}\n.btn.sm{font-size:12px;padding:8px 11px;min-height:36px}\n#flash{margin:0 auto;max-width:1060px;padding:10px 17px;color:#1d5d95;white-space:pre-wrap;min-height:20px}\n#flash.error{color:#ac3d33}\n.tag{display:inline-block;background:#eaf3ff;color:#2460af;border-radius:9px;padding:5px 9px;font-size:12px;font-weight:800}\n.pupil{border-top:1px solid #e6edf6;padding:13px 0;display:flex;justify-content:space-between;align-items:center;gap:10px}\n.pupil b{display:block}.pupil small{color:#76899c;display:block;margin-top:3px}.pupil button{white-space:nowrap}\n.groupHead{display:flex;gap:10px;justify-content:space-between;align-items:start;flex-wrap:wrap}.groupHead h2{margin:2px 0 5px;font-size:19px}\n.codebar{background:#eff5fd;border:1px dashed #b3cce7;border-radius:12px;padding:12px;display:flex;gap:9px;align-items:center;flex-wrap:wrap}.codebar strong{letter-spacing:2px;font-size:19px}\nhr{border:0;border-top:1px solid #e5ecf5;margin:16px 0}\n[hidden]{display:none!important}\ndialog{width:min(94vw,750px);border:1px solid #d8e5f3;border-radius:18px;padding:23px;box-shadow:0 20px 70px #10294655;max-height:90dvh;overflow:auto}\ndialog::backdrop{background:#102b48ac}#documentBody{white-space:pre-wrap;word-break:break-word;max-height:40vh;overflow:auto;background:#f7faff;padding:14px;border-radius:12px;font-size:13px}\n.history{max-height:140px;overflow:auto;color:#435d75;font-size:12px}.history p{margin:8px 0;padding:8px;background:#f4f8fd;border-radius:9px}\n@media(max-width:640px){main{margin-top:15px}.card{padding:16px;border-radius:14px}.pupil{align-items:start;flex-direction:column}.groupHead{display:block}}\n\n/* Aperçu lisible du dossier par le professeur */\n#documentBody{white-space:normal;word-break:normal;max-height:55vh;overflow:auto;background:#f5f8fc;padding:12px;border-radius:12px;font-size:14px}\n.dossier-info{background:#fff;border:1px solid #dfe8f3;border-radius:10px;padding:14px;margin-bottom:12px}\n.dossier-info-row{margin:5px 0;font-size:13px;color:#425b73}.dossier-info-row strong{color:#1c3853}\n.annex-preview-card{padding:22px 18px;margin:13px 0;background:#fff;border:1px solid #dce5ef;border-radius:10px;box-shadow:0 2px 10px #19365008}\n.annex-preview-kicker{font:800 11px system-ui,sans-serif;letter-spacing:1.2px;color:#51718d;text-align:center}\n.annex-preview-title{text-align:center;margin:12px 0 18px;font:700 18px/1.4 Georgia,serif;color:#21384e}\n.annex-preview-content{white-space:pre-wrap;word-break:break-word;font:15px/1.7 Georgia,'Times New Roman',serif;color:#2b3d4b}\n.annex-preview-source{margin-top:22px;padding-top:12px;border-top:1px solid #dbe4ed;font:13px/1.5 system-ui,sans-serif;white-space:pre-wrap;overflow-wrap:anywhere}\n.annex-preview-status{display:block;color:#72879b;font-size:12px;margin-top:8px}\n</style>\n<script defer src=\"./auth-feedback.js\"></script>\n<script defer src=\"./vendor/supabase-2.57.4.js\"></script>\n<script defer src=\"./enseignant.js\"></script><link rel=\"stylesheet\" href=\"./theme-rouge.css\"><link rel=\"stylesheet\" href=\"/ege-interface.css\">\n<script defer src=\"/ege-header-avenir-brand-r1.js\"></script>\n<link rel=\"stylesheet\" href=\"./mon-bac-language-secondary-20261118.css\"><script defer src=\"./mon-bac-language-audit-20261118-r2.js\"></script><link rel=\"stylesheet\" href=\"/monavenir-brand-r1.css\"></head>\n<body><header><div class=\"head\"><a class=\"brand\" href=\"./assistant-dossier-gfm-2027.html\"><span class=\"logo\">EGE</span><span>EGE GFM 2027<small>Encadrement pédagogique</small></span></a><button type=\"button\" class=\"btn sm\" id=\"signOut\" hidden>Déconnexion</button></div></header>\n<div id=\"flash\" role=\"status\" aria-live=\"polite\"></div><main><div class=\"eyebrow\">ESPACE ENSEIGNANT</div><h1 class=\"title\">Encadrer mes élèves</h1><p class=\"lead\">Un compte, plusieurs groupes, les dossiers de vos élèves et vos observations.</p>\n<section id=\"authSection\" class=\"card\" hidden><h2>Connexion ou inscription</h2><p class=\"muted\">Utilisez une adresse e-mail personnelle. L'accès enseignant doit ensuite être validé par l'administrateur.</p>\n<label for=\"email\">Adresse e-mail</label><input type=\"email\" id=\"email\" autocomplete=\"username\" required placeholder=\"enseignant@exemple.com\">\n<label for=\"password\">Mot de passe</label><input type=\"password\" id=\"password\" autocomplete=\"current-password\" minlength=\"12\" required placeholder=\"12 caractères minimum\">\n<div class=\"row\" style=\"margin-top:15px\"><button id=\"login\" class=\"btn primary\" type=\"button\">Se connecter</button><button id=\"signup\" class=\"btn\" type=\"button\">Créer mon compte</button><button id=\"recover\" class=\"btn sm\" type=\"button\">Mot de passe oublié ?</button></div>\n<p class=\"muted\" style=\"font-size:12px\">Après l'inscription, confirmez votre e-mail. Puis revenez sur cette page pour demander l'accès enseignant.</p></section>\n<section id=\"requestSection\" class=\"card\" hidden><h2>Demander l'accès enseignant</h2><p class=\"muted\">Votre compte est connecté. Renseignez votre identité professionnelle. L'administrateur examinera la demande.</p>\n<form id=\"requestForm\"><label for=\"fullName\">Nom et prénom</label><input id=\"fullName\" required minlength=\"3\" maxlength=\"120\" autocomplete=\"name\">\n<label for=\"school\">Établissement</label><input id=\"school\" required minlength=\"2\" maxlength=\"160\" placeholder=\"Ex. Lycée d'État de Djibouti\">\n<button class=\"btn primary\" type=\"submit\" style=\"margin-top:15px\">Envoyer ma demande</button></form></section>\n<section id=\"pendingSection\" class=\"card\" hidden><h2 id=\"pendingTitle\">Demande en attente</h2><p id=\"pendingText\" class=\"muted\"></p><button class=\"btn\" id=\"checkStatus\" type=\"button\">Vérifier mon statut</button></section>\n<section id=\"teacherSection\" hidden><div class=\"card\"><div class=\"groupHead\"><div><span class=\"tag\" id=\"teacherIdentity\">Enseignant approuvé</span><h2>Mes groupes</h2><p class=\"muted\">Créez une classe, communiquez le code aux élèves et consultez leurs dossiers après leur inscription.</p></div><button class=\"btn\" id=\"reload\" type=\"button\">Actualiser</button></div>\n<form id=\"groupForm\"><div class=\"grid\"><div><label for=\"groupName\">Nom du groupe / classe</label><input id=\"groupName\" maxlength=\"90\" required placeholder=\"Ex. TGFM6\"></div><div><label for=\"groupSchool\">Établissement</label><input id=\"groupSchool\" maxlength=\"160\" placeholder=\"Ex. LED\"></div></div><button type=\"submit\" class=\"btn primary\" style=\"margin-top:14px\">+ Créer un groupe</button></form></div>\n<div id=\"groups\" class=\"grid\" aria-live=\"polite\"></div></section>\n</main>\n<dialog id=\"dossierDialog\" aria-labelledby=\"dossierTitle\"><div class=\"groupHead\"><h2 id=\"dossierTitle\">Dossier EGE</h2><button class=\"btn sm\" id=\"closeDialog\" type=\"button\">Fermer</button></div><div id=\"documentBody\"></div><h3>Historique des corrections</h3><div id=\"reviewsHistory\" class=\"history\"></div>\n<form id=\"reviewForm\"><label for=\"reviewAnnex\">Travail concerné</label><select id=\"reviewAnnex\"><option value=\"\">Dossier complet</option><option value=\"1\">Annexe 1</option><option value=\"2\">Annexe 2</option><option value=\"3\">Annexe 3</option><option value=\"4\">Annexe 4 (binôme)</option></select>\n<label for=\"reviewText\">Votre observation (obligatoire pour demander une correction)</label><textarea id=\"reviewText\" rows=\"3\" maxlength=\"5000\"></textarea>\n<div class=\"row\" style=\"margin-top:12px\"><button type=\"button\" class=\"btn primary\" id=\"approve\">Valider le dossier</button><button type=\"button\" class=\"btn\" id=\"revise\">Demander une correction</button></div></form>\n</dialog><nav class=\"ege-teacher-bottom\" aria-label=\"Navigation enseignant\"><a href=\"./?choisir=1\">Accueil</a><a href=\"#groupForm\">Mes groupes</a><a href=\"#groups\">Corrections</a><a href=\"./?choisir=1\">Profil</a></nav></body></html>\n"],"/enseignant.js":["application/javascript; charset=utf-8",false,"/* EGE GFM 2027 — espace enseignant, accès soumis à approbation Supabase/RLS. */\n(()=>{'use strict';\nconst URL_DB='https://nwcatsmfbkcgvgbanwyl.supabase.co';\nconst PUBLIC_KEY='sb_publishable_vXuRHP_lqGqtV9d1C_oZWw_SetdoY7L';\nconst REDIRECT='https://ege-gfm-2027.janakaleh.workers.dev/enseignant.html';\nconst RECOVERY_REDIRECT='https://ege-gfm-2027.janakaleh.workers.dev/';\nconst $=s=>document.getElementById(s);\nconst node=(tag,cls,text)=>{const v=document.createElement(tag);if(cls)v.className=cls;if(text!==undefined)v.textContent=String(text);return v};\nconst val=s=>String($(s)?.value||'').trim();\nconst date=s=>s?new Date(s).toLocaleDateString('fr-FR'):'—';\nlet api=null,user=null,request=null,groups=[],members=[],submissions=[],dossiers=[],selected=null,epoch=0,authBusy=false;\nfunction note(m,bad=false){$('flash').textContent=m;$('flash').classList.toggle('error',bad)}\nfunction show(id,yes){$(id).hidden=!yes}\nfunction buttonsBusy(b){for(const id of ['login','signup','recover'])$(id).disabled=b}\nfunction reset(){show('authSection',!user);show('signOut',!!user);show('requestSection',false);show('pendingSection',false);show('teacherSection',false)}\nasync function refresh(){\n const ticket=++epoch;\n try{\n  const {data,error}=await api.auth.getUser();\n  if(error)throw error;\n  if(ticket!==epoch)return;\n  user=data.user||null;window.EGEHeader?.setUser(user,api);request=null;reset();\n  if(!user){note('Connectez-vous pour accéder à votre espace.');return}\n  const resp=await api.from('ege2027_teacher_requests').select('user_id,full_name,school,status,rejection_reason').eq('user_id',user.id).maybeSingle();\n  if(ticket!==epoch)return;\n  if(resp.error)throw resp.error;\n  request=resp.data||null;\n  if(!request){show('requestSection',true);note('Compte connecté. Demandez l’accès enseignant.');return}\n  if(request.status!=='approved'){\n   show('pendingSection',true);\n   const titles={pending:'Demande en attente de validation',rejected:'Demande refusée',suspended:'Accès enseignant suspendu'};\n   $('pendingTitle').textContent=titles[request.status]||'Statut du compte';\n   $('pendingText').textContent=request.status==='pending'?'L’administrateur doit approuver votre demande avant la création de groupes.':(request.rejection_reason||'Contactez l’administrateur EGE pour obtenir des précisions.');\n   note('Statut : '+(titles[request.status]||request.status));return;\n  }\n  show('teacherSection',true);$('teacherIdentity').textContent=request.full_name+' · '+request.school;\n  $('groupSchool').value=request.school;\n  await loadGroups();\n  if(ticket!==epoch)return;\n  note('Accès enseignant validé. Vos groupes sont privés.');\n }catch(e){note('Service indisponible : '+(e.message||e),true)}\n}\nasync function auth(signUp){\n if(authBusy||!api)return;\n const email=val('email').toLowerCase(),password=$('password').value;\n if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)||password.length<(signUp?12:6)){note('Adresse e-mail valide et mot de passe '+(signUp?'de 12 caractères minimum.':'obligatoire.'),true);return}\n authBusy=true;buttonsBusy(true);note(signUp?'Création du compte…':'Connexion…');\n try{\n  const {data,error}=signUp?await api.auth.signUp({email,password,options:{emailRedirectTo:REDIRECT}}):await api.auth.signInWithPassword({email,password});\n  if(error)throw error;\n  $('password').value='';\n  if(signUp&&!data.session){note('Compte créé. Confirmez votre adresse e-mail depuis le message reçu, puis revenez sur cet espace enseignant.');return}\n  await refresh();\n }catch(e){note('Connexion/inscription impossible : '+(e.message||e),true)}\n finally{authBusy=false;buttonsBusy(false)}\n}\nasync function recover(){\n const email=val('email').toLowerCase();\n if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)){note('Renseignez d’abord votre adresse e-mail.',true);return}\n buttonsBusy(true);\n try{\n  const {error}=await api.auth.resetPasswordForEmail(email,{redirectTo:RECOVERY_REDIRECT});\n  if(error)throw error;\n  note('Si ce compte existe, un lien de réinitialisation a été demandé par e-mail.');\n }catch(e){note('Demande impossible : '+e.message,true)}\n finally{buttonsBusy(false)}\n}\nasync function sendRequest(e){\n e.preventDefault();if(!user)return;\n const full_name=val('fullName'),school=val('school');\n if(full_name.length<3||school.length<2){note('Complétez votre nom et votre établissement.',true);return}\n const btn=$('requestForm').querySelector('[type=submit]');btn.disabled=true;\n try{\n  const {error}=await api.from('ege2027_teacher_requests').insert({user_id:user.id,full_name,school});\n  if(error)throw error;\n  note('Demande envoyée. En attente de validation de l’administrateur.');await refresh();\n }catch(err){note('Demande non enregistrée : '+err.message,true)}\n finally{btn.disabled=false}\n}\nasync function loadGroups(){\n if(!user||request?.status!=='approved')return;\n const result=await api.from('ege2027_teacher_groups').select('id,name,school,join_code,active,created_at').eq('teacher_id',user.id).order('created_at',{ascending:false}).limit(100);\n if(result.error)throw result.error;\n groups=result.data||[];members=[];submissions=[];dossiers=[];\n if(groups.length){\n  const ids=groups.map(g=>g.id);\n  const [m,shares]=await Promise.all([\n   api.from('ege2027_group_members').select('group_id,student_id,student_name,joined_at').in('group_id',ids).order('joined_at',{ascending:true}).limit(2000),\n   api.from('ege2027_group_submissions').select('id,group_id,student_id,dossier_id,submitted_at').in('group_id',ids).order('submitted_at',{ascending:false}).limit(2000)\n  ]);\n  if(m.error)throw m.error;\n  if(shares.error)throw shares.error;\n  members=m.data||[];submissions=shares.data||[];\n  const dossierIds=[...new Set(submissions.map(x=>x.dossier_id))];\n  if(dossierIds.length){\n   const d=await api.from('ege2027_dossiers').select('id,owner_id,title,student,payload,updated_at').in('id',dossierIds).is('archived_at',null).order('updated_at',{ascending:false}).limit(400);\n   if(d.error)throw d.error;\n   dossiers=d.data||[];\n  }\n }\n renderGroups();\n}\nfunction renderGroups(){\n const host=$('groups');host.replaceChildren();\n if(!groups.length){const box=node('div','card');box.append(node('h2','','Aucun groupe pour le moment'),node('p','muted','Créez votre première classe ci-dessus.'));host.append(box);return}\n for(const group of groups){\n  const box=node('article','card');\n  const head=node('div','groupHead'),info=node('div'),actions=node('div','row');\n  info.append(node('span','tag',group.active?'Actif':'Invitation suspendue'),node('h2','',group.name),node('p','muted',group.school||request?.school||''));\n  const toggle=node('button','btn sm',group.active?'Désactiver le code':'Activer le code');toggle.type='button';\n  toggle.addEventListener('click',()=>toggleGroup(group));actions.append(toggle);\n  head.append(info,actions);box.append(head);\n  const codebar=node('div','codebar');codebar.append(node('span','','Code élève :'),node('strong','',group.join_code));\n  const copy=node('button','btn sm','Copier');copy.type='button';copy.addEventListener('click',async()=>{\n   try{await navigator.clipboard.writeText(group.join_code);note('Code '+group.join_code+' copié.')}\n   catch{note('Communiquez ce code à vos élèves : '+group.join_code)}\n  });codebar.append(copy);box.append(codebar);\n  const pupils=members.filter(m=>m.group_id===group.id);\n  box.append(node('h3','',pupils.length+' élève(s) inscrit(s)'));\n  if(!pupils.length)box.append(node('p','muted','Communiquez ce code à vos élèves. Ils utilisent « Mes groupes » pour rejoindre votre classe et partager les dossiers de leur choix.'));\n  for(const pupil of pupils){\n   const line=node('div','pupil'),left=node('div'),right=node('div','row');\n   left.append(node('b','',pupil.student_name),node('small','', 'Inscrit le '+date(pupil.joined_at)));\n   const docs=dossiers.filter(d=>d.owner_id===pupil.student_id && submissions.some(x=>x.dossier_id===d.id && x.group_id===group.id && x.student_id===pupil.student_id));\n   left.append(node('small','',docs.length+' dossier(s) partagé(s) avec ce groupe'));\n   for(const doc of docs){\n    const b=node('button','btn sm',doc.title||'Ouvrir le dossier');\n    b.type='button';b.addEventListener('click',()=>viewDossier(doc));right.append(b);\n   }\n   const remove=node('button','btn sm danger','Retirer');remove.type='button';remove.addEventListener('click',()=>removePupil(group,pupil));right.append(remove);\n   line.append(left,right);box.append(line);\n  }\n  host.append(box);\n }\n}\nasync function createGroup(e){\n e.preventDefault();if(!user||request?.status!=='approved')return;\n const name=val('groupName'),school=val('groupSchool');\n if(name.length<2){note('Indiquez un nom de groupe.',true);return}\n const btn=$('groupForm').querySelector('[type=submit]');btn.disabled=true;\n try{\n  const {error}=await api.from('ege2027_teacher_groups').insert({teacher_id:user.id,name,school});\n  if(error)throw error;\n  $('groupName').value='';await loadGroups();note('Groupe créé. Vous pouvez communiquer son code aux élèves.');\n }catch(err){note('Création impossible : '+err.message,true)}\n finally{btn.disabled=false}\n}\nasync function toggleGroup(group){\n if(!await window.MBDialog.confirm(group.active?'Désactiver les nouvelles inscriptions dans « '+group.name+' » ?':'Réactiver les inscriptions dans « '+group.name+' » ?'))return;\n const {error}=await api.from('ege2027_teacher_groups').update({active:!group.active}).eq('id',group.id).eq('teacher_id',user.id);\n if(error){note('Modification refusée : '+error.message,true);return}\n await loadGroups();note('Groupe actualisé.');\n}\nasync function removePupil(group,pupil){\n if(!await window.MBDialog.confirm('Retirer '+pupil.student_name+' du groupe '+group.name+' ? Ses dossiers personnels ne seront pas supprimés.'))return;\n const {error}=await api.from('ege2027_group_members').delete().eq('group_id',group.id).eq('student_id',pupil.student_id);\n if(error){note('Retrait impossible : '+error.message,true);return}\n await loadGroups();note('Élève retiré du groupe. Ses dossiers sont conservés.');\n}\nasync function viewDossier(doc){\n selected=doc;\n const d=doc.payload||{},annexes=d.annexes||{},titles=d.annexTitles||{},sources=d.sources||{},sourceChecks=d.sourceChecks||{};\n $('dossierTitle').textContent=(doc.student||d.student||'Élève')+' · Dossier EGE';\n const wrap=$('documentBody');wrap.replaceChildren();\n const header=node('section','dossier-info');\n for(const [label,value] of [\n  ['Dossier',doc.title||'—'],['Élève',doc.student||d.student||'—'],\n  ['Binôme',d.partner||'—'],['Classe',d.className||'—'],\n  ['Établissement',d.school||'—'],['Problématique',d.problem||'—']\n ]){\n  const p=node('p','dossier-info-row');\n  p.append(node('strong','',label+' : '),node('span','',String(value)));\n  header.append(p);\n }\n wrap.append(header);\n let count=0;\n const defaults=[\n  'Les notions générales','Comprendre le sous-thème',\n  'Éléments de réponse à la problématique','Conditions et limites du sujet'\n ];\n for(const [key,value] of Object.entries(annexes).sort(([a],[b])=>Number(a)-Number(b))){\n  const n=Number(key);\n  if(!Number.isInteger(n)||n<1||n>4||!String(value||'').trim())continue;\n  count++;\n  const block=node('article','annex-preview-card');\n  block.append(node('div','annex-preview-kicker','ANNEXE '+n));\n  block.append(node('h3','annex-preview-title',String(titles[n]||defaults[n-1]).trim()));\n  block.append(node('div','annex-preview-content',String(value).slice(0,40000)));\n  const src=node('div','annex-preview-source');\n  src.append(node('strong','','Source : '),node('span','',String(sources[n]||'Non renseignée')));\n  block.append(src);\n  block.append(node('small','annex-preview-status',sourceChecks[n]?'Source déclarée vérifiée par l’élève.':'Référence documentaire à vérifier.'));\n  wrap.append(block);\n }\n if(!count)wrap.append(node('p','muted','Aucune annexe rédigée dans ce dossier.'));\n $('reviewText').value='';\n $('dossierDialog').showModal();\n await loadReviews();\n}\nasync function loadReviews(){\n if(!selected)return;\n const {data,error}=await api.from('ege2027_reviews').select('decision,observation,annex_number,created_at').eq('dossier_id',selected.id).order('created_at',{ascending:false}).limit(30);\n const host=$('reviewsHistory');host.replaceChildren();\n if(error){host.append(node('p','',error.message));return}\n if(!data?.length){host.append(node('p','','Pas encore de correction.'));return}\n for(const r of data)host.append(node('p','',(r.decision==='valide'?'Validé':'À corriger')+(r.annex_number?' · Annexe '+r.annex_number:' · Dossier')+' · '+date(r.created_at)+' : '+(r.observation||'Sans commentaire')));\n}\nasync function sendReview(decision){\n if(!selected||!user||request?.status!=='approved')return;\n const observation=val('reviewText');\n if(decision==='a_corriger'&&!observation){note('Une observation est nécessaire pour demander une correction.',true);return}\n if(decision==='valide'&&!await window.MBDialog.confirm('Valider le dossier de cet élève ?'))return;\n for(const n of ['approve','revise'])$(n).disabled=true;\n try{\n  const {error}=await api.from('ege2027_reviews').insert({dossier_id:selected.id,staff_id:user.id,decision,observation,annex_number:val('reviewAnnex')?Number(val('reviewAnnex')):null});\n  if(error)throw error;\n  $('reviewText').value='';$('reviewAnnex').value='';await loadReviews();note(decision==='valide'?'Dossier validé.':'Correction demandée. L’élève verra votre observation.');\n }catch(e){note('Avis non enregistré : '+e.message,true)}\n finally{for(const n of ['approve','revise'])$(n).disabled=false}\n}\nasync function boot(){\n if(!window.supabase?.createClient){note('Connexion Supabase indisponible. Vérifiez Internet.',true);return}\n api=window.supabase.createClient(URL_DB,PUBLIC_KEY);\n $('login').addEventListener('click',()=>auth(false));\n $('signup').addEventListener('click',()=>auth(true));\n $('recover').addEventListener('click',recover);\n $('requestForm').addEventListener('submit',sendRequest);\n $('groupForm').addEventListener('submit',createGroup);\n $('checkStatus').addEventListener('click',refresh);\n $('reload').addEventListener('click',async()=>{try{await loadGroups();note('Groupes actualisés.')}catch(e){note(e.message,true)}});\n $('signOut').addEventListener('click',async()=>{await api.auth.signOut();user=null;request=null;reset();note('Déconnecté.');});\n $('closeDialog').addEventListener('click',()=>$('dossierDialog').close());\n $('approve').addEventListener('click',()=>sendReview('valide'));\n $('revise').addEventListener('click',()=>sendReview('a_corriger'));\n api.auth.onAuthStateChange(event=>{if(event==='SIGNED_IN'||event==='SIGNED_OUT')setTimeout(refresh,0)});\n await refresh();\n}\ndocument.addEventListener('DOMContentLoaded',boot);\n})();"],"/mes-groupes.html":["text/html; charset=utf-8",false,"<!doctype html>\n<html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#c91b2c\"><meta name=\"robots\" content=\"noindex,nofollow\">\n<title>Mes groupes EGE | EGE GFM 2027</title><link rel=\"icon\" type=\"image/png\" href=\"/monavenir-icon-192.png\">\n<style>\n:root{font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;color:#18344f;background:#f4f7fb;font-synthesis:none}\n*{box-sizing:border-box}body{margin:0;padding-bottom:env(safe-area-inset-bottom)}[hidden]{display:none!important}\nbutton,input,select{font:inherit}button{cursor:pointer}button:disabled{cursor:wait;opacity:.55}a{color:#1e5cbd}\nbutton:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #9ecbff;outline-offset:3px}\nheader{background:#fff;border-bottom:1px solid #dfe8f3}.head{max-width:1040px;margin:auto;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px}\n.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:#173b62;font-weight:800}.brand span{display:grid;place-items:center;width:44px;height:44px;border-radius:13px;background:#1761c1;color:#fff}.head nav{display:flex;align-items:center;flex-wrap:wrap;gap:13px;font-size:13px}\nmain{max-width:1040px;margin:26px auto;padding:0 16px 48px}.eyebrow{color:#1f62b7;font-size:11px;font-weight:800;letter-spacing:1.2px}\nh1{font-size:clamp(26px,4vw,36px);letter-spacing:-.8px;margin:5px 0 8px}h2{font-size:19px;margin:0 0 9px}.lead,.muted{color:#607891}.lead{margin:0 0 23px}\n.card{border:1px solid #dfe7f2;border-radius:18px;background:#fff;padding:23px;margin:15px 0;box-shadow:0 5px 20px #12345b07}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}\n.grid .card{margin:0}label{font-size:13px;font-weight:750;display:block;margin:13px 0 5px}\ninput,select{width:100%;min-height:45px;border:1px solid #c7d8e9;background:#fff;border-radius:10px;padding:10px 12px;color:#18344f}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:44px;border:1px solid #c8daee;background:#f1f6fc;color:#1f588c;font-weight:750;border-radius:10px;padding:10px 16px}\n.btn.primary{background:#205fc0;color:#fff;border-color:#205fc0}.btn.danger{background:#fff6f5;color:#a23e3e;border-color:#efc4bd}\n.btn.small{min-height:36px;font-size:12px;padding:7px 11px}.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:12px}\n.entry{border-top:1px solid #e5edf6;padding:13px 0}.entry:last-child{padding-bottom:0}\n.entry strong{display:block}.entry small{color:#70869e}.entry .row{margin-top:7px}\n.tag{display:inline-block;padding:5px 9px;border-radius:9px;background:#ebf4ff;color:#1d59a7;font-size:12px;font-weight:750}\n#flash{max-width:1040px;margin:auto;min-height:22px;padding:9px 17px;color:#185b94;white-space:pre-wrap}\n#flash.error{color:#a13b35}\n#groupList .card{margin:0}.mini{font-size:13px;color:#627a90;margin:7px 0}\n@media(max-width:640px){main{margin-top:18px}.card{padding:17px;border-radius:14px}.head nav{gap:8px}}\n</style>\n<script defer src=\"./vendor/supabase-2.57.4.js\"></script>\n<script defer src=\"./mes-groupes.js\"></script><link rel=\"stylesheet\" href=\"./theme-rouge.css\"><link rel=\"stylesheet\" href=\"/ege-interface.css\">\n<script defer src=\"/ege-header-avenir-brand-r1.js\"></script>\n<link rel=\"stylesheet\" href=\"./mon-bac-language-secondary-20261118.css\"><script defer src=\"./mon-bac-language-audit-20261118-r2.js\"></script><link rel=\"stylesheet\" href=\"/monavenir-brand-r1.css\"></head><body>\n<header><div class=\"head\"><a class=\"brand\" href=\"./assistant-dossier-gfm-2027.html\"><span>EGE</span><div>EGE GFM 2027<div class=\"muted\" style=\"font-size:12px;font-weight:500\">Mes groupes d'encadrement</div></div></a>\n<nav><a href=\"./assistant-dossier-gfm-2027.html\">Mon dossier</a><a href=\"./enseignant.html\">Espace enseignant</a><button id=\"signOut\" class=\"btn small\" hidden>Déconnexion</button></nav></div></header>\n<div id=\"flash\" role=\"status\" aria-live=\"polite\"></div>\n<main><div class=\"eyebrow\">ESPACE ÉLÈVE</div><h1>Mes groupes et mes dossiers</h1><p class=\"lead\">Rejoins la classe de ton enseignant avec son code. Choisis ensuite les dossiers que tu veux lui transmettre.</p>\n<section class=\"card\" id=\"authArea\" hidden><h2>Connexion EGE</h2><p class=\"muted\">Utilise le compte de tes dossiers EGE. Tu peux aussi <a href=\"./assistant-dossier-gfm-2027.html\">créer un compte depuis l'application</a>.</p>\n<label for=\"email\">Adresse e-mail</label><input id=\"email\" type=\"email\" autocomplete=\"username\" placeholder=\"votre@email.com\">\n<label for=\"password\">Mot de passe</label><input id=\"password\" type=\"password\" autocomplete=\"current-password\">\n<div class=\"row\"><button id=\"login\" type=\"button\" class=\"btn primary\">Se connecter</button><button id=\"recover\" type=\"button\" class=\"btn\">Mot de passe oublié ?</button></div></section>\n<div id=\"privateArea\" hidden>\n<div class=\"grid\">\n<section class=\"card\"><h2>Rejoindre un groupe</h2><p class=\"mini\">Demande le code de 12 caractères à ton enseignant.</p>\n<form id=\"joinForm\"><label for=\"studentName\">Ton nom et prénom</label><input id=\"studentName\" required maxlength=\"140\" minlength=\"2\" autocomplete=\"name\" placeholder=\"Ex. Ahmed Ali\">\n<label for=\"groupCode\">Code donné par l'enseignant</label><input id=\"groupCode\" required maxlength=\"12\" minlength=\"12\" pattern=\"[0-9a-fA-F]{12}\" autocapitalize=\"characters\" autocomplete=\"off\" placeholder=\"12 caractères\">\n<button type=\"submit\" class=\"btn primary\" style=\"margin-top:16px\">Rejoindre la classe</button></form></section>\n<section class=\"card\"><h2>Partager un dossier</h2><p class=\"mini\">Ton professeur ne voit que les dossiers que tu sélectionnes.</p>\n<form id=\"shareForm\"><label for=\"groupSelect\">Groupe</label><select id=\"groupSelect\" required></select>\n<label for=\"dossierSelect\">Mon dossier EGE</label><select id=\"dossierSelect\" required></select>\n<button type=\"submit\" class=\"btn primary\" style=\"margin-top:16px\">Partager avec mon enseignant</button></form>\n<p class=\"mini\" id=\"noDossier\" hidden>Tu n'as aucun dossier en ligne. <a href=\"./assistant-dossier-gfm-2027.html\">Crée et sauvegarde d'abord un dossier.</a></p></section>\n</div>\n<section style=\"margin-top:26px\"><div class=\"row\" style=\"justify-content:space-between\"><h2>Mes classes</h2><button id=\"reload\" class=\"btn small\">Actualiser</button></div><div id=\"groupList\" class=\"grid\" aria-live=\"polite\"></div></section>\n</div></main></body></html>\n"],"/mes-groupes.js":["application/javascript; charset=utf-8",false,"/* EGE GFM 2027 · espace élève et partage volontaire. */\n(()=>{'use strict';\nconst DB='https://nwcatsmfbkcgvgbanwyl.supabase.co';\nconst KEY='sb_publishable_vXuRHP_lqGqtV9d1C_oZWw_SetdoY7L';\nconst $=id=>document.getElementById(id);\nconst val=id=>String($(id)?.value||'').trim();\nconst make=(tag,cls,txt)=>{const e=document.createElement(tag);if(cls)e.className=cls;if(txt!==undefined)e.textContent=String(txt);return e};\nlet api=null,user=null,memberRows=[],groupRows=[],dossiers=[],shares=[],reviews=[],busy=false,seq=0;\nfunction note(t,err=false){$('flash').textContent=t;$('flash').classList.toggle('error',err)}\nfunction show(id,yes){$(id).hidden=!yes}\nfunction date(s){return s?new Date(s).toLocaleDateString('fr-FR'):'—'}\nfunction button(text,fn,cls='btn small'){const b=make('button',cls,text);b.type='button';b.addEventListener('click',fn);return b}\nfunction render(){\n const groups=new Map(groupRows.map(g=>[g.id,g]));\n const selectGroup=$('groupSelect'),selectDossier=$('dossierSelect');\n selectGroup.replaceChildren();selectDossier.replaceChildren();\n if(!memberRows.length)selectGroup.add(new Option('Rejoins d’abord une classe',''));\n for(const m of memberRows)selectGroup.add(new Option(groups.get(m.group_id)?.name||'Mon groupe',m.group_id));\n if(!dossiers.length)selectDossier.add(new Option('Sauvegarde d’abord un dossier en ligne',''));\n for(const d of dossiers)selectDossier.add(new Option((d.title||'Mon dossier')+' · '+(d.student||'Élève'),d.id));\n $('shareForm').querySelector('[type=submit]').disabled=!memberRows.length||!dossiers.length;\n show('noDossier',!dossiers.length);\n if(memberRows.length&&!val('studentName'))$('studentName').value=memberRows[0].student_name||'';\n const host=$('groupList');host.replaceChildren();\n if(!memberRows.length){const box=make('div','card');box.append(make('h2','','Aucune classe pour le moment'),make('p','muted','Entre le code transmis par ton enseignant pour rejoindre sa classe.'));host.append(box);return}\n for(const m of memberRows){\n  const g=groups.get(m.group_id);\n  const box=make('article','card');\n  box.append(make('span','tag','Inscrit'),make('h2','',g?.name||'Groupe EGE'),make('p','muted',(g?.school||'')+' · Depuis le '+date(m.joined_at)));\n  const shared=shares.filter(s=>s.group_id===m.group_id);\n  box.append(make('h3','',shared.length+' dossier(s) partagé(s)'));\n  if(!shared.length)box.append(make('p','mini','Aucun dossier partagé : ton professeur ne voit pas encore tes travaux.'));\n  for(const s of shared){\n   const d=dossiers.find(d=>d.id===s.dossier_id);\n   const line=make('div','entry'),name=make('strong','',d?.title||'Dossier EGE'),feedback=reviews.find(r=>r.dossier_id===s.dossier_id);\n   line.append(name,make('small','','Partagé le '+date(s.submitted_at)));\n   if(feedback){\n    const status=feedback.decision==='valide'?'Dossier validé':'Correction demandée';\n    line.append(make('p','mini',status+(feedback.annex_number?' · Annexe '+feedback.annex_number:'')+' : '+(feedback.observation||'Sans observation')));\n   }\n   const actions=make('div','row');actions.append(button('Ne plus partager',()=>unshare(s),'btn danger small'));line.append(actions);box.append(line);\n  }\n  const actions=make('div','row');actions.append(button('Quitter ce groupe',()=>leave(m),'btn danger small'));box.append(actions);\n  host.append(box);\n }\n}\nasync function refresh(){\n const ticket=++seq;\n if(!api)return;\n try{\n  const {data,error}=await api.auth.getUser();\n  if(error)throw error;\n  if(ticket!==seq)return;\n  user=data.user||null;window.EGEHeader?.setUser(user,api);show('authArea',!user);show('privateArea',!!user);show('signOut',!!user);\n  if(!user){memberRows=[];groupRows=[];dossiers=[];shares=[];reviews=[];note('Connecte-toi avec ton compte EGE pour retrouver tes groupes.');return}\n  const [a,b,c]=await Promise.all([\n   api.from('ege2027_group_members').select('group_id,student_id,student_name,joined_at').eq('student_id',user.id).order('joined_at',{ascending:false}).limit(100),\n   api.from('ege2027_dossiers').select('id,owner_id,title,student,updated_at').eq('owner_id',user.id).is('archived_at',null).order('updated_at',{ascending:false}).limit(200),\n   api.from('ege2027_group_submissions').select('id,group_id,dossier_id,submitted_at').eq('student_id',user.id).order('submitted_at',{ascending:false}).limit(200)\n  ]);\n  if(a.error||b.error||c.error)throw(a.error||b.error||c.error);\n  if(ticket!==seq)return;\n  memberRows=a.data||[];dossiers=b.data||[];shares=c.data||[];\n  groupRows=[];reviews=[];\n  const ids=[...new Set(memberRows.map(m=>m.group_id))];\n  if(ids.length){\n   const q=await api.from('ege2027_teacher_groups').select('id,name,school,active').in('id',ids).limit(100);\n   if(q.error)throw q.error;\n   groupRows=q.data||[];\n  }\n  const dossierIds=[...new Set(shares.map(s=>s.dossier_id))];\n  if(dossierIds.length){\n   const q=await api.from('ege2027_reviews').select('dossier_id,decision,observation,annex_number,created_at').in('dossier_id',dossierIds).order('created_at',{ascending:false}).limit(300);\n   if(q.error)throw q.error;\n   reviews=q.data||[];\n  }\n  if(ticket!==seq)return;\n  render();note('Mes groupes et dossiers sont actualisés.');\n }catch(e){note('Chargement impossible : '+(e.message||e),true)}\n}\nasync function signIn(){\n const email=val('email').toLowerCase(),password=$('password').value;\n if(!email||!password){note('Renseigne ton adresse et ton mot de passe.',true);return}\n $('login').disabled=true;\n try{\n  const {error}=await api.auth.signInWithPassword({email,password});\n  if(error)throw error;\n  $('password').value='';await refresh();\n }catch(e){note('Connexion impossible : '+e.message,true)}finally{$('login').disabled=false}\n}\nasync function recover(){\n const email=val('email').toLowerCase();\n if(!email.includes('@')){note('Entre ton adresse e-mail.',true);return}\n $('recover').disabled=true;\n try{\n  const {error}=await api.auth.resetPasswordForEmail(email,{redirectTo:new URL('./assistant-dossier-gfm-2027.html',location.href).href});\n  if(error)throw error;\n  note('Si le compte existe, un message de réinitialisation sera envoyé.');\n }catch(e){note(e.message,true)}finally{$('recover').disabled=false}\n}\nasync function join(e){\n e.preventDefault();if(!user||busy)return;\n const p_code=val('groupCode').toUpperCase(),p_student_name=val('studentName');\n if(!/^[0-9A-F]{12}$/.test(p_code)||p_student_name.length<2){note('Indique ton nom et un code de 12 caractères.',true);return}\n busy=true;const b=$('joinForm').querySelector('[type=submit]');b.disabled=true;\n try{\n  const {data:joined,error}=await api.rpc('ege2027_join_group',{p_code,p_student_name});\n  if(error)throw error;\n  $('groupCode').value='';await refresh();\n  if(joined && memberRows.some(m=>m.group_id===joined))$('groupSelect').value=joined;\n  const suggested=dossiers.length===1?dossiers[0]:null;\n  if(suggested&&joined&&await window.MBDialog.confirm('Associer le dossier « '+(suggested.title||'Mon dossier')+' » à cette classe ? Votre professeur pourra consulter toutes ses prochaines sauvegardes. Vos autres dossiers restent privés.')){\n   const link=await api.from('ege2027_group_submissions').insert({group_id:joined,dossier_id:suggested.id,student_id:user.id});\n   if(link.error&&link.error.code!=='23505'){note('Groupe rejoint, mais association impossible : '+link.error.message,true);return}\n   await refresh();note('Groupe rejoint et dossier associé. Le professeur voit désormais le travail et ses prochaines modifications.');await window.MBDialog.notice('Dossier associé','Votre professeur peut désormais consulter votre dossier et ses prochaines modifications.','success');return;\n  }\n  note(dossiers.length?'Groupe rejoint. Choisis le dossier à associer dans le formulaire ci-dessus.':'Groupe rejoint. Crée puis sauvegarde un dossier dans ton espace élève avant de l’associer à ce groupe.');\n }catch(err){note('Impossible de rejoindre ce groupe : '+err.message,true)}\n finally{busy=false;b.disabled=false}\n}\nasync function share(e){\n e.preventDefault();if(!user||busy)return;\n const group_id=val('groupSelect'),dossier_id=val('dossierSelect');\n if(!memberRows.some(m=>m.group_id===group_id)||!dossiers.some(d=>d.id===dossier_id)){note('Sélectionne une classe et ton dossier.',true);return}\n if(shares.some(s=>s.group_id===group_id&&s.dossier_id===dossier_id)){note('Ce dossier est déjà partagé avec ce groupe.');return}\n busy=true;const b=$('shareForm').querySelector('[type=submit]');b.disabled=true;\n try{\n  const {error}=await api.from('ege2027_group_submissions').insert({group_id,dossier_id,student_id:user.id});\n  if(error)throw error;\n  await refresh();note('Dossier associé au groupe. Les prochaines modifications sauvegardées en ligne sont automatiquement accessibles à cet enseignant.');await window.MBDialog.notice('Dossier associé','Votre professeur peut désormais consulter votre dossier et ses prochaines modifications.','success');\n }catch(err){note('Partage impossible : '+err.message,true)}\n finally{busy=false;b.disabled=false}\n}\nasync function unshare(s){\n if(!user||busy||!await window.MBDialog.confirm('Arrêter le partage de ce dossier avec ton enseignant ?'))return;\n busy=true;\n try{\n  const {error}=await api.from('ege2027_group_submissions').delete().eq('id',s.id).eq('student_id',user.id);\n  if(error)throw error;\n  await refresh();note('Partage retiré. Ton dossier personnel est conservé.');\n }catch(e){note(e.message,true)}finally{busy=false}\n}\nasync function leave(m){\n if(!user||busy||!await window.MBDialog.confirm('Quitter cette classe ? Les partages associés seront retirés, mais tes dossiers resteront dans ton compte.'))return;\n busy=true;\n try{\n  const {error}=await api.from('ege2027_group_members').delete().eq('group_id',m.group_id).eq('student_id',user.id);\n  if(error)throw error;\n  await refresh();note('Tu as quitté la classe. Tes dossiers personnels sont conservés.');\n }catch(e){note('Départ impossible : '+e.message,true)}finally{busy=false}\n}\nasync function boot(){\n if(!window.supabase?.createClient){note('La bibliothèque Supabase ne s’est pas chargée. Vérifie ta connexion Internet.',true);return}\n api=window.supabase.createClient(DB,KEY);\n $('login').addEventListener('click',signIn);\n $('recover').addEventListener('click',recover);\n $('joinForm').addEventListener('submit',join);\n $('shareForm').addEventListener('submit',share);\n $('reload').addEventListener('click',refresh);\n $('signOut').addEventListener('click',async()=>{await api.auth.signOut();await refresh()});\n api.auth.onAuthStateChange(event=>{if(event==='SIGNED_OUT')refresh()});\n await refresh();\n}\ndocument.addEventListener('DOMContentLoaded',boot);\n})();\n"],"/admin.css":["text/css; charset=utf-8",false,":root{--navy:#123d66;--blue:#245ed7;--ink:#19334b;--muted:#6a7a8b;--line:#e1e9f2;--bg:#f5f7fa;--white:#fff;--green:#117458;--warn:#a35813}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:var(--bg);font:15px/1.55 system-ui,-apple-system,\"Segoe UI\",Arial,sans-serif;-webkit-font-smoothing:antialiased}button,input,textarea{font:inherit}button{cursor:pointer}button:disabled{opacity:.55;cursor:wait}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #9cc4ff;outline-offset:2px}a{color:var(--blue)}[hidden]{display:none!important}h1,h2,h3,p{margin-top:0}.topbar{padding:15px clamp(16px,4vw,48px);min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:15px;background:#fff;border-bottom:1px solid var(--line)}.identity{display:flex;gap:12px;align-items:center;text-decoration:none;color:var(--ink)}.identity b{display:block;font-size:17px;letter-spacing:-.03em}.identity small{display:block;color:var(--muted)}.mark{width:45px;height:45px;border-radius:13px;background:var(--navy);color:#fff;display:grid;place-items:center;font-weight:800}.toplinks{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.toplinks span{font-size:12px;color:var(--muted)}.outline,.secondary{display:inline-flex;align-items:center;justify-content:center;background:#fff;color:#27578e;border:1px solid #cbd9ea;padding:10px 15px;border-radius:11px;font-weight:700;text-decoration:none}.secondary{background:#eef4fc}.primary{background:var(--blue);color:#fff;border:1px solid var(--blue);padding:11px 18px;border-radius:11px;font-weight:750}.primary:hover{background:#1550bd}.status{max-width:1210px;margin:16px auto;padding:11px 15px;border-radius:12px;background:#eaf1fb;color:#28517b;font-size:13px}.status.ok{background:#e8f7ee;color:#166543}.status.error{background:#fff0eb;color:#a03b25}main{max-width:1210px;margin:30px auto 80px;padding:0 20px;min-height:58vh}.gate{display:grid;grid-template-columns:1.1fr .9fr;gap:35px;align-items:center;margin-top:7vh}.gateVisual{padding:20px}.gateSymbol{font-weight:900;font-size:46px;color:var(--navy);letter-spacing:-.08em;margin-bottom:22px}.gateSymbol span{font-size:21px;color:#11886c;vertical-align:top}.gateVisual h1{font-size:clamp(38px,5vw,60px);line-height:1.1;letter-spacing:-.06em}.gateVisual p{max-width:480px;color:var(--muted);font-size:17px}.loginCard,.panel{background:#fff;border:1px solid var(--line);border-radius:22px;padding:28px;box-shadow:0 12px 37px #203e570a}.loginCard h2{font-size:26px}.loginCard p{color:var(--muted)}label{display:block;font-size:13px;font-weight:700;margin:16px 0 7px}input,textarea{width:100%;border:1.5px solid #d4dfec;border-radius:12px;padding:12px 14px;color:var(--ink);background:#fff;min-height:46px}input:focus,textarea:focus{border-color:var(--blue);outline:3px solid #dce8ff}.loginCard .primary{margin-top:19px;width:100%}.tiny{font-size:12px;color:var(--muted);line-height:1.7}.eyebrow{color:#3165ae;letter-spacing:.10em;font-size:11px;font-weight:800}.intro{display:flex;align-items:end;justify-content:space-between;gap:15px;margin:12px 0 24px}.intro h1{font-size:clamp(31px,4vw,45px);letter-spacing:-.055em;margin:6px 0}.intro p{color:var(--muted);margin-bottom:0}.tabs{display:flex;align-items:center;gap:7px;overflow-x:auto;padding:5px 0 14px;margin:0 0 18px;border-bottom:1px solid var(--line)}.tabs button{padding:11px 18px;border:0;border-radius:11px;background:transparent;color:#677990;font-weight:750;white-space:nowrap}.tabs button.active{background:#e6eeff;color:#245ed7}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-bottom:21px}.stats article{background:white;border:1px solid var(--line);border-radius:18px;padding:22px}.stats small{display:block;color:var(--muted);font-size:12px;font-weight:700}.stats strong{font-size:35px;letter-spacing:-.055em;display:block;margin-top:10px;color:#123d66}.stats span{color:#7a8b9d;font-size:12px}.panel{margin-bottom:18px}.panel h2{font-size:21px;letter-spacing:-.035em}.panel h3{margin-top:24px}.muted{color:var(--muted);font-size:13px}.entries{display:grid;gap:9px;margin-top:15px}.entry{border:1px solid var(--line);background:#fff;border-radius:13px;padding:13px 14px;display:flex;justify-content:space-between;align-items:center;gap:15px;text-align:left;width:100%;color:var(--ink)}button.entry:hover{border-color:#9cb9df;background:#fbfdff}.entry b{display:block;font-size:14px}.entry small{display:block;color:var(--muted);font-size:12px}.entry .pill{font-size:11px;color:#2764b3;background:#eff5ff;padding:5px 8px;border-radius:50px}.panelHead{display:flex;justify-content:space-between;align-items:center;gap:16px}.panelHead input{max-width:300px}.meta{font-size:13px;color:var(--muted);margin:13px 0}.document{max-height:480px;overflow:auto;background:#f8fafc;border:1px solid var(--line);border-radius:12px;padding:18px;line-height:1.65}.document pre{white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.7 system-ui,sans-serif}.document h3{font-size:14px;color:#275b9b;margin:15px 0 6px}.actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:18px}.settingsForm{max-width:750px}.settingsForm label{margin-top:18px}.securityList{border:1px solid var(--line);border-radius:13px;overflow:hidden;margin:18px 0}.securityList div{padding:14px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:20px}.securityList div:last-child{border-bottom:0}.securityList span{color:var(--muted);text-align:right}.entry.review{display:block;background:#fafbfd}.entry.review b{color:var(--navy)}footer{text-align:center;padding:20px;color:#8795a7;font-size:12px;border-top:1px solid var(--line)}@media(max-width:760px){.topbar{padding:10px 15px}.toplinks{gap:6px}.toplinks span{display:none}.outline{padding:8px 11px;font-size:12px}.gate{grid-template-columns:1fr;gap:8px;margin-top:0}.gateVisual{padding:0}.gateVisual h1{font-size:34px;margin-bottom:12px}.gateVisual p{font-size:14px}.gateSymbol{margin-bottom:8px;font-size:30px}.loginCard,.panel{padding:19px;border-radius:18px}.stats{grid-template-columns:1fr 1fr;gap:10px}.stats article{padding:14px}.stats strong{font-size:27px}.stats article:last-child{grid-column:1/-1}.panelHead{align-items:stretch;flex-direction:column}.panelHead input{max-width:100%}.intro{align-items:start}.securityList div{display:block}.securityList span{display:block;text-align:left;margin-top:3px}}\n/* Bouton œil : montrer ou masquer le mot de passe sans exposer les données */\n.passwordField{position:relative}.passwordField input{padding-right:56px}.passwordToggle{position:absolute;top:50%;right:6px;transform:translateY(-50%);width:42px;height:42px;display:grid;place-items:center;border:0;background:transparent;color:#62748b;border-radius:10px}.passwordToggle:hover{color:#245ed7;background:#f1f6fd}.passwordToggle svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8}.passwordToggle[aria-pressed=\"false\"] .eyeStrike{display:none}\n\n\n.admin-bottom-nav{display:none}\n@media(max-width:760px){\n body:has(#dashboard:not([hidden])){padding-bottom:calc(86px + env(safe-area-inset-bottom))}\n .dashboard .tabs{display:none}\n .admin-bottom-nav{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:90;background:rgba(255,255,255,.98);border-top:1px solid #dce6f1;box-shadow:0 -7px 25px rgba(20,46,80,.08);gap:2px;align-items:stretch;justify-content:space-around;padding:7px max(8px,env(safe-area-inset-left)) calc(8px + env(safe-area-inset-bottom)) max(8px,env(safe-area-inset-right))}\n .admin-bottom-nav button{flex:1;min-width:0;max-width:132px;min-height:56px;padding:5px 2px;display:flex;flex-direction:column;gap:2px;align-items:center;justify-content:center;border:0;border-radius:12px;background:transparent;font:700 11px/1.2 system-ui,-apple-system,\"Segoe UI\",sans-serif;color:#5b718b}\n .admin-bottom-nav button svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linejoin:round;stroke-linecap:round}\n .admin-bottom-nav button.active{background:#e9f1ff;color:#245ed7}\n #reviewPanel .actions{position:sticky;z-index:80;bottom:calc(77px + env(safe-area-inset-bottom));padding:10px 0;background:#fff;border-top:1px solid var(--line);box-shadow:0 -8px 18px rgba(255,255,255,.86);flex-wrap:nowrap}\n #reviewPanel .actions button{flex:1;min-height:46px;padding:10px 8px;font-size:13px}\n body.admin-keyboard-open .admin-bottom-nav{display:none}\n body.admin-keyboard-open #reviewPanel .actions{position:static}\n}\n@media print{.admin-bottom-nav{display:none!important}body{padding-bottom:0}}\n\n\n/* Présentation des annexes envoyées par les élèves */\n.admin-annex-card{border:1px solid #dce5f0;border-radius:12px;padding:22px 18px;margin:16px 0;background:#fff}\n.admin-annex-label{display:block;color:#667d95;font-weight:750;letter-spacing:1.2px;text-align:center}\n.admin-annex-title{text-align:center;font:700 18px/1.45 Georgia,'Times New Roman',serif;color:#203950;margin:12px 0 17px}\n.admin-annex-content{font:15px/1.65 Georgia,'Times New Roman',serif;white-space:pre-wrap;word-break:break-word}\n.admin-annex-source{border-top:1px solid #dde7f2;padding-top:12px;margin-top:20px;font:13px/1.5 system-ui,sans-serif;white-space:pre-wrap;overflow-wrap:anywhere}\n.admin-annex-check{display:block;color:#687f95;margin-top:7px;font-size:12px}\n"],"/theme-rouge.css":["text/css; charset=utf-8",false,"/* Identité visuelle unique — EGE GFM 2027 · Prof. Jana Galeh */\n:root{--red:#c91b2c;--red-dark:#a71222;--red-pale:#fff2f3;--blue:#c91b2c;--navy:#8a1725;--bluelight:#fff1f3;--bg:#fff;--ink:#25272d;--muted:#6c6c73;--line:#ecdde0;--shadow:0 8px 25px rgba(72,22,30,.055)}\nbody:not(.ege-portal){background:#fff;color:#28292f}\nbody:not(.ege-portal) .topbar,body:not(.ege-portal) header{background:#fff;border-bottom-color:#f0e0e3}\nbody:not(.ege-portal) .topbar .brandlogo,body:not(.ege-portal) .logo,body:not(.ege-portal) .head .brand .logo,body:not(.ege-portal) .mark{background:#c91b2c!important;color:#fff!important}\nbody:not(.ege-portal) .hero-kicker,body:not(.ege-portal) .eyebrow,body:not(.ege-portal) .stepcount,body:not(.ege-portal) .minihead .minor{color:#a81d2b}\nbody:not(.ege-portal) .btn-primary,body:not(.ege-portal) .btn.primary,body:not(.ege-portal) .ege-cloud-primary,body:not(.ege-portal) button.primary{background:#c91b2c!important;border-color:#c91b2c!important;color:#fff!important}\nbody:not(.ege-portal) .btn-primary:hover,body:not(.ege-portal) .btn.primary:hover{background:#a71222!important;border-color:#a71222!important}\nbody:not(.ege-portal) .btn-outline,body:not(.ege-portal) .btn:not(.primary):not(.btn-primary),body:not(.ege-portal) .btn-quiet{border-color:#e7cbd0;color:#9e202d;background:#fff}\nbody:not(.ege-portal) a{color:#af1828}\nbody:not(.ege-portal) .textbutton,body:not(.ege-portal) .smalllink{color:#b31b2c}\nbody:not(.ege-portal) .card,body:not(.ege-portal) .questionbox,body:not(.ege-portal) .dlcard,body:not(.ege-portal) .choice,body:not(.ege-portal) .panel{border-color:#eedfe1;background:#fff;box-shadow:0 5px 18px #63132407}\nbody:not(.ege-portal) .choice.selected{border-color:#d33948;background:#fff2f3}\nbody:not(.ege-portal) .sourcecheck{background:#fff9f9;border-color:#e9cfd4}\nbody:not(.ege-portal) .notice,body:not(.ege-portal) .sujetinfo{background:#fff8f8;border-color:#f0e1e2}\nbody:not(.ege-portal) input:focus-visible,body:not(.ege-portal) textarea:focus-visible,body:not(.ege-portal) button:focus-visible,body:not(.ege-portal) select:focus-visible{outline:3px solid #f1a9b1;outline-offset:2px}\nbody:not(.ege-portal) .field:focus,body:not(.ege-portal) .area:focus{border-color:#c91b2c}\nbody:not(.ege-portal) .ege-bottom-nav{background:#fff;border-top:1px solid #f0e0e3;box-shadow:0 -4px 18px #88273307}\nbody:not(.ege-portal) .ege-bottom-item.is-current,body:not(.ege-portal) .ege-bottom-item[aria-current=\"page\"]{color:#c91b2c;background:#fff2f3}\nbody:not(.ege-portal) .ege-bottom-item.is-current svg{color:#c91b2c;stroke:#c91b2c}\nbody:not(.ege-portal) .progressbar>div,body:not(.ege-portal) #progressLine,body:not(.ege-portal) .progress-line{background:#c91b2c}\nbody:not(.ege-portal) .tag,body:not(.ege-portal) .badge{background:#fff0f2;color:#ad2030}\nbody:not(.ege-portal) .tag.approved{background:#edf8f1;color:#147548}\nbody:not(.ege-portal) .tag.pending{background:#fff5df;color:#8a651e}\nbody:not(.ege-portal) .ege-annex-preview{background:#fff7f8;border-color:#eedbde}\nbody:not(.ege-portal) .ege-annex-preview>summary{color:#ad2230}\nbody:not(.ege-portal) .ege-annex-paper{box-shadow:0 5px 16px #6819270c}\nbody:not(.ege-portal) .paper{background:#fff}\nbody:not(.ege-portal) dialog{border-color:#e9d5d9}\nbody:not(.ege-portal) .identity .mark{background:#c91b2c}\n@media(max-width:680px){\nbody:not(.ege-portal) .topright .pill{display:none}\nbody:not(.ege-portal) .questionbox,body:not(.ege-portal) .card{border-radius:14px}\nbody:not(.ege-portal) button,body:not(.ege-portal) a{touch-action:manipulation}\nbody:not(.ege-portal) .topbar{padding:10px 12px}\n}\n\n/* Ces composants injectent leurs styles après le chargement : forcer la cohérence des boutons. */\nbody:not(.ege-portal) .ege-phase-modal button.ege-primary,\nbody:not(.ege-portal) .ege-phase-modal button.ege-dossier-primary,\nbody:not(.ege-portal) .ege-group-join-actions button[type=\"submit\"],\nbody:not(.ege-portal) .ege-cloud-dialog button.ege-cloud-primary{background:#c91b2c!important;border-color:#c91b2c!important;color:#fff!important}\nbody:not(.ege-portal) .ege-phase-modal button:not(.ege-primary):not(.ege-dossier-primary),\nbody:not(.ege-portal) .ege-cloud-dialog button:not(.ege-cloud-primary){background:#fff;color:#a91828;border-color:#e6cbd0}\nbody:not(.ege-portal) .ege-phase-modal .ege-current,\nbody:not(.ege-portal) .ege-phase-modal .ege-dossier-history{background:#fff5f5!important}\nbody:not(.ege-portal) .ege-phase-modal .ege-dossier-card.is-selected{background:#fff1f3!important;border-color:#cf7581!important}\nbody:not(.ege-portal) .ege-phase-modal .ege-phase-header small{color:#ae1e2d!important}\n.ege-student-bottom,.ege-teacher-bottom,.ege-admin-bottom{display:none}\n@media(max-width:700px){\n .ege-teacher-bottom,.ege-admin-bottom{display:flex;position:fixed;z-index:50;bottom:0;left:0;right:0;gap:5px;justify-content:space-around;align-items:center;padding:7px 8px calc(7px + env(safe-area-inset-bottom));background:#fff;border-top:1px solid #eedfe2}\n .ege-teacher-bottom a,.ege-admin-bottom a{flex:1;text-decoration:none;color:#aa1e2d;text-align:center;font:700 12px/1.4 system-ui,sans-serif;padding:8px 3px;border-radius:9px;min-height:38px}\n body:has(.ege-teacher-bottom),body:has(.ege-admin-bottom){padding-bottom:75px}\n}\n\n@media(max-width:700px){.ege-admin-bottom button{flex:1;text-decoration:none;color:#aa1e2d;text-align:center;font:700 12px/1.4 system-ui,sans-serif;padding:8px 3px;border:0;background:transparent;border-radius:9px;min-height:38px;cursor:pointer}}\n"],"/styles.css":["text/css; charset=utf-8",false,"\n:root{color-scheme:light;--ink:#203b36;--green:#173e39;--paper:#f5f3eb;--line:#d8dfd3;--muted:#59685f}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:2rem}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,sans-serif;line-height:1.6}header,main,footer{max-width:1280px;margin:auto}header{padding:28px 40px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:20px}a{color:inherit}button,input,select,textarea{font:inherit}button,a{touch-action:manipulation}button{cursor:pointer}button:disabled{cursor:wait;opacity:.55}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid #a37c27;outline-offset:4px}.brand{font:bold 25px Georgia,serif;text-decoration:none}.brand span{display:block;font:10px Arial,sans-serif;letter-spacing:2px;margin-top:5px}nav{display:flex;align-items:center;gap:28px;font-size:14px}nav a{text-decoration:none}nav button,.secondary{padding:10px 18px;border:1px solid var(--green);border-radius:6px;background:transparent;color:var(--green)}main{padding:0 40px}section{padding:64px 0;border-bottom:1px solid var(--line)}h1,h2,h3,p{margin-top:0}h1{font:normal clamp(38px,4.5vw,64px)/1.1 Georgia,serif;letter-spacing:-1.6px;margin-bottom:26px}h1 em{font-weight:normal;color:#53725a}h2{font:normal clamp(28px,3vw,38px)/1.2 Georgia,serif;letter-spacing:-.7px}h3{font-size:19px}.eyebrow{font-size:11px;font-weight:bold;letter-spacing:2px;color:#60725d;margin-bottom:18px}.hero{display:grid;grid-template-columns:1.6fr 1fr;gap:65px;padding:78px 0}.lead{font-size:17px;color:var(--muted);max-width:580px}.actions{display:flex;align-items:center;gap:24px;margin:32px 0}.primary{display:inline-flex;justify-content:center;gap:35px;align-items:center;padding:13px 22px;background:var(--green);color:white;border:1px solid var(--green);border-radius:6px;text-decoration:none}.small{font-size:12px;color:var(--muted)}.hero-card{align-self:center;position:relative;background:#e4e9db;padding:35px;border-radius:10px;box-shadow:15px 15px 0 #ece8db}.hero-card p{font:24px Georgia,serif}.year{display:block;font:70px Georgia,serif;margin-bottom:20px;color:#3c5e47}.year span{color:#a5b09a}.hero-card ol{padding-left:20px;line-height:2.2;font-size:14px}.pill{display:inline-block;font-size:11px;background:#f5f6ef;border-radius:20px;padding:6px 12px}.section-title{display:flex;justify-content:space-between;align-items:end;gap:20px}.muted{color:var(--muted);font-size:14px}.filters{display:grid;grid-template-columns:1fr 1fr;gap:20px;background:#eeeee4;padding:20px;border-radius:8px;margin:20px 0 30px}label{display:block;font-size:13px;font-weight:bold}input,select,textarea{width:100%;margin:6px 0 16px;padding:11px;background:#fffef9;color:var(--ink);border:1px solid #b9c7b8;border-radius:5px;font-size:15px}.filters input,.filters select{margin-bottom:0}.theme-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.theme-card{background:#fffef8;border:1px solid var(--line);border-radius:8px;padding:24px}.theme-card .number{font:22px Georgia,serif;color:#839079}.theme-card h3{margin:8px 0 18px}.theme-card details{padding:10px 0;border-top:1px solid var(--line)}summary{cursor:pointer;font-size:14px;padding:8px 0}details p{padding-top:12px}.offer{padding:12px;background:#f3f5ed;margin-top:10px;border-radius:5px}.offer button{margin-top:8px}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;margin-top:35px}.steps span{font:25px Georgia,serif;color:#8a9678}.steps h3{margin:14px 0 10px}.steps p{font-size:14px;color:var(--muted)}.pricing{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:30px}.pricing article{border-left:1px solid var(--line);padding-left:30px}.price{font:34px Georgia,serif}.notice{background:#f5e7c1;padding:16px;border-radius:6px;margin:20px 0}#faq details{border-bottom:1px solid var(--line);padding:8px 0}#faq p{max-width:800px;font-size:14px}.order{background:#fffef8;border:1px solid var(--line);border-radius:8px;padding:22px;margin:15px 0;overflow-wrap:anywhere}.order .actions{flex-wrap:wrap;margin:12px 0}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 20px}form button{margin-top:12px}.check{display:flex;align-items:flex-start;gap:12px;font-weight:normal;margin:15px 0}.check input{width:20px;margin:5px 0}.check span{flex:1}.stats{display:flex;gap:20px;flex-wrap:wrap}.stats p{padding:15px;background:#e4e9db;border-radius:6px}.stats strong{display:block;font-size:28px}dialog{border:1px solid var(--line);border-radius:10px;padding:32px;width:min(95vw,560px);max-height:90dvh;color:var(--ink);background:var(--paper)}dialog::backdrop{background:#122d2880}.close{float:right;font-size:26px;background:transparent;border:0;color:var(--ink)}#dialogMessage:not(:empty),#status:not(:empty),#privateMessage:not(:empty){padding:12px;background:#ece8d9;overflow-wrap:anywhere}.auth-links{display:flex;gap:20px;margin-top:20px}.auth-links button{border:0;background:transparent;text-decoration:underline;color:inherit}.skip{position:absolute;top:-100px}.skip:focus{top:0;background:white;padding:10px;z-index:100}footer{padding:35px 40px}footer .small{max-width:800px;margin-top:24px}[hidden]{display:none!important}@media(max-width:760px){header{padding:20px;align-items:start}nav{gap:12px;flex-wrap:wrap;justify-content:end}nav a{display:none}main{padding:0 20px}.hero{grid-template-columns:1fr;gap:25px;padding:45px 0}.hero-card{padding:24px;box-shadow:6px 6px 0 #ece8db}.hero-card ol{line-height:1.9}.year{font-size:48px}.hero-card p{font-size:22px}.hero-card .pill{font-size:10px}.theme-grid,.filters,.form-grid{grid-template-columns:1fr}.steps{grid-template-columns:1fr 1fr;gap:24px}.section-title{display:block}.pricing{grid-template-columns:1fr 1fr;gap:18px}.pricing>div{grid-column:1/-1}.pricing article{padding-left:18px}.price{font-size:28px}.actions{gap:16px;flex-wrap:wrap}section{padding:40px 0}footer{padding:30px 20px}dialog{padding:24px}}\n\n.auth-links{flex-wrap:wrap;gap:12px}#importProgress{width:100%;height:18px}#importStatus,#importReport,dialog{overflow-wrap:anywhere}.order h4{margin:0 0 12px}.actions:empty{display:none}#adminPanel>details{margin:22px 0;padding:18px;background:#eeeee4;border-radius:8px}\n"],"/auth-feedback.js":["application/javascript; charset=utf-8",false,"/* EGE GFM 2027 — Retour de confirmation Supabase Auth, sans lecture des jetons. */\n(()=>{'use strict';\n  const hash = new URLSearchParams(window.location.hash.slice(1));\n  const search = new URLSearchParams(window.location.search);\n  const error = hash.get('error') || hash.get('error_code') || search.get('error') || search.get('error_code');\n  const isSignup = hash.get('type') === 'signup' && hash.has('access_token');\n  const isRecovery = hash.get('type') === 'recovery' && hash.has('access_token');\n  if (!error && !isSignup && !isRecovery) return;\n  const teacher = /\\/enseignant\\.html$/i.test(window.location.pathname);\n  let title, description, good = !error;\n  if (error) {\n    title = 'Lien de confirmation non valide';\n    description = 'Ce lien a peut-être expiré ou déjà été utilisé. Si votre adresse est confirmée, connectez-vous avec votre compte. Sinon, demandez un nouveau lien depuis l’application.';\n  } else if (isSignup) {\n    title = 'Votre adresse e-mail est confirmée';\n    description = teacher\n      ? 'Bienvenue sur EGE GFM 2027. Vous pouvez vous connecter et demander votre accès enseignant.'\n      : 'Bienvenue sur EGE GFM 2027. Votre compte est activé. Vous pouvez maintenant accéder à vos dossiers.';\n  } else {\n    title = 'Réinitialisation du mot de passe';\n    description = teacher\n      ? 'Ouvrez l’application principale pour définir un nouveau mot de passe.'\n      : 'Choisissez un nouveau mot de passe dans la fenêtre de récupération de votre compte.';\n  }\n  function show() {\n    if (document.getElementById('egeAuthReturnMessage')) return;\n    const box = document.createElement('section');\n    box.id = 'egeAuthReturnMessage';\n    box.setAttribute('role','status');\n    box.setAttribute('aria-live','polite');\n    box.style.cssText = 'max-width:1020px;margin:14px auto 8px;padding:16px 18px;border-radius:14px;border:1px solid '+(good?'#b9e1ce':'#e9c4b5')+';background:'+(good?'#ebf8f1':'#fff4ef')+';color:#193b4b;box-sizing:border-box;font:14px/1.5 system-ui,sans-serif;';\n    const heading = document.createElement('strong');\n    heading.textContent=title;\n    heading.style.cssText='display:block;font-size:17px;margin-bottom:5px';\n    const p = document.createElement('p');\n    p.textContent=description;\n    p.style.margin='0';\n    box.append(heading,p);\n    const main = document.querySelector('main');\n    if (main?.parentNode) main.parentNode.insertBefore(box,main);\n    else document.body.prepend(box);\n  }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded',show,{once:true});\n  else show();\n})();"],"/word-import.js":["application/javascript; charset=utf-8",false,"/* EGE GFM 2027 — Importation locale d'un document Word .docx.\n   Les données du fichier ne sont envoyées à aucun serveur.\n   Les champs ambigus sont laissés à vérifier par le candidat. */\n(function(){\n'use strict';\nconst W_NS='http://schemas.openxmlformats.org/wordprocessingml/2006/main';\nconst ui=id=>document.getElementById(id);\nconst MAX_FILE=20*1024*1024,MAX_XML=5*1024*1024;\nlet pending=null;\nconst trim=x=>String(x??'').replace(/\\u00a0/g,' ').replace(/\\s+/g,' ').trim();\nconst normal=x=>trim(x).normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().replace(/[’‘]/g,\"'\").replace(/[^\\p{L}\\p{N}]+/gu,' ').trim();\nconst escape=x=>String(x??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction notice(s,error){\n const el=ui('wordImportStatus');if(el){el.textContent=s;el.classList.toggle('error',!!error);}\n}\nfunction field(id,value){const el=ui(id);if(el)el.value=String(value??'');}\nfunction fromWordXml(xml){\n const doc=new DOMParser().parseFromString(xml,'application/xml');\n if(doc.getElementsByTagName('parsererror').length)throw Error('Le texte du document Word est illisible.');\n const paragraphs=Array.from(doc.getElementsByTagNameNS(W_NS,'p'));\n if(!paragraphs.length)throw Error('Le Word ne contient aucun texte exploitable.');\n if(paragraphs.length>10000)throw Error('Ce Word contient trop de paragraphes pour une importation directe.');\n const items=paragraphs.map(p=>trim(Array.from(p.getElementsByTagNameNS(W_NS,'t')).map(t=>t.textContent).join(''))).filter(Boolean);\n if(items.join('').length<20)throw Error('Le document ne contient pas assez de texte. Les Word scannés sous forme d’images ne peuvent pas être reconnus automatiquement.');\n return items;\n}\nfunction fieldFromParagraphs(parts,labels){\n const max=Math.min(125,parts.length);\n const normalizedLabels=labels.map(normal);\n for(let i=0;i<max;i++){\n  const text=parts[i],s=normal(text);\n  for(const label of normalizedLabels){\n   if(s===label){\n    const next=parts[i+1]||'';\n    if(next&&next.length<=600&&!/^(?:annexe\\s*\\d|titre$|source$|th[eè]me$|sous.th[eè]me$|probl[eé]matique$)/i.test(next))return trim(next);\n   }\n   const asText=normal(text.split(/[:：]/)[0]);\n   if(asText===label&&/[:：]/.test(text)){\n    const val=trim(text.substring(text.indexOf(':')+1));\n    if(val.length>1&&val.length<=600)return val;\n   }\n  }\n }\n return '';\n}\nfunction matchTitle(text,options){\n const key=normal(text);\n if(!key)return -1;\n let index=options.findIndex(x=>normal(x)===key);\n if(index>=0)return index;\n // Only accept a strong unique match, to avoid assigning an unrelated official subject.\n const matches=options.map((x,i)=>({i,k:normal(x)})).filter(x=>x.k.length>15&&(key.includes(x.k)||x.k.includes(key))&&Math.min(key.length,x.k.length)/Math.max(key.length,x.k.length)>.80);\n return matches.length===1?matches[0].i:-1;\n}\nfunction annexHeading(text){\n if(/\\.{2,}\\s*page\\s*\\d+/i.test(text)||/page\\s*\\d+\\s*$/i.test(text))return 0;\n const m=trim(text).match(/^annexe\\s*(?:n[°ºo]\\s*)?([1-4])(?:\\s*[:\\-–—.]\\s*[\\p{L} ]{0,75})?$/iu);\n return m?Number(m[1]):0;\n}\nfunction stopSection(text){\n const v=normal(text);\n return /^(?:entreprises potentielles|presentation de l organisation|presentation de l entreprise|organigramme|guide d entretien|tableau comparatif|synthese redigee|synthese de la visite|bibliographie|conclusion generale|partie ii\\b|partie pratique\\b)/.test(v);\n}\nfunction parseAnnexes(parts){\n const best={};\n let markers=[];\n for(let i=0;i<parts.length;i++){const n=annexHeading(parts[i]);if(n)markers.push({i,n});}\n for(const m of markers){\n  let last=parts.length;\n  const following=markers.find(x=>x.i>m.i);\n  if(following)last=following.i;\n  for(let i=m.i+1;i<last;i++){if(stopSection(parts[i])){last=i;break;}}\n  let body=parts.slice(m.i+1,last);\n  // Table of annexes inside the study sheet: ignore inventory content.\n  if(body[0]&&normal(body[0])==='titre')continue;\n  let source='',title='';\n  let lines=[];\n  for(let i=0;i<body.length;i++){\n   const raw=body[i],v=normal(raw);\n   if(/^source\\s*(?:[:：]|$)/i.test(raw)){\n    let val=trim(raw.replace(/^sources?\\s*[:：]?\\s*/i,''));\n    if(!val&&body[i+1]){val=trim(body[i+1]);i++;}\n    if(val&&!/r[eé]f[eé]rence documentaire [aà] renseigner|[aà] compl[eé]ter|source non v[eé]rifi[eé]e/i.test(val))source=val.slice(0,1000);\n    continue;\n   }\n   if(v==='titre'){title=trim(body[i+1]||'').slice(0,190);i++;continue;}\n    if(/^titre\\s*[:：]/i.test(raw)){title=trim(raw.replace(/^titre\\s*[:：]\\s*/i,'')).slice(0,190);continue;}\n   if(!lines.length&&raw.length<=165&&(!/[.!?]$/.test(raw)||/notions|comprendre|element|reponse/i.test(raw))){title=title||raw.slice(0,190);continue;}\n   if(/^\\d+$/.test(raw)&&raw.length<=2)continue;\n   lines.push(raw);\n  }\n  const text=lines.join('\\n\\n').trim().slice(0,30000);\n  const score=text.length;\n  if(score>0&&(!best[m.n]||score>best[m.n].score))best[m.n]={text,source,title,score};\n }\n return best;\n}\nfunction parseWord(parts){\n const candidate=fieldFromParagraphs(parts,['Candidat(e)','Candidat','Nom du candidat','Nom du candidat(e)','Noms des candidats'])||fieldFromParagraphs(parts,['Nom du candidat']);\n let student=candidate,partner='',className='';\n const classMark=student.match(/\\s*[—–-]\\s*((?:[1T]GFM|[1T]OGRH|[1T]IAG)\\s*\\d+)\\s*$/i);\n if(classMark){className=trim(classMark[1]);student=trim(student.slice(0,classMark.index));}\n if(!className){\n  const other=fieldFromParagraphs(parts,['Nom du candidat','Nom du candidat(e)']);\n  const match=other.match(/\\s*[—–-]\\s*((?:[1T]GFM|[1T]OGRH|[1T]IAG)\\s*\\d+)\\s*$/i);\n  if(match)className=trim(match[1]);\n }\n if(!className){const v=fieldFromParagraphs(parts,['Classe','Classe du candidat']);if(v&&v.length<40)className=v;}\n const binome=/\\s+et\\s+/i.test(student)&&student.length<120;\n if(binome){const a=student.split(/\\s+et\\s+/i);student=trim(a[0]);partner=trim(a.slice(1).join(' et '));}\n const themeText=fieldFromParagraphs(parts,['Thème','Thème de gestion']);\n const subthemeText=fieldFromParagraphs(parts,['Sous-thème','Sous thème']);\n let series=EGEAcademic.seriesOf({series:fieldFromParagraphs(parts,['Série','Serie','Spécialité']).toUpperCase(),className});\n if(!className&&matchTitle(themeText,EGEAcademic.ogrh.map(x=>x.title))>=0)series='OGRH';\n const catalog=egeCatalog({series});\n const themeIndex=matchTitle(themeText,catalog.map(x=>x.title));\n const subthemeIndex=themeIndex>=0?matchTitle(subthemeText,catalog[themeIndex].subthemes.map(x=>x.name)):-1;\n const annexes=parseAnnexes(parts);\n const mode=binome||annexes[4]?'binome':'individuel';\n const problem=fieldFromParagraphs(parts,['Problématique','Question de gestion','Question problématique']);\n const school=fieldFromParagraphs(parts,['Établissement','Etablissement','Lycée','Etablissement scolaire']);\n let teacher=fieldFromParagraphs(parts,['Professeur','Enseignant','Professeur encadrant']);\n if(/^[àa] pr[eé]ciser|^professeur/i.test(teacher))teacher='';\n const found=Object.values(annexes).filter(x=>x.text&&x.text.length>20).length;\n const notes=[];\n if(themeText&&themeIndex<0)notes.push('Le thème du Word ne correspond pas exactement au référentiel de la série choisie pour 2026–2027 : choisis le thème officiel.');\n if(subthemeText&&subthemeIndex<0)notes.push('Le sous-thème doit être vérifié et choisi dans la liste officielle.');\n if(!found)notes.push('Aucune annexe numérotée n’a pu être reconnue automatiquement : tu peux affecter le texte à l’annexe 1.');\n\n const evidence=parts.join('\\n').slice(0,45000);\n return {series,student,partner,className,school,teacher,themeText,subthemeText,themeIndex,subthemeIndex,problem,mode,annexes,found,notes,evidence};\n}\nfunction addOption(select,value,label){\n const opt=document.createElement('option');opt.value=String(value);opt.textContent=label;select.append(opt);\n}\nfunction updateSubjectOptions(selected){\n const theme=ui('wordImportTheme'),sub=ui('wordImportSubtheme');\n if(!theme||!sub)return;\n const index=Number(theme.value);\n sub.replaceChildren();addOption(sub,'','— Sous-thème à choisir —');\n if(theme.value!==''){\n  egeCatalog({series:ui('wordImportSeries').value})[index]?.subthemes.forEach((item,i)=>addOption(sub,i,item.name));\n  if(selected!==undefined&&selected!==null&&selected>=0)sub.value=String(selected);\n }\n}\nfunction openPreview(doc,file){\n pending={doc,fileName:file.name};\n const overlay=ui('wordImportOverlay');\n ui('wordImportFilename').textContent=file.name;\n field('wordImportMode',doc.mode);field('wordImportStudent',doc.student);field('wordImportPartner',doc.partner);field('wordImportClass',doc.className);\n field('wordImportSchool',doc.school);field('wordImportTeacher',doc.teacher);field('wordImportProblem',doc.problem);\n ui('wordImportSeries').innerHTML=EGEAcademic.options(EGEAcademic.series,doc.series,'Choisir une série');\n ui('wordImportClass').innerHTML=EGEAcademic.options(EGEAcademic.classes[doc.series],doc.className,'Choisir une classe',true);\n ui('wordImportSchool').innerHTML=EGEAcademic.options(EGEAcademic.schools,doc.school,'Choisir un établissement',true);\n const theme=ui('wordImportTheme');theme.replaceChildren();addOption(theme,'','— Thème officiel à choisir —');\n egeCatalog({series:doc.series}).forEach((item,i)=>addOption(theme,i,item.title));theme.value=doc.themeIndex<0?'':String(doc.themeIndex);\n updateSubjectOptions(doc.subthemeIndex);\n for(let i=1;i<=4;i++){\n  field('wordImportTitle'+i,doc.annexes[i]?.title||'');\n   field('wordImportAnnex'+i,doc.annexes[i]?.text||'');\n  field('wordImportSource'+i,doc.annexes[i]?.source||'');\n  const box=ui('wordImportAnnexBox'+i);\n  if(box){box.open=!!doc.annexes[i]?.text;box.hidden=i===4&&doc.mode==='individuel';}\n }\n const loose=ui('wordImportLoose');\n loose.value=doc.evidence.slice(0,25000);\n ui('wordImportLooseBox').hidden=doc.found>0;\n const lines=doc.notes.length?doc.notes:['Vérifie les champs extraits avant de confirmer. Les mises en forme complexes et les images ne sont pas reprises.'];\n notice('Reconnaissance terminée : '+doc.found+' annexe(s) détectée(s). '+lines.join(' '),false);\n overlay.hidden=false;overlay.querySelector('.word-import-panel')?.scrollTo(0,0);\n ui('wordImportCancel')?.focus();\n}\nasync function processImport(file){\n if(!/\\.docx$/i.test(file.name))throw Error('Sélectionne un fichier Word au format .docx (et non .doc ou PDF).');\n if(file.size>MAX_FILE)throw Error('Le fichier dépasse 20 Mo : réduis sa taille.');\n if(typeof JSZip==='undefined')throw Error('Lecteur Word non disponible sur cet appareil.');\n const zip=await JSZip.loadAsync(await file.arrayBuffer(),{checkCRC32:true});\n const entry=zip.file('word/document.xml');\n if(!entry)throw Error('Structure Word invalide : « word/document.xml » est introuvable.');\n const xml=await entry.async('string');\n if(xml.length>MAX_XML)throw Error('Ce document dépasse la limite de lecture (5 Mo de texte XML).');\n const parsed=parseWord(fromWordXml(xml));\n const terrainPart=zip.file('customXml/ege-terrain.xml');\n if(terrainPart){parsed.terrain=EGETerrain.readWordData(await terrainPart.async('string'));parsed.notes.push('La partie terrain est reprise. Les images de l’entreprise devront être réimportées dans le dossier.')}\n return parsed;\n}\nasync function applyImport(){\n if(!pending)return;\n const themeEl=ui('wordImportTheme'),subEl=ui('wordImportSubtheme');\n const mode=ui('wordImportMode').value;\n const imported=empty();\n imported.terrain=EGETerrain.normalize(pending.doc.terrain);\n imported.company=imported.terrain.organizationName;\n imported.series=EGEAcademic.series.includes(ui('wordImportSeries').value)?ui('wordImportSeries').value:'GFM';\n imported.mode=mode==='binome'?'binome':'individuel';\n imported.student=trim(ui('wordImportStudent').value).slice(0,180);\n imported.partner=imported.mode==='binome'?trim(ui('wordImportPartner').value).slice(0,180):'';\n imported.className=trim(ui('wordImportClass').value).slice(0,180);\n imported.school=trim(ui('wordImportSchool').value).slice(0,180);\n imported.teacher=trim(ui('wordImportTeacher').value).slice(0,180);\n imported.problem=trim(ui('wordImportProblem').value).slice(0,700);\n imported.problemMode=imported.problem?'custom':'';\n if(themeEl.value!==''){imported.theme=Number(themeEl.value);}\n if(subEl.value!==''&&imported.theme!==null){imported.subtheme=Number(subEl.value);}\n for(let i=1;i<=(imported.mode==='binome'?4:3);i++){\n  let text=ui('wordImportAnnex'+i).value.trim();\n  let source=ui('wordImportSource'+i).value.trim();\n  let title=ui('wordImportTitle'+i)?.value.trim();\n   if(title)imported.annexTitles[i]=title.slice(0,190);\n   if(text)imported.annexes[i]=text.slice(0,30000);\n  if(source)imported.sources[i]=source.slice(0,1500);\n  // Checking sources is a human action; imports must not mark them as verified.\n  imported.sourceChecks[i]=false;\n }\n if(!imported.student&&!imported.problem&&!Object.values(imported.annexes).some(Boolean)){\n  notice('Aucun champ ni texte d’annexe à importer. Vérifie le Word ou renseigne les champs.',true);return;\n }\n const oldHasData=!!(data.student||data.problem||Object.values(data.annexes||{}).some(v=>v));\n if(oldHasData&&!await window.MBDialog.confirm('Ce fichier Word remplacera le dossier EGE ouvert sur cet appareil. Veux-tu continuer ? Tu peux d’abord utiliser « Sauvegarder le dossier actuel » pour obtenir une copie JSON.'))return;\n imported.step=!imported.student?'student':imported.theme===null?'theme':imported.subtheme===null?'subtheme':!imported.problem?'problem':'finish';\n imported.resumeAt=imported.step;\n const previous=data;\n data=imported;\n window.EGE2027Phase1?.detachCurrent();\n if(!save()){\n  data=previous;notice('Espace de stockage insuffisant : le dossier actuel a été conservé. Libère de l’espace et réessaie.',true);return;\n }\n pending=null;ui('wordImportOverlay').hidden=true;\n render();window.scrollTo({top:0,behavior:'smooth'});\n toast('Dossier Word importé. Relis les champs, annexes et sources avant l’export.');\n}\nfunction closePreview(){ui('wordImportOverlay').hidden=true;pending=null;}\ndocument.addEventListener('DOMContentLoaded',()=>{\n const picker=ui('importFile');\n if(!picker)return;\n picker.accept='.json,.docx,application/json,application/vnd.openxmlformats-officedocument.wordprocessingml.document';\n const oldOnChange=picker.onchange;\n picker.onchange=async event=>{\n  const file=event.target.files?.[0];\n  if(!file)return;\n  if(/\\.json$/i.test(file.name)){\n   if(oldOnChange){\n    if((data.student||data.problem||Object.values(data.annexes||{}).some(v=>v))&&!await window.MBDialog.confirm('Restaurer cette sauvegarde JSON à la place du dossier actuel ?')){picker.value='';return;}\n    await oldOnChange.call(picker,event);\n   }\n   return;\n  }\n  if(!/\\.docx$/i.test(file.name)){picker.value='';toast('Formats acceptés : Word .docx ou sauvegarde .json');return;}\n  picker.value='';\n  ui('wordImportOverlay').hidden=false;notice('Lecture du fichier Word sur cet appareil…');\n  try{const parsed=await processImport(file);openPreview(parsed,file)}\n  catch(e){pending=null;notice('Importation impossible : '+(e?.message||String(e)),true);}\n };\n ui('wordImportClose')?.addEventListener('click',closePreview);\n ui('wordImportCancel')?.addEventListener('click',closePreview);\n ui('wordImportConfirm')?.addEventListener('click',applyImport);\n ui('wordImportTheme')?.addEventListener('change',()=>updateSubjectOptions());\n ui('wordImportSeries')?.addEventListener('change',()=>{const series=ui('wordImportSeries').value;ui('wordImportClass').innerHTML=EGEAcademic.options(EGEAcademic.classes[series]||[],'','Choisir une classe');const theme=ui('wordImportTheme');theme.replaceChildren();addOption(theme,'','— Thème officiel à choisir —');egeCatalog({series}).forEach((item,i)=>addOption(theme,i,item.title));updateSubjectOptions();});\n ui('wordImportMode')?.addEventListener('change',()=>{const a=ui('wordImportAnnexBox4');if(a)a.hidden=ui('wordImportMode').value!=='binome'});\n ui('wordImportSaveCurrent')?.addEventListener('click',()=>backup());\n ui('wordImportUseLoose')?.addEventListener('click',async()=>{\n  const box=ui('wordImportAnnex1'),text=ui('wordImportLoose').value.trim();\n  if(!text)return;\n  if(box.value.trim()&&!await window.MBDialog.confirm('Remplacer le texte de l’annexe 1 par le texte sélectionné ?'))return;\n  box.value=text.slice(0,30000);ui('wordImportAnnexBox1').open=true;\n  notice('Texte placé dans l’annexe 1. Relis-le et supprime les parties qui ne correspondent pas à l’annexe.');\n });\n ui('wordImportOverlay')?.addEventListener('click',e=>{if(e.target===ui('wordImportOverlay'))closePreview()});\n document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!ui('wordImportOverlay').hidden)closePreview()});\n ui('egeCloudImportDoc')?.addEventListener('click',()=>{\n  if(typeof egeCloudOpen==='function')egeCloudOpen(false);\n  picker.click();\n });\n});\n})();\n"],"/phase1.js":["application/javascript; charset=utf-8",false,"/* Phase 1 : espace multi-dossiers et historique EGE GFM 2027.\n   Les dossiers privés sont chargés depuis Supabase, avec contrôles RLS.\n   Pas de rôle administrateur ni de mot de passe stocké ici. */\n(function(){\n'use strict';\nconst id=n=>document.getElementById(n);\nlet accountId=null, currentId=null, currentTitle='', currentRevision=null, list=[], showArchived=false, busy=false;\nlet syncTimer=null,lastSyncedJson='',autoCreate=false,conflict=false;\nconst nameOf=row=>String(row?.title||row?.student||'Mon dossier EGE').trim();\nconst str=x=>String(x??'').trim();\nconst date=s=>{try{return new Date(s).toLocaleString('fr-FR')}catch{return '—'}};\nconst key=uid=>'ege2027_dossier_selection_'+uid;\nconst cloud=()=>!window.EGELegacyOffline&&typeof egeSupabaseClient!=='undefined'&&egeSupabaseClient&&typeof egeCloudUser!=='undefined'&&egeCloudUser;\nconst cloudMsg=message=>{if(typeof egeCloudMsg==='function')egeCloudMsg(message)};\nconst el=(tag,cls,text)=>{let e=document.createElement(tag);if(cls)e.className=cls;if(text!==undefined)e.textContent=String(text);return e;};\nconst populated=()=>!!(data?.student||data?.problem||Object.values(data?.annexes||{}).some(Boolean));\nfunction status(text,bad=false){let e=id('egeDossierStatus');if(e){e.textContent=text;e.classList.toggle('error',bad)}cloudMsg(text)}\nfunction getStored(){\n if(!accountId)return;\n try{const v=JSON.parse(localStorage.getItem(key(accountId))||'null');currentId=v?.id||null;currentTitle=v?.title||'';currentRevision=v?.updated_at||null}\n catch{currentId=null;currentTitle=''}\n}\nfunction store(){\n if(!accountId)return;\n try{if(currentId)localStorage.setItem(key(accountId),JSON.stringify({id:currentId,title:currentTitle,updated_at:currentRevision}));else localStorage.removeItem(key(accountId))}catch{}\n}\nfunction onAuthChanged(user){\n const now=user?.id||null;\n if(now===accountId)return;\n accountId=now;currentId=null;currentTitle='';currentRevision=null;autoCreate=false;conflict=false;lastSyncedJson='';list=[];getStored();\n const b=id('egeDossierCurrent');\n if(b)b.textContent=accountId?(currentTitle||'Dossier local non associé'):'Connexion nécessaire';\n}\nfunction notifyCurrent(){\n const e=id('egeDossierCurrent');if(e)e.textContent=currentId?(currentTitle||'Dossier en ligne sélectionné'):'Brouillon local';\n}\nfunction cleanPayload(source){\n if(!source||typeof source!=='object'||Array.isArray(source))throw Error('Structure du dossier non reconnue');\n const v=empty();\n for(const k of Object.keys(v))if(Object.prototype.hasOwnProperty.call(source,k))v[k]=source[k];\n for(const k of ['annexes','annexTitles','sources','sourceChecks','researchEvidence','annexBackup'])\n v[k]=source[k]&&typeof source[k]==='object'&&!Array.isArray(source[k])?source[k]:{};\n v.candidates=Array.isArray(source.candidates)?source.candidates.slice(0,7):Array(7).fill('');\n v.mode=['','individuel','binome'].includes(source.mode)?source.mode:'';\n v.terrain=EGETerrain.normalize(source.terrain,source);\n v.series=EGEAcademic.seriesOf(source);\n v.theme=Number.isInteger(source.theme)&&source.theme>=0&&source.theme<egeCatalog(v).length?source.theme:null;\n v.subtheme=v.theme!==null&&Number.isInteger(source.subtheme)&&source.subtheme>=0&&source.subtheme<egeCatalog(v)[v.theme].subthemes.length?source.subtheme:null;\n if(!/^(welcome|mode|series|student|partner|className|school|teacher|theme|subtheme|problem|annex[1-4]|source[1-4]|company|candidates|finish)$/.test(v.step||''))v.step='welcome';\n if(!v.mode)v.step='mode';\n return v;\n}\nfunction dialog(open){\n const overlay=id('egeDossierOverlay');\n if(!overlay)return;\n overlay.hidden=!open;\n if(open){if(typeof egeCloudOpen==='function')egeCloudOpen(false);notifyCurrent();}\n if(open)id('egeDossierClose')?.focus();\n}\nasync function fetchList(){\n if(!cloud()){status('Connecte-toi pour voir tes dossiers.',true);return}\n const {data:rows,error}=await egeSupabaseClient.from('ege2027_dossiers')\n .select('id,title,student,updated_at,archived_at')\n .eq('owner_id',egeCloudUser.id).order('updated_at',{ascending:false}).limit(150);\n if(error)throw error;\n list=rows||[];\n renderList();\n}\nfunction renderList(){\n const host=id('egeDossierList');\n if(!host)return;\n host.replaceChildren();\n const archivedToggle=id('egeShowArchived');\n if(archivedToggle)archivedToggle.checked=showArchived;\n const filtered=list.filter(row=>!!row.archived_at===showArchived);\n const q=str(id('egeDossierSearch')?.value||'').toLocaleLowerCase('fr');\n const selected=filtered.filter(row=>(nameOf(row)+' '+(row.student||'')).toLocaleLowerCase('fr').includes(q));\n const count=id('egeDossierCount');if(count)count.textContent=selected.length+' dossier(s)';\n if(!selected.length){host.append(el('p','ege-dossier-hint',showArchived?'Aucun dossier archivé.':'Aucun dossier enregistré. Utilise « Nouveau dossier » ou « Sauvegarder en ligne ».'));return}\n for(const row of selected){\n  const card=el('article','ege-dossier-card'+(currentId===row.id?' is-selected':''));\n  const heading=el('div','ege-dossier-main');\n  heading.append(el('b','',nameOf(row)),el('small','',(row.student||'Candidat non renseigné')+' · '+date(row.updated_at)));\n  const buttons=el('div','ege-dossier-row-actions');\n  const open=el('button','ege-dossier-primary',row.archived_at?'Consulter':'Ouvrir');\n  open.type='button';open.addEventListener('click',()=>openDossier(row));\n  buttons.append(open);\n  if(row.archived_at){\n   const unarchive=el('button','ege-dossier-secondary','Réactiver');unarchive.type='button';unarchive.addEventListener('click',()=>archiveDossier(row,false));buttons.append(unarchive);\n  }else{\n   const versions=el('button','ege-dossier-secondary','Versions');versions.type='button';versions.addEventListener('click',()=>showVersions(row));buttons.append(versions);\n   const rename=el('button','ege-dossier-secondary','Renommer');rename.type='button';rename.addEventListener('click',()=>renameDossier(row));buttons.append(rename);\n   const archive=el('button','ege-dossier-muted','Archiver');archive.type='button';archive.addEventListener('click',()=>archiveDossier(row,true));buttons.append(archive);\n  }\n  card.append(heading,buttons);host.append(card);\n }\n}\nasync function saveDossier(options={}){\n const automatic=options.automatic===true;\n if(automatic&&(!cloud()||conflict||(!currentId&&!autoCreate)||!navigator.onLine))return false;\n if(!cloud()){if(typeof egeCloudOpen==='function')egeCloudOpen(true);cloudMsg('Connecte-toi pour enregistrer plusieurs dossiers en ligne. Le brouillon reste sur ton appareil.');return false}\n if(busy)return false;\n busy=true;let succeeded=false;setSyncBadge('Enregistrement…');status('Enregistrement en ligne…');\n try{\n  const json=JSON.parse(JSON.stringify(data));\n  if(currentId)await window.EGEOffline?.stage(egeCloudUser.id,{id:currentId,owner_id:egeCloudUser.id,updated_at:currentRevision},json);\n  const student=str(data.student||'').slice(0,140);\n  const title=(str(currentTitle)||('Dossier de '+(student||'nouveau candidat'))).slice(0,100);\n  let row=null,error=null;\n  const payload={student,title,payload:json,updated_at:new Date().toISOString()};\n  if(currentId){\n   if(!currentRevision){\n    const probe=await egeSupabaseClient.from('ege2027_dossiers').select('payload,updated_at').eq('owner_id',egeCloudUser.id).eq('id',currentId).maybeSingle();\n    if(probe.error)throw probe.error;\n    if(!probe.data)throw Error('Dossier introuvable ou inaccessible.');\n    if(JSON.stringify(probe.data.payload)===JSON.stringify(json)){\n     currentRevision=probe.data.updated_at;lastSyncedJson=JSON.stringify(json);store();setSyncBadge('Enregistré en ligne');return true;\n    }\n    conflict=true;\n    throw Error('Conflit entre versions. Exporte ton brouillon JSON avant de recharger le dossier depuis « Mes dossiers ».');\n   }\n   ({data:row,error}=await egeSupabaseClient.from('ege2027_dossiers')\n     .update(payload).eq('owner_id',egeCloudUser.id).eq('id',currentId).eq('updated_at',currentRevision).select('id,title,updated_at').maybeSingle());\n   if(!error&&!row){conflict=true;throw Error('Dossier modifié sur un autre appareil. Le brouillon local est conservé : exporte-le en JSON avant de recharger.');}\n  }else{\n   ({data:row,error}=await egeSupabaseClient.from('ege2027_dossiers')\n     .insert({...payload,owner_id:egeCloudUser.id}).select('id,title,updated_at').single());\n  }\n  if(error)throw error;\n  currentId=row.id;currentTitle=row.title;currentRevision=row.updated_at;autoCreate=true;lastSyncedJson=JSON.stringify(json);conflict=false;succeeded=true;store();notifyCurrent();setSyncBadge('Enregistré en ligne');\n  await window.EGEOffline?.ack(egeCloudUser.id,currentId,json,{...payload,id:currentId,owner_id:egeCloudUser.id,title:currentTitle,updated_at:currentRevision});\n  status('Dossier sauvegardé. Une version précédente pourra être restaurée depuis « Versions ».');\n  return true;\n }catch(e){setSyncBadge(conflict?'Conflit à résoudre':navigator.onLine?'Échec de synchronisation':'Hors connexion');status('Sauvegarde impossible : '+(e?.message||String(e))+'. Ton travail reste sur cet appareil.',true);return false}\n finally{busy=false;if(succeeded&&!conflict&&cloud()&&currentId&&JSON.stringify(data)!==lastSyncedJson)scheduleSync();}\n}\nfunction setSyncBadge(txt){const e=id('egeCloudBadge');if(e)e.textContent=txt}\nfunction scheduleSync(){\n if(!cloud()){setSyncBadge('Sur cet appareil');return}\n if(!navigator.onLine){setSyncBadge('Hors connexion');return}\n if(conflict){setSyncBadge('Conflit à résoudre');return}\n if(!currentId&&!autoCreate){setSyncBadge('Sur cet appareil');return}\n if(!populated())return;\n if(JSON.stringify(data)===lastSyncedJson){setSyncBadge('Enregistré en ligne');return}\n clearTimeout(syncTimer);setSyncBadge('Enregistrement…');\n syncTimer=setTimeout(()=>{if(busy){scheduleSync();return}saveDossier({automatic:true})},1450);\n}\nasync function openDossiers(){\n if(!cloud()){\n  dialog(false);\n  if(typeof egeCloudOpen==='function')egeCloudOpen(true);\n  cloudMsg('Connecte-toi pour créer et retrouver tes dossiers en ligne.');\n  return;\n }\n dialog(true);\n status('Chargement de tes dossiers…');\n try{await fetchList();status('Sélectionne un dossier ou crée un nouveau projet. Le dossier actuel n’est pas remplacé sans confirmation.')}\n catch(e){status('Liste indisponible : '+(e?.message||String(e)),true)}\n}\nasync function openDossier(row){\n if(!cloud())return;\n if(populated()&&!await window.MBDialog.confirm('Ouvrir « '+nameOf(row)+' » ? Le dossier actuellement affiché sur cet appareil sera remplacé. Sauvegarde-le avant de continuer si tu souhaites le conserver.'))return;\n status('Ouverture du dossier…');\n try{\n  const {data:remote,error}=await egeSupabaseClient.from('ege2027_dossiers')\n   .select('id,title,payload,updated_at').eq('id',row.id).eq('owner_id',egeCloudUser.id).single();\n  if(error)throw error;\n  const draft=cleanPayload(remote.payload);\n  const old=data;\n  data=draft;\n  if(!save()){data=old;throw Error('Impossible d’écrire dans le stockage local : espace insuffisant.')}\n  currentId=remote.id;currentTitle=remote.title;currentRevision=remote.updated_at;lastSyncedJson=JSON.stringify(draft);autoCreate=true;conflict=false;store();render();notifyCurrent();dialog(false);window.scrollTo({top:0,behavior:'smooth'});\n  toast('Dossier « '+currentTitle+' » ouvert.');\n }catch(e){status('Ouverture impossible : '+(e?.message||String(e)),true)}\n}\nasync function newDossier(){\n if(populated()&&!await window.MBDialog.confirm('Créer un nouveau dossier vierge ? Le dossier actuellement ouvert sera remplacé sur cet appareil. Sauvegarde-le d’abord en ligne ou en JSON si nécessaire.'))return;\n data=empty();currentId=null;currentTitle='';currentRevision=null;lastSyncedJson='';autoCreate=true;conflict=false;store();save();render();dialog(false);window.scrollTo({top:0,behavior:'smooth'});\n toast('Nouveau dossier prêt. Il sera ajouté à ton compte lors de la première sauvegarde en ligne.');\n}\nasync function renameDossier(row){\n const value=await window.MBDialog.prompt('Nom du dossier (100 caractères maximum)',nameOf(row));\n if(value===null)return;\n const title=str(value).slice(0,100);\n if(!title){status('Le nom ne peut pas être vide.',true);return}\n const {data:changed,error}=await egeSupabaseClient.from('ege2027_dossiers').update({title,updated_at:new Date().toISOString()})\n   .eq('id',row.id).eq('owner_id',egeCloudUser.id).select('updated_at').maybeSingle();\n if(error){status('Renommage impossible : '+error.message,true);return}\n if(currentId===row.id){currentTitle=title;currentRevision=changed?.updated_at||null;store();notifyCurrent()}\n status('Dossier renommé.');await fetchList();\n}\nasync function archiveDossier(row,archive){\n if(archive&&!await window.MBDialog.confirm('Archiver « '+nameOf(row)+' » ? Il restera disponible dans les archives.'))return;\n const {error}=await egeSupabaseClient.from('ege2027_dossiers')\n  .update({archived_at:archive?new Date().toISOString():null,updated_at:new Date().toISOString()})\n  .eq('id',row.id).eq('owner_id',egeCloudUser.id);\n if(error){status('Modification impossible : '+error.message,true);return}\n if(archive&&row.id===currentId){currentId=null;currentTitle='';currentRevision=null;lastSyncedJson='';autoCreate=false;store();notifyCurrent()}\n status(archive?'Dossier archivé, sans suppression.':'Dossier réactivé.');\n await fetchList();\n}\nasync function showVersions(row){\n if(!cloud())return;\n const host=id('egeDossierVersions'),title=id('egeVersionsTitle');\n if(!host||!title)return;\n title.textContent='Historique : '+nameOf(row);\n host.replaceChildren(el('p','ege-dossier-hint','Chargement des sauvegardes…'));\n const pane=id('egeDossierVersionsPanel');pane.hidden=false;\n try{\n  const {data:versions,error}=await egeSupabaseClient.from('ege2027_versions')\n    .select('id,created_at,student,title').eq('dossier_id',row.id).order('created_at',{ascending:false}).limit(20);\n  if(error)throw error;\n  host.replaceChildren();\n  if(!versions?.length){host.append(el('p','ege-dossier-hint','Aucune version enregistrée.'));return}\n  for(const item of versions){\n   const box=el('div','ege-version-row');\n   box.append(el('span','',date(item.created_at)));\n   const btn=el('button','ege-dossier-secondary','Restaurer');btn.type='button';btn.addEventListener('click',()=>restoreVersion(row,item));box.append(btn);host.append(box);\n  }\n }catch(e){host.replaceChildren(el('p','ege-dossier-hint','Historique indisponible : '+(e?.message||String(e))))}\n}\nasync function restoreVersion(row,version){\n if(!cloud()||!await window.MBDialog.confirm('Restaurer la version du '+date(version.created_at)+' ? Elle remplacera le dossier affiché et sera enregistrée comme nouvelle sauvegarde.'))return;\n status('Restauration de la version…');\n try{\n  const {data:rev,error}=await egeSupabaseClient.from('ege2027_versions')\n  .select('payload,title,student,created_at').eq('id',version.id).eq('dossier_id',row.id).single();\n  if(error)throw error;\n  const remote=cleanPayload(rev.payload);\n  const old=data,oldId=currentId,oldTitle=currentTitle;\n  data=remote;currentId=row.id;currentTitle=row.title;currentRevision=row.updated_at||null;lastSyncedJson='';conflict=false;store();\n  if(!save()){data=old;currentId=oldId;currentTitle=oldTitle;store();throw Error('Impossible de stocker la version localement')}\n  const saved=await saveDossier();\n  if(!saved){status('La version est restaurée localement, mais son enregistrement en ligne a échoué : utilise « Sauvegarder en ligne ».',true);return}\n  render();dialog(false);toast('Ancienne version restaurée et enregistrée.');\n }catch(e){status('Restauration impossible : '+(e?.message||String(e)),true)}\n}\nasync function showReviews(){\n if(!cloud()){if(typeof egeCloudOpen==='function')egeCloudOpen(true);cloudMsg('Connecte-toi pour consulter les corrections.');return}\n if(!currentId){await openDossiers();status('Ouvre d’abord un dossier pour voir ses corrections.');return}\n const {data:reviews,error}=await egeSupabaseClient.from('ege2027_reviews')\n .select('decision,observation,annex_number,created_at').eq('dossier_id',currentId).order('created_at',{ascending:false}).limit(10);\n if(error){cloudMsg('Corrections indisponibles : '+error.message);return}\n if(typeof egeCloudOpen==='function')egeCloudOpen(true);\n cloudMsg(!reviews?.length?'Pas encore de correction pour ce dossier.':reviews.map(x=>\n  (x.decision==='valide'?'Validé':'À corriger')+(x.annex_number?' · Annexe '+x.annex_number:' · Dossier')+' ('+date(x.created_at)+') : '+x.observation).join('\\n\\n'));\n}\nasync function forgotPassword(){\n if(!egeSupabaseClient)return;\n const email=str(id('egeCloudEmail')?.value).toLowerCase();\n if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)){cloudMsg('Entre ton adresse e-mail pour demander un nouveau mot de passe.');return}\n const btn=id('egeCloudForgot');if(btn)btn.disabled=true;\n try{\n  const {error}=await egeSupabaseClient.auth.resetPasswordForEmail(email,{redirectTo:'https://ege-gfm-2027.janakaleh.workers.dev/'});\n  if(error)throw error;\n  cloudMsg('Si ton compte existe, un lien de réinitialisation a été demandé. Vérifie tes e-mails et les spams. Le lien doit ouvrir l’application EGE.');\n }catch(e){cloudMsg('Réinitialisation impossible : '+(e?.message||String(e)))}\n finally{if(btn)btn.disabled=false}\n}\nfunction showRecovery(){\n const panel=id('egeRecoveryOverlay');if(!panel)return;\n panel.hidden=false;\n if(typeof egeCloudOpen==='function')egeCloudOpen(false);\n id('egeRecoveryPassword')?.focus();\n}\nasync function updatePassword(e){\n e?.preventDefault();\n const password=id('egeRecoveryPassword')?.value||'';\n const confirmPass=id('egeRecoveryConfirm')?.value||'';\n const msg=id('egeRecoveryMessage');\n if(password.length<12||password!==confirmPass){if(msg)msg.textContent='Utilise au moins 12 caractères et confirme exactement le même mot de passe.';return}\n const btn=id('egeRecoverySubmit');if(btn)btn.disabled=true;\n try{\n  if(!egeSupabaseClient)throw Error('Connexion Supabase indisponible');\n  const {error}=await egeSupabaseClient.auth.updateUser({password});\n  if(error)throw error;\n  if(msg)msg.textContent='Mot de passe modifié. Tu peux maintenant te connecter avec cette adresse e-mail et ton nouveau mot de passe.';\n  id('egeRecoveryPassword').value='';id('egeRecoveryConfirm').value='';\n  id('egeRecoveryOverlay').hidden=true;\n  if(typeof egeCloudOpen==='function')egeCloudOpen(true);\n  cloudMsg('Mot de passe mis à jour.');\n }catch(err){if(msg)msg.textContent='Modification refusée : '+(err?.message||String(err))}\n finally{if(btn)btn.disabled=false}\n}\nfunction buildPhase1UI(){\n if(id('egeDossierOverlay'))return;\n const style=document.createElement('style');\n style.textContent=\".ege-phase-overlay[hidden],.ege-dossier-history[hidden]{display:none!important}.ege-phase-overlay{position:fixed;inset:0;z-index:6300;background:#142943bb;display:flex;align-items:center;justify-content:center;padding:10px}.ege-phase-modal{background:#fff;color:#18344f;width:min(100%,660px);max-height:calc(100dvh - 20px);overflow:auto;padding:23px;border-radius:20px;box-shadow:0 20px 60px #071d3355}.ege-phase-header{display:flex;justify-content:space-between;align-items:start;gap:10px}.ege-phase-header h2{font-size:24px;margin:2px 0}.ege-phase-header small{font-size:11px;font-weight:800;color:#2460b9}.ege-phase-header p,.ege-phase-modal>p{font-size:12px;color:#718196}.ege-close{font-size:26px;width:40px}.ege-current{margin:15px 0;padding:12px;background:#ecf4ff;border-radius:12px;display:flex;justify-content:space-between;gap:10px}.ege-current strong{color:#235b9e}.ege-tools,.ege-dossier-row-actions,.ege-filter,.ege-version-head,.ege-version-row,.ege-count{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:9px}.ege-tools{margin:14px 0}.ege-phase-modal button{min-height:40px;border:1px solid #cbdbed;border-radius:10px;background:#eef4fc;color:#28598c;padding:8px 13px;font-weight:700;font-size:13px}.ege-phase-modal button.ege-primary,.ege-phase-modal button.ege-dossier-primary{background:#245ed7;border-color:#245ed7;color:white}.ege-phase-modal button.ege-dossier-muted{color:#896575;background:#faf5f7}.ege-filter>input{flex:1;min-width:0;border:1px solid #cfdeec;border-radius:10px;padding:11px;background:white}.ege-filter label{font-size:12px;display:flex;align-items:center;gap:5px}.ege-list{display:grid;gap:9px;max-height:40vh;overflow-y:auto;margin:10px 0}.ege-dossier-card{border:1px solid #d9e5f2;border-radius:12px;padding:12px}.ege-dossier-card.is-selected{background:#f2f8ff;border-color:#93b7ea}.ege-dossier-main b{display:block}.ege-dossier-main small{display:block;color:#657990;font-size:11px}.ege-dossier-row-actions{justify-content:flex-start;margin-top:9px}.ege-dossier-history{background:#f8fbff;border:1px solid #dce6f1;border-radius:12px;padding:12px}.ege-version-row{border-top:1px solid #e3ecf5;padding:7px 0}.ege-version-head h3{margin:0;font-size:15px}.ege-dossier-status{font-size:12px;color:#225c93;border-top:1px solid #e0e8f1;padding-top:10px;white-space:pre-wrap}.ege-dossier-status.error{color:#af4332}.ege-recovery-form label{display:block;font-weight:700;margin:12px 0 5px}.ege-recovery-form input{width:100%;border:1px solid #c9d9e9;border-radius:10px;padding:12px;background:#fff}.ege-cloud-password-wrap{display:flex;gap:5px}.ege-cloud-password-wrap input{flex:1;min-width:0}.ege-cloud-password-wrap button{border:1px solid #d2dfea;border-radius:10px;background:#eef4fa;color:#255a98;padding:10px}#egeCloudForgot{border:0;background:transparent;color:#245ed7;text-decoration:underline;padding:9px;font-size:12px;font-weight:700}body:has(.ege-phase-overlay:not([hidden])){overflow:hidden}body:has(.ege-phase-overlay:not([hidden])) .ege-bottom-nav{display:none!important}@media(max-width:740px){.ege-phase-overlay{padding:6px;padding-bottom:calc(6px + env(safe-area-inset-bottom))}.ege-phase-modal{max-height:calc(100dvh - 12px - env(safe-area-inset-bottom));padding:16px}.ege-current{display:block}.ege-current strong{display:block}.ege-dossier-row-actions button{flex:1}}@media print{.ege-phase-overlay{display:none!important}}\";document.head.appendChild(style);\n document.body.insertAdjacentHTML('beforeend',\"<div id=\\\"egeDossierOverlay\\\" class=\\\"ege-phase-overlay\\\" hidden role=\\\"dialog\\\" aria-modal=\\\"true\\\" aria-labelledby=\\\"egeDossierTitle\\\"><section class=\\\"ege-phase-modal\\\">\\n <header class=\\\"ege-phase-header\\\"><div><small>ESPACE PERSONNEL</small><h2 id=\\\"egeDossierTitle\\\">Mes dossiers EGE</h2><p>Plusieurs dossiers et historique de sauvegarde.</p></div><button id=\\\"egeDossierClose\\\" class=\\\"ege-close\\\" type=\\\"button\\\" aria-label=\\\"Fermer\\\">×</button></header>\\n <div class=\\\"ege-current\\\"><small>Actuellement ouvert</small><strong id=\\\"egeDossierCurrent\\\">Brouillon local</strong></div>\\n <div class=\\\"ege-tools\\\"><button id=\\\"egeDossierNew\\\" type=\\\"button\\\" class=\\\"ege-primary\\\">+ Nouveau dossier</button><button id=\\\"egeDossierRefresh\\\" type=\\\"button\\\">Actualiser</button></div>\\n <div class=\\\"ege-filter\\\"><input id=\\\"egeDossierSearch\\\" type=\\\"search\\\" placeholder=\\\"Rechercher un dossier\\\" aria-label=\\\"Rechercher un dossier\\\"><label><input id=\\\"egeShowArchived\\\" type=\\\"checkbox\\\"> Archives</label></div>\\n <div class=\\\"ege-count\\\"><b>Mes documents</b><small id=\\\"egeDossierCount\\\"></small></div><div id=\\\"egeDossierList\\\" class=\\\"ege-list\\\"></div>\\n <section id=\\\"egeDossierVersionsPanel\\\" class=\\\"ege-dossier-history\\\" hidden><div class=\\\"ege-version-head\\\"><h3 id=\\\"egeVersionsTitle\\\">Versions</h3><button id=\\\"egeVersionsClose\\\" type=\\\"button\\\">Fermer</button></div><div id=\\\"egeDossierVersions\\\"></div><p>Les 20 dernières versions sont récupérables.</p></section>\\n <div class=\\\"ege-tools\\\"><button id=\\\"egeDossierSaveLocal\\\" type=\\\"button\\\">Exporter JSON</button><button id=\\\"egeDossierImport\\\" type=\\\"button\\\">Importer Word / JSON</button></div><p id=\\\"egeDossierStatus\\\" role=\\\"status\\\" aria-live=\\\"polite\\\">Prêt.</p>\\n</section></div>\\n<div id=\\\"egeRecoveryOverlay\\\" class=\\\"ege-phase-overlay\\\" hidden role=\\\"dialog\\\" aria-modal=\\\"true\\\" aria-labelledby=\\\"egeRecoveryTitle\\\"><section class=\\\"ege-phase-modal\\\" style=\\\"max-width:450px\\\"><h2 id=\\\"egeRecoveryTitle\\\">Nouveau mot de passe</h2>\\n <p>Définis un mot de passe EGE distinct de Gmail.</p><form id=\\\"egeRecoveryForm\\\">\\n <label for=\\\"egeRecoveryPassword\\\">Nouveau mot de passe (12 caractères minimum)</label><input id=\\\"egeRecoveryPassword\\\" type=\\\"password\\\" minlength=\\\"12\\\" autocomplete=\\\"new-password\\\" required>\\n <label for=\\\"egeRecoveryConfirm\\\">Confirmer</label><input id=\\\"egeRecoveryConfirm\\\" type=\\\"password\\\" minlength=\\\"12\\\" autocomplete=\\\"new-password\\\" required><p id=\\\"egeRecoveryMessage\\\" role=\\\"status\\\"></p>\\n <div class=\\\"ege-tools\\\"><button id=\\\"egeRecoverySubmit\\\" class=\\\"ege-primary\\\" type=\\\"submit\\\">Enregistrer</button><button id=\\\"egeRecoveryDismiss\\\" type=\\\"button\\\">Fermer</button></div></form></section></div>\");\n const auth=id('egeCloudAuth'),pwd=id('egeCloudPassword');\n if(auth&&pwd){const row=document.createElement('div');row.className='ege-cloud-password-wrap';pwd.parentNode.insertBefore(row,pwd);row.append(pwd);const eye=el('button','','Voir');eye.id='egeCloudPasswordEye';eye.type='button';row.append(eye);const forgot=el('button','','Mot de passe oublié ?');forgot.id='egeCloudForgot';forgot.type='button';auth.append(forgot)}\n const existing=id('egeCloudLoad');if(existing){existing.id='egeCloudOpenDossiers'}\n}\n\n/* Encadrement : inscription d'un élève dans un groupe, et accès enseignant. */\nfunction installGroupJoinUI(){\n if(id('egeGroupJoinOverlay'))return;\n const style=el('style');style.textContent='.ege-group-join-help{font-size:12px;color:#687e95}.ege-group-join-grid{display:grid;gap:9px;margin-top:13px}.ege-group-join-grid label{display:block;font-weight:750;font-size:13px}.ege-group-join-grid input{width:100%;min-height:45px;border:1px solid #bfd3e7;padding:11px;border-radius:10px;background:white}.ege-teacher-link{display:inline-block;color:#245bb3;font-weight:750;font-size:13px;margin:8px 0;text-decoration:underline}.ege-group-join-note{font-size:12px;white-space:pre-wrap;color:#215e99}';document.head.append(style);\n const auth=id('egeCloudAuth');\n if(auth){\n  const link=el('a','ege-teacher-link','Vous êtes enseignant ? Créer votre espace');\n  link.href='./enseignant.html';auth.append(link);\n }\n const actions=id('egeCloudActions');\n if(actions){\n  const row=el('div','ege-cloud-buttons');\n  const btn=el('button','','Rejoindre ma classe');btn.type='button';btn.id='egeGroupJoinOpen';\n  row.append(btn);\n\n  actions.prepend(row);\n }\n const root=el('div','ege-phase-overlay');root.id='egeGroupJoinOverlay';root.hidden=true;root.setAttribute('role','dialog');root.setAttribute('aria-modal','true');root.setAttribute('aria-labelledby','egeGroupJoinTitle');\n const panel=el('section','ege-phase-modal');panel.style.maxWidth='460px';\n panel.append(el('h2','', 'Rejoindre mon groupe EGE'),el('p','ege-group-join-help','Demande le code à ton professeur. Tes dossiers ne seront visibles que par les enseignants de tes groupes et l’administrateur.'));\n const form=el('form','ege-group-join-grid');form.id='egeGroupJoinForm';\n const labelCode=el('label','','Code donné par le professeur');labelCode.htmlFor='egeGroupJoinCode';\n const code=el('input');code.id='egeGroupJoinCode';code.maxLength=12;code.minLength=12;code.required=true;code.autocomplete='off';code.placeholder='12 caractères';\n const labelName=el('label','','Ton nom et prénom');labelName.htmlFor='egeGroupJoinName';\n const name=el('input');name.id='egeGroupJoinName';name.required=true;name.maxLength=140;name.minLength=2;name.placeholder='Nom complet';\n const submit=el('button','ege-primary','Rejoindre');submit.type='submit';submit.id='egeGroupJoinSubmit';\n const close=el('button','','Fermer');close.type='button';close.id='egeGroupJoinClose';\n const actionsRow=el('div','ege-tools');actionsRow.append(submit,close);\n const result=el('p','ege-group-join-note','');result.id='egeGroupJoinMessage';result.setAttribute('role','status');\n form.append(labelCode,code,labelName,name,actionsRow,result);panel.append(form);root.append(panel);document.body.append(root);\n id('egeGroupJoinOpen')?.addEventListener('click',()=>{\n  if(!cloud()){if(typeof egeCloudOpen==='function')egeCloudOpen(true);cloudMsg('Connecte-toi pour rejoindre la classe de ton professeur.');return}\n  if(typeof egeCloudOpen==='function')egeCloudOpen(false);\n  result.textContent='';\n  name.value=String(data?.student||'').trim().slice(0,140);\n  root.hidden=false;code.focus();\n });\n close.addEventListener('click',()=>root.hidden=true);\n root.addEventListener('click',e=>{if(e.target===root)root.hidden=true});\n form.addEventListener('submit',async e=>{\n  e.preventDefault();\n  if(!cloud()){result.textContent='Connexion nécessaire.';return}\n  const groupCode=code.value.trim().toUpperCase(),studentName=name.value.trim();\n  if(!/^[A-F0-9]{12}$/.test(groupCode)||studentName.length<2){result.textContent='Vérifie le code (12 caractères) et ton nom complet.';return}\n  submit.disabled=true;result.textContent='Inscription en cours…';\n  try{\n   const {data:groupId,error}=await egeSupabaseClient.rpc('ege2027_join_group',{p_code:groupCode,p_student_name:studentName});\n   if(error)throw error;\n   const response=await egeSupabaseClient.from('ege2027_teacher_groups').select('name,school').eq('id',groupId).maybeSingle();\n   if(response.error)throw response.error;\n   result.textContent='Groupe rejoint'+(response.data?.name?' : '+response.data.name:'')+'.';\n    if(populated()&&await window.MBDialog.confirm('Associer le dossier EGE ouvert à ce groupe ? Votre enseignant pourra consulter ses modifications futures. Les autres dossiers restent privés.')){\n      let saved=true;\n      if(!currentId)saved=await saveDossier();\n      if(saved&&currentId){\n       const assoc=await egeSupabaseClient.from('ege2027_group_submissions').insert({group_id:groupId,dossier_id:currentId,student_id:egeCloudUser.id});\n       if(assoc.error&&assoc.error.code!=='23505')result.textContent+=' Association du dossier non enregistrée : '+assoc.error.message;\n       else {result.textContent+=' Votre dossier est associé au groupe et visible par votre professeur.';await window.MBDialog.notice('Dossier associé','Votre professeur peut désormais consulter votre dossier et ses prochaines modifications.','success');}\n      }else result.textContent+=' Le dossier n’a pas été associé. Réessayez depuis « Mes groupes ».';\n    }else result.textContent+=' Pour que votre professeur voie votre travail, associez un dossier dans « Mes groupes ».';\n   code.value='';cloudMsg('Groupe rejoint avec succès.');\n  }catch(err){result.textContent='Inscription impossible : '+(err?.message||String(err))}\n  finally{submit.disabled=false}\n });\n}\n\nfunction init(){\n buildPhase1UI();\n installGroupJoinUI();\n id('egeDossierClose')?.addEventListener('click',()=>dialog(false));\n id('egeDossierOverlay')?.addEventListener('click',e=>{if(e.target===id('egeDossierOverlay'))dialog(false)});\n id('egeDossierNew')?.addEventListener('click',newDossier);\n id('egeDossierRefresh')?.addEventListener('click',openDossiers);\n id('egeDossierSearch')?.addEventListener('input',renderList);\n id('egeShowArchived')?.addEventListener('change',e=>{showArchived=e.target.checked;renderList()});\n id('egeVersionsClose')?.addEventListener('click',()=>id('egeDossierVersionsPanel').hidden=true);\n id('egeCloudForgot')?.addEventListener('click',forgotPassword);\n id('egeRecoveryForm')?.addEventListener('submit',updatePassword);\n id('egeRecoveryDismiss')?.addEventListener('click',()=>id('egeRecoveryOverlay').hidden=true);\n id('egeCloudPasswordEye')?.addEventListener('click',()=>{\n  const inp=id('egeCloudPassword'),btn=id('egeCloudPasswordEye');if(!inp||!btn)return;\n  const shown=inp.type==='password';inp.type=shown?'text':'password';btn.textContent=shown?'Masquer':'Voir';btn.setAttribute('aria-pressed',String(shown));\n });\n id('egeCloudOpenDossiers')?.addEventListener('click',openDossiers);\n id('egeDossierCurrentLink')?.addEventListener('click',openDossiers);\n id('egeDossierImport')?.addEventListener('click',()=>{dialog(false);id('importFile')?.click()});\n id('egeDossierSaveLocal')?.addEventListener('click',()=>backup());\n if(typeof egeCloudUser!=='undefined')onAuthChanged(egeCloudUser);\n if(location.hash.includes('type=recovery')||new URLSearchParams(location.search).get('type')==='recovery'){\n  setTimeout(()=>{if(typeof egeCloudUser!=='undefined'&&egeCloudUser)showRecovery()},600);\n }\n}\nfunction detachCurrent(){currentId=null;currentTitle='';currentRevision=null;lastSyncedJson='';autoCreate=false;conflict=false;clearTimeout(syncTimer);store();notifyCurrent()}\nwindow.addEventListener('online',scheduleSync);\nwindow.EGE2027Phase1={getCurrentId:()=>currentId,init,onAuthChanged,saveDossier,scheduleSync,openDossiers,showReviews,showRecovery,detachCurrent};\ndocument.addEventListener('DOMContentLoaded',init);\n})();\n"],"/ad-learning.svg":["image/svg+xml",false,"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 260 180\" role=\"img\" aria-label=\"Livres et diplôme\">\n<defs><linearGradient id=\"paper\" x2=\"0\" y2=\"1\"><stop stop-color=\"#fff\"/><stop offset=\"1\" stop-color=\"#fff8f5\"/></linearGradient><linearGradient id=\"crimson\"><stop stop-color=\"#e52642\"/><stop offset=\"1\" stop-color=\"#a9001a\"/></linearGradient></defs>\n<ellipse cx=\"127\" cy=\"153\" rx=\"105\" ry=\"13\" fill=\"#71152c\" opacity=\".09\"/>\n<g transform=\"translate(25 89) rotate(-7 92 40)\"><rect x=\"8\" y=\"39\" width=\"199\" height=\"25\" rx=\"6\" fill=\"#163960\"/><rect x=\"21\" y=\"43\" width=\"166\" height=\"17\" rx=\"3\" fill=\"url(#paper)\"/><rect x=\"8\" y=\"37\" width=\"200\" height=\"6\" rx=\"3\" fill=\"#316399\"/><path d=\"M19 61h175\" stroke=\"#a3b2c4\" stroke-width=\"1\"/></g>\n<g transform=\"translate(27 52) rotate(5 94 40)\"><rect x=\"3\" y=\"66\" width=\"195\" height=\"26\" rx=\"6\" fill=\"#d82840\"/><rect x=\"15\" y=\"70\" width=\"166\" height=\"17\" rx=\"4\" fill=\"url(#paper)\"/><path d=\"M15 85h167\" stroke=\"#e8d7d7\"/><rect x=\"3\" y=\"64\" width=\"196\" height=\"7\" rx=\"3\" fill=\"#ac0822\"/></g>\n<g transform=\"translate(49 44) rotate(-4 81 40)\"><rect x=\"8\" y=\"36\" width=\"164\" height=\"29\" rx=\"5\" fill=\"#e7a62b\"/><rect x=\"21\" y=\"41\" width=\"137\" height=\"18\" rx=\"3\" fill=\"url(#paper)\"/><rect x=\"8\" y=\"36\" width=\"164\" height=\"7\" rx=\"4\" fill=\"#bf7520\"/></g>\n<g transform=\"translate(44 -3)\"><path d=\"M20 66 112 25 211 66 112 111Z\" fill=\"#222b48\"/><path d=\"M45 85v26c48 37 109 37 139-1V84l-72 33Z\" fill=\"#303b5c\"/><path d=\"M211 66v51\" stroke=\"#e5a936\" stroke-width=\"4\" stroke-linecap=\"round\"/><circle cx=\"211\" cy=\"121\" r=\"8\" fill=\"#e5a936\"/><path d=\"M210 124c-2 7-5 18-5 24h15c0-8-4-19-6-24Z\" fill=\"#e5a936\"/></g>\n</svg>"],"/ege-header-soutenance-v1.webp":["image/webp",true,""],"/ege-account.js":["application/javascript; charset=utf-8",false,"/* Fonctions communes aux profils et à la relecture personnelle des étapes. */\n(()=>{'use strict';\nconst adminWhatsApp='25377441633';\nfunction whatsapp(value,required=true){let n=String(value||'').replace(/[+().\\s-]/g,'');if(n.startsWith('00'))n=n.slice(2);if(!n&&!required)return '';if(/^\\d{8}$/.test(n))n='253'+n;if(!/^[1-9][0-9]{7,14}$/.test(n))throw Error('Indiquez votre numéro WhatsApp avec l’indicatif pays, par exemple +253 77 12 34 56.');return n}\nfunction blocked(p){return !!p&&(p.account_status!=='active'||!!p.deleted_at)}\nfunction incomplete(p,role='eleve'){return !p||String(p.full_name||'').trim().length<2||(role==='eleve'&&(!p.whatsapp_number||!EGEAcademic.classes[p.series]?.includes(p.class_name)||!p.school))}\nasync function current(db){const {data,error}=await db.rpc('ege2027_profile_current');if(error)throw error;return data}\nfunction userWithProfile(user,p){return {...user,email:p.auth_method==='phone_password'?'':user?.email,user_metadata:{...user?.user_metadata,full_name:p.full_name,whatsapp_number:p.whatsapp_number,series:p.series,class_name:p.class_name,school:p.school}}}\nfunction contact(message='Bonjour, j’ai besoin d’aide pour EGE 2027.'){return 'https://wa.me/'+adminWhatsApp+'?text='+encodeURIComponent(message)}\nfunction authMessage(error){const text=String(error?.message||error||'');if(/email.*not.*confirmed/i.test(text))return 'Confirmez votre e-mail avant de vous connecter. Vous pouvez renvoyer le lien ci-dessous.';if(/invalid.*credentials/i.test(text))return 'Adresse e-mail ou mot de passe incorrect.';if(/rate|too many|seconds|429/i.test(text))return 'Patientez quelques instants avant de demander un nouvel e-mail.';if(/expired|invalid.*(token|link)|otp/i.test(text))return 'Ce lien est invalide ou expiré. Demandez un nouvel e-mail de confirmation.';return text||'Cette opération n’a pas abouti. Réessayez.'}\nwindow.EGEAccount={adminWhatsApp,whatsapp,blocked,incomplete,current,userWithProfile,contact,authMessage};\nconst clean=value=>String(value??'').trim();\nfunction stable(v){if(Array.isArray(v))return v.map(stable);if(v&&typeof v==='object')return Object.fromEntries(Object.keys(v).sort().map(k=>[k,stable(v[k])]));return v}\nfunction fingerprint(value){let n=2166136261;for(const c of JSON.stringify(stable(value))){n^=c.codePointAt(0);n=Math.imul(n,16777619)}return (n>>>0).toString(16)}\nfunction snapshot(key,p){\n const t=EGETerrain.normalize(p.terrain,p),annex=/^annex_(\\d)$/.exec(key);\n if(annex){const n=annex[1];return {title:p.annexTitles?.[n],body:p.annexes?.[n],source:p.sources?.[n],checked:p.sourceChecks?.[n]}}\n if(key==='identity')return {mode:p.mode,series:EGEAcademic.seriesOf(p),student:p.student,partner:p.partner,className:p.className,school:p.school,teacher:p.teacher};\n if(key==='subject')return {series:EGEAcademic.seriesOf(p),theme:p.theme,subtheme:p.subtheme};\n if(key==='problem')return {theme:p.theme,subtheme:p.subtheme,problem:p.problem};\n if(key==='terrain_enterprise')return Object.fromEntries(['organizationName','legalForm','creationDate','address','employees','turnover','activities','scope','history','visionStrategy','organizationSource','organizationChartText','logo','organizationChart'].map(k=>[k,t[k]]));\n if(key==='terrain_professional')return Object.fromEntries(['professionalName','professionalRole','interviewStatus','interviewDate','interviewMethod','interviewDifficulties'].map(k=>[k,t[k]]));\n if(key==='terrain_interview')return t.questions;\n if(key==='terrain_comparison')return {source:EGETerrain.comparisonSignature(p),rows:t.comparisons,similarities:t.similarities,differences:t.differences};\n if(key==='terrain_synthesis')return {source:EGETerrain.synthesisSignature(p),text:t.synthesis};\n if(key.startsWith('legacy_')){const field=key.slice(7);if(['theme','subtheme'].includes(field))return {series:p.series,theme:p.theme,subtheme:p.subtheme};if(/^annex\\d$/.test(field))return snapshot('annex_'+field.slice(-1),p);if(field==='finish')return {identity:snapshot('identity',p),subject:snapshot('subject',p),problem:p.problem,annexes:p.annexes,sourceChecks:p.sourceChecks,terrain:t};return {[field]:p[field]}}\n return {};\n}\nfunction check(key,p){\n const t=EGETerrain.normalize(p.terrain,p),annex=/^annex_(\\d)$/.exec(key);\n if(annex){const n=annex[1],words=clean(p.annexes?.[n]).split(/\\s+/).filter(Boolean).length;if(words<75||words>720)return 'L’annexe doit contenir entre 75 et 720 mots.';if(!/(?:^|\\s)https:\\/\\/[^\\s<>\"']+\\.[^\\s<>\"']+/i.test(clean(p.sources?.[n]))||!p.sourceChecks?.[n])return 'Renseignez un lien web HTTPS et confirmez que vous l’avez consulté.';return ''}\n if(key==='identity'){if(!['individuel','binome'].includes(p.mode)||!clean(p.student)||!clean(p.className)||!clean(p.school)||(!clean(p.teacher)&&p.className!=='Candidat libre')||(p.mode==='binome'&&!clean(p.partner)))return 'Complétez l’identité, la classe, l’établissement et le professeur.';return ''}\n if(key==='subject'){if(!Number.isInteger(p.theme)||!Number.isInteger(p.subtheme))return 'Choisissez le thème et le sous-thème de votre série.';return ''}\n if(key==='problem'){const count=clean(p.problem).split(/\\s+/).filter(Boolean).length;return count<1?'Renseignez votre problématique.':''}\n if(key==='terrain_enterprise')return !t.organizationName.trim()||!t.history.trim()||!t.activities.trim()||!t.organizationSource.trim()?'Complétez le nom, l’historique, l’activité et les sources des informations de l’entreprise.':'';\n if(key==='terrain_professional')return !t.professionalName.trim()||!t.professionalRole.trim()||t.interviewStatus!=='done'?'Renseignez le professionnel et indiquez si l’entretien a été réalisé.':EGETerrain.interviewIssues(t)[0]||'';\n if(key==='terrain_interview')return !t.questions.some(q=>q.question.trim()&&q.answer.trim())||t.questions.some(q=>!!q.question.trim()!==!!q.answer.trim())?'Saisissez une question et sa réponse pour chaque ligne utilisée.':'';\n if(key==='terrain_comparison')return !t.comparisons.some(r=>r.theory.trim()&&r.practice.trim())?'Préparez et relisez le tableau comparatif.':'';\n if(key==='terrain_synthesis')return !t.synthesis.trim()?'Préparez et complétez la synthèse.':'';\n if(key.startsWith('legacy_')){const field=key.slice(7);if(field==='teacher'&&p.className==='Candidat libre')return '';if(/^annex\\d$/.test(field))return check('annex_'+field.slice(-1),p);if(['theme','subtheme'].includes(field))return field==='theme'&&Number.isInteger(p.theme)?'':check('subject',p);if(field==='problem')return check('problem',p);if(field==='series')return EGEAcademic.series.includes(p.series)?'':'Choisissez une série.';if(field==='mode')return ['individuel','binome'].includes(p.mode)?'':'Choisissez le mode de travail.';if(field==='candidates')return '';if(field==='finish')return check('identity',p)||check('subject',p)||check('problem',p);return clean(p[field])?'':'Complétez cette étape avant de la valider.'}\n return '';\n}\nfunction status(key,p){const r=p.validations?.[key];return r?.status==='validated'&&r.fingerprint===fingerprint(snapshot(key,p))?'validated':r?'correction':'pending'}\nfunction mark(key,p,action='validate'){\n if(!p.validations||typeof p.validations!=='object'||Array.isArray(p.validations))p.validations={};\n if(action==='validate'){const error=check(key,p);if(error)throw Error(error);if(key==='terrain_comparison'){p.terrain=EGETerrain.normalize(p.terrain,p);p.terrain.comparisonReviewed=true;p.terrain.comparisonSignature=EGETerrain.comparisonSignature(p)}if(key==='terrain_synthesis'){p.terrain=EGETerrain.normalize(p.terrain,p);p.terrain.synthesisReviewed=true;p.terrain.synthesisSignature=EGETerrain.synthesisSignature(p)}}\n else if(key==='terrain_comparison'&&p.terrain)p.terrain.comparisonReviewed=false;else if(key==='terrain_synthesis'&&p.terrain)p.terrain.synthesisReviewed=false;\n p.validations[key]={status:action==='validate'?'validated':'correction',fingerprint:fingerprint(snapshot(key,p)),updated_at:new Date().toISOString()};return p;\n}\nwindow.EGEStage={snapshot,check,status,mark,fingerprint};\n})();\n\n/* Images personnelles : réencodage JPEG, suppression des métadonnées et stockage privé. */\n(()=>{'use strict';\nconst BUCKET='ege2027-profils-prives',cache=new Map(),inflight=new Map();\nfunction uuid(){if(crypto.randomUUID)return crypto.randomUUID();const b=crypto.getRandomValues(new Uint8Array(16));b[6]=(b[6]&15)|64;b[8]=(b[8]&63)|128;return [...b].map((v,i)=>([4,6,8,10].includes(i)?'-':'')+v.toString(16).padStart(2,'0')).join('')}\nfunction check(file){if(!file?.size)throw Error('Cette photo est vide ou illisible. Choisissez une autre photo.');if(file.size>20*1024*1024)throw Error('Choisissez une photo de 20 Mo maximum.');if(file.type&&!['image/jpeg','image/jpg','image/pjpeg','image/png','image/webp','application/octet-stream',''].includes(file.type))throw Error('Choisissez une photo JPG, PNG ou WebP. Pour une photo HEIC, enregistrez d’abord une copie en JPG.');}\nasync function jpeg(file,{size=640,square=true,max=1024*1024}={}){\n check(file);const bytes=new Uint8Array(await file.slice(0,16).arrayBuffer());const valid=(bytes[0]===255&&bytes[1]===216&&bytes[2]===255)||(bytes[0]===137&&bytes[1]===80&&bytes[2]===78&&bytes[3]===71)||(String.fromCharCode(...bytes.slice(0,4))==='RIFF'&&String.fromCharCode(...bytes.slice(8,12))==='WEBP');if(!valid)throw Error('Le fichier doit être une vraie photo JPG, PNG ou WebP.');\n const local=URL.createObjectURL(file);try{const img=await new Promise((resolve,reject)=>{const image=new Image();image.onload=()=>resolve(image);image.onerror=()=>reject(Error('Photo impossible à ouvrir. Essayez une autre photo ou une copie en JPG.'));image.src=local});const w=img.naturalWidth,h=img.naturalHeight;if(!w||!h)throw Error('Cette photo ne contient pas d’image lisible.');const canvas=document.createElement('canvas');const ratio=Math.min(1,size/Math.max(w,h));canvas.width=square?Math.min(size,w,h):Math.max(1,Math.round(w*ratio));canvas.height=square?canvas.width:Math.max(1,Math.round(h*ratio));const ctx=canvas.getContext('2d');if(!ctx)throw Error('Ce navigateur ne peut pas préparer la photo.');ctx.fillStyle='#ffffff';ctx.fillRect(0,0,canvas.width,canvas.height);if(square){const side=Math.min(w,h);ctx.drawImage(img,(w-side)/2,(h-side)/2,side,side,0,0,canvas.width,canvas.height)}else ctx.drawImage(img,0,0,canvas.width,canvas.height);let blob;for(const quality of [.86,.7,.55]){blob=await new Promise((resolve,reject)=>canvas.toBlob(b=>b?resolve(b):reject(Error('La préparation de la photo a échoué.')),'image/jpeg',quality));if(blob.size<=max)return blob}throw Error('La photo reste trop volumineuse. Choisissez une image plus petite.');}finally{URL.revokeObjectURL(local)}\n}\nasync function signed(db,path){if(inflight.has(path))return inflight.get(path);const promise=signedOnce(db,path);inflight.set(path,promise);try{return await promise}finally{inflight.delete(path)}}\nasync function signedOnce(db,path){if(!db||!path)return '';if(!/^[0-9a-f-]{36}\\/[0-9a-f-]{36}[.]jpg$/.test(path))return '';if(!navigator.onLine)return '';const hit=cache.get(path);if(hit?.expires>Date.now())return hit.url;const r=await db.storage.from(BUCKET).createSignedUrl(path,120);if(r.error)throw Error('Photo de profil momentanément indisponible.');const url=r.data?.signedUrl;if(!url)return '';cache.set(path,{url,expires:Date.now()+90000});return url}\nfunction clear(){cache.clear()}\nasync function save(db,userId,file){const body=await jpeg(file),path=userId+'/'+uuid()+'.jpg';const r=await db.storage.from(BUCKET).upload(path,body,{contentType:'image/jpeg',cacheControl:'120',upsert:false});if(r.error)throw Error('Importation de la photo : '+r.error.message);try{const saved=await db.rpc('ege2027_profile_avatar',{p_path:path});if(saved.error)throw saved.error;clear();const old=saved.data.previous_path;if(old&&old!==path)await db.storage.from(BUCKET).remove([old]).catch(()=>{});return saved.data.profile;}catch(e){await db.storage.from(BUCKET).remove([path]).catch(()=>{});throw e}}\nasync function remove(db){const r=await db.rpc('ege2027_profile_avatar',{p_path:null});if(r.error)throw r.error;clear();if(r.data.previous_path)await db.storage.from(BUCKET).remove([r.data.previous_path]).catch(()=>{});return r.data.profile}\nEGEAccount.photo={BUCKET,uuid,check,jpeg,signed,clear,save,remove};\n})();\n"],"/ege-academic.js":["application/javascript; charset=utf-8",false,"/* Référentiel scolaire partagé. Les thèmes OGRH sont transcrits du document validé du 03/11/2026. */\n(()=>{'use strict';\nconst config={\"classes\":{\"GFM\":[\"TGFM1\",\"TGFM2\",\"TGFM3\",\"TGFM4\",\"TGFM5\",\"TGFM6\",\"TGFM7\",\"TGFM8\"],\"OGRH\":[\"TOGRH1\",\"TOGRH2\",\"TOGRH3\",\"TOGRH4\",\"TOGRH5\"],\"IAG\":[\"TIAG1\",\"TIAG2\",\"TIAG3\"]},\"schools\":[\"LYCÉE D'ÉTAT DE DJIBOUTI\",\"LYCÉE AHMED FARAH\",\"LYCÉE DJAMA MAITRE\",\"LYCÉE HODAN 4\",\"LYCEE PK12\",\"LYCEE ARTA\",\"LYCÉE ALI-SABIEH\",\"LYCÉE DIKHIL\",\"LYCÉE TADJOURAH\",\"LYCÉE OBOCK\",\"LYCÉE PRIVÉ GUELLEH BATAL\",\"LYCÉE PRIVÉ ILEYS\",\"LYCÉE PRIVÉ LUMIÈRES\",\"LYCÉE PRIVÉ MANDELA\",\"LYCÉE PRIVÉ VICTOIRE\",\"LYCÉE PRIVÉ EPSO\",\"LYCÉE PRIVÉ INTERNATIONAL\",\"AUTRES\"],\"ogrh\":[{\"title\":\"L’IA et les nouvelles formes d’emploi\",\"subthemes\":[\"L'IA et la transformation du marché du travail\",\"Les plateformes numériques et le travail indépendant\",\"L'IA, la motivation des salariés et le changement organisationnel\",\"L'IA et l'insertion professionnelle des jeunes\",\"L'utilisation de l'IA dans les décisions de gestion des ressources humaines\",\"Le dialogue social face aux transformations des emplois causées par l’intelligence artificielle\",\"L'impact de l'IA sur la gestion des carrières et la mobilité professionnelle des salariés\",\"L'utilisation de l'IA dans l'évaluation de la performance et le suivi des salariés\",\"L'intelligence artificielle dans les activités professionnelles (aspects éthiques et déontologiques)\",\"Les opportunités et les défis de l'utilisation de l'IA dans les organisations et les emplois\",\"L'adaptation des emplois à l'intelligence artificielle\"]},{\"title\":\"La cybersécurité et la protection des données dans les organisations\",\"subthemes\":[\"Les enjeux de la cybersécurité dans les organisations\",\"La formation du personnel sur la cybersécurité\",\"La sécurité informatique au sein des organisations\",\"La gestion de crise et la sécurité des données\",\"La protection des données personnelles et professionnelles dans les organisations\",\"Les règles juridiques et les obligations des organisations en matière de protection des données\",\"La souveraineté numérique et la protection des données\",\"Le télétravail et la sécurité des données\",\"La gestion sécurisée des accès aux informations et aux données sensibles\",\"Le phishing (courriers électroniques frauduleux) et la sensibilisation des employés\",\"Les réseaux sociaux et la protection des données personnelles\",\"Les outils de protection et de sécurisation des données numériques\"]},{\"title\":\"Les compétences du XXIᵉ siècle en milieu professionnel\",\"subthemes\":[\"L'autonomie et l'efficacité professionnelle dans un environnement numérique.\",\"L'adaptation des salariés aux évolutions technologiques et organisationnelles.\",\"Le développement des compétences professionnelles grâce à la gestion prévisionnelle des emplois et des compétences (GPEC).\",\"La collaboration et le travail en équipe dans les organisations modernes.\",\"Le leadership bienveillant et la gestion des équipes au XXIᵉ siècle.\",\"La diversité et les compétences interculturelles dans les organisations.\",\"L'esprit d'initiative et la résolution des problèmes en milieu professionnel.\",\"La veille professionnelle et l'apprentissage continu face à l'évolution des métiers.\",\"L'éthique et la responsabilité dans l'utilisation des technologies numériques.\",\"La gestion du stress comme compétence professionnelle.\"]},{\"title\":\"L’identité numérique et la marque employeur dans les organisations\",\"subthemes\":[\"La construction et la gestion de l'identité numérique de l'organisation\",\"L'influence de l'identité numérique sur l'image et la réputation de l'organisation\",\"Les réseaux sociaux au service de la marque employeur et de l'attractivité\",\"La communication numérique au service des talents\",\"La communication en ligne et la culture organisationnelle\",\"Les réseaux professionnels dans la stratégie de recrutement (sourcing)\",\"Le marketing des ressources humaines au service de la marque employeur\",\"L'expérience collaborateur et son influence sur la réputation de l’organisation\",\"La fidélisation des salariés et des talents grâce à une marque employeur\",\"Le rôle des salariés comme ambassadeurs de leur organisation\",\"Les impacts des commentaires en ligne sur la marque employeur\",\"La Responsabilité Sociétale des Organisations (RSO) comme composante de la marque employeur\",\"La gestion des crises et la protection de l’e-réputation\",\"L'influence de la marque employeur sur la performance globale de l'organisation\"]},{\"title\":\"Les environnements de travail et la performance organisationnelle\",\"subthemes\":[\"L’aménagement des espaces de travail (open space, flex office) et la productivité\",\"L’impact du climat professionnel sur la performance (bruit, éclairage, température, bien-être des salariés)\",\"Les espaces collaboratifs, la communication et l’innovation dans les organisations\",\"Les pratiques écologiques dans les espaces de travail et la performance durable (RSE)\",\"La transformation digitale et l’efficacité au travail\",\"Le télétravail et la performance organisationnelle\",\"Le climat social et la performance économique des organisations\",\"Santé et sécurité au travail : un enjeu de performance\",\"Risques psychosociaux, stress et charge de travail : impact sur la productivité\",\"La relation entre l'environnement de travail et la motivation du personnel\",\"Le management, un levier de performance\",\"Les coûts liés à l’organisation des environnements de travail\",\"L’évaluation de l’impact de l'environnement de travail sur la performance\"]},{\"title\":\"L’accessibilité et l’inclusion professionnelle dans les organisations\",\"subthemes\":[\"L’égalité des chances et la prévention des discriminations au recrutement\",\"L’inclusion professionnelle des personnes en situation de handicap\",\"L’accès au numérique, à l’information et à l’intelligence artificielle\",\"L’accès des femmes aux postes de responsabilité\",\"La gestion des équipes et la diversité culturelle\",\"L’intégration des jeunes diplômés et le maintien en emploi des seniors\",\"Le rôle des managers dans la promotion de la diversité et de l’inclusion\",\"Les effets de l’inclusion sur la performance et le climat social de l’organisation\",\"Le cadre juridique et les pratiques d’inclusion professionnelle à Djibouti\"]}]};\n// Les classes historiques sont conservées ; les niveaux génériques évitent d'inventer des divisions.\nfor(const s of ['GFM','OGRH','IAG','S','ES','L']){\n config.classes[s] ||= [];\n config.classes[s].push('Première '+s,'Terminale '+s);\n}\nconst series=Object.keys(config.classes);\nconst officialClasses=Object.fromEntries(series.map(s=>[s,[...config.classes[s]]]));\nfor(const s of series)config.classes[s].push('Candidat libre');\nconst escape=value=>String(value??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction seriesOf(payload){\n if(series.includes(payload?.series))return payload.series;\n const inferred=/^T(GFM|OGRH|IAG)\\s*\\d+$/i.exec(String(payload?.className||payload?.class_name||'').trim());\n return inferred?inferred[1].toUpperCase():'GFM';\n}\nfunction options(values,selected='',placeholder='Choisir',preserve=false){\n const list=[...values];\n if(preserve&&selected&&!list.includes(selected))list.unshift(selected);\n return '<option value=\"\">'+escape(placeholder)+'</option>'+list.map(value=>'<option value=\"'+escape(value)+'\"'+(value===selected?' selected':'')+'>'+escape(value)+'</option>').join('');\n}\nfunction catalogFor(payload,gfm){\n const value=seriesOf(payload);\n return value==='GFM'?gfm:value==='OGRH'?config.ogrh:[];\n}\nconst legacyOGRH=config.ogrh.map(theme=>({title:theme.title,general:[],subthemes:theme.subthemes.map(name=>({name,questions:[],notes:[],short_explanation:'Sous-thème officiel OGRH · 2026–2027'}))}));\nfunction legacyCatalog(payload,gfm){const value=seriesOf(payload);return value==='GFM'?gfm:value==='OGRH'?legacyOGRH:[];}\nfunction allClassOptions(selected=''){\n return '<option value=\"\">Choisir une classe</option>'+series.map(value=>'<optgroup label=\"'+value+'\">'+officialClasses[value].map(name=>'<option value=\"'+name+'\"'+(selected===name?' selected':'')+'>'+name+'</option>').join('')+'</optgroup>').join('')+'<option value=\"Candidat libre\"'+(selected==='Candidat libre'?' selected':'')+'>Candidat libre</option>';\n}\nwindow.EGEAcademic=Object.freeze({series,officialClasses,classes:config.classes,schools:config.schools,ogrh:config.ogrh,seriesOf,options,catalogFor,legacyCatalog,allClassOptions});\n})();\n"],"/ege-terrain.js":["application/javascript; charset=utf-8",false,"/* Partie terrain, d'après la structure du modèle « ege Nassima brouillon ».\n   Les faits et réponses proviennent de l'élève. Les propositions restent à relire. */\n(()=>{'use strict';\nconst EGE_INTRO_QUESTION=\"Quelle est l'activité principale de votre entreprise ?\";\nfunction egeIntroQuestion(q){const s=String(q?.question||q||'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().replace(/[’']/g,' ').replace(/[^\\p{L}\\p{N} ]/gu,' ').replace(/\\s+/g,' ').trim();return s==='quelle est l activite principale de votre entreprise'}\nconst BUCKET='ege2027-terrain-prive';\nconst fields={\n organizationName:['Dénomination de l’entreprise',180],legalForm:['Forme juridique',180],creationDate:['Date de création',80],address:['Siège social / adresse',300],employees:['Effectif et période de référence',180],turnover:['Chiffre d’affaires, période et unité (si communiqué)',180],activities:['Domaine d’activité',2000],scope:['Champ d’action',300],history:['Historique de l’entreprise',6000],visionStrategy:['Vision, stratégie et positionnement',5000],organizationSource:['Sources des informations sur l’entreprise',1500],organizationChartText:['Description de l’organigramme',4000],professionalName:['Nom et prénom du professionnel',180],professionalRole:['Fonction du professionnel',180],interviewDate:['Date de l’entretien',10],interviewMethod:['Moyens utilisés',180],interviewDifficulties:['Difficultés rencontrées / limites de l’entretien',2000],similarities:['Similitudes constatées',5000],differences:['Différences constatées',5000],synthesis:['Synthèse rédigée',24000]\n};\nconst str=(value,max=4000)=>typeof value==='string'?value.replace(/[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]/g,'').slice(0,max):'';\nconst esc=value=>String(value??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst pathOK=value=>/^[0-9a-f-]{36}\\/[0-9a-f-]{36}\\/[0-9a-f-]{36}\\.jpg$/i.test(value||'');\nfunction empty(payload={}){\n const t={version:1,interviewStatus:'planned',questions:[{question:EGE_INTRO_QUESTION,answer:'',annex:0}],comparisons:[],comparisonSignature:'',synthesisSignature:'',comparisonReviewed:false,synthesisReviewed:false,logo:null,organizationChart:null};\n for(const key of Object.keys(fields))t[key]='';\n t.organizationName=str(payload.company,180);return t;\n}\nfunction normalize(value,payload={}){\n const t=empty(payload),v=value&&typeof value==='object'&&!Array.isArray(value)?value:{};\n for(const [key,[,max]] of Object.entries(fields))if(typeof v[key]==='string')t[key]=str(v[key],max);\n t.interviewStatus=v.interviewStatus==='done'?'done':'planned';\n if(Array.isArray(v.questions))t.questions=v.questions.slice(0,20).map(q=>({question:str(q?.question,1200),answer:str(q?.answer,6000),annex:[1,2,3,4].includes(Number(q?.annex))?Number(q.annex):0}));\n if(!t.questions.length||t.questions.length===1&&!t.questions[0].question.trim()&&!t.questions[0].answer.trim())t.questions=[{question:EGE_INTRO_QUESTION,answer:'',annex:0}];\n t.comparisons=Array.isArray(v.comparisons)?v.comparisons.slice(0,4).map((r,i)=>({annex:i+1,theory:str(r?.theory,6000),practice:str(r?.practice,12000)})):[];\n for(const key of ['comparisonSignature','synthesisSignature'])t[key]=str(v[key],80);\n for(const key of ['comparisonReviewed','synthesisReviewed'])t[key]=v[key]===true;\n for(const key of ['logo','organizationChart']){\n  const asset=v[key];if(asset&&pathOK(asset.path))t[key]={path:asset.path,width:Math.max(1,Math.min(4000,Number(asset.width)||1000)),height:Math.max(1,Math.min(4000,Number(asset.height)||1000))};\n }\n return t;\n}\nfunction hash(value){let n=2166136261;for(const c of JSON.stringify(value)){n^=c.codePointAt(0);n=Math.imul(n,16777619)}return (n>>>0).toString(16)}\nfunction comparisonSignature(payload){const t=normalize(payload.terrain,payload);return hash({mode:payload.mode,annexes:payload.annexes,annexTitles:payload.annexTitles,questions:t.questions})}\nfunction synthesisSignature(payload){const t=normalize(payload.terrain,payload);const input={...t};for(const k of ['synthesis','comparisonSignature','synthesisSignature','comparisonReviewed','synthesisReviewed'])delete input[k];return hash({series:payload.series,problem:payload.problem,theme:payload.theme,subtheme:payload.subtheme,annexes:payload.annexes,input})}\nconst short=(text,max=800)=>{const value=str(text,30000).trim().replace(/\\s+/g,' ');if(value.length<=max)return value;const end=value.slice(0,max).lastIndexOf(' ');return value.slice(0,end>0?end:max)+'…'};\nconst stop=new Set('avec dans pour cette cet ces des les une aux sur que qui quoi comment pourquoi quelle quelles quels quel entreprise organisation professionnel gestion elle est sont ont par plus peut leur leurs nous vous notre votre ainsi aussi cela doit comme mais entre tout tous toute toutes être avoir selon faire afin'.split(' '));\nfunction tokens(text){return new Set(str(text,40000).normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().match(/[a-z]{4,}/g)?.filter(w=>!stop.has(w))||[])}\nfunction prepareComparison(payload){\n const t=normalize(payload.terrain,payload),count=payload.mode==='binome'?4:3;\n const annexes=Array.from({length:count},(_,i)=>tokens((payload.annexTitles?.[i+1]||'')+' '+(payload.annexes?.[i+1]||'')));\n const matches=t.questions.map(q=>{\n  if(egeIntroQuestion(q))return 0;\n  if(q.annex>=1&&q.annex<=count)return q.annex;\n  if(!q.question.trim()||!q.answer.trim())return 0;\n  const words=tokens(q.question+' '+q.answer),scores=annexes.map(a=>[...words].filter(w=>a.has(w)).length),best=Math.max(...scores);\n  return best>=2&&scores.filter(n=>n===best).length===1?scores.indexOf(best)+1:0;\n });\n t.comparisons=Array.from({length:count},(_,i)=>({annex:i+1,theory:short(payload.annexes?.[i+1]||'',1100),practice:t.questions.map((q,n)=>matches[n]===i+1&&q.question.trim()&&q.answer.trim()?`Question ${n+1} : ${q.question.trim()}\\nRéponse du professionnel : ${q.answer.trim()}`:'').filter(Boolean).join('\\n\\n').slice(0,12000)}));\n t.comparisonSignature=comparisonSignature({...payload,terrain:t});t.comparisonReviewed=false;t.synthesisReviewed=false;\n return {terrain:t,unmatched:t.questions.map((q,i)=>q.answer.trim()&&!egeIntroQuestion(q)&&!matches[i]?i+1:null).filter(Boolean)};\n}\nfunction interviewIssues(t){\n const errors=[];\n if(t.interviewStatus==='done'){\n  if(!t.organizationName.trim())errors.push('Renseignez la dénomination de l’entreprise.');\n  if(!/^\\d{4}-\\d{2}-\\d{2}$/.test(t.interviewDate)||Number.isNaN(Date.parse(t.interviewDate)))errors.push('Renseignez la date réelle de l’entretien.');\n  else if(t.interviewDate>new Date().toISOString().slice(0,10))errors.push('La date d’un entretien réalisé ne peut pas être future.');\n }\n return errors;\n}\nfunction generateSynthesis(payload,topic=''){\n const t=normalize(payload.terrain,payload),answers=t.questions.filter(q=>q.question.trim()&&q.answer.trim());\n if(t.interviewStatus!=='done')throw Error('Indiquez que l’entretien a été réalisé avant de préparer la synthèse de terrain.');\n const issues=interviewIssues(t);if(issues.length)throw Error(issues[0]);\n if(!t.professionalName.trim()||!t.professionalRole.trim())throw Error('Renseignez le nom et la fonction du professionnel interrogé.');\n if(!answers.length)throw Error('Saisissez au moins une question et sa réponse réelle.');\n if(!t.comparisons.length||t.comparisonSignature!==comparisonSignature(payload))throw Error('Préparez ou actualisez d’abord le tableau comparatif.');\n if(!t.comparisons.some(r=>r.theory.trim()))throw Error('Rédigez vos annexes théoriques avant de préparer la synthèse.');\n const introduction=`Cette étude porte sur « ${topic||'le sous-thème choisi'} ». La problématique retenue est : « ${str(payload.problem,1000)||'à préciser'} ». Elle rapproche la recherche documentaire des informations recueillies auprès de ${t.organizationName}, au cours de l’entretien du ${t.interviewDate}, avec ${t.professionalName}, ${t.professionalRole}.`;\n const theory=t.comparisons.filter(r=>r.theory.trim()).map(r=>`Annexe ${r.annex} — ${short(r.theory,650)}`).join('\\n\\n');\n const practical=t.comparisons.filter(r=>r.practice.trim()).map(r=>`En lien avec l’annexe ${r.annex}, l’entretien apporte les éléments suivants :\\n${short(r.practice,1700)}`).join('\\n\\n')||answers.map((q,i)=>`Question ${i+1} — ${short(q.question,250)}\\nLe professionnel répond : « ${short(q.answer,900)} »`).join('\\n\\n');\n const similarities=t.similarities.trim()?`Similitudes relevées par l’élève :\\n${t.similarities.trim()}`:'Similitudes : à préciser après relecture du tableau comparatif.';\n const differences=t.differences.trim()?`Différences relevées par l’élève :\\n${t.differences.trim()}`:'Différences : à préciser après relecture du tableau comparatif.';\n const limits=t.interviewDifficulties.trim()?`Les limites de l’enquête déclarées par l’élève sont les suivantes : ${t.interviewDifficulties.trim()}`:'Les limites de l’enquête restent à préciser avant la validation finale.';\n t.synthesis=[introduction,'I. RECHERCHE DOCUMENTAIRE',theory,'II. CONTEXTUALISATION SUR LE TERRAIN',practical,similarities,differences,'CONCLUSION',`La confrontation porte sur la problématique « ${str(payload.problem,1000)||'à préciser'} ». Les déclarations du professionnel sont présentées comme des informations recueillies lors de l’entretien ; leur portée doit être appréciée à partir des sources et du contexte de l’entreprise. ${limits} La réponse argumentée définitive à la problématique et la conclusion personnelle sont à finaliser après cette vérification.`].join('\\n\\n').slice(0,24000);\n t.synthesisSignature=synthesisSignature({...payload,terrain:t});t.synthesisReviewed=false;return t;\n}\nfunction progress(payload){const t=normalize(payload.terrain,payload);const complete=[!!(t.organizationName.trim()&&t.history.trim()&&t.activities.trim()),!!(t.professionalName.trim()&&t.professionalRole.trim()&&t.interviewStatus==='done'&&!interviewIssues(t).length),t.questions.some(q=>q.question.trim()&&q.answer.trim()),!!(t.comparisons.some(r=>r.theory.trim()&&r.practice.trim())&&t.comparisonReviewed&&t.comparisonSignature===comparisonSignature(payload)),!!(t.synthesis.trim()&&t.synthesisReviewed&&t.synthesisSignature===synthesisSignature(payload))];return {done:complete.filter(Boolean).length,total:complete.length,complete}}\nasync function uploadImage(file,kind,{db,userId,dossierId}){\n if(!['logo','organizationChart'].includes(kind))throw Error('Type d’illustration incorrect.');\n if(!db||!userId||!dossierId)throw Error('Enregistrez d’abord ce dossier en ligne pour y ajouter une image.');\n if(!['image/jpeg','image/png','image/webp'].includes(file.type)||!file.size)throw Error('Choisissez une image JPG, PNG ou WebP lisible.');\n if(file.size>20*1024*1024)throw Error('Choisissez une image de 20 Mo maximum avant compression.');\n const local=URL.createObjectURL(file);let body,width,height;\n try{\n  const image=await new Promise((resolve,reject)=>{const img=new Image();img.onload=()=>resolve(img);img.onerror=()=>reject(Error('Cette image ne peut pas être ouverte.'));img.src=local});\n  if(!image.naturalWidth||!image.naturalHeight)throw Error('Dimensions de l’image invalides.');\n  const scale=Math.min(1,(kind==='logo'?900:2400)/Math.max(image.naturalWidth,image.naturalHeight));\n  const canvas=document.createElement('canvas');canvas.width=width=Math.max(1,Math.round(image.naturalWidth*scale));canvas.height=height=Math.max(1,Math.round(image.naturalHeight*scale));\n  const ctx=canvas.getContext('2d');if(!ctx)throw Error('Traitement d’image indisponible.');ctx.fillStyle='#ffffff';ctx.fillRect(0,0,width,height);ctx.drawImage(image,0,0,width,height);\n  body=await new Promise((resolve,reject)=>canvas.toBlob(b=>b?resolve(b):reject(Error('Conversion impossible.')),'image/jpeg',.9));\n }finally{URL.revokeObjectURL(local)}\n if(body.size>3*1024*1024)throw Error('L’image reste trop volumineuse. Réduisez sa taille puis réessayez.');\n const path=userId+'/'+dossierId+'/'+crypto.randomUUID()+'.jpg';\n const {error}=await db.storage.from(BUCKET).upload(path,body,{contentType:'image/jpeg',upsert:false,cacheControl:'3600'});\n if(error)throw Error('Importation de l’image : '+error.message);\n return {path,width,height};\n}\nfunction preview(payload){\n const t=normalize(payload.terrain,payload);\n const company=['organizationName','legalForm','creationDate','address','employees','turnover','activities','scope','history','visionStrategy','organizationSource','organizationChartText'];\n const person=['professionalName','professionalRole','interviewDate','interviewMethod','interviewDifficulties'];\n const values=keys=>keys.filter(key=>t[key]).map(key=>`<p><strong>${esc(fields[key][0])}</strong><br><span style=\"white-space:pre-wrap\">${esc(t[key])}</span></p>`).join('');\n const image=(kind,label)=>t[kind]?`<h4>${label}</h4><img data-terrain-imagepath=\"${esc(t[kind].path)}\" alt=\"${label} fourni par l’élève\" style=\"display:block;max-width:100%;max-height:400px;object-fit:contain\">`:'';\n return `<section><h3>Partie terrain</h3><p>${t.interviewStatus==='done'?'Entretien déclaré réalisé':'Entretien à préparer'}</p><h4>Présentation de l’entreprise</h4>${values(company)}${image('logo','Logo')}${image('organizationChart','Organigramme')}<h4>Professionnel interrogé</h4>${values(person)}<h4>Guide d’entretien</h4>${t.questions.filter(q=>q.question||q.answer).map((q,i)=>`<details><summary>Question ${i+1} — ${esc(q.question||'À renseigner')}</summary><p style=\"white-space:pre-wrap\">${esc(q.answer||'Réponse non renseignée')}</p></details>`).join('')}<h4>Tableau comparatif</h4>${t.comparisons.map(r=>`<details><summary>Annexe ${r.annex}</summary><p><strong>Recherche documentaire</strong></p><p style=\"white-space:pre-wrap\">${esc(r.theory)}</p><p><strong>Contextualisation sur le terrain</strong></p><p style=\"white-space:pre-wrap\">${esc(r.practice)}</p></details>`).join('')}${values(['similarities','differences'])}${t.synthesis?`<h4>Synthèse ${t.synthesisReviewed?'relue par l’élève':'à relire'}</h4><p style=\"white-space:pre-wrap\">${esc(t.synthesis)}</p>`:''}</section>`;\n}\nconst xmlText=value=>esc(str(value,30000));\nfunction paragraph(text,{heading=false,page=false}={}){return str(text,40000).split(/\\r?\\n/).map(line=>`<w:p><w:pPr>${page?'<w:pageBreakBefore/>':''}${heading?'<w:keepNext/><w:outlineLvl w:val=\"1\"/>':''}<w:spacing w:after=\"160\" w:line=\"276\" w:lineRule=\"auto\"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Arial\" w:hAnsi=\"Arial\"/>${heading?'<w:b/>':''}<w:sz w:val=\"${heading?26:22}\"/></w:rPr><w:t xml:space=\"preserve\">${xmlText(line)}</w:t></w:r></w:p>`).join('')}\nfunction table(rows,widths){const borders='<w:tblBorders>'+['top','left','bottom','right','insideH','insideV'].map(side=>`<w:${side} w:val=\"single\" w:sz=\"4\" w:color=\"CBD5E1\"/>`).join('')+'</w:tblBorders>';return `<w:tbl><w:tblPr><w:tblW w:w=\"0\" w:type=\"auto\"/>${borders}<w:tblCellMar><w:top w:w=\"90\" w:type=\"dxa\"/><w:left w:w=\"90\" w:type=\"dxa\"/><w:bottom w:w=\"90\" w:type=\"dxa\"/><w:right w:w=\"90\" w:type=\"dxa\"/></w:tblCellMar></w:tblPr><w:tblGrid>${widths.map(w=>`<w:gridCol w:w=\"${w}\"/>`).join('')}</w:tblGrid>${rows.map((row,i)=>`<w:tr>${i===0?'<w:trPr><w:tblHeader/></w:trPr>':''}${row.map((cell,n)=>`<w:tc><w:tcPr><w:tcW w:w=\"${widths[n]}\" w:type=\"dxa\"/>${i===0?'<w:shd w:fill=\"F1F5F9\"/>':''}</w:tcPr>${paragraph(cell||'À renseigner')}</w:tc>`).join('')}</w:tr>`).join('')}</w:tbl>${paragraph('')}`}\nfunction imageXML(asset,label,id){if(!asset)return paragraph(label+' : image à ajouter.');const maxW=label==='Logo'?1.7*914400:5.9*914400,maxH=label==='Logo'?1.7*914400:6.7*914400,scale=Math.min(maxW/asset.width,maxH/asset.height),cx=Math.round(asset.width*scale),cy=Math.round(asset.height*scale);return `<w:p><w:r><w:drawing><wp:inline xmlns:wp=\"http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing\"><wp:extent cx=\"${cx}\" cy=\"${cy}\"/><wp:docPr id=\"${id}\" name=\"${label}\"/><a:graphic xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\"><a:graphicData uri=\"http://schemas.openxmlformats.org/drawingml/2006/picture\"><pic:pic xmlns:pic=\"http://schemas.openxmlformats.org/drawingml/2006/picture\"><pic:nvPicPr><pic:cNvPr id=\"0\" name=\"${label}\"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" r:embed=\"${asset.relationship}\"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x=\"0\" y=\"0\"/><a:ext cx=\"${cx}\" cy=\"${cy}\"/></a:xfrm><a:prstGeom prst=\"rect\"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p>`}\nasync function prepareWordAssets(zip,payload,db){\n const t=normalize(payload.terrain,payload),assets={};\n for(const kind of ['logo','organizationChart'])if(t[kind]){\n  let image=await window.EGEOffline?.image(t[kind].path);\n  if(!image&&db&&navigator.onLine){const result=await db.storage.from(BUCKET).download(t[kind].path);if(!result.error)image=result.data}\n  if(!image)throw Error('Image privée indisponible : préparez les images depuis votre profil ou reconnectez-vous.');\n  const bytes=new Uint8Array(await image.arrayBuffer());if(bytes[0]!==255||bytes[1]!==216)throw Error('Le fichier privé n’est pas une image JPEG valide.');\n  const name='ege-terrain-'+kind+'.jpg',relationship='rIdEgeTerrain'+kind;\n  zip.file('word/media/'+name,bytes);\n  let rels=await zip.file('word/_rels/document.xml.rels').async('string');\n  rels=rels.replace('</Relationships>',`<Relationship Id=\"${relationship}\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/image\" Target=\"media/${name}\"/></Relationships>`);zip.file('word/_rels/document.xml.rels',rels);\n  let content=await zip.file('[Content_Types].xml').async('string');if(!/Extension=\"jpg\"/.test(content))content=content.replace('</Types>','<Default Extension=\"jpg\" ContentType=\"image/jpeg\"/></Types>');zip.file('[Content_Types].xml',content);\n  assets[kind]={...t[kind],relationship};\n }\n return assets;\n}\nfunction applyToWord(xml,payload,assets={}){\n const t=normalize(payload.terrain,payload),issues=interviewIssues(t);if(issues.length)throw Error(issues[0]);\n const matches=[...xml.matchAll(/<w:p\\b[^>]*>[\\s\\S]*?<\\/w:p>/g)],plain=s=>s.replace(/<[^>]*>/g,'').replace(/&apos;/g,\"'\").replace(/&amp;/g,'&').trim();\n const start=matches.find(m=>plain(m[0])===\"PRÉSENTATION DE L'ORGANISATION\"),end=matches.find(m=>plain(m[0])==='ENTREPRISES POTENTIELLES À CONTACTER');\n if(!start||!end||end.index<=start.index)throw Error('La partie terrain du modèle Word n’a pas été reconnue.');\n const get=key=>t[key].trim()||'À renseigner / à vérifier';\n const profileKeys=['organizationName','legalForm','creationDate','address','employees','turnover','activities','scope'];\n let body=paragraph(\"PRÉSENTATION DE L’ENTREPRISE\",{heading:true,page:true})+paragraph(t.interviewStatus==='done'?'Entretien déclaré réalisé le '+t.interviewDate+'. Données à relire et à vérifier.':'PRÉPARATION DU TERRAIN — entretien non encore déclaré réalisé.')+table([['Rubrique','Informations fournies par l’élève'],...profileKeys.map(k=>[fields[k][0],get(k)])],[2700,6300]);\n body+=paragraph('Historique',{heading:true})+paragraph(get('history'))+paragraph('Vision et stratégie',{heading:true})+paragraph(get('visionStrategy'))+paragraph('Sources des informations',{heading:true})+paragraph(get('organizationSource'))+paragraph('Logo',{heading:true})+imageXML(assets.logo,'Logo',9101);\n body+=paragraph('ORGANIGRAMME',{heading:true,page:true})+imageXML(assets.organizationChart,'Organigramme',9102)+paragraph(get('organizationChartText'));\n body+=paragraph(\"GUIDE D’ENTRETIEN\",{heading:true,page:true})+table([['Rubrique','Informations'],['Entreprise',get('organizationName')],['Identité du professionnel',get('professionalName')],['Fonction',get('professionalRole')],['Date de l’entretien',get('interviewDate')],['Moyens utilisés',get('interviewMethod')],['Difficultés / limites',get('interviewDifficulties')]],[2700,6300])+table([['Questions de l’élève','Réponses du professionnel'],...t.questions.filter(q=>q.question||q.answer).map((q,i)=>[(i+1)+'. '+(q.question||'Question à saisir'),q.answer||'Réponse à recueillir après l’entretien'])],[4500,4500]);\n body+=paragraph('TABLEAU COMPARATIF',{heading:true,page:true})+paragraph(t.comparisonReviewed&&t.comparisonSignature===comparisonSignature(payload)?'Tableau relu par l’élève.':'Brouillon à relire. Les rapprochements proposés doivent être vérifiés par l’élève.')+table([['Recherches documentaires (Annexes)','Contextualisation sur le terrain'],...(t.comparisons.length?t.comparisons:Array.from({length:payload.mode==='binome'?4:3},(_,i)=>({annex:i+1,theory:'',practice:''}))).map(r=>['Annexe '+r.annex+'\\n'+(r.theory||'Recherche documentaire à renseigner'),r.practice||'Réponse à rattacher à cette annexe après un entretien réel'])],[4500,4500])+paragraph('SIMILITUDES',{heading:true})+paragraph(get('similarities'))+paragraph('DIFFÉRENCES',{heading:true})+paragraph(get('differences'));\n body+=paragraph('SYNTHÈSE RÉDIGÉE',{heading:true,page:true})+paragraph(t.synthesisReviewed&&t.synthesisSignature===synthesisSignature(payload)?'Synthèse relue par l’élève ; validation pédagogique à effectuer.':'Proposition à relire et à compléter avant validation pédagogique.')+paragraph(t.synthesis||'La synthèse sera préparée à partir des annexes, des informations de l’entreprise et des réponses réelles du professionnel.');\n let result=xml.slice(0,start.index)+body+xml.slice(end.index);\n result=result.replace(/(Présentation de l’organisation|Organigramme|Guide d’entretien|Tableau comparatif|Synthèse rédigée)\\s*\\.+\\s*Page\\s*\\d+/g,'$1 — pagination à vérifier dans Word');\n if(t.interviewStatus==='done')result=result.replace('La visite de terrain n’a pas encore été réalisée.','Un entretien est déclaré réalisé par l’élève ; ses informations doivent être vérifiées.');\n return result;\n}\nasync function writeWordData(zip,payload){\n const t=normalize(payload.terrain,payload);t.logo=null;t.organizationChart=null;\n zip.file('customXml/ege-terrain.xml','<?xml version=\"1.0\" encoding=\"UTF-8\"?><ege:terrain xmlns:ege=\"urn:ege2027:terrain:1\" version=\"1\"><ege:json>'+esc(JSON.stringify(t))+'</ege:json></ege:terrain>');\n let rels=await zip.file('word/_rels/document.xml.rels').async('string');\n rels=rels.replace('</Relationships>','<Relationship Id=\"rIdEgeTerrainData\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/customXml\" Target=\"../customXml/ege-terrain.xml\"/></Relationships>');zip.file('word/_rels/document.xml.rels',rels);\n}\nfunction readWordData(xml){\n if(typeof xml!=='string'||xml.length>2000000||!xml.includes('urn:ege2027:terrain:1'))throw Error('Données de terrain du Word invalides.');\n const content=/<ege:json>([\\s\\S]*?)<\\/ege:json>/.exec(xml)?.[1];if(!content)throw Error('Partie terrain non reconnue.');\n const decoded=content.replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'\"').replace(/&#39;/g,\"'\").replace(/&amp;/g,'&');\n return normalize(JSON.parse(decoded));\n}\nwindow.EGETerrain={BUCKET,fields,empty,normalize,comparisonSignature,synthesisSignature,prepareComparison,generateSynthesis,interviewIssues,progress,uploadImage,preview,prepareWordAssets,applyToWord,writeWordData,readWordData};\n})();\n"],"/ege-interface.js":["application/javascript; charset=utf-8",false,"/* Profils, relecture des étapes, devis et administration EGE. */\nObject.assign(st,{profile:null,profiles:[],designRequests:[],adminProfileId:null,adminDocId:null,adminDocDraft:null,confirmEmail:'',confirmSentAt:0});\nscreenList.push(['privacy','Confidentialité'],['student-service','Accompagnement'],['admin-services','Demandes et devis']);\nnavs.eleve.splice(3,0,['student-service','Aide au dossier','chat']);\nnavs.admin.splice(3,0,['admin-services','Devis','file']);\nconst redesignLoadAll=loadAll;\nloadAll=async function(){\n if(!st.user)return;\n try{\n st.profile=await EGEAccount.current(st.db);st.user=EGEAccount.userWithProfile(st.user,st.profile);\n if(EGEAccount.blocked(st.profile)){st.docs=[];st.groups=[];st.members=[];st.designRequests=[];st.loaded=true;render();return}\n if(st.pendingPasswordReset){st.screen='auth';render();return}\n if(EGEAccount.incomplete(st.profile,st.role)){if(st.screen!=='privacy')st.screen='profile';st.loaded=true;render();return}\n await redesignLoadAll();\n st.designRequests=await readRows('ege2027_design_requests','*',q=>q.order('created_at',{ascending:false}).limit(500));\n if(st.role==='admin')st.profiles=await readRows('ege2027_profiles','*',q=>q.order('created_at',{ascending:false}).limit(1000));\n render();\n }catch(e){fail(e);render()}\n};\nconst redesignGo=go;\ngo=function(screen){if(screen==='privacy'){st.screen='privacy';st.lastError='';st.notice='';render();scrollTo({top:0,behavior:'instant'});return}if(st.user&&EGEAccount.blocked(st.profile)){render();return}if(st.user&&EGEAccount.incomplete(st.profile,st.role)&&!['profile','auth','welcome','pricing','ads-directory'].includes(screen)){st.screen='profile';render();toast('Complétez votre nom et votre numéro WhatsApp.');return}redesignGo(screen)};\nsaveStudentProfile=async function(){\n if(!st.user)throw Error('Connectez-vous.');\n if(st.draft&&st.saveBadge!=='Enregistré en ligne'){if(!await saveDoc({silent:true}))throw Error('Enregistrez votre dossier avant de modifier le profil.')}\n const input=profileInputs('profile');\n const {data,error}=await st.db.rpc('ege2027_profile_save',input);if(error)throw error;\n st.profile=data;st.user=EGEAccount.userWithProfile(st.user,data);\n st.draft=null;clearLocalDraft();\n const mirror=await st.db.auth.updateUser({data:{full_name:data.full_name,whatsapp_number:data.whatsapp_number,series:data.series,class_name:data.class_name,school:data.school}});\n if(mirror.error)toast('Profil enregistré. La mise à jour des informations de connexion sera réessayée plus tard.');\n await loadAll();status('Profil enregistré.');\n};\nfunction profileInputs(prefix){return {p_full_name:cleaned($(prefix+'Name')?.value),p_whatsapp:EGEAccount.whatsapp($(prefix+'WhatsApp')?.value,prefix==='profile'?(st.role==='eleve'||st.user?.app_metadata?.ege2027_phone_auth===true):st.profiles.find(p=>p.user_id===st.adminProfileId)?.account_kind==='eleve'),p_series:$(prefix+'Series')?.value||'GFM',p_class_name:$(prefix+'Class')?.value||'',p_school:$(prefix+'School')?.value||''}}\nfunction contactAdmin(text='Bonjour, j’ai besoin d’aide pour EGE 2027.'){return `<a class=\"btn support-link\" target=\"_blank\" rel=\"noopener\" href=\"${esc(EGEAccount.contact(text))}\">Contacter l’administrateur sur WhatsApp</a>`}\nfunction profileFields(p={},prefix='profile',student=true){const s=EGEAcademic.series.includes(p.series)?p.series:'GFM',phoneRequired=student||(prefix==='profile'&&st.user?.app_metadata?.ege2027_phone_auth===true);return `<label class=\"field\"><span>Nom et prénom</span><input class=\"input\" id=\"${prefix}Name\" required minlength=\"2\" maxlength=\"120\" autocomplete=\"name\" value=\"${esc(p.full_name||'')}\"></label><label class=\"field\"><span>WhatsApp ${phoneRequired?'(obligatoire)':''}</span><input class=\"input\" id=\"${prefix}WhatsApp\" type=\"tel\" ${phoneRequired?'required':''} autocomplete=\"tel\" placeholder=\"+253 77 12 34 56\" value=\"${esc(p.whatsapp_number?'+'+p.whatsapp_number:'')}\"></label>${student?`<label class=\"field\"><span>Série</span><select class=\"select\" id=\"${prefix}Series\" required>${EGEAcademic.options(EGEAcademic.series,s)}</select></label><label class=\"field\"><span>Classe</span><select class=\"select\" id=\"${prefix}Class\" required>${EGEAcademic.options(EGEAcademic.classes[s],p.class_name,'Choisir une classe')}</select></label>`:''}<label class=\"field\"><span>Établissement</span><select class=\"select\" id=\"${prefix}School\" required>${EGEAcademic.options(EGEAcademic.schools,p.school,'Choisir un établissement',true)}</select></label>`}\nprofile=function(){return `${title('Mon compte','Mon profil','Corrigez votre nom et mettez vos coordonnées à jour.')}<section class=\"card\" style=\"max-width:700px\">${EGEAccount.incomplete(st.profile,st.role)?'<p class=\"notice info\">Complétez votre profil pour accéder à votre espace. Le numéro WhatsApp est obligatoire pour les élèves.</p>':''}<p class=\"small muted\">${st.profile?.auth_method==='phone_password'?'Connexion par numéro WhatsApp et mot de passe':esc(st.user?.email||'')+' · '+(st.profile?.email_confirmed?'E-mail confirmé':'E-mail à confirmer')}</p><form id=\"studentProfileForm\" class=\"ege-forms\">${profileFields(st.profile||st.user?.user_metadata,'profile',st.role==='eleve')}<button type=\"submit\" class=\"btn primary\">Enregistrer mon profil</button></form><div class=\"form-footer\">${btn('Changer mon mot de passe','profile-changepass','btn')}${btn('Se déconnecter','logout','btn')}</div></section><div style=\"margin-top:18px\">${contactAdmin()}</div>`};\negeFreeNotice=()=>'';\nconst redesignAuth=auth;\nauth=function(){if(st.mode==='confirm'&&!st.pendingPasswordReset)return `<div class=\"login-card\"><div class=\"login-badge\">VÉRIFICATION E-MAIL</div><h1>Confirmez votre inscription</h1><p>Ouvrez le lien reçu à <strong>${esc(st.confirmEmail||'votre adresse e-mail')}</strong>, puis revenez vous connecter.</p><p class=\"small muted\">Vérifiez aussi les courriers indésirables. Un lien expiré peut être remplacé ci-dessous.</p><label class=\"field\"><span>Adresse e-mail</span><input class=\"input\" type=\"email\" id=\"confirmationEmail\" value=\"${esc(st.confirmEmail)}\" autocomplete=\"email\"></label>${btn('Renvoyer le lien','resend-confirm','btn primary full')}${btn('Me connecter','mode','btn full','','data-mode=\"login\"')}<div style=\"margin-top:20px\">${contactAdmin()}</div></div>`;return redesignAuth().replace('<label class=\"field\"><span>Nom complet</span>',`<label class=\"field\"><span>Nom complet</span>`).replace('<span>Établissement</span>',`${st.mode==='signup'&&st.desired==='eleve'?'<span>WhatsApp (obligatoire)</span><input id=\"authWhatsApp\" class=\"input\" type=\"tel\" autocomplete=\"tel\" placeholder=\"+253 77 12 34 56\" required></label><label class=\"field\">':''}<span>Établissement</span>`).replace('Mot de passe oublié ?','Mot de passe oublié ?')+(!st.pendingPasswordReset&&st.mode==='login'?`<div style=\"max-width:435px;margin:0 auto 20px\">${btn('Renvoyer la confirmation e-mail','mode','btn ghost','','data-mode=\"confirm\"')}</div>`:'')};\nfunction stageBar(key,p){const s=EGEStage.status(key,p);return `<div class=\"stage-review\"><div>${badge(s==='validated'?'Étape relue et validée':s==='correction'?'À relire / corriger':'Relecture à effectuer',s==='validated'?'green':'orange')}<p class=\"form-note\">Votre relecture personnelle. Le professeur conserve sa propre validation.</p></div><div class=\"inline-actions\">${btn('Valider cette étape','stage-validate','btn primary','check',`data-key=\"${key}\"`)}${btn('Apporter une correction','stage-correct','btn','edit',`data-key=\"${key}\"`)}</div></div>`}\nconst redesignWizard=studentWizard;studentWizard=function(){return redesignWizard()+(st.draft&&st.wizardStep<4?stageBar(['','identity','subject','problem'][st.wizardStep],st.draft):'')};\nconst redesignAnnex=studentAnnex;studentAnnex=function(){return redesignAnnex()+(st.draft?stageBar('annex_'+st.annex,st.draft):'')};\nconst redesignTerrain=terrainPage;terrainPage=function(){return redesignTerrain()+(st.draft?stageBar('terrain_'+egeTerrainTab,st.draft):'')};\nconst redesignView=view;view=function(){if(st.screen==='privacy')return privacyPage();if(st.user&&EGEAccount.blocked(st.profile))return `${title('Mon compte',st.profile.deleted_at?'Compte dans la corbeille':'Compte suspendu','Contactez l’administrateur pour rétablir votre accès.')}<div class=\"card\">${contactAdmin()} ${btn('Se déconnecter','logout','btn')}</div>`;if(st.screen==='student-service'||st.screen==='admin-services')return servicePage();return redesignView()};\nrenderHeader=function(){EGEHeader.configure({\n home:()=>go(st.user?homes[st.role]:'welcome'),\n login:()=>{st.mode='login';go('auth')},\n logout:async()=>{if(st.saving||st.terrainUploading||st.profilePhotoUploading)throw Error('Un enregistrement est en cours. Réessayez dans un instant.');if(!await window.MBDialog.confirm('Voulez-vous vous déconnecter de monAvenir ?'))return;saveLocalDraft();await signOut()},\n error:error=>{fail(error);render()}\n});return EGEHeader.render({signedIn:!!st.user,home:st.screen==='welcome',userName:st.profile?.full_name||st.user?.user_metadata?.full_name||'',avatarPath:st.profile?.avatar_path||'',userId:st.user?.id||'',db:st.db})};\nconst redesignUsers=adminUsers;adminUsers=function(){const selected=st.profiles.find(p=>p.user_id===st.adminProfileId);return `${title('Administration','Profils et accès','Modifiez les coordonnées, suspendez un accès ou restaurez un compte.',btn('Actualiser','refresh','btn'))}${selected?`<section class=\"card\"><h2>Modifier ${esc(selected.full_name||'le profil')}</h2><p class=\"small muted\">${esc(selected.email)} · ${esc(selected.account_kind)}</p><form id=\"adminProfileForm\">${profileFields(selected,'adminProfile',selected.account_kind==='eleve')}<button class=\"btn primary\" type=\"submit\">Enregistrer les modifications</button>${btn('Fermer','close-profile','btn')}</form></section>`:''}<section class=\"card\"><h2>Tous les profils</h2>${st.profiles.map(p=>`<div class=\"list-row record-row\"><div class=\"row-content\"><strong>${esc(p.full_name||'Profil à compléter')}</strong><small>${esc(p.email)} · ${esc(p.class_name||p.account_kind)}${p.whatsapp_number?' · +'+esc(p.whatsapp_number):''}</small>${badge(p.deleted_at?'Corbeille':p.account_status==='suspended'?'Suspendu':'Actif',p.deleted_at||p.account_status==='suspended'?'orange':'green')}</div><div class=\"inline-actions\">${btn('Modifier','edit-profile','btn smol','',`data-id=\"${p.user_id}\"`)}${p.deleted_at?adminActionButton('Restaurer','profile_restore',p.user_id):adminActionButton(p.account_status==='suspended'?'Réactiver':'Suspendre',p.account_status==='suspended'?'profile_resume':'profile_suspend',p.user_id)+adminActionButton('Mettre à la corbeille','profile_trash',p.user_id)}</div></div>`).join('')||emptyCard('Aucun profil.')}</section><details style=\"margin-top:22px\"><summary>Approbation des enseignants</summary>${redesignUsers()}</details>`};\nfunction adminActionButton(label,action,id){const trash=action.endsWith('_trash');return btn(trash?'Corbeille':label,'admin-manage','btn smol',trash?'trash':'',`data-operation=\"${action}\" data-id=\"${id}\" aria-label=\"${esc(label)}\"`)}\nconst redesignMonitor=adminMonitor;adminMonitor=function(){if(st.adminDocDraft)return adminDossierEditor();const old=redesignMonitor();if(!['dossiers','trash'].includes(st.adminTab))return old;const docs=st.docs.filter(d=>st.adminTab==='trash'?d.deleted_at||d.archived_at:!d.deleted_at&&!d.archived_at);return `${title('Administration','Gestion des dossiers','Les dossiers supprimés restent restaurables.')}<div class=\"tabset\">${[['dossiers','Dossiers'],['trash','Corbeille'],['stats','Statistiques'],['security','Paramètres'],['ads','Publicités'],['pricing','Tarifs']].map(([v,l])=>btn(l,'admin-tab','btn'+(st.adminTab===v?' primary':''),'',`data-mode=\"${v}\"`)).join('')}</div><div class=\"card\">${docs.map(d=>`<div class=\"list-row record-row\"><div class=\"row-content\"><strong>${esc(docTitle(d))}</strong><small>${esc(displayStudent(d))} · ${shortDate(d.updated_at)}</small>${d.suspended_at?badge('Suspendu','orange'):''}</div><div class=\"inline-actions\">${btn('Lire','admin-read','btn smol','',`data-id=\"${d.id}\"`)}${btn('Modifier','edit-dossier','btn smol','',`data-id=\"${d.id}\"`)}${d.deleted_at||d.archived_at?adminActionButton('Restaurer','dossier_restore',d.id):adminActionButton(d.suspended_at?'Réactiver':'Suspendre',d.suspended_at?'dossier_resume':'dossier_suspend',d.id)+adminActionButton('Mettre à la corbeille','dossier_trash',d.id)}</div></div>`).join('')||emptyCard('Aucun dossier dans cette liste.')}</div>`};\nfunction adminDossierField(label,path,value,large=false){return `<label class=\"field\"><span>${esc(label)}</span>${large?`<textarea class=\"textarea\" data-admin-path=\"${path}\">${esc(value||'')}</textarea>`:`<input class=\"input\" data-admin-path=\"${path}\" value=\"${esc(value||'')}\">`}</label>`}\nfunction adminDossierEditor(){const p=st.adminDocDraft;return `${title('Administration','Modifier le dossier','Les changements sont enregistrés dans l’historique du dossier.')}<form id=\"adminDossierForm\" class=\"card ege-forms\">${adminDossierField('Titre','@title',st.adminDocTitle)}<label class=\"field\"><span>Mode de travail</span><select class=\"select\" data-admin-path=\"mode\"><option value=\"individuel\" ${p.mode!=='binome'?'selected':''}>Individuel</option><option value=\"binome\" ${p.mode==='binome'?'selected':''}>Binôme</option></select></label>${['student','partner','className','school','teacher','problem'].map((k,i)=>adminDossierField(['Élève','Binôme','Classe','Établissement','Professeur','Problématique'][i],k,p[k],k==='problem')).join('')}<label class=\"field\"><span>Série</span><select class=\"select\" data-admin-path=\"series\" id=\"adminDossierSeries\">${EGEAcademic.options(EGEAcademic.series,p.series)}</select></label><label class=\"field\"><span>Thème</span><select class=\"select\" data-admin-path=\"theme\" id=\"adminDossierTheme\"><option value=\"\">Choisir</option>${EGEAcademic.catalogFor(p,official).map((t,i)=>`<option value=\"${i}\" ${p.theme===i?'selected':''}>${esc(t.title)}</option>`).join('')}</select></label><label class=\"field\"><span>Sous-thème</span><select class=\"select\" data-admin-path=\"subtheme\"><option value=\"\">Choisir</option>${(EGEAcademic.catalogFor(p,official)[p.theme]?.subthemes||[]).map((t,i)=>`<option value=\"${i}\" ${p.subtheme===i?'selected':''}>${esc(t)}</option>`).join('')}</select></label>${Array.from({length:p.mode==='binome'?4:3},(_,i)=>i+1).map(n=>`<details><summary>Annexe ${n}</summary>${adminDossierField('Titre','annexTitles.'+n,p.annexTitles?.[n])}${adminDossierField('Texte','annexes.'+n,p.annexes?.[n],true)}${adminDossierField('Source','sources.'+n,p.sources?.[n],true)}</details>`).join('')}<details><summary>Entreprise et entretien</summary>${['logo','organizationChart'].map(k=>`<label class=\"field\"><span>${k==='logo'?'Logo':'Organigramme'} ${p.terrain[k]?'· image jointe':''}</span><input class=\"input\" type=\"file\" accept=\"image/jpeg,image/png,image/webp\" data-admin-image=\"${k}\"></label>`).join('')}<label class=\"field\"><span>Entretien</span><select class=\"select\" data-admin-path=\"terrain.interviewStatus\"><option value=\"planned\" ${p.terrain.interviewStatus!=='done'?'selected':''}>À préparer</option><option value=\"done\" ${p.terrain.interviewStatus==='done'?'selected':''}>Réalisé</option></select></label>${Object.entries(EGETerrain.fields).map(([key,label])=>adminDossierField(Array.isArray(label)?label[0]:label,'terrain.'+key,p.terrain?.[key],true)).join('')}<div class=\"inline-actions\">${btn('Ajouter une question','admin-add-question','btn')}${btn('Préparer le tableau','admin-comparison','btn')}${btn('Préparer la synthèse','admin-synthesis','btn')}</div>${(p.terrain?.questions||[]).map((q,i)=>`${adminDossierField('Question '+(i+1),'terrain.questions.'+i+'.question',q.question,true)}${adminDossierField('Réponse '+(i+1),'terrain.questions.'+i+'.answer',q.answer,true)}`).join('')}${(p.terrain?.comparisons||[]).map((r,i)=>adminDossierField('Comparaison — théorie '+(i+1),'terrain.comparisons.'+i+'.theory',r.theory,true)+adminDossierField('Comparaison — terrain '+(i+1),'terrain.comparisons.'+i+'.practice',r.practice,true)).join('')}</details><div class=\"form-footer\"><button class=\"btn primary\" type=\"submit\">Enregistrer les corrections</button>${btn('Fermer','close-dossier','btn')}</div></form>`}\nconst requestLabels={pending:'Demande reçue',quoted:'Devis à accepter',accepted:'Devis accepté',in_progress:'En préparation',delivered:'Dossier préparé',cancelled:'Annulée',rejected:'Refusée'};\nfunction serviceQuoteForm(r,editing=false){\n return `<form id=\"quoteForm_${r.id}\" data-quote-form=\"${r.id}\" class=\"ege-forms service-quote-form\">\n  <label class=\"field\"><span>Montant total en FDJ</span><input class=\"input\" name=\"amount\" type=\"number\" inputmode=\"numeric\" min=\"1\" max=\"100000000\" step=\"1\" required value=\"${r.quote_amount_fdj||''}\"></label>\n  <label class=\"field\"><span>Prestation, délai et paiement</span><textarea class=\"textarea\" name=\"details\" required maxlength=\"2000\" placeholder=\"Décrivez ce qui est compris, le délai et les modalités de paiement.\">${esc(r.quote_details||'')}</textarea></label>\n  <p class=\"service-quote-warning\">${r.status==='accepted'?'Le devis actuel a été accepté. Toute modification nécessitera une nouvelle acceptation de l’élève.':'L’élève devra accepter le montant et les modalités avant le démarrage.'}</p>\n  <div class=\"service-form-actions\"><button class=\"btn primary service-main-action\" type=\"submit\">${editing?'Envoyer le devis révisé':'Envoyer le devis'}</button>${editing?btn('Fermer la modification','quote-close','btn service-secondary','',`data-id=\"${r.id}\"`):''}</div>\n </form>`;\n}\nfunction serviceAdminActions(r){\n let primary='';const secondary=[];\n if(r.status==='accepted')primary=btn('Commencer la préparation','design-status','btn primary service-main-action','arrow',`data-id=\"${r.id}\" data-status=\"in_progress\"`);\n if(r.status==='in_progress')primary=btn('Marquer comme préparé','design-status','btn primary service-main-action','check',`data-id=\"${r.id}\" data-status=\"delivered\"`);\n if(r.dossier_id)secondary.push(btn('Modifier le dossier','edit-dossier','btn service-secondary','',`data-id=\"${r.dossier_id}\"`));\n else if(['accepted','in_progress'].includes(r.status))secondary.push(adminActionButton('Créer le dossier','design_create_dossier',r.id));\n const editable=['quoted','accepted'].includes(r.status);\n if(editable)secondary.push(btn('Modifier le devis','quote-toggle','btn service-secondary','',`data-id=\"${r.id}\" aria-controls=\"quoteEditor_${r.id}\" aria-expanded=\"false\"`));\n if(['pending','quoted'].includes(r.status))secondary.push(btn('Refuser la demande','design-status','btn service-danger','',`data-id=\"${r.id}\" data-status=\"rejected\"`));\n return `${primary||secondary.length?`<div class=\"service-card-actions\">${primary}${secondary.length?`<div class=\"service-secondary-actions\">${secondary.join('')}</div>`:''}</div>`:''}\n ${editable?`<section id=\"quoteEditor_${r.id}\" class=\"service-quote-editor\" hidden aria-label=\"Modifier le devis\"><h3>Modifier le devis</h3>${serviceQuoteForm(r,true)}</section>`:''}`;\n}\nfunction serviceStudentActions(r){\n const quoted=r.status==='quoted',cancellable=['pending','quoted','accepted'].includes(r.status);\n return `${quoted?`<div class=\"service-acceptance\"><label class=\"form-check\"><input id=\"accept_${r.id}\" type=\"checkbox\"> <span>J’accepte le devis n° ${r.quote_version} de <strong>${egeFDJ(r.quote_amount_fdj)}</strong> et ses modalités.</span></label>${btn('Accepter ce devis','accept-quote','btn primary service-main-action','check',`data-id=\"${r.id}\"`)}<p class=\"form-note\">Votre accord est enregistré. Aucun débit automatique n’est effectué.</p></div>`:''}\n <div class=\"service-card-actions\"><a class=\"btn service-secondary\" target=\"_blank\" rel=\"noopener\" href=\"${esc(EGEAccount.contact('Bonjour, concernant ma demande EGE du '+shortDate(r.created_at)+'.'))}\">Contacter l’administrateur sur WhatsApp</a>${cancellable?btn('Annuler ma demande','cancel-design','btn service-cancel','',`data-id=\"${r.id}\"`):''}</div>`;\n}\nfunction serviceRequestCard(r,admin){\n const p=st.profiles.find(p=>p.user_id===r.student_id),kind=['accepted','delivered'].includes(r.status)?'green':['pending','quoted'].includes(r.status)?'orange':'';\n const hasQuote=!!r.quote_amount_fdj;\n return `<section class=\"card service-card\" data-service-request=\"${r.id}\">\n  <div class=\"service-card-header\"><div><span class=\"service-eyebrow\">${admin?'Demande d’accompagnement':'Ma demande'}</span><h2>${admin?esc(p?.full_name||'Élève'):'Demande du '+shortDate(r.created_at)}</h2></div>${badge(requestLabels[r.status]||r.status,kind)}</div>\n  <div class=\"service-brief\"><span class=\"service-field-label\">Besoin exprimé</span><p>${esc(r.brief)}</p></div>\n  ${hasQuote?`<div class=\"service-quote-summary\"><div class=\"service-price-row\"><div><span class=\"service-field-label\">Montant du devis</span><p class=\"quote-price\">${egeFDJ(r.quote_amount_fdj)}</p></div><span class=\"service-quote-version\">Devis n° ${r.quote_version}</span></div><p class=\"service-quote-details\">${esc(r.quote_details||'')}</p><p class=\"service-quote-date\">${r.quote_accepted_at?'Accepté le '+shortDate(r.quote_accepted_at):r.quote_issued_at?'Proposé le '+shortDate(r.quote_issued_at):'Proposition à relire'}</p></div>`:''}\n  ${admin&&r.status==='quoted'?'<p class=\"service-waiting\">En attente de l’acceptation de l’élève.</p>':''}\n  ${admin&&r.status==='pending'?`<div class=\"service-initial-quote\"><h3>Préparer le devis</h3>${serviceQuoteForm(r)}</div>`:''}\n  ${admin?serviceAdminActions(r):serviceStudentActions(r)}\n </section>`;\n}\nfunction servicePage(){\n const admin=st.role==='admin';\n return `${title(admin?'Administration':'Accompagnement',admin?'Demandes et devis':'Demander une aide à la conception',admin?'Suivez chaque demande, de la proposition de devis à la préparation du dossier.':'Fournissez vos informations et acceptez le devis personnalisé avant le démarrage.')}\n ${!admin?`<section class=\"card service-new-request\"><h2>Ma demande</h2><form id=\"designRequestForm\" class=\"ege-forms\">\n <label class=\"field\"><span>Dossier concerné</span><select class=\"select\" id=\"designDossier\"><option value=\"\">Nouveau dossier</option>${st.docs.map(d=>`<option value=\"${d.id}\">${esc(docTitle(d))}</option>`).join('')}</select></label>\n <label class=\"field\"><span>Décrivez votre besoin</span><textarea class=\"textarea\" id=\"designBrief\" required minlength=\"10\" maxlength=\"3000\" placeholder=\"Mon sujet, mon entreprise, les éléments déjà disponibles…\"></textarea></label>\n <label class=\"form-check\"><input id=\"designPrinciple\" type=\"checkbox\" required><span>Je demande une prestation payante sur devis personnalisé. Aucun travail ne commencera sans mon acceptation du montant proposé.</span></label>\n <button class=\"btn primary service-main-action\" type=\"submit\">Demander un devis</button></form></section>`:''}\n <div class=\"service-requests\">${st.designRequests.map(r=>serviceRequestCard(r,admin)).join('')||emptyCard('Aucune demande pour le moment.')}</div>`;\n}\nasync function adminManage(action,id,data={}){if(st.role!=='admin')throw Error('Accès administrateur requis.');const r=await st.db.rpc('ege2027_admin_manage',{p_action:action,p_target:id,p_data:data});if(r.error)throw r.error;return r.data}\nasync function redesignAction(a,el){\n const id=el.dataset.id;\n if(a==='quote-toggle'||a==='quote-close'){if(st.role!=='admin')throw Error('Accès administrateur requis.');const panel=$('quoteEditor_'+id);if(!panel)return;const open=a==='quote-toggle'&&panel.hidden;panel.hidden=!open;panel.closest('.service-card')?.classList.toggle('service-editing',open);const toggle=document.querySelector('[data-act=\"quote-toggle\"][data-id=\"'+id+'\"]');toggle?.setAttribute('aria-expanded',String(open));if(open)panel.querySelector('input')?.focus({preventScroll:true});return}\n if(['admin-add-question','admin-comparison','admin-synthesis'].includes(a)){if(st.role!=='admin'||!st.adminDocDraft)throw Error('Ouvrez un dossier.');const p=st.adminDocDraft;if(a==='admin-add-question'){if(p.terrain.questions.length>=20)throw Error('20 questions maximum.');p.terrain.questions.push({question:'',answer:'',annex:0})}else{if(!await window.MBDialog.confirm('Préparer une nouvelle proposition à partir des informations du dossier ? Le contenu actuel sera remplacé.'))return;p.terrain=a==='admin-comparison'?EGETerrain.prepareComparison(p).terrain:EGETerrain.generateSynthesis(p,terrainTopic(p))}render();return}\n if(a==='resend-confirm'){const email=cleaned($('confirmationEmail')?.value||st.confirmEmail);if(!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email))throw Error('Saisissez votre adresse e-mail.');if(Date.now()-st.confirmSentAt<60000)throw Error('Patientez une minute avant de renvoyer le lien.');const r=await st.db.auth.resend({type:'signup',email,options:{emailRedirectTo:appBase}});if(r.error)throw Error(EGEAccount.authMessage(r.error));st.confirmSentAt=Date.now();st.confirmEmail=email;status('Si votre inscription attend une confirmation, un nouveau lien a été envoyé.');render();return}\n if(a==='stage-validate'||a==='stage-correct'){if(st.role!=='eleve'||!st.draft)throw Error('Ouvrez votre dossier.');EGEStage.mark(el.dataset.key,st.draft,a==='stage-validate'?'validate':'correction');touchTerrain();clearTimeout(st.saveTimer);await saveDoc({silent:true});render();if(a==='stage-correct')document.querySelector('.ege-forms input,.ege-forms textarea,.ege-forms select')?.focus();return}\n if(a==='edit-profile'){st.adminProfileId=id;render();return}if(a==='close-profile'){st.adminProfileId=null;render();return}\n if(a==='edit-dossier'){const d=entityDoc(id);if(!d)throw Error('Actualisez la liste pour ouvrir ce dossier.');st.adminDocId=id;st.adminDocRevision=d.updated_at;st.adminDocTitle=d.title;st.adminDocDraft=structuredClone(d.payload);st.adminDocDraft.terrain=EGETerrain.normalize(d.payload.terrain,d.payload);st.screen='admin-monitor';render();return}if(a==='close-dossier'){if(await window.MBDialog.confirm('Fermer cet écran sans enregistrer les modifications en cours ?')){st.adminDocDraft=null;render()}return}\n if(a==='admin-manage'){if(/trash|suspend/.test(el.dataset.operation)&&!await window.MBDialog.confirm('Confirmer cette action ? Les éléments mis à la corbeille pourront être restaurés.'))return;await adminManage(el.dataset.operation,id);await loadAll();toast('Modification enregistrée.');return}\n if(a==='design-status'){await adminManage('design_status',id,{status:el.dataset.status});await loadAll();return}\n if(a==='accept-quote'){const r=st.designRequests.find(r=>r.id===id);if(!$('accept_'+id)?.checked)throw Error('Cochez l’acceptation du devis et de son montant.');const result=await st.db.rpc('ege2027_accept_quote',{p_request:id,p_version:r.quote_version,p_amount:r.quote_amount_fdj});if(result.error)throw result.error;await loadAll();return}\n if(a==='cancel-design'){if(!await window.MBDialog.confirm('Annuler cette demande ?'))return;const r=await st.db.rpc('ege2027_cancel_design',{p_request:id});if(r.error)throw r.error;await loadAll();return}\n}\nconst redesignActions=new Set(['quote-toggle','quote-close','admin-add-question','admin-comparison','admin-synthesis','resend-confirm','stage-validate','stage-correct','edit-profile','close-profile','edit-dossier','close-dossier','admin-manage','design-status','accept-quote','cancel-design']);\ndocument.addEventListener('click',async e=>{const el=e.target.closest('[data-act]');if(!el||!redesignActions.has(el.dataset.act))return;e.preventDefault();e.stopImmediatePropagation();if(st.busy)return;st.busy=true;try{await redesignAction(el.dataset.act,el)}catch(error){fail(error);render()}finally{st.busy=false}},true);\ndocument.addEventListener('submit',async e=>{const f=e.target;if(!['adminProfileForm','adminDossierForm','designRequestForm'].includes(f.id)&&!f.dataset.quoteForm)return;e.preventDefault();e.stopImmediatePropagation();if(st.busy||st.terrainUploading)return;st.busy=true;const button=f.querySelector('[type=\"submit\"]');if(button)button.disabled=true;try{\n if(f.id==='adminProfileForm'){const p=profileInputs('adminProfile');await adminManage('profile_save',st.adminProfileId,{full_name:p.p_full_name,whatsapp_number:p.p_whatsapp,series:p.p_series,class_name:p.p_class_name,school:p.p_school});st.adminProfileId=null}\n else if(f.id==='adminDossierForm'){await adminManage('dossier_save',st.adminDocId,{title:st.adminDocTitle,payload:st.adminDocDraft,expected_revision:st.adminDocRevision});st.adminDocDraft=null}\n else if(f.id==='designRequestForm'){const r=await st.db.rpc('ege2027_design_request',{p_dossier:$('designDossier').value||null,p_brief:cleaned($('designBrief').value),p_accept:$('designPrinciple').checked});if(r.error)throw r.error}\n else{await adminManage('quote',f.dataset.quoteForm,{amount_fdj:Number(f.elements.amount.value),details:f.elements.details.value})}\n await loadAll();toast('Enregistré.');\n }catch(error){fail(error);const msg=document.createElement('p');msg.setAttribute('role','alert');msg.textContent=error.message;f.append(msg)}finally{st.busy=false;if(button)button.disabled=false}},true);\ndocument.addEventListener('input',e=>{const el=e.target,path=el.dataset.adminPath;if(!path||!st.adminDocDraft)return;if(path==='@title'){st.adminDocTitle=el.value;return}let v=el.value;if(['theme','subtheme'].includes(path))v=v===''?null:Number(v);const parts=path.split('.');let obj=st.adminDocDraft;for(const k of parts.slice(0,-1)){if(!obj[k])obj[k]={};obj=obj[k]}obj[parts.at(-1)]=v;if(path==='series'){st.adminDocDraft.theme=null;st.adminDocDraft.subtheme=null}if(path==='theme')st.adminDocDraft.subtheme=null});\ndocument.addEventListener('change',e=>{if(e.target.id==='adminProfileSeries'){$('adminProfileClass').innerHTML=EGEAcademic.options(EGEAcademic.classes[e.target.value]||[],'','Choisir une classe')}if(['adminDossierSeries','adminDossierTheme'].includes(e.target.id))render()});\n\ndocument.addEventListener('change',async e=>{const el=e.target,kind=el.dataset.adminImage,file=el.files?.[0];if(!kind||!file||st.role!=='admin'||!st.adminDocDraft)return;const doc=entityDoc(st.adminDocId),draft=st.adminDocDraft;st.terrainUploading=true;el.disabled=true;try{const asset=await EGETerrain.uploadImage(file,kind,{db:st.db,userId:doc.owner_id,dossierId:doc.id});if(st.adminDocDraft!==draft)throw Error('Le dossier ouvert a changé.');draft.terrain[kind]=asset;toast('Image ajoutée. Enregistrez les corrections pour la rattacher au dossier.')}catch(error){fail(error)}finally{st.terrainUploading=false;render()}});\n\nfunction privacyPage(){\n const sections=[\n  ['hors-connexion','Le travail hors connexion',`<p>Vous pouvez préparer vos dossiers sur votre appareil personnel depuis « Mon profil ». Cette copie facultative contient uniquement vos dossiers, leurs images disponibles et les derniers avis reçus. Elle est chiffrée dans le stockage du navigateur, avec une clé conservée sur ce même appareil. Une personne utilisant votre session de navigateur peut donc y accéder.</p><p>Les modifications sont conservées localement puis synchronisées après vérification du compte et des autorisations. Si une autre version existe en ligne, les modifications sont conservées pour que vous puissiez les exporter et choisir la version à reprendre. Les avis du professeur peuvent être anciens hors connexion.</p><p>Vous pouvez effacer cette préparation depuis votre profil. La déconnexion l’efface également, après avertissement si des modifications restent à synchroniser. Le navigateur peut supprimer son stockage ; conservez une sauvegarde JSON. Les brouillons de secours déjà présents dans le navigateur suivent les règles de stockage local décrites ci-dessous.</p><p>Les PDF et les QR codes de classe sont produits sur l’appareil. Le QR code contient un lien et un code d’inscription à la classe, sans nom d’élève ni dossier. Les partages de documents ou de liens restent à votre initiative.</p>`],\n  ['photos','Photos de profil et images publicitaires',`<p>La photo de profil est facultative. Elle est redimensionnée et stockée dans un espace privé ; seuls son propriétaire et les administrateurs autorisés peuvent la consulter. Elle n’est pas publiée dans l’annuaire des enseignants. Vous pouvez la remplacer ou la retirer depuis votre profil.</p><p>Les images des annonces et le nom public renseigné pour l’annonce sont publics. La photo de profil privée n’est jamais reprise automatiquement dans une annonce. Un enseignant peut proposer ou modifier une image ; une nouvelle image nécessite une validation administrative avant publication. Une image d’annonce peut rester dans les caches du navigateur après retrait.</p><p>Les images importées sont réencodées afin de réduire leur taille et de supprimer leurs métadonnées d’origine. Pour le parcours Candidat libre, le bouton WhatsApp ouvre un lien contenant le message prérempli. Vous décidez ensuite de l’envoyer à l’administrateur.</p>`],\n  ['collecte','Les informations enregistrées',`<p>Pour créer un nouveau compte élève ou enseignant, EGE 2027 utilise votre nom complet, votre numéro WhatsApp et un mot de passe. Vous choisissez ensuite votre établissement ; les élèves renseignent aussi leur classe et, s’ils le possèdent, le code de leur professeur. La série et l’établissement sont enregistrés pour le suivi scolaire. Pour un compte enseignant, l’établissement est demandé et l’inscription doit être approuvée par l’administration. L’adresse e-mail reste utilisée pour les anciens comptes.</p><p>Vos dossiers peuvent contenir votre identité, les noms du binôme et du professeur, votre sujet, vos annexes et sources, les informations de l’entreprise et du professionnel interrogé, les questions et réponses de l’entretien, des images, les comparaisons et la synthèse.</p><p>Les groupes, les corrections, les versions de sauvegarde et les demandes d’accompagnement sur devis sont également enregistrés. Les actions d’administration font l’objet d’un historique.</p>`],\n  ['utilisation','Pourquoi ces informations sont utilisées',`<p>Elles servent à vous identifier, enregistrer et retrouver votre travail, vous rattacher à votre classe, transmettre les corrections autorisées et préparer les exports Word, PDF ou JSON.</p><p>Pour les nouveaux comptes élèves et enseignants, le numéro WhatsApp sert d’identifiant de connexion avec votre mot de passe. Aucun e-mail, SMS ou message WhatsApp de confirmation n’est envoyé ; l’application ne vérifie donc pas que vous possédez ce numéro. En cas de mot de passe oublié, contactez l’administration, qui vérifiera votre identité et pourra vous transmettre personnellement un lien de réinitialisation valable 30 minutes et utilisable une seule fois. Un nouveau lien remplace le précédent et l’administration peut le révoquer. Vous choisissez vous-même votre nouveau mot de passe ; il ne s’affiche pas dans l’espace administrateur. Une adresse technique interne à l’authentification est attribuée automatiquement au compte ; ce n’est pas une boîte de réception et vous n’avez pas à la renseigner. Les anciens comptes conservent la connexion et la récupération par e-mail. Votre numéro WhatsApp permet aussi à l’administration de vous contacter pour l’assistance ou le suivi d’une demande. Les devis et leur acceptation permettent de suivre une prestation demandée par l’élève.</p><p>Votre mot de passe est géré par Supabase Auth. L’interface d’administration EGE 2027 ne permet pas de le lire.</p>`],\n  ['acces','Qui peut voir votre dossier',`<ul><li><strong>Vous :</strong> vos informations de compte et vos dossiers personnels.</li><li><strong>Votre enseignant :</strong> les dossiers que vous associez volontairement à son groupe, pour les consulter et les corriger. La seule inscription dans un groupe ne publie pas tous vos dossiers.</li><li><strong>L’administration EGE 2027 :</strong> les profils, dossiers et demandes nécessaires à la gestion du service, à l’assistance et aux prestations demandées. Elle peut modifier, suspendre ou placer un élément dans la corbeille.</li></ul><p>Les noms et numéros WhatsApp des profils élèves ne sont pas affichés dans un annuaire public. Le numéro du profil est accessible à l’élève et à l’administration. Si vous ajoutez un numéro ou une autre information dans le texte du dossier, les lecteurs autorisés du dossier pourront la voir.</p><p>Les images de la partie terrain sont conservées dans un espace privé et présentées aux lecteurs autorisés par des liens temporaires. Un fichier que vous avez exporté ou transmis à quelqu’un reste ensuite sous votre responsabilité.</p>`],\n  ['annonces','Les annonces et les contacts externes',`<p>Les annonces d’enseignants validées sont publiques. Le texte, l’image et les coordonnées fournis pour une annonce peuvent donc être consultés par les visiteurs. Cette publication est distincte du partage des dossiers élèves.</p><p>Les photos destinées aux annonces sont hébergées dans un espace public. Une personne disposant de leur URL peut les consulter, y compris avant la validation de l’annonce. Ne les utilisez pas pour des documents privés.</p><p>Un lien d’image externe peut entraîner le chargement d’une image depuis son hébergeur, qui reçoit alors des informations techniques de connexion, notamment l’adresse IP.</p><p>Ouvrir un lien WhatsApp vous dirige vers un service externe, soumis à ses propres règles de confidentialité. EGE 2027 n’envoie pas automatiquement un message WhatsApp à votre place.</p><p>Les recherches documentaires en ligne peuvent transmettre les termes recherchés à Wikipédia. Si vous configurez puis utilisez un service externe de recherche approfondie dans l’éditeur, le thème, le sous-thème, la problématique et le numéro d’annexe sont transmis à ce service pour traiter votre demande.</p>`],\n  ['hebergement','Hébergement et stockage sur votre appareil',`<p>L’application est hébergée par <strong>Cloudflare</strong>. L’authentification, la base de données et le stockage des fichiers utilisent <strong>Supabase</strong>. La base de ce projet est située dans la région <strong>eu-west-1, en Irlande</strong>. Cloudflare utilise un réseau mondial : certains traitements techniques peuvent avoir lieu hors de Djibouti.</p><p>Pour les comptes utilisant l’e-mail, les courriels de confirmation et de récupération du mot de passe sont envoyés par Supabase au moyen du serveur SMTP Gmail de Google. Google traite notamment l’adresse du destinataire et le contenu du message nécessaire à cette opération. Des journaux techniques peuvent être conservés pour le fonctionnement et le diagnostic du service.</p><p>Votre navigateur conserve la session, des préférences et des brouillons locaux. Le cache de l’application permet de recharger son interface ; il n’est pas destiné à mettre en cache les réponses de la base de données ni les dossiers privés. Les fichiers Word ou JSON exportés restent sur votre appareil.</p><p>Sur un appareil partagé, déconnectez-vous après utilisation. Effacer les données du navigateur supprime aussi les brouillons locaux qui n’ont pas été sauvegardés en ligne ou exportés.</p>`],\n  ['conservation','Conservation, archives et corbeille',`<p>Les comptes, dossiers, corrections et demandes sont conservés pour permettre le suivi du travail et du service. Les versions et historiques servent à retrouver des sauvegardes et à garder une trace des opérations.</p><p><strong>Archiver ou placer dans la corbeille ne constitue pas un effacement définitif.</strong> Ces éléments sont conservés afin de permettre leur restauration. Une demande d’effacement définitif doit être adressée à l’administration et confirmée par elle, en tenant compte des versions, historiques et copies techniques concernés.</p>`],\n  ['vos-demandes','Vos demandes et vos choix',`<p>Vous pouvez corriger votre nom et vos coordonnées depuis <strong>Mon profil</strong>, modifier vos dossiers et retirer leur association à un groupe. Vous pouvez également exporter votre travail.</p><p>Pour demander l’accès à vos informations, une correction supplémentaire ou un effacement, contactez l’administration. Elle pourra vous demander les éléments nécessaires pour vérifier que la demande concerne bien votre compte. Ne transmettez jamais votre mot de passe.</p><p>Avant d’ajouter des photos ou des informations concernant une entreprise, un professionnel ou une autre personne, vérifiez que vous êtes autorisé à les utiliser et limitez-vous aux informations utiles à votre étude.</p>`],\n  ['contact','Contacter l’administration',`<p>Pour toute question concernant vos données, contactez l’administration EGE 2027 au <strong>+253 77 44 16 33</strong>.</p><p>Pour une demande relative à vos données, indiquez le compte concerné et la nature de la demande, sans communiquer votre mot de passe.</p><a class=\"btn support-link\" href=\"${esc(EGEAccount.contact('Bonjour, je souhaite vous contacter au sujet de mes données dans EGE 2027.'))}\" target=\"_blank\" rel=\"noopener\">Contacter l’administration sur WhatsApp</a>`]\n ];\n return `<article class=\"privacy-page\">${title('Vos informations','Confidentialité et données personnelles','Comment EGE 2027 utilise vos informations et protège l’accès à vos dossiers.')}<p class=\"privacy-updated\">Mise à jour : 15 novembre 2026</p><section class=\"privacy-summary\"><strong>À retenir</strong><p>Vos dossiers ne sont pas publiés automatiquement sur Internet par l’application. Vous choisissez les dossiers à associer à un groupe. L’administration conserve un accès pour gérer le service. La corbeille est restaurable.</p></section><nav class=\"privacy-toc\" aria-label=\"Sommaire de la confidentialité\">${sections.map(([id,label])=>`<a href=\"#${id}\">${label}</a>`).join('')}</nav>${sections.map(([id,label,body])=>`<section id=\"${id}\" class=\"privacy-section\"><h2>${label}</h2>${body}</section>`).join('')}<div class=\"privacy-back\"><a class=\"btn\" href=\"/\" data-act=\"goto\" data-to=\"${st.user?homes[st.role]:'welcome'}\">Retour à ${st.user?'mon espace':'l’accueil'}</a></div></article>`;\n}\n\n/* Administration des groupes et accès direct aux élèves : mêmes droits vérifiés par RPC et RLS. */\n(()=>{'use strict';\nObject.assign(st,{adminGroupTab:'all',adminGroupSearch:'',adminStudentId:null,adminGroupEditId:null});\nscreenList.push(['admin-group-detail','Élèves du groupe'],['admin-student-detail','Profil et dossiers']);\nconst A=(text,action,cls='btn',data='')=>`<button type=\"button\" class=\"${cls}\" data-admin=\"${action}\" ${data}>${esc(text)}</button>`;\nconst tabs=active=>`<nav class=\"admin-resource-tabs\" aria-label=\"Gestion des personnes et des classes\">${btn('Profils et accès','goto','btn'+(active==='profiles'?' primary':''),'user','data-to=\"admin-users\"')}${btn('Groupes et élèves','goto','btn'+(active==='groups'?' primary':''),'users','data-to=\"admin-groups\"')}</nav>`;\nconst groupState=g=>g.deleted_at?['Corbeille','orange']:g.suspended_at?['Suspendu','orange']:['Actif','green'];\nconst personState=p=>p?.deleted_at?['Corbeille','orange']:p?.account_status==='suspended'?['Suspendu','orange']:['Actif','green'];\nconst person=id=>st.profiles.find(p=>p.user_id===id);\nconst teacherName=g=>person(g.teacher_id)?.full_name||st.requests.find(p=>p.user_id===g.teacher_id)?.full_name||'Enseignant';\nconst target=id=>`data-id=\"${esc(id)}\"`;\nfunction stateActions(kind,id,item){const deleted=!!item.deleted_at,suspended=kind==='profile'?item.account_status==='suspended':!!item.suspended_at;return deleted?A('Restaurer','state','btn',`${target(id)} data-operation=\"${kind}_restore\"`):A(suspended?'Réactiver':'Suspendre','state','btn',`${target(id)} data-operation=\"${kind}_${suspended?'resume':'suspend'}\"`)+A('Supprimer','state','btn admin-trash',`${target(id)} data-operation=\"${kind}_trash\"`)}\nfunction groupManagement(g){return `<details class=\"admin-manage-details\"><summary>Gérer ce groupe</summary><p class=\"small muted\">La suspension bloque les inscriptions, les nouveaux partages et les corrections. La suppression place le groupe dans la corbeille ; les élèves et les dossiers restent conservés.</p><div class=\"admin-action-grid\">${!g.deleted_at?A('Modifier le groupe','edit-group','btn',target(g.id)):''}${stateActions('group',g.id,g)}</div>${!g.deleted_at&&!g.suspended_at?`<div class=\"admin-code-setting\"><p class=\"small muted\">${g.active?'Le code accepte de nouvelles inscriptions.':'Les inscriptions sont fermées ; les élèves déjà inscrits conservent le suivi.'}</p>${A(g.active?'Fermer les inscriptions':'Ouvrir les inscriptions','state','btn smol',`${target(g.id)} data-operation=\"group_${g.active?'close':'open'}\"`)}</div>`:''}</details>`}\nfunction groupEditor(g){return `<section class=\"card\"><h2>Modifier le groupe</h2><form id=\"adminGroupEditForm\" class=\"ege-forms\"><label class=\"field\"><span>Nom du groupe</span><input class=\"input\" id=\"adminGroupEditName\" minlength=\"2\" maxlength=\"120\" required value=\"${esc(g.name)}\"></label><label class=\"field\"><span>Établissement</span><select class=\"select\" id=\"adminGroupEditSchool\" required>${EGEAcademic.options([...new Set([...EGEAcademic.schools,g.school].filter(Boolean))],g.school)}</select></label><p class=\"small muted\">Enseignant : ${esc(teacherName(g))}</p><div class=\"study-actions\"><button type=\"submit\" class=\"btn primary\">Enregistrer les modifications</button>${A('Annuler','cancel-edit','btn')}</div></form></section>`}\nadminGroups=function(){\n if(st.role!=='admin')return emptyCard('Accès administrateur requis.');\n const q=st.adminGroupSearch.toLocaleLowerCase('fr'),all=st.groups.filter(g=>st.adminGroupTab==='trash'?g.deleted_at:st.adminGroupTab==='suspended'?!g.deleted_at&&g.suspended_at:!g.deleted_at),groups=all.filter(g=>(g.name+' '+g.school+' '+teacherName(g)).toLocaleLowerCase('fr').includes(q)),editing=st.groups.find(g=>g.id===st.adminGroupEditId);\n return `${title('Administration','Groupes et élèves','Consultez les classes, leurs enseignants et les élèves inscrits.',btn('Créer un groupe','admin-create','btn primary','plus'))}${tabs('groups')}\n ${st.adminOpen?`<section class=\"card\"><h2>Nouveau groupe</h2><form id=\"adminNewGroupForm\" class=\"ege-forms\"><label class=\"field\"><span>Enseignant approuvé</span><select id=\"adminTeacher\" class=\"select\" required><option value=\"\">Choisir un enseignant</option>${st.requests.filter(r=>r.status==='approved'&&!person(r.user_id)?.deleted_at&&person(r.user_id)?.account_status!=='suspended').map(r=>`<option value=\"${r.user_id}\">${esc(r.full_name)}</option>`).join('')}</select></label><label class=\"field\"><span>Classe</span><select id=\"adminGroupName\" class=\"select\" required>${EGEAcademic.allClassOptions()}</select></label><label class=\"field\"><span>Établissement</span><select id=\"adminGroupSchool\" class=\"select\" required>${EGEAcademic.options(EGEAcademic.schools,'','Choisir un établissement')}</select></label><button type=\"submit\" class=\"btn primary\">Créer le groupe</button></form></section>`:''}\n ${editing?groupEditor(editing):''}<div class=\"admin-group-filters\"><div class=\"tabset\">${[['all','Groupes'],['suspended','Suspendus'],['trash','Corbeille']].map(([key,label])=>A(label,'filter','btn'+(st.adminGroupTab===key?' primary':''),`data-tab=\"${key}\" aria-pressed=\"${st.adminGroupTab===key}\"`)).join('')}</div><label class=\"field\"><span>Rechercher un groupe ou un enseignant</span><input class=\"input\" type=\"search\" id=\"adminGroupSearch\" value=\"${esc(st.adminGroupSearch)}\" placeholder=\"Classe, enseignant, établissement\"></label></div>\n <div id=\"adminGroupCards\">${groups.map(g=>`<section class=\"card admin-group-card\"><div class=\"card-head\"><div><h2>${esc(g.name)}</h2><p class=\"small muted\">${esc(g.school)}</p></div>${badge(...groupState(g))}</div><p class=\"admin-teacher-name\">${I('cap')}<span>${esc(teacherName(g))}</span></p><p class=\"small muted\">${st.members.filter(m=>m.group_id===g.id).length} élève(s) · ${st.shares.filter(x=>x.group_id===g.id).length} dossier(s) associé(s)</p><div class=\"admin-group-primary\">${A('Voir les élèves','group','btn primary',target(g.id))}</div>${groupManagement(g)}</section>`).join('')||emptyCard(st.adminGroupTab==='trash'?'Aucun groupe dans la corbeille.':'Aucun groupe trouvé.')}</div>`;\n};\nfunction groupDetail(){const g=currentGroup();if(!g)return box(emptyCard('Ce groupe n’est plus disponible.'));const members=st.members.filter(m=>m.group_id===g.id),editing=st.adminGroupEditId===g.id;return `${title('Administration',g.name,'Enseignant : '+teacherName(g),A('Tous les groupes','groups','btn'))}${tabs('groups')}<section class=\"card\"><div class=\"card-head\"><div><h2>${esc(g.school)}</h2><p class=\"small muted\">${members.length} élève(s) inscrit(s)</p></div>${badge(...groupState(g))}</div><div class=\"study-actions\">${A('Profil de l’enseignant','profile','btn',target(g.teacher_id))}</div>${groupManagement(g)}</section>${editing?groupEditor(g):''}<section class=\"card\"><h2>Élèves du groupe</h2>${members.map(m=>{const p=person(m.student_id),name=p?.full_name||m.student_name||'Élève';return `<div class=\"list-row record-row\"><div class=\"row-content\"><strong>${esc(name)}</strong><small>${esc(p?.class_name||g.name)} · ${esc(p?.email||'')}</small>${badge(...personState(p))}<small>${st.shares.filter(x=>x.group_id===g.id&&x.student_id===m.student_id).length} dossier(s) associé(s)</small></div><div class=\"inline-actions\">${A('Consulter','student','btn',target(m.student_id))}</div></div>`}).join('')||emptyCard('Aucun élève inscrit dans ce groupe.')}</section>`}\nfunction studentDetail(){const p=person(st.adminStudentId);if(!p)return emptyCard('Profil indisponible : actualisez les données.');const docs=st.docs.filter(d=>d.owner_id===p.user_id),groups=st.groups.filter(g=>st.members.some(m=>m.student_id===p.user_id&&m.group_id===g.id));return `${title('Administration',p.full_name||'Profil de l’élève','Profil, groupes et dossiers de cet élève.',A('Retour aux groupes','groups','btn'))}<section class=\"card\"><div class=\"card-head\"><h2>Profil et accès</h2>${badge(...personState(p))}</div><p class=\"admin-person-contact\">${esc(p.email)}<br>${esc(p.class_name)} · ${esc(p.school)}${p.whatsapp_number?'<br>WhatsApp : +'+esc(p.whatsapp_number):''}</p><div class=\"study-actions\">${A('Modifier le profil','profile','btn',target(p.user_id))}</div><details class=\"admin-manage-details\"><summary>Gérer le compte</summary><p class=\"small muted\">Suspendre ou supprimer le compte bloque l’accès de l’élève. Les dossiers restent conservés pour l’administration et la restauration.</p><div class=\"admin-action-grid\">${stateActions('profile',p.user_id,p)}</div></details>${groups.length?`<details class=\"admin-manage-details\"><summary>Ses groupes (${groups.length})</summary>${groups.map(g=>`<div class=\"admin-linked-group\"><span>${esc(g.name)} · ${esc(teacherName(g))}</span>${A('Ouvrir','group','btn smol',target(g.id))}</div>`).join('')}</details>`:''}</section><section class=\"card\"><h2>Ses dossiers (${docs.length})</h2>${docs.map(d=>`<article class=\"admin-student-doc\"><div class=\"card-head\"><div><h3>${esc(docTitle(d))}</h3><p class=\"small muted\">${shortDate(d.updated_at)}</p></div>${badge(d.deleted_at||d.archived_at?'Corbeille / archives':d.suspended_at?'Suspendu':'Actif',d.deleted_at||d.archived_at||d.suspended_at?'orange':'green')}</div><div class=\"study-actions\">${btn('Lire','admin-read','btn primary','eye',target(d.id))}${btn('Modifier','edit-dossier','btn','edit',target(d.id))}</div><details class=\"admin-manage-details\"><summary>Gérer ce dossier</summary><div class=\"admin-action-grid\">${d.archived_at&&!d.deleted_at?A('Restaurer','state','btn',`${target(d.id)} data-operation=\"dossier_restore\"`):stateActions('dossier',d.id,d)}</div></details></article>`).join('')||emptyCard('Cet élève n’a pas encore de dossier.')}</section>`}\nconst oldUsers=adminUsers;adminUsers=function(){return oldUsers().replace('<section class=\"card\"><h2>Tous les profils</h2>',tabs('profiles')+'<section class=\"card\"><h2>Tous les profils</h2>')};\nconst oldView=view;view=function(){if(st.role==='admin'&&st.screen==='admin-group-detail')return groupDetail();if(st.role==='admin'&&st.screen==='admin-student-detail')return studentDetail();return oldView()};\nasync function action(el){if(st.role!=='admin'||!st.user)throw Error('Accès administrateur requis.');const a=el.dataset.admin,id=el.dataset.id;if(a==='groups'){st.adminGroupEditId=null;go('admin-groups');return}if(a==='filter'){st.adminGroupTab=el.dataset.tab;st.adminGroupEditId=null;render();return}if(a==='group'){st.selectedGroupId=id;st.adminGroupEditId=null;go('admin-group-detail');return}if(a==='student'){st.adminStudentId=id;go('admin-student-detail');return}if(a==='profile'){st.adminProfileId=id;go('admin-users');return}if(a==='edit-group'){st.adminGroupEditId=id;render();$('adminGroupEditName')?.focus({preventScroll:true});return}if(a==='cancel-edit'){st.adminGroupEditId=null;render();return}\n if(a==='state'){const operation=el.dataset.operation;const labels={group_suspend:'Suspendre le groupe ? Les inscriptions, les nouveaux partages et les corrections seront bloqués.',group_resume:'Réactiver le groupe ?',group_trash:'Supprimer ce groupe vers la corbeille ? Les élèves et les dossiers seront conservés.',group_restore:'Restaurer ce groupe ? Un groupe précédemment suspendu restera suspendu.',group_close:'Fermer uniquement les nouvelles inscriptions ? Les élèves déjà inscrits conservent leur suivi.',group_open:'Ouvrir les nouvelles inscriptions ?',profile_suspend:'Suspendre le compte de cet élève ? Il ne pourra plus accéder à ses données en ligne.',profile_resume:'Réactiver le compte de cet élève ?',profile_trash:'Supprimer ce profil vers la corbeille ? Ses dossiers restent conservés.',profile_restore:'Restaurer ce profil ? Un compte précédemment suspendu restera suspendu.',dossier_suspend:'Suspendre ce dossier ?',dossier_resume:'Réactiver ce dossier ?',dossier_trash:'Supprimer ce dossier vers la corbeille ?',dossier_restore:'Restaurer ce dossier ?'};if(!labels[operation])throw Error('Action inconnue.');if(!await window.MBDialog.confirm(labels[operation]))return;await adminManage(operation,id);await loadAll();toast('Modification enregistrée.');render()}\n}\ndocument.addEventListener('click',async event=>{const el=event.target.closest?.('[data-admin]');if(!el)return;event.preventDefault();if(st.busy)return;const mutating=el.dataset.admin==='state';if(mutating)st.busy=true;el.disabled=true;try{await action(el)}catch(e){fail(e);render()}finally{if(mutating)st.busy=false;el.disabled=false}});\ndocument.addEventListener('input',event=>{const el=event.target;if(el.id!=='adminGroupSearch'||st.role!=='admin')return;const pos=el.selectionStart;st.adminGroupSearch=el.value;render();const field=$('adminGroupSearch');field?.focus({preventScroll:true});field?.setSelectionRange(pos,pos)});\ndocument.addEventListener('submit',async event=>{if(event.target.id!=='adminGroupEditForm')return;event.preventDefault();if(st.busy)return;st.busy=true;try{const g=st.groups.find(g=>g.id===st.adminGroupEditId);if(!g)throw Error('Groupe introuvable.');await adminManage('group_save',g.id,{name:$('adminGroupEditName').value.trim(),school:$('adminGroupEditSchool').value,expected_revision:g.updated_at});st.adminGroupEditId=null;await loadAll();toast('Groupe modifié.')}catch(e){fail(e)}finally{st.busy=false;render()}});\nwindow.EGEAdminControls={tabs,action,groupDetail,studentDetail};\n})();\n\n/* Profil facultatif et premier accueil après confirmation de l'e-mail. */\n(()=>{'use strict';\nObject.assign(st,{profilePhotoUploading:false,classStartBusy:false});\nscreenList.push(['student-class-start','Rejoindre ma classe']);\nconst localInitials=name=>String(name||'Mon compte').trim().split(/\\s+/).slice(0,2).map(s=>s[0]||'').join('').toUpperCase();\nfunction photoPanel(){const p=st.profile||{},required=st.role==='eleve';return `<div class=\"profile-photo-panel\"><div class=\"profile-photo-portrait\"><span data-profile-initials>${esc(localInitials(p.full_name))}</span>${p.avatar_path?`<img data-profile-avatar=\"${esc(p.avatar_path)}\" alt=\"Ma photo de profil\" hidden>`:''}</div><div class=\"profile-photo-body\"><h2>Photo de profil <span class=\"small muted\">(${required?'obligatoire':'facultatif'})</span></h2><p>Visible dans votre espace et par l’administration. JPG, PNG ou WebP ; la photo est préparée automatiquement.</p><label class=\"field\"><span>${p.avatar_path?'Remplacer ma photo':'Choisir ma photo'}</span><input type=\"file\" id=\"profilePhotoFile\" accept=\"image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp\" ${st.profilePhotoUploading?'disabled':''}></label>${p.avatar_path&&!required?'<button type=\"button\" class=\"btn smol\" data-profile-photo-remove>Retirer la photo</button>':''}<p class=\"profile-photo-state\" id=\"profilePhotoState\" role=\"status\"></p></div></div>`}\nconst oldProfile=profile;profile=function(){return oldProfile().replace('<form id=\"studentProfileForm\"',photoPanel()+'<form id=\"studentProfileForm\"')};\nasync function refreshPhoto(){const img=document.querySelector('[data-profile-avatar]');if(!img||!st.user||!navigator.onLine)return;const uid=st.user.id,path=img.dataset.profileAvatar;try{const url=await EGEAccount.photo.signed(st.db,path);if(!url||st.user?.id!==uid||!img.isConnected)return;img.onerror=()=>{img.hidden=true;const label=img.parentElement?.querySelector('[data-profile-initials]');if(label)label.hidden=false};img.src=url;img.hidden=false;const label=img.parentElement?.querySelector('[data-profile-initials]');if(label)label.hidden=true}catch(_){}}\nconst oldRender=render;render=function(){oldRender();refreshPhoto()};\nfunction photoStatus(text,error=false){const node=$('profilePhotoState');if(node){node.textContent=text;node.classList.toggle('profile-photo-error',error)}}\nasync function changePhoto(file,remove=false){if(!st.user||st.profilePhotoUploading)throw Error('Attendez la fin de l’importation en cours.');if(!navigator.onLine||st.offlineSession)throw Error('Internet est nécessaire pour modifier votre photo.');const uid=st.user.id;st.profilePhotoUploading=true;const input=$('profilePhotoFile');if(input)input.disabled=true;photoStatus(remove?'Retrait de la photo…':'Préparation et enregistrement de la photo…');try{const p=remove?await EGEAccount.photo.remove(st.db):await EGEAccount.photo.save(st.db,uid,file);if(st.user?.id!==uid)return;st.profile={...st.profile,...p};st.user=EGEAccount.userWithProfile(st.user,st.profile);const panel=document.querySelector('.profile-photo-panel');if(panel)panel.outerHTML=photoPanel();const header=document.querySelector('.ege-shared-header');if(header)header.outerHTML=renderHeader();EGEHeader.refresh();refreshPhoto();photoStatus(remove?'Photo retirée.':'Photo enregistrée.');toast(remove?'Photo retirée.':'Photo de profil enregistrée.')}catch(e){photoStatus(e.message,true);throw e}finally{st.profilePhotoUploading=false;const field=$('profilePhotoFile');if(field){field.disabled=false;field.value=''}}}\ndocument.addEventListener('change',event=>{if(event.target.id!=='profilePhotoFile')return;const file=event.target.files?.[0];if(file)changePhoto(file).catch(e=>{photoStatus(e.message,true);toast(e.message)})});\ndocument.addEventListener('click',async event=>{if(!event.target.closest?.('[data-profile-photo-remove]'))return;event.preventDefault();if(await window.MBDialog.confirm('Retirer votre photo de profil ?'))changePhoto(null,true).catch(e=>{photoStatus(e.message,true);toast(e.message)})});\nfunction needsClassStart(){return st.role==='eleve'&&st.user&&st.profile?.email_confirmed===true&&st.profile.auth_method!=='phone_password'&&st.user.app_metadata?.ege2027_phone_auth!==true&&!st.profile.class_onboarding_done_at&&!EGEAccount.blocked(st.profile)&&!EGEAccount.incomplete(st.profile,'eleve')&&!st.pendingPasswordReset&&navigator.onLine&&!st.offlineSession}\nfunction classStart(){const p=st.profile,candidate=p.class_name==='Candidat libre',name=cleaned(p.full_name).split(/\\s+/)[0]||'';const text=`Bonjour, je m’appelle ${p.full_name}. Je prépare l’EGE 2027 en candidat libre, en série ${p.series}. Mon inscription est confirmée. Pouvez-vous m’aider pour la suite ? Merci.`;\n return `<div class=\"ege-class-start\"><p class=\"ege-confirmed\">${I('check')} Inscription confirmée</p><h1>Bienvenue${name?', '+esc(name):''} !</h1><p class=\"intro\">Votre espace monAvenir est prêt. Vous pourrez rejoindre un enseignant plus tard, depuis « Ma classe ».</p><section class=\"card\"><div class=\"ege-class-head\"><h2>Votre scolarité</h2><span>Série ${esc(p.series)}</span></div><div class=\"ege-class-fields\"><label class=\"field\"><span>Classe scolaire</span><select class=\"select\" id=\"onboardingClass\" ${st.classStartBusy?'disabled':''}>${EGEAcademic.options(EGEAcademic.classes[p.series],p.class_name)}</select></label>${candidate?`<div class=\"ege-class-free\"><h3>Un accompagnement adapté</h3><a class=\"btn support-link\" href=\"${esc(EGEAccount.contact(text))}\" target=\"_blank\" rel=\"noopener\" data-class-contact>Contacter l’admin sur WhatsApp</a></div>`:''}<button class=\"btn primary full\" type=\"button\" data-class-later ${st.classStartBusy?'disabled':''}>Accéder à mon espace</button></div><p class=\"ege-class-warning\" id=\"classStartError\" role=\"alert\" hidden></p></section></div>`;\n}\nconst oldView=view;view=function(){if(st.screen==='student-class-start'&&st.role==='eleve'&&st.profile&&!EGEAccount.blocked(st.profile)&&!EGEAccount.incomplete(st.profile,'eleve'))return classStart();return oldView()};\nconst oldLoad=loadAll;loadAll=async function(){await oldLoad();if(needsClassStart()&&!['privacy','auth','profile','welcome','ads-directory'].includes(st.screen)){try{await finish('later')}catch(e){st.screen='student-class-start';render();classError(e)}}};\nasync function finish(choice){const r=await st.db.rpc('ege2027_class_onboarding_finish',{p_choice:choice});if(r.error)throw r.error;st.profile={...st.profile,...r.data};st.screen='student-home';render()}\nfunction classError(e){const node=$('classStartError');if(node){node.hidden=false;node.textContent=EGEAccount.authMessage(e)}else fail(e)}\nasync function changeClass(value){if(st.classStartBusy)return;if(!st.user||st.role!=='eleve'||!EGEAcademic.classes[st.profile.series]?.includes(value))throw Error('Choisissez une classe de votre série.');const p=st.profile;st.classStartBusy=true;const select=$('onboardingClass');if(select)select.disabled=true;try{const r=await st.db.rpc('ege2027_profile_save',{p_full_name:p.full_name,p_whatsapp:p.whatsapp_number,p_series:p.series,p_class_name:value,p_school:p.school});if(r.error)throw r.error;st.profile={...p,...r.data};st.user=EGEAccount.userWithProfile(st.user,st.profile);await st.db.auth.updateUser({data:{class_name:value,series:p.series}}).catch(()=>{});}finally{st.classStartBusy=false;render()}}\ndocument.addEventListener('change',event=>{if(event.target.id==='onboardingClass')changeClass(event.target.value).catch(classError)});\ndocument.addEventListener('click',event=>{if(event.target.closest?.('[data-class-contact]')){if(st.classStartBusy){event.preventDefault();return}finish('free_contact').catch(classError);return}if(event.target.closest?.('[data-class-later]')){event.preventDefault();finish('later').catch(classError)}});\nwindow.EGEProfileMedia={photoPanel,changePhoto,refreshPhoto,classStart,needsClassStart,finish,changeClass};\n})();\n\n/* Inscription élève sans e-mail ni code reçu par messagerie. */\n(()=>{'use strict';\nObject.assign(st,{phoneEmailFallback:false,enrollmentClass:'',enrollmentSeries:'GFM',enrollmentSchool:''});\nscreenList.push(['student-enrollment','Ma classe']);\nconst legacyAuth=auth,legacyLogin=doLogin;\nconst phoneAccount=()=>st.profile?.auth_method==='phone_password'||st.user?.app_metadata?.ege2027_phone_auth===true;\nconst needsEnrollment=()=>st.user&&st.role==='eleve'&&phoneAccount()&&st.profile&&!EGEAccount.blocked(st.profile)&&(!st.profile.class_onboarding_done_at||EGEAccount.incomplete(st.profile,'eleve'))&&!st.pendingPasswordReset&&!st.offlineSession;\nfunction passwordField(id,label,signup){return `<div class=\"field\"><label class=\"password-label\" for=\"${id}\">${label}</label><div class=\"password-wrap\"><input class=\"input\" id=\"${id}\" name=\"${id}\" type=\"password\" required minlength=\"${signup?12:1}\" maxlength=\"72\" autocomplete=\"${signup?'new-password':'current-password'}\" ${signup?'placeholder=\"12 caractères minimum\"':''}><button class=\"password-toggle\" type=\"button\" data-act=\"toggle-password\" data-target=\"${id}\" aria-label=\"Afficher le mot de passe\" aria-pressed=\"false\">${I('eye')}</button></div></div>`}\nauth=function(){\n if(st.pendingPasswordReset||!['eleve','enseignant'].includes(st.desired)||st.mode==='confirm')return legacyAuth();\n const signup=st.mode==='signup',teacher=st.desired==='enseignant';if(signup)st.phoneEmailFallback=false;\n if(st.phoneEmailFallback)return legacyAuth()+`<div class=\"phone-auth-back\"><button type=\"button\" class=\"btn ghost\" data-phone-email=\"false\">Utiliser mon numéro WhatsApp</button></div>`;\n const forgot=st.mode==='forgot';\n return `<div class=\"ege-auth-stage\"><div class=\"login-card\"><button class=\"backbtn\" data-act=\"goto\" data-to=\"welcome\">${I('left')} Changer d’espace</button><span class=\"login-badge\">${teacher?'ENSEIGNANT':'ÉLÈVE'}${signup?' · ÉTAPE 1 SUR 2':''}</span><h1>${signup?'Créer mon compte':forgot?'Retrouver mon accès':'Connexion'}</h1><p class=\"muted small\">${signup?(teacher?'Votre compte, puis votre établissement et votre demande d’approbation.':'Votre compte, puis votre établissement et votre classe.'):forgot?'Contactez l’administration pour être aidé à récupérer votre compte. Ne communiquez jamais votre mot de passe.':'Votre numéro WhatsApp et votre mot de passe suffisent.'}</p>\n ${forgot?`${contactAdmin('Bonjour, j’ai besoin d’aide pour récupérer l’accès à mon compte '+(teacher?'enseignant':'élève')+' EGE 2027.')}<button type=\"button\" class=\"btn full\" data-act=\"mode\" data-mode=\"login\">Retour à la connexion</button>`:`<form id=\"authForm\" class=\"ege-forms\" data-phone-auth>\n ${signup?'<label class=\"field\"><span>Nom complet</span><input id=\"authFullName\" name=\"full_name\" class=\"input\" required minlength=\"2\" maxlength=\"120\" autocomplete=\"name\" placeholder=\"Nom et prénom\"></label>':''}\n <label class=\"field\"><span>Numéro WhatsApp</span><input id=\"authWhatsApp\" name=\"whatsapp\" class=\"input\" type=\"tel\" inputmode=\"tel\" required maxlength=\"25\" autocomplete=\"${signup?'tel':'username'}\" placeholder=\"+253 77 12 34 56\"><small>Votre numéro sert d’identifiant de connexion.</small></label>\n ${passwordField('authPassword','Mot de passe',signup)}${signup?passwordField('authPasswordConfirm','Confirmer le mot de passe',true):''}\n <p class=\"form-note phone-auth-note\">Aucun message ni code de confirmation ne vous sera envoyé.</p>\n ${signup?'<p class=\"form-note signup-privacy-note\">Votre nom et votre numéro servent à gérer votre compte et vos dossiers. <a href=\"/confidentialite.html\" target=\"_blank\" rel=\"noopener\">Confidentialité</a></p>':''}\n <button type=\"submit\" class=\"btn primary full\">${signup?'Continuer':'Se connecter'} ${I('arrow')}</button></form>\n <div class=\"phone-auth-links\">${btn(signup?'Déjà inscrit ? Se connecter':'Créer mon compte','mode','btn ghost smol','',`data-mode=\"${signup?'login':'signup'}\"`)}${!signup?btn('Mot de passe oublié ?','mode','btn ghost smol','','data-mode=\"forgot\"'):''}</div>`}\n ${!signup?'<button type=\"button\" class=\"phone-legacy-link\" data-phone-email=\"true\">Ancien compte : utiliser mon e-mail</button>':''}</div><div class=\"ege-auth-ad\">${adBanner('auth')}</div></div>`;\n};\ndoLogin=async function(mode){\n if(!['eleve','enseignant'].includes(st.desired)||st.phoneEmailFallback||!['login','signup'].includes(mode))return legacyLogin(mode);\n const whatsapp=EGEAccount.whatsapp($('authWhatsApp')?.value),password=$('authPassword')?.value||'',signup=mode==='signup';\n const body={action:signup?'register':'login',whatsapp,password};if(signup)body.account_kind=st.desired;\n if(signup){body.full_name=cleaned($('authFullName')?.value);body.password_confirmation=$('authPasswordConfirm')?.value||'';if(body.full_name.length<(st.desired==='enseignant'?3:2))throw Error('Indiquez votre nom complet.');if(password.length<12)throw Error('Choisissez un mot de passe d’au moins 12 caractères.');if(password!==body.password_confirmation)throw Error('Les deux mots de passe doivent être identiques.');}\n if(!password)throw Error('Saisissez votre mot de passe.');\n if(new TextEncoder().encode(password).length>72)throw Error('Le mot de passe est trop long (72 octets maximum).');\n const {data,error}=await st.db.functions.invoke('ege2027-phone-auth',{body});\n if(error){let message='Connexion indisponible. Vérifiez Internet et réessayez.';try{const payload=await error.context?.json();if(payload?.error)message=payload.error}catch(_){}throw Error(message)}\n if(!data?.session?.access_token||!data.session.refresh_token)throw Error(data?.error||'La connexion n’a pas abouti. Réessayez.');\n const set=await st.db.auth.setSession(data.session);if(set.error)throw set.error;\n const verified=await st.db.auth.getUser();if(verified.error||!verified.data.user)throw Error('Impossible de vérifier la connexion. Réessayez.');\n st.user=verified.data.user;st.role=await resolveRole();if(st.desired==='enseignant'&&st.role!=='enseignant'&&st.role!=='admin'){await st.db.auth.signOut({scope:'local'});st.user=null;throw Error('Ce compte n’est pas un compte enseignant. Choisissez votre espace.');}st.screen=homes[st.role];st.phoneEmailFallback=false;\n status(signup?(st.role==='enseignant'?'Compte créé. Choisissez votre établissement pour envoyer votre demande d’approbation.':'Compte créé. Choisissez maintenant votre établissement et votre classe.'):'Connexion réussie.');await loadAll();\n};\nfunction enrollment(){\n const p=st.profile||{},selected=st.enrollmentClass||p.class_name||'',candidate=selected==='Candidat libre',school=st.enrollmentSchool||p.school||'';\n const message=`Bonjour, je m’appelle ${p.full_name||''}. Je prépare l’EGE 2027 en candidat libre, en série ${st.enrollmentSeries}. Je souhaite être accompagné pour mon dossier.`;\n return `<div class=\"ege-class-start\"><p class=\"ege-confirmed\">${I('check')} Compte créé · Étape 2 sur 2</p><h1>Votre scolarité</h1><p class=\"intro\">${esc(p.full_name||'Bienvenue')}, choisissez votre établissement et votre classe pour commencer.</p><section class=\"card\"><form id=\"phoneEnrollmentForm\" class=\"ege-forms\"><label class=\"field\"><span>Établissement</span><select class=\"select\" id=\"enrollmentSchool\" name=\"school\" required>${EGEAcademic.options(EGEAcademic.schools,school,'Choisir un établissement')}</select></label><label class=\"field\"><span>Classe</span><select class=\"select\" id=\"enrollmentClass\" required>${EGEAcademic.allClassOptions(selected)}</select></label>\n ${candidate?`<label class=\"field\"><span>Série</span><select class=\"select\" id=\"enrollmentSeries\" required>${EGEAcademic.options(EGEAcademic.series,st.enrollmentSeries)}</select></label><div class=\"ege-class-free\"><h2>Candidat libre</h2><p>Contactez l’administrateur si vous souhaitez être accompagné.</p><a class=\"btn support-link\" href=\"${esc(EGEAccount.contact(message))}\" target=\"_blank\" rel=\"noopener\">Contacter l’admin sur WhatsApp</a></div>`:''}\n <p class=\"form-note\">Vous pouvez utiliser monAvenir sans rejoindre une classe. Rejoignez votre enseignant plus tard depuis « Ma classe ».</p><button type=\"submit\" class=\"btn primary full\">Accéder à mon espace</button><p id=\"phoneEnrollmentError\" class=\"profile-photo-error\" role=\"alert\" hidden></p></form></section>${window.EGETeacherOnboarding?.photoChoice?.()||''}<p class=\"ege-class-privacy\">Vos dossiers restent privés. Vous choisissez ceux à partager avec votre professeur.</p></div>`;\n}\nconst oldView=view;view=function(){if(st.screen==='student-enrollment'&&st.role==='eleve'&&st.profile&&!EGEAccount.blocked(st.profile))return enrollment();return oldView()};\nconst oldRender=render;render=function(){if(needsEnrollment()&&!['privacy','welcome','ads-directory','auth','account-recovery'].includes(st.screen))st.screen='student-enrollment';oldRender()};\nconst oldLoad=loadAll;loadAll=async function(){await oldLoad();if(needsEnrollment()&&!['privacy','auth','welcome','ads-directory','account-recovery'].includes(st.screen)){st.screen='student-enrollment';render()}};\nconst oldSignOut=signOut;signOut=async function(){await oldSignOut();Object.assign(st,{phoneEmailFallback:false,enrollmentClass:'',enrollmentSeries:'GFM',enrollmentSchool:''})};\nfunction retainEnrollment(){st.enrollmentClass=$('enrollmentClass')?.value||st.enrollmentClass;st.enrollmentSeries=$('enrollmentSeries')?.value||st.enrollmentSeries;st.enrollmentSchool=$('enrollmentSchool')?.value??st.enrollmentSchool}\ndocument.addEventListener('click',event=>{const email=event.target.closest?.('[data-phone-email]');if(email){event.preventDefault();if(st.busy)return;st.phoneEmailFallback=email.dataset.phoneEmail==='true';st.mode='login';st.lastError='';render()}});\ndocument.addEventListener('change',event=>{if(event.target.id==='enrollmentSchool')retainEnrollment();if(['enrollmentClass','enrollmentSeries'].includes(event.target.id)){retainEnrollment();render()}});\ndocument.addEventListener('submit',async event=>{\n if(event.target.id!=='phoneEnrollmentForm')return;event.preventDefault();if(st.busy)return;retainEnrollment();st.busy=true;const button=event.target.querySelector('[type=submit]');button.disabled=true;button.textContent='Enregistrement…';\n try{\n  if(!st.profile?.avatar_path)throw Error('Ajoutez votre photo de profil avant de terminer votre inscription.');\n  const selected=st.enrollmentClass,candidate=selected==='Candidat libre',series=candidate?st.enrollmentSeries:/^(?:T|Première |Terminale )(GFM|OGRH|IAG|ES|S|L)/.exec(selected)?.[1];\n  if(!EGEAcademic.schools.includes(st.enrollmentSchool))throw Error('Choisissez votre établissement.');\n  if(!EGEAcademic.classes[series]?.includes(selected))throw Error('Choisissez votre classe.');\n  const r=await st.db.rpc('ege2027_finish_phone_registration',{p_class:selected,p_series:series,p_code:null,p_school:st.enrollmentSchool||null,p_later:true});if(r.error)throw r.error;\n  st.profile={...st.profile,...r.data};st.user=EGEAccount.userWithProfile(st.user,st.profile);st.screen='student-home';\n  await loadAll();status('Votre espace est prêt. Vous pouvez rejoindre une classe plus tard.');render();\n }catch(e){const error=$('phoneEnrollmentError');if(error){error.hidden=false;error.textContent=e.message||'Impossible d’enregistrer votre scolarité.'}else fail(e)}finally{st.busy=false;if(button.isConnected){button.disabled=false;button.textContent='Accéder à mon espace'}}\n});\nwindow.EGEPhoneAuth={phoneAccount,needsEnrollment,enrollment};\n})();\n\n/* Récupération manuelle : lien personnel, temporaire, jamais enregistré dans le navigateur. */\n(()=>{'use strict';\nscreenList.push(['account-recovery','Nouveau mot de passe']);\nlet recoveryToken=null,recoveryDone=false,recoveryInvalid=false,resetBusy=false,dialogGeneration=0;\nfunction readRecovery(){const params=new URLSearchParams(location.hash.slice(1));if(!params.has('recuperation'))return false;const value=params.get('recuperation')||'';recoveryToken=/^[A-Za-z0-9_-]{43}$/.test(value)?value:null;recoveryInvalid=!recoveryToken;recoveryDone=false;initialAuthHash.delete('recuperation');history.replaceState(null,'',location.pathname+location.search);return true}\nconst initialRecovery=readRecovery();\nconst eligible=p=>st.role==='admin'&&['eleve','enseignant'].includes(p?.account_kind)&&p.account_status==='active'&&!p.deleted_at;\nconst recoveryButton=p=>eligible(p)?`<button type=\"button\" class=\"btn smol\" data-recovery-admin=\"${esc(p.user_id)}\">${I('lock')}Réinitialiser l’accès</button>`:'';\nconst oldUsers=adminUsers;adminUsers=function(){const p=st.profiles.find(p=>p.user_id===st.adminProfileId);let html=oldUsers();if(eligible(p))html=html.replace('</form></section>',`</form><div class=\"recovery-profile-action\"><p class=\"small muted\">Mot de passe oublié : vérifiez l’identité du titulaire du compte avant de créer un lien personnel.</p>${recoveryButton(p)}</div></section>`);return html};\nfunction password(id,label){return `<div class=\"field\"><label class=\"password-label\" for=\"${id}\">${label}</label><div class=\"password-wrap\"><input id=\"${id}\" class=\"input\" type=\"password\" minlength=\"12\" maxlength=\"72\" autocomplete=\"new-password\" required placeholder=\"12 caractères minimum\"><button class=\"password-toggle\" type=\"button\" data-act=\"toggle-password\" data-target=\"${id}\" aria-label=\"Afficher le mot de passe\" aria-pressed=\"false\">${I('eye')}</button></div></div>`}\nfunction recoveryPage(){return `<div class=\"ege-auth-stage\"><section class=\"login-card\"><span class=\"login-badge\">RÉCUPÉRATION DU COMPTE</span><h1>${recoveryDone?'Mot de passe modifié':recoveryInvalid?'Lien indisponible':'Nouveau mot de passe'}</h1>${recoveryDone?`<p>Votre nouveau mot de passe est enregistré. Connectez-vous avec votre numéro WhatsApp et ce nouveau mot de passe.</p><button type=\"button\" class=\"btn primary full\" data-recovery-login>Me connecter</button>`:recoveryInvalid?`<p>Ce lien est invalide, expiré ou déjà utilisé. Demandez un nouveau lien à l’administrateur.</p>${contactAdmin('Bonjour, mon lien de récupération EGE 2027 ne fonctionne plus. Pouvez-vous vérifier mon identité et me transmettre un nouveau lien ?')}`:`<p class=\"muted small\">Choisissez un nouveau mot de passe pour retrouver votre compte et vos dossiers.</p><form id=\"accountRecoveryForm\" class=\"ege-forms\">${password('recoveryPassword','Nouveau mot de passe')}${password('recoveryPasswordConfirm','Confirmer le nouveau mot de passe')}<p class=\"form-note\">Le lien reçu de l’administrateur est valable 30 minutes et utilisable une seule fois. Votre mot de passe reste personnel.</p><button class=\"btn primary full\" type=\"submit\">Enregistrer mon nouveau mot de passe</button><p class=\"recovery-error\" id=\"accountRecoveryError\" role=\"alert\" hidden></p></form><div class=\"recovery-help\">${contactAdmin('Bonjour, j’ai besoin d’aide pour récupérer mon compte EGE 2027.')}</div>`}</section></div>`}\nconst oldView=view;view=function(){if(st.screen==='account-recovery')return recoveryPage();let html=oldView();if(st.screen==='admin-student-detail'){const p=st.profiles.find(p=>p.user_id===st.adminStudentId);if(eligible(p))html=html.replace('<div class=\"admin-action-grid\">','<div class=\"admin-action-grid\">'+recoveryButton(p))}return html};\nconst oldInit=initApp;initApp=async function(){if(!initialRecovery)return oldInit();st.screen='account-recovery';st.pendingPasswordReset=false;const factory=window.supabase?.createClient;if(factory)st.db=factory(DB_URL,DB_PUBLIC,{auth:{detectSessionInUrl:false}});render()};\nwindow.addEventListener('hashchange',()=>{if(readRecovery()){st.screen='account-recovery';st.pendingPasswordReset=false;render()}});\nasync function functionError(error){try{const payload=await error.context?.json();if(payload?.error)return payload.error}catch(_){}return 'Cette opération n’a pas abouti. Vérifiez Internet et réessayez.'}\nfunction dismiss(){const dialog=$('accountRecoveryDialog');if(dialog){dialog.close();dialog.remove()}dialogGeneration++}\nfunction openAdmin(id){\n const p=st.profiles.find(p=>p.user_id===id);if(!eligible(p))throw Error('Choisissez un compte élève ou enseignant actif.');if(st.offlineSession||!navigator.onLine)throw Error('Reconnectez-vous à Internet.');dismiss();const generation=dialogGeneration;\n document.body.insertAdjacentHTML('beforeend',`<dialog id=\"accountRecoveryDialog\" class=\"recovery-dialog\" aria-labelledby=\"recoveryDialogTitle\"><div class=\"recovery-dialog-head\"><h2 id=\"recoveryDialogTitle\">Réinitialiser l’accès</h2><button type=\"button\" class=\"btn smol\" data-recovery-close>Fermer</button></div><p><strong>${esc(p.full_name||'Titulaire du compte')}</strong>${p.whatsapp_number?'<br><span class=\"small muted\">WhatsApp : +'+esc(p.whatsapp_number)+'</span>':''}</p><div id=\"recoveryDialogBody\"><p>Vérifiez l’identité du titulaire du compte, en échangeant depuis son numéro enregistré et avec son établissement si nécessaire.</p><form id=\"recoveryIssueForm\" class=\"ege-forms\" data-user-id=\"${esc(id)}\"><label class=\"recovery-check\"><input type=\"checkbox\" id=\"recoveryIdentityChecked\" required><span>J’ai vérifié que la demande vient bien de cette personne.</span></label><button class=\"btn primary full\" type=\"submit\">Créer le lien temporaire</button></form><p class=\"form-note\">Aucun message n’est envoyé automatiquement. Un nouveau lien remplace le précédent.</p></div><p id=\"recoveryDialogError\" class=\"recovery-error\" role=\"alert\" hidden></p></dialog>`);\n const dialog=$('accountRecoveryDialog');dialog.dataset.generation=String(generation);dialog.addEventListener('close',()=>{if(dialog.isConnected){dialog.remove();dialogGeneration++}});dialog.showModal();\n}\nasync function issue(form){\n const dialog=$('accountRecoveryDialog'),generation=dialogGeneration,uid=st.user?.id;if(!dialog||!uid||st.role!=='admin')throw Error('Accès administrateur requis.');\n if(!$('recoveryIdentityChecked')?.checked)throw Error('Vérifiez d’abord l’identité du titulaire du compte.');\n const button=form.querySelector('[type=submit]');if(button.disabled)return;button.disabled=true;button.textContent='Création du lien…';$('recoveryDialogError').hidden=true;\n try{\n  const {data,error}=await st.db.functions.invoke('ege2027-account-recovery',{body:{action:'issue',user_id:form.dataset.userId,identity_verified:true}});if(error)throw Error(await functionError(error));\n  if(!data?.url||!data.id||!data.expires_at)throw Error('Le lien n’a pas été créé. Réessayez.');\n  const parsed=new URL(data.url);if(!['https://monavenir.janagaleh.com','https://monbac.janagaleh.com','https://ege-gfm-2027.janakaleh.workers.dev'].includes(parsed.origin)||parsed.pathname!=='/'||!/^#recuperation=[A-Za-z0-9_-]{43}$/.test(parsed.hash))throw Error('Lien invalide.');\n  data.url='https://monavenir.janagaleh.com/'+parsed.hash;\n  if(!dialog.isConnected||dialogGeneration!==generation||st.user?.id!==uid||st.role!=='admin')return;\n  const expiry=new Date(data.expires_at).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});\n  $('recoveryDialogBody').innerHTML=`<p class=\"notice info\">Lien créé. Valable jusqu’à <strong>${esc(expiry)}</strong>, une seule utilisation.</p><label class=\"field\"><span>Lien personnel à transmettre au titulaire du compte</span><input class=\"input recovery-link\" id=\"recoveryLink\" type=\"text\" readonly autocomplete=\"off\" value=\"${esc(data.url)}\"></label><p class=\"form-note\">Copiez-le et transmettez-le personnellement au titulaire du compte dont vous avez vérifié l’identité. Il choisira lui-même son nouveau mot de passe.</p><button type=\"button\" class=\"btn primary full\" data-recovery-copy>Copier le lien</button><button type=\"button\" class=\"btn ghost full\" data-recovery-revoke=\"${esc(data.id)}\">Révoquer ce lien</button><p class=\"small muted\" id=\"recoveryCopyState\" role=\"status\"></p>`;\n }finally{if(button.isConnected){button.disabled=false;button.textContent='Créer le lien temporaire'}}\n}\nfunction dialogError(error){const node=$('recoveryDialogError');if(node){node.hidden=false;node.textContent=error.message||String(error)}else toast(error.message||String(error))}\ndocument.addEventListener('click',async event=>{\n const trigger=event.target.closest?.('[data-recovery-admin]');if(trigger){event.preventDefault();try{openAdmin(trigger.dataset.recoveryAdmin)}catch(e){toast(e.message)}return}\n if(event.target.closest?.('[data-recovery-close]')){event.preventDefault();dismiss();return}\n if(event.target.closest?.('[data-recovery-copy]')){event.preventDefault();const field=$('recoveryLink');if(!field)return;try{await navigator.clipboard.writeText(field.value);$('recoveryCopyState').textContent='Lien copié. Vous pouvez le transmettre au titulaire du compte.'}catch(_){field.focus();field.select();$('recoveryCopyState').textContent='Sélectionnez « Copier » pour copier ce lien.'}return}\n const revoke=event.target.closest?.('[data-recovery-revoke]');if(revoke){event.preventDefault();if(st.role!=='admin')return;revoke.disabled=true;try{const r=await st.db.rpc('ege2027_recovery_revoke',{p_id:revoke.dataset.recoveryRevoke});if(r.error)throw r.error;const field=$('recoveryLink');if(field)field.value='';$('recoveryDialogBody').innerHTML=r.data?'<p>Ce lien est maintenant inutilisable. Fermez cette fenêtre pour revenir au profil.</p>':'<p>Ce lien est déjà utilisé ou indisponible. Une réinitialisation déjà engagée ne peut pas être annulée.</p>'}catch(e){dialogError(e);revoke.disabled=false}return}\n if(event.target.closest?.('[data-recovery-login]')){event.preventDefault();recoveryToken=null;st.screen='auth';st.desired='eleve';st.mode='login';st.phoneEmailFallback=false;st.user=null;st.profile=null;render()}\n});\ndocument.addEventListener('submit',async event=>{\n if(event.target.id==='recoveryIssueForm'){event.preventDefault();try{await issue(event.target)}catch(e){dialogError(e)}return}\n if(event.target.id!=='accountRecoveryForm')return;event.preventDefault();if(resetBusy)return;\n const password=$('recoveryPassword')?.value||'',confirmation=$('recoveryPasswordConfirm')?.value||'',errorNode=$('accountRecoveryError'),button=event.target.querySelector('[type=submit]');errorNode.hidden=true;\n try{\n  if(password.length<12||new TextEncoder().encode(password).length>72)throw Error('Choisissez un mot de passe d’au moins 12 caractères, sans dépasser 72 octets.');\n  if(password!==confirmation)throw Error('Les deux mots de passe doivent être identiques.');if(!recoveryToken)throw Error('Demandez un nouveau lien à l’administrateur.');if(!navigator.onLine)throw Error('Internet est nécessaire pour modifier votre mot de passe.');\n  resetBusy=true;button.disabled=true;button.textContent='Enregistrement…';\n  const response=await fetch(DB_URL+'/functions/v1/ege2027-account-recovery',{method:'POST',cache:'no-store',headers:{apikey:DB_PUBLIC,'Content-Type':'application/json'},body:JSON.stringify({action:'reset',token:recoveryToken,password,password_confirmation:confirmation})});const data=await response.json();\n  if(!response.ok||!data.success){if(response.status===410){recoveryInvalid=true;recoveryToken=null;render();return}throw Error(data.error||'Demandez un nouveau lien à l’administrateur.')}\n  recoveryToken=null;recoveryDone=true;await st.db?.auth?.signOut({scope:'local'}).catch(()=>{});st.user=null;st.profile=null;st.docs=[];st.groups=[];st.members=[];st.draft=null;st.pendingPasswordReset=false;render();\n }catch(e){if(errorNode.isConnected){errorNode.hidden=false;errorNode.textContent=e.message||'La récupération n’a pas abouti.'}}finally{resetBusy=false;if(button.isConnected){button.disabled=false;button.textContent='Enregistrer mon nouveau mot de passe'}}\n});\nconst oldSignOut=signOut;signOut=async function(){dismiss();await oldSignOut()};\nwindow.EGERecovery={openAdmin,recoveryPage};\n})();\n\n/* Enseignant : coordonnées, établissement, puis approbation explicite par l’administrateur. */\n(()=>{'use strict';\nscreenList.push(['teacher-enrollment','Mon établissement']);\nconst isPhoneTeacher=()=>st.user?.app_metadata?.ege2027_account_kind==='enseignant';\nconst needsEnrollment=()=>st.user&&st.role==='enseignant'&&isPhoneTeacher()&&st.profile&&!EGEAccount.blocked(st.profile)&&!st.teacher&&!st.pendingPasswordReset;\nfunction photoChoice(){return window.EGEProfileMedia?.photoPanel?(st.role==='eleve'?`<section class=\"card onboarding-photo\">${EGEProfileMedia.photoPanel()}</section>`:`<details class=\"onboarding-photo\"><summary>Ajouter une photo de profil <span>(facultatif)</span></summary>${EGEProfileMedia.photoPanel()}</details>`):''}\nfunction teacherEnrollment(){return `<div class=\"ege-class-start\"><p class=\"ege-confirmed\">${I('check')} Compte créé · Étape 2 sur 2</p><h1>Votre enseignement</h1><p class=\"intro\">${esc(st.profile?.full_name||'Bienvenue')}, indiquez votre établissement et les matières que vous enseignez.</p><section class=\"card\"><form id=\"teacherEnrollmentForm\" class=\"ege-forms\"><label class=\"field\"><span>Établissement</span><select class=\"select\" id=\"teacherEnrollmentSchool\" required>${EGEAcademic.options(EGEAcademic.schools,st.profile?.school||'','Choisir un établissement')}</select></label><p class=\"form-note\">L’administrateur doit approuver votre inscription avant que vous puissiez créer vos classes, consulter les dossiers partagés ou proposer une annonce.</p><button class=\"btn primary full\" type=\"submit\">Envoyer ma demande d’approbation</button><p class=\"profile-photo-error\" id=\"teacherEnrollmentError\" role=\"alert\" hidden></p></form></section>${photoChoice()}</div>`}\nconst oldPending=teacherPending;teacherPending=function(){return oldPending()+photoChoice()};\nconst oldView=view;view=function(){if(st.screen==='teacher-enrollment'&&needsEnrollment())return teacherEnrollment();return oldView()};\nconst oldRender=render;render=function(){if(needsEnrollment()&&!['privacy','auth','account-recovery','welcome','ads-directory','profile'].includes(st.screen))st.screen='teacher-enrollment';oldRender()};\nconst oldLoad=loadAll;loadAll=async function(){await oldLoad();if(needsEnrollment()&&!['privacy','auth','account-recovery','welcome','ads-directory','profile'].includes(st.screen)){st.screen='teacher-enrollment';render()}else if(st.screen==='teacher-enrollment'&&st.teacher){st.screen='teacher-home';render()}};\ndocument.addEventListener('submit',async event=>{if(event.target.id!=='teacherEnrollmentForm')return;event.preventDefault();if(st.busy||st.profilePhotoUploading)return;const school=$('teacherEnrollmentSchool')?.value;if(!EGEAcademic.schools.includes(school)){$('teacherEnrollmentError').hidden=false;$('teacherEnrollmentError').textContent='Choisissez votre établissement.';return}st.busy=true;const button=event.target.querySelector('[type=submit]');button.disabled=true;button.textContent='Envoi de la demande…';try{const r=await st.db.rpc('ege2027_finish_teacher_registration',{p_school:school});if(r.error)throw r.error;st.teacher=r.data;st.profile={...st.profile,school:r.data.school};st.user=EGEAccount.userWithProfile(st.user,st.profile);st.screen='teacher-home';await loadAll();status('Votre demande a été envoyée. L’administrateur doit maintenant l’approuver.');render()}catch(e){const node=$('teacherEnrollmentError');if(node){node.hidden=false;node.textContent=e.message||'La demande n’a pas abouti.'}else fail(e)}finally{st.busy=false;if(button.isConnected){button.disabled=false;button.textContent='Envoyer ma demande d’approbation'}}});\nconst oldAdminUsers=adminUsers;adminUsers=function(){const count=st.requests.filter(r=>r.status==='pending'&&!st.profiles.find(p=>p.user_id===r.user_id)?.deleted_at).length;return oldAdminUsers().replace('Approbation des enseignants</summary>','Approbation des enseignants'+(count?' <span class=\"badge orange\">'+count+' en attente</span>':'')+'</summary>')};\nwindow.EGETeacherOnboarding={needsEnrollment,teacherEnrollment,photoChoice};\n})();\n"],"/ege-interface.css":["text/css; charset=utf-8",false,"/* EGE 2027 — interface compacte, lisible et adaptée au téléphone. */\n/* V99 — tableau de bord EGE sur un seul écran, sans allonger les autres pages. */\n.mb99-ege{--ege-red:#c60835;--ege-ink:#17253a;--ege-muted:#687689;display:grid;gap:12px;max-width:1100px;margin:0 auto;min-width:0}.mb99-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;min-width:0}.mb99-heading h1{font-size:25px;line-height:1.15;letter-spacing:-.6px;color:var(--ege-ink);margin:0 0 3px}.mb99-heading p{font-size:13px;color:var(--ege-muted);line-height:1.25;margin:0}.mb99-status{display:flex;justify-content:flex-end;max-width:55%;min-width:0}.mb99-status .badge{white-space:normal;text-align:center;font-size:11px;line-height:1.25;padding:6px 9px}.mb99-recover{display:inline-flex;align-items:center;gap:5px;justify-content:center;text-align:center;font-weight:700;font-size:11px;line-height:1.2;border:0;border-radius:9px;padding:8px 9px;min-height:40px;color:#865710;background:#fff2d8;cursor:pointer}.mb99-recover svg{height:16px;width:16px;flex:none}.mb99-warning{display:flex;align-items:center;gap:6px;overflow-wrap:anywhere;border-radius:10px;padding:9px 10px;color:#79510e;background:#fff2d8;font-size:12px;margin:0;line-height:1.35}.mb99-warning svg{width:16px;height:16px;flex:none}.mb99-layout,.mb99-primary{display:grid;gap:10px;min-width:0;align-content:start}\n.mb99-ege .mb99-feature{position:relative;display:block;padding:15px!important;margin:0!important;min-height:0!important;overflow:hidden;border:1px solid #e1e5ec!important;background:#fff!important;border-radius:15px!important;box-shadow:0 2px 10px #15283f08!important}.mb99-feature:before,.mb99-feature:after{display:none!important}.mb99-ege .mb99-feature .feature-label{display:flex;align-items:center;gap:6px;margin:0 0 6px;color:var(--ege-red);font-size:12px;font-weight:750;line-height:1.25}.mb99-feature .feature-label svg{width:17px;height:17px;flex:none}.mb99-ege .mb99-feature h2{font-size:21px;line-height:1.2;color:var(--ege-ink);margin:0;overflow-wrap:anywhere;font-weight:750;letter-spacing:-.3px}.mb99-ege .mb99-feature .mb99-meta{font-size:12px;color:var(--ege-muted);margin:4px 0 12px;line-height:1.25}.mb99-ege .compact-legend{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:12px;color:var(--ege-muted);margin:0 0 5px;font-weight:650}.mb99-ege .compact-legend strong:last-child{color:var(--ege-red);font-size:13px}.mb99-ege .progress-track{height:6px!important;margin:0!important;border-radius:99px;background:#e9edf2;overflow:hidden}.mb99-ege .progress-bar{height:100%;background:var(--ege-red);border-radius:99px}.mb99-ege .feature-bottom{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:12px 0 0!important;min-height:0;flex-wrap:nowrap}.mb99-next{display:grid;gap:2px;flex:1;min-width:0;font-size:12px;line-height:1.25;color:var(--ege-ink)}.mb99-next small{font-size:10px;color:var(--ege-muted)}.mb99-next strong{font-size:12px;line-height:1.25;overflow-wrap:anywhere;font-weight:700}.mb99-ege .feature-bottom .btn{min-height:44px;padding:9px 12px;font-size:12px;white-space:normal;border-radius:10px;flex:1;line-height:1.2;justify-content:center;text-align:center;box-shadow:none}.mb99-ege .feature-bottom .btn svg{width:17px;height:17px;flex:none}\n.mb99-shortcuts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;min-width:0}.mb99-shortcut{display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:3px;min-width:0;min-height:86px;padding:8px 4px;border:1px solid #e1e5ec;background:#fff;color:var(--ege-ink);border-radius:12px;cursor:pointer;box-shadow:0 1px 4px #15283f06}.mb99-shortcut-icon{display:grid;place-items:center;width:31px;height:31px;background:#fff0f3;border-radius:9px;color:var(--ege-red);margin-bottom:2px}.mb99-shortcut-icon svg{width:20px;height:20px;stroke:currentColor;fill:none}.mb99-shortcut strong{font-size:12px;line-height:1.25;overflow-wrap:anywhere;font-weight:750}.mb99-shortcut small{font-size:10px;color:var(--ege-muted);line-height:1.2;overflow-wrap:anywhere}.mb99-shortcut:active{background:#fff5f7}.mb99-ege .mb99-reviews{padding:11px 14px!important;margin:0!important;border:1px solid #e1e5ec!important;border-radius:15px!important;background:white;box-shadow:0 2px 10px #15283f08!important;min-width:0}.mb99-review-head{display:flex;align-items:center;justify-content:space-between;gap:6px;margin:0 0 2px}.mb99-review-head h2{font-size:16px;line-height:1.25;margin:0;display:flex;gap:6px;align-items:center;color:var(--ege-ink);font-weight:750}.mb99-review-head h2 span{border-radius:99px;background:#fff0f3;color:var(--ege-red);font-size:11px;padding:3px 7px;line-height:1.25}.mb99-see{display:flex;flex-direction:row-reverse;align-items:center;gap:3px;min-height:40px;padding:5px 0;background:none;border:0;color:var(--ege-red);font-size:12px;font-weight:750;cursor:pointer}.mb99-see svg{height:16px;width:16px;flex:none}.mb99-review-row{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 0;min-height:44px;border-top:1px solid #eef0f3}.mb99-review-text{display:grid;gap:3px;min-width:0;flex:1}.mb99-review-text strong{font-size:13px;color:var(--ege-ink);line-height:1.2}.mb99-review-text small{font-size:11px;color:var(--ege-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.25}.mb99-review-row .badge{width:auto;max-width:45%;flex:none;font-size:10px;line-height:1.2;padding:5px 8px;margin:0;white-space:nowrap;border-radius:30px}.mb99-empty{font-size:12px;color:var(--ege-muted);margin:8px 0;line-height:1.4}.screen:has(>.mb99-ege)>.mb74-back{margin:0 0 4px;min-height:30px}.mb99-ege button:focus-visible{outline:2px solid var(--ege-red);outline-offset:2px}\n@media(min-width:800px){.mb99-layout{grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:14px}.mb99-ege{gap:14px}.mb99-ege .mb99-feature{padding:19px!important}.mb99-ege .mb99-reviews{padding:14px 18px!important}.mb99-shortcut{min-height:98px}}@media(max-width:350px){.mb99-ege .mb99-feature{padding:12px!important}.mb99-ege .mb99-reviews{padding:9px 11px!important}.mb99-shortcut strong{font-size:11px}.mb99-shortcut small{font-size:9px}.mb99-ege .feature-bottom .btn{padding:8px 6px;font-size:11px}.mb99-heading h1{font-size:23px}}\ndialog.mb98-dialog{position:fixed;inset:0;margin:auto;width:min(420px,calc(100% - 32px));max-height:calc(100dvh - 40px);overflow:auto;border:0;border-radius:24px;padding:26px 22px 22px;background:#fff;color:#17253c;text-align:center;box-shadow:0 24px 70px #14203840;font:inherit;z-index:9999}dialog.mb98-dialog::backdrop{background:#10182799;backdrop-filter:blur(2px)}.mb98-dialog .mb98-mark{display:grid;place-items:center;width:64px;height:64px;border-radius:50%;margin:0 auto 18px;color:#c60835;background:#fff0f3}.mb98-mark svg{width:30px;height:30px}.mb98-dialog.mb98-success .mb98-mark{color:#16834c;background:#e7f8ef}.mb98-dialog.mb98-error .mb98-mark,.mb98-dialog.mb98-warning .mb98-mark{color:#a7600c;background:#fff3df}.mb98-dialog h2{font-size:22px;line-height:1.25;font-weight:750;margin:0 0 10px;color:#17253c}.mb98-dialog p{margin:0 0 24px;color:#607087;font-size:15px;line-height:1.65;white-space:pre-line;overflow-wrap:anywhere}.mb98-dialog .mb98-actions{display:flex;gap:10px;justify-content:stretch}.mb98-dialog .mb98-actions button{flex:1;min-width:0;min-height:48px;border-radius:13px;border:1px solid #dce0e7;font:inherit;font-weight:700;font-size:14px;padding:10px;background:#fff;color:#334155;box-shadow:none}.mb98-dialog .mb98-actions .mb98-primary{background:#c60835;border-color:#c60835;color:#fff}.mb98-dialog .mb98-actions .mb98-primary:active{background:#a5052c}.mb98-dialog [hidden]{display:none!important}.mb98-dialog .mb98-input{width:100%;border:1px solid #cad2de;border-radius:12px;padding:12px;color:#17253c;background:#f8fafc;margin-bottom:18px}.mb98-dialog button:focus-visible,.mb98-dialog input:focus-visible{outline:3px solid #e7a2b1;outline-offset:2px}@media(max-width:340px){dialog.mb98-dialog{padding:22px 16px}.mb98-dialog .mb98-actions{flex-direction:column-reverse}}\n:root{--red:#c91b2c;--red-dark:#aa1424;--navy:#15283f;--ink:#24364c;--muted:#66768a;--bg:#f5f7fb;--line:#e5eaf1;--bluelight:#fff2f3;--radius:18px}\nhtml{scroll-behavior:smooth}body{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased}*{box-sizing:border-box}button,input,select,textarea{font:inherit}button,a,input,select,textarea{-webkit-tap-highlight-color:transparent}button,a{touch-action:manipulation}button{cursor:pointer}button:disabled{cursor:default;opacity:.55}a{color:var(--red)}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #ef9ba6;outline-offset:3px}\n.app{max-width:1600px;margin:0 auto;background:transparent}.app-header,.ege-public-header{height:76px;background:#fff;border-bottom:1px solid var(--line);box-shadow:none;padding:0 28px;display:flex;align-items:center;justify-content:space-between;gap:16px;position:relative;z-index:20}.brand{display:flex;align-items:center;gap:11px;text-decoration:none;color:var(--navy);min-width:0}.brandmark{width:42px;height:42px;border-radius:12px}.brandname{font-size:19px;font-weight:850;letter-spacing:-.6px}.brand-sub{font-size:11px;color:var(--muted)}.brand-chip{display:grid;place-items:center;width:42px;height:42px;background:var(--red);color:#fff;border-radius:12px;font-weight:900;font-size:15px}.header-right{display:flex;align-items:center;gap:12px}.version-pill{font-size:11px;background:#f2f4f8;color:var(--muted);border:0}.app-body{max-width:none}.main{padding:30px;min-width:0}.screen{max-width:1220px;margin:0 auto}.sidebar{background:#fff;border-right:1px solid var(--line);padding:24px 16px}.sectionlabel{font-size:10px;letter-spacing:1.3px;color:#8a96a7;margin:20px 12px 10px}.side-link{border-radius:12px;padding:12px 