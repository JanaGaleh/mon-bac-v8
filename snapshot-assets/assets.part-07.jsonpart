function home(){const p=st.profile,rows=studentData?.resources||[],count=rows.filter(x=>x.completed).length,progress=rows.length?Math.round(100*count/rows.length):0;const recent=rows.filter(x=>!x.completed).sort((a,b)=>String(b.touched_at||'').localeCompare(String(a.touched_at||'')))[0],group=studentData?.groups?.[0];const tile=(k,t)=>`<button type=\"button\" class=\"mbed-tile\" data-mbed-action=\"${k==='teachers'?'groups':'tab'}\" data-id=\"${E(k)}\">${I(icons[k])}<span>${E(t)}</span></button>`;return `<div class=\"mbedu-page mbed-home\"><span class=\"mbed-pill\">${E(tr('ESPACE UNIVERSITÉ','UNIVERSITY AREA','الفضاء الجامعي'))}</span><h1>${E(tr('Bonjour, ','Hello, ','مرحبًا، ')+String(p.full_name||'').trim().split(/\\s+/)[0])}</h1><p class=\"mbed-muted\">${E(profileLabel())}</p><section class=\"mbed-card\"><div class=\"mbed-line\"><div><h2>${E(tr('Mon parcours','My programme','مساري'))}</h2><p>${E(p.study_semester?tr('Semestre ','Semester ','الفصل الدراسي ')+p.study_semester:p.study_level)}</p></div>${button('tab',tr('Continuer','Continue','متابعة'),'course',true)}</div><div class=\"mbed-progress\" aria-label=\"${progress}%\"><i style=\"width:${progress}%\"></i></div><small>${count}/${rows.length} ${E(tr('ressources terminées','resources completed','موارد مكتملة'))}</small></section><h2 class=\"mbed-section-title\">${E(tr('Mes études','My studies','دراستي'))}</h2><div class=\"mbed-grid\">${kinds().map(([k,t])=>tile(k,t)).join('')}${tile('teachers',tr('Mes enseignants','My teachers','معلّميّ'))}</div><section class=\"mbed-card\"><h2>${E(tr('À reprendre','Resume','للمتابعة'))}</h2>${recent?`<div class=\"mbed-line\"><span>${E(recent.title)}</span>${button('open',tr('Continuer','Continue','متابعة'),recent.id,true)}</div>`:empty(tr('Aucun travail en cours.','No work in progress.','لا يوجد عمل قيد الإنجاز.'))}</section><section class=\"mbed-card\"><h2>${E(tr('Mon groupe','My group','مجموعتي'))}</h2><div class=\"mbed-line\"><span>${E(group?.title||[p.study_level,p.study_track].filter(Boolean).join(' '))}</span>${button('groups',tr('Voir','View','عرض'))}</div></section>${error?`<p class=\"mbed-error\">${E(error)}</p>${button('refresh',tr('Réessayer','Retry','إعادة المحاولة'))}`:''}</div>`;}\nfunction resourceCard(r){return `<article class=\"mbed-result\"><button type=\"button\" class=\"mbed-result-open\" data-mbed-action=\"open\" data-id=\"${E(r.id)}\"><small>${E(r.subject+' · '+typeTitle(r.kind))}</small><b>${E(r.title)}</b><small>${E(r.completed?tr('Terminé','Completed','مكتمل'):tr('Consulter','Open','عرض'))}</small></button>${button('favorite',r.favorite?'★':'☆',r.id)}</article>`;}\nfunction work(){const rows=studentData?.resources||[],r=rows.find(x=>x.id===resourceId),fav=st.screen==='uni-favorites',sortKey='uni-work-'+(fav?'favorites':filter),items=MBSort.rows(sortKey,fav?rows.filter(x=>x.favorite):rows.filter(x=>x.kind===filter),()=>render());return `<div class=\"mbedu-page\">${back()}<div class=\"mbed-line\"><h1>${E(fav?tr('Mes favoris','My favorites','مفضلاتي'):tr('Travailler','Study','دراسة'))}</h1>${button('refresh',tr('Actualiser','Refresh','تحديث'))}</div>${r?`<section class=\"mbed-card\">${button('close-resource',tr('← Retour','← Back','رجوع'))}<small>${E(r.subject+' · '+typeTitle(r.kind))}</small><h2>${E(r.title)}</h2><div class=\"mbed-text\">${E(r.body)}</div>${r.link?`<a class=\"mbed-link\" href=\"${E(r.link)}\" target=\"_blank\" rel=\"noopener noreferrer\">${E(tr('Ouvrir la ressource','Open resource','فتح المورد'))} ↗</a>`:''}${r.kind==='interactive'?`<form id=\"mbed-answer\"><fieldset><legend>${E(tr('Choisissez la bonne réponse','Choose the correct answer','اختر الإجابة الصحيحة'))}</legend>${(r.choices||[]).map((c,i)=>`<label class=\"mbed-radio\"><input name=\"answer\" type=\"radio\" value=\"${i}\" required> ${E(c)}</label>`).join('')}</fieldset><button class=\"mbed-btn mbed-main\" type=\"submit\">${E(tr('Valider','Check','تحقق'))}</button></form>${feedback?`<p class=\"${feedback.correct?'mbed-good':'mbed-error'}\">${E((feedback.correct?tr('Bonne réponse !','Correct!','إجابة صحيحة!'):tr('Réessayez.','Try again.','حاول مرة أخرى.'))+' '+(feedback.explanation||''))}</p>`:''}`:button('complete',r.completed?tr('Terminé','Completed','مكتمل'):tr('Marquer comme terminé','Mark complete','وضع علامة مكتمل'),r.id,true)}${button('favorite',r.favorite?tr('Retirer des favoris','Remove favorite','إزالة من المفضلة'):tr('Ajouter aux favoris','Add favorite','إضافة إلى المفضلة'),r.id)}</section>`:`${fav?'':`<div class=\"mbed-tabs\">${kinds().map(([id,t])=>`<button type=\"button\" data-mbed-action=\"tab\" data-id=\"${id}\" aria-pressed=\"${filter===id}\">${E(t)}</button>`).join('')}</div>`}${fetching?empty(tr('Chargement…','Loading…','جارٍ التحميل…')):(MBSort.menu(sortKey)+items.map(resourceCard).join('')||empty())}`}${error?`<p class=\"mbed-error\">${E(error)}</p>`:''}</div>`;}\nfunction groups(){const sorted=MBSort.rows('uni-groups',studentData?.groups||[],()=>render());return `<div class=\"mbedu-page\">${back()}<h1>${E(tr('Mon groupe · Mes enseignants','My group · My teachers','مجموعتي · معلّميّ'))}</h1><section class=\"mbed-card\"><h2>${E(tr('Rejoindre un groupe','Join a group','الانضمام إلى مجموعة'))}</h2><form id=\"mbed-join\">${field(tr('Code enseignant','Teacher code','رمز المعلّم'),input('code','','required minlength=\"12\" maxlength=\"12\" autocomplete=\"off\"'))}<button class=\"mbed-btn mbed-main\" type=\"submit\">${E(tr('Rejoindre','Join','انضمام'))}</button></form></section>${MBSort.menu(\"uni-groups\")}${sorted.map(g=>`<section class=\"mbed-card\"><h2>${E(g.title)}</h2><p>${E(g.subject)} · ${E(g.teacher)}</p></section>`).join('')||empty(tr('Aucun groupe rejoint.','No groups joined.','لم تنضم إلى مجموعة بعد.'))}${error?`<p class=\"mbed-error\">${E(error)}</p>`:''}</div>`;}\nfunction universitySchoolOptions(){return unique(catalog.filter(x=>x.cycle==='university').map(x=>x.school));}\nfunction staff(){const rows=MBSort.rows('uni-staff-resources',staffData?.resources||[],()=>render()),gr=MBSort.rows('uni-staff-groups',staffData?.groups||[],()=>render()),schools=universitySchoolOptions();const title=tr('Gestion universitaire','University management','إدارة الجامعة');const school=admin()?field(tr('Établissement (facultatif)','Institution (optional)','المؤسسة (اختياري)'),select('school',schools,'',false)):field(tr('Établissement','Institution','المؤسسة'),select('school',unique([...(window.MBMultiTeacher?.schools()||[]),...(schools.includes(st.profile?.school)?[st.profile.school]:[])]),'',true));const common=field(tr('Niveau','Level','المستوى'),select('level',levels.university))+field(tr('Filière (vide = toutes)','Field (blank = all)','التخصص (فارغ = الكل)'),input('track','','maxlength=\"100\" list=\"mbed-tracks\"'))+`<datalist id=\"mbed-tracks\">${unique([...tracks,...catalog.map(x=>x.track)]).map(t=>`<option value=\"${E(t)}\"></option>`).join('')}</datalist>`;const resourceForm=`<form id=\"mbed-resource\" class=\"mbed-card\"><h2>${E(tr('Publier une ressource','Publish a resource','نشر مورد'))}</h2>${school}${common}${field(tr('Semestre (facultatif)','Semester (optional)','الفصل الدراسي (اختياري)'),select('semester',Array.from({length:12},(_,i)=>String(i+1)),'',false))}${field(tr('Type de ressource','Resource type','نوع المورد'),select('kind',kinds(),'course',true,'data-mbed-kind'))}${field(tr('Matière','Subject','المادة'),input('subject','','required maxlength=\"120\"'))}${field(tr('Titre','Title','العنوان'),input('title','','required maxlength=\"160\"'))}${field(tr('Contenu / question','Content / question','المحتوى / السؤال'),'<textarea name=\"body\" rows=\"4\" maxlength=\"20000\"></textarea>')}${field(tr('Lien HTTPS facultatif','Optional HTTPS link','رابط HTTPS اختياري'),input('link','','type=\"url\" maxlength=\"2000\"'))}<div class=\"mbed-exercise-fields\" hidden>${field(tr('Réponses (une par ligne)','Answers (one per line)','الإجابات (واحدة في كل سطر)'),'<textarea name=\"choices\" rows=\"4\"></textarea>')}${field(tr('Numéro de réponse correcte','Correct answer number','رقم الإجابة الصحيحة'),input('answer','1','type=\"number\" min=\"1\" max=\"6\"'))}${field(tr('Explication','Explanation','الشرح'),'<textarea name=\"explanation\" rows=\"3\" maxlength=\"3000\"></textarea>')}</div><button type=\"submit\" class=\"mbed-btn mbed-main\">${E(admin()?tr('Publier','Publish','نشر'):tr('Soumettre pour validation','Submit for approval','إرسال للاعتماد'))}</button></form>`;const catalogForm=`<form id=\"mbed-catalog\" class=\"mbed-card\"><h2>${E(tr('Ajouter au référentiel','Add to catalog','إضافة إلى الدليل'))}</h2>${field(tr('Cycle','Stage','المرحلة'),select('cycle',cycles(),'university',true,'data-mbed-catalog-cycle'))}${field(tr('Type','Type','النوع'),select('institution_type',types(),'private',true,'data-mbed-catalog-type'))}${field(tr('Établissement','Institution','المؤسسة'),input('school','','required maxlength=\"160\"'))}${field(tr('Niveau (facultatif)','Level (optional)','المستوى (اختياري)'),input('level','','maxlength=\"40\"'))}${field(tr('Filière ou série (facultatif)','Field or stream (optional)','التخصص أو الشعبة (اختياري)'),input('track','','maxlength=\"100\"'))}${field(tr('Classe (facultatif)','Class (optional)','الصف (اختياري)'),input('class_name','','maxlength=\"90\"'))}${field(tr('Matière (facultatif)','Subject (optional)','المادة (اختياري)'),input('subject','','maxlength=\"120\"'))}<button type=\"submit\" class=\"mbed-btn mbed-main\">${E(tr('Ajouter','Add','إضافة'))}</button></form>`;return `<div class=\"mbedu-page\">${back()}<h1>${E(title)}</h1><div class=\"mbed-tabs\">${[['resources',tr('Ressources','Resources','الموارد')],['groups',tr('Groupes','Groups','المجموعات')],...(admin()?[['catalog',tr('Référentiel','Catalog','الدليل')]]:[])].map(([id,t])=>`<button type=\"button\" data-mbed-action=\"staff-tab\" data-id=\"${id}\" aria-pressed=\"${staffTab===id}\">${E(t)}</button>`).join('')}</div>${staffTab==='catalog'&&admin()?catalogForm+catalog.filter(x=>!x.level&&!x.track&&!x.class_name).map(x=>`<div class=\"mbed-result\"><b>${E(x.school)}</b><small>${E(cycles().find(y=>y[0]===x.cycle)?.[1]||x.cycle)}</small></div>`).join(''):staffTab==='groups'?`${universityTeacher()&&window.MBMultiTeacher?.schools().length?button('multi-group',tr('Créer un groupe universitaire','Create a university group','إنشاء مجموعة جامعية')):universityTeacher()?`<form class=\"mbed-card\" id=\"mbed-group\"><h2>${E(tr('Créer un groupe','Create a group','إنشاء مجموعة'))}</h2>${common}${field(tr('Nom du groupe','Group name','اسم المجموعة'),input('title','','required maxlength=\"100\"'))}${field(tr('Matière','Subject','المادة'),input('subject','','required maxlength=\"120\"'))}<button class=\"mbed-btn mbed-main\" type=\"submit\">${E(tr('Créer','Create','إنشاء'))}</button></form>`:''}${MBSort.menu('uni-staff-groups')}${gr.map(g=>`<section class=\"mbed-card\"><h2>${E(g.title)}</h2><p>${E(g.school+' · '+g.level+' · '+g.subject)}</p><p>${E(tr('Code','Code','الرمز'))} : <b>${E(g.code)}</b> </p>${button('roster',tr('Voir les étudiants','View students','عرض الطلاب')+' ('+g.member_count+')',g.id)}</section>`).join('')||empty(tr('Aucun groupe.','No groups.','لا توجد مجموعات.'))}${roster?`<section class=\"mbed-card\"><h2>${E(tr('Étudiants inscrits','Enrolled students','الطلاب المسجلون'))}</h2>${roster.map(x=>`<p>${E(x.name)} · ${E(x.level+' '+x.track)}</p>`).join('')||empty()}</section>`:''}`:resourceForm+MBSort.menu('uni-staff-resources')+rows.map(r=>`<section class=\"mbed-card\"><small>${E(typeTitle(r.kind)+' · '+r.level+' · '+r.track)}</small><h2>${E(r.title)}</h2><span>${E({pending:tr('En attente','Pending','قيد الانتظار'),published:tr('Publié','Published','منشور'),archived:tr('Archivé','Archived','مؤرشف')}[r.status])}</span>${admin()&&r.status!=='published'?button('publish',tr('Approuver','Approve','اعتماد'),r.id,true):''}${admin()&&r.status==='published'?button('archive',tr('Archiver','Archive','أرشفة'),r.id):''}</section>`).join('')}${error?`<p class=\"mbed-error\">${E(error)}</p>`:''}</div>`;}\nconst oldView=view;view=function(){if(university()){if(st.screen==='student-home')return home();if(['uni-work','uni-favorites'].includes(st.screen))return work();if(st.screen==='uni-groups')return groups();}if(st.screen==='uni-staff'&&(admin()||universityTeacher()))return staff();return oldView.apply(this,arguments);};\nconst oldGo=go;go=function(s){if(university()){s=({'student-learning':'uni-work','student-exams':'uni-work','student-corrections':'uni-work','student-favorites':'uni-favorites','student-group':'uni-groups'}[s]||s);if(s==='uni-work'||s==='uni-favorites')resourceId='';}if(s==='uni-staff'&&st.screen==='teacher-groups'){staffTab='groups';staffData=null;}const r=oldGo.call(this,s);if(uniScreens.includes(s)&&s!=='uni-staff')void loadStudent();if(s==='uni-staff')void loadStaff();return r;};\nfunction nav(root){if(!university())return;root.classList.remove('mb106-student-home','mb106-more-open');root.querySelector('.mb106-home-switch')?.remove();const nav=root.querySelector('.bottomnav');if(!nav)return;const map={'student-learning':['uni-work',tr('Travailler','Study','دراسة')],'student-exams':['uni-work',tr('Travailler','Study','دراسة')],'student-favorites':['uni-favorites',tr('Favoris','Favorites','المفضلة')],'student-group':['uni-groups',tr('Mon groupe','My group','مجموعتي')]};for(const el of nav.querySelectorAll('[data-to]'))if(map[el.dataset.to]&&!el.classList.contains('mb72-center')){const [to,label]=map[el.dataset.to];el.dataset.to=to;el.classList.toggle('active',st.screen===to);el.setAttribute('aria-label',label);const span=el.querySelector('span');if(span)span.textContent=label;}const center=nav.querySelector('.mb72-center');if(center){delete center.dataset.mb72;center.dataset.act='goto';center.dataset.to='uni-work';const label=tr('Travailler','Study','دراسة');center.setAttribute('aria-label',label);const span=center.querySelector('span:last-child');if(span)span.textContent=label;center.classList.toggle('active',st.screen==='uni-work');}}\nconst oldRender=render;render=function(){reset();const r=oldRender.apply(this,arguments);const root=document.getElementById('app');if(!root)return r;mountForm(root);mountClassFilters(root);preserveAdminAcademic(root);nav(root);if((admin()||universityTeacher())&&['admin-home','teacher-home'].includes(st.screen)&&!root.querySelector('[data-mbed-action=\"staff\"]')){const p=root.querySelector('.mb-tiles')||root.querySelector('.screen');if(p)p.insertAdjacentHTML('beforeend',`<button type=\"button\" class=\"mb-tile\" data-mbed-action=\"staff\">${I('cap')}<span>${E(tr('Université','University','الجامعة'))}</span></button>`);}if(owner&&!catalogReady&&!catalogLoading)void loadCatalog();if(university()&&!studentData&&!fetching&&(!error))void loadStudent();return r;};\nconst oldLoad=loadAll;loadAll=async function(){const result=await oldLoad.apply(this,arguments);reset();await loadCatalog();if(university())await loadStudent(true);if((admin()||universityTeacher())&&['admin-home','teacher-home'].includes(st.screen))render();return result;};\nlet actionBusy=false;\ndocument.addEventListener('click',async e=>{const b=e.target.closest?.('[data-mbed-action]');if(!b)return;e.preventDefault();e.stopImmediatePropagation();const a=b.dataset.mbedAction,id=b.dataset.id;if(actionBusy)return;error='';try{if(a==='multi-group'){st.teacherOpen=true;go('teacher-groups');return}if(a==='staff'){staffTab='resources';setPage('uni-staff');return}if(a==='staff-tab'){staffTab=id;roster=null;render();return}if(a==='tab'){filter=id;resourceId='';feedback=null;if(st.screen!=='uni-work')setPage('uni-work');else render();return}if(a==='groups'){setPage('uni-groups');return}if(a==='open'){resourceId=id;feedback=null;if(!['uni-work','uni-favorites'].includes(st.screen)){const old=id;setPage('uni-work');resourceId=old;}render();actionBusy=true;await rpc('touch',{id});return}if(a==='close-resource'){resourceId='';feedback=null;render();return}actionBusy=true;if(a==='refresh'){if(st.screen==='uni-staff')await loadStaff(true);else await loadStudent(true);}else if(a==='favorite'||a==='complete'){await rpc(a,{id});await loadStudent(true)}else if(a==='publish'||a==='archive'){await rpc('resource_status',{id,status:a==='publish'?'published':'archived'});await loadStaff(true)}else if(a==='roster'){roster=await rpc('group_members',{id});render()}}catch(err){error=err.message;render()}finally{actionBusy=false}},true);\ndocument.addEventListener('change',e=>{const el=e.target;if(el.matches?.('[data-mbed-kind]')){el.closest('form').querySelector('.mbed-exercise-fields').hidden=el.value!=='interactive';}if(el.matches?.('[data-mbed-catalog-cycle]')){const s=el.closest('form').querySelector('[data-mbed-catalog-type]'),v=el.value;const type=v==='general'?[['general',tr('Général','General','عام')]]:v==='lic'?[['lic','LIC']]:types();s.innerHTML=opts(type,type[0][0]);}},true);\ndocument.addEventListener('submit',async e=>{const f=e.target;if(!['mbed-answer','mbed-join','mbed-resource','mbed-catalog','mbed-group'].includes(f.id))return;e.preventDefault();e.stopImmediatePropagation();if(actionBusy)return;actionBusy=true;error='';const submit=f.querySelector('[type=submit]');if(submit)submit.disabled=true;const d=Object.fromEntries(new FormData(f));try{if(f.id==='mbed-answer'){feedback=await rpc('answer',{id:resourceId,answer:Number(d.answer)});await loadStudent(true)}else if(f.id==='mbed-join'){await rpc('join_group',{code:d.code});await loadStudent(true)}else if(f.id==='mbed-resource'){if(!admin()&&!d.school)d.school=st.profile.school;d.choices=d.kind==='interactive'?String(d.choices||'').split('\\n').map(x=>x.trim()).filter(Boolean):[];d.answer=Number(d.answer)-1;await rpc('resource_add',d);await loadStaff(true)}else if(f.id==='mbed-catalog'){await rpc('catalog_add',d);await loadCatalog(true);render()}else if(f.id==='mbed-group'){await rpc('group_add',d);await loadStaff(true)}}catch(err){let p=f.querySelector('.mbed-error');if(!p){p=document.createElement('p');p.className='mbed-error';p.setAttribute('role','alert');f.append(p)}p.textContent=err.message;}finally{actionBusy=false;if(submit?.isConnected)submit.disabled=false;}},true);\nwindow.MBAcademic={isUniversity,schoolList,trackList,classList,initial,fieldChange,payload,semesters,gradeLabel,numberedClasses,classChoice,requestLink};\nwindow.MBSignupStudent={\n mount(host){if(!drafts.signup)drafts.signup=initial(null);host.classList.add('mbed-fields');host.dataset.context='signup';paint(host,drafts.signup)},\n clear(){delete drafts.signup},\n snapshot(){const draft={...drafts.signup};return {draft,data:payload(draft)}},\n restore(snapshot){drafts.enrollment={...snapshot.draft}},\n catalog(rows){if(Array.isArray(rows)&&rows.length){rememberCatalog([...baseCatalog,...rows]);const host=document.querySelector('#mb-signup-academic.mbed-fields');if(host)paint(host,drafts.signup)}},\n async finish(snapshot){if(st.role!=='eleve'||!st.user||EGEAccount.blocked(st.profile))throw Error('Compte élève requis.');if(!st.profile?.avatar_path)throw Error(tr('Ajoutez votre photo de profil.','Add your profile photo.','أضف صورة ملفك الشخصي.'));const uid=st.user.id,saved=await rpc('save_profile',snapshot.data);if(uid!==st.user?.id)throw Error('Session modifiée.');st.profile=saved;st.user=EGEAccount.userWithProfile(st.user,saved);drafts={};studentData=null;st.screen='student-home';await loadAll();render();}\n};\n})();\n"],"/monbac-teacher-multicycle-20261119-referentiel-r1.js":["application/javascript; charset=utf-8",false,"/* monAvenir — un enseignant, plusieurs cycles et établissements. */\n(()=>{'use strict';\nconst E=x=>esc(String(x??'')), tr=(fr,en,ar)=>({fr,en,ar}[window.MBLang?.get?.()||document.documentElement.lang]||fr), teacher=()=>st.role==='enseignant'&&st.user&&!EGEAccount.blocked(st.profile), approved=()=>teacher()&&st.teacher?.status==='approved';\nconst cycles=()=>[['university',tr('Université','University','الجامعة')],['general',tr('Lycée général','General high school','الثانوية العامة')],['lic','LIC'],['college',tr('Collège','Middle school','المرحلة الإعدادية')]];\nconst levels={college:['6e','5e','4e','3e'],general:['Seconde','Première','Terminale'],lic:['Seconde','Première','Terminale','Autre'],university:['L1','L2','L3','M1','M2','Autre']};\nconst names={college:'Collège',general:'Lycée général',lic:'Lycée LIC',university:'Université'};\nconst uni=['UNIVERSITÉ DE DJIBOUTI (UD)','IAE','ISCAE','ACADÉMIE ARABE'];\nconst streams=['GFM','OGRH','IAG','S','ES','L'];\nconst subjects=['Mathématiques','Français','Anglais','Arabe','Gestion Financière','Principes de gestion','Mercatique','Économie et Droit','Management des Organisations','OGRH','IAG','Physique et Chimie','SVT','Histoire-Géographie','Informatique','Comptabilité','Autre'];\n\nconst sg=['Gestion Financière','Mercatique','IAG','OGRH','Management des Organisations','Principes de gestion','Communication'];\nconst sci=['Physique et Chimie','SVT'];\nconst es=['SES'];\nconst common=['Mathématiques','Arabe','Anglais','Philosophie','Histoire-Géographie','Français'];\nfunction subjectGroups(o){let g;if(o.cycle==='college')g=[['Scientifique (S)',sci],['Matières communes',common.filter(x=>x!=='Philosophie')],['Informatique',['IAG']]];else if(o.level==='Seconde'&&o.cycle==='general')g=[['Matières communes',common.filter(x=>x!=='Philosophie')],['Économie et informatique',['IG','SES']]];else g=[['Sciences de gestion (SG)',sg],['Scientifique (S)',sci],['Économie et sociale (ES)',es],['Matières communes',common]];\nconst seen=new Set(g.flatMap(x=>x[1]));const extra=unique(catalog.filter(x=>x.cycle===o.cycle&&(!x.school||x.school===schoolValue(o))&&(!x.level||x.level===o.level)&&(!x.track||x.track===o.track)).map(x=>x.subject)).filter(x=>!seen.has(x));if(extra.length)g.push(['Ajouts de l’administration',extra]);return g;}\nfunction subjectText(s,o){return s==='Français'&&o.cycle!=='college'&&o.level==='Terminale'?'Français de spécialité (Terminale)':s==='Français'&&o.cycle!=='college'&&o.level==='Première'?'Français anticipé (Première)':s==='Physique et Chimie'?'Physique & Chimie':s==='Histoire-Géographie'?'Histoire & Géographie':s==='Principes de gestion'?'Principes de Gestion':s;}\nfunction subjectSelect(o,attr){if(o.cycle==='university')return select('subject',subjects,o.subject,attr+' required');return '<select class=\"select\" name=\"subject\" '+attr+' required><option value=\"\">'+E(tr('Choisir','Choose','اختر'))+'</option>'+subjectGroups(o).map(([label,list])=>'<optgroup label=\"'+E(label)+'\">'+list.map(s=>'<option value=\"'+E(s)+'\" '+(o.subject===s?'selected':'')+'>'+E(subjectText(s,o))+'</option>').join('')+'</optgroup>').join('')+'</select>';}\n\nlet owner='',rows=[],catalog=[],draft=[],selected=new Set(),loaded=false,loading=false,busy=false,group={cycle:'',index:'',name:'',semester:''};\nconst rpc=async(a,d={})=>{const r=await st.db.rpc('mon_bac_teacher_multicycle',{p_action:a,p_data:d});if(r.error)throw Error(r.error.message);return r.data;};\nconst option=(values,v)=>'<option value=\"\">'+E(tr('Choisir','Choose','اختر'))+'</option>'+values.map(x=>{const [k,l]=Array.isArray(x)?x:[x,x];return `<option value=\"${E(k)}\" ${k===v?'selected':''}>${E(l)}</option>`}).join('');\nconst select=(n,values,v,attr='')=>`<select class=\"select\" name=\"${E(n)}\" ${attr}>${option(values,v)}</select>`;\nconst field=(l,x)=>`<label class=\"mbed-field\"><span>${E(l)}</span>${x}</label>`;\nconst input=(n,v,attr='')=>`<input class=\"input\" name=\"${E(n)}\" value=\"${E(v)}\" ${attr}>`;\nconst typeLabel=()=>tr('Type d’établissement','Institution type','نوع المؤسسة');\nconst schoolLabel=()=>tr('Établissement','Institution','المؤسسة');\nconst levelLabel=()=>tr('Niveau','Level','المستوى');\nconst subjectLabel=()=>tr('Matière','Subject','المادة');\nconst cycleLabel=c=>c==='general'?tr('Lycée général','General high school','الثانوية العامة'):c==='lic'?'Lycée LIC':cycles().find(x=>x[0]===c)?.[1]||c;\nconst bucket=c=>c;\nconst unique=a=>[...new Set(a.filter(Boolean))];\nfunction reset(){if(owner===(st.user?.id||''))return;owner=st.user?.id||'';rows=[];catalog=[];draft=[];selected=new Set();loaded=false;loading=false;group={cycle:'',index:'',name:'',semester:''};}\nfunction createRow(b){return {bucket:b,cycle:b,institution_type:['general','lic'].includes(b)?b:'',school:'',schoolOther:'',level:'',track:'',subject:'',subjectOther:''};}\nfunction schools(o){let items=catalog.filter(x=>x.cycle===o.cycle&&x.institution_type===o.institution_type).map(x=>x.school);if(o.cycle==='general')items.push(...EGEAcademic.schools.filter(x=>!uni.includes(x)&&x!=='LIC'&&x!=='AUTRES'));if(o.cycle==='lic')items.push('LIC');if(o.cycle==='university')items.push(...(o.institution_type==='public'?uni.slice(0,1):uni.slice(1)));return unique(items);}\nfunction schoolValue(o){return o.school==='__other__'?o.schoolOther.trim():o.school;}\nfunction drawRow(o,i){const attr=`data-multi-row=\"${i}\"`, sel=(n,x)=>select(n,x,o[n],attr+' required'), inp=n=>input(n,o[n],attr+' required maxlength=\"160\"');let h='';if(o.cycle==='college'||o.cycle==='university')h+=field(typeLabel(),sel('institution_type',[['public',tr('Public','Public','حكومي')],['private',tr('Privé','Private','خاص')]]));if(o.cycle&&o.institution_type){h+=field(schoolLabel(),sel('school',[...schools(o),...(o.cycle==='university'&&o.institution_type==='public'?[]:[['__other__',tr('Autre…','Other…','أخرى…')]])]));if(o.school==='__other__')h+=field(schoolLabel(),inp('schoolOther'));}if(schoolValue(o))h+=field(levelLabel(),sel('level',(levels[o.cycle]||[]).map(l=>[l,MBAcademic.gradeLabel(o.cycle,l)])));if(o.level){if(o.cycle==='general'&&o.level!=='Seconde')h+=field(tr('Série','Stream','الشعبة'),sel('track',streams));if(['lic','university'].includes(o.cycle))h+=field(tr('Filière','Programme','التخصص'),inp('track'));h+=field(subjectLabel(),subjectSelect(o,attr));if(o.cycle==='university'&&o.subject==='Autre')h+=field(subjectLabel(),inp('subjectOther'));}return `<div class=\"mbed-card\" data-multi-box=\"${i}\">${h}<button type=\"button\" class=\"mbed-btn\" data-multi-remove=\"${i}\">${E(tr('Retirer','Remove','حذف'))}</button></div>`;}\nfunction picker(){return `<div id=\"mbmulti-picker\"><h2>${E(tr('Mes cycles d’enseignement','My teaching stages','مراحل التدريس'))}</h2><p class=\"mbed-muted\">${E(tr('Sélectionnez un ou plusieurs cycles. Ajoutez chaque établissement, niveau et matière.','Select one or more stages. Add each institution, level and subject.','اختر مرحلة أو أكثر، ثم أضف المؤسسات والمستويات والمواد.'))}</p><div class=\"mbed-tabs mbmulti-cycle-grid\">${cycles().map(([k,l])=>`<label class=\"mbed-field mbmulti-cycle-option\"><input type=\"checkbox\" data-multi-cycle=\"${k}\" ${selected.has(k)?'checked':''}><span>${E(l)}</span></label>`).join('')}</div>${cycles().filter(([k])=>selected.has(k)).map(([k,l])=>`<section><h3>${E(l)}</h3>${draft.map((r,i)=>r.bucket===k?drawRow(r,i):'').join('')}<button type=\"button\" class=\"mbed-btn\" data-multi-add=\"${k}\">+ ${E(tr('Ajouter un établissement, niveau ou matière','Add institution, level or subject','إضافة مؤسسة أو مستوى أو مادة'))}</button></section>`).join('')}${MBAcademic.requestLink()}</div>`;}\nfunction repaint(){const h=document.getElementById('mbmulti-picker');if(h)h.outerHTML=picker();}\nfunction normalize(){if(!selected.size||!draft.length)throw Error(tr('Choisissez au moins un cycle.','Choose at least one stage.','اختر مرحلة واحدة على الأقل.'));return draft.map(o=>{const school=schoolValue(o),subject=o.subject==='Autre'?o.subjectOther.trim():o.subject,track=o.track.trim();if(!o.cycle||!o.institution_type||school.length<2||!o.level||subject.length<2||(['university','lic'].includes(o.cycle)&&track.length<2)||(o.cycle==='general'&&o.level!=='Seconde'&&!track))throw Error(tr('Complétez chaque parcours.','Complete each teaching assignment.','أكمل كل مسار.'));return {cycle:o.cycle,institution_type:o.institution_type,school,level:o.level,track,subject};});}\nfunction list(){const sorted=MBSort.rows('teacher-assignments',rows,()=>render(),{name:r=>[r.cycle,r.subject,r.school].filter(Boolean).join(' ')});return sorted.length?`<div class=\"mbed-card\"><h2>${E(tr('Mes affectations','My teaching assignments','مهام التدريس'))}</h2>${MBSort.menu(\"teacher-assignments\")}${sorted.map(r=>`<div class=\"mbed-result\"><b>${E(cycleLabel(r.cycle)+' · '+r.subject)}</b><small>${E([r.school,r.level,r.track].filter(Boolean).join(' · '))}</small></div>`).join('')}</div>`:'';}\nfunction createForm(){const matches=rows.map((r,i)=>[r,i]).filter(([r])=>bucket(r.cycle)===group.cycle),r=rows[Number(group.index)];return `<form id=\"mbmulti-create\" class=\"mbed-card\"><h2>${E(tr('Nouvelle classe','New class','صف جديد'))}</h2>${!rows.length?`<p>${E(tr('Déclarez d’abord vos cycles et établissements.','Declare your teaching stages and institutions first.','صرّح أولاً بمراحل التدريس والمؤسسات.'))}</p><button type=\"button\" class=\"btn\" data-act=\"goto\" data-to=\"teacher-specialties\">${E(tr('Mes cycles','My teaching stages','مراحل التدريس'))}</button>`:field(tr('Cycle','Stage','المرحلة'),select('cycle',cycles(),group.cycle,'data-multi-group required'))+(group.cycle?field(tr('Établissement · niveau · matière','Institution · level · subject','المؤسسة · المستوى · المادة'),select('index',matches.map(([x,i])=>[String(i),[cycleLabel(x.cycle),x.school,MBAcademic.gradeLabel(x.cycle,x.level),x.track,x.subject].filter(Boolean).join(' · ')]),group.index,'data-multi-group required')):'')+(group.index!==''&&r?(r.cycle==='university'?field(tr('Classe ou groupe','Class or group','الصف أو المجموعة'),input('name',group.name,'data-multi-group required maxlength=\"90\" list=\"mbmulti-class-list\"'))+`<datalist id=\"mbmulti-class-list\">${[...new Set([...catalog.filter(x=>x.cycle===r.cycle&&x.school===r.school&&x.level===r.level&&(!r.track||x.track===r.track)).map(x=>x.class_name).filter(Boolean),[r.level,r.track].filter(Boolean).join(' ')])].map(x=>`<option value=\"${E(x)}\">`).join('')}</datalist>`:field(tr('Numéro de classe','Class number','رقم الصف'),select('name',MBAcademic.classChoice(r.cycle,r.level,r.track,group.name),group.name,'data-multi-group required'))+(group.name?'<p class=\"mbed-muted\"><strong>'+E(group.name)+'</strong></p>':'')+MBAcademic.requestLink())+(r.cycle==='university'?field(tr('Semestre','Semester','الفصل الدراسي'),select('semester',MBAcademic.semesters(r.level),group.semester,'data-multi-group required')):'')+`<button type=\"submit\" class=\"btn primary full\">${E(tr('Créer','Create','إنشاء'))}</button>`:'')}</form>`;}\nasync function load(){reset();if(!teacher()||!st.db||loading||loaded)return;loading=true;const uid=owner;try{const [a,b]=await Promise.all([rpc('list'),st.db.rpc('mon_bac_academic',{p_action:'catalog',p_data:{}})]);if(owner!==uid)return;rows=a||[];catalog=b.data||[];loaded=true;if(['teacher-enrollment','teacher-home','teacher-specialties','teacher-groups','profile','uni-staff'].includes(st.screen))render();}catch(e){console.warn('monAvenir teaching assignments:',e.message);}finally{if(owner===uid)loading=false;}}\nconst oldRender=render;render=function(){reset();const result=oldRender.apply(this,arguments);if(!teacher())return result;const root=document.getElementById('app');if(!root)return result;const enrollment=root.querySelector('#teacherEnrollmentForm');if(enrollment&&!enrollment.querySelector('#mbmulti-picker')){enrollment.querySelector('#teacherEnrollmentSchool')?.closest('label')?.remove();enrollment.querySelector('.mb69-specialties')?.remove();enrollment.insertAdjacentHTML('afterbegin',picker());}if(st.screen==='teacher-specialties'){const old=root.querySelector('#mb69Specialties');if(old&&!root.querySelector('#mbmulti-profile'))old.insertAdjacentHTML('beforebegin',list()+`<form id=\"mbmulti-profile\" class=\"mbed-card\">${picker()}<button type=\"submit\" class=\"btn primary full\">${E(tr('Enregistrer mes affectations','Save assignments','حفظ المهام'))}</button></form>`);}if(['profile','teacher-home'].includes(st.screen)&&!root.querySelector('#mbmulti-link')){const host=root.querySelector('.screen');host?.insertAdjacentHTML('afterbegin',`<button id=\"mbmulti-link\" class=\"btn full\" type=\"button\" data-act=\"goto\" data-to=\"teacher-specialties\">${E(tr('Mes cycles et établissements','My teaching stages and institutions','مراحل التدريس والمؤسسات'))}</button>`);}if(approved()&&st.screen==='teacher-groups'&&st.teacherOpen){const prior=root.querySelector('#teacherNewGroupForm')?.closest('section')||[...root.querySelectorAll('.mb93-card')].find(x=>x.querySelector('h2')?.textContent==='Nouvelle classe');if(prior)prior.outerHTML=createForm();else root.querySelector('.mb93-actions')?.insertAdjacentHTML('afterend',createForm());}if(approved()&&st.screen==='teacher-groups'&&rows.some(r=>r.cycle==='university'))root.querySelector('.mb93-actions')?.insertAdjacentHTML('beforeend',`<button type=\"button\" class=\"btn\" data-act=\"goto\" data-to=\"uni-staff\">${E(tr('Mes groupes universitaires','My university groups','مجموعاتي الجامعية'))}</button>`);if(!loaded&&!loading)void load();return result;};\ndocument.addEventListener('change',e=>{const el=e.target;if(el.matches('[data-multi-cycle]')){const b=el.dataset.multiCycle;if(el.checked){selected.add(b);if(!draft.some(r=>r.bucket===b))draft.push(createRow(b));}else{selected.delete(b);draft=draft.filter(r=>r.bucket!==b);}repaint();}else if(el.matches('[data-multi-row]')){const o=draft[Number(el.dataset.multiRow)];if(!o)return;const n=el.name;o[n]=el.value;if(n==='cycle'){Object.assign(o,{institution_type:el.value==='general'?'general':'lic',school:'',schoolOther:'',level:'',track:'',subject:'',subjectOther:''});}if(n==='institution_type')Object.assign(o,{school:'',schoolOther:'',level:'',track:'',subject:'',subjectOther:''});if(n==='school')Object.assign(o,{schoolOther:'',level:'',track:'',subject:'',subjectOther:''});if(n==='level')Object.assign(o,{track:'',subject:'',subjectOther:''});if(n==='track'&&o.cycle!=='university')Object.assign(o,{subject:'',subjectOther:''});if(el.tagName==='SELECT')repaint();else if(n==='schoolOther')repaint();}else if(el.matches('[data-multi-group]')){group[el.name]=el.value;if(el.name==='cycle'){group.index='';group.name='';group.semester='';}if(el.name==='index'){group.name='';group.semester='';}if(el.tagName==='SELECT')document.getElementById('mbmulti-create').outerHTML=createForm();}},true);\ndocument.addEventListener('input',e=>{const el=e.target;if(el.matches('input[data-multi-row]')){const o=draft[Number(el.dataset.multiRow)];if(o)o[el.name]=el.value;}if(el.matches('input[data-multi-group]'))group[el.name]=el.value;},true);\ndocument.addEventListener('click',e=>{const add=e.target.closest('[data-multi-add]'),del=e.target.closest('[data-multi-remove]');if(!add&&!del)return;e.preventDefault();e.stopImmediatePropagation();if(add)draft.push(createRow(add.dataset.multiAdd));else{const i=Number(del.dataset.multiRemove),b=draft[i]?.bucket;draft.splice(i,1);if(!draft.some(r=>r.bucket===b))selected.delete(b);}repaint();},true);\ndocument.addEventListener('submit',async e=>{const f=e.target;if(!['teacherEnrollmentForm','mbmulti-profile','mbmulti-create'].includes(f.id)||!teacher()||!f.querySelector('#mbmulti-picker')&&f.id!=='mbmulti-create')return;e.preventDefault();e.stopImmediatePropagation();if(busy||st.profilePhotoUploading)return;busy=true;const b=f.querySelector('[type=submit]');if(b)b.disabled=true;try{if(f.id==='mbmulti-create'){const r=rows[Number(group.index)];if(group.index===''||!r)throw Error(tr('Choisissez une affectation.','Choose an assignment.','اختر مهمة تدريس.'));await rpc('create',{...r,name:group.name,semester:group.semester});st.teacherOpen=false;group={cycle:'',index:'',name:'',semester:''};await loadAll();if(r.cycle==='university')go('uni-staff');else render();toast(tr('Classe créée.','Class created.','تم إنشاء الصف.'));}else{const result=await rpc('save',{rows:normalize()});rows=result.assignments||[];loaded=true;draft=[];selected=new Set();if(f.id==='teacherEnrollmentForm'){st.teacher=result.request;st.profile={...st.profile,school:result.request.school};st.user=EGEAccount.userWithProfile(st.user,st.profile);st.screen='teacher-home';}await loadAll();render();toast(tr('Affectations enregistrées.','Assignments saved.','تم حفظ المهام.'));}}catch(err){let h=f.querySelector('.mbmulti-error');if(!h){h=document.createElement('p');h.className='mbed-error mbmulti-error';h.setAttribute('role','alert');f.append(h);}h.textContent=err.message;}finally{busy=false;if(b?.isConnected)b.disabled=false;}},true);\nwindow.MBMultiTeacher={schools:()=>unique(rows.filter(r=>r.cycle==='university').map(r=>r.school)),rows:()=>rows.slice()};\nwindow.MBSignupTeacher={\n mount(host){host.innerHTML=picker()},\n clear(){if(!st.user){draft=[];selected=new Set()}},\n snapshot(){return {draft:draft.map(r=>({...r})),selected:[...selected],data:normalize()}},\n restore(snapshot){draft=snapshot.draft.map(r=>({...r}));selected=new Set(snapshot.selected)},\n catalog(data){if(Array.isArray(data)&&data.length){catalog=data;const host=document.querySelector('#mb-signup-academic');if(host&&host.querySelector('#mbmulti-picker'))repaint()}},\n async finish(snapshot){if(!teacher())throw Error('Compte enseignant requis.');if(!st.profile?.avatar_path)throw Error(tr('Ajoutez votre photo de profil.','Add your profile photo.','أضف صورة ملفك الشخصي.'));const uid=st.user.id,result=await rpc('save',{rows:snapshot.data});if(uid!==st.user?.id)throw Error('Session modifiée.');rows=result.assignments||[];loaded=true;draft=[];selected=new Set();st.teacher=result.request;st.profile={...st.profile,school:result.request.school};st.user=EGEAccount.userWithProfile(st.user,st.profile);st.screen='teacher-home';await loadAll();render();toast(tr('Affectations enregistrées.','Assignments saved.','تم حفظ المهام.'));}\n};\n})();\n"],"/monbac-single-signup-20261119-referentiel-r1.js":["application/javascript; charset=utf-8",false,"/* monAvenir — inscription sur un seul formulaire, parcours et contrôles inchangés. */\n(()=>{'use strict';\nconst oldRender=render,oldLogin=doLogin;\nlet photo=null,lastRole='',submitting=false,catalogAttempt=false,publicCatalog=null;\nconst tr=(fr,en,ar)=>({fr,en,ar}[window.MBLang?.get?.()||document.documentElement.lang]||fr);\nconst isSignup=()=>!st.user&&st.screen==='auth'&&st.mode==='signup'&&['eleve','enseignant'].includes(st.desired)&&!st.pendingPasswordReset&&!st.phoneEmailFallback;\nconst current=()=>st.desired==='enseignant'?window.MBSignupTeacher:window.MBSignupStudent;\nfunction clear(){photo=null;lastRole='';window.MBSignupStudent?.clear();window.MBSignupTeacher?.clear()}\nfunction statusFile(f){const node=document.getElementById('mb-signup-photo-name');if(node)node.textContent=f?.name||tr('JPG, PNG ou WebP','JPG, PNG or WebP','JPG أو PNG أو WebP');const input=document.getElementById('mb-signup-photo');if(input)input.required=!photo}\nfunction applyCatalog(){if(!publicCatalog||!isSignup())return;current().catalog(publicCatalog)}\n// Only use the existing public directory before login. The full academic catalogue stays private.\nfunction directoryOptions(rows){const out=[];for(const r of rows||[]){const school=String(r.school||'').trim(),cl=String(r.name||'').trim();if(!school||!cl)continue;const up=cl.toUpperCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'');let m=up.match(/^(T|TERMINALE[ ]*)(GFM|OGRH|IAG|ES|S|L)(?:[ ]?[0-9]{1,2})?$/);if(m){out.push({cycle:'general',institution_type:'general',school,level:'Terminale',track:m[2],class_name:cl});continue}m=up.match(/^(1|PREMIERE[ ]*)(GFM|OGRH|IAG|ES|S|L)(?:[ ]?[0-9]{1,2})?$/);if(m){out.push({cycle:'general',institution_type:'general',school,level:'Première',track:m[2],class_name:cl});continue}if(/^SECONDE(?: |$)/.test(up)){out.push({cycle:'general',institution_type:'general',school,level:'Seconde',track:'',class_name:cl});continue}const grade=cl.match(/^([6789])e année(?:\\s|$)/i);m=grade?[grade[0],({'6':'6e','7':'5e','8':'4e','9':'3e'})[grade[1]]]:cl.match(/^([6543]e)(?:\\s|$)/i);const sk=school.normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase(),type=sk.includes('prive')?'private':sk.includes('public')?'public':'';if(m&&type&&sk.includes('college'))out.push({cycle:'college',institution_type:type,school,level:m[1].toLowerCase(),class_name:cl})}return out}\nasync function fetchCatalog(){if(catalogAttempt||!st.db||!navigator.onLine)return;catalogAttempt=true;try{const [r,c]=await Promise.all([st.db.rpc('mon_bac_class_directory'),st.db.from('mon_bac_signup_catalog').select('cycle,institution_type,school,level,track,class_name,subject')]);publicCatalog=[...(!r.error&&Array.isArray(r.data)?directoryOptions(r.data):[]),...(!c.error&&Array.isArray(c.data)?c.data:[])];applyCatalog()}catch{}}\nfunction mount(){\n const form=document.querySelector('#authForm[data-phone-auth]');if(!form||form.dataset.mbSignup)return;\n const role=st.desired,teacher=role==='enseignant',card=form.closest('.login-card');if(!card)return;\n lastRole=role;form.dataset.mbSignup='1';card.classList.add('mb-signup-card');card.closest('.ege-auth-stage')?.classList.add('mb-signup-stage');\n const badge=card.querySelector('.login-badge');if(badge)badge.hidden=true;\n const title=card.querySelector('h1');if(title)title.textContent=tr('Créer un compte','Create an account','إنشاء حساب');\n const intro=card.querySelector('h1 + p');if(intro)intro.textContent=tr('Inscrivez-vous en quelques instants.','Register in a few moments.','سجّل في لحظات.');\n const roles=document.createElement('div');roles.className='mb-signup-roles';roles.setAttribute('role','group');roles.setAttribute('aria-label',tr('Votre profil','Your profile','ملفك الشخصي'));\n for(const [key,label] of [['eleve',tr('Élève','Student','طالب')],['enseignant',tr('Enseignant','Teacher','معلّم')]]){const b=document.createElement('button');b.type='button';b.dataset.mbSignupRole=key;b.textContent=label;b.setAttribute('aria-pressed',String(key===role));roles.append(b)}\n form.before(roles);\n const note=form.querySelector('.phone-auth-note'),privacy=form.querySelector('.signup-privacy-note'),submit=form.querySelector('[type=submit]');\n const identity=document.createElement('div');identity.className='mb-signup-identity';for(const id of ['authFullName','authWhatsApp','authPassword','authPasswordConfirm']){const input=document.getElementById(id),field=input?.closest('.field');if(field)identity.append(field)}form.prepend(identity);\n const phone=form.querySelector('#authWhatsApp')?.closest('.field');if(phone){const span=phone.querySelector('span');if(span)span.textContent=tr('Téléphone / WhatsApp','Phone / WhatsApp','الهاتف / واتساب');}\n const section=document.createElement('section');section.className='mb-signup-section';\n const heading=document.createElement('h2');heading.textContent=teacher?tr('Votre enseignement','Your teaching','التدريس'):tr('Votre scolarité','Your studies','الدراسة');section.append(heading);\n const host=document.createElement('div');host.id='mb-signup-academic';section.append(host);\n const help=document.createElement('p');help.className='mb-signup-help';help.textContent=teacher?tr('Votre demande sera validée par l’administration.','Your application will be approved by the administration.','ستوافق الإدارة على طلبك.'):tr('Rejoignez votre enseignant plus tard avec son code.','Join your teacher later using their code.','انضم إلى معلّمك لاحقًا باستخدام رمزه.');section.append(help);\n identity.after(section);current().mount(host);applyCatalog();void fetchCatalog();\n const photoRow=document.createElement('label');photoRow.className='mb-signup-photo';photoRow.htmlFor='mb-signup-photo';const label=document.createElement('span');label.className='mb-signup-photo-label';label.textContent=tr('Photo de profil','Profile photo','الصورة الشخصية')+' ('+tr('obligatoire','required','إلزامية')+')';const input=document.createElement('input');input.type='file';input.id='mb-signup-photo';input.accept='image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp';input.required=!photo;const info=document.createElement('small');info.id='mb-signup-photo-name';photoRow.append(label,input,info);section.after(photoRow);statusFile(photo);\n if(note)note.classList.add('mb-signup-note');if(privacy)privacy.classList.add('mb-signup-note');\n if(submit){submit.textContent=tr('Créer mon compte','Create my account','إنشاء حسابي');submit.classList.add('mb-signup-submit')}\n}\nrender=function(){const result=oldRender.apply(this,arguments);if(isSignup())mount();else if(!submitting&&lastRole)clear();return result};\ndocument.addEventListener('change',e=>{if(e.target.id!=='mb-signup-photo')return;const f=e.target.files?.[0];photo=null;e.target.setCustomValidity('');if(f){try{EGEAccount.photo.check(f);photo=f}catch(err){e.target.setCustomValidity(err.message);e.target.reportValidity()}}statusFile(photo)},true);\ndocument.addEventListener('click',e=>{const b=e.target.closest?.('[data-mb-signup-role]');if(!b||!isSignup()||st.busy)return;e.preventDefault();e.stopImmediatePropagation();const role=b.dataset.mbSignupRole;if(!['eleve','enseignant'].includes(role)||role===st.desired)return;\n const values={};for(const id of ['authFullName','authWhatsApp','authPassword','authPasswordConfirm'])values[id]=document.getElementById(id)?.value||'';st.desired=role;render();for(const id of Object.keys(values)){const input=document.getElementById(id);if(input)input.value=values[id]}\n},true);\nfunction overlay(){const d=document.createElement('div');d.id='mb-signup-progress';d.setAttribute('role','status');d.setAttribute('aria-live','polite');d.innerHTML='<div class=\"mb-signup-progress-inner\"><i></i><strong></strong><small></small></div>';d.querySelector('strong').textContent=tr('Création de votre compte…','Creating your account…','جارٍ إنشاء حسابك…');d.querySelector('small').textContent=tr('Patientez quelques instants.','Please wait a moment.','يرجى الانتظار قليلاً.');document.body.append(d);return d}\ndoLogin=async function(mode){\n if(mode!=='signup'||!isSignup()||!document.querySelector('#authForm[data-mb-signup]'))return oldLogin(mode);\n const role=st.desired,helper=current(),snapshot=helper.snapshot(),chosen=photo;\n if(!chosen)throw Error(tr('Ajoutez votre photo de profil.','Add your profile photo.','أضف صورة ملفك الشخصي.'));\n if(chosen)await EGEAccount.photo.jpeg(chosen); // same image validation as authenticated upload, before account creation\n submitting=true;const progress=overlay();\n try{\n  await oldLogin(mode);\n  if(!st.user||st.role!==role||!st.profile||EGEAccount.blocked(st.profile))throw Error(tr('Impossible de terminer l’inscription.','Unable to finish registration.','تعذّر إكمال التسجيل.'));\n  helper.restore(snapshot);\n  if(chosen)await EGEProfileMedia.changePhoto(chosen);\n  await helper.finish(snapshot);\n  photo=null;lastRole='';\n }catch(err){\n  // If the account exists, do not retry account creation: the existing recovery/onboarding form retains the choices.\n  if(st.user&&st.role===role&&st.profile&&!EGEAccount.blocked(st.profile)&&((role==='eleve'&&!st.profile.class_onboarding_done_at)||(role==='enseignant'&&!st.teacher))){\n   helper.restore(snapshot);st.screen=role==='eleve'?'student-enrollment':'teacher-enrollment';render();\n   const node=document.getElementById(role==='eleve'?'phoneEnrollmentError':'teacherEnrollmentError');if(node){node.hidden=false;node.textContent=tr('Compte créé. Terminez votre inscription ci-dessous : ','Account created. Complete registration below: ','تم إنشاء الحساب. أكمل التسجيل أدناه: ')+(err.message||'');}\n   photo=null;lastRole='';\n  }\n  throw err;\n }finally{progress.remove();submitting=false}\n};\n})();"],"/monavenir-logo.png":["image/png",true,""],"/monavenir-icon-192.png":["image/png",true,""],"/monavenir-icon-512.png":["image/png",true,""],"/mon-bac-v96-welcome-maquette3-20261119-avenir-brand-r1.js":["application/javascript; charset=utf-8",false,"/* V96 — accueil épuré, accès unique, identité rouge et blanc pour tous. */\n(()=>{'use strict';\nconst previousWelcome=welcome,previousAuth=auth,previousLogin=doLogin,previousProfile=profile,previousRender=render;\nconst brand=()=>`<div class=\"mb96-brand\"><img class=\"monavenir-wordmark\" src=\"/monavenir-logo.png\" alt=\"monAvenir\" width=\"780\" height=\"166\"></div>`;\nconst back=()=>`<button type=\"button\" class=\"mb96-back\" data-act=\"goto\" data-to=\"welcome\" aria-label=\"Retour à l’accueil\">${I('left')}</button>`;\nconst action=(key,label,cls='')=>`<button type=\"button\" class=\"${cls}\" data-mb96=\"${key}\">${label}</button>`;\nconst premium=slot=>egeAdFor(slot)?adBanner(slot):'';\nwelcome=function(){if(st.user)return previousWelcome();const advert=premium(\"home\");return `<div class=\"mb96-welcome mb96-welcome-new\">${brand()}<div class=\"mb96-shortcut-grid\"><a class=\"mb96-support\" href=\"/annonces.html?onglet=soutien\">${I('cap')}<span>Cours de soutien</span></a><button type=\"button\" class=\"mb96-install\" data-act=\"install\">${I('download')}<span>Installer l’app</span></button></div><img class=\"mb96-hero\" src=\"./monbac-welcome-maquette3-20261119.webp\" width=\"840\" height=\"461\" alt=\"Jeunes élèves et étudiant à Djibouti, avec leurs livres\"><div class=\"mb96-welcome-title\"><h1>Construis ton avenir dès aujourd’hui.</h1><p class=\"mb96-tagline\">Du collège à l’université.</p></div><div class=\"mb96-ctas\">${action('login','Se connecter','btn primary full')}${action('signup','Créer un compte','btn mb96-outline full')}</div>${advert?`<section class=\"mb96-ad-section\"><p class=\"mb96-ad-heading\">À découvrir</p>${advert}</section>`:\"\"}</div>`};\nfunction loginScreen(){\n st.desired='eleve';\n const t=document.createElement('template');t.innerHTML=previousAuth();const passkey=t.content.querySelector('.mb90-access');\n if(passkey){const b=passkey.querySelector('[data-mb90=\"login\"]');if(b){const icon=b.querySelector('svg');b.textContent='Connexion par empreinte';if(icon)b.prepend(icon)}const small=passkey.querySelector('small');if(small)small.textContent='Sur appareil compatible';}\n return `<section class=\"mb96-auth-card\">${back()}${brand()}<h1>Connexion</h1><form id=\"authForm\" class=\"ege-forms mb96-form\"><label class=\"field\"><span>E-mail ou téléphone</span><input class=\"input\" id=\"mb96Identifier\" name=\"username\" type=\"text\" autocomplete=\"username\" autocapitalize=\"none\" spellcheck=\"false\" required placeholder=\"Votre e-mail ou numéro\"></label><input id=\"authEmail\" type=\"hidden\"><input id=\"authWhatsApp\" type=\"hidden\"><div class=\"field\"><label class=\"password-label\" for=\"authPassword\">Mot de passe</label><div class=\"password-wrap\"><input class=\"input\" id=\"authPassword\" name=\"password\" type=\"password\" required maxlength=\"72\" autocomplete=\"current-password\" placeholder=\"Votre mot de passe\"><button type=\"button\" class=\"password-toggle\" data-act=\"toggle-password\" data-target=\"authPassword\" aria-pressed=\"false\" aria-label=\"Afficher le mot de passe\">${I('eye')}</button></div></div>${action('forgot','Mot de passe oublié ?','mb96-forgot')}<button type=\"submit\" class=\"btn primary full\">Se connecter</button></form>${passkey?.outerHTML||''}<p class=\"mb96-switch\">Pas encore de compte ? ${action('signup','Créer un compte')}</p>${premium('auth')}</section>`;\n}\nauth=function(){if(st.user||st.pendingPasswordReset)return previousAuth();if(st.mode==='login')return loginScreen();if(st.mode==='choose-role')return `<section class=\"mb96-auth-card\">${back()}${brand()}<h1>Créer un compte</h1><p class=\"mb96-tagline\">Choisissez votre espace.</p><div class=\"mb96-role-list\">${action('eleve',I('cap')+' Élève '+I('chevron'),'btn mb96-outline full')}${action('enseignant',I('users')+' Enseignant '+I('chevron'),'btn mb96-outline full')}</div><p class=\"mb96-switch\">Déjà inscrit ? ${action('login','Se connecter')}</p></section>`;\n if(st.mode==='forgot')return `<section class=\"mb96-auth-card\">${back()}${brand()}<h1>Mot de passe oublié ?</h1><p class=\"mb96-tagline\">Comment avez-vous créé votre compte ?</p><div class=\"mb96-role-list\">${action('forgot-email','Avec mon e-mail','btn mb96-outline full')}${action('forgot-phone','Avec mon téléphone','btn mb96-outline full')}</div>${action('login','Retour à la connexion','mb96-forgot')}</section>`;\n return previousAuth();};\ndoLogin=async function(mode){const input=$('mb96Identifier');if(mode!=='login'||!input)return previousLogin(mode);const value=input.value.trim();st.desired='eleve';st.phoneEmailFallback=value.includes('@');$('authEmail').value=st.phoneEmailFallback?value:'';$('authWhatsApp').value=st.phoneEmailFallback?'':value;return previousLogin(mode)};\n// Keep original recovery flows; they depend on the account's original identifier.\nlet recovery=null;\nconst unifiedAuth=auth;\nauth=function(){if(st.mode==='forgot'&&recovery&&!st.user){return previousAuth()}return unifiedAuth()};\nfunction start(mode,role='eleve'){recovery=null;st.desired=role;st.mode=mode;st.phoneEmailFallback=false;st.lastError='';st.screen='auth';render()}\nfunction profileMenu(html){const t=document.createElement('template');t.innerHTML=html;const card=t.content.querySelector('.mb91-identity'),panel=card?.querySelector('.profile-photo-panel'),input=panel?.querySelector('#profilePhotoFile');if(!input)return html;\n const remove=panel.querySelector('[data-profile-photo-remove]'),state=panel.querySelector('#profilePhotoState');const pencil=document.createElement('button');pencil.type='button';pencil.className='mb96-photo-pencil';pencil.dataset.mb96='photo-menu';pencil.setAttribute('aria-label','Gérer ma photo de profil');pencil.setAttribute('aria-expanded','false');pencil.innerHTML=I('edit');panel.append(pencil);input.closest('label').hidden=true;\n const menu=document.createElement('div');menu.className='mb96-photo-menu';menu.hidden=true;menu.innerHTML=action('photo-choose',st.profile?.avatar_path?'Modifier la photo':'Ajouter une photo','btn');if(remove)menu.append(remove);card.append(menu);if(state)card.append(state);return t.innerHTML;\n}\nprofile=function(){return profileMenu(previousProfile())};\nrender=function(){const result=previousRender(),host=$('app');if(!host)return result;if(!st.user&&st.screen==='welcome'){host.classList.add('mb96-public');for(const duplicate of host.querySelectorAll('.mb91-shortcuts,.mb96-public-extra,[data-mb91=\"directory\"]'))duplicate.remove();const footer=host.querySelector('.privacy-footer');if(footer){footer.classList.add('mb96-compact-footer');footer.innerHTML='<span>© '+new Date().getFullYear()+' monAvenir</span><span aria-hidden=\"true\">·</span><a href=\"/confidentialite.html\" data-act=\"goto\" data-to=\"privacy\">Confidentialité</a><span aria-hidden=\"true\">·</span><span>Jana Galeh</span>';}}if(!st.user&&st.screen==='auth'&&host.querySelector('.mb96-auth-card'))host.classList.add('mb96-auth');return result};\ndocument.addEventListener('click',e=>{const b=e.target.closest?.('[data-mb96]');if(!b||st.busy)return;const key=b.dataset.mb96;e.preventDefault();if(key==='photo-menu'){const menu=b.closest('.mb91-identity')?.querySelector('.mb96-photo-menu');if(menu){menu.hidden=!menu.hidden;b.setAttribute('aria-expanded',String(!menu.hidden));}return}if(key==='photo-choose'){$('profilePhotoFile')?.click();return}if(st.user)return;if(key==='login')start('login');else if(key==='signup')start('choose-role');else if(key==='eleve'||key==='enseignant')start('signup',key);else if(key==='forgot')start('forgot');else if(key==='forgot-email'||key==='forgot-phone'){recovery=key;st.phoneEmailFallback=key==='forgot-email';st.mode='forgot';render()}});\ndocument.addEventListener('click',e=>{const b=e.target.closest?.('[data-act=\"mode\"],[data-to=\"welcome\"]');if(!b)return;if(b.dataset.mode==='login'||b.dataset.to==='welcome')recovery=null;},true);\n})();\n"],"/ege-header-avenir-brand-r1.js":["application/javascript; charset=utf-8",false,"/* Fenêtres monAvenir communes : confirmation, résultat et saisie, sans dialogue navigateur. */\n(()=>{'use strict';\n const icons={confirm:'<path d=\"M10 4H4v16h6M13 8l4 4-4 4m-8-4h12\"/>',success:'<path d=\"m5 12 4 4 10-10\"/>',error:'<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6m0 4h.01\"/>',info:'<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6m0-10h.01\"/>',warning:'<path d=\"M12 3 2 21h20L12 3Zm0 6v5m0 3h.01\"/>'};\n let active=false;const queue=[];\n function next(){if(active||!queue.length)return;active=true;const {options:o,resolve}=queue.shift(),focus=document.activeElement,d=document.createElement('dialog');d.className='mb98-dialog mb98-'+o.kind;d.setAttribute('aria-labelledby','mb98-title');d.setAttribute('aria-describedby','mb98-text');\n  d.innerHTML=`<div class=\"mb98-mark\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">${icons[o.kind]||icons.info}</svg></div><h2 id=\"mb98-title\"></h2><p id=\"mb98-text\"></p><div class=\"mb98-input-wrap\" hidden><input class=\"mb98-input\" type=\"text\" aria-label=\"Votre réponse\"></div><div class=\"mb98-actions\"><button class=\"mb98-cancel\" type=\"button\"></button><button class=\"mb98-primary\" type=\"button\"></button></div>`;\n  d.querySelector('h2').textContent=o.title;d.querySelector('p').textContent=o.message;const cancel=d.querySelector('.mb98-cancel'),ok=d.querySelector('.mb98-primary'),input=d.querySelector('input');cancel.textContent=o.cancel||'Annuler';ok.textContent=o.action||'Compris';cancel.hidden=!o.choice;d.querySelector('.mb98-input-wrap').hidden=!o.input;if(o.input){input.value=o.value||'';input.setAttribute('aria-label',o.message)}\n  let finished=false;function finish(value){if(finished)return;finished=true;d.close();d.remove();if(focus?.isConnected)focus.focus();active=false;resolve(value);queueMicrotask(next)}\n  const declined=o.input?null:false;cancel.addEventListener('click',()=>finish(declined));ok.addEventListener('click',()=>finish(o.input?input.value:true));d.addEventListener('cancel',e=>{e.preventDefault();finish(declined)});d.addEventListener('close',()=>finish(declined));input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();finish(input.value)}});document.body.append(d);d.showModal();(o.input?input:o.choice?cancel:ok).focus();\n }\n function show(options){return new Promise(resolve=>{queue.push({options,resolve});next()})}\n function confirm(message,custom={}){const raw=String(message);const logout=/déconnecter de monAvenir/i.test(raw),associate=/Autoriser l'enseignant de cette classe|Associer le dossier/i.test(raw),danger=/supprimer|effacer|archiver|suspendre|retirer|quitter|remplac/i.test(raw);const title=logout?'Se déconnecter ?':associate?'Associer le dossier ?':raw.split('?')[0].length<65&&raw.includes('?')?raw.split('?')[0].trim()+' ?':'Confirmer l’action';const body=logout?'Voulez-vous quitter votre espace monAvenir ?':raw;return show({kind:logout?'confirm':danger?'warning':'info',title,message:body,choice:true,action:logout?'Se déconnecter':associate?'Associer':'Confirmer',...custom})}\n function prompt(message,value=''){return show({kind:'info',title:'Votre réponse',message:String(message),input:true,value:String(value??''),choice:true,action:'Valider'})}\n function notice(title,message,kind='info'){return show({kind,title,message:String(message),choice:false,action:kind==='error'?'Fermer':'Compris'})}\n window.MBDialog=Object.freeze({show,confirm,prompt,notice});\n})();\n/* En-tête EGE commun : aucune bibliothèque et aucun nouveau client de connexion. */\n(()=>{'use strict';\nconst subtitle='Votre réussite, étape par étape';\nconst escape=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nlet identity={id:'',name:'',path:'',db:null},identityTicket=0,lastHome=false;\nconst initials=name=>String(name||'Mon compte').trim().split(/\\s+/).slice(0,2).map(x=>x[0]||'').join('').toUpperCase();\nlet handlers={},logged=false,busy=false,legacyButton=null,returnFocus=null;\nlet fallbackInstallPrompt=null,nativelyInstalled=false,installReturnFocus=null;\nconst isInstalled=()=>nativelyInstalled||window.matchMedia?.('(display-mode: standalone)')?.matches===true||navigator.standalone===true;\nfunction refreshHeaderInstall(){document.querySelectorAll('[data-ege-header=install]').forEach(button=>{button.hidden=isInstalled()})}\nconst installIcon='<svg viewBox=\"0 0 24 24\" width=\"19\" height=\"19\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3v13m-5-5 5 5 5-5M4 20h16\"/></svg>';\nfunction configure(next){handlers=next||{}}\nfunction footer({showPrivacy=true,legacy=false}={}){return `<footer class=\"privacy-footer${legacy?' ege-legacy-footer':''}\"><div class=\"ege-footer-identity\"><p class=\"ege-copyright\">© ${new Date().getFullYear()} monAvenir — Tous droits réservés.</p><p class=\"ege-design-credit\">Conçu par <span>Jana Galeh</span></p></div>${showPrivacy?`<a href=\"/confidentialite.html\"${legacy?'':' data-act=\"goto\" data-to=\"privacy\"'}>Confidentialité et données personnelles</a>`:''}</footer>`}\n\nfunction markup({signedIn=false,home=false,userName='',avatarPath='',userId='',db=null}={}){\n logged=!!signedIn;lastHome=home;\n if(logged&&userId)identity={id:userId,name:userName||'Mon compte',path:avatarPath||'',db};\n if(!logged){identity={id:'',name:'',path:'',db:null};window.EGEAccount?.photo?.clear()}\n const account=logged?`<div class=\"ege-header-person\"><span class=\"ege-header-avatar\"><span class=\"ege-header-initials\">${escape(initials(identity.name))}</span>${identity.path?`<img data-ege-avatar-path=\"${escape(identity.path)}\" alt=\"Photo de profil\" hidden>`:''}</span><div class=\"ege-header-usertext\"><span class=\"ege-header-name\">${escape(identity.name||'Mon compte')}</span><button type=\"button\" class=\"ege-header-auth\" data-ege-header=\"logout\">Se déconnecter</button></div></div>`:`<button type=\"button\" class=\"ege-header-auth\" data-ege-header=\"login\">Se connecter</button>`;\n const install=`<button type=\"button\" class=\"ege-header-install${home&&!logged?' ege-header-install--label':''}\" data-ege-header=\"install\" aria-label=\"Installer l’App\" title=\"Installer l’App\" ${isInstalled()?'hidden':''}>${installIcon}<span class=\"ege-header-install-label\">Installer l’App</span></button>`;\n return `<header class=\"app-header ege-shared-header${home?' ege-header-home':''}\"><a class=\"brand\" href=\"/\" data-ege-header=\"home\" aria-label=\"Accueil monAvenir\"><span class=\"brandmark\"><img src=\"/monavenir-icon-192.png\" width=\"40\" height=\"40\" alt=\"\"></span><span class=\"ege-brand-text\"><span class=\"brandname\"><img class=\"monavenir-wordmark\" src=\"/monavenir-logo.png\" alt=\"monAvenir\" width=\"780\" height=\"166\"></span><span class=\"brand-sub\">${subtitle}</span></span></a><div class=\"ege-header-actions\">${home&&!logged?'':account}${install}</div></header>`;\n}\nasync function refresh(){\n const id=identity.id,path=identity.path,db=identity.db;if(!logged||!id||!path||!db||!navigator.onLine)return;\n const image=document.querySelector('.ege-shared-header [data-ege-avatar-path]');if(!image)return;\n try{const url=await EGEAccount.photo.signed(db,path);if(!url||!image.isConnected||identity.id!==id||identity.path!==path)return;image.onerror=()=>{image.hidden=true;const text=image.parentElement?.querySelector('.ege-header-initials');if(text)text.hidden=false};image.src=url;image.hidden=false;const text=image.parentElement?.querySelector('.ege-header-initials');if(text)text.hidden=true}catch(_){}\n}\nfunction replaceHeader(){const current=document.querySelector('.ege-shared-header');if(!current)return;current.outerHTML=markup({signedIn:logged,home:lastHome,userName:identity.name,userId:identity.id,avatarPath:identity.path,db:identity.db});refresh()}\nasync function setUser(user,db){const ticket=++identityTicket;if(!user){setSignedIn(false);return}identity={id:user.id,name:user.user_metadata?.full_name||'Mon compte',path:'',db};logged=true;replaceHeader();if(!db||!navigator.onLine)return;try{const p=await EGEAccount.current(db);if(ticket!==identityTicket||identity.id!==user.id||(p.user_id&&p.user_id!==user.id))return;identity={id:user.id,name:p.full_name||identity.name,path:EGEAccount.blocked(p)?'':p.avatar_path||'',db};replaceHeader()}catch(_){} }\nfunction installInstructions(){\n let d=document.getElementById('egeHeaderInstallDialog');if(!d){d=document.createElement('dialog');d.id='egeHeaderInstallDialog';d.className='ege-help-dialog';d.setAttribute('aria-labelledby','egeHeaderInstallTitle');d.innerHTML='<div class=\"ege-help-heading\"><h2 id=\"egeHeaderInstallTitle\">Installer l’App</h2><button type=\"button\" class=\"ege-help-close\" data-ege-header=\"install-close\" aria-label=\"Fermer\">×</button></div><p id=\"egeHeaderInstallText\"></p><button type=\"button\" class=\"btn primary full\" data-ege-header=\"install-close\">Compris</button>';d.addEventListener('close',()=>installReturnFocus?.isConnected&&installReturnFocus.focus());document.body.append(d)}\n const ios=/iPad|iPhone|iPod/.test(navigator.userAgent)||navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1;\n d.querySelector('p').textContent=ios?'Sur iPhone ou iPad : ouvrez EGE 2027 dans Safari, appuyez sur Partager, choisissez « Sur l’écran d’accueil », puis « Ajouter ».':/Android/i.test(navigator.userAgent)?'Sur Android : ouvrez EGE 2027 dans Chrome, appuyez sur le menu ⋮, puis sur « Installer l’application » ou « Ajouter à l’écran d’accueil ». Depuis un navigateur intégré, ouvrez d’abord le lien dans Chrome.':'Dans Chrome ou Edge, utilisez l’option « Installer l’application » de la barre d’adresse ou du menu du navigateur.';\n if(!d.open)d.showModal();\n}\nasync function installApp(target){\n installReturnFocus=target;\n if(typeof installEGE==='function'){await installEGE();return}\n const old=document.getElementById('egeInstallButton');if(old){old.click();return}\n if(isInstalled()){refreshHeaderInstall();return}\n if(fallbackInstallPrompt){const prompt=fallbackInstallPrompt;fallbackInstallPrompt=null;try{await prompt.prompt();await prompt.userChoice;return}catch(_){}}\n installInstructions();\n}\nwindow.addEventListener('beforeinstallprompt',event=>{if(!document.getElementById('app')&&!document.getElementById('egeInstallButton')){event.preventDefault();fallbackInstallPrompt=event;refreshHeaderInstall()}});\nwindow.addEventListener('appinstalled',()=>{nativelyInstalled=true;fallbackInstallPrompt=null;document.getElementById('egeHeaderInstallDialog')?.close();refreshHeaderInstall()});\nwindow.matchMedia?.('(display-mode: standalone)')?.addEventListener?.('change',refreshHeaderInstall);\nfunction dialog(){\n let d=document.getElementById('egeHeaderHelpDialog');if(d)return d;\n d=document.createElement('dialog');d.id='egeHeaderHelpDialog';d.className='ege-help-dialog';d.setAttribute('aria-labelledby','egeHeaderHelpTitle');\n d.innerHTML=`<div class=\"ege-help-heading\"><h2 id=\"egeHeaderHelpTitle\">Besoin d’aide ?</h2><button type=\"button\" class=\"ege-help-close\" data-ege-header=\"help-close\" aria-label=\"Fermer l’aide\">×</button></div><p>Retrouvez vos dossiers dans votre espace personnel. Pour rejoindre une classe, demandez le code à votre professeur.</p><p>En cas de difficulté avec votre compte ou votre dossier, contactez l’administrateur.</p><a class=\"ege-help-contact\" href=\"https://wa.me/25377441633?text=Bonjour%2C%20j%E2%80%99ai%20besoin%20d%E2%80%99aide%20pour%20EGE%202027.\" target=\"_blank\" rel=\"noopener\">Contacter l’administrateur sur WhatsApp</a><a class=\"ege-help-profile\" href=\"/?profil=1\">Mon profil</a><a class=\"ege-help-profile\" href=\"/confidentialite.html\">Confidentialité et données personnelles</a><p class=\"ege-help-phone\">WhatsApp : +253 77 44 16 33</p>`;\n d.addEventListener('close',()=>returnFocus?.isConnected&&returnFocus.focus());\n d.addEventListener('click',e=>{if(e.target!==d)return;const r=d.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)d.close()});\n document.body.append(d);return d;\n}\nfunction setSignedIn(value){logged=!!value;if(!logged){identityTicket++;identity={id:'',name:'',path:'',db:null};window.EGEAccount?.photo?.clear()}replaceHeader()}\nfunction errorMessage(error){if(handlers.error){handlers.error(error);return}const d=dialog();d.querySelector('[data-header-error]')?.remove();const p=document.createElement('p');p.dataset.headerError='';p.setAttribute('role','alert');p.textContent=error?.message||'L’opération n’a pas abouti. Réessayez.';d.append(p);if(!d.open)d.showModal()}\ndocument.addEventListener('click',async e=>{\n const target=e.target.closest('[data-ege-header]');if(!target)return;\n const action=target.dataset.egeHeader;e.preventDefault();\n if(action==='install-close'){document.getElementById('egeHeaderInstallDialog')?.close();return}\n if(action==='help'){returnFocus=target;const d=dialog();d.querySelector('.ege-help-profile').hidden=!logged;if(!d.open)d.showModal();return}\n if(action==='help-close'){document.getElementById('egeHeaderHelpDialog')?.close();return}\n if(busy)return;busy=true;target.disabled=true;\n try{if(action==='install'){await installApp(target)}\n else if(action==='home'){if(handlers.home)await handlers.home();else location.assign('/')}\n else if(action==='login'){if(handlers.login)await handlers.login();else location.assign('/?connexion=1')}\n else if(action==='logout'){if(handlers.logout)await handlers.logout();else if(legacyButton)legacyButton.click();else throw Error('Actualisez la page pour vous déconnecter.')}\n }catch(error){errorMessage(error)}finally{busy=false;target.disabled=false}\n});\nfunction mountLegacy(){\n if(document.getElementById('app')||document.querySelector('.ege-shared-header'))return;\n const old=document.querySelector('body>header');if(!old)return;\n const word=!!document.getElementById('egeCloudOpen');\n if(!document.getElementById('egeInstallButton')){if(!document.querySelector('link[rel=manifest]')){const link=document.createElement('link');link.rel='manifest';link.href='/manifest-ege-2027.webmanifest';document.head.append(link)}if('serviceWorker' in navigator&&location.protocol==='https:')navigator.serviceWorker.register('/service-worker-ege-2027.js',{scope:'/'}).catch(()=>{})}\n legacyButton=document.getElementById('signOut');\n let initial=legacyButton?!legacyButton.hidden:false;\n if(word&&typeof egeCloudUser!=='undefined')initial=!!egeCloudUser;\n old.insertAdjacentHTML('beforebegin',markup({signedIn:initial}));\n const tools=document.createElement('details');tools.className='ege-legacy-tools';const summary=document.createElement('summary');summary.textContent=word?'Outils du dossier':'Navigation';tools.append(summary);old.before(tools);tools.append(old);\n if(word&&typeof egeCloudUser!=='undefined'&&egeCloudUser)setUser(egeCloudUser,typeof egeSupabaseClient!=='undefined'?egeSupabaseClient:null);\n if(word)configure({login:()=>document.getElementById('egeCloudOpen')?.click(),logout:async()=>{if(typeof egeCloudLogout!=='function')throw Error('Actualisez la page.');await egeCloudLogout();setSignedIn(typeof egeCloudUser!=='undefined'&&!!egeCloudUser)}});\n const box=document.createElement('div');box.innerHTML=footer({legacy:true});const legalFooter=box.firstElementChild;const oldFooter=document.querySelector('body>footer');if(oldFooter)oldFooter.replaceWith(legalFooter);else document.body.append(legalFooter);\n if(legacyButton)new MutationObserver(()=>setSignedIn(!legacyButton.hidden)).observe(legacyButton,{attributes:true,attributeFilter:['hidden']});\n}\nwindow.EGEHeader={render:markup,footer,configure,setSignedIn,setUser,refresh,mountLegacy};\ndocument.addEventListener('DOMContentLoaded',mountLegacy);\n})();\n"],"/monavenir-brand-r1.css":["text/css; charset=utf-8",false,"/* Identity monAvenir — validated wordmark and icon. */\n#app .mb96-brand .monavenir-wordmark{display:block!important;width:clamp(160px,52vw,252px)!important;height:auto!important;max-width:100%;aspect-ratio:780/166;object-fit:contain;border-radius:0!important;flex:0 1 auto!important}\n#app.mb96-public .mb96-welcome .mb96-brand .monavenir-wordmark{width:clamp(136px,51vw,245px)!important;height:auto!important;max-width:100%}\n#app .mb96-auth-card .mb96-brand .monavenir-wordmark{margin:auto}\n.ege-shared-header .brandname .monavenir-wordmark{display:block;width:clamp(96px,25vw,148px);max-width:100%;height:auto;aspect-ratio:780/166;object-fit:contain;filter:brightness(0) invert(1)}\n.ege-shared-header .ege-brand-text{min-width:0}\n.ege-shared-header .brandmark img{object-fit:contain}\n@media(max-width:340px){.ege-shared-header .brandname .monavenir-wordmark{width:96px!important}}\n"],"/mon-bac-v72-teacher-clean-r1.js":["application/javascript; charset=utf-8",false,"/* monAvenir 72 — accueil par rôle, QR public et éditeur de portraits. */\n(()=>{'use strict';\nconst publicOrigin='https://monavenir.janagaleh.com';\nconst profileLink=id=>publicOrigin+'/annonces.html?prof='+encodeURIComponent(id);\nconst approved=()=>st.role==='admin'||st.role==='enseignant'&&st.teacher?.status==='approved';\nconst mine=()=> (st.ads||[]).filter(a=>a.submitted_by===st.user?.id&&egeAdLive(a));\nconst qrSvg=url=>{const q=qrcodegen.QrCode.encodeText(url,qrcodegen.QrCode.Ecc.MEDIUM),n=q.size+8;let p='';for(let y=0;y<q.size;y++)for(let x=0;x<q.size;x++)if(q.getModule(x,y))p+=`M${x+4} ${y+4}h1v1h-1z`;return `<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ${n} ${n}\" role=\"img\" aria-label=\"QR code de mon soutien scolaire\"><rect width=\"100%\" height=\"100%\" fill=\"white\"/><path d=\"${p}\" fill=\"#10243a\"/></svg>`};\nconst tile=(label,icon,to)=>`<button type=\"button\" class=\"mb-tile\" data-act=\"goto\" data-to=\"${to}\">${I(icon)}<span>${esc(label)}</span></button>`;\nconst oldNav=bottomNav;bottomNav=function(){const html=oldNav();if(st.role==='enseignant'&&!approved())return html;const label=st.role==='eleve'?'Réviser':st.role==='enseignant'?'Ajouter':'Actions';const center=`<button type=\"button\" class=\"mb72-center\" data-mb72=\"central\" aria-label=\"${label}\"><span class=\"mb72-center-disc\">${I(st.role==='eleve'?'book':st.role==='enseignant'?'plus':'settings')}</span><span>${label}</span></button>`;let n=0;return html.replace(/<button\\b[\\s\\S]*?<\\/button>/g,b=>{n++;if(st.role==='eleve'&&n===2)b=tile('Favoris','bookmark','student-favorites').replace('mb-tile','');return n===3?center+b:b}).replace('class=\"bottomnav\"','class=\"bottomnav mb72-nav\"')};\nfunction supportCard(){if(!mine().length)return `<section class=\"mb72-support\"><div><small>MON SOUTIEN SCOLAIRE</small><h2>Partagez vos cours</h2><p>Votre QR code sera disponible après publication de votre annonce.</p><button class=\"btn primary\" data-act=\"goto\" data-to=\"teacher-announcements\">Gérer mon annonce</button></div><div class=\"mb72-qr-placeholder\">${I('megaphone')}</div></section>`;const url=profileLink(st.user.id);return `<section class=\"mb72-support\"><div><small>MON SOUTIEN SCOLAIRE</small><h2>Mon QR code</h2><p>Invitez vos élèves à découvrir vos cours.</p><div class=\"mb72-share\"><button type=\"button\" data-mb72=\"share\">${I('share')} Partager</button><button type=\"button\" data-mb72=\"download\">${I('download')} QR code</button></div></div><a class=\"mb72-qr\" href=\"${esc(url)}\" aria-label=\"Voir mes annonces publiques\">${qrSvg(url)}</a></section>`}\nconst oldRender=render;render=function(){const r=oldRender();const app=$('app');if(!app||app.classList.contains('mb70-photo-gate')||!['student-home','teacher-home','admin-home'].includes(st.screen)||st.role==='enseignant'&&!approved())return r;const heading=app.querySelector('.mb-heading'),grid=app.querySelector('.mb-tiles'),hero=app.querySelector('.mb-priority');if(!heading||!grid)return r;app.classList.add('mb72-home');const name=st.profile?.full_name||st.teacher?.full_name|| (st.role==='admin'?'Administration':'Bienvenue');heading.classList.add('mb72-welcome');heading.innerHTML=`<p>Bienvenue</p><h1>${esc(name)}</h1>`;if(st.role==='enseignant'){grid.insertAdjacentHTML('beforeend',tile('Invitations','plus','teacher-invites')+tile('Messages','bell','teacher-notices'));app.querySelector('.mb-actions')?.remove();}if(st.role==='admin'){grid.insertAdjacentHTML('beforeend',tile('Soutien scolaire','hand-heart','admin-support')+tile('Notifications','bell','admin-notices')+tile('Simulations','calculator','admin-simulations'));app.querySelector('.mb-actions')?.remove();}if(st.role==='eleve'){grid.insertAdjacentHTML('beforeend',tile('Ma classe','users','student-group')+((st.profile?.academic_level==='Terminale'&&['GFM','OGRH','IAG'].includes(st.profile?.series))?tile('Mon EGE','edit','student-ege'):tile('Soutien scolaire','hand-heart','ads-directory')));}if(hero)grid.after(hero);const banner=app.querySelector('[data-ege-ad-slot=\"student_home\"]');if(banner)grid.after(banner);return r};\nconst oldBanner=adBanner;adBanner=function(place){const html=oldBanner(place),a=egeAdFor(place);if(!a)return html;const template=document.createElement('template');template.innerHTML=html;const node=template.content.firstElementChild;if(!node)return html;const controls=node.querySelector('.ege-ad-controls')?.outerHTML||'';const fee=node.querySelector('.ege-ad-fee')?.textContent||'';node.classList.add('mb72-ad');node.innerHTML=`<button type=\"button\" class=\"mb72-banner-hit\" data-act=\"ad-info\" data-id=\"${esc(a.id)}\"><div class=\"mb72-ad-copy\"><small>COURS DE SOUTIEN · PREMIUM</small><strong>${esc(a.subjects||a.title||'Soutien scolaire')}</strong><span>${esc(a.teacher_display_name||'Enseignant')}</span><span class=\"mb72-ad-extra\">${esc([a.ad_level,fee].filter(Boolean).join(' · '))}</span><b>Plus d’informations ${I('arrow')}</b></div><img src=\"${esc(egeAdPhoto(a))}\" alt=\"\" loading=\"lazy\" data-ege-ad-image></button>${controls}`;return node.outerHTML};\nconst teacherId=()=>{const id=new URLSearchParams(location.search).get('prof');return /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(id||'')?id:null};\nconst oldSeries=egeAdDirectorySeries;egeAdDirectorySeries=function(){return teacherId()?'all':oldSeries()};\nconst oldDirectory=egeAdsDirectory;egeAdsDirectory=function(){const id=teacherId();if(!id)return oldDirectory();const ads=st.ads;try{st.ads=(ads||[]).filter(a=>a.submitted_by===id&&egeAdLive(a));return oldDirectory().replace('Annonces des enseignants</h1>','Cours de soutien</h1>').replace(/<div class=\"ege-ad-directory-filters\"[\\s\\S]*?<\\/div>/,'<a class=\"btn\" href=\"./annonces.html\">Toutes les annonces</a>')}finally{st.ads=ads}};\ndocument.addEventListener('click',async e=>{const b=e.target.closest?.('[data-mb72]');if(!b)return;const a=b.dataset.mb72;if(a==='central'){if(st.role==='eleve'){go('student-exams');return}if(!approved())return;document.getElementById('mb72Actions')?.remove();const actions=st.role==='enseignant'?[['Nouveau sujet','file','data-mb=\"new\"'],['Nouvelle classe','users','data-act=\"teacher-create\"'],['Inviter mes élèves','plus','data-act=\"goto\" data-to=\"teacher-invites\"'],['Créer une annonce','megaphone','data-act=\"goto\" data-to=\"teacher-announcements\"']]:[['Ajouter un sujet','file','data-mb=\"new\"'],['Utilisateurs','users','data-act=\"goto\" data-to=\"admin-users\"'],['Annonces','megaphone','data-act=\"goto\" data-to=\"admin-announcements\"'],['Paramètres','settings','data-act=\"goto\" data-to=\"admin-settings\"']];document.getElementById('app').insertAdjacentHTML('beforeend',`<dialog id=\"mb72Actions\" class=\"mb72-action-dialog\"><h2>${st.role==='enseignant'?'Ajouter':'Actions rapides'}</h2>${actions.map(([n,i,attr])=>`<button class=\"btn\" ${attr}>${I(i)} ${n}</button>`).join('')}<button class=\"btn\" data-mb72=\"close\">Fermer</button></dialog>`);$('mb72Actions').showModal();return}if(a==='close'){$('mb72Actions')?.close();return}if(!mine().length||!approved())return;const url=profileLink(st.user.id);try{if(a==='share'){if(navigator.share)await navigator.share({title:'Mon soutien scolaire',text:'Découvrez mes cours sur monAvenir',url});else window.open('https://wa.me/?text='+encodeURIComponent('Découvrez mes cours : '+url),'_blank','noopener,noreferrer')}if(a==='download'){const blob=new Blob([qrSvg(url)],{type:'image/svg+xml'}),object=URL.createObjectURL(blob),link=document.createElement('a');link.href=object;link.download='mon-soutien-monbac.svg';link.click();setTimeout(()=>URL.revokeObjectURL(object),1000)}}catch(err){if(err.name!=='AbortError')toast('Le partage est indisponible.')}});\n// Détourage dans un iframe isolé. Seul le JPEG validé est ensuite transmis au stockage existant.\nconst edits=new WeakMap();let frame=null,serial=0;const pending=new Map();\nfunction portrait(file,mode,color){return new Promise((resolve,reject)=>{const id=++serial;const timeout=setTimeout(()=>{pending.delete(id);reject(Error('Détourage indisponible. Réessayez ou choisissez Original.'))},90000);pending.set(id,{resolve,reject,timeout});const send=()=>frame.contentWindow.postMessage({type:'mb72-edit',id,file,mode,color},'*');if(!frame){frame=document.createElement('iframe');frame.src='./portrait-editor.html';frame.sandbox='allow-scripts';frame.title='Traitement local de la photo';frame.hidden=true;frame.addEventListener('load',send,{once:true});document.body.append(frame)}else if(frame.dataset.ready)send();else frame.addEventListener('load',send,{once:true})})}\nwindow.addEventListener('message',e=>{if(!frame||e.source!==frame.contentWindow)return;if(e.data?.type==='mb72-ready'){frame.dataset.ready='1';return}if(e.data?.type!=='mb72-result')return;const p=pending.get(e.data.id);if(!p)return;pending.delete(e.data.id);clearTimeout(p.timeout);if(e.data.blob instanceof Blob&&e.data.blob.type==='image/jpeg')p.resolve(e.data.blob);else p.reject(Error(e.data.error||'Détourage indisponible.'))});\nfunction start(input,file,panel){const mode=panel.querySelector('[data-portrait-mode]').value,color=panel.querySelector('[data-portrait-color]').value,status=panel.querySelector('[role=status]'),image=panel.querySelector('img');const state={file,mode,body:null,promise:null};edits.set(input,state);status.textContent=mode==='original'?'Photo originale sélectionnée.':'Préparation de votre photo…';if(mode==='original'){image.src=panel.dataset.original;return}state.promise=portrait(file,mode,color).then(blob=>{if(edits.get(input)!==state)return null;state.body=blob;if(panel.dataset.preview)URL.revokeObjectURL(panel.dataset.preview);panel.dataset.preview=URL.createObjectURL(blob);image.src=panel.dataset.preview;status.textContent='Aperçu prêt. Vous pouvez enregistrer l’annonce.';return blob}).catch(error=>{if(edits.get(input)===state){state.error=error;status.textContent=error.message}return null})}\ndocument.addEventListener('change',e=>{const input=e.target;if(!input.dataset.adPhoto||!input.files?.[0])return;const file=input.files[0],prefix=input.dataset.adPhoto,preview=document.getElementById(prefix+'PhotoPreview');if(!preview)return;preview.querySelector('.mb72-photo-editor')?.remove();const original=preview.querySelector('img')?.src;if(!original)return;preview.insertAdjacentHTML('beforeend',`<div class=\"mb72-photo-editor\"><h3>Créer ma bannière</h3><label>Arrière-plan<select class=\"select\" data-portrait-mode><option value=\"cutout\">Détourer automatiquement</option><option value=\"blur\">Flouter l’arrière-plan</option><option value=\"original\">Garder la photo originale</option></select></label><label>Couleur<select class=\"select\" data-portrait-color><option value=\"white\">Blanc épuré</option><option value=\"blue\">Bleu nuit</option><option value=\"green\">Vert émeraude</option><option value=\"purple\">Violet</option></select></label><div class=\"mb72-photo-preview\"><div><small>COURS DE SOUTIEN</small><strong>${esc(document.getElementById(prefix+'Subjects')?.value||'Votre matière')}</strong><span>${esc(document.getElementById(prefix+'DisplayName')?.value||'Votre nom')}</span><b>Plus d’informations →</b></div><img alt=\"Aperçu de la bannière\"></div><p role=\"status\" aria-live=\"polite\"></p></div>`);const panel=preview.querySelector('.mb72-photo-editor');panel.dataset.original=original;panel.querySelector('img').src=original;panel.addEventListener('change',()=>start(input,file,panel));start(input,file,panel)});\nasync function photoFor(input,file){const state=edits.get(input);if(!state||state.file!==file||state.mode==='original')return null;if(state.promise)await state.promise;if(edits.get(input)!==state) return photoFor(input,file);if(!state.body)throw Error('Le détourage n’est pas disponible. Choisissez Original ou réessayez.');return state.body}\nwindow.MB72={profileLink,qrSvg,photoFor};\n})();\n"],"/mon-bac-v74-teacher-clean-r1.js":["application/javascript; charset=utf-8",false,"/* monAvenir 74 : en-tête unique, accueil compact et QR indépendant des icônes. */\n(()=>{'use strict';\nconst homeScreens=['student-home','teacher-home','admin-home'];\nconst moreScreens={eleve:'student-overview',enseignant:'teacher-overview',admin:'admin-overview'};\nconst roles={eleve:'Élève',enseignant:'Enseignant',admin:'Administrateur'};\nconst eligible=()=>!!st.user&&!EGEAccount.blocked(st.profile)&&!EGEAccount.incomplete(st.profile,st.role)&&(st.role!=='eleve'||!!st.profile?.avatar_path)&&(st.role!=='enseignant'||st.teacher?.status==='approved');\nconst hasQR=()=>st.role==='enseignant'&&eligible()&&(st.ads||[]).some(a=>a.submitted_by===st.user.id&&egeAdLive(a));\nconst button=(label,ico,to)=>`<button type=\"button\" class=\"mb74-link\" data-act=\"goto\" data-to=\"${to}\">${I(ico)}<span>${esc(label)}</span>${I('chevron')}</button>`;\nconst install=()=>`<div class=\"mb74-install\"><button type=\"button\" data-act=\"install\"${egeIsInstalled()?' hidden':''}>${I('download')} Télécharger l’application</button></div>`;\nscreenList.push(['student-overview','Mes autres services'],['teacher-overview','Mes autres services'],['admin-overview','Activité et services'],['teacher-qr','Mon QR code']);\nconst previousHeader=renderHeader;\nrenderHeader=function(){\n const html=previousHeader();if(!st.user)return html;\n const t=document.createElement('template');t.innerHTML=html;const header=t.content.firstElementChild;\n const logo=header?.querySelector('.brand'),avatar=header?.querySelector('.ege-header-avatar'),logout=header?.querySelector('[data-ege-header=\"logout\"]');\n if(!header||!logo||!logout)return html;\n const home=homeScreens.includes(st.screen)&&eligible(),name=st.profile?.full_name||st.teacher?.full_name||st.user?.user_metadata?.full_name||'Mon compte';\n logo.querySelector('.brand-sub')?.remove();logout.className='mb74-logout mb97-logout';logout.innerHTML=I('logout');logout.setAttribute('aria-label','Se déconnecter');logout.title='Se déconnecter';\n header.classList.add('mb74-header',home?'mb74-header-home':'mb74-header-inner');\n header.innerHTML='';header.append(logo);\n if(eligible()&&avatar){\n  header.classList.add('mb95-header');\n  const identity=document.createElement('button');identity.type='button';identity.className='mb74-identity mb95-identity';identity.dataset.act='goto';identity.dataset.to='profile';identity.setAttribute('aria-label','Ouvrir mon profil');\n  identity.append(avatar);const text=document.createElement('span');text.className='mb95-identity-text';const nameEl=document.createElement('strong');nameEl.textContent=home?(st.role==='admin'?'Administration':'Bonjour, '+name):'Profil';text.append(nameEl);\n  if(home){const meta=document.createElement('small');meta.textContent=st.role==='eleve'?[st.profile?.academic_level,st.profile?.series].filter(Boolean).join(' ')||roles.eleve:roles[st.role];text.append(meta);}\n  identity.append(text);if(home)identity.insertAdjacentHTML('beforeend',I('chevron'));\n  const notice=document.createElement('button');notice.type='button';notice.className='mb95-notice';notice.dataset.act='goto';notice.dataset.to={eleve:'student-notices',enseignant:'teacher-notices',admin:'admin-notices'}[st.role];notice.setAttribute('aria-label','Notifications');notice.title='Notifications';notice.innerHTML=I('bell');\n  const cluster=document.createElement('div');cluster.className='mb95-header-actions';cluster.append(notice);if(!home)cluster.append(identity);cluster.append(logout);header.append(cluster);if(home)header.append(identity);\n }else header.append(logout);\n return header.outerHTML;\n};\n// Seul ce message de connexion devient une notification transitoire ; les erreurs et confirmations utiles restent visibles.\nconst previousFeedback=feedback;let loginToast=false;\nfeedback=function(){if(!st.lastError&&st.notice==='Connexion réussie.'){loginToast=true;st.notice='';return ''}return previousFeedback()};\nconst toastNode=$('toast');if(toastNode)new MutationObserver(()=>{if(toastNode.textContent!=='✓ Connexion réussie.')toastNode.classList.remove('mb74-success')}).observe(toastNode,{childList:true,characterData:true,subtree:true});\nfunction qrSvg(url){\n const q=qrcodegen.QrCode.encodeText(url,qrcodegen.QrCode.Ecc.MEDIUM),n=q.size+8;let path='';\n for(let y=0;y<q.size;y++)for(let x=0;x<q.size;x++)if(q.getModule(x,y))path+=`M${x+4} ${y+4}h1v1h-1z`;\n return `<svg class=\"mb74-qr-svg\" xmlns=\"http://www.w3.org/2000/svg\" width=\"${n*8}\" height=\"${n*8}\" viewBox=\"0 0 ${n} ${n}\" shape-rendering=\"crispEdges\" stroke=\"none\" role=\"img\" aria-label=\"QR code de mon soutien scolaire\"><rect width=\"${n}\" height=\"${n}\" fill=\"#ffffff\" stroke=\"none\"/><path d=\"${path}\" fill=\"#000000\" stroke=\"none\"/></svg>`;\n}\nfunction qrPage(){\n if(!hasQR())return title('Mon soutien','Mon QR code','Disponible après publication de votre annonce.')+button('Gérer mon annonce','megaphone','teacher-announcements');\n const url=MB72.profileLink(st.user.id);return title('Mon soutien','Mon QR code','Faites scanner ce code pour accéder à vos annonces.')+\n `<section class=\"mb74-qr-page card\"><div class=\"mb74-qr-large\">${qrSvg(url)}</div><strong>${esc(st.profile?.full_name||st.teacher?.full_name||'Mon soutien scolaire')}</strong><p>Votre page publique de soutien scolaire</p><div class=\"mb74-qr-actions\"><button type=\"button\" class=\"btn\" data-mb72=\"share\">${I('share')} Partager</button><button type=\"button\" class=\"btn primary\" data-mb74=\"download\">${I('download')} Télécharger</button></div><a class=\"mb74-public-link\" href=\"${esc(url)}\" target=\"_blank\" rel=\"noopener\">Voir ma page publique ${I('arrow')}</a></section>`;\n}\nfunction compactQR(card){\n if(!hasQR()){card.classList.add('mb74-no-qr');return}\n const url=MB72.profileLink(st.user.id);card.innerHTML=`<div><small>MON SOUTIEN SCOLAIRE</small><h2>Mon QR code</h2><p>Invitez vos élèves.</p><div class=\"mb74-qr-actions\"><button type=\"button\" data-mb72=\"share\">${I('share')} Partager</button><button type=\"button\" data-act=\"goto\" data-to=\"teacher-qr\">Agrandir ${I('arrow')}</button></div></div><button type=\"button\" class=\"mb74-qr-preview\" data-act=\"goto\" data-to=\"teacher-qr\" aria-label=\"Agrandir mon QR code\">${qrSvg(url)}</button>`;\n}\nfunction timeline(){\n const events=MB73.activity();return `<section class=\"mb73-dashboard mb73-activity\"><div class=\"mb73-dash-head\"><h2>Activité récente</h2><button type=\"button\" class=\"mb73-text-button\" data-mb73=\"audit\">Journal complet ${I('chevron')}</button></div>${events.length?'<ol class=\"mb73-timeline\">'+events.map(e=>`<li><span class=\"mb73-event-icon\">${I(e.icon)}</span><div><strong>${esc(e.title)}</strong>${e.sub?`<small>${esc(e.sub)}</small>`:''}<time datetime=\"${esc(e.date)}\">${esc(new Intl.DateTimeFormat('fr-FR',{timeZone:'Africa/Djibouti',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}).format(new Date(e.date)))}</time></div></li>`).join('')+'</ol>':'<p class=\"small muted\">Aucune activité récente.</p>'}</section>`;\n}\nconst previousView=view;\nfunction overview(){\n if(!eligible())return previousView();\n const screen=st.screen;let html;try{st.screen=homes[st.role];html=previousView()}finally{st.screen=screen}\n const template=document.createElement('template');template.innerHTML=html;const extras=[...template.content.children].filter(n=>!n.matches('.mb-heading,.mb-tiles,.mb-quick,[data-ege-ad-slot]'));\n const links=new Set(),shortcuts=[];for(const n of extras){\n  if(st.role==='admin'&&n.matches('.mb-priority,.mb-actions')||st.role==='admin'&&n.querySelector('h3')?.textContent==='Activité récente')continue;\n  for(const b of n.querySelectorAll('button[data-to]')){let to=b.dataset.to;if(!to||links.has(to)||b.closest('.mb-priority,.mb-week'))continue;links.add(to);shortcuts.push(button(b.textContent.trim(),'arrow',to));}\n }\n const sections=extras.filter(n=>st.role!=='admin'&&(n.matches('.mb-priority,.mb-week')||n.querySelector('h3')?.textContent==='Activité récente')).map(n=>n.outerHTML).join('');\n return title('monAvenir',st.role==='admin'?'Activité et services':'Mes autres services','Retrouvez vos outils et votre suivi.')+\n (st.role==='admin'?timeline():sections)+`<section class=\"mb74-link-list\">${shortcuts.join('')}</section>`;\n}\nview=function(){if(st.screen==='teacher-qr'&&st.role==='enseignant'&&eligible())return qrPage();if(st.screen===moreScreens[st.role]&&eligible())return overview();return previousView()};\nconst previousRender=render;\nrender=function(){\n const r=previousRender(),host=$('app');\n if(loginToast){loginToast=false;toast('✓ Connexion réussie.');const el=$('toast');if(el)el.classList.add('mb74-success');}\n if(!host||!st.user)return r;\n host.classList.add('mb74-signed');\n const content=host.querySelector('.screen'),header=host.querySelector('.mb74-header');\n if(!content||!header)return r;\n if(homeScreens.includes(st.screen)&&eligible()&&host.querySelector('.mb72-home .mb-tiles')){\n  host.classList.add('mb74-home');content.querySelector('.mb72-welcome')?.remove();\n  const grid=content.querySelector('.mb-tiles'),qr=content.querySelector('.mb72-support');if(qr)compactQR(qr);\n  // Les sections annexes deviennent un véritable écran ; les raccourcis et la publicité restent directement accessibles.\n  for(const el of [...content.children])if(!el.matches('.mb-tiles,.mb-quick,.mb72-support,.mb73-review,.mb73-activity,[data-ege-ad-slot],.privacy-footer,.ege-feedback'))el.remove();\n  const recent=content.querySelector('.mb73-activity');if(recent){const first=recent.querySelector('li');for(const li of [...recent.querySelectorAll('li')].slice(1))li.remove();recent.querySelector('.mb73-dash-head button')?.remove();recent.insertAdjacentHTML('beforeend',button(first?'Toute l’activité':'Activité et services','clock',moreScreens[st.role]));}\n  const footer=content.querySelector('.privacy-footer');const more=button(st.role==='admin'?'Autres services':'Autres services et suivi','more',moreScreens[st.role]);\n  if(footer)footer.insertAdjacentHTML('beforebegin',`<div class=\"mb74-more\">${more}</div>${install()}`);else content.insertAdjacentHTML('beforeend',more+install());\n  // Un accès direct aux outils supplémentaires est conservé depuis chaque accueil.\n\n }else if(!host.classList.contains('ege-intro-app')&&!host.classList.contains('mb70-photo-gate')&&eligible()){\n  const back=document.createElement('button');back.type='button';back.className='mb74-back';back.dataset.act='goto';back.dataset.to=homes[st.role];back.innerHTML=I('left')+' Retour à l’accueil';content.prepend(back);\n }\n return r;\n};\ndocument.addEventListener('click',e=>{\n const target=e.target.closest('[data-mb74=\"download\"]');if(!target||!hasQR())return;\n const url=MB72.profileLink(st.user.id),qr=qrcodegen.QrCode.encodeText(url,qrcodegen.QrCode.Ecc.MEDIUM),size=(qr.size+8)*12,canvas=document.createElement('canvas');canvas.width=canvas.height=size;\n try{const ctx=canvas.getContext('2d');ctx.fillStyle='#fff';ctx.fillRect(0,0,size,size);ctx.fillStyle='#000';for(let y=0;y<qr.size;y++)for(let x=0;x<qr.size;x++)if(qr.getModule(x,y))ctx.fillRect((x+4)*12,(y+4)*12,12,12);const a=document.createElement('a');a.href=canvas.toDataURL('image/png');a.download='monbac-soutien-qr.png';a.click()}catch(_){const object=URL.createObjectURL(new Blob([qrSvg(url)],{type:'image/svg+xml'})),a=document.createElement('a');a.href=object;a.download='monbac-soutien-qr.svg';a.click();setTimeout(()=>URL.revokeObjectURL(object),1000)}\n});\nwindow.MB74={qrSvg};\n})();\n"],"/mon-bac-v92-article-r2-teacher-clean-r1.js":["application/javascript; charset=utf-8",false,"/* monAvenir — dossier EGE, document par document, sans perte des anciens dossiers. */\n(()=>{'use strict';\nconst screens=['student-wizard','student-annex','student-terrain'], prelim=[['cover','Page de garde'],['contents','Sommaire'],['thanks','Remerciements'],['study','Fiche d’étude']], terrain=[['enterprise','Entreprise'],['professional','Professionnel'],['interview','Entretien'],['comparison','Comparaison'],['synthesis','Synthèse']];\nconst own=()=>st.role==='eleve'&&st.user&&st.draft&&currentDoc()?.owner_id===st.user.id&&(!st.profile||(!EGEAccount.blocked(st.profile)&&!EGEAccount.incomplete(st.profile,st.role)&&!!st.profile.avatar_path));\nconst config=p=>p.study?.workspace||{};\nconst state=()=>{st.draft.study||={};return st.draft.study.workspace||={}};\nconst count=p=>p.mode==='binome'?4:3;\nconst sections=p=>[prelim.concat(p.mode==='binome'?[['tasks','Répartition']]:[]),[['topic','Sujet'],...Array.from({length:count(p)},(_,i)=>['a'+(i+1),'Annexe '+(i+1)])],terrain];\nconst docs=p=>sections(p).flat();\nconst keyForScreen=()=>st.screen==='student-annex'?'a'+st.annex:st.screen==='student-terrain'?egeTerrainTab:st.wizardStep>1?'topic':'cover';\nconst current=p=>docs(p).some(([key])=>key===config(p).current)?config(p).current:docs(p).some(([key])=>key===keyForScreen())?keyForScreen():'cover';\nconst route=k=>/^a\\d$/.test(k)?'student-annex':terrain.some(([x])=>x===k)?'student-terrain':'student-wizard';\nconst B=(label,act,attrs='',cls='btn')=>`<button type=\"button\" class=\"${cls}\" data-ege92=\"${act}\" ${attrs}>${esc(label)}</button>`;\nconst fld=(label,key,val='',area=false,extra='')=>`<label class=\"field\"><span>${esc(label)}</span>${area?`<textarea class=\"textarea\" data-ege92-field=\"${key}\" rows=\"${area===true?4:area}\" ${extra}>${esc(val||'')}</textarea>`:`<input class=\"input\" data-ege92-field=\"${key}\" value=\"${esc(val||'')}\" ${extra}>`}</label>`;\nconst extract=(h,sel)=>{const tmp=document.createElement('template');tmp.innerHTML=h;return tmp.content.querySelector(sel)?.innerHTML||''};\nfunction form(p,key){const c=config(p),t=EGETerrain.normalize(p.terrain,p),topic=EGEStudy.topic(p,official);\n if(key==='cover'){const old=st.wizardStep;st.wizardStep=1;const h=extract(studentWizard(),'.ege-forms');st.wizardStep=old;return h+'<p class=\"ege92-note\">Session 2027 · Les informations sont reprises dans la fiche d’étude.</p>'}\n if(key==='contents')return `<p class=\"ege92-note\">Sommaire automatique. Les numéros de pages définitifs sont calculés à l’export.</p><div class=\"ege92-list\">${docs(p).filter(([k])=>!['cover','contents','topic','professional'].includes(k)).map(([k,l])=>`<div><span>${esc(l)}${/^a\\d/.test(k)?' — '+esc(getTitle(+k.slice(1),p)):''}</span>${B('Ouvrir','open',`data-key=\"${k}\"`,'btn smol')}</div>`).join('')}</div>`;\n if(key==='thanks'){const list=c.thanksPeople||[];return `<div class=\"ege92-list\">${list.map((r,i)=>`<div class=\"ege92-section\"><div style=\"flex:1\">${fld('Nom','thanksPeople.'+i+'.name',r.name)}${fld('Rôle','thanksPeople.'+i+'.role',r.role)}</div>${B('Retirer','remove',`data-list=\"thanksPeople\" data-index=\"${i}\"`,'btn smol')}</div>`).join('')}</div>${B('Ajouter une personne','add','data-list=\"thanksPeople\"')}${B('Préparer le paragraphe','thanks','','btn')} ${fld('Remerciements personnalisables','thanksText',c.thanksText,7)}`}\n if(key==='study'){const cal=c.calendar||[];return `<div class=\"ege92-section\"><strong>${esc(p.student||'Nom à renseigner')}${p.mode==='binome'?' · '+esc(p.partner||'Binôme'):''}</strong><p class=\"ege92-meta\">${esc(p.className||'Classe')} · ${esc(p.school||'Établissement')}</p><p>${esc(topic.theme||'Thème')} · ${esc(topic.subtheme||'Sous-thème')}</p><p><strong>Problématique :</strong> ${esc(p.problem||'À renseigner')}</p>${B('Modifier le sujet','open','data-key=\"topic\"','btn smol')}</div><h3>Calendrier des tâches</h3>${cal.map((r,i)=>`<div class=\"ege92-section\">${fld('Travail réalisé','calendar.'+i+'.task',r.task)}<div class=\"row\">${fld('Date','calendar.'+i+'.date',r.date,false,'type=\"date\"')}${fld('Durée','calendar.'+i+'.duration',r.duration)}</div>${B('Retirer','remove',`data-list=\"calendar\" data-index=\"${i}\"`,'btn smol')}</div>`).join('')}${B('Ajouter une tâche','add','data-list=\"calendar\"')}<h3>Annexes et sources</h3><div class=\"ege92-list\">${Array.from({length:count(p)},(_,i)=>`<div><span><strong>${esc(getTitle(i+1,p))}</strong><br><small>${esc(p.sources?.[i+1]||'Source à renseigner')}</small></span>${B('Modifier','open',`data-key=\"a${i+1}\"`,'btn smol')}</div>`).join('')}</div>${fld('Méthodes de recherche','methods',c.methods,3,'placeholder=\"Internet, livres, enquête terrain…\"')}${fld('Outils utilisés','tools',c.tools,3)}${fld('Documents produits','produced',c.produced,3)}${fld('Observations','observations',c.observations,3)}<h3>Validation de l’encadreur</h3><p>${esc(p.teacher||'Nom de l’encadreur à renseigner dans la page de garde')}</p>${fld('Date','signatureDate',c.signatureDate,false,'type=\"date\"')}<div class=\"ege92-sig\"><div>Signature de l’encadreur</div><div>Cachet de l’établissement</div></div>`}\n if(key==='tasks'){return `<p class=\"ege92-meta\">${esc(p.student||'Candidat 1')} et ${esc(p.partner||'Candidat 2')}</p>${(c.tasks||[]).map((r,i)=>`<div class=\"ege92-section\">${fld('Tâche','tasks.'+i+'.task',r.task)}${fld('Responsable','tasks.'+i+'.person',r.person)}${fld('Date','tasks.'+i+'.date',r.date,false,'type=\"date\"')}${B('Retirer','remove',`data-list=\"tasks\" data-index=\"${i}\"`,'btn smol')}</div>`).join('')}${B('Ajouter une tâche','add','data-list=\"tasks\"')}`}\n if(key==='topic'){const old=st.wizardStep;st.wizardStep=2;const a=extract(studentWizard(),'.ege-forms');st.wizardStep=3;const b=extract(studentWizard(),'.ege-forms');st.wizardStep=old;return a+b+`<p id=\"ege92-words\" class=\"ege92-note\">${(p.problem?.trim().match(/\\S+/g)||[]).length} mots</p>`}\n if(/^a\\d$/.test(key)){const n=+key.slice(1);return `<label class=\"field\"><span>Titre</span><input class=\"input\" data-field=\"annex_title_${n}\" maxlength=\"190\" value=\"${esc(getTitle(n,p))}\"></label><label class=\"field\"><span>Contenu</span><textarea class=\"textarea\" data-field=\"annex_body_${n}\" placeholder=\"Rédigez ou collez votre article. Séparez les paragraphes par une ligne vide.\">${esc(p.annexes?.[n]||'')}</textarea></label><p id=\"wordCount\" class=\"ege92-note\">${(p.annexes?.[n]?.trim().match(/\\S+/g)||[]).length} mots · Objectif : 98 % de la surface utile A4 · une page par annexe</p><label class=\"field\"><span>Source web (HTTPS)</span><textarea class=\"textarea\" rows=\"2\" placeholder=\"https://…\" data-field=\"annex_source_${n}\">${esc(p.sources?.[n]||'')}</textarea></label>${window.MBEgeAI?.sourceField(n,p)||''}<label class=\"ege92-proof\"><input type=\"checkbox\" data-field=\"annex_checked_${n}\" ${p.sourceChecks?.[n]?'checked':''}> Source HTTPS consultée et vérifiée</label><div class=\"ege92-preview\"><h3>Aperçu de l’annexe</h3>${annexPaper(n,p)}</div>`}\n if(key==='synthesis'){const s=c.synthesis||{intro:'',development:t.synthesis||'',conclusion:''};return `${fld('Introduction','synthesis.intro',s.intro,5)}${fld('Développement','synthesis.development',s.development,10)}${fld('Conclusion','synthesis.conclusion',s.conclusion,5)}<div id=\"ege92-review\" class=\"ege92-status\">${reviewHTML()}</div>`}\n const old=egeTerrainTab;egeTerrainTab=key;const html=extract(terrainPage(),'section.card.ege-forms');egeTerrainTab=old;\n if(key==='interview'||key==='comparison'){const tmp=document.createElement('template');tmp.innerHTML=html;const selector=key==='interview'?'fieldset':'section';const rows=[...tmp.content.querySelectorAll(selector)];const n=Math.max(0,Math.min(rows.length-1,Number(c[key+'Index'])||0));rows.forEach((el,i)=>{if(i!==n)el.remove()});const nav=rows.length?`<div class=\"ege92-inline\">${B('←','sub',`data-key=\"${key}\" data-delta=\"-1\" ${n===0?'disabled':''}`)}<strong>${key==='interview'?'Question':'Annexe'} ${n+1} / ${rows.length}</strong>${B('→','sub',`data-key=\"${key}\" data-delta=\"1\" ${n===rows.length-1?'disabled':''}`)}</div>`:'';return nav+tmp.innerHTML}\n return html;\n}\nfunction navigate(k){if(!own()||!docs(st.draft).some(([x])=>x===k))return;state().current=k;st.wizardStep=k==='topic'?2:1;if(/^a\\d$/.test(k))st.annex=+k.slice(1);if(terrain.some(([x])=>x===k))egeTerrainTab=k;go(route(k));touchTerrain();window.scrollTo(0,0)}\nlet review={id:null,uid:null,loading:false,contacts:[],rows:[],error:''};\nasync function rpc(action,data={}){const r=await st.db.rpc('mon_bac_synthesis',{p_action:action,p_data:data});if(r.error)throw r.error;return r.data}\nfunction synth(p){const s=config(p).synthesis||{};return {intro:s.intro||'',development:s.development||'',conclusion:s.conclusion||''}}\nfunction reviewHTML(){const s=synth(st.draft),sameUser=review.uid===st.user?.id&&review.id===st.selectedDocId,rows=sameUser?review.rows:[],contacts=sameUser?review.contacts:[],r=rows[0],same=r&&['intro','development','conclusion'].every(k=>r.content?.[k]===s[k]);return `<h3>Validation par l’enseignant d’économie-droit</h3>${sameUser&&review.error?`<p>${esc(review.error)}</p>`:''}${r?`<p><strong>${same?({pending:'En attente de validation',approved:'Validée par l’enseignant',changes:'À corriger'}[r.status]||r.status):'Synthèse modifiée : renvoyez-la pour validation'}</strong>${r.feedback?' · '+esc(r.feedback):''}</p>`:''}<label class=\"field\"><span>Enseignant</span><select id=\"ege92-teacher\" class=\"select\"><option value=\"\">Choisir un enseignant</option>${contacts.map(x=>`<option value=\"${esc(x.id)}\" ${r?.teacher_id===x.id?'selected':''}>${esc(x.name)}</option>`).join('')}</select></label>${!contacts.length?'<p class=\"ege92-note\">Rejoignez une classe d’économie-droit approuvée pour partager votre synthèse.</p>':''}${B('Envoyer pour validation','submit-review','','btn primary')}`}\nasync function loadReview(force=false){if(!own()||!navigator.onLine||review.loading)return;const id=st.selectedDocId,uid=st.user.id;if(!force&&review.id===id&&review.uid===uid)return;review={id,uid,loading:true,contacts:[],rows:[],error:''};try{const [contacts,rows]=await Promise.all([rpc('contacts'),rpc('status',{id})]);if(review.id===id&&review.uid===uid)Object.assign(review,{contacts,rows})}catch(e){review.error='Validation actuellement indisponible.'}finally{review.loading=false;const el=document.querySelector('#ege92-review');if(el&&own()&&st.selectedDocId===id)el.innerHTML=reviewHTML()}}\nfunction workspace(){const p=st.draft,k=current(p),all=docs(p),index=all.findIndex(([x])=>x===k),groups=sections(p),g=groups.findIndex(items=>items.some(([x])=>x===k)),label=all[index]?.[1]||'Mon dossier';if(k==='synthesis')queueMicrotask(()=>loadReview());return `<main class=\"ege92\"><div class=\"ege92-head\"><h1>Mon dossier EGE</h1><span id=\"saveState\" class=\"ege92-save\">${esc(st.saveBadge)}</span></div>${st.warning?`<p class=\"notice\">${esc(st.warning)} ${st.localCandidate?btn('Récupérer','restore-draft','btn smol'):''}</p>`:''}<div class=\"ege92-progress\"><div><span>${esc(label)}</span><span>Document ${index+1} sur ${all.length}</span></div><progress max=\"${all.length}\" value=\"${index+1}\" aria-label=\"Position dans le dossier\"></progress></div><nav class=\"ege92-tabs\" aria-label=\"Parties du dossier\">${['Préliminaires','Théorie','Terrain'].map((name,i)=>B(name,'open',`data-key=\"${groups[i][0][0]}\" ${i===g?'aria-current=\"page\"':''}`,i===g?'active':'')).join('')}</nav><nav class=\"ege92-steps\" aria-label=\"Documents\">${groups[g].map(([x,l])=>B(l,'open',`data-key=\"${x}\" ${x===k?'aria-current=\"page\"':''}`,x===k?'active':'')).join('')}</nav><section class=\"card ege-forms\"><h2>${esc(label)}</h2>${window.MBEgeAI?.panel(k)||\"\"}${form(p,k)}</section><div class=\"ege92-actions\">${B('Précédent','open',`data-key=\"${all[index-1]?.[0]||k}\" ${!index?'disabled':''}`)}${B('Enregistrer','save')}${B(index===all.length-1?'Exporter':'Suivant',index===all.length-1?'export':'open',`data-key=\"${all[index+1]?.[0]||k}\"`,'btn primary')}</div><details class=\"card\" id=\"ege92-export\"><summary>Exporter mon dossier</summary><p class=\"ege92-note\">Le document reste modifiable. Relisez-le avant remise.</p><div class=\"ege92-export\">${B('Word (.docx)','word','','btn')}${B('PDF (.pdf)','pdf','','btn primary')}</div></details>${window.EGEStudyUI?.tools?.()||''}</main>`}\nconst oldView=view;view=function(){if(own()&&screens.includes(st.screen))return workspace();if(own()&&st.screen==='student-export')return `<main class=\"ege92\"><h1>Exporter mon dossier</h1><section class=\"card\"><p>Word modifiable ou PDF à imprimer.</p><div class=\"ege92-export\">${B('Word (.docx)','word')}${B('PDF (.pdf)','pdf','','btn primary')}</div></section>${B('Retour au dossier','open',`data-key=\"${current(st.draft)}\"`)}</main>`;return oldView()};\nconst oldHome=studentHome;studentHome=function(){let h=oldHome().replace('Continuer mon étude','Reprendre mon travail').replace('Voir mon bilan','Reprendre mon travail');if(!own())return h;const all=docs(st.draft),idx=all.findIndex(([k])=>k===current(st.draft));return h.replace(/<div class=\"compact-legend\"><strong>Progression de la partie théorique<\\/strong>[\\s\\S]*?<div class=\"progress-track\"><div class=\"progress-bar\"[^>]*><\\/div><\\/div>/,`<div class=\"compact-legend\"><strong>${esc(all[idx]?.[1]||'Page de garde')}</strong><strong>Document ${idx+1} sur ${all.length}</strong></div><div class=\"progress-track\"><div class=\"progress-bar\" style=\"width:${(idx+1)/all.length*100}%\"></div></div>`).replace(/<p class=\"study-next\">[\\s\\S]*?<\\/p>/,'')};\nconst originalGo=go;go=function(screen){if(own()&&screens.includes(screen)){const c=state();if(!c.current)c.current=screen==='student-annex'?'a'+st.annex:screen==='student-terrain'?egeTerrainTab:'cover';if(!docs(st.draft).some(([k])=>k===c.current))c.current='cover';screen=route(c.current)}return originalGo(screen)};\nconst oldSelect=selectDoc;selectDoc=function(id){oldSelect(id);if(own()){const c=state();if(!c.current){const r=st.draft.study?.resume;c.current=r?.screen==='student-annex'?'a'+(r.annex||1):r?.screen==='student-terrain'?r.terrainTab||'enterprise':r?.wizardStep>1?'topic':'cover'}}};\ndocument.addEventListener('input',e=>{if(!own())return;const el=e.target,k=el.dataset.ege92Field;if(k){const parts=k.split('.');let obj=state();if(parts[0]==='synthesis'&&!obj.synthesis)obj.synthesis={intro:'',development:st.draft.terrain?.synthesis||'',conclusion:''};for(const x of parts.slice(0,-1)){obj[x]||={};obj=obj[x]}obj[parts.at(-1)]=el.value.slice(0,24000);if(parts[0]==='synthesis'){const s=synth(st.draft),t=st.draft.terrain;t.synthesis=[s.intro,s.development,s.conclusion].join('\\n\\n');t.synthesisReviewed=false;t.synthesisSignature=EGETerrain.synthesisSignature(st.draft)}touchTerrain()}if(el.dataset.field==='dProblem'){const w=document.querySelector('#ege92-words');if(w){const n=(el.value.trim().match(/\\S+/g)||[]).length;w.textContent=n+' mots';w.style.color=''}}});\ndocument.addEventListener('click',e=>{const home=e.target.closest?.('[data-study=\"next\"],[data-study=\"resume\"]');if(home&&own()){e.preventDefault();e.stopImmediatePropagation();navigate(current(st.draft));return}const el=e.target.closest?.('[data-ege92]');if(!el)return;e.preventDefault();e.stopImmediatePropagation();(async()=>{const a=el.dataset.ege92;if(a==='inbox'){await inbox();return}if(a==='review'){const id=el.dataset.id,feedback=document.querySelector('#ege92-feedback-'+id)?.value||'';await rpc('review',{id,status:el.dataset.status,feedback});toast('Avis enregistré.');await inbox();return}if(!own())return;if(a==='open'){navigate(el.dataset.key);return}if(a==='save'){await saveDoc();return}if(a==='export'){const x=document.querySelector('#ege92-export');if(x){x.open=true;x.scrollIntoView({block:'center'})}return}if(a==='sub'){state()[el.dataset.key+'Index']=Math.max(0,(Number(config(st.draft)[el.dataset.key+'Index'])||0)+Number(el.dataset.delta));touchTerrain();render();return}if(a==='add'||a==='remove'){const c=state(),k=el.dataset.list;c[k]||=[];if(a==='add'&&c[k].length<30)c[k].push({});if(a==='remove')c[k].splice(Number(el.dataset.index),1);touchTerrain();render();return}if(a==='thanks'){const c=state();c.thanksText=(c.thanksPeople||[]).filter(x=>x.name?.trim()).map(x=>'Je remercie '+x.name.trim()+(x.role?.trim()?', '+x.role.trim():'')+', pour son accompagnement dans la réalisation de cette étude.').join(' ');touchTerrain();render();return}if(a==='submit-review'){const s=synth(st.draft),teacher=document.querySelector('#ege92-teacher')?.value;if(!teacher||Object.values(s).some(x=>!x.trim()))throw Error('Complétez les trois parties et choisissez un enseignant.');if(!await saveDoc({silent:true}))throw Error('Enregistrez votre dossier en ligne avant l’envoi.');await rpc('submit',{id:st.selectedDocId,teacher});await loadReview(true);toast('Synthèse envoyée.');return}if(a==='word'||a==='pdf'){el.disabled=true;try{await window.EGE92Export.download(structuredClone(st.draft),a,official,st.db);toast('Dossier exporté.')}finally{el.disabled=false}}})().catch(fail)},true);\nasync function inbox(){const rows=await rpc('inbox');let d=document.querySelector('#ege92-inbox');if(!d){d=document.createElement('dialog');d.id='ege92-inbox';d.className='ege92';document.body.append(d)}d.innerHTML=`<div class=\"card\"><div class=\"ege92-inline\"><h2>Synthèses à valider</h2><button class=\"btn\" type=\"button\" onclick=\"this.closest('dialog').close()\">Fermer</button></div>${rows.length?rows.map(r=>`<div class=\"ege92-section\"><strong>${esc(r.student_name||'Élève')}</strong><p>${esc(r.status)}</p>${['intro','development','conclusion'].map((k,i)=>`<h3>${['Introduction','Développement','Conclusion'][i]}</h3><div class=\"ege92-paper\">${esc(r.content?.[k]||'')}</div>`).join('')}<label class=\"field\">Avis<textarea class=\"textarea\" maxlength=\"1500\" id=\"ege92-feedback-${esc(r.id)}\">${esc(r.feedback||'')}</textarea></label>${B('Valider','review',`data-id=\"${esc(r.id)}\" data-status=\"approved\"`,'btn primary')} ${B('À corriger','review',`data-id=\"${esc(r.id)}\" data-status=\"changes\"`)}</div>`).join(''):'<p>Aucune synthèse reçue.</p>'}</div>`;if(!d.open)d.showModal()}\nconst oldRender=render;render=function(){const r=oldRender.apply(this,arguments);if(st.role!=='enseignant'||!st.user)document.querySelector('#ege92-inbox')?.remove();return r};\nconst baseReviewHTML=reviewHTML;reviewHTML=function(){return baseReviewHTML()+' <button type=\"button\" class=\"btn smol\" data-ege92-refresh>Actualiser l’avis</button>'};\nconst baseNavigate=navigate;navigate=function(k){baseNavigate(k);if(k==='synthesis')loadReview(true)};\ndocument.addEventListener('click',e=>{if(e.target.closest?.('[data-ege92-refresh]')&&own()){e.preventDefault();loadReview(true)}});\ndocument.addEventListener('input',e=>{if(!own()||!e.target.dataset.ege92Field?.startsWith('synthesis.'))return;const el=document.querySelector('#ege92-review');if(!el)return;const chosen=document.querySelector('#ege92-teacher')?.value;el.innerHTML=reviewHTML();if(chosen&&document.querySelector('#ege92-teacher'))document.querySelector('#ege92-teacher').value=chosen});\nwindow.EGE92={docs,sections,synth};\n})();\n"],"/mon-bac-v91-private-class-20261119-market-r1-teacher-clean-r1.js":["application/javascript; charset=utf-8",false,"/* monAvenir V91: compact account, class access and moderated communication. */\n(()=>{'use strict';\nconst E=x=>esc(String(x??'')),active=()=>!!st.user&&!EGEAccount.blocked(st.profile||{})&&!EGEAccount.incomplete(st.profile,st.role),teacher=()=>active()&&st.role==='enseignant'&&st.teacher?.status==='approved',student=()=>active()&&st.role==='eleve',admin=()=>active()&&st.role==='admin';\nconst modeLabel={public:'Publique · sans code',visible_code:'Publique · code visible',private_code:'Privée · code caché'};\nconst action=(a,label,id='',extra='')=>`<button type=\"button\" class=\"btn mb91-action\" data-mb91=\"${a}\" data-id=\"${E(id)}\" ${extra}>${E(label)}</button>`;\nconst api=async(a,d={})=>{const r=await st.db.rpc('mon_bac_community',{p_action:a,p_data:d});if(r.error)throw r.error;return r.data};\nconst directory=async()=>{const r=await st.db.rpc('mon_bac_class_directory');if(r.error)throw r.error;return r.data||[]};\nconst learning=async(a,d={})=>{const r=await st.db.rpc('mon_bac_learning',{p_action:a,p_data:d});if(r.error)throw r.error;return r.data};\nconst row=(name,sub='',tail='')=>`<div class=\"mb91-row\"><div><strong>${E(name)}</strong>${sub?`<small>${E(sub)}</small>`:''}</div>${tail}</div>`;\nconst trAccount=(f,e,a)=>{const l=window.MBLang?.get?.();return l==='ar'?a:l==='en'?e:f};\nconst oldProfile=profile;\nprofile=function(){const html=oldProfile();if(!active())return html;const t=document.createElement('template');t.innerHTML=html;const form=t.content.querySelector('#studentProfileForm'),photo=t.content.querySelector('.profile-photo-panel');if(!form||!photo)return html;const p=st.profile||{},role={admin:'Administration',enseignant:'Enseignant',eleve:'Élève'}[st.role];const security=t.content.querySelector('.mb90-profile');const extras=[...t.content.querySelectorAll('[data-act=\"profile-changepass\"],[data-act=\"logout\"]')].map(x=>x.outerHTML).join('');\nreturn `<div class=\"mb91-profile\"><h1>Mon profil</h1><section class=\"mb91-card mb91-identity\">${photo.outerHTML}<div><h2>${E(p.full_name)}</h2><span class=\"mb91-role\">${role}</span></div></section><section class=\"mb91-card\"><div class=\"mb91-section-head\"><h2>Informations personnelles</h2>${action('edit','Modifier')}</div>${row('Nom et prénom',p.full_name)}${row('WhatsApp',p.whatsapp_number?'+'+p.whatsapp_number:'Non renseigné')}${row('Établissement',p.school||'Non renseigné')}${st.role==='eleve'?row('Série et classe',[p.series,p.class_name].filter(Boolean).join(' · ')):''}</section><section class=\"mb91-card\"><h2>Mon compte</h2>${st.role==='enseignant'?row(trAccount('Mes cycles et établissements','My teaching stages and institutions','مراحل التدريس والمؤسسات'),'Séries et matières',`<button type=\"button\" class=\"btn\" data-act=\"goto\" data-to=\"teacher-specialties\">Ouvrir</button>`)+(teacher()?row(trAccount('Ma carte enseignant','My teacher card','بطاقتي كمعلّم'),trAccount('Profil public et QR code','Public profile and QR code','الملف العام ورمز الاستجابة السريعة'),`<button type=\"button\" class=\"btn\" data-act=\"goto\" data-to=\"teacher-qr\">Ouvrir</button>`):''):''}${row('Messages','Échanges et assistance',action('messages','Ouvrir'))}${security?`<details class=\"mb91-security\"><summary>Connexion biométrique</summary>${security.outerHTML}</details>`:''}<div class=\"mb91-profile-actions\">${extras}</div></section><dialog class=\"mb91-dialog\" id=\"mb91Edit\"><div class=\"mb91-section-head\"><h2>Modifier mon profil</h2>${action('close','Fermer')}</div>${form.outerHTML}</dialog></div>`};\nfunction modal(title,html){let d=$('mb91Modal');if(!d){d=document.createElement('dialog');d.id='mb91Modal';d.className='mb91-dialog';document.body.append(d)}d.innerHTML=`<div class=\"mb91-section-head\"><h2>${E(title)}</h2>${action('close','Fermer')}</div><div class=\"mb91-body\">${html}</div>`;if(!d.open)d.showModal();return d}\nfunction wait(title){modal(title,'<p>Chargement…</p>')}\nfunction addTeacher(){modal('Ajouter un enseignant',`<form id=\"mb91AddTeacher\"><label class=\"field\"><span>Nom et prénom</span><input class=\"input\" name=\"full_name\" required minlength=\"3\" maxlength=\"120\"></label><label class=\"field\"><span>WhatsApp</span><input class=\"input\" name=\"whatsapp\" type=\"tel\" required placeholder=\"+253 77 …\"></label><label class=\"field\"><span>Établissement</span><select class=\"select\" name=\"school\" required>${EGEAcademic.options(EGEAcademic.schools,'','Choisir un établissement',true)}</select></label><p class=\"small muted\">Le compte est approuvé à sa création. Transmettez ensuite un lien de réinitialisation à l’enseignant pour qu’il choisisse son mot de passe.</p><button class=\"btn primary\" type=\"submit\">Créer le compte</button></form>`)}\ndocument.addEventListener('click',e=>{if(e.target.closest?.('[data-mb91=\"add-teacher\"]')&&admin())addTeacher()});\ndocument.addEventListener('submit',async e=>{const f=e.target;if(f.id!=='mb91AddTeacher')return;e.preventDefault();e.stopImmediatePropagation();if(!admin())return;const b=f.querySelector('button[type=\"submit\"]');b.disabled=true;try{const {data,error}=await st.db.functions.invoke('mon-bac-admin-teacher',{body:Object.fromEntries(new FormData(f))});if(error||!data?.user_id)throw Error(typeof functionError==='function'&&error?await functionError(error):'Création impossible.');await loadAll();modal('Enseignant ajouté','<p>Compte approuvé. Ouvrez sa fiche dans Gestion des enseignants, puis utilisez « Réinitialiser l’accès » pour transmettre son lien personnel.</p>');toast('Enseignant ajouté.')}catch(err){toast(err.message||'Création impossible.')}finally{b.disabled=false}},true);\nlet rows=[],joins=[],contacts=[],inbox=[],current='';\nfunction directoryList(q='',target=''){const needle=q.trim().toLocaleLowerCase('fr');const sorted=MBSort.rows('public-classes',rows.filter(g=>(!target||g.id===target)&&[g.name,g.teacher_name,g.school,g.subject||'',JSON.stringify(g.specialties)].join(' ').toLocaleLowerCase('fr').includes(needle)),()=>{$('mb91Directory').innerHTML=directoryList($('mb91Search')?.value||'')},{name:g=>[g.teacher_name,g.name].filter(Boolean).join(' ')});return MBSort.menu('public-classes')+sorted.map(g=>{const j=joins.find(j=>j.group_id===g.id);const label=j?.status==='pending'?'En attente':j?.status==='approved'?'Approuvé':null;\nreturn '<details class=\"mbc-class-item\"><summary><strong>'+E([g.teacher_name||'Enseignant',g.name].filter(Boolean).join(' — '))+'</strong><span class=\"mbc-class-toggle\">Détails <span aria-hidden=\"true\">⌄</span></span></summary><div class=\"mbc-class-detail\"><small>'+E([g.subject||'Matière à préciser',g.school,modeLabel[g.mode],g.code?'Code : '+g.code:''].filter(Boolean).join(' · '))+'</small>'+(label?'<span class=\"mb91-status\">'+E(label)+'</span>':action('join','Rejoindre',g.id))+window.MBMarket.shareButton('class',g.id,[g.teacher_name,g.name].filter(Boolean).join(' — '))+'</div></details>'}).join('')||'<p>Aucune classe trouvée.</p>'}\nasync function showDirectory(target=''){wait('Trouver une classe');rows=await directory();joins=student()?(await learning('student_data')).requests||[]:[];modal('Trouver une classe',`<input class=\"input\" type=\"search\" id=\"mb91Search\" placeholder=\"Classe, matière, enseignant…\" aria-label=\"Rechercher une classe\"><div id=\"mb91Directory\">${directoryList('',target)}</div>${student()?'<form id=\"mb91Code\"><label class=\"field\"><span>Code de classe privée</span><input class=\"input\" name=\"code\" required placeholder=\"Saisissez le code\"></label><button class=\"btn primary\" type=\"submit\">Demander à rejoindre</button></form>':''}`)}\nasync function showClasses(){wait('Accès aux classes');const gs=await api('classes'),data=await learning('teacher_data');joins=data.requests||[];modal('Accès aux classes',`<h3>Demandes à traiter</h3>${joins.filter(j=>j.status==='pending').map(j=>row(j.student_name,j.group_name,`<div class=\"mb91-actions\">${action('approve','Accepter',j.id)}${action('refuse','Refuser',j.id)}</div>`)).join('')||'<p>Aucune demande en attente.</p>'}<h3>Mes classes</h3>${gs.map(g=>`<section class=\"mb91-card\"><strong>${E(g.name)}</strong><small>${E(g.school)}</small>${g.suspended_at?'':MBMarket.shareButton('class',g.id,g.name)}${g.suspended_at?'<p>Classe suspendue par l’administration.</p>':`<form data-mb91-class=\"${E(g.id)}\"><label class=\"field\"><span>Visibilité</span><select class=\"select\" name=\"mode\">${Object.entries(modeLabel).map(([v,l])=>`<option value=\"${v}\" ${v===g.mode?'selected':''}>${l}</option>`).join('')}</select></label><small>Chaque demande nécessite votre accord.</small><button class=\"btn primary\" type=\"submit\">Enregistrer</button></form>${g.archived_at?action('restore','Restaurer',g.id):action('archive','Archiver',g.id)}`}</section>`).join('')||'<p>Aucune classe créée.</p>'}`)}\nfunction choices(selected=''){return '<option value=\"\">Choisir un destinataire</option>'+contacts.map(p=>`<option value=\"${E(p.id)}\" ${p.id===selected?'selected':''}>${E(p.name)} · ${E(p.role)}</option>`).join('')}\nasync function showMessages(selected=''){wait('Messages');[contacts,inbox]=await Promise.all([api('contacts'),api('messages')]);modal('Messages',`<form id=\"mb91Message\"><label class=\"field\"><span>À</span><select class=\"select\" name=\"id\" required>${choices(selected)}</select></label><label class=\"field\"><span>Message (500 caractères maximum)</span><textarea class=\"input\" name=\"body\" maxlength=\"500\" rows=\"3\" required></textarea></label><button class=\"btn primary\" type=\"submit\">Envoyer</button>${!admin()?action('report','Signaler un comportement'):''}</form><h3>Derniers messages</h3>${inbox.map(m=>`<article class=\"mb91-message ${m.recipient===st.user.id&&!m.read_at?'mb91-unread':''}\"><strong>${E(m.sender===st.user.id?'À '+m.recipient_name:'De '+m.sender_name)}</strong><p>${E(m.body)}</p><small>${E(new Date(m.created_at).toLocaleString('fr-FR'))}</small><div class=\"mb91-actions\">${m.recipient===st.user.id&&!m.read_at?action('read','Marquer comme lu',m.id):''}${m.recipient===st.user.id&&contacts.some(p=>p.id===m.sender)?action('reply','Répondre',m.sender):''}</div></article>`).join('')||'<p>Aucun message.</p>'}`)}\nasync function showReports(){wait('Signalements');const items=await api('reports');modal('Signalements',items.map(r=>`<article class=\"mb91-message\"><strong>${E(r.reporter_name)} → ${E(r.target_name)}</strong><p>${E(r.body)}</p><small>${E(new Date(r.created_at).toLocaleString('fr-FR'))}</small>${r.status==='pending'?action('close-report','Marquer traité',r.id):'<span class=\"mb91-status\">Traité</span>'}</article>`).join('')||'<p>Aucun signalement.</p>')}\ndocument.addEventListener('input',e=>{if(e.target.id==='mb91Search')$('mb91Directory').innerHTML=directoryList(e.target.value)});\ndocument.addEventListener('click',async e=>{const b=e.target.closest?.('[data-mb91=\"resource-join\"]');if(!b||b.disabled)return;b.disabled=true;try{await learning('request_join',{id:b.dataset.id,code:b.dataset.code});b.textContent='En attente';toast('Demande envoyée.')}catch(err){toast(err.message||'Demande impossible.');b.disabled=false}});\ndocument.addEventListener('click',async e=>{const b=e.target.closest?.('[data-mb91]');if(!b||b.disabled)return;const a=b.dataset.mb91,id=b.dataset.id;b.disabled=true;try{if(a==='close'){b.closest('dialog')?.close();return}if(a==='edit'){$('mb91Edit').showModal();return}if(a==='directory'&&student())return await showDirectory();if(a==='classes'&&teacher())return await showClasses();if(a==='messages'&&active())return await showMessages();if(a==='reports'&&admin())return await showReports();if(a==='join'){if(!student()){b.closest('dialog')?.close();st.desired='eleve';st.mode='login';st.screen='auth';render();return}const g=rows.find(x=>x.id===id);if(!g)return;await learning('request_join',{id,code:g.code||''});toast('Demande envoyée.');return await showDirectory()}if(['approve','refuse'].includes(a)){await learning(a==='approve'?'approve_join':'refuse_join',{id});return await showClasses()}if(['archive','restore'].includes(a)){if(!await window.MBDialog.confirm(a==='archive'?'Archiver cette classe ?':'Restaurer cette classe ?'))return;await api(a==='archive'?'archive_class':'restore_class',{id});await loadAll();return await showClasses()}if(a==='read'){await api('read',{id});return await showMessages()}if(a==='reply')return await showMessages(id);if(a==='report'){const selected=$('mb91Message')?.elements.id.value;modal('Signaler un comportement',`<form id=\"mb91Report\"><label class=\"field\"><span>Personne concernée</span><select name=\"id\" class=\"select\" required>${choices(selected)}</select></label><label class=\"field\"><span>Décrivez les faits</span><textarea class=\"input\" name=\"body\" maxlength=\"500\" required rows=\"4\"></textarea></label><p class=\"small muted\">Visible uniquement par l’administration chargée du suivi.</p><button type=\"submit\" class=\"btn primary\">Envoyer le signalement</button></form>`);return}if(a==='close-report'){await api('close_report',{id});return await showReports()}}catch(err){toast(err.message||'Opération impossible.');modal('Une erreur est survenue',`<p>${E(err.message||'Réessayez.')}</p>`)}finally{b.disabled=false}});\ndocument.addEventListener('submit',async e=>{const f=e.target;if(!['mb91Message','mb91Report','mb91Code'].includes(f.id)&&!f.dataset.mb91Class)return;e.preventDefault();e.stopImmediatePropagation();const b=f.querySelector('[type=submit]');b.disabled=true;try{const d=Object.fromEntries(new FormData(f));if(f.id==='mb91Code'){await learning('join_code',d);toast('Demande envoyée.');await showDirectory()}else if(f.id==='mb91Message'){await api('send',d);toast('Message envoyé.');await showMessages(d.id)}else if(f.id==='mb91Report'){await api('report',d);toast('Signalement transmis.');await showMessages()}else{await api('class_mode',{id:f.dataset.mb91Class,mode:d.mode});toast('Visibilité enregistrée.');await loadAll();await showClasses()}}catch(err){toast(err.message||'Opération impossible.')}finally{b.disabled=false}},true);\nfunction tidy(host){for(const el of host.querySelectorAll('[data-v69=\"approve-specialty\"]'))el.remove();for(const el of host.querySelectorAll('.mb76-specialty')){const badge=el.querySelector('.badge');if(badge)badge.remove();if(!el.querySelector('[data-v69=\"remove-specialty\"]')){const p=el.querySelector('.mb76-specialty-text');const subject=p?.querySelector('strong')?.textContent;const [series,level]=(p?.querySelector('small')?.textContent||'').split(' · ');if(subject&&series&&level)el.insertAdjacentHTML('beforeend',`<button class=\"btn mb76-remove\" type=\"button\" data-v69=\"remove-specialty\" data-id=\"${E(series)}\" data-subject=\"${E(subject)}\" data-level=\"${E(level)}\">Retirer</button>`)}}for(const el of host.querySelectorAll('h1,h2,h3,h4,.form-note,button,summary,legend,.badge,label>span,.row-content>small,.notice,.page-head p')){for(const n of el.childNodes){if(n.nodeType!==3)continue;n.textContent=n.textContent.replace(/\\bMes groupes\\b/g,'Mes classes').replace(/\\bNouveau groupe\\b/g,'Nouvelle classe').replace(/\\bCréer (un|le) groupe\\b/g,'Créer une classe').replace(/\\bNom du groupe\\b/g,'Nom de la classe').replace(/\\bGroupes actifs\\b/g,'Classes actives').replace(/\\b(Rejoindre|Choisir) un groupe\\b/g,'$1 une classe').replace(/\\bce groupe\\b/gi,'cette classe').replace(/\\bAucun groupe\\b/g,'Aucune classe').replace(/\\bgroupes associés\\b/g,'classes associées').replace(/\\bgroupe\\(s\\)/g,'classe(s)').replace(/\\bvos groupes\\b/g,'vos classes').replace(/\\bGroupes\\b/g,'Classes').replace(/Envoyer à l’administration/g,'Enregistrer mes spécialités').replace(/Demander la validation/g,'Enregistrer cette spécialité').replace(/Spécialité approuvée/g,'Spécialité enregistrée').replace(/Les spécialités sélectionnées seront soumises à l’administration pour approbation\\./g,'Vos spécialités seront enregistrées immédiatement.').replace(/Cette spécialité doit être validée avant la publication\\./g,'Ajoutez cette spécialité pour publier.').replace(/Validez les matières déclarées avant d’approuver une nouvelle inscription\\./g,'Matières déclarées par l’enseignant.')}}}\nconst oldRender=render;render=function(){const ret=oldRender(),host=$('app');if(!host)return ret;tidy(host);const screen=host.querySelector('.screen');if(!screen)return ret;if(st.screen==='teacher-specialties'){const h=screen.querySelector('.mb76-heading p');if(h)h.textContent=`${MB69.state.specialties.filter(x=>x.teacher_id===st.user.id).length} spécialité(s) enregistrée(s)`}if(st.screen==='teacher-learning'){const note=host.querySelector('.lr-specialty-note');if(note&&note.querySelector('[data-lr=\"request-specialty\"]'))note.firstChild.textContent='Ajoutez cette spécialité pour continuer. '}\nif(st.screen==='student-home'||st.screen==='student-group'||st.screen==='teacher-groups'||st.screen==='teacher-home'||st.screen==='admin-home'){const html=student()?action('directory','Trouver une classe')+action('messages','Messages'):teacher()?action('classes','Accès et demandes')+action('messages','Messages'):admin()?action('messages','Messages')+action('reports','Signalements'):'';if(html){const wrap=document.createElement('div');wrap.className='mb91-shortcuts';wrap.innerHTML=html;const start=screen.querySelector('.page-head,.mb76-heading,h1,.mb-tiles,.mb83-directory');if(start)start.after(wrap);else screen.prepend(wrap);if(active()&&!st.offlineSession)api('unread').then(n=>{if(!wrap.isConnected)return;for(const [key,a] of [['messages','messages'],['requests','classes'],['reports','reports']])if(n[key]){const btn=wrap.querySelector(`[data-mb91=\"${a}\"]`);if(btn)btn.append(' · '+n[key])}}).catch(()=>{})}}\nif(admin()&&st.screen==='admin-users'){const bar=document.createElement('div');bar.className='mb91-shortcuts';bar.innerHTML=action('add-teacher','+ Ajouter un enseignant');screen.prepend(bar)}return ret};\n// Admin detail dialogs are inserted after the base click handler.\ndocument.addEventListener('click',()=>queueMicrotask(()=>{for(const d of document.querySelectorAll('dialog[open]'))tidy(d)}));\nwindow.MB91Share={showDirectory};\n})();\n"],"/monbac-teacher-multicycle-20261119-referentiel-r1-teacher-clean-r1.js":["application/javascript; charset=utf-8",false,"/* monAvenir — un enseignant, plusieurs cycles et établissements. */\n(()=>{'use strict';\nconst E=x=>esc(String(x??'')), tr=(fr,en,ar)=>({fr,en,ar}[window.MBLang?.get?.()||document.documentElement.lang]||fr), teacher=()=>st.role==='enseignant'&&st.user&&!EGEAccount.blocked(st.profile), approved=()=>teacher()&&st.teacher?.status==='approved';\nconst cycles=()=>[['university',tr('Université','University','الجامعة')],['general',tr('Lycée général','General high school','الثانوية العامة')],['lic','LIC'],['college',tr('Collège','Middle school','المرحلة الإعدادية')]];\nconst levels={college:['6e','5e','4e','3e'],general:['Seconde','Première','Terminale'],lic:['Seconde','Première','Terminale','Autre'],university:['L1','L2','L3','M1','M2','Autre']};\nconst names={college:'Collège',general:'Lycée général',lic:'Lycée LIC',university:'Université'};\nconst uni=['UNIVERSITÉ DE DJIBOUTI (UD)','IAE','ISCAE','ACADÉMIE ARABE'];\nconst streams=['GFM','OGRH','IAG','S','ES','L'];\nconst subjects=['Mathématiques','Français','Anglais','Arabe','Gestion Financière','Principes de gestion','Mercatique','Économie et Droit','Management des Organisations','OGRH','IAG','Physique et Chimie','SVT','Histoire-Géographie','Informatique','Comptabilité','Autre'];\n\nconst sg=['Gestion Financière','Mercatique','IAG','OGRH','Management des Organisations','Principes de gestion','Communication'];\nconst sci=['Physique et Chimie','SVT'];\nconst es=['SES'];\nconst common=['Mathématiques','Arabe','Anglais','Philosophie','Histoire-Géographie','Français'];\nfunction subjectGroups(o){let g;if(o.cycle==='college')g=[['Scientifique (S)',sci],['Matières communes',common.filter(x=>x!=='Philosophie')],['Informatique',['IAG']]];else if(o.level==='Seconde'&&o.cycle==='general')g=[['Matières communes',common.filter(x=>x!=='Philosophie')],['Économie et informatique',['IG','SES']]];else g=[['Sciences de gestion (SG)',sg],['Scientifique (S)',sci],['Économie et sociale (ES)',es],['Matières communes',common]];\nconst seen=new Set(g.flatMap(x=>x[1]));const extra=unique(catalog.filter(x=>x.cycle===o.cycle&&(!x.school||x.school===schoolValue(o))&&(!x.level||x.level===o.level)&&(!x.track||x.track===o.track)).map(x=>x.subject)).filter(x=>!seen.has(x));if(extra.length)g.push(['Ajouts de l’administration',extra]);return g;}\nfunction subjectText(s,o){return s==='Français'&&o.cycle!=='college'&&o.level==='Terminale'?'Français de spécialité (Terminale)':s==='Français'&&o.cycle!=='college'&&o.level==='Première'?'Français anticipé (Première)':s==='Physique et Chimie'?'Physique & Chimie':s==='Histoire-Géographie'?'Histoire & Géographie':s==='Principes de gestion'?'Principes de Gestion':s;}\nfunction subjectSelect(o,attr){if(o.cycle==='university')return select('subject',subjects,o.subject,attr+' required');return '<select class=\"select\" name=\"subject\" '+attr+' required><option value=\"\">'+E(tr('Choisir','Choose','اختر'))+'</option>'+subjectGroups(o).map(([label,list])=>'<optgroup label=\"'+E(label)+'\">'+list.map(s=>'<option value=\"'+E(s)+'\" '+(o.subject===s?'selected':'')+'>'+E(subjectText(s,o))+'</option>').join('')+'</optgroup>').join('')+'</select>';}\n\nlet owner='',rows=[],catalog=[],draft=[],selected=new Set(),loaded=false,loading=false,busy=false,group={cycle:'',index:'',name:'',semester:''};\nconst rpc=async(a,d={})=>{const r=await st.db.rpc('mon_bac_teacher_multicycle',{p_action:a,p_data:d});if(r.error)throw Error(r.error.message);return r.data;};\nconst option=(values,v)=>'<option value=\"\">'+E(tr('Choisir','Choose','اختر'))+'</option>'+values.map(x=>{const [k,l]=Array.isArray(x)?x:[x,x];return `<option value=\"${E(k)}\" ${k===v?'selected':''}>${E(l)}</option>`}).join('');\nconst select=(n,values,v,attr='')=>`<select class=\"select\" name=\"${E(n)}\" ${attr}>${option(values,v)}</select>`;\nconst field=(l,x)=>`<label class=\"mbed-field\"><span>${E(l)}</span>${x}</label>`;\nconst input=(n,v,attr='')=>`<input class=\"input\" name=\"${E(n)}\" value=\"${E(v)}\" ${attr}>`;\nconst typeLabel=()=>tr('Type d’établissement','Institution type','نوع المؤسسة');\nconst schoolLabel=()=>tr('Établissement','Institution','المؤسسة');\nconst levelLabel=()=>tr('Niveau','Level','المستوى');\nconst subjectLabel=()=>tr('Matière','Subject','المادة');\nconst cycleLabel=c=>c==='general'?tr('Lycée général','General high school','الثانوية العامة'):c==='lic'?'Lycée LIC':cycles().find(x=>x[0]===c)?.[1]||c;\nconst bucket=c=>c;\nconst unique=a=>[...new Set(a.filter(Boolean))];\nfunction reset(){if(owner===(st.user?.id||''))return;owner=st.user?.id||'';rows=[];catalog=[];draft=[];selected=new Set();loaded=false;loading=false;group={cycle:'',index:'',name:'',semester:''};}\nfunction createRow(b){return {bucket:b,cycle:b,institution_type:['general','lic'].includes(b)?b:'',school:'',schoolOther:'',level:'',track:'',subject:'',subjectOther:''};}\nfunction schools(o){let items=catalog.filter(x=>x.cycle===o.cycle&&x.institution_type===o.institution_type).map(x=>x.school);if(o.cycle==='general')items.push(...EGEAcademic.schools.filter(x=>!uni.includes(x)&&x!=='LIC'&&x!=='AUTRES'));if(o.cycle==='lic')items.push('LIC');if(o.cycle==='university')items.push(...(o.institution_type==='public'?uni.slice(0,1):uni.slice(1)));return unique(items);}\nfunction schoolValue(o){return o.school==='__other__'?o.schoolOther.trim():o.school;}\nfunction drawRow(o,i){const attr=`data-multi-row=\"${i}\"`, sel=(n,x)=>select(n,x,o[n],attr+' required'), inp=n=>input(n,o[n],attr+' required maxlength=\"160\"');let h='';if(o.cycle==='college'||o.cycle==='university')h+=field(typeLabel(),sel('institution_type',[['public',tr('Public','Public','حكومي')],['private',tr('Privé','Private','خاص')]]));if(o.cycle&&o.institution_type){h+=field(schoolLabel(),sel('school',[...schools(o),...(o.cycle==='university'&&o.institution_type==='public'?[]:[['__other__',tr('Autre…','Other…','أخرى…')]])]));if(o.school==='__other__')h+=field(schoolLabel(),inp('schoolOther'));}if(schoolValue(o))h+=field(levelLabel(),sel('level',(levels[o.cycle]||[]).map(l=>[l,MBAcademic.gradeLabel(o.cycle,l)])));if(o.level){if(o.cycle==='general'&&o.level!=='Seconde')h+=field(tr('Série','Stream','الشعبة'),sel('track',streams));if(['lic','university'].includes(o.cycle))h+=field(tr('Filière','Programme','التخصص'),inp('track'));h+=field(subjectLabel(),subjectSelect(o,attr));if(o.cycle==='university'&&o.subject==='Autre')h+=field(subjectLabel(),inp('subjectOther'));}return `<div class=\"mbed-card\" data-multi-box=\"${i}\">${h}<button type=\"button\" class=\"mbed-btn\" data-multi-remove=\"${i}\">${E(tr('Retirer','Remove','حذف'))}</button></div>`;}\nfunction picker(){return `<div id=\"mbmulti-picker\"><h2>${E(tr('Mes cycles d’enseignement','My teaching stages','مراحل التدريس'))}</h2><p class=\"mbed-muted\">${E(tr('Sélectionnez un ou plusieurs cycles. Ajoutez chaque établissement, niveau et matière.','Select one or more stages. Add each institution, level and subject.','اختر مرحلة أو أكثر، ثم أضف المؤسسات والمستويات والمواد.'))}</p><div class=\"mbed-tabs mbmulti-cycle-grid\">${cycles().map(([k,l])=>`<label class=\"mbed-field mbmulti-cycle-option\"><input type=\"checkbox\" data-multi-cycle=\"${k}\" ${selected.has(k)?'checked':''}><span>${E(l)}</span></label>`).join('')}</div>${cycles().filter(([k])=>selected.has(k)).map(([k,l])=>`<section><h3>${E(l)}</h3>${draft.map((r,i)=>r.bucket===k?drawRow(r,i):'').join('')}<button type=\"button\" class=\"mbed-btn\" data-multi-add=\"${k}\">+ ${E(tr('Ajouter un établissement, niveau ou matière','Add institution, level or subject','إضافة مؤسسة أو مستوى أو مادة'))}</button></section>`).join('')}${MBAcademic.requestLink()}</div>`;}\nfunction repaint(){const h=document.getElementById('mbmulti-picker');if(h)h.outerHTML=picker();}\nfunction normalize(){if(!selected.size||!draft.length)throw Error(tr('Choisissez au moins un cycle.','Choose at least one stage.','اختر مرحلة واحدة على الأقل.'));return draft.map(o=>{const school=schoolValue(o),subject=o.subject==='Autre'?o.subjectOther.trim():o.subject,track=o.track.trim();if(!o.cycle||!o.institution_type||school.length<2||!o.level||subject.length<2||(['university','lic'].includes(o.cycle)&&track.length<2)||(o.cycle==='general'&&o.level!=='Seconde'&&!track))throw Error(tr('Complétez chaque parcours.','Complete each teaching assignment.','أكمل كل مسار.'));return {cycle:o.cycle,institution_type:o.institution_type,school,level:o.level,track,subject};});}\nfunction list(){const sorted=MBSort.rows('teacher-assignments',rows,()=>render(),{name:r=>[r.cycle,r.subject,r.school].filter(Boolean).join(' ')});return sorted.length?`<div class=\"mbed-card\"><h2>${E(tr('Mes affectations','My teaching assignments','مهام التدريس'))}</h2>${MBSort.menu(\"teacher-assignments\")}${sorted.map(r=>`<div class=\"mbed-result\"><b>${E(cycleLabel(r.cycle)+' · '+r.subject)}</b><small>${E([r.school,r.level,r.track].filter(Boolean).join(' · '))}</small></div>`).join('')}</div>`:'';}\nfunction createForm(){const matches=rows.map((r,i)=>[r,i]).filter(([r])=>bucket(r.cycle)===group.cycle),r=rows[Number(group.index)];return `<form id=\"mbmulti-create\" class=\"mbed-card\"><h2>${E(tr('Nouvelle classe','New class','صف جديد'))}</h2>${!rows.length?`<p>${E(tr('Déclarez d’abord vos cycles et établissements.','Declare your teaching stages and institutions first.','صرّح أولاً بمراحل التدريس والمؤسسات.'))}</p><button type=\"button\" class=\"btn\" data-act=\"goto\" data-to=\"teacher-specialties\">${E(tr('Mes cycles','My teaching stages','مراحل التدريس'))}</button>`:field(tr('Cycle','Stage','المرحلة'),select('cycle',cycles(),group.cycle,'data-multi-group required'))+(group.cycle?field(tr('Établissement · niveau · matière','Institution · level · subject','المؤسسة · المستوى · المادة'),select('index',matches.map(([x,i])=>[String(i),[cycleLabel(x.cycle),x.school,MBAcademic.gradeLabel(x.cycle,x.level),x.track,x.subject].filter(Boolean).join(' · ')]),group.index,'data-multi-group required')):'')+(group.index!==''&&r?(r.cycle==='university'?field(tr('Classe ou groupe','Class or group','الصف أو المجموعة'),input('name',group.name,'data-multi-group required maxlength=\"90\" list=\"mbmulti-class-list\"'))+`<datalist id=\"mbmulti-class-list\">${[...new Set([...catalog.filter(x=>x.cycle===r.cycle&&x.school===r.school&&x.level===r.level&&(!r.track||x.track===r.track)).map(x=>x.class_name).filter(Boolean),[r.level,r.track].filter(Boolean).join(' ')])].map(x=>`<option value=\"${E(x)}\">`).join('')}</datalist>`:field(tr('Numéro de classe','Class number','رقم الصف'),select('name',MBAcademic.classChoice(r.cycle,r.level,r.track,group.name),group.name,'data-multi-group required'))+(group.name?'<p class=\"mbed-muted\"><strong>'+E(group.name)+'</strong></p>':'')+MBAcademic.requestLink())+(r.cycle==='university'?field(tr('Semestre','Semester','الفصل الدراسي'),select('semester',MBAcademic.semesters(r.level),group.semester,'data-multi-group required')):'')+`<button type=\"submit\" class=\"btn primary full\">${E(tr('Créer','Create','إنشاء'))}</button>`:'')}</form>`;}\nasync function load(){reset();if(!teacher()||!st.db||loading||loaded)return;loading=true;const uid=owner;try{const [a,b]=await Promise.all([rpc('list'),st.db.rpc('mon_bac_academic',{p_action:'catalog',p_data:{}})]);if(owner!==uid)return;rows=a||[];catalog=b.data||[];loaded=true;if(['teacher-enrollment','teacher-home','teacher-specialties','teacher-groups','profile','uni-staff'].includes(st.screen))render();}catch(e){console.warn('monAvenir teaching assignments:',e.message);}finally{if(owner===uid)loading=false;}}\nconst oldRender=render;render=function(){reset();const result=oldRender.apply(this,arguments);if(!teacher())return result;const root=document.getElementById('app');if(!root)return result;const enrollment=root.querySelector('#teacherEnrollmentForm');if(enrollment&&!enrollment.querySelector('#mbmulti-picker')){enrollment.querySelector('#teacherEnrollmentSchool')?.closest('label')?.remove();enrollment.querySelector('.mb69-specialties')?.remove();enrollment.insertAdjacentHTML('afterbegin',picker());}if(st.screen==='teacher-specialties'){const old=root.querySelector('#mb69Specialties');if(old&&!root.querySelector('#mbmulti-profile'))old.insertAdjacentHTML('beforebegin',list()+`<form id=\"mbmulti-profile\" class=\"mbed-card\">${picker()}<button type=\"submit\" class=\"btn primary full\">${E(tr('Enregistrer mes affectations','Save assignments','حفظ المهام'))}</button></form>`);}if(st.screen==='profile'&&!root.querySelector('#mbmulti-link,[data-to=\"teacher-specialties\"]')){const host=root.querySelector('.screen');host?.insertAdjacentHTML('afterbegin',`<button id=\"mbmulti-link\" class=\"btn full\" type=\"button\" data-act=\"goto\" data-to=\"teacher-specialties\">${E(tr('Mes cycles et établissements','My teaching stages and institutions','مراحل التدريس والمؤسسات'))}</button>`);}if(approved()&&st.screen==='profile'&&!root.querySelector('[data-to=\"teacher-qr\"]')){const host=root.querySelector('.screen');host?.insertAdjacentHTML('afterbegin',`<button type=\"button\" class=\"btn full\" data-act=\"goto\" data-to=\"teacher-qr\">${E(tr('Ma carte enseignant','My teacher card','بطاقتي كمعلّم'))}</button>`);}if(approved()&&st.screen==='teacher-groups'&&st.teacherOpen){const prior=root.querySelector('#teacherNewGroupForm')?.closest('section')||[...root.querySelectorAll('.mb93-card')].find(x=>x.querySelector('h2')?.textContent==='Nouvelle classe');if(prior)prior.outerHTML=createForm();else root.querySelector('.mb93-actions')?.insertAdjacentHTML('afterend',createForm());}if(approved()&&st.screen==='teacher-groups'&&rows.some(r=>r.cycle==='university'))root.querySelector('.mb93-actions')?.insertAdjacentHTML('beforeend',`<button type=\"button\" class=\"btn\" data-act=\"goto\" data-to=\"uni-staff\">${E(tr('Mes groupes universitaires','My university groups','مجموعاتي الجامعية'))}</button>`);if(!loaded&&!loading)void load();return result;};\ndocument.addEventListener('change',e=>{const el=e.target;if(el.matches('[data-multi-cycle]')){const b=el.dataset.multiCycle;if(el.checked){selected.add(b);if(!draft.some(r=>r.bucket===b))draft.push(createRow(b));}else{selected.delete(b);draft=draft.filter(r=>r.bucket!==b);}repaint();}else if(el.matches('[data-multi-row]')){const o=draft[Number(el.dataset.multiRow)];if(!o)return;const n=el.name;o[n]=el.value;if(n==='cycle'){Object.assign(o,{institution_type:el.value==='general'?'general':'lic',school:'',schoolOther:'',level:'',track:'',subject:'',subjectOther:''});}if(n==='institution_type')Object.assign(o,{school:'',schoolOther:'',level:'',track:'',subject:'',subjectOther:''});if(n==='school')Object.assign(o,{schoolOther:'',level:'',track:'',subject:'',subjectOther:''});if(n==='level')Object.assign(o,{track:'',subject:'',subjectOther:''});if(n==='track'&&o.cycle!=='university')Object.assign(o,{subject:'',subjectOther:''});if(el.tagName==='SELECT')repaint();else if(n==='schoolOther')repaint();}else if(el.matches('[data-multi-group]')){group[el.name]=el.value;if(el.name==='cycle'){group.index='';group.name='';group.semester='';}if(el.name==='index'){group.name='';group.semester='';}if(el.tagName==='SELECT')document.getElementById('mbmulti-create').outerHTML=createForm();}},true);\ndocument.addEventListener('input',e=>{const el=e.target;if(el.matches('input[data-multi-row]')){const o=draft[Number(el.dataset.multiRow)];if(o)o[el.name]=el.value;}if(el.matches('input[data-multi-group]'))group[el.name]=el.value;},true);\ndocument.addEventListener('click',e=>{const add=e.target.closest('[data-multi-add]'),del=e.target.closest('[data-multi-remove]');if(!add&&!del)return;e.preventDefault();e.stopImmediatePropagation();if(add)draft.push(createRow(add.dataset.multiAdd));else{const i=Number(del.dataset.multiRemove),b=draft[i]?.bucket;draft.splice(i,1);if(!draft.some(r=>r.bucket===b))selected.delete(b);}repaint();},true);\ndocument.addEventListener('submit',async e=>{const f=e.target;if(!['teacherEnrollmentForm','mbmulti-profile','mbmulti-create'].includes(f.id)||!teacher()||!f.querySelector('#mbmulti-picker')&&f.id!=='mbmulti-create')return;e.preventDefault();e.stopImmediatePropagation();if(busy||st.profilePhotoUploading)return;busy=true;const b=f.querySelector('[type=submit]');if(b)b.disabled=true;try{if(f.id==='mbmulti-create'){const r=rows[Number(group.index)];if(group.index===''||!r)throw Error(tr('Choisissez une affectation.','Choose an assignment.','اختر مهمة تدريس.'));await rpc('create',{...r,name:group.name,semester:group.semester});st.teacherOpen=false;group={cycle:'',index:'',name:'',semester:''};await loadAll();if(r.cycle==='university')go('uni-staff');else render();toast(tr('Classe créée.','Class created.','تم إنشاء الصف.'));}else{const result=await rpc('save',{rows:normalize()});rows=result.assignments||[];loaded=true;draft=[];selected=new Set();if(f.id==='teacherEnrollmentForm'){st.teacher=result.request;st.profile={...st.profile,school:result.request.school};st.user=EGEAccount.userWithProfile(st.user,st.profile);st.screen='teacher-home';}await loadAll();render();toast(tr('Affectations enregistrées.','Assignments saved.','تم حفظ المهام.'));}}catch(err){let h=f.querySelector('.mbmulti-error');if(!h){h=document.createElement('p');h.className='mbed-error mbmulti-error';h.setAttribute('role','alert');f.append(h);}h.textContent=err.message;}finally{busy=false;if(b?.isConnected)b.disabled=false;}},true);\nwindow.MBMultiTeacher={schools:()=>unique(rows.filter(r=>r.cycle==='university').map(r=>r.school)),rows:()=>rows.slice()};\nwindow.MBSignupTeacher={\n mount(host){host.innerHTML=picker()},\n clear(){if(!st.user){draft=[];selected=new Set()}},\n snapshot(){return {draft:draft.map(r=>({...r})),selected:[...selected],data:normalize()}},\n restore(snapshot){draft=snapshot.draft.map(r=>({...r}));selected=new Set(snapshot.selected)},\n catalog(data){if(Array.isArray(data)&&data.length){catalog=data;const host=document.querySelector('#mb-signup-academic');if(host&&host.querySelector('#mbmulti-picker'))repaint()}},\n async finish(snapshot){if(!teacher())throw Error('Compte enseignant requis.');if(!st.profile?.avatar_path)throw Error(tr('Ajoutez votre photo de profil.','Add your profile photo.','أضف صورة ملفك الشخصي.'));const uid=st.user.id,result=await rpc('save',{rows:snapshot.data});if(uid!==st.user?.id)throw Error('Session modifiée.');rows=result.assignments||[];loaded=true;draft=[];selected=new Set();st.teacher=result.request;st.profile={...st.profile,school:result.request.school};st.user=EGEAccount.userWithProfile(st.user,st.profile);st.screen='teacher-home';await loadAll();render();toast(tr('Affectations enregistrées.','Assignments saved.','تم حفظ المهام.'));}\n};\n})();\n"],"/mon-bac-encadrement-compact-20261119-sort-r1-teacher-clean-r1.js":["application/javascript; charset=utf-8",false,"/* monAvenir — encadrement EGE et recherche de classe */\n(()=>{'use strict';\nconst E=v=>esc(String(v??'')),tr=(f,e,a)=>{const l=window.MBLang?.get?.();return l==='ar'?a:l==='en'?e:f},T=(f,e,a)=>E(tr(f,e,a));\nconst labels={\ntheme:['Thème','Theme','الموضوع العام'],subtheme:['Sous-thème','Subtheme','الموضوع الفرعي'],problem:['Problématique','Research question','الإشكالية'],titles:['Titres des annexes','Appendix titles','عناوين الملاحق'],a1:['Annexe 1','Appendix 1','الملحق ١'],a2:['Annexe 2','Appendix 2','الملحق ٢'],a3:['Annexe 3','Appendix 3','الملحق ٣'],a4:['Annexe 4','Appendix 4','الملحق ٤'],prelim:['Pages préliminaires','Preliminary pages','الصفحات التمهيدية'],company:['Entreprise et professionnel','Company and professional','المؤسسة والمهني'],questionnaire:['Questionnaire d’entretien','Interview questionnaire','استبيان المقابلة'],interview:['Entretien et réponses','Interview and responses','المقابلة والإجابات'],comparison:['Tableau comparatif','Comparison table','جدول المقارنة'],synthesis:['Synthèse','Synthesis','الخلاصة'],final:['Dossier final','Final project','الملف النهائي']};\nconst statusLabels={new:['Non soumis','Not submitted','لم يُرسل'],pending:['En attente','Pending','قيد المراجعة'],approved:['Validé','Approved','معتمد'],changes:['À corriger','Needs changes','يحتاج إلى تصحيح'],edited:['Modifié · à renvoyer','Edited · resubmit','عُدّل · أعد الإرسال']};\nconst L=k=>T(...(labels[k]||[k,k,k])),S=k=>T(...(statusLabels[k]||statusLabels.new));\nconst student=()=>st.user&&st.role==='eleve'&&st.profile?.account_status==='active'&&!!st.profile?.avatar_path;\nconst teacher=()=>st.user&&st.role==='enseignant'&&st.teacher?.status==='approved';\nconst btn=(f,e,a,act,attrs='',primary=false)=>'<button type=\"button\" class=\"btn '+(primary?'primary':'')+'\" data-mbenc=\"'+act+'\" '+attrs+'>'+T(f,e,a)+'</button>';\nconst rpc=async(action,data={})=>{const r=await st.db.rpc('mon_bac_encadrement',{p_action:action,p_data:data});if(r.error)throw Error(r.error.message);return r.data};\nlet dlg,viewType='',dirRows=[],filters={series:'',subject:'',className:''},teacherData=null,tFilter={series:'',className:'',student:''},tab='dossiers',currentID='',studentData=null,serial=0;\nasync function refreshSynthesisCount(){const sid=st.user?.id;const target=dlg?.querySelector('[data-mbenc-synthesis-count]');if(!target||!dlg.open||!teacher())return;try{const r=await st.db.rpc('mon_bac_synthesis',{p_action:'inbox',p_data:{}});if(r.error||sid!==st.user?.id||!teacher()||!dlg.open||!target.isConnected)return;if(Array.isArray(r.data)){target.textContent=String(r.data.filter(x=>x.status==='pending').length);target.hidden=false;}}catch{}}\ndocument.addEventListener('close',e=>{if(e.target?.id==='ege92-inbox'&&dlg?.open)void refreshSynthesisCount()},true);\nfunction modal(title,body){if(!dlg||!dlg.isConnected){dlg=document.createElement('dialog');dlg.id='mbenc-dialog';dlg.className='mbenc-dialog';document.body.append(dlg);dlg.addEventListener('close',()=>{serial++;viewType='';studentData=null;teacherData=null})}dlg.innerHTML='<header class=\"mbenc-head\"><h2>'+title+'</h2>'+btn('Fermer','Close','إغلاق','close')+'</header><div class=\"mbenc-body\">'+body+'</div>';if(!dlg.open)dlg.showModal();if(dlg.querySelector('[data-mbenc-synthesis-count]'))void refreshSynthesisCount();return dlg}\nconst loading=()=>'<p role=\"status\" class=\"muted\">'+T('Chargement…','Loading…','جارٍ التحميل…')+'</p>';\nconst error=e=>{if(!dlg?.open)return;const box=dlg.querySelector('.mbenc-error');if(box)box.textContent=e?.message||tr('Opération impossible.','Unable to complete action.','تعذّر إتمام العملية.');else dlg.querySelector('.mbenc-body').insertAdjacentHTML('afterbegin','<p class=\"mbenc-error\" role=\"alert\">'+E(e?.message||'Opération impossible.')+'</p>')};\nconst unique=arr=>[...new Set(arr.filter(Boolean))].sort((a,b)=>String(a).localeCompare(String(b),'fr',{numeric:true}));\nconst options=(arr,selected,all)=>'<option value=\"\">'+all+'</option>'+arr.map(x=>'<option value=\"'+E(x)+'\" '+(x===selected?'selected':'')+'>'+E(x)+'</option>').join('');\nconst select=(id,caption,arr,value,all)=>'<label class=\"field\"><span>'+caption+'</span><select class=\"select\" id=\"'+id+'\">'+options(arr,value,all)+'</select></label>';\nconst all=()=>T('Tous','All','الكل');\nfunction directoryBody(){const series=unique(dirRows.map(r=>r.series)),subjects=unique(dirRows.flatMap(r=>[r.subject,...(r.subjects||[])])),classes=unique(dirRows.map(r=>r.name));return '<p class=\"mbenc-error\" role=\"alert\"></p><details class=\"mbenc-card mbc-direct-code\"><summary>'+T('Saisir directement un code de classe','Enter a class code directly','إدخال رمز الصف مباشرة')+' <span aria-hidden=\"true\">⌄</span></summary><form data-mbenc-form=\"join\"><label class=\"field\"><span>'+T('Code de classe','Class code','رمز الصف')+'</span><input class=\"input\" name=\"code\" required maxlength=\"64\" autocomplete=\"off\"></label><button type=\"submit\" class=\"btn primary\">'+T('Demander à rejoindre','Request to join','طلب الانضمام')+'</button></form></details><section class=\"mbenc-card mbc-directory-card\"><h3>'+T('Rechercher une classe','Find a class','ابحث عن صف')+'</h3><div class=\"mbenc-grid\">'+select('mbenc-series',T('Série','Track','الشعبة'),series,filters.series,all())+select('mbenc-subject',T('Matière','Subject','المادة'),subjects,filters.subject,all())+select('mbenc-class',T('Classe','Class','الصف'),classes,filters.className,all())+'</div><p class=\"small muted\">'+T('Les classes de votre série sont affichées. Demandez le code à l’enseignant.','Classes for your track are shown. Ask the teacher for the code.','تظهر صفوف شعبتك. اطلب الرمز من المعلّم.')+'</p><div id=\"mbenc-class-results\"></div></section>'}\nfunction directoryRows(){const el=document.querySelector('#mbenc-class-results');if(!el)return;const bySeries=dirRows.filter(r=>!filters.series||r.series===filters.series);const subjects=unique(bySeries.flatMap(r=>[r.subject,...(r.subjects||[])]));if(!subjects.includes(filters.subject))filters.subject='';const bySubject=bySeries.filter(r=>!filters.subject||r.subject===filters.subject||(r.subjects||[]).includes(filters.subject));const classes=unique(bySubject.map(r=>r.name));if(!classes.includes(filters.className))filters.className='';for(const [id,items,value] of [['mbenc-subject',subjects,filters.subject],['mbenc-class',classes,filters.className]]){const select=document.getElementById(id);if(select)select.innerHTML=options(items,value,all())}const rows=MBSort.rows('class-directory',bySubject.filter(r=>!filters.className||r.name===filters.className),directoryRows,{name:r=>[r.teacher_name,r.name].filter(Boolean).join(' ')});\nel.innerHTML=MBSort.menu('class-directory')+rows.map(r=>'<details class=\"mbc-class-item\"><summary><strong>'+E([r.teacher_name||tr('Enseignant','Teacher','المعلّم'),r.name].filter(Boolean).join(' — '))+'</strong><span class=\"mbc-class-toggle\">'+T('Détails','Details','التفاصيل')+' <span aria-hidden=\"true\">⌄</span></span></summary><div class=\"mbc-class-detail\"><small>'+E([r.school,r.series,[...new Set([r.subject,...(r.subjects||[])].filter(Boolean))].join(', ')].filter(Boolean).join(' · '))+'</small>'+(r.joined?'<span class=\"mbenc-badge approved\">'+T('Inscrit','Enrolled','مسجّل')+'</span>':r.status==='pending'?'<span class=\"mbenc-badge pending\">'+S('pending')+'</span>':btn('Saisir le code','Enter code','أدخل الرمز','class-code','data-id=\"'+E(r.id)+'\"',true))+'</div></details>').join('')||'<p class=\"muted\">'+T('Aucune classe trouvée.','No classes found.','لم يُعثر على صفوف.')+'</p>'}\nasync function openDirectory(){const n=++serial;viewType='directory';modal(T('Trouver une classe','Find a class','البحث عن صف'),loading());try{const rows=await rpc('directory');if(n!==serial||!student())return;dirRows=rows||[];filters={series:st.profile?.series||'',subject:'',className:''};modal(T('Trouver une classe','Find a class','البحث عن صف'),directoryBody());directoryRows()}catch(e){error(e)}}\nfunction codeModal(id){const r=dirRows.find(x=>x.id===id);if(!r)return;modal(T('Rejoindre une classe','Join a class','الانضمام إلى صف'),'<p class=\"mbenc-error\" role=\"alert\"></p><p><strong>'+E(r.name)+'</strong> · '+E(r.teacher_name)+'</p><form data-mbenc-form=\"join\" data-group=\"'+E(id)+'\"><label class=\"field\"><span>'+T('Code communiqué par l’enseignant','Code provided by the teacher','الرمز المقدّم من المعلّم')+'</span><input class=\"input\" name=\"code\" required maxlength=\"64\" autocomplete=\"off\"></label><button class=\"btn primary\" type=\"submit\">'+T('Demander à rejoindre','Request to join','طلب الانضمام')+'</button></form>'+btn('Retour','Back','رجوع','directory'))}\nasync function saveCurrent(){if(!student()||!st.selectedDocId||!st.draft)throw Error(tr('Ouvrez votre dossier EGE.','Open your EGE project.','افتح ملفك الدراسي.'));if(st.saving)throw Error(tr('Enregistrement en cours. Réessayez.','Saving in progress. Try again.','جارٍ الحفظ. أعد المحاولة.'));clearTimeout(st.saveTimer);if(!await saveDoc({silent:true}))throw Error(tr('Enregistrez le dossier en ligne avant de continuer.','Save the project online first.','احفظ الملف عبر الإنترنت أولاً.'))}\nfunction statusBadge(r){return '<span class=\"mbenc-badge '+E(r.status)+'\">'+S(r.status)+'</span>'}\nfunction studentBody(){const d=studentData,association=d.association,other=d.stages.filter(r=>r.stage!=='final'),approved=other.filter(r=>r.status==='approved').length;return '<p class=\"mbenc-error\" role=\"alert\"></p><section class=\"mbenc-card\"><h3>'+T('Mon enseignant référent','My supervising teacher','المعلّم المشرف')+'</h3>'+(association?'<p><strong>'+E(association.name)+'</strong></p>':'<p>'+T('Choisissez un enseignant parmi vos classes rejointes.','Choose a teacher from your enrolled classes.','اختر معلّماً من صفوفك المسجّل بها.')+'</p>')+(d.teachers.length?'<form data-mbenc-form=\"assign\"><label class=\"field\"><span>'+T('Enseignant','Teacher','المعلّم')+'</span><select class=\"select\" name=\"group\" required><option value=\"\">'+T('Choisir un enseignant','Choose a teacher','اختر معلّماً')+'</option>'+d.teachers.map(t=>'<option value=\"'+E(t.group_id)+'\" '+(association?.group_id===t.group_id?'selected':'')+'>'+E([t.name,t.class_name,t.subject].filter(Boolean).join(' · '))+'</option>').join('')+'</select></label><button type=\"submit\" class=\"btn primary\">'+(association?T('Changer l’enseignant','Change teacher','تغيير المعلّم'):T('Associer mon dossier','Link my project','ربط ملفي'))+'</button></form>':'<p>'+T('Aucun enseignant associé à vos classes.','No teachers in your enrolled classes.','لا يوجد معلّم في صفوفك.')+'</p>'+btn('Trouver une classe','Find a class','البحث عن صف','directory'))+'</section><section class=\"mbenc-card\"><h3>'+T('Validations du dossier','Project approvals','اعتمادات الملف')+'</h3><progress max=\"'+other.length+'\" value=\"'+approved+'\"></progress><p class=\"small\">'+approved+' / '+other.length+'</p>'+d.stages.map(r=>'<article class=\"mbenc-row mbenc-stage\"><div><strong>'+L(r.stage)+'</strong>'+statusBadge(r)+(r.feedback?'<p class=\"mbenc-feedback\">'+E(r.feedback)+'</p>':'')+(!r.ready?'<small>'+T('À compléter','Incomplete','غير مكتمل')+'</small>':'')+'</div>'+(association&&r.ready&&!['pending','approved'].includes(r.status)&&(r.stage!=='final'||approved===other.length)?btn(r.status==='changes'||r.status==='edited'?'Renvoyer':'Soumettre',r.status==='changes'||r.status==='edited'?'Resubmit':'Submit',r.status==='changes'||r.status==='edited'?'إعادة الإرسال':'إرسال','submit','data-stage=\"'+E(r.stage)+'\"'):'' )+'</article>').join('')+'</section>'}\nasync function openStudent(save=true){const n=++serial;viewType='student';currentID=st.selectedDocId;modal(T('Encadrement EGE','EGE supervision','الإشراف على الدراسة'),loading());try{if(save)await saveCurrent();const d=await rpc('student',{id:currentID});if(n!==serial||!student()||currentID!==st.selectedDocId)return;studentData=d;modal(T('Encadrement EGE','EGE supervision','الإشراف على الدراسة'),studentBody())}catch(e){error(e)}}\nfunction teacherBody(){const d=teacherData,base=d.students,series=unique(base.map(r=>r.series)),classes=unique(base.filter(r=>!tFilter.series||r.series===tFilter.series).map(r=>r.class_name));const filtered=base.filter(r=>(!tFilter.series||r.series===tFilter.series)&&(!tFilter.className||r.class_name===tFilter.className));const students=MBSort.rows('enc-students',Array.from(new Map(filtered.map(r=>[r.id,r])).values()),()=>modal(T('Suivi pédagogique','Teaching supervision','المتابعة التربوية'),teacherBody()));let docs=d.dossiers.filter(r=>(!tFilter.series||r.series===tFilter.series)&&(!tFilter.className||r.class_name===tFilter.className)&&(!tFilter.student||r.student_id===tFilter.student));docs=MBSort.rows('enc-dossiers',docs,()=>modal(T('Suivi pédagogique','Teaching supervision','المتابعة التربوية'),teacherBody()));return '<p class=\"mbenc-error\" role=\"alert\"></p><div class=\"mbenc-tabs\">'+btn('Mes élèves','My students','طلابي','teacher-tab','data-tab=\"students\"',tab==='students')+btn('Dossiers EGE','EGE projects','ملفات الدراسة','teacher-tab','data-tab=\"dossiers\"',tab==='dossiers')+'</div>'+(tab==='dossiers'?'<div class=\"mbenc-synthesis\"><button type=\"button\" class=\"btn\" data-ege92=\"inbox\">'+T('Synthèses à valider','Syntheses awaiting approval','الخلاصات بانتظار الاعتماد')+' <span data-mbenc-synthesis-count hidden style=\"border-radius:999px;background:#c81040;color:white;padding:.15em .55em;font-weight:700\"></span></button></div>':'')+'<div class=\"mbenc-grid\">'+select('mbenc-tseries',T('Série','Track','الشعبة'),series,tFilter.series,all())+select('mbenc-tclass',T('Classe','Class','الصف'),classes,tFilter.className,all())+'</div>'+(tab==='dossiers'?'<label class=\"field\"><span>'+T('Élève','Student','الطالب')+'</span><select class=\"select\" id=\"mbenc-student\"><option value=\"\">'+all()+'</option>'+students.map(r=>'<option value=\"'+E(r.id)+'\" '+(r.id===tFilter.student?'selected':'')+'>'+E(r.name)+'</option>').join('')+'</select></label>':'')+'<div id=\"mbenc-teacher-list\">'+MBSort.menu(tab==='students'?'enc-students':'enc-dossiers')+(tab==='students'?students.map(r=>'<article class=\"mbenc-row\"><div><strong>'+E(r.name)+'</strong><small>'+E([r.series,...unique(filtered.filter(x=>x.id===r.id).map(x=>x.class_name))].join(' · '))+'</small></div>'+btn('Dossiers','Projects','الملفات','student-dossiers','data-id=\"'+E(r.id)+'\"')+'</article>').join(''):docs.map(r=>{const n=r.stages.filter(s=>s.status==='approved').length;return '<article class=\"mbenc-row\"><div><strong>'+E(r.name)+'</strong><small>'+E([r.series,r.class_name,r.title].filter(Boolean).join(' · '))+'</small><small>'+n+'/'+r.stages.length+' · '+r.stages.filter(s=>s.status==='pending').length+' '+T('en attente','pending','قيد المراجعة')+'</small></div>'+btn('Consulter','View','عرض','detail','data-id=\"'+E(r.id)+'\"',true)+'</article>'}).join(''))+'</div>'+((tab==='students'?!students.length:!docs.length)?'<p class=\"muted\">'+T('Aucun résultat.','No results.','لا توجد نتائج.')+'</p>':'')}\nasync function openTeacher(which='dossiers',reset=true){const n=++serial;viewType='teacher';tab=which;if(reset)tFilter={series:'',className:'',student:''};modal(T('Suivi pédagogique','Teaching supervision','المتابعة التربوية'),loading());try{const d=await rpc('teacher');if(n!==serial||!teacher())return;teacherData=d;modal(T('Suivi pédagogique','Teaching supervision','المتابعة التربوية'),teacherBody())}catch(e){error(e)}}\nconst para=(label,value)=>value===undefined||value===null||String(value).trim()===''?'':'<div class=\"mbenc-content\"><strong>'+label+'</strong><p>'+E(value)+'</p></div>';\nfunction sourceLink(v){const m=String(v||'').match(/https:\\/\\/[^\\s<>\"']+/i);if(!m)return '';try{const u=new URL(m[0]);if(u.protocol!=='https:'||u.username||u.password)return '';return '<a href=\"'+E(u.href)+'\" target=\"_blank\" rel=\"noopener noreferrer\">'+T('Consulter la source','View source','عرض المصدر')+'</a>'}catch{return ''}}\nfunction stageContent(k,p){const w=p.study?.workspace||{},t=p.terrain||{};let topic={};try{topic=EGEStudy.topic(p,official)||{}}catch{};const a=(f,e,ar,v)=>para(T(f,e,ar),v);\n if(k==='theme')return a('Thème','Theme','الموضوع العام',topic.theme);\n if(k==='subtheme')return a('Sous-thème','Subtheme','الموضوع الفرعي',topic.subtheme);\n if(k==='problem')return a('Problématique','Research question','الإشكالية',p.problem);\n if(k==='titles')return Array.from({length:p.mode==='binome'?4:3},(_,i)=>para(L('a'+(i+1)),p.annexTitles?.[i+1])).join('');\n if(/^a[1-4]$/.test(k)){const n=+k.slice(1);return para(T('Titre','Title','العنوان'),p.annexTitles?.[n])+para(T('Contenu','Content','المحتوى'),p.annexes?.[n])+para(T('Source','Source','المصدر'),p.sources?.[n])+sourceLink(p.sources?.[n]);}\n if(k==='prelim')return a('Candidat(s)','Candidate(s)','المرشحون',[p.student,p.partner].filter(Boolean).join(' / '))+a('Classe et établissement','Class and school','الصف والمدرسة',[p.className,p.school].filter(Boolean).join(' · '))+a('Remerciements','Acknowledgments','الشكر',w.thanksText)+a('Calendrier','Schedule','الجدول الزمني',(w.calendar||[]).map(x=>[x.date,x.duration,x.task].filter(Boolean).join(' · ')).join('\\n'))+a('Méthodes et outils','Methods and tools','الطرق والأدوات',[w.methods,w.tools,w.produced,w.observations].filter(Boolean).join('\\n'))+a('Répartition des tâches','Task allocation','توزيع المهام',(w.tasks||[]).map(x=>[x.task,x.person,x.date].filter(Boolean).join(' · ')).join('\\n'));\n if(k==='company')return a('Entreprise','Company','المؤسسة',t.organizationName||p.company)+a('Forme juridique','Legal form','الشكل القانوني',t.legalForm)+a('Adresse','Address','العنوان',t.address)+a('Activités','Activities','الأنشطة',t.activities)+a('Historique','History','التاريخ',t.history)+a('Effectif','Workforce','عدد الموظفين',t.employees)+a('Création','Founded','تاريخ الإنشاء',t.creationDate)+a('Chiffre d’affaires','Turnover','رقم الأعمال',t.turnover)+a('Champ d’action','Scope','نطاق النشاط',t.scope)+a('Stratégie','Strategy','الاستراتيجية',t.visionStrategy)+a('Sources','Sources','المصادر',t.organizationSource)+a('Organigramme','Organization chart','الهيكل التنظيمي',t.organizationChartText)+a('Professionnel','Professional','المهني',[t.professionalName,t.professionalRole].filter(Boolean).join(' · '));\n if(k==='questionnaire'||k==='interview')return (k==='interview'?a('Date et méthode','Date and method','التاريخ والطريقة',[t.interviewDate,t.interviewMethod,t.interviewDifficulties].filter(Boolean).join(' · ')):'')+(t.questions||[]).map((q,i)=>para(String(i+1)+'. '+E(q.question),k==='interview'?q.answer:'')||(k==='questionnaire'?'<p>'+E(String(i+1)+'. '+q.question)+'</p>':'')).join('');\n if(k==='comparison')return (t.comparisons||[]).map((r,i)=>'<h4>'+L('a'+(i+1))+'</h4>'+a('Théorie','Theory','النظرية',r.theory)+a('Terrain','Fieldwork','الميدان',r.practice)).join('')+a('Similitudes','Similarities','أوجه التشابه',t.similarities)+a('Différences','Differences','أوجه الاختلاف',t.differences);\n if(k==='synthesis')return a('Introduction','Introduction','المقدمة',w.synthesis?.intro)+a('Développement','Development','العرض',w.synthesis?.development)+a('Conclusion','Conclusion','الخاتمة',w.synthesis?.conclusion);\n return '<p>'+T('Contrôlez l’ensemble des étapes ci-dessus avant la validation finale.','Review all the steps above before final approval.','راجع جميع المراحل أعلاه قبل الاعتماد النهائي.')+'</p>';\n}\nasync function openDetail(id){const n=++serial;viewType='detail';modal(T('Consulter le dossier','View project','عرض الملف'),loading());try{const d=await rpc('detail',{id});if(n!==serial||!teacher())return;const other=d.stages.filter(r=>r.stage!=='final'),approved=other.filter(r=>r.status==='approved').length;modal(E(d.student||d.title),'<p class=\"mbenc-error\" role=\"alert\"></p>'+btn('Retour aux dossiers','Back to projects','العودة إلى الملفات','teacher-back')+'<p>'+E([d.payload.series,d.payload.className].filter(Boolean).join(' · '))+' · '+approved+'/'+other.length+' '+T('validés','approved','معتمدة')+'</p><progress max=\"'+other.length+'\" value=\"'+approved+'\"></progress>'+d.stages.map(r=>'<details class=\"mbenc-card\" '+(r.status==='pending'?'open':'')+'><summary><strong>'+L(r.stage)+'</strong>'+statusBadge(r)+'</summary><div class=\"mbenc-stage-body\">'+(stageContent(r.stage,d.payload)||'<p>'+T('À compléter','Incomplete','غير مكتمل')+'</p>')+(r.feedback?'<p class=\"mbenc-feedback\">'+E(r.feedback)+'</p>':'')+(r.status==='pending'&&(r.stage!=='final'||approved===other.length)?'<form data-mbenc-form=\"review\" data-id=\"'+E(id)+'\" data-stage=\"'+E(r.stage)+'\" data-fingerprint=\"'+E(r.fingerprint)+'\"><label class=\"field\"><span>'+T('Observation (obligatoire si à corriger)','Comment (required for corrections)','الملاحظات (إلزامية عند طلب التصحيح)')+'</span><textarea class=\"textarea\" name=\"feedback\" rows=\"3\" maxlength=\"2000\"></textarea></label><div class=\"mbenc-tabs\"><button class=\"btn primary\" type=\"submit\" value=\"approved\">'+T('Valider','Approve','اعتماد')+'</button><button class=\"btn\" type=\"submit\" value=\"changes\">'+T('À corriger','Request changes','طلب تصحيح')+'</button></div></form>':'')+'</div></details>').join(''))}catch(e){error(e)}}\nconst oldRender=render;render=function(){const r=oldRender();const host=document.querySelector('#app');if(!host)return r;if(student()&&st.draft&&st.selectedDocId&&host.querySelector('.ege92-head')&&!host.querySelector('[data-mbenc=\"student\"]'))host.querySelector('.ege92-head').insertAdjacentHTML('afterend','<section class=\"mbenc-entry\">'+btn('Associer le dossier à l’enseignant','Link project to teacher','ربط الملف بالمعلّم','student','',true)+btn('Suivre les validations','Track approvals','متابعة الاعتمادات','student')+'</section>');if(teacher()&&st.screen==='teacher-home'&&!host.querySelector('[data-mbenc-home]')){const grid=host.querySelector('.mb-tiles');if(grid)grid.insertAdjacentHTML('beforeend','<button type=\"button\" class=\"mb-tile\" data-mbenc=\"teacher\" data-tab=\"dossiers\" data-mbenc-home=\"1\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/><path d=\"M7 12h10M7 16h7\"/></svg><span>'+T('Dossiers EGE','EGE projects','ملفات الدراسة')+'</span></button>');}if(teacher()&&['teacher-all-students','teacher-students','teacher-groups','teacher-review'].includes(st.screen)&&!host.querySelector('[data-mbenc=\"teacher\"]')){const main=host.querySelector('.screen')||host.querySelector('#content');if(main)main.insertAdjacentHTML('afterbegin','<section class=\"mbenc-entry\">'+btn('Mes élèves','My students','طلابي','teacher','data-tab=\"students\"')+btn('Dossiers EGE','EGE projects','ملفات الدراسة','teacher','data-tab=\"dossiers\"',true)+'</section>')}if(!st.user&&dlg?.open)dlg.close();return r};\ndocument.addEventListener('click',async e=>{const native=e.target.closest?.('[data-mb91=\"directory\"]');if(native&&student()){e.preventDefault();e.stopImmediatePropagation();return openDirectory()}const b=e.target.closest?.('[data-mbenc]');if(!b)return;e.preventDefault();e.stopImmediatePropagation();if(b.disabled)return;b.disabled=true;try{switch(b.dataset.mbenc){case 'close':dlg?.close();break;case 'directory':if(student())await openDirectory();break;case 'class-code':if(student())codeModal(b.dataset.id);break;case 'student':if(student())await openStudent();break;case 'teacher':if(teacher())await openTeacher(b.dataset.tab);break;case 'teacher-back':await openTeacher('dossiers',false);break;case 'teacher-tab':tab=b.dataset.tab;tFilter.student='';modal(T('Suivi pédagogique','Teaching supervision','المتابعة التربوية'),teacherBody());break;case 'student-dossiers':tab='dossiers';tFilter.student=b.dataset.id;modal(T('Suivi pédagogique','Teaching supervision','المتابعة التربوية'),teacherBody());break;case 'detail':await openDetail(b.dataset.id);break;case 'submit':if(!student())return;await saveCurrent();await rpc('submit',{id:currentID,stage:b.dataset.stage});await openStudent(false);break;}}catch(err){error(err)}finally{b.disabled=false}},true);\ndocument.addEventListener('change',e=>{const id=e.target.id;const value=e.target.value;if(id==='mbenc-series'){filters.series=value;filters.subject='';filters.className=''}else if(id==='mbenc-subject'){filters.subject=value;filters.className=''}else if(id==='mbenc-class')filters.className=value;else if(id==='mbenc-tseries'){tFilter.series=value;tFilter.className='';tFilter.student=''}else if(id==='mbenc-tclass'){tFilter.className=value;tFilter.student=''}else if(id==='mbenc-student')tFilter.student=value;else return;if(viewType==='directory')directoryRows();if(viewType==='teacher')modal(T('Suivi pédagogique','Teaching supervision','المتابعة التربوية'),teacherBody())});\ndocument.addEventListener('submit',async e=>{const f=e.target,act=f.dataset.mbencForm;if(!act)return;e.preventDefault();e.stopImmediatePropagation();const b=e.submitter||f.querySelector('[type=submit]');if(b?.disabled)return;if(b)b.disabled=true;try{const data=Object.fromEntries(new FormData(f));if(act==='join'&&student()){await rpc('join',{code:data.code,group:f.dataset.group||''});toast(tr('Demande envoyée à l’enseignant.','Request sent to the teacher.','تم إرسال الطلب إلى المعلّم.'));await openDirectory()}else if(act==='assign'&&student()){if(studentData.association&&studentData.association.group_id!==data.group&&!confirm(tr('Changer d’enseignant ? Les nouvelles validations recommenceront.','Change teacher? New approvals will restart.','تغيير المعلّم؟ ستبدأ الاعتمادات الجديدة من جديد.')))return;await saveCurrent();await rpc('assign',{id:currentID,group:data.group});await openStudent(false)}else if(act==='review'&&teacher()){const status=b.value;if(status==='changes'&&!data.feedback.trim())throw Error(tr('Indiquez la correction attendue.','Explain what needs correction.','وضّح التصحيح المطلوب.'));await rpc('review',{id:f.dataset.id,stage:f.dataset.stage,fingerprint:f.dataset.fingerprint,status,feedback:data.feedback});await openDetail(f.dataset.id)}}catch(err){error(err)}finally{if(b)b.disabled=false}},true);\n})();"],"/mon-bac-v90-biometric-origin-r1.js":["application/javascript; charset=utf-8",false,"/* monAvenir V90 — clés d'accès WebAuthn natives Supabase Auth. */\n(()=>{'use strict';\nconst origin='https://monbac.janagaleh.com',brandOrigin='https://monavenir.janagaleh.com';\nconst alternate=()=>location.origin===brandOrigin&&window.isSecureContext;\nconst tr=(fr,en,ar)=>{const lang=window.MBLang?.get?.();return lang==='ar'?ar:lang==='en'?en:fr};\nconst legacyLink=(profile=false)=>origin+'/?connexion=1'+(profile?'&profil=1':'');\nlet working=false;\nconst supported=()=>location.origin===origin&&window.isSecureContext&&typeof window.PublicKeyCredential==='function'&&!!navigator.credentials;\nconst online=()=>supported()&&navigator.onLine&&!st.offlineSession&&!!st.db?.auth;\nconst isLogin=()=>!st.user&&st.screen==='auth'&&st.mode==='login'&&!st.pendingPasswordReset;\nconst isProfile=()=>!!st.user&&st.screen==='profile'&&!st.pendingPasswordReset&&!EGEAccount.blocked(st.profile||{});\nconst message=e=>{const s=String(e?.message||'');if(/disabled|not enabled|not configured|passkey_not_enabled|webauthn.*config/i.test(s+' '+(e?.code||'')))return 'Connexion par clé d’accès non activée sur monAvenir.';if(/abort|cancel|notallowed|not allowed|timed out/i.test(s+' '+e?.name))return 'Opération annulée ou expirée. Vous pouvez réessayer.';return 'Clé d’accès indisponible. Vérifiez votre appareil et votre connexion, ou utilisez votre mot de passe.'};\nconst oldAuth=auth,oldProfile=profile;\nauth=function(){const html=oldAuth();if(!isLogin()||(!supported()&&!alternate()))return html;const template=document.createElement('template');template.innerHTML=html;const form=template.content.querySelector('#authForm');if(!form)return html;const box=document.createElement('div');box.className='mb90-access';box.innerHTML=alternate()?`<a class=\"btn full mb90-key\" href=\"${legacyLink()}\">${fingerprint()} ${tr('Connexion par empreinte','Sign in with fingerprint','الدخول ببصمة الإصبع')}</a><p class=\"mb90-feedback\" style=\"text-align:center\">${tr('Accès sécurisé via l’adresse historique de monAvenir.','Secure sign-in via monAvenir’s original address.','دخول آمن عبر العنوان الأصلي لمنصّة monAvenir.')}</p>`:`<button type=\"button\" class=\"btn full mb90-key\" data-mb90=\"login\">${fingerprint()} Connexion par clé d’accès</button><small>Empreinte, visage ou code de l’appareil.</small><p class=\"mb90-feedback\" role=\"status\" aria-live=\"polite\"></p>`;form.after(box);return template.innerHTML};\nfunction fingerprint(){return '<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><path d=\"M3 12a9 9 0 0 1 18 0M6 12a6 6 0 0 1 12 0v3m-9-3a3 3 0 0 1 6 0c0 4-1 7-3 9M6 15c0 2-.4 3-1 4m4-4c0 2-.5 5-2 6m11-3-1 3m-5-9v3\"/></svg>'}\nprofile=function(){const html=oldProfile();if(!isProfile()||(!supported()&&!alternate()))return html;if(alternate())return html+`<section class=\"card mb90-profile\" aria-label=\"Sécurité du compte\"><h2>${tr('Connexion biométrique','Biometric sign-in','تسجيل الدخول بالقياسات الحيوية')}</h2><p>${tr('Activez ou gérez votre empreinte sur l’adresse historique sécurisée. Vos clés existantes restent valides.','Enable or manage your fingerprint on the original secure address. Existing passkeys remain valid.','فعّل بصمتك أو أدِرها عبر العنوان الأصلي الآمن. تظل مفاتيح المرور الحالية صالحة.')}</p><a class=\"btn full mb90-key\" href=\"${legacyLink(true)}\">${fingerprint()} ${tr('Activer ou gérer mes clés d’accès','Enable or manage passkeys','تفعيل مفاتيح المرور أو إدارتها')}</a><small>${tr('Si nécessaire, connectez-vous puis ouvrez Profil.','If required, sign in, then open Profile.','إذا لزم الأمر، سجّل الدخول ثم افتح الملف الشخصي.')}</small></section>`;return html+`<section class=\"card mb90-profile\" aria-label=\"Sécurité du compte\"><h2>Sécurité du compte</h2><p>Activez une clé d’accès pour vous connecter rapidement avec votre empreinte, votre visage ou le code de votre appareil.</p><button type=\"button\" class=\"btn primary full mb90-key\" data-mb90=\"register\">${fingerprint()} Activer une clé d’accès</button><button type=\"button\" class=\"btn full\" data-mb90=\"list\">Gérer mes clés d’accès</button><small>Votre empreinte ne quitte pas votre appareil. Votre mot de passe reste utilisable.</small><p class=\"mb90-feedback\" role=\"status\" aria-live=\"polite\"></p><div class=\"mb90-list\"></div></section>`};\nfunction feedback(text){const node=document.querySelector('.mb90-feedback');if(node)node.textContent=text;else toast(text)}\nfunction requireOK(result){if(result?.error)throw result.error;return result?.data}\nasync function login(){\n const desired=st.desired;\n const result=requireOK(await st.db.auth.signInWithPasskey());\n if(!result?.session)throw Error('Session absente');\n try{\n  const verified=requireOK(await st.db.auth.getUser());if(!verified?.user)throw Error('Compte non vérifié');\n  st.user=verified.user;st.role=await resolveRole();\n  if(desired==='admin'&&st.role!=='admin'||desired==='enseignant'&&st.role==='eleve')throw Error('wrong-role');\n }catch(e){await st.db.auth.signOut({scope:'local'}).catch(()=>{});Object.assign(st,{user:null,profile:null,staff:null,teacher:null,role:'eleve',screen:'auth'});throw e}\n st.screen=homes[st.role];st.phoneEmailFallback=false;status('Connexion réussie.');await loadAll();render();\n}\nasync function list(){const result=requireOK(await st.db.auth.passkey.list());const entries=Array.isArray(result)?result:result?.passkeys;if(!Array.isArray(entries))throw Error('Liste indisponible');const box=document.querySelector('.mb90-list');if(!box)return;box.replaceChildren();if(!entries.length){box.textContent='Aucune clé enregistrée.';return}for(const entry of entries){if(typeof entry.id!=='string')continue;const row=document.createElement('div');row.className='mb90-entry';const name=document.createElement('span');name.textContent=entry.friendly_name||entry.name||'Clé d’accès';const btn=document.createElement('button');btn.type='button';btn.className='btn';btn.dataset.mb90='delete';btn.dataset.keyId=entry.id;btn.textContent='Retirer';row.append(name,btn);box.append(row)}}\nasync function act(e){const button=e.target.closest?.('[data-mb90]');if(!button)return;e.preventDefault();const action=button.dataset.mb90;if(working||st.busy||!online()||!(action==='login'?isLogin():isProfile())){feedback('Connexion Internet et appareil compatible nécessaires.');return}if(action==='delete'&&!await window.MBDialog.confirm('Retirer cette clé d’accès ? Votre mot de passe reste disponible.'))return;working=true;st.busy=true;button.disabled=true;feedback('Veuillez patienter…');try{if(action==='login')await login();else if(a