h'&&st.mode==='login');const old=host.querySelector('[data-mb-app-update]');if(!home){old?.remove();return}const footer=host.querySelector('.privacy-footer');if(!footer)return;let b=old;if(!b){b=document.createElement('button');b.type='button';b.className='mb-app-update';b.setAttribute('data-mb-app-update','');b.innerHTML=svg+'<span></span>';const secondary=footer.closest('.mb106-secondary');if(secondary)secondary.before(b);else footer.append(b)}const label=busy?labels().busy:labels().normal;if(b.querySelector('span').textContent!==label)b.querySelector('span').textContent=label;b.setAttribute('aria-label',label);b.disabled=busy;b.classList.toggle('is-checking',busy)}\nfunction waitForActivation(worker){return new Promise((resolve,reject)=>{let timer;const done=(err)=>{clearTimeout(timer);worker.removeEventListener('statechange',check);err?reject(err):resolve()};function check(){if(worker.state==='activated')done();else if(worker.state==='redundant')done(new Error('Update failed'))}timer=setTimeout(()=>done(new Error('Update timeout')),45000);worker.addEventListener('statechange',check);check()})}\nasync function update(){if(busy)return;if(!navigator.onLine){notice(labels().offline);return}busy=true;sync();try{if(!sw){location.reload();return}let reg=await sw.getRegistration();const initial=reg?.active;let candidate=reg?.installing||reg?.waiting;const first=!reg;if(!reg)reg=await sw.register('/service-worker-ege-2027.js',{scope:'/',updateViaCache:'none'});else await reg.update();candidate=reg.installing||reg.waiting||candidate;if(candidate)await waitForActivation(candidate);if(changed||first||candidate||reg.active!==initial){notice(labels().reload);location.reload();return}notice(labels().success);location.reload()}catch(e){console.warn(\"monAvenir update:\",e);notice(navigator.onLine?labels().error:labels().offline)}finally{busy=false;sync()}}\ndocument.addEventListener('click',e=>{if(e.target.closest?.('[data-mb-app-update]')){e.preventDefault();e.stopPropagation();void update()}},true);\nconst prior=render;render=function(){const result=prior.apply(this,arguments);sync();return result};sync();\n})();"],"/mon-bac-v90-biometric-monavenir-r3.js":["application/javascript; charset=utf-8",false,"/* monAvenir V90 — clés d'accès WebAuthn natives Supabase Auth. */\n(()=>{'use strict';\nconst origin='https://monavenir.janagaleh.com',legacyOrigin='https://monbac.janagaleh.com';\nconst knownOrigin=()=>location.origin===origin||location.origin===legacyOrigin;\nconst alternate=()=>location.origin===legacyOrigin;\nconst tr=(fr,en,ar)=>{const lang=window.MBLang?.get?.();return lang==='ar'?ar:lang==='en'?en:fr};\nconst canonicalLink=(profile=false)=>origin+'/?connexion=1'+(profile?'&profil=1':'');\nlet working=false;\nconst supported=()=>location.origin===origin&&window.isSecureContext&&typeof window.PublicKeyCredential==='function'&&!!navigator.credentials;\nconst online=()=>supported()&&navigator.onLine&&!st.offlineSession&&!!st.db?.auth;\nconst isLogin=()=>!st.user&&st.screen==='auth'&&st.mode==='login'&&!st.pendingPasswordReset;\nconst isProfile=()=>!!st.user&&st.screen==='profile'&&!st.pendingPasswordReset&&!EGEAccount.blocked(st.profile||{});\nconst message=e=>{const s=String(e?.message||'');if(/disabled|not enabled|not configured|passkey_not_enabled|webauthn.*config/i.test(s+' '+(e?.code||'')))return 'Connexion par clé d’accès non activée sur monAvenir.';if(/abort|cancel|notallowed|not allowed|timed out/i.test(s+' '+e?.name))return tr('Opération annulée ou expirée. Vous pouvez réessayer. Si votre ancienne clé ne fonctionne plus, connectez-vous avec votre mot de passe puis activez une nouvelle clé dans Profil.','Operation cancelled or expired. Try again. If your old passkey no longer works, sign in with your password, then register a new passkey in Profile.','أُلغيت العملية أو انتهت مهلتها. حاول مجددًا. إذا لم يعد مفتاحك القديم يعمل، سجّل الدخول بكلمة المرور ثم فعّل مفتاحًا جديدًا في الملف الشخصي.');return tr('Clé d’accès indisponible. Connectez-vous avec votre mot de passe puis activez une nouvelle clé dans Profil.','Passkey unavailable. Sign in with your password, then register a new passkey in Profile.','مفتاح المرور غير متاح. سجّل الدخول بكلمة المرور ثم فعّل مفتاحًا جديدًا في الملف الشخصي.')};\nconst oldAuth=auth,oldProfile=profile;\nauth=function(){const html=oldAuth();if(!isLogin()||!knownOrigin())return html;const template=document.createElement('template');template.innerHTML=html;const form=template.content.querySelector('#authForm');if(!form)return html;const box=document.createElement('div');box.className='mb90-access';box.innerHTML=alternate()?`<a class=\"btn full mb90-key\" href=\"${canonicalLink()}\">${fingerprint()} ${tr('Connexion par empreinte','Sign in with fingerprint','الدخول ببصمة الإصبع')}</a><p class=\"mb90-feedback\" style=\"text-align:center\">${tr('Connexion sécurisée sur le nouveau domaine monAvenir.','Secure sign-in on the new monAvenir domain.','تسجيل الدخول الآمن عبر نطاق monAvenir الجديد.')}</p>`:`<button type=\"button\" class=\"btn full mb90-key\" data-mb90=\"login\">${fingerprint()} Connexion par clé d’accès</button><small>Empreinte, visage ou code de l’appareil.</small><p class=\"mb90-feedback\" role=\"status\" aria-live=\"polite\"></p>`;form.after(box);return template.innerHTML};\nfunction fingerprint(){return '<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><path d=\"M3 12a9 9 0 0 1 18 0M6 12a6 6 0 0 1 12 0v3m-9-3a3 3 0 0 1 6 0c0 4-1 7-3 9M6 15c0 2-.4 3-1 4m4-4c0 2-.5 5-2 6m11-3-1 3m-5-9v3\"/></svg>'}\nprofile=function(){const html=oldProfile();if(!isProfile()||!knownOrigin())return html;if(alternate())return html+`<section class=\"card mb90-profile\" aria-label=\"Sécurité du compte\"><h2>${tr('Connexion biométrique','Biometric sign-in','تسجيل الدخول بالقياسات الحيوية')}</h2><p>${tr('Activez ou gérez votre empreinte sur le nouveau domaine monAvenir. Les anciennes clés MonBac doivent être réenregistrées.','Enable or manage your fingerprint on the new monAvenir domain. Old MonBac passkeys need to be registered again.','فعّل بصمتك أو أدِرها عبر نطاق monAvenir الجديد. يجب إعادة تسجيل مفاتيح MonBac القديمة.')}</p><a class=\"btn full mb90-key\" href=\"${canonicalLink(true)}\">${fingerprint()} ${tr('Activer ou gérer mes clés d’accès','Enable or manage passkeys','تفعيل مفاتيح المرور أو إدارتها')}</a><small>${tr('Si nécessaire, connectez-vous puis ouvrez Profil.','If required, sign in, then open Profile.','إذا لزم الأمر، سجّل الدخول ثم افتح الملف الشخصي.')}</small></section>`;return html+`<section class=\"card mb90-profile\" aria-label=\"Sécurité du compte\"><h2>Sécurité du compte</h2><p>Activez une clé d’accès pour vous connecter rapidement avec votre empreinte, votre visage ou le code de votre appareil.</p><button type=\"button\" class=\"btn primary full mb90-key\" data-mb90=\"register\">${fingerprint()} Activer une clé d’accès</button><button type=\"button\" class=\"btn full\" data-mb90=\"list\">Gérer mes clés d’accès</button><small>Votre empreinte ne quitte pas votre appareil. Votre mot de passe reste utilisable.</small><p class=\"muted\">${tr('Vous utilisiez MonBac ? Enregistrez une nouvelle clé d’accès pour monAvenir.','Did you use MonBac? Register a new passkey for monAvenir.','هل كنت تستخدم MonBac؟ سجّل مفتاح مرور جديدًا لمنصّة monAvenir.')}</p><p class=\"mb90-feedback\" role=\"status\" aria-live=\"polite\"></p><div class=\"mb90-list\"></div></section>`};\nfunction feedback(text){const node=document.querySelector('.mb90-feedback');if(node)node.textContent=text;else toast(text)}\nfunction requireOK(result){if(result?.error)throw result.error;return result?.data}\nasync function login(){\n const desired=st.desired;\n const result=requireOK(await st.db.auth.signInWithPasskey());\n if(!result?.session)throw Error('Session absente');\n try{\n  const verified=requireOK(await st.db.auth.getUser());if(!verified?.user)throw Error('Compte non vérifié');\n  st.user=verified.user;st.role=await resolveRole();\n  if(desired==='admin'&&st.role!=='admin'||desired==='enseignant'&&st.role==='eleve')throw Error('wrong-role');\n }catch(e){await st.db.auth.signOut({scope:'local'}).catch(()=>{});Object.assign(st,{user:null,profile:null,staff:null,teacher:null,role:'eleve',screen:'auth'});throw e}\n st.screen=homes[st.role];st.phoneEmailFallback=false;status('Connexion réussie.');await loadAll();render();\n}\nasync function list(){const result=requireOK(await st.db.auth.passkey.list());const entries=Array.isArray(result)?result:result?.passkeys;if(!Array.isArray(entries))throw Error('Liste indisponible');const box=document.querySelector('.mb90-list');if(!box)return;box.replaceChildren();if(!entries.length){box.textContent='Aucune clé enregistrée.';return}for(const entry of entries){if(typeof entry.id!=='string')continue;const row=document.createElement('div');row.className='mb90-entry';const name=document.createElement('span');name.textContent=entry.friendly_name||entry.name||'Clé d’accès';const btn=document.createElement('button');btn.type='button';btn.className='btn';btn.dataset.mb90='delete';btn.dataset.keyId=entry.id;btn.textContent='Retirer';row.append(name,btn);box.append(row)}}\nasync function act(e){const button=e.target.closest?.('[data-mb90]');if(!button)return;e.preventDefault();const action=button.dataset.mb90;if(!supported()){feedback(tr('Votre navigateur ne permet pas la biométrie. Ouvrez monAvenir dans Chrome ou Safari et réessayez, ou utilisez votre mot de passe.','Your browser does not support biometrics. Open monAvenir in Chrome or Safari and try again, or use your password.','متصفحك لا يدعم تسجيل الدخول بالقياسات الحيوية. افتح monAvenir في Chrome أو Safari وحاول مجددًا، أو استخدم كلمة المرور.'));return}if(working||st.busy||!online()||!(action==='login'?isLogin():isProfile())){feedback('Connexion Internet et appareil compatible nécessaires.');return}if(action==='delete'&&!await window.MBDialog.confirm('Retirer cette clé d’accès ? Votre mot de passe reste disponible.'))return;working=true;st.busy=true;button.disabled=true;feedback('Veuillez patienter…');try{if(action==='login')await login();else if(action==='register'){requireOK(await st.db.auth.registerPasskey());feedback('Clé d’accès enregistrée.');}else if(action==='list'){await list();feedback('');}else if(action==='delete'){requireOK(await st.db.auth.passkey.delete({passkeyId:button.dataset.keyId}));await list();feedback('Clé d’accès retirée.')}}catch(e){feedback(e?.message==='wrong-role'?'Cette clé appartient à un autre espace. Choisissez le bon espace.':message(e))}finally{working=false;st.busy=false;if(button.isConnected)button.disabled=false}}\ndocument.addEventListener('click',act);\n})();\n"]}