THER DEALINGS IN THE\nSOFTWARE.\n"],"/mon-bac-v91.js":["application/javascript; charset=utf-8",false,"/* monAvenir V91: compact account, class access and moderated communication. */\n(()=>{'use strict';\nconst E=x=>esc(String(x??'')),active=()=>!!st.user&&!EGEAccount.blocked(st.profile||{})&&!EGEAccount.incomplete(st.profile,st.role),teacher=()=>active()&&st.role==='enseignant'&&st.teacher?.status==='approved',student=()=>active()&&st.role==='eleve',admin=()=>active()&&st.role==='admin';\nconst modeLabel={public:'Publique · sans code',visible_code:'Publique · code visible',private_code:'Privée · code caché'};\nconst action=(a,label,id='',extra='')=>`<button type=\"button\" class=\"btn mb91-action\" data-mb91=\"${a}\" data-id=\"${E(id)}\" ${extra}>${E(label)}</button>`;\nconst api=async(a,d={})=>{const r=await st.db.rpc('mon_bac_community',{p_action:a,p_data:d});if(r.error)throw r.error;return r.data};\nconst directory=async()=>{const r=await st.db.rpc('mon_bac_class_directory');if(r.error)throw r.error;return r.data||[]};\nconst learning=async(a,d={})=>{const r=await st.db.rpc('mon_bac_learning',{p_action:a,p_data:d});if(r.error)throw r.error;return r.data};\nconst row=(name,sub='',tail='')=>`<div class=\"mb91-row\"><div><strong>${E(name)}</strong>${sub?`<small>${E(sub)}</small>`:''}</div>${tail}</div>`;\nconst oldProfile=profile;\nprofile=function(){const html=oldProfile();if(!active())return html;const t=document.createElement('template');t.innerHTML=html;const form=t.content.querySelector('#studentProfileForm'),photo=t.content.querySelector('.profile-photo-panel');if(!form||!photo)return html;const p=st.profile||{},role={admin:'Administration',enseignant:'Enseignant',eleve:'Élève'}[st.role];const security=t.content.querySelector('.mb90-profile');const extras=[...t.content.querySelectorAll('[data-act=\"profile-changepass\"],[data-act=\"logout\"]')].map(x=>x.outerHTML).join('');\nreturn `<div class=\"mb91-profile\"><h1>Mon profil</h1><section class=\"mb91-card mb91-identity\">${photo.outerHTML}<div><h2>${E(p.full_name)}</h2><span class=\"mb91-role\">${role}</span></div></section><section class=\"mb91-card\"><div class=\"mb91-section-head\"><h2>Informations personnelles</h2>${action('edit','Modifier')}</div>${row('Nom et prénom',p.full_name)}${row('WhatsApp',p.whatsapp_number?'+'+p.whatsapp_number:'Non renseigné')}${row('Établissement',p.school||'Non renseigné')}${st.role==='eleve'?row('Série et classe',[p.series,p.class_name].filter(Boolean).join(' · ')):''}</section><section class=\"mb91-card\"><h2>Mon compte</h2>${st.role==='enseignant'?row('Mes spécialités','Séries et matières',`<button type=\"button\" class=\"btn\" data-act=\"goto\" data-to=\"teacher-specialties\">Ouvrir</button>`):''}${row('Messages','Échanges et assistance',action('messages','Ouvrir'))}${security?`<details class=\"mb91-security\"><summary>Connexion biométrique</summary>${security.outerHTML}</details>`:''}<div class=\"mb91-profile-actions\">${extras}</div></section><dialog class=\"mb91-dialog\" id=\"mb91Edit\"><div class=\"mb91-section-head\"><h2>Modifier mon profil</h2>${action('close','Fermer')}</div>${form.outerHTML}</dialog></div>`};\nfunction modal(title,html){let d=$('mb91Modal');if(!d){d=document.createElement('dialog');d.id='mb91Modal';d.className='mb91-dialog';document.body.append(d)}d.innerHTML=`<div class=\"mb91-section-head\"><h2>${E(title)}</h2>${action('close','Fermer')}</div><div class=\"mb91-body\">${html}</div>`;if(!d.open)d.showModal();return d}\nfunction wait(title){modal(title,'<p>Chargement…</p>')}\nfunction addTeacher(){modal('Ajouter un enseignant',`<form id=\"mb91AddTeacher\"><label class=\"field\"><span>Nom et prénom</span><input class=\"input\" name=\"full_name\" required minlength=\"3\" maxlength=\"120\"></label><label class=\"field\"><span>WhatsApp</span><input class=\"input\" name=\"whatsapp\" type=\"tel\" required placeholder=\"+253 77 …\"></label><label class=\"field\"><span>Établissement</span><select class=\"select\" name=\"school\" required>${EGEAcademic.options(EGEAcademic.schools,'','Choisir un établissement',true)}</select></label><p class=\"small muted\">Le compte est approuvé à sa création. Transmettez ensuite un lien de réinitialisation à l’enseignant pour qu’il choisisse son mot de passe.</p><button class=\"btn primary\" type=\"submit\">Créer le compte</button></form>`)}\ndocument.addEventListener('click',e=>{if(e.target.closest?.('[data-mb91=\"add-teacher\"]')&&admin())addTeacher()});\ndocument.addEventListener('submit',async e=>{const f=e.target;if(f.id!=='mb91AddTeacher')return;e.preventDefault();e.stopImmediatePropagation();if(!admin())return;const b=f.querySelector('button[type=\"submit\"]');b.disabled=true;try{const {data,error}=await st.db.functions.invoke('mon-bac-admin-teacher',{body:Object.fromEntries(new FormData(f))});if(error||!data?.user_id)throw Error(typeof functionError==='function'&&error?await functionError(error):'Création impossible.');await loadAll();modal('Enseignant ajouté','<p>Compte approuvé. Ouvrez sa fiche dans Gestion des enseignants, puis utilisez « Réinitialiser l’accès » pour transmettre son lien personnel.</p>');toast('Enseignant ajouté.')}catch(err){toast(err.message||'Création impossible.')}finally{b.disabled=false}},true);\nlet rows=[],joins=[],contacts=[],inbox=[],current='';\nfunction directoryList(q=''){const needle=q.trim().toLocaleLowerCase('fr');return rows.filter(g=>`${g.name} ${g.teacher_name} ${g.school} ${g.subject||''} ${JSON.stringify(g.specialties)}`.toLocaleLowerCase('fr').includes(needle)).map(g=>{const j=joins.find(j=>j.group_id===g.id);const label=j?.status==='pending'?'En attente':j?.status==='approved'?'Approuvé':null;return row(g.name,[g.subject||'Matière à préciser',g.teacher_name,g.school,modeLabel[g.mode],g.code?'Code : '+g.code:''].filter(Boolean).join(' · '),label?`<span class=\"mb91-status\">${label}</span>`:action('join','Rejoindre',g.id))}).join('')||'<p>Aucune classe trouvée.</p>'}\nasync function showDirectory(){wait('Trouver une classe');rows=await directory();joins=student()?(await learning('student_data')).requests||[]:[];modal('Trouver une classe',`<input class=\"input\" type=\"search\" id=\"mb91Search\" placeholder=\"Classe, matière, enseignant…\" aria-label=\"Rechercher une classe\"><div id=\"mb91Directory\">${directoryList()}</div>${student()?'<form id=\"mb91Code\"><label class=\"field\"><span>Code de classe privée</span><input class=\"input\" name=\"code\" required placeholder=\"Saisissez le code\"></label><button class=\"btn primary\" type=\"submit\">Demander à rejoindre</button></form>':''}`)}\nasync function showClasses(){wait('Accès aux classes');const gs=await api('classes'),data=await learning('teacher_data');joins=data.requests||[];modal('Accès aux classes',`<h3>Demandes à traiter</h3>${joins.filter(j=>j.status==='pending').map(j=>row(j.student_name,j.group_name,`<div class=\"mb91-actions\">${action('approve','Accepter',j.id)}${action('refuse','Refuser',j.id)}</div>`)).join('')||'<p>Aucune demande en attente.</p>'}<h3>Mes classes</h3>${gs.map(g=>`<section class=\"mb91-card\"><strong>${E(g.name)}</strong><small>${E(g.school)}</small>${g.suspended_at?'<p>Classe suspendue par l’administration.</p>':`<form data-mb91-class=\"${E(g.id)}\"><label class=\"field\"><span>Visibilité</span><select class=\"select\" name=\"mode\">${Object.entries(modeLabel).map(([v,l])=>`<option value=\"${v}\" ${v===g.mode?'selected':''}>${l}</option>`).join('')}</select></label><small>Chaque demande nécessite votre accord.</small><button class=\"btn primary\" type=\"submit\">Enregistrer</button></form>${g.archived_at?action('restore','Restaurer',g.id):action('archive','Archiver',g.id)}`}</section>`).join('')||'<p>Aucune classe créée.</p>'}`)}\nfunction choices(selected=''){return '<option value=\"\">Choisir un destinataire</option>'+contacts.map(p=>`<option value=\"${E(p.id)}\" ${p.id===selected?'selected':''}>${E(p.name)} · ${E(p.role)}</option>`).join('')}\nasync function showMessages(selected=''){wait('Messages');[contacts,inbox]=await Promise.all([api('contacts'),api('messages')]);modal('Messages',`<form id=\"mb91Message\"><label class=\"field\"><span>À</span><select class=\"select\" name=\"id\" required>${choices(selected)}</select></label><label class=\"field\"><span>Message (500 caractères maximum)</span><textarea class=\"input\" name=\"body\" maxlength=\"500\" rows=\"3\" required></textarea></label><button class=\"btn primary\" type=\"submit\">Envoyer</button>${!admin()?action('report','Signaler un comportement'):''}</form><h3>Derniers messages</h3>${inbox.map(m=>`<article class=\"mb91-message ${m.recipient===st.user.id&&!m.read_at?'mb91-unread':''}\"><strong>${E(m.sender===st.user.id?'À '+m.recipient_name:'De '+m.sender_name)}</strong><p>${E(m.body)}</p><small>${E(new Date(m.created_at).toLocaleString('fr-FR'))}</small><div class=\"mb91-actions\">${m.recipient===st.user.id&&!m.read_at?action('read','Marquer comme lu',m.id):''}${m.recipient===st.user.id&&contacts.some(p=>p.id===m.sender)?action('reply','Répondre',m.sender):''}</div></article>`).join('')||'<p>Aucun message.</p>'}`)}\nasync function showReports(){wait('Signalements');const items=await api('reports');modal('Signalements',items.map(r=>`<article class=\"mb91-message\"><strong>${E(r.reporter_name)} → ${E(r.target_name)}</strong><p>${E(r.body)}</p><small>${E(new Date(r.created_at).toLocaleString('fr-FR'))}</small>${r.status==='pending'?action('close-report','Marquer traité',r.id):'<span class=\"mb91-status\">Traité</span>'}</article>`).join('')||'<p>Aucun signalement.</p>')}\ndocument.addEventListener('input',e=>{if(e.target.id==='mb91Search')$('mb91Directory').innerHTML=directoryList(e.target.value)});\ndocument.addEventListener('click',async e=>{const b=e.target.closest?.('[data-mb91=\"resource-join\"]');if(!b||b.disabled)return;b.disabled=true;try{await learning('request_join',{id:b.dataset.id,code:b.dataset.code});b.textContent='En attente';toast('Demande envoyée.')}catch(err){toast(err.message||'Demande impossible.');b.disabled=false}});\ndocument.addEventListener('click',async e=>{const b=e.target.closest?.('[data-mb91]');if(!b||b.disabled)return;const a=b.dataset.mb91,id=b.dataset.id;b.disabled=true;try{if(a==='close'){b.closest('dialog')?.close();return}if(a==='edit'){$('mb91Edit').showModal();return}if(a==='directory')return await showDirectory();if(a==='classes'&&teacher())return await showClasses();if(a==='messages'&&active())return await showMessages();if(a==='reports'&&admin())return await showReports();if(a==='join'){if(!student()){b.closest('dialog')?.close();st.desired='eleve';st.mode='login';st.screen='auth';render();return}const g=rows.find(x=>x.id===id);if(!g)return;await learning('request_join',{id,code:g.code||''});toast('Demande envoyée.');return await showDirectory()}if(['approve','refuse'].includes(a)){await learning(a==='approve'?'approve_join':'refuse_join',{id});return await showClasses()}if(['archive','restore'].includes(a)){if(!await window.MBDialog.confirm(a==='archive'?'Archiver cette classe ?':'Restaurer cette classe ?'))return;await api(a==='archive'?'archive_class':'restore_class',{id});await loadAll();return await showClasses()}if(a==='read'){await api('read',{id});return await showMessages()}if(a==='reply')return await showMessages(id);if(a==='report'){const selected=$('mb91Message')?.elements.id.value;modal('Signaler un comportement',`<form id=\"mb91Report\"><label class=\"field\"><span>Personne concernée</span><select name=\"id\" class=\"select\" required>${choices(selected)}</select></label><label class=\"field\"><span>Décrivez les faits</span><textarea class=\"input\" name=\"body\" maxlength=\"500\" required rows=\"4\"></textarea></label><p class=\"small muted\">Visible uniquement par l’administration chargée du suivi.</p><button type=\"submit\" class=\"btn primary\">Envoyer le signalement</button></form>`);return}if(a==='close-report'){await api('close_report',{id});return await showReports()}}catch(err){toast(err.message||'Opération impossible.');modal('Une erreur est survenue',`<p>${E(err.message||'Réessayez.')}</p>`)}finally{b.disabled=false}});\ndocument.addEventListener('submit',async e=>{const f=e.target;if(!['mb91Message','mb91Report','mb91Code'].includes(f.id)&&!f.dataset.mb91Class)return;e.preventDefault();e.stopImmediatePropagation();const b=f.querySelector('[type=submit]');b.disabled=true;try{const d=Object.fromEntries(new FormData(f));if(f.id==='mb91Code'){await learning('join_code',d);toast('Demande envoyée.');await showDirectory()}else if(f.id==='mb91Message'){await api('send',d);toast('Message envoyé.');await showMessages(d.id)}else if(f.id==='mb91Report'){await api('report',d);toast('Signalement transmis.');await showMessages()}else{await api('class_mode',{id:f.dataset.mb91Class,mode:d.mode});toast('Visibilité enregistrée.');await loadAll();await showClasses()}}catch(err){toast(err.message||'Opération impossible.')}finally{b.disabled=false}},true);\nfunction tidy(host){for(const el of host.querySelectorAll('[data-v69=\"approve-specialty\"]'))el.remove();for(const el of host.querySelectorAll('.mb76-specialty')){const badge=el.querySelector('.badge');if(badge)badge.remove();if(!el.querySelector('[data-v69=\"remove-specialty\"]')){const p=el.querySelector('.mb76-specialty-text');const subject=p?.querySelector('strong')?.textContent;const [series,level]=(p?.querySelector('small')?.textContent||'').split(' · ');if(subject&&series&&level)el.insertAdjacentHTML('beforeend',`<button class=\"btn mb76-remove\" type=\"button\" data-v69=\"remove-specialty\" data-id=\"${E(series)}\" data-subject=\"${E(subject)}\" data-level=\"${E(level)}\">Retirer</button>`)}}for(const el of host.querySelectorAll('h1,h2,h3,h4,.form-note,button,summary,legend,.badge,label>span,.row-content>small,.notice,.page-head p')){for(const n of el.childNodes){if(n.nodeType!==3)continue;n.textContent=n.textContent.replace(/\\bMes groupes\\b/g,'Mes classes').replace(/\\bNouveau groupe\\b/g,'Nouvelle classe').replace(/\\bCréer (un|le) groupe\\b/g,'Créer une classe').replace(/\\bNom du groupe\\b/g,'Nom de la classe').replace(/\\bGroupes actifs\\b/g,'Classes actives').replace(/\\b(Rejoindre|Choisir) un groupe\\b/g,'$1 une classe').replace(/\\bce groupe\\b/gi,'cette classe').replace(/\\bAucun groupe\\b/g,'Aucune classe').replace(/\\bgroupes associés\\b/g,'classes associées').replace(/\\bgroupe\\(s\\)/g,'classe(s)').replace(/\\bvos groupes\\b/g,'vos classes').replace(/\\bGroupes\\b/g,'Classes').replace(/Envoyer à l’administration/g,'Enregistrer mes spécialités').replace(/Demander la validation/g,'Enregistrer cette spécialité').replace(/Spécialité approuvée/g,'Spécialité enregistrée').replace(/Les spécialités sélectionnées seront soumises à l’administration pour approbation\\./g,'Vos spécialités seront enregistrées immédiatement.').replace(/Cette spécialité doit être validée avant la publication\\./g,'Ajoutez cette spécialité pour publier.').replace(/Validez les matières déclarées avant d’approuver une nouvelle inscription\\./g,'Matières déclarées par l’enseignant.')}}}\nconst oldRender=render;render=function(){const ret=oldRender(),host=$('app');if(!host)return ret;tidy(host);const screen=host.querySelector('.screen');if(!screen)return ret;if(st.screen==='teacher-specialties'){const h=screen.querySelector('.mb76-heading p');if(h)h.textContent=`${MB69.state.specialties.filter(x=>x.teacher_id===st.user.id).length} spécialité(s) enregistrée(s)`}if(st.screen==='teacher-learning'){const note=host.querySelector('.lr-specialty-note');if(note&&note.querySelector('[data-lr=\"request-specialty\"]'))note.firstChild.textContent='Ajoutez cette spécialité pour continuer. '}\nif(st.screen==='welcome'||st.screen==='student-home'||st.screen==='student-group'||st.screen==='teacher-groups'||st.screen==='teacher-home'||st.screen==='admin-home'){const html=st.screen==='welcome'?action('directory','Trouver une classe'):student()?action('directory','Trouver une classe')+action('messages','Messages'):teacher()?action('classes','Accès et demandes')+action('messages','Messages'):admin()?action('messages','Messages')+action('reports','Signalements'):'';if(html){const wrap=document.createElement('div');wrap.className='mb91-shortcuts';wrap.innerHTML=html;const start=screen.querySelector('.page-head,.mb76-heading,h1,.mb-tiles,.mb83-directory');if(start)start.after(wrap);else screen.prepend(wrap);if(active()&&!st.offlineSession)api('unread').then(n=>{if(!wrap.isConnected)return;for(const [key,a] of [['messages','messages'],['requests','classes'],['reports','reports']])if(n[key]){const btn=wrap.querySelector(`[data-mb91=\"${a}\"]`);if(btn)btn.append(' · '+n[key])}}).catch(()=>{})}}\nif(admin()&&st.screen==='admin-users'){const bar=document.createElement('div');bar.className='mb91-shortcuts';bar.innerHTML=action('add-teacher','+ Ajouter un enseignant');screen.prepend(bar)}return ret};\n// Admin detail dialogs are inserted after the base click handler.\ndocument.addEventListener('click',()=>queueMicrotask(()=>{for(const d of document.querySelectorAll('dialog[open]'))tidy(d)}));\n})();\n"],"/mon-bac-v91.css":["text/css; charset=utf-8",false,".mb91-profile{max-width:720px;margin:0 auto;display:grid;gap:14px;padding-bottom:24px}.mb91-profile h1{margin:0;font-size:1.55rem}.mb91-card{background:#fff;border:1px solid #e4e8ed;border-radius:18px;padding:16px;min-width:0;overflow-wrap:anywhere}.mb91-card h2,.mb91-dialog h2{margin:0;font-size:1.08rem}.mb91-identity{display:flex;align-items:center;gap:18px}.mb91-identity h2{font-size:1.25rem}.mb91-role{display:inline-block;font-size:.8rem;color:#657486;margin-top:3px}.mb91-identity .profile-photo-panel{position:relative;display:block;flex:0 0 76px;width:76px;padding:0;margin:0;border:0}.mb91-identity .profile-photo-portrait{width:76px;height:76px;margin:0;min-width:0}.mb91-identity .profile-photo-body{position:absolute;inset:0;margin:0;padding:0}.mb91-identity .profile-photo-body h2,.mb91-identity .profile-photo-body>p:not(.profile-photo-state),.mb91-identity .profile-photo-body .field>span{display:none}.mb91-identity .profile-photo-body .field{margin:0;position:absolute;inset:0;cursor:pointer}.mb91-identity .profile-photo-body .field:after{content:'✎';position:absolute;right:-2px;bottom:-2px;background:#fff;border:1px solid #d7dfe7;border-radius:50%;width:28px;height:28px;text-align:center;line-height:26px;pointer-events:none}.mb91-identity #profilePhotoFile{position:absolute;inset:0;opacity:0;width:100%;height:100%;cursor:pointer}.mb91-identity [data-profile-photo-remove]{position:absolute;top:calc(100% + 2px);left:0;padding:2px 5px;font-size:10px;min-height:18px}.mb91-identity .profile-photo-state{position:absolute;top:calc(100% + 20px);z-index:2;width:220px;background:white;font-size:11px}.mb91-identity .profile-photo-state:empty{display:none}.mb91-section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:9px}.mb91-row{display:flex;gap:10px;align-items:center;justify-content:space-between;padding:13px 0;border-bottom:1px solid #edf0f3;min-width:0}.mb91-row:last-child{border-bottom:0}.mb91-row>div:first-child{min-width:0;flex:1}.mb91-row strong,.mb91-row small,.mb91-card>small{display:block;overflow-wrap:anywhere}.mb91-row small,.mb91-card>small{font-size:.82rem;color:#66788a;margin-top:4px}.mb91-action{max-width:100%;white-space:normal;overflow-wrap:anywhere}.mb91-shortcuts,.mb91-actions,.mb91-profile-actions{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.mb91-shortcuts .btn{flex:1 1 140px}.mb91-dialog{box-sizing:border-box;width:min(560px,calc(100% - 24px));max-height:calc(100dvh - 36px);border:0;border-radius:20px;padding:18px;overflow:auto;color:inherit;background:#fff;overscroll-behavior:contain}.mb91-dialog::backdrop{background:#16233799}.mb91-dialog form{display:grid;gap:10px;margin:8px 0 14px}.mb91-dialog input,.mb91-dialog textarea,.mb91-dialog select{width:100%;min-width:0;box-sizing:border-box}.mb91-dialog .mb91-card{margin-bottom:8px}.mb91-message{padding:12px;border:1px solid #e2e7eb;border-radius:12px;margin:8px 0;overflow-wrap:anywhere}.mb91-message p{white-space:pre-wrap;margin:6px 0}.mb91-unread{border-left:4px solid #0b8064}.mb91-status{color:#08775d;font-size:.8rem;font-weight:700}.mb91-security{padding:14px 0;border-bottom:1px solid #edf0f3}.mb91-security summary{cursor:pointer;font-weight:600}.mb91-security .mb90-profile{border:none;box-shadow:none;padding:8px 0;margin:0}.mb91-security .mb90-profile h2,.mb91-security .mb90-profile>p:not(.mb90-feedback),.mb91-security .mb90-profile>small{display:none}.mb91-profile-actions .btn{flex:1 1 140px}.mb91-profile .mb91-identity{min-height:112px}.mb91-profile .mb91-section-head .btn{min-height:36px}.mb91-dialog .mb91-row .btn{flex-shrink:0}.mb91-dialog .mb91-actions .btn{flex:1}.mb91-profile .mb91-card .btn{font-size:.88rem}\n@media(max-width:480px){.mb91-dialog{width:calc(100% - 16px);padding:14px}.mb91-card{padding:13px}.mb91-row .mb91-actions{flex:0 0 105px}.mb91-dialog .mb91-row{align-items:flex-start}.mb91-dialog .mb91-row .btn{font-size:.8rem;padding:8px}.mb91-dialog .mb91-section-head h2{font-size:1.05rem}.mb91-profile .mb91-identity{gap:13px}}\n"],"/mon-bac-v92.js":["application/javascript; charset=utf-8",false,"/* monAvenir — dossier EGE, document par document, sans perte des anciens dossiers. */\n(()=>{'use strict';\nconst screens=['student-wizard','student-annex','student-terrain'], prelim=[['cover','Page de garde'],['contents','Sommaire'],['thanks','Remerciements'],['study','Fiche d’étude']], terrain=[['enterprise','Entreprise'],['professional','Professionnel'],['interview','Entretien'],['comparison','Comparaison'],['synthesis','Synthèse']];\nconst own=()=>st.role==='eleve'&&st.user&&st.draft&&currentDoc()?.owner_id===st.user.id&&(!st.profile||(!EGEAccount.blocked(st.profile)&&!EGEAccount.incomplete(st.profile,st.role)&&!!st.profile.avatar_path));\nconst config=p=>p.study?.workspace||{};\nconst state=()=>{st.draft.study||={};return st.draft.study.workspace||={}};\nconst count=p=>p.mode==='binome'?4:3;\nconst sections=p=>[prelim.concat(p.mode==='binome'?[['tasks','Répartition']]:[]),[['topic','Sujet'],...Array.from({length:count(p)},(_,i)=>['a'+(i+1),'Annexe '+(i+1)])],terrain];\nconst docs=p=>sections(p).flat();\nconst keyForScreen=()=>st.screen==='student-annex'?'a'+st.annex:st.screen==='student-terrain'?egeTerrainTab:st.wizardStep>1?'topic':'cover';\nconst current=p=>docs(p).some(([key])=>key===config(p).current)?config(p).current:docs(p).some(([key])=>key===keyForScreen())?keyForScreen():'cover';\nconst route=k=>/^a\\d$/.test(k)?'student-annex':terrain.some(([x])=>x===k)?'student-terrain':'student-wizard';\nconst B=(label,act,attrs='',cls='btn')=>`<button type=\"button\" class=\"${cls}\" data-ege92=\"${act}\" ${attrs}>${esc(label)}</button>`;\nconst fld=(label,key,val='',area=false,extra='')=>`<label class=\"field\"><span>${esc(label)}</span>${area?`<textarea class=\"textarea\" data-ege92-field=\"${key}\" rows=\"${area===true?4:area}\" ${extra}>${esc(val||'')}</textarea>`:`<input class=\"input\" data-ege92-field=\"${key}\" value=\"${esc(val||'')}\" ${extra}>`}</label>`;\nconst extract=(h,sel)=>{const tmp=document.createElement('template');tmp.innerHTML=h;return tmp.content.querySelector(sel)?.innerHTML||''};\nfunction form(p,key){const c=config(p),t=EGETerrain.normalize(p.terrain,p),topic=EGEStudy.topic(p,official);\n if(key==='cover'){const old=st.wizardStep;st.wizardStep=1;const h=extract(studentWizard(),'.ege-forms');st.wizardStep=old;return h+'<p class=\"ege92-note\">Session 2027 · Les informations sont reprises dans la fiche d’étude.</p>'}\n if(key==='contents')return `<p class=\"ege92-note\">Sommaire automatique. Les numéros de pages définitifs sont calculés à l’export.</p><div class=\"ege92-list\">${docs(p).filter(([k])=>!['cover','contents','topic','professional'].includes(k)).map(([k,l])=>`<div><span>${esc(l)}${/^a\\d/.test(k)?' — '+esc(getTitle(+k.slice(1),p)):''}</span>${B('Ouvrir','open',`data-key=\"${k}\"`,'btn smol')}</div>`).join('')}</div>`;\n if(key==='thanks'){const list=c.thanksPeople||[];return `<div class=\"ege92-list\">${list.map((r,i)=>`<div class=\"ege92-section\"><div style=\"flex:1\">${fld('Nom','thanksPeople.'+i+'.name',r.name)}${fld('Rôle','thanksPeople.'+i+'.role',r.role)}</div>${B('Retirer','remove',`data-list=\"thanksPeople\" data-index=\"${i}\"`,'btn smol')}</div>`).join('')}</div>${B('Ajouter une personne','add','data-list=\"thanksPeople\"')}${B('Préparer le paragraphe','thanks','','btn')} ${fld('Remerciements personnalisables','thanksText',c.thanksText,7)}`}\n if(key==='study'){const cal=c.calendar||[];return `<div class=\"ege92-section\"><strong>${esc(p.student||'Nom à renseigner')}${p.mode==='binome'?' · '+esc(p.partner||'Binôme'):''}</strong><p class=\"ege92-meta\">${esc(p.className||'Classe')} · ${esc(p.school||'Établissement')}</p><p>${esc(topic.theme||'Thème')} · ${esc(topic.subtheme||'Sous-thème')}</p><p><strong>Problématique :</strong> ${esc(p.problem||'À renseigner')}</p>${B('Modifier le sujet','open','data-key=\"topic\"','btn smol')}</div><h3>Calendrier des tâches</h3>${cal.map((r,i)=>`<div class=\"ege92-section\">${fld('Travail réalisé','calendar.'+i+'.task',r.task)}<div class=\"row\">${fld('Date','calendar.'+i+'.date',r.date,false,'type=\"date\"')}${fld('Durée','calendar.'+i+'.duration',r.duration)}</div>${B('Retirer','remove',`data-list=\"calendar\" data-index=\"${i}\"`,'btn smol')}</div>`).join('')}${B('Ajouter une tâche','add','data-list=\"calendar\"')}<h3>Annexes et sources</h3><div class=\"ege92-list\">${Array.from({length:count(p)},(_,i)=>`<div><span><strong>${esc(getTitle(i+1,p))}</strong><br><small>${esc(p.sources?.[i+1]||'Source à renseigner')}</small></span>${B('Modifier','open',`data-key=\"a${i+1}\"`,'btn smol')}</div>`).join('')}</div>${fld('Méthodes de recherche','methods',c.methods,3,'placeholder=\"Internet, livres, enquête terrain…\"')}${fld('Outils utilisés','tools',c.tools,3)}${fld('Documents produits','produced',c.produced,3)}${fld('Observations','observations',c.observations,3)}<h3>Validation de l’encadreur</h3><p>${esc(p.teacher||'Nom de l’encadreur à renseigner dans la page de garde')}</p>${fld('Date','signatureDate',c.signatureDate,false,'type=\"date\"')}<div class=\"ege92-sig\"><div>Signature de l’encadreur</div><div>Cachet de l’établissement</div></div>`}\n if(key==='tasks'){return `<p class=\"ege92-meta\">${esc(p.student||'Candidat 1')} et ${esc(p.partner||'Candidat 2')}</p>${(c.tasks||[]).map((r,i)=>`<div class=\"ege92-section\">${fld('Tâche','tasks.'+i+'.task',r.task)}${fld('Responsable','tasks.'+i+'.person',r.person)}${fld('Date','tasks.'+i+'.date',r.date,false,'type=\"date\"')}${B('Retirer','remove',`data-list=\"tasks\" data-index=\"${i}\"`,'btn smol')}</div>`).join('')}${B('Ajouter une tâche','add','data-list=\"tasks\"')}`}\n if(key==='topic'){const old=st.wizardStep;st.wizardStep=2;const a=extract(studentWizard(),'.ege-forms');st.wizardStep=3;const b=extract(studentWizard(),'.ege-forms');st.wizardStep=old;return a+b+`<p id=\"ege92-words\" class=\"ege92-note\">${(p.problem?.trim().match(/\\S+/g)||[]).length} mots</p>`}\n if(/^a\\d$/.test(key)){const n=+key.slice(1);return `<label class=\"field\"><span>Titre</span><input class=\"input\" data-field=\"annex_title_${n}\" maxlength=\"190\" value=\"${esc(getTitle(n,p))}\"></label><label class=\"field\"><span>Contenu</span><textarea class=\"textarea\" data-field=\"annex_body_${n}\" placeholder=\"Rédigez ou collez votre article. Séparez les paragraphes par une ligne vide.\">${esc(p.annexes?.[n]||'')}</textarea></label><p id=\"wordCount\" class=\"ege92-note\">${(p.annexes?.[n]?.trim().match(/\\S+/g)||[]).length} mots · Objectif : 98 % de la surface utile A4 · une page par annexe</p><label class=\"field\"><span>Source web (HTTPS)</span><textarea class=\"textarea\" rows=\"2\" placeholder=\"https://…\" data-field=\"annex_source_${n}\">${esc(p.sources?.[n]||'')}</textarea></label>${window.MBEgeAI?.sourceField(n,p)||''}<label class=\"ege92-proof\"><input type=\"checkbox\" data-field=\"annex_checked_${n}\" ${p.sourceChecks?.[n]?'checked':''}> Source HTTPS consultée et vérifiée</label><div class=\"ege92-preview\"><h3>Aperçu de l’annexe</h3>${annexPaper(n,p)}</div>`}\n if(key==='synthesis'){const s=c.synthesis||{intro:'',development:t.synthesis||'',conclusion:''};return `${fld('Introduction','synthesis.intro',s.intro,5)}${fld('Développement','synthesis.development',s.development,10)}${fld('Conclusion','synthesis.conclusion',s.conclusion,5)}<div id=\"ege92-review\" class=\"ege92-status\">${reviewHTML()}</div>`}\n const old=egeTerrainTab;egeTerrainTab=key;const html=extract(terrainPage(),'section.card.ege-forms');egeTerrainTab=old;\n if(key==='interview'||key==='comparison'){const tmp=document.createElement('template');tmp.innerHTML=html;const selector=key==='interview'?'fieldset':'section';const rows=[...tmp.content.querySelectorAll(selector)];const n=Math.max(0,Math.min(rows.length-1,Number(c[key+'Index'])||0));rows.forEach((el,i)=>{if(i!==n)el.remove()});const nav=rows.length?`<div class=\"ege92-inline\">${B('←','sub',`data-key=\"${key}\" data-delta=\"-1\" ${n===0?'disabled':''}`)}<strong>${key==='interview'?'Question':'Annexe'} ${n+1} / ${rows.length}</strong>${B('→','sub',`data-key=\"${key}\" data-delta=\"1\" ${n===rows.length-1?'disabled':''}`)}</div>`:'';return nav+tmp.innerHTML}\n return html;\n}\nfunction navigate(k){if(!own()||!docs(st.draft).some(([x])=>x===k))return;state().current=k;st.wizardStep=k==='topic'?2:1;if(/^a\\d$/.test(k))st.annex=+k.slice(1);if(terrain.some(([x])=>x===k))egeTerrainTab=k;go(route(k));touchTerrain();window.scrollTo(0,0)}\nlet review={id:null,uid:null,loading:false,contacts:[],rows:[],error:''};\nasync function rpc(action,data={}){const r=await st.db.rpc('mon_bac_synthesis',{p_action:action,p_data:data});if(r.error)throw r.error;return r.data}\nfunction synth(p){const s=config(p).synthesis||{};return {intro:s.intro||'',development:s.development||'',conclusion:s.conclusion||''}}\nfunction reviewHTML(){const s=synth(st.draft),sameUser=review.uid===st.user?.id&&review.id===st.selectedDocId,rows=sameUser?review.rows:[],contacts=sameUser?review.contacts:[],r=rows[0],same=r&&['intro','development','conclusion'].every(k=>r.content?.[k]===s[k]);return `<h3>Validation par l’enseignant d’économie-droit</h3>${sameUser&&review.error?`<p>${esc(review.error)}</p>`:''}${r?`<p><strong>${same?({pending:'En attente de validation',approved:'Validée par l’enseignant',changes:'À corriger'}[r.status]||r.status):'Synthèse modifiée : renvoyez-la pour validation'}</strong>${r.feedback?' · '+esc(r.feedback):''}</p>`:''}<label class=\"field\"><span>Enseignant</span><select id=\"ege92-teacher\" class=\"select\"><option value=\"\">Choisir un enseignant</option>${contacts.map(x=>`<option value=\"${esc(x.id)}\" ${r?.teacher_id===x.id?'selected':''}>${esc(x.name)}</option>`).join('')}</select></label>${!contacts.length?'<p class=\"ege92-note\">Rejoignez une classe d’économie-droit approuvée pour partager votre synthèse.</p>':''}${B('Envoyer pour validation','submit-review','','btn primary')}`}\nasync function loadReview(force=false){if(!own()||!navigator.onLine||review.loading)return;const id=st.selectedDocId,uid=st.user.id;if(!force&&review.id===id&&review.uid===uid)return;review={id,uid,loading:true,contacts:[],rows:[],error:''};try{const [contacts,rows]=await Promise.all([rpc('contacts'),rpc('status',{id})]);if(review.id===id&&review.uid===uid)Object.assign(review,{contacts,rows})}catch(e){review.error='Validation actuellement indisponible.'}finally{review.loading=false;const el=document.querySelector('#ege92-review');if(el&&own()&&st.selectedDocId===id)el.innerHTML=reviewHTML()}}\nfunction workspace(){const p=st.draft,k=current(p),all=docs(p),index=all.findIndex(([x])=>x===k),groups=sections(p),g=groups.findIndex(items=>items.some(([x])=>x===k)),label=all[index]?.[1]||'Mon dossier';if(k==='synthesis')queueMicrotask(()=>loadReview());return `<main class=\"ege92\"><div class=\"ege92-head\"><h1>Mon dossier EGE</h1><span id=\"saveState\" class=\"ege92-save\">${esc(st.saveBadge)}</span></div>${st.warning?`<p class=\"notice\">${esc(st.warning)} ${st.localCandidate?btn('Récupérer','restore-draft','btn smol'):''}</p>`:''}<div class=\"ege92-progress\"><div><span>${esc(label)}</span><span>Document ${index+1} sur ${all.length}</span></div><progress max=\"${all.length}\" value=\"${index+1}\" aria-label=\"Position dans le dossier\"></progress></div><nav class=\"ege92-tabs\" aria-label=\"Parties du dossier\">${['Préliminaires','Théorie','Terrain'].map((name,i)=>B(name,'open',`data-key=\"${groups[i][0][0]}\" ${i===g?'aria-current=\"page\"':''}`,i===g?'active':'')).join('')}</nav><nav class=\"ege92-steps\" aria-label=\"Documents\">${groups[g].map(([x,l])=>B(l,'open',`data-key=\"${x}\" ${x===k?'aria-current=\"page\"':''}`,x===k?'active':'')).join('')}</nav><section class=\"card ege-forms\"><h2>${esc(label)}</h2>${window.MBEgeAI?.panel(k)||\"\"}${form(p,k)}</section><div class=\"ege92-actions\">${B('Précédent','open',`data-key=\"${all[index-1]?.[0]||k}\" ${!index?'disabled':''}`)}${B('Enregistrer','save')}${B(index===all.length-1?'Exporter':'Suivant',index===all.length-1?'export':'open',`data-key=\"${all[index+1]?.[0]||k}\"`,'btn primary')}</div><details class=\"card\" id=\"ege92-export\"><summary>Exporter mon dossier</summary><p class=\"ege92-note\">Le document reste modifiable. Relisez-le avant remise.</p><div class=\"ege92-export\">${B('Word (.docx)','word','','btn')}${B('PDF (.pdf)','pdf','','btn primary')}</div></details>${window.EGEStudyUI?.tools?.()||''}</main>`}\nconst oldView=view;view=function(){if(own()&&screens.includes(st.screen))return workspace();if(own()&&st.screen==='student-export')return `<main class=\"ege92\"><h1>Exporter mon dossier</h1><section class=\"card\"><p>Word modifiable ou PDF à imprimer.</p><div class=\"ege92-export\">${B('Word (.docx)','word')}${B('PDF (.pdf)','pdf','','btn primary')}</div></section>${B('Retour au dossier','open',`data-key=\"${current(st.draft)}\"`)}</main>`;return oldView()};\nconst oldHome=studentHome;studentHome=function(){let h=oldHome().replace('Continuer mon étude','Reprendre mon travail').replace('Voir mon bilan','Reprendre mon travail');if(!own())return h;const all=docs(st.draft),idx=all.findIndex(([k])=>k===current(st.draft));return h.replace(/<div class=\"compact-legend\"><strong>Progression de la partie théorique<\\/strong>[\\s\\S]*?<div class=\"progress-track\"><div class=\"progress-bar\"[^>]*><\\/div><\\/div>/,`<div class=\"compact-legend\"><strong>${esc(all[idx]?.[1]||'Page de garde')}</strong><strong>Document ${idx+1} sur ${all.length}</strong></div><div class=\"progress-track\"><div class=\"progress-bar\" style=\"width:${(idx+1)/all.length*100}%\"></div></div>`).replace(/<p class=\"study-next\">[\\s\\S]*?<\\/p>/,'')};\nconst originalGo=go;go=function(screen){if(own()&&screens.includes(screen)){const c=state();if(!c.current)c.current=screen==='student-annex'?'a'+st.annex:screen==='student-terrain'?egeTerrainTab:'cover';if(!docs(st.draft).some(([k])=>k===c.current))c.current='cover';screen=route(c.current)}return originalGo(screen)};\nconst oldSelect=selectDoc;selectDoc=function(id){oldSelect(id);if(own()){const c=state();if(!c.current){const r=st.draft.study?.resume;c.current=r?.screen==='student-annex'?'a'+(r.annex||1):r?.screen==='student-terrain'?r.terrainTab||'enterprise':r?.wizardStep>1?'topic':'cover'}}};\ndocument.addEventListener('input',e=>{if(!own())return;const el=e.target,k=el.dataset.ege92Field;if(k){const parts=k.split('.');let obj=state();if(parts[0]==='synthesis'&&!obj.synthesis)obj.synthesis={intro:'',development:st.draft.terrain?.synthesis||'',conclusion:''};for(const x of parts.slice(0,-1)){obj[x]||={};obj=obj[x]}obj[parts.at(-1)]=el.value.slice(0,24000);if(parts[0]==='synthesis'){const s=synth(st.draft),t=st.draft.terrain;t.synthesis=[s.intro,s.development,s.conclusion].join('\\n\\n');t.synthesisReviewed=false;t.synthesisSignature=EGETerrain.synthesisSignature(st.draft)}touchTerrain()}if(el.dataset.field==='dProblem'){const w=document.querySelector('#ege92-words');if(w){const n=(el.value.trim().match(/\\S+/g)||[]).length;w.textContent=n+' mots';w.style.color=''}}});\ndocument.addEventListener('click',e=>{const home=e.target.closest?.('[data-study=\"next\"],[data-study=\"resume\"]');if(home&&own()){e.preventDefault();e.stopImmediatePropagation();navigate(current(st.draft));return}const el=e.target.closest?.('[data-ege92]');if(!el)return;e.preventDefault();e.stopImmediatePropagation();(async()=>{const a=el.dataset.ege92;if(a==='inbox'){await inbox();return}if(a==='review'){const id=el.dataset.id,feedback=document.querySelector('#ege92-feedback-'+id)?.value||'';await rpc('review',{id,status:el.dataset.status,feedback});toast('Avis enregistré.');await inbox();return}if(!own())return;if(a==='open'){navigate(el.dataset.key);return}if(a==='save'){await saveDoc();return}if(a==='export'){const x=document.querySelector('#ege92-export');if(x){x.open=true;x.scrollIntoView({block:'center'})}return}if(a==='sub'){state()[el.dataset.key+'Index']=Math.max(0,(Number(config(st.draft)[el.dataset.key+'Index'])||0)+Number(el.dataset.delta));touchTerrain();render();return}if(a==='add'||a==='remove'){const c=state(),k=el.dataset.list;c[k]||=[];if(a==='add'&&c[k].length<30)c[k].push({});if(a==='remove')c[k].splice(Number(el.dataset.index),1);touchTerrain();render();return}if(a==='thanks'){const c=state();c.thanksText=(c.thanksPeople||[]).filter(x=>x.name?.trim()).map(x=>'Je remercie '+x.name.trim()+(x.role?.trim()?', '+x.role.trim():'')+', pour son accompagnement dans la réalisation de cette étude.').join(' ');touchTerrain();render();return}if(a==='submit-review'){const s=synth(st.draft),teacher=document.querySelector('#ege92-teacher')?.value;if(!teacher||Object.values(s).some(x=>!x.trim()))throw Error('Complétez les trois parties et choisissez un enseignant.');if(!await saveDoc({silent:true}))throw Error('Enregistrez votre dossier en ligne avant l’envoi.');await rpc('submit',{id:st.selectedDocId,teacher});await loadReview(true);toast('Synthèse envoyée.');return}if(a==='word'||a==='pdf'){el.disabled=true;try{await window.EGE92Export.download(structuredClone(st.draft),a,official,st.db);toast('Dossier exporté.')}finally{el.disabled=false}}})().catch(fail)},true);\nasync function inbox(){const rows=await rpc('inbox');let d=document.querySelector('#ege92-inbox');if(!d){d=document.createElement('dialog');d.id='ege92-inbox';d.className='ege92';document.body.append(d)}d.innerHTML=`<div class=\"card\"><div class=\"ege92-inline\"><h2>Synthèses à valider</h2><button class=\"btn\" type=\"button\" onclick=\"this.closest('dialog').close()\">Fermer</button></div>${rows.length?rows.map(r=>`<div class=\"ege92-section\"><strong>${esc(r.student_name||'Élève')}</strong><p>${esc(r.status)}</p>${['intro','development','conclusion'].map((k,i)=>`<h3>${['Introduction','Développement','Conclusion'][i]}</h3><div class=\"ege92-paper\">${esc(r.content?.[k]||'')}</div>`).join('')}<label class=\"field\">Avis<textarea class=\"textarea\" maxlength=\"1500\" id=\"ege92-feedback-${esc(r.id)}\">${esc(r.feedback||'')}</textarea></label>${B('Valider','review',`data-id=\"${esc(r.id)}\" data-status=\"approved\"`,'btn primary')} ${B('À corriger','review',`data-id=\"${esc(r.id)}\" data-status=\"changes\"`)}</div>`).join(''):'<p>Aucune synthèse reçue.</p>'}</div>`;if(!d.open)d.showModal()}\nconst oldRender=render;render=function(){oldRender();if(st.role!=='enseignant'||!st.user)document.querySelector('#ege92-inbox')?.remove();if(st.role==='enseignant'&&st.screen==='teacher-home'){const s=document.querySelector('#content > .screen');if(s&&!s.querySelector('[data-ege92=\"inbox\"]'))s.insertAdjacentHTML('afterbegin',`<div class=\"card\">${B('Synthèses EGE à valider','inbox','','btn')}</div>`)}};\nconst baseReviewHTML=reviewHTML;reviewHTML=function(){return baseReviewHTML()+' <button type=\"button\" class=\"btn smol\" data-ege92-refresh>Actualiser l’avis</button>'};\nconst baseNavigate=navigate;navigate=function(k){baseNavigate(k);if(k==='synthesis')loadReview(true)};\ndocument.addEventListener('click',e=>{if(e.target.closest?.('[data-ege92-refresh]')&&own()){e.preventDefault();loadReview(true)}});\ndocument.addEventListener('input',e=>{if(!own()||!e.target.dataset.ege92Field?.startsWith('synthesis.'))return;const el=document.querySelector('#ege92-review');if(!el)return;const chosen=document.querySelector('#ege92-teacher')?.value;el.innerHTML=reviewHTML();if(chosen&&document.querySelector('#ege92-teacher'))document.querySelector('#ege92-teacher').value=chosen});\nwindow.EGE92={docs,sections,synth};\n})();\n"],"/mon-bac-v92.css":["text/css; charset=utf-8",false,".ege92{max-width:950px;margin:auto;min-width:0;--accent:#cf073f;overflow-wrap:anywhere}.ege92 *{min-width:0;box-sizing:border-box}.ege92-head{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin:0 0 14px}.ege92-head h1{font-size:clamp(23px,5vw,32px);margin:0}.ege92-save{font-size:12px;color:#547164}.ege92-progress{background:white;padding:12px 15px;border-radius:14px;border:1px solid #e4e7ed;margin-bottom:14px}.ege92-progress>div{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;font-size:13px;font-weight:650}.ege92-progress progress{display:block;width:100%;height:8px;accent-color:var(--accent);margin-top:9px}.ege92-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:0 0 10px}.ege92-tabs button,.ege92-steps button{padding:10px 5px;border:1px solid #e2e6eb;background:#fff;color:#384558;border-radius:10px;white-space:normal;overflow-wrap:anywhere;font-size:13px;font-weight:650;min-height:44px}.ege92-tabs button.active,.ege92-steps button.active{background:#fff0f4;color:var(--accent);border-color:var(--accent)}.ege92-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,105px),1fr));gap:6px;margin-bottom:14px}.ege92 .card{padding:clamp(12px,3vw,24px);margin:0 0 12px;max-width:100%}.ege92 h2{font-size:21px;margin:0 0 14px}.ege92 h3{font-size:16px}.ege92 .field{margin:10px 0}.ege92 textarea,.ege92 input,.ege92 select{max-width:100%;width:100%}.ege92 textarea[data-field^=annex_body]{height:clamp(300px,48vh,650px);min-height:300px;resize:vertical}.ege92 .paper{width:100%;max-width:100%;min-height:0;overflow-wrap:anywhere;padding:clamp(12px,4vw,32px);box-shadow:none;margin:0}.ege92 .paper-text{white-space:pre-wrap;overflow-wrap:anywhere}.ege92 .paper-source{overflow-wrap:anywhere}.ege92 .row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.ege92 .row .field{margin:4px 0}.ege92 .ege92-actions{display:flex;flex-wrap:wrap;gap:8px;justify-content:space-between;margin:14px 0 20px}.ege92 .ege92-actions .btn{flex:1 1 110px;white-space:normal}.ege92 .ege92-section{padding:12px;border:1px solid #e4e7ed;border-radius:12px;margin:10px 0}.ege92 .ege92-list{display:grid;gap:6px}.ege92 .ege92-list>div{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid #e4e7ed}.ege92 .ege92-list>div span:first-child{flex:1;overflow-wrap:anywhere}.ege92 .ege92-meta{font-size:13px;color:#64748b}.ege92 .ege92-inline{display:flex;justify-content:space-between;gap:8px;align-items:center;flex-wrap:wrap}.ege92 .ege92-inline .btn{min-height:40px}.ege92 .ege92-status{padding:10px;background:#f3f6fa;border-radius:9px;margin:10px 0}.ege92 .ege92-preview{margin-top:12px}.ege92 .ege92-export{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ege92 .ege92-export .btn{width:100%;white-space:normal}.ege92 .study-tools{margin-top:10px}.ege92 input[type=checkbox]{width:auto}.ege92 .ege92-proof{display:flex;gap:8px;align-items:center;font-size:13px}.ege92 .ege92-proof input{flex:none}.ege92 .ege92-paper{border:1px solid #dce1ea;background:white;padding:14px;white-space:pre-wrap}.ege92 .ege92-note{font-size:12px;color:#64748b;margin:6px 0}.ege92 .ege92-sig{display:grid;grid-template-columns:1fr 1fr;gap:12px}.ege92 .ege92-sig>div{min-height:90px;border:1px dashed #a8b3c3;padding:10px}.ege92 .ege92-logout{display:none}@media(max-width:360px){.ege92 .row{grid-template-columns:1fr}.ege92-tabs button{font-size:12px}.ege92-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}\n\n.ege-paper-text,#paperBody{white-space:pre-wrap!important;overflow-wrap:anywhere;line-height:1.55} textarea[data-field^=\"annex_body_\"]{line-height:1.55;white-space:pre-wrap} .ege-source-suggest a{overflow-wrap:anywhere;word-break:break-word}\n"],"/ege-workspace-export.js":["application/javascript; charset=utf-8",false,"/* Un même plan paginé pour Word et PDF. Les textes restent éditables dans Word. */\n(()=>{'use strict';\nconst X=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&apos;'}[c]));\nconst value=v=>String(v||'À renseigner');\nconst candidates=p=>[p.student,p.mode==='binome'?p.partner:''].filter(Boolean).join(' et ');\nconst year=p=>p.academicYear||p.schoolYear||p.year||'2026–2027';\nfunction totalHours(rows){let minutes=0,unknown=0;for(const r of rows){const s=String(r.duration||'').trim().toLowerCase().replace(',','.');if(!s){unknown++;continue}const h=s.match(/^(\\d+(?:\\.\\d+)?)\\s*(?:h(?:eures?)?)?\\s*(\\d{1,2})?\\s*(?:min)?$/),m=s.match(/^(\\d+)\\s*min(?:utes?)?$/),c=s.match(/^(\\d+):(\\d{2})$/);if(m)minutes+=Number(m[1]);else if(c)minutes+=Number(c[1])*60+Number(c[2]);else if(h)minutes+=Number(h[1])*60+Number(h[2]||0);else unknown++}const a=Math.round(minutes);return `${Math.floor(a/60)} h${a%60?' '+String(a%60).padStart(2,'0')+' min':''}${unknown?' (durées à compléter : '+unknown+')':''}`}\nfunction blocks(p,catalog){const w=p.study?.workspace||{},t=EGETerrain.normalize(p.terrain,p),topic=EGEStudy.topic(p,catalog),n=p.mode==='binome'?4:3,annex=i=>p.annexTitles?.[i]||getTitle(i,p);const b=(label,v)=>({label,text:value(v)});return [\n {title:'ÉTUDE DE GESTION ENCADRÉE',cover:true,items:[b('Baccalauréat – Session 2027',p.series),b('Candidat(s)',[p.student,p.mode==='binome'?p.partner:''].filter(Boolean).join(' et ')),b('Classe',p.className),b('Établissement',p.school),b('Encadreur',p.teacher),b('Thème',topic.theme),b('Sous-thème',topic.subtheme),b('Problématique',p.problem)]},\n {title:'SOMMAIRE',toc:true,items:[]},\n {title:'REMERCIEMENTS',items:[b('',w.thanksText)]},\n {title:'FICHE D’ÉTUDE',items:[b('Candidat(s)',[p.student,p.mode==='binome'?p.partner:''].filter(Boolean).join(' et ')),b('Classe et établissement',[p.className,p.school].filter(Boolean).join(' · ')),b('Thème et sous-thème',[topic.theme,topic.subtheme].filter(Boolean).join(' · ')),b('Problématique',p.problem),b('Calendrier des tâches',(w.calendar||[]).map(r=>[r.date,r.duration,r.task].filter(Boolean).join(' | ')).join('\\n')),b('Annexes et sources',Array.from({length:n},(_,i)=>`${i+1}. ${annex(i+1)} — ${value(p.sources?.[i+1])}`).join('\\n')),b('Méthodes',w.methods),b('Outils utilisés',w.tools),b('Documents produits',w.produced),b('Observations',w.observations),b('Encadreur et date',[p.teacher,w.signatureDate].filter(Boolean).join(' · ')),b('Signature de l’encadreur            Cachet de l’établissement','\\n\\n')]},\n ...(p.mode==='binome'?[{title:'RÉPARTITION DES TÂCHES',items:[b('Tâches / Responsable / Date',(w.tasks||[]).map(r=>[r.task,r.person,r.date].filter(Boolean).join(' | ')).join('\\n'))]}]:[]),\n ...Array.from({length:n},(_,i)=>({title:'ANNEXE '+(i+1)+' – '+annex(i+1),annex:true,items:[b('',p.annexes?.[i+1]),b('Source',p.sources?.[i+1])]})),\n {title:'PRÉSENTATION DE L’ENTREPRISE',items:[...(t.logo?[{image:t.logo,label:'Logo'}]:[]),...['organizationName','legalForm','creationDate','address','employees','turnover','activities','scope','history','visionStrategy','organizationSource'].map(k=>b(EGETerrain.fields[k][0],t[k])),...(t.organizationChart?[{image:t.organizationChart,label:'Organigramme'}]:[]),b('Description de l’organigramme',t.organizationChartText)]},\n {title:'ENTRETIEN AVEC LE PROFESSIONNEL',items:[...['professionalName','professionalRole','interviewDate','interviewMethod','interviewDifficulties'].map(k=>b(EGETerrain.fields[k][0],t[k])),...t.questions.map((q,i)=>b('Question '+(i+1)+(q.annex?' · Annexe '+q.annex:''),value(q.question)+'\\nRéponse : '+value(q.answer)))]},\n {title:'TABLEAU COMPARATIF',items:[...t.comparisons.flatMap(r=>[b('Annexe '+r.annex+' — Recherche documentaire',r.theory),b('Contextualisation sur le terrain',r.practice)]),b('Similitudes',t.similarities),b('Différences',t.differences)]},\n {title:'SYNTHÈSE',items:w.synthesis?[b('Introduction',w.synthesis.intro),b('Développement',w.synthesis.development),b('Conclusion',w.synthesis.conclusion)]:[b('',t.synthesis)]}\n ]}\nasync function assets(sections,db){for(const s of sections)for(const i of s.items)if(i.image){let blob=await window.EGEOffline?.image(i.image.path);if(!blob&&db&&navigator.onLine){const r=await db.storage.from(EGETerrain.BUCKET).download(i.image.path);if(r.error)throw r.error;blob=r.data}if(!blob)throw Error('Image indisponible : reconnectez-vous pour exporter.');i.bytes=new Uint8Array(await blob.arrayBuffer());const w=Math.min(i.label==='Logo'?42:155,i.image.width*.264);i.w=w;i.h=w*i.image.height/i.image.width;if(i.h>115){i.w*=115/i.h;i.h=115}}}\nconst baseBlocks=blocks;blocks=function(p,catalog){const ss=baseBlocks(p,catalog),w=p.study?.workspace||{},t=EGETerrain.normalize(p.terrain,p),n=p.mode==='binome'?4:3;const f=ss.find(x=>x.title==='FICHE D’ÉTUDE');f.items=f.items.flatMap(i=>i.label==='Calendrier des tâches'?[{label:i.label,text:''},{cells:['Date','Durée','Travaux réalisés'],bold:true},...(w.calendar||[]).map(r=>({cells:[value(r.date),value(r.duration),value(r.task)]}))]:i.label==='Annexes et sources'?[{label:i.label,text:''},{cells:['Titre de l’annexe','Source'],bold:true},...Array.from({length:n},(_,j)=>({cells:[(j+1)+'. '+getTitle(j+1,p),value(p.sources?.[j+1])]}))]:i.label?.startsWith('Signature de')?[{cells:['Signature de l’encadreur','Cachet de l’établissement'],bold:true},{cells:['','']},{cells:['','']},{cells:['','']}]:[i]);const c=ss.find(x=>x.title==='TABLEAU COMPARATIF');c.items=[{cells:['Recherche documentaire','Contextualisation sur le terrain'],bold:true},...Array.from({length:n},(_,j)=>{const row=t.comparisons[j]||{};return [{label:'Annexe '+(j+1),text:''},{cells:[value(row.theory),value(row.practice)]}]}).flat(),{label:'Similitudes',text:value(t.similarities)},{label:'Différences',text:value(t.differences)}];const tasks=ss.find(x=>x.title==='RÉPARTITION DES TÂCHES');if(tasks)tasks.items=[{cells:['Tâche','Responsable','Date'],bold:true},...(w.tasks||[]).map(r=>({cells:[value(r.task),value(r.person),value(r.date)]}))];return ss};\nconst ns='http://schemas.openxmlformats.org/wordprocessingml/2006/main',rels='http://schemas.openxmlformats.org/package/2006/relationships',office='http://schemas.openxmlformats.org/officeDocument/2006/relationships/';\n/* Préliminaires : modèle institutionnel et calendrier détaillé commun aux deux exports. */\nconst legacyBlocks=blocks;blocks=function(p,catalog){\n const ss=legacyBlocks(p,catalog),w=p.study?.workspace||{},topic=EGEStudy.topic(p,catalog),n=p.mode==='binome'?4:3,calendar=Array.isArray(w.calendar)?w.calendar:[],b=(label,text)=>({label,text:value(text)}),cell=(...cells)=>({cells}),title=i=>p.annexTitles?.[i]||getTitle(i,p);\n const cover=ss[0];cover.title='DOSSIER D’ÉPREUVE DE GESTION ET D’ÉCONOMIE';cover.items=[{center:true,text:'BACCALAURÉAT GÉNÉRAL – SESSION 2027',bold:true},{center:true,text:'Série : '+value(p.series),bold:true},{center:true,text:'Année scolaire '+year(p)},{space:12},cell('Thème',value(topic.theme)),cell('Sous-thème',value(topic.subtheme)),cell('Problématique',value(p.problem)),{space:10},cell('Préparé par',value(candidates(p))),cell('Classe',value(p.className)),cell('Établissement',value(p.school)),cell('Encadré par',value(p.teacher))];\n const f=ss.find(x=>x.title==='FICHE D’ÉTUDE');f.compact=true;f.items=[cell('Candidat(s)',value(candidates(p))),cell('Série / Classe',[p.series,p.className].filter(Boolean).join(' · ')||'À renseigner'),cell('Établissement',value(p.school)),cell('Année scolaire',year(p)),...(p.candidateNumber||w.candidateNumber?[cell('N° de candidat',p.candidateNumber||w.candidateNumber)]:[]),cell('Thème',value(topic.theme)),cell('Sous-thème',value(topic.subtheme)),cell('Problématique',value(p.problem)),{label:'Calendrier des travaux',text:''},cell('Période',calendar.length?[calendar[0]?.date,calendar.at(-1)?.date].filter(Boolean).join(' au ')||'À renseigner':'À renseigner'),cell('Durée totale',calendar.length?totalHours(calendar):'À renseigner'),{label:'Recherche documentaire : annexes et sources',text:''},{cells:['Titre de l’annexe','Source consultée'],bold:true},...Array.from({length:n},(_,j)=>cell((j+1)+'. '+title(j+1),value(p.sources?.[j+1]))),{label:'Démarche et résultats',text:''},cell('Méthodes de recherche',value(w.methods)),cell('Technologies et outils',value(w.tools)),cell('Documents produits',value(w.produced)),cell('Observations',value(w.observations)),cell('Validé par / Date',[p.teacher,w.signatureDate].filter(Boolean).join(' · ')||'À renseigner'),{cells:['Signature de l’encadreur','Cachet de l’établissement'],bold:true},{cells:['',''],minHeight:15}];\n const steps=['Choix du sujet et de la problématique','Recherche documentaire','Sélection et analyse des documents','Rédaction des annexes','Préparation de l’entretien','Visite et collecte des informations','Comparaison théorie / terrain','Rédaction de la synthèse'];\n const dashboard={title:'TABLEAU DE BORD DE L’ÉLÈVE',dashboard:true,items:[b('Candidat(s)',candidates(p)),{cells:['Date','Durée','Travaux réalisés'],bold:true},...(calendar.length?calendar.map(r=>cell(value(r.date),value(r.duration),value(r.task))):steps.map(t=>cell('','',t))),{cells:['Total',calendar.length?totalHours(calendar):'À renseigner',''],bold:true}]};ss.splice(ss.indexOf(f)+1,0,dashboard);\n return ss;\n};\nasync function download(p,format,catalog,db){const pages=await plan(p,catalog,db),name='EGE-2027-'+String(p.student||'dossier').replace(/[^\\p{L}\\p{N}_-]+/gu,'-').slice(0,60);if(format==='pdf'){(await pdf(p,pages)).save(name+'.pdf');return}const blob=await word(p,pages),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name+'.docx';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}\n/* Layout v2: measure real glyph widths, paginate atomic blocks and preserve\n   source links even when an appendix spans multiple sheets. */\nconst mmTwip=v=>Math.round(v*1440/25.4), pageWidth=174, bodyBudget=234;\nfunction fontDoc(){const d=new jspdf.jsPDF({unit:'mm',format:'a4',compress:true});for(const [style,data] of Object.entries(EGEFonts)){d.addFileToVFS('EGE-'+style+'.ttf',data);d.addFont('EGE-'+style+'.ttf','EGE',style)}return d}\nfunction measured(d,s,width,size,bold=false){d.setFont('EGE',bold?'bold':'normal');d.setFontSize(size);return String(s??'').split('\\n').flatMap(t=>t?d.splitTextToSize(t,width):[''])}\nfunction textItems(d,it,width,size=11,gap=1.8,step=5){\n const out=[],s=String(it.text??'');if(it.label)out.push({kind:'text',lines:measured(d,it.label,width,size,true),size,bold:true,step,gap:.6,keep:true});\n if(!s.trim())return out;\n const source=it.label==='Source';\n for(const par of s.split(/\\n\\s*\\n/).filter(x=>x.trim())){\n  if(source){\n   const parts=par.split(/(https:\\/\\/[^\\s<>\"']+)/gi);\n   for(const part of parts.filter(x=>x.trim())){const url=/^https:\\/\\//i.test(part)?part:undefined;out.push({kind:'text',lines:measured(d,part.trim(),width,10),size:10,step:4.5,gap:1,url})}\n  }else out.push({kind:'text',lines:measured(d,par,width,size),size,step,gap});\n }return out;\n}\nfunction rowItem(d,cells,{header=false,widths=null,compact=false,minHeight=0}={}){\n widths=widths||cells.map(()=>pageWidth/cells.length);\n const size=compact?10.5:10,step=compact?4.2:4.1,lines=cells.map((v,j)=>measured(d,v,widths[j]-6,size,header)),urls=cells.map(v=>String(v).trim().match(/^https:\\/\\/[^\\s<>\"']+$/i)?.[0]);\n return {kind:'row',cells:lines,rawCells:cells,widths,size,step,pad:compact?1.25:1.8,header,urls,minHeight};\n}\nconst height=i=>i.kind==='space'?i.h:i.kind==='image'?i.h+3:i.kind==='row'?Math.max(i.minHeight||0,Math.max(...i.cells.map(a=>a.length))*i.step+2*i.pad):i.lines.length*i.step+i.gap;\nfunction layout(s,d){\n const pages=[],toc=[];\n for(const section of s){\n  const title=section.title, isCompare=title==='TABLEAU COMPARATIF', isFiche=title==='FICHE D’ÉTUDE';\n  let budget=bodyBudget;\n  const newPage=()=>{const heading=current?title+' (suite)':title;budget=(section.cover?195:bodyBudget)-Math.max(0,measured(d,heading,pageWidth,14,true).length-1)*6;return {title:heading,items:[],annex:!!section.annex,cover:!!section.cover,toc:!!section.toc,budget}};\n  let current=null,used=0,activeHeader=null,activeLabel=null;\n  function open(continuation=false){current=newPage();pages.push(current);used=0;if(continuation&&activeHeader){current.items.push(activeHeader);used+=height(activeHeader)}if(continuation&&activeLabel){const label={...activeLabel,lines:[activeLabel.lines[0]+' (suite)'],keep:false};current.items.push(label);used+=height(label)}}\n  function put(i){current.items.push(i);used+=height(i)}\n  open();if(!section.cover&&!section.toc)toc.push([title,pages.length-1]);\n  if(section.toc)continue;\n  if(section.annex){\n   const content=section.items.flatMap(it=>textItems(d,it,pageWidth-8,11,2.2,4.8));\n   // 98% of the usable annex area, without inflating short/incomplete text.\n   const raw=content.reduce((n,i)=>n+height(i),0),target=(budget-5)*.98;\n   if(raw<=target&&raw>target*.65){const add=Math.min(2.5,(target-raw)/Math.max(1,content.reduce((n,i)=>n+i.lines.length,0)));for(const i of content)i.step+=add}\n   for(let j=0;j<content.length;j++){\n    let i=content[j];if(i.keep&&j+1<content.length&&used+height(i)+Math.min(height(content[j+1]),10)>budget-5)open(true);\n    while(height(i)>budget-5-used){const count=Math.floor((budget-5-used-i.gap)/i.step);if(count<2){open(true);continue}const cut=Math.min(count,i.lines.length-1);if(cut<1){open(true);continue}put({...i,lines:i.lines.slice(0,cut),gap:0});i={...i,lines:i.lines.slice(cut)};open(true)}\n    put(i);\n   }continue;\n  }\n  const items=[];\n  for(const it of section.items){\n   if(it.space){items.push({kind:'space',h:it.space});continue}\n   if(it.image){items.push({kind:'image',...it});continue}\n   if(it.cells){\n    const widths=it.cells.length===3?(isFiche||section.dashboard?[35,32,107]:[92,47,35]):it.cells.length===2?(isFiche?[60,114]:section.cover?[52,122]:[87,87]):null;\n    items.push(rowItem(d,it.cells,{header:!!it.bold,widths,compact:!!section.compact,minHeight:it.minHeight||0}));continue;\n   }\n   const lines=textItems(d,it,pageWidth,isFiche?9.5:11,isFiche?.6:1.8,isFiche?3.8:5);if(it.center)for(const i of lines){i.center=true;i.bold=!!it.bold}items.push(...lines);\n  }\n  // Les valeurs extrêmes restent intégrales : compacter seulement dans les limites de lisibilité.\n  if(isFiche){const sum=items.reduce((a,i)=>a+height(i),0);if(sum>budget){for(const i of items){if(i.kind==='row'){i.pad=.7;i.step=3.65;i.size=9.5;i.cells=i.rawCells.map((v,j)=>measured(d,v,i.widths[j]-6,i.size,i.header))}else if(i.kind==='text'){i.step=3.65;i.size=9.5}}}}\n  for(let j=0;j<items.length;j++){\n   let i=items[j],next=items[j+1];\n   if(i.kind==='row'&&i.header){activeHeader=i;activeLabel=null}\n   if(isCompare&&i.kind==='text'&&i.bold&&/^Annexe \\d/.test(i.lines[0])){activeLabel=i;const estimate=next?(height(next)+height(i)+(activeHeader?height(activeHeader):0)<=budget?height(next):25):0;if(used+height(i)+estimate>budget){activeLabel=null;open(true);activeLabel=i}}\n   if(isCompare&&i.kind==='text'&&i.bold&&/^(Similitudes|Différences)$/.test(i.lines[0])){activeHeader=null;activeLabel=null}\n   if(i.keep&&next&&used+height(i)+Math.min(height(next),12)>budget)open(true);\n   if(i.kind==='row'){\n    // One cell per real comparison, with continuation rows only when needed.\n    if(i.header&&used+height(i)+10>budget){activeHeader=null;open();activeHeader=i}\n    while(height(i)>budget-used){\n     const num=Math.floor((budget-used-2*i.pad)/i.step);\n     if(num<3){open(true);continue}\n     put({...i,cells:i.cells.map(a=>a.slice(0,num))});i={...i,cells:i.cells.map(a=>a.slice(num))};open(true)\n    }put(i);continue;\n   }\n   if(i.kind==='image'||i.kind==='space'){if(used+height(i)>budget)open(true);put(i);continue}\n   if(!isCompare&&i.bold&&activeHeader&&(!next||next.kind!=='row')){activeHeader=null;activeLabel=null}\n   while(height(i)>budget-used){\n    const num=Math.floor((budget-used-i.gap)/i.step);\n    if(num<2){open(true);continue}\n    const cut=Math.min(num,i.lines.length-1);if(cut<1){open(true);continue}\n    put({...i,lines:i.lines.slice(0,cut),gap:0});i={...i,lines:i.lines.slice(cut)};open(true)\n   }put(i)\n  }\n }\n const tocPage=pages.find(x=>x.toc);const entry=(title,n)=>({kind:'toc',lines:measured(d,title,pageWidth-19,10.5),size:10.5,step:4.5,gap:1.3,n});const group=s=>({kind:'text',lines:measured(d,s,pageWidth,10.5,true),bold:true,size:10.5,step:5,gap:1.5});tocPage.items=[group('PARTIES PRÉLIMINAIRES'),entry('Page de garde','—'),entry('Sommaire',1)];for(const [title,n] of toc){if(/^ANNEXE 1 /i.test(title))tocPage.items.push(group('PARTIE I : RECHERCHE DOCUMENTAIRE'));if(title==='PRÉSENTATION DE L’ENTREPRISE')tocPage.items.push(group('PARTIE II : CONTEXTUALISATION DE LA THÉORIE SUR LE TERRAIN'));if(title==='SYNTHÈSE')tocPage.items.push(group('PARTIE III : SYNTHÈSE'));tocPage.items.push(entry(title,n));if(title==='PRÉSENTATION DE L’ENTREPRISE'){const chart=pages.findIndex((pg,k)=>k>=n&&pg.title.startsWith(title)&&pg.items.some(i=>i.label==='Organigramme'||i.lines?.some(l=>l==='Description de l’organigramme')));tocPage.items.push(entry('Organigramme',chart>=0?chart:n))}}\n return pages;\n}\nasync function plan(p,catalog,db){await EGEPDF.prepare();const s=blocks(p,catalog);await assets(s,db);return layout(s,fontDoc())}\nasync function pdf(p,pages){await EGEPDF.prepare();const d=fontDoc();for(let idx=0;idx<pages.length;idx++){\n const pg=pages[idx];if(idx)d.addPage();d.setTextColor(0,0,0);d.setFont('EGE','bold');d.setFontSize(14);\n const title=measured(d,pg.title,pageWidth,14,true);if(pg.cover){d.setFontSize(12);d.text('RÉPUBLIQUE DE DJIBOUTI',105,22,{align:'center'});d.setFont('EGE','normal');d.setFontSize(10);d.text('Unité – Égalité – Paix',105,28,{align:'center'});d.text('Ministère de l’Éducation nationale et de la Formation professionnelle',105,36,{align:'center'});d.setFont('EGE','bold');d.setFontSize(14)}d.text(title,105,pg.cover?52:22,{align:'center'});let y=(pg.cover?65:34)+(title.length-1)*6;\n if(pg.annex){d.setDrawColor(80,80,80);d.setLineWidth(.3);d.rect(18,y,pageWidth,pg.budget);y+=3}\n for(const i of pg.items){\n  if(i.kind==='space'){y+=i.h;continue}\n  if(i.kind==='image'){d.addImage(i.bytes,'JPEG',(210-i.w)/2,y,i.w,i.h);y+=height(i);continue}\n  d.setFont('EGE',(i.bold||i.header)?'bold':'normal');d.setFontSize(i.size);\n  if(i.kind==='row'){\n   const h=height(i);let x=18;d.setDrawColor(185,185,185);d.setLineWidth(.18);\n   i.cells.forEach((lines,j)=>{const w=i.widths[j];if(i.header){d.setFillColor(235,235,235);d.rect(x,y,w,h,'FD')}else d.rect(x,y,w,h);const link=i.urls?.[j];d.setTextColor(...(link?[21,70,130]:[0,0,0]));lines.forEach((line,k)=>{const yy=y+i.pad+(k+1)*i.step-1;d.text(line,x+3,yy);if(link&&line)d.link(x+3,yy-i.step+.6,Math.min(w-6,d.getTextWidth(line)),i.step,{url:link})});x+=w});d.setTextColor(0,0,0);y+=h;continue;\n  }\n  const x=pg.annex?22:18;\n  if(i.url)d.setTextColor(21,70,130);else d.setTextColor(0,0,0);\n  i.lines.forEach((line,k)=>{const yy=y+(k+1)*i.step-1;d.text(line,i.center?105:x,yy,i.center?{align:'center'}:undefined);if(i.url&&line)d.link(x,yy-i.step+.6,Math.min(pageWidth-8,d.getTextWidth(line)),i.step,{url:i.url})});\n  if(i.kind==='toc'){const yy=y+i.lines.length*i.step-1,last=i.lines.at(-1)||'',right=192-d.getTextWidth(String(i.n))-2,left=x+d.getTextWidth(last)+2,dot=d.getTextWidth('.');if(right-left>dot*2)d.text('.'.repeat(Math.floor((right-left)/dot)),left,yy);d.text(String(i.n),192,yy,{align:'right'})}\n  y+=height(i);\n }if(idx){d.setFont('EGE','normal');d.setFontSize(10);d.setTextColor(0,0,0);d.text('Page '+idx,105,286,{align:'center'})}\n }return d};\nfunction wordParagraph(i,links,{center=false,pageBreak=false,justify=false}={}){\n const size=Math.round(i.size*2),step=mmTwip(i.step),gap=mmTwip(i.gap||0);\n const rpr='<w:rPr><w:rFonts w:ascii=\"DejaVu Sans\" w:hAnsi=\"DejaVu Sans\"/>'+((i.bold||i.header)?'<w:b/>':'')+(i.url?'<w:color w:val=\"154682\"/><w:u w:val=\"single\"/>':'')+'<w:sz w:val=\"'+size+'\"/><w:szCs w:val=\"'+size+'\"/></w:rPr>';\n const runs=i.lines.map((line,j)=>(j?'<w:br/>':'')+'<w:t xml:space=\"preserve\">'+X(line)+'</w:t>').join('');\n let run='<w:r>'+rpr+runs+'</w:r>';if(i.url){let j=links.indexOf(i.url);if(j<0)j=links.push(i.url)-1;run='<w:hyperlink r:id=\"rIdLink'+(j+1)+'\">'+run+'</w:hyperlink>'}\n const tabs=i.kind==='toc'?'<w:tabs><w:tab w:val=\"right\" w:pos=\"'+mmTwip(pageWidth)+'\" w:leader=\"dot\"/></w:tabs>':'';\n if(i.kind==='toc')run+='<w:r>'+rpr+'<w:tab/><w:t>'+i.n+'</w:t></w:r>';\n return '<w:p><w:pPr><w:spacing w:before=\"0\" w:after=\"'+gap+'\" w:line=\"'+step+'\" w:lineRule=\"exact\"/><w:widowControl w:val=\"0\"/>'+tabs+(center?'<w:jc w:val=\"center\"/>':justify&&!i.url&&!i.bold&&i.lines.length>1?'<w:jc w:val=\"both\"/>':'')+(pageBreak?'<w:pageBreakBefore/>':'')+'</w:pPr>'+run+'</w:p>'\n}\nfunction wordTable(rows,links){\n const widths=rows[0].widths,n=widths.length,edge=['top','left','bottom','right','insideH','insideV'].map(k=>'<w:'+k+' w:val=\"single\" w:sz=\"4\" w:color=\"B9B9B9\"/>').join('');\n const pad=mmTwip(rows[0].pad);return '<w:tbl><w:tblPr><w:tblW w:w=\"'+mmTwip(pageWidth)+'\" w:type=\"dxa\"/><w:tblBorders>'+edge+'</w:tblBorders><w:tblLayout w:type=\"fixed\"/><w:tblCellMar><w:top w:w=\"'+pad+'\" w:type=\"dxa\"/><w:bottom w:w=\"'+pad+'\" w:type=\"dxa\"/><w:left w:w=\"155\" w:type=\"dxa\"/><w:right w:w=\"155\" w:type=\"dxa\"/></w:tblCellMar></w:tblPr><w:tblGrid>'+widths.map(v=>'<w:gridCol w:w=\"'+mmTwip(v)+'\"/>').join('')+'</w:tblGrid>'+rows.map(i=>'<w:tr><w:trPr><w:cantSplit/>'+(i.minHeight?'<w:trHeight w:val=\"'+mmTwip(i.minHeight)+'\" w:hRule=\"atLeast\"/>':'')+(i.header?'<w:tblHeader/>':'')+'</w:trPr>'+i.cells.map((lines,j)=>'<w:tc><w:tcPr><w:tcW w:w=\"'+mmTwip(widths[j])+'\" w:type=\"dxa\"/>'+(i.header?'<w:shd w:fill=\"EBEBEB\"/>':'')+'</w:tcPr>'+wordParagraph({...i,lines:lines.length?lines:[''],gap:0,bold:i.header,url:i.urls?.[j]},links)+'</w:tc>').join('')+'</w:tr>').join('')+'</w:tbl>'\n}\nfunction annexFrame(content){const edges=['top','left','bottom','right'].map(k=>'<w:'+k+' w:val=\"single\" w:sz=\"6\" w:color=\"505050\"/>').join('');return '<w:tbl><w:tblPr><w:tblW w:w=\"'+mmTwip(pageWidth)+'\" w:type=\"dxa\"/><w:tblBorders>'+edges+'</w:tblBorders><w:tblLayout w:type=\"fixed\"/><w:tblCellMar><w:top w:w=\"170\" w:type=\"dxa\"/><w:bottom w:w=\"100\" w:type=\"dxa\"/><w:left w:w=\"215\" w:type=\"dxa\"/><w:right w:w=\"215\" w:type=\"dxa\"/></w:tblCellMar></w:tblPr><w:tblGrid><w:gridCol w:w=\"'+mmTwip(pageWidth)+'\"/></w:tblGrid><w:tr><w:trPr><w:cantSplit/></w:trPr><w:tc><w:tcPr><w:tcW w:w=\"'+mmTwip(pageWidth)+'\" w:type=\"dxa\"/></w:tcPr>'+content+'</w:tc></w:tr></w:tbl>'}\nasync function word(p,pages){\n if(!window.JSZip)await EGEPDF.load('/vendor/jszip-3.10.1.min.js');const zip=new JSZip(),images=[],links=[];let body='';\n for(let idx=0;idx<pages.length;idx++){const pg=pages[idx];if(pg.cover){for(const [line,size,bold,gap] of [['RÉPUBLIQUE DE DJIBOUTI',12,true,1],['Unité – Égalité – Paix',10,false,2],['Ministère de l’Éducation nationale et de la Formation professionnelle',10,false,10]])body+=wordParagraph({lines:[line],size,step:5,bold,gap},links,{center:true})}body+=wordParagraph({lines:[pg.title],size:14,step:6,bold:true,gap:8},links,{center:true,pageBreak:idx>0});let content='',rows=[];\n  const flush=()=>{if(rows.length)content+=wordTable(rows,links);rows=[]};\n  for(const i of pg.items){if(i.kind==='row'){if(rows.length&&JSON.stringify(rows[0].widths)!==JSON.stringify(i.widths))flush();rows.push(i);continue}flush();\n   if(i.kind==='space'){content+=wordParagraph({lines:[''],size:8,step:i.h,gap:0},links);continue}\n   if(i.kind==='image'){const j=images.push(i),w=Math.round(i.w*36000),h=Math.round(i.h*36000);content+='<w:p><w:pPr><w:jc w:val=\"center\"/><w:spacing w:after=\"170\"/></w:pPr><w:r><w:drawing><wp:inline xmlns:wp=\"http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing\"><wp:extent cx=\"'+w+'\" cy=\"'+h+'\"/><wp:docPr id=\"'+j+'\" name=\"Image '+j+'\"/><a:graphic xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\"><a:graphicData uri=\"http://schemas.openxmlformats.org/drawingml/2006/picture\"><pic:pic xmlns:pic=\"http://schemas.openxmlformats.org/drawingml/2006/picture\"><pic:nvPicPr><pic:cNvPr id=\"'+j+'\" name=\"Image '+j+'\"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed=\"rIdImg'+j+'\"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x=\"0\" y=\"0\"/><a:ext cx=\"'+w+'\" cy=\"'+h+'\"/></a:xfrm><a:prstGeom prst=\"rect\"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p>';continue}\n   content+=wordParagraph(i,links,{justify:pg.annex,center:!!i.center})\n  }flush();body+=pg.annex?annexFrame(content):content;\n }\n const xml='<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><w:document xmlns:w=\"'+ns+'\" xmlns:r=\"'+office.slice(0,-1)+'\"><w:body>'+body+'<w:sectPr><w:footerReference w:type=\"default\" r:id=\"rIdFooter\"/><w:titlePg/><w:pgSz w:w=\"11906\" w:h=\"16838\"/><w:pgMar w:top=\"1134\" w:right=\"1020\" w:bottom=\"1134\" w:left=\"1020\" w:header=\"360\" w:footer=\"360\"/><w:pgNumType w:start=\"0\"/></w:sectPr></w:body></w:document>';\n zip.file('[Content_Types].xml','<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"><Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/><Default Extension=\"xml\" ContentType=\"application/xml\"/><Default Extension=\"jpg\" ContentType=\"image/jpeg\"/><Override PartName=\"/word/document.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml\"/><Override PartName=\"/word/footer1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.footer+xml\"/></Types>');zip.file('_rels/.rels','<Relationships xmlns=\"'+rels+'\"><Relationship Id=\"rId1\" Type=\"'+office+'officeDocument\" Target=\"word/document.xml\"/></Relationships>');zip.file('word/document.xml',xml);\n zip.file('word/footer1.xml','<w:ftr xmlns:w=\"'+ns+'\"><w:p><w:pPr><w:jc w:val=\"center\"/></w:pPr><w:r><w:t xml:space=\"preserve\">Page </w:t></w:r><w:fldSimple w:instr=\"PAGE\"/></w:p></w:ftr>');\n zip.file('word/_rels/document.xml.rels','<Relationships xmlns=\"'+rels+'\"><Relationship Id=\"rIdFooter\" Type=\"'+office+'footer\" Target=\"footer1.xml\"/>'+images.map((l,i)=>'<Relationship Id=\"rIdImg'+(i+1)+'\" Type=\"'+office+'image\" Target=\"media/image'+(i+1)+'.jpg\"/>').join('')+links.map((url,i)=>'<Relationship Id=\"rIdLink'+(i+1)+'\" Type=\"'+office+'hyperlink\" Target=\"'+X(url)+'\" TargetMode=\"External\"/>').join('')+'</Relationships>');images.forEach((l,i)=>zip.file('word/media/image'+(i+1)+'.jpg',l.bytes));return zip.generateAsync({type:'blob',mimeType:'application/vnd.openxmlformats-officedocument.wordprocessingml.document'})\n};\nwindow.EGE92Export={blocks,paginate:(sections)=>layout(sections,fontDoc()),plan,pdf,word,download};\n})();\n\n"],"/mon-bac-v93.js":["application/javascript; charset=utf-8",false,"/* monAvenir V93 — classes par établissement, matières et élèves uniques. */\n(()=>{'use strict';\nconst E=x=>esc(String(x??'')), norm=x=>String(x??'').trim().replace(/\\s+/g,' ').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLocaleLowerCase('fr');\nconst sort=(a,b)=>String(a).localeCompare(String(b),'fr',{numeric:true,sensitivity:'base'});\nconst subject=g=>g.subject?.trim()||'Matière à préciser';\nconst active=()=>!!st.user&&!EGEAccount.blocked(st.profile)&&!EGEAccount.incomplete(st.profile,st.role);\nconst teacher=()=>active()&&st.role==='enseignant'&&st.teacher?.status==='approved', student=()=>active()&&st.role==='eleve'&&!!st.profile?.avatar_path;\nconst visible=gs=>gs.filter(g=>!g.deleted_at), own=()=>visible(st.groups).filter(g=>g.teacher_id===st.user.id);\nfunction cluster(gs,key,label){const buckets=new Map();for(const g of visible(gs)){const k=key(g);if(!buckets.has(k))buckets.set(k,{...label(g),groups:[]});buckets.get(k).groups.push(g)}return [...buckets.values()]}\nfunction studentClasses(gs){return cluster(gs,g=>JSON.stringify([norm(g.name),norm(g.school)||g.id]),g=>({name:g.name,school:g.school})).sort((a,b)=>sort(a.name,b.name)||sort(a.school,b.school));}\nfunction teacherClasses(gs){return cluster(gs,g=>norm(subject(g)),g=>({name:subject(g)})).sort((a,b)=>sort(a.name,b.name));}\nfunction uniqueStudents(gs,ms){const byGroup=new Map(visible(gs).map(g=>[g.id,g])),byStudent=new Map();for(const m of ms){if(!m.student_id||!byGroup.has(m.group_id))continue;if(!byStudent.has(m.student_id))byStudent.set(m.student_id,{id:m.student_id,name:m.student_name||'Élève',groups:[]});const p=byStudent.get(m.student_id);if(!p.groups.some(g=>g.id===m.group_id))p.groups.push(byGroup.get(m.group_id));}return [...byStudent.values()].sort((a,b)=>sort(a.name,b.name)||sort(a.id,b.id));}\nconst count=g=>new Set(st.members.filter(m=>m.group_id===g.id).map(m=>m.student_id)).size;\nconst status=g=>g.archived_at?'Archivée':g.suspended_at?'Suspendue':!g.active?'Fermée':'Active';\nconst flag=(g,s=false)=>`<span class=\"mb93-flag ${status(g)==='Active'?'is-active':''}\">${E(s&&status(g)==='Active'?'Inscrit':status(g))}</span>`;\nconst action=(label,attrs,primary=false)=>`<button type=\"button\" class=\"btn ${primary?'primary':''}\" ${attrs}>${E(label)}</button>`;\nconst goto=(label,to)=>action(label,`data-act=\"goto\" data-to=\"${to}\"`);\nconst title=(text,sub)=>`<header class=\"mb93-title\"><h1>${E(text)}</h1><p>${E(sub)}</p></header>`;\nconst empty=s=>`<p class=\"mb93-empty\">${E(s)}</p>`;\nconst heading=(name,sub,count)=>`<header class=\"mb93-heading\"><div><h2>${E(name)}</h2>${sub?`<small>${E(sub)}</small>`:''}</div><span class=\"mb93-number\">${E(count)}</span></header>`;\nlet names=new Map(),owner='',selected='',query='',filter='',request=0;\nfunction reset(){const u=st.user?.id||'';if(owner!==u){owner=u;names=new Map();selected='';query='';filter='';request++}}\nasync function loadNames(){reset();if(!student())return;const token=++request,uid=owner,ids=[...new Set(visible(st.groups).map(g=>g.teacher_id).filter(Boolean))];if(!ids.length)return;try{const r=await st.db.from('mon_bac_public_teachers').select('teacher_id,full_name').in('teacher_id',ids);if(r.error||token!==request||st.user?.id!==uid)return;names=new Map((r.data||[]).map(p=>[p.teacher_id,p.full_name]));if(st.screen==='student-group'||st.screen==='student-group-detail')render()}catch(_){}}\nconst teacherName=g=>names.get(g.teacher_id)||'Enseignant';\nconst prevLoad=loadAll;loadAll=async function(){await prevLoad();await loadNames()};\nfunction studentPage(){const clusters=studentClasses(st.groups),groups=visible(st.groups);return `<div class=\"mb93-page\">${title('Mes classes',`${clusters.length} classe(s) · ${groups.length} espace(s) enseignant`)}<div class=\"mb93-actions\">${action('＋ Rejoindre une classe','data-mb91=\"directory\"',true)}${goto('Sujets et devoirs','student-shares')}${(st.profile?.academic_level==='Terminale'&&['GFM','OGRH','IAG'].includes(st.profile?.series))?goto('Corrections EGE','student-group-corrections'):''}${goto('Mon soutien scolaire','student-group-tutoring')}</div>${clusters.map(c=>`<section class=\"mb93-card\">${heading(c.name,c.school||'Établissement non renseigné',c.groups.length+' matière(s)')}${c.groups.sort((a,b)=>sort(subject(a),subject(b))||sort(teacherName(a),teacherName(b))).map(g=>`<button class=\"mb93-row\" type=\"button\" data-mb75-group data-id=\"${E(g.id)}\"><span class=\"mb93-icon\">${I('book')}</span><span class=\"mb93-info\"><strong>${E(subject(g))}</strong><small>${E(teacherName(g))}</small></span>${flag(g,true)}${I('chevron')}</button>`).join('')}</section>`).join('')||empty('Aucune classe rejointe.')} </div>`+adBanner('student_group');}\nfunction specialties(){return MB69.state.owner===st.user.id?[...new Set(MB69.state.specialties.filter(s=>s.teacher_id===st.user.id&&s.approved).map(s=>s.subject))].sort(sort):[]}\nfunction options(value=''){return '<option value=\"\">Choisir la matière</option>'+specialties().map(s=>`<option value=\"${E(s)}\" ${s===value?'selected':''}>${E(s)}</option>`).join('')}\nfunction createForm(){return st.teacherOpen?`<section class=\"mb93-card\"><h2>Nouvelle classe</h2>${specialties().length?`<form id=\"teacherNewGroupForm\"><label class=\"field\"><span>Classe</span><select id=\"groupName\" class=\"select\" required>${EGEAcademic.allClassOptions()}</select></label><label class=\"field\"><span>Établissement</span><select id=\"groupSchool\" class=\"select\" required>${EGEAcademic.options(EGEAcademic.schools,st.teacher?.school,'Choisir un établissement',true)}</select></label><label class=\"field\"><span>Matière</span><select id=\"groupSubject\" class=\"select\" required>${options()}</select></label><button class=\"btn primary\" type=\"submit\">Créer la classe</button></form>`:empty('Ajoutez d’abord vos matières.')+goto('Mes spécialités','teacher-specialties')}</section>`:''}\nfunction classRow(g){const id=`data-id=\"${E(g.id)}\"`,editable=!g.suspended_at&&!g.archived_at;return `<details class=\"mb93-detail\"><summary><span class=\"mb93-icon\">${I('users')}</span><span class=\"mb93-info\"><strong>${E(g.name)}</strong><small>${E(g.school||'Établissement non renseigné')} · ${count(g)} élève(s)</small></span>${flag(g)}${I('chevron')}</summary><div class=\"mb93-expanded\">${!g.subject&&editable?`<form data-mb93-subject=\"${E(g.id)}\"><label class=\"field\"><span>Préciser la matière</span><select name=\"subject\" class=\"select\" required>${options()}</select></label><button class=\"btn primary\" type=\"submit\">Enregistrer la matière</button></form>`:''}<div class=\"mb93-actions\">${action('Voir les élèves',`data-act=\"teacher-select\" ${id}`,true)}${editable?action('Renommer',`data-act=\"group-rename\" ${id}`)+action(g.active?'Fermer les inscriptions':'Réactiver',`data-act=\"group-toggle\" ${id}`):''}${editable&&g.join_code?action('Copier le code',`data-act=\"copy\" data-code=\"${E(g.join_code)}\"`):''}${editable&&g.active?action('Inviter',`data-study=\"invite\" ${id}`):''}${action('Accès et demandes','data-mb91=\"classes\"')}</div></div></details>`}\nfunction teacherPage(){const groups=own(),clusters=teacherClasses(groups);return `<div class=\"mb93-page\">${title('Mes classes',`${groups.length} classe(s) · ${uniqueStudents(groups,st.members).length} élève(s) distinct(s)`)}<div class=\"mb93-actions\">${action(st.teacherOpen?'Annuler':'＋ Nouvelle classe','data-mb93=\"create\"',true)}${goto('Mes élèves','teacher-all-students')}</div>${createForm()}${clusters.map(c=>`<section class=\"mb93-card\">${heading(c.name,'',c.groups.length+' classe(s)')}${c.groups.sort((a,b)=>sort(a.name,b.name)||sort(a.school,b.school)).map(classRow).join('')}</section>`).join('')||empty('Aucune classe créée.')}</div>`}\nfunction studentCard(p){return `<details class=\"mb93-detail mb93-person\"><summary><span class=\"mb93-avatar\">${E(p.name.slice(0,1).toUpperCase())}</span><span class=\"mb93-info\"><strong>${E(p.name)}</strong><small>${p.groups.length} classe(s)</small><span class=\"mb93-tags\">${p.groups.map(g=>`<span>${E(g.name)} · ${E(subject(g))}</span>`).join('')}</span></span>${I('chevron')}</summary><div class=\"mb93-expanded\">${p.groups.map(g=>`<div class=\"mb93-membership\"><strong>${E(g.name)} · ${E(subject(g))}</strong><small>${E(g.school||'Établissement non renseigné')}</small>${action('Gérer dans cette classe',`data-act=\"teacher-select\" data-id=\"${E(g.id)}\"`)}${st.shares.filter(s=>s.group_id===g.id&&s.student_id===p.id).map(s=>entityDoc(s.dossier_id)).filter(Boolean).map(d=>action('Consulter : '+docTitle(d),`data-act=\"teacher-review\" data-id=\"${E(d.id)}\"`)).join('')}</div>`).join('')}</div></details>`}\nfunction matching(gs,ms,q,f){return uniqueStudents(gs,ms).filter(p=>norm(p.name).includes(norm(q))&&(!f||p.groups.some(g=>g.id===f)))}\nfunction results(){const ps=matching(own(),st.members,query,filter);return `<p class=\"mb93-result\">${ps.length} élève(s)</p>`+ps.map(studentCard).join('')||empty('Aucun élève trouvé.');}\nfunction allStudents(){const groups=own();return `<div class=\"mb93-page\">${title('Mes élèves',`${uniqueStudents(groups,st.members).length} élève(s) distinct(s)`)}<div class=\"mb93-filters\"><input type=\"search\" id=\"mb93Search\" class=\"input\" placeholder=\"Rechercher un élève\" aria-label=\"Rechercher un élève\" value=\"${E(query)}\"><select id=\"mb93Filter\" class=\"select\" aria-label=\"Filtrer par classe\"><option value=\"\">Toutes les classes</option>${groups.map(g=>`<option value=\"${E(g.id)}\" ${filter===g.id?'selected':''}>${E(g.name+' · '+subject(g)+' · '+(g.school||''))}</option>`).join('')}</select></div><section class=\"mb93-card\" id=\"mb93Results\">${results()}</section></div>`}\nscreenList.push(['teacher-all-students','Mes élèves']);\nconst oldView=view;view=function(){reset();if(student()&&st.screen==='student-group')return studentPage();if(teacher()&&st.screen==='teacher-groups')return teacherPage();if(teacher()&&st.screen==='teacher-all-students')return allStudents();return oldView()};\nconst oldRender=render;render=function(){const r=oldRender(),host=$('app');if(!host)return r;if(teacher()){if(st.screen==='teacher-home'){for(const b of host.querySelectorAll('[data-to=\"teacher-students\"]'))b.dataset.to='teacher-all-students';}for(const b of host.querySelectorAll('nav [data-to=\"teacher-students\"],aside [data-to=\"teacher-students\"]'))b.dataset.to='teacher-all-students';if(st.screen==='teacher-all-students')host.querySelector('.bottomnav [data-to=\"teacher-groups\"]')?.classList.add('active');if(st.screen==='teacher-students'){const g=own().find(g=>g.id===st.selectedGroupId),h=host.querySelector('.screen h1');if(g&&h&&!h.querySelector('.mb93-context'))h.insertAdjacentHTML('beforeend',`<small class=\"mb93-context\">${E(subject(g))}</small>`);}}if(student()&&st.screen==='student-group-detail'){const g=st.groups.find(g=>g.id===selected),h=host.querySelector('.mb75-heading');if(g&&h)h.insertAdjacentHTML('beforeend',`<p class=\"mb93-context\">${E(subject(g))} · ${E(teacherName(g))}</p>`)}return r};\ndocument.addEventListener('click',e=>{const g=e.target.closest?.('[data-mb75-group]');if(g&&student())selected=g.dataset.id;const b=e.target.closest?.('[data-mb93=\"create\"]');if(b&&teacher()){st.teacherOpen=!st.teacherOpen;render()}},true);\ndocument.addEventListener('input',e=>{if(e.target.id==='mb93Search'&&teacher()){query=e.target.value;$('mb93Results').innerHTML=results()}});\ndocument.addEventListener('change',e=>{if(e.target.id==='mb93Filter'&&teacher()){filter=e.target.value;$('mb93Results').innerHTML=results()}});\ndocument.addEventListener('submit',async e=>{const f=e.target,id=f.dataset?.mb93Subject;if(!id)return;e.preventDefault();e.stopImmediatePropagation();if(!teacher()||!own().some(g=>g.id===id&&!g.archived_at&&!g.suspended_at))return;const value=f.elements.subject.value,b=f.querySelector('button[type=\"submit\"]');if(!specialties().includes(value))return;b.disabled=true;try{const r=await st.db.from('ege2027_teacher_groups').update({subject:value}).eq('id',id).eq('teacher_id',st.user.id).select('id').maybeSingle();if(r.error||!r.data)throw r.error||Error('Classe indisponible.');await loadAll();toast('Matière enregistrée.')}catch(err){toast(err.message||'Enregistrement impossible.')}finally{b.disabled=false}},true);\nwindow.MB93={studentClasses,teacherClasses,uniqueStudents,matching};\n})();\n"],"/mon-bac-v93.css":["text/css; charset=utf-8",false,"/* Responsive, sans défilement horizontal. */\n.mb93-page{display:grid;gap:14px;min-width:0;width:100%;max-width:1000px;margin:0 auto;overflow-wrap:anywhere}.mb93-page>*{min-width:0}.mb93-title h1{font-size:clamp(24px,5vw,34px);margin:0 0 4px}.mb93-title p,.mb93-heading small,.mb93-info small,.mb93-membership small{display:block;color:#687587;font-size:.86rem;line-height:1.4}.mb93-title p{margin:0}.mb93-card{background:#fff;border:1px solid #e0e5eb;border-radius:16px;padding:14px;min-width:0;box-shadow:0 2px 9px #172b4d08}.mb93-card h2{font-size:1.08rem;margin:0}.mb93-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 0 10px;flex-wrap:wrap}.mb93-number{background:#f0f3f7;border-radius:20px;padding:4px 9px;font-size:.75rem;font-weight:600;color:#536378}.mb93-row,.mb93-detail>summary{display:flex;align-items:center;gap:10px;width:100%;min-width:0;padding:12px 0;border:0;border-top:1px solid #edf0f3;background:transparent;text-align:left;color:inherit;cursor:pointer;font:inherit;list-style:none}.mb93-detail>summary::-webkit-details-marker{display:none}.mb93-row>svg,.mb93-detail>summary>svg{width:17px;height:17px;flex:0 0 17px;color:#738195}.mb93-detail[open]>summary>svg{transform:rotate(90deg)}.mb93-info{min-width:0;flex:1;display:block}.mb93-info strong{font-size:.96rem;display:block;line-height:1.35}.mb93-icon,.mb93-avatar{display:grid;place-items:center;width:36px;height:36px;flex:0 0 36px;background:#fff0f3;color:#ca0b40;border-radius:11px;font-weight:700}.mb93-icon svg{width:20px;height:20px}.mb93-avatar{border-radius:50%}.mb93-flag{background:#fff4dd;color:#865e21;padding:4px 7px;border-radius:20px;font-size:.71rem;line-height:1.3;max-width:80px;text-align:center}.mb93-flag.is-active{background:#e5f5ec;color:#17734b}.mb93-actions,.mb93-filters{display:flex;flex-wrap:wrap;gap:8px;min-width:0}.mb93-actions .btn{flex:1 1 135px;min-width:0;white-space:normal;font-size:.87rem;line-height:1.3;min-height:44px}.mb93-filters>*{flex:1 1 200px;min-width:0;max-width:100%}.mb93-expanded{padding:6px 0 12px;display:grid;gap:10px}.mb93-expanded form{max-width:100%;min-width:0}.mb93-expanded .select{max-width:100%;min-width:0}.mb93-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}.mb93-tags>span{font-size:.72rem;background:#f0f3f7;color:#42536a;border-radius:6px;padding:4px 7px;max-width:100%;overflow-wrap:anywhere}.mb93-person>summary{align-items:flex-start}.mb93-membership{display:grid;gap:4px;border-left:2px solid #d9e0e8;padding:6px 0 6px 10px}.mb93-membership .btn{white-space:normal;justify-self:start;max-width:100%}.mb93-empty,.mb93-result{color:#687587;font-size:.88rem;margin:5px 0}.mb93-context{display:block;font-size:.85rem;font-weight:500;color:#657487;margin-top:5px}.mb93-page select,.mb93-page input{width:100%;max-width:100%;min-width:0}.mb93-page button:focus-visible,.mb93-page summary:focus-visible{outline:2px solid #1b55a8;outline-offset:2px}@media(max-width:350px){.mb93-card{padding:10px}.mb93-row,.mb93-detail>summary{gap:6px}.mb93-icon,.mb93-avatar{width:30px;height:30px;flex-basis:30px}.mb93-flag{font-size:.66rem;padding:3px 5px}.mb93-info strong{font-size:.9rem}}\n"],"/mon-bac-v94.js":["application/javascript; charset=utf-8",false,"/* monAvenir V94 — repères chromatiques communs aux catégories et à leurs enfants. */\n(()=>{'use strict';\nconst toneForDocument=key=>['cover','contents','thanks','study','tasks'].includes(key)?'blue':key==='topic'||/^a[1-4]$/.test(key)?'violet':['enterprise','professional','interview','comparison','synthesis'].includes(key)?'green':null;\nconst tones={\n groups:'violet',students:'green',teachers:'blue',dossiers:'violet',trash:'red',stats:'cyan',security:'blue',journal:'slate',ads:'amber',pricing:'green',preview:'slate',\n learn:'blue',practice:'green',tests:'violet',bac:'amber',orders:'cyan',resources:'blue',add:'green',qcm:'violet',requests:'amber',pending:'amber',paid:'green',payout:'violet',accounts:'blue',settings:'slate',\n groupe:'violet',domicile:'blue',sessions:'violet',payments:'amber',access:'cyan',tools:'blue',general:'violet',all:'slate',active:'green',scheduled:'blue',expired:'slate',paused:'orange',rejected:'red',premium:'violet',suspended:'orange',\n profiles:'blue',\n};\nconst set=(el,tone)=>{if(el&&tone)el.dataset.mbTone=tone};\nfunction apply(root=document){\n for(const page of root.querySelectorAll('.ege92')){\n   const tabs=page.querySelector('.ege92-tabs');if(!tabs)continue;\n   for(const b of tabs.querySelectorAll('[data-key]'))set(b,toneForDocument(b.dataset.key));\n   const tone=toneForDocument(page.querySelector('.ege92-steps [aria-current=\"page\"]')?.dataset.key||'');\n   if(tone){set(page,tone);set(page.querySelector('.ege92-progress'),tone);for(const b of page.querySelectorAll('.ege92-steps [data-key],.ege92-actions .primary'))set(b,tone);}\n   for(const b of page.querySelectorAll('.ege92-list [data-key],.ege92-section [data-key]'))set(b,toneForDocument(b.dataset.key));\n }\n for(const el of root.querySelectorAll('.mb73-tabs [data-mb73-tab],.mb78-tabs [data-mode],.lr-tabs [data-id],.mb82-tabs [data-value],.mb77-tabs [data-mode],.mb77-tabs [data-tab],.mb80-statuses [data-value],.mb80-settings-tabs [data-value],.tabset [data-act=\"admin-tab\"],.tabset [data-admin=\"filter\"]')){\n   const key=el.dataset.mb73Tab||el.dataset.mode||el.dataset.id||el.dataset.value||el.dataset.tab;set(el,tones[key]);\n }\n for(const el of root.querySelectorAll('.tabset [data-act=\"annex\"],.tabset [data-act=\"teacher-annex\"]'))set(el,'violet');\n for(const el of root.querySelectorAll('.tabset [data-act=\"terrain-tab\"]'))set(el,'green');\n for(const el of root.querySelectorAll('.admin-resource-tabs [data-to]'))set(el,el.dataset.to==='admin-users'?'blue':el.dataset.to==='admin-groups'?'violet':null);\n for(const el of root.querySelectorAll('.mb76-tabs [data-to]'))set(el,{'student-exams':'amber','student-corrections':'blue','student-favorites':'violet'}[el.dataset.to]);\n for(const shell of root.querySelectorAll('.lr-shell')){const active=shell.querySelector('.lr-tabs [aria-pressed=\"true\"]');if(active)set(shell.querySelector('.lr-steps'),active.dataset.mbTone);}\n if(st.role==='eleve'&&st.screen==='student-home'&&st.draft){const key=st.draft.study?.workspace?.current||'cover';for(const el of root.querySelectorAll('.progress-track'))set(el,toneForDocument(key));}\n}\nconst previousRender=render;render=function(){const r=previousRender();apply();return r};\nwindow.MB94={toneForDocument,apply};\n})();\n"],"/mon-bac-v94.css":["text/css; charset=utf-8",false,"/* Palette commune : même teinte du niveau parent au niveau enfant. */\n[data-mb-tone=\"blue\"]{--mb-cat:#1d52a3;--mb-cat-soft:#edf4ff;--mb-cat-border:#b6cdec}\n[data-mb-tone=\"violet\"]{--mb-cat:#6939a0;--mb-cat-soft:#f4edfb;--mb-cat-border:#d6bfe9}\n[data-mb-tone=\"green\"]{--mb-cat:#08765d;--mb-cat-soft:#e8f6f0;--mb-cat-border:#a9d9c8}\n[data-mb-tone=\"cyan\"]{--mb-cat:#126b87;--mb-cat-soft:#e8f5f9;--mb-cat-border:#b0d8e4}\n[data-mb-tone=\"amber\"]{--mb-cat:#89590b;--mb-cat-soft:#fff5db;--mb-cat-border:#e8ce92}\n[data-mb-tone=\"orange\"]{--mb-cat:#a64c13;--mb-cat-soft:#ffefe4;--mb-cat-border:#e8c1a5}\n[data-mb-tone=\"red\"]{--mb-cat:#b12a40;--mb-cat-soft:#fff0f2;--mb-cat-border:#edb5bf}\n[data-mb-tone=\"slate\"]{--mb-cat:#4b5b71;--mb-cat-soft:#f1f4f8;--mb-cat-border:#ccd5e0}\n/* La teinte est visible même lorsque l’onglet n’est pas sélectionné. */\nbutton[data-mb-tone],.ege92 .ege92-tabs button[data-mb-tone],.ege92 .ege92-steps button[data-mb-tone],.lr-shell .lr-tabs>button[data-mb-tone],.mb80-panel .mb80-statuses>.mb80-chip[data-mb-tone]{background:var(--mb-cat-soft);border:1px solid var(--mb-cat-border);color:var(--mb-cat);border-radius:10px;font-weight:650;min-height:44px;white-space:normal;overflow-wrap:anywhere;transition:background .15s,color .15s,border-color .15s}\nbutton[data-mb-tone]:is(.active,.selected,.primary,[aria-current=\"page\"],[aria-pressed=\"true\"],[aria-selected=\"true\"]),.ege92 .ege92-tabs button[data-mb-tone].active,.ege92 .ege92-steps button[data-mb-tone].active,.lr-shell .lr-tabs>button[data-mb-tone][aria-pressed=\"true\"],.mb80-panel .mb80-statuses>.mb80-chip[data-mb-tone].active{background:var(--mb-cat);border-color:var(--mb-cat);color:white;box-shadow:0 2px 5px #18273a13}\nbutton[data-mb-tone]:hover:not(:disabled){filter:brightness(.97)}\nbutton[data-mb-tone]:focus-visible{outline:2px solid var(--mb-cat);outline-offset:3px}\nbutton[data-mb-tone]:disabled{opacity:.5}\n/* Certaines anciennes lectures EGE forçaient la couleur du rôle. */\nhtml[data-mb-role] .app .tab[data-mb-tone].active{background:var(--mb-cat)!important;color:#fff!important;border-color:var(--mb-cat)!important}\nhtml[data-mb-role] .app .btn.primary[data-mb-tone]{background:var(--mb-cat)!important;border-color:var(--mb-cat)!important;color:white!important}\nhtml[data-mb-role] .app .btn.primary[data-mb-tone]:hover{background:var(--mb-cat)!important}\nbutton[data-mb-tone] :is(svg,span){color:inherit}\nbutton[data-mb-tone] b{background:var(--mb-cat-border);color:var(--mb-cat);border-radius:6px}\nbutton[data-mb-tone]:is(.active,.selected,[aria-current=\"page\"],[aria-pressed=\"true\"]) b{background:#ffffff26;color:white}\n.mb80-panel .mb80-statuses>.mb80-chip[data-mb-tone] b{background:var(--mb-cat-border);color:var(--mb-cat)}\n.mb80-panel .mb80-statuses>.mb80-chip[data-mb-tone].active b{background:#ffffff26;color:#fff}\n.lr-shell .lr-steps[data-mb-tone]>span{color:var(--mb-cat);background:var(--mb-cat-soft);border:1px solid var(--mb-cat-border);padding:6px;border-radius:8px;min-width:0;overflow-wrap:anywhere;text-align:center;flex:1}\n.lr-shell .lr-steps[data-mb-tone]>span.active{color:#fff;background:var(--mb-cat);border-color:var(--mb-cat)}\n.ege92[data-mb-tone]{--accent:var(--mb-cat)}\n.ege92[data-mb-tone]>.ege-forms,html[data-mb-role] .app .ege92[data-mb-tone]>.ege-forms.card{border-top:3px solid var(--mb-cat)!important}\n.ege92[data-mb-tone]>.ege-forms>h2:first-child{color:var(--mb-cat)}\n.ege92-progress[data-mb-tone]{border-color:var(--mb-cat-border);background:var(--mb-cat-soft)}\n.ege92-progress[data-mb-tone]>div>span:first-child{color:var(--mb-cat)}\n.ege92-progress[data-mb-tone] progress{accent-color:var(--mb-cat)}\n.progress-track[data-mb-tone] .progress-bar{background:var(--mb-cat)}\n@media(prefers-reduced-motion:reduce){button[data-mb-tone]{transition:none}}\n"],"/mon-bac-v95.js":["application/javascript; charset=utf-8",false,"/* V95 — accueil organisé et en-tête compact sans dupliquer les accès. */\n(()=>{'use strict';\nconst eligible=()=>!!st.user&&!EGEAccount.blocked(st.profile)&&!EGEAccount.incomplete(st.profile,st.role)&&(st.role!=='eleve'||!!st.profile?.avatar_path)&&(st.role!=='enseignant'||st.teacher?.status==='approved');\nfunction classCard(screen,utilities){\n const classes=window.MB93?.studentClasses(st.groups||[])||[];\n const card=document.createElement('section');card.className='mb95-class-card';\n const title=classes.length===1?classes[0].name:classes.length?classes.length+' classes rejointes':'Aucune classe rejointe';\n const subtitle=classes.length===1?classes[0].school||'Votre établissement':classes.length?'Retrouvez vos enseignants et vos matières':'Rejoignez votre classe pour retrouver vos enseignants';\n card.innerHTML=`<h2>Mes classes</h2><button type=\"button\" class=\"mb95-class-row\" data-act=\"goto\" data-to=\"student-group\"><span class=\"mb95-class-icon\">${I('cap')}</span><span class=\"mb95-class-label\"><strong>${esc(title)}</strong><small>${esc(subtitle)}</small></span><span class=\"mb95-class-open\">Voir mes classes ${I('chevron')}</span></button>`;\n const find=utilities?.querySelector('[data-mb91=\"directory\"]')||document.createElement('button');find.type='button';find.dataset.mb91='directory';find.className='mb95-find';find.innerHTML=I('search')+'<span>Trouver une classe</span>';card.append(find);return card;\n}\nfunction organizeHome(host,screen){const grid=screen.querySelector('.mb-tiles');if(!grid)return;\n const oldQuick=screen.querySelector('.mb-quick'),notice=oldQuick?.querySelector('[data-to=\"student-notices\"]'),headerNotice=host.querySelector('.mb95-notice');\n if(notice&&headerNotice){const count=notice.textContent.match(/\\((\\d+)\\)/)?.[1];if(count){const badge=document.createElement('span');badge.className='mb95-notice-count';badge.textContent=Number(count)>99?'99+':count;headerNotice.append(badge);headerNotice.setAttribute('aria-label',`Notifications : ${count} non lues`);}notice.remove();}\n let utilities=screen.querySelector('.mb91-shortcuts');const card=classCard(screen,utilities);\n if(!utilities){utilities=document.createElement('div');utilities.className='mb91-shortcuts';}\n utilities.classList.add('mb95-utilities');const calc=oldQuick?.querySelector('[data-to=\"student-calculator\"]');if(calc)utilities.prepend(calc);if(oldQuick&&!oldQuick.children.length)oldQuick.remove();\n const msg=utilities.querySelector('[data-mb91=\"messages\"]');if(msg)msg.insertAdjacentHTML('afterbegin',I('chat'));\n const heading=document.createElement('div');heading.className='mb95-home-heading';heading.innerHTML='<h1>Accueil</h1><h2>Mes outils</h2>';grid.before(heading);grid.after(utilities);utilities.after(card);\n const links=screen.querySelector('.mb82-home-links'),ad=screen.querySelector('[data-ege-ad-slot]');if(links){links.classList.add('mb95-directory-links');(ad||card).after(links);}\n}\nfunction organizeClasses(screen){const page=screen.querySelector('.mb93-page');if(!page)return;const find=page.querySelector('.mb93-actions [data-mb91=\"directory\"]');if(!find)return;find.classList.add('mb95-class-primary');find.innerHTML=I('search')+'<span>Trouver une classe</span>';page.querySelector('.mb93-title')?.after(find);\n const wrap=screen.querySelector('.mb91-shortcuts');if(wrap){for(const b of wrap.querySelectorAll('[data-mb91=\"directory\"]'))b.remove();if(!wrap.children.length)wrap.remove();}\n}\nconst oldRender=render;render=function(){const r=oldRender(),host=$('app');if(!host||!eligible()||!host.querySelector('.mb95-header'))return r;host.classList.add('mb95-app');const screen=host.querySelector('.screen');if(!screen)return r;\n if(st.screen==='student-home'){organizeHome(host,screen);host.classList.add('mb106-student-home');const grid=screen.querySelector('.mb-tiles'),utilities=screen.querySelector('.mb95-utilities');if(grid&&utilities){for(const item of [...utilities.children]){item.className='mb-tile mb106-utility';const svg=item.querySelector('svg');const label=item.textContent.trim();if(svg){item.replaceChildren(svg);const span=document.createElement('span');span.textContent=label;item.append(span)}grid.append(item)}utilities.remove()}\n const secondary=document.createElement('div');secondary.className='mb106-secondary';secondary.id='mb106-secondary';for(const node of screen.querySelectorAll('.mb95-directory-links,.mb74-more,.mb74-install,.privacy-footer'))secondary.append(node);screen.append(secondary);const toggle=document.createElement('button');toggle.type='button';toggle.className='mb106-home-switch';toggle.dataset.mb106='more';toggle.setAttribute('aria-controls','mb106-secondary');toggle.setAttribute('aria-expanded','false');toggle.innerHTML=I('more')+'<span>Autres accès et services</span>'+I('chevron');secondary.before(toggle);}\n if(st.screen==='student-group')organizeClasses(screen);\n if(st.screen==='student-group')host.querySelector('.bottomnav [data-to=\"student-group\"]')?.classList.add('active');return r;};\nwindow.MB95={classCard,organizeHome,organizeClasses};\ndocument.addEventListener('click',e=>{const button=e.target.closest?.('[data-mb106=\"more\"]'),host=$('app');if(!button||!host?.classList.contains('mb106-student-home'))return;const more=host.classList.toggle('mb106-more-open');button.innerHTML=more?I('left')+'<span>Retour aux outils</span>':I('more')+'<span>Autres accès et services</span>'+I('chevron');button.setAttribute('aria-expanded',String(more));window.scrollTo(0,0);});\n})();\n"],"/mon-bac-v95.css":["text/css; charset=utf-8",false,"/* monAvenir V95 : en-tête de marque compact, avatar agrandi, surfaces allégées. */\nhtml[data-mb-role] .app .app-header.mb74-header.mb95-header{position:relative;grid-template-columns:minmax(0,1fr) auto;padding:10px 16px 12px!important;gap:6px 12px;width:calc(100% - 24px);border-radius:16px;box-shadow:0 3px 12px #14233a18;background:linear-gradient(120deg,var(--mb-dark),var(--mb) 72%)!important;overflow:hidden}\n.mb95-header.mb74-header::before{background:radial-gradient(ellipse at 108% -70%,transparent 0 51%,#ffffff15 51.3% 52%,transparent 52.4% 61%,#ffffff0e 61.3% 62%,transparent 62.4%),linear-gradient(145deg,transparent 60%,#ffffff07 60.5% 79%,transparent 79.5%)}\n.mb95-header .brand{grid-column:1;grid-row:1;min-width:0;min-height:44px}.mb95-header .brandmark,.mb95-header .brandmark img{width:30px!important;height:30px!important;min-width:30px!important;flex-basis:30px!important}.mb95-header .brandname{font-size:18px!important;letter-spacing:-.3px}\n.mb95-header-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;grid-column:2;grid-row:1;min-width:0}\n.mb95-notice{position:relative;width:44px;height:44px;display:grid;place-items:center;flex:none;border:0;border-radius:12px;background:#ffffff12;color:#fff;cursor:pointer}.mb95-notice svg{width:22px;height:22px;stroke:#fff;fill:none}.mb95-notice-count{position:absolute;right:0;top:-2px;min-width:18px;padding:2px 4px;border-radius:20px;background:#fff;color:var(--mb-dark);font-size:10px;font-weight:800;border:1px solid var(--mb);line-height:1.1}\n.mb95-header .mb95-identity{display:flex;flex-direction:row;align-items:center;text-align:left;gap:12px;min-width:0;max-width:100%;justify-self:stretch;grid-row:2;grid-column:1/-1;padding:2px 0 0;min-height:60px;white-space:normal}\n.mb95-header .mb95-identity .ege-header-avatar{width:54px;height:54px;min-width:54px;flex:0 0 54px;border:2px solid #ffffffd9;border-radius:50%;font-size:17px;box-shadow:0 2px 6px #14233a20}\n.mb95-identity-text{display:grid;gap:3px;min-width:0;flex:1;text-align:left}.mb95-header .mb95-identity-text strong{font-size:clamp(16px,4vw,20px);font-weight:750;text-align:left;line-height:1.2;overflow-wrap:anywhere;color:#fff}.mb95-identity small{color:#ffffffe6;font-size:12px;line-height:1.25}.mb95-identity>svg{width:20px;height:20px;flex:0 0 20px;stroke:#fff}\n.mb95-header.mb74-header-inner .mb95-identity{min-height:44px;gap:5px;padding:0}.mb95-header.mb74-header-inner .mb95-identity .ege-header-avatar{width:44px;height:44px;min-width:44px;flex:0 0 44px;font-size:14px}.mb95-header.mb74-header-inner .mb95-identity strong{font-size:12px}\n.mb95-header button:focus-visible{outline:2px solid #fff;outline-offset:2px}\n.mb95-app .mb91-identity .profile-photo-panel{flex-basis:88px;width:88px}.mb95-app .mb91-identity .profile-photo-portrait{width:88px;height:88px}.mb95-app .mb91-profile .mb91-identity{min-height:124px}\nhtml[data-mb-role] .app.mb95-app.mb74-home .main{background:#f7f8fb!important}\n.mb95-app.mb74-home .mb-tiles{gap:9px;margin:6px 0 10px}.mb95-app.mb74-home .mb-tile{border:1px solid #e5e8ed;box-shadow:0 2px 6px #14233a0b;border-radius:13px;min-height:78px;background:#fff}.mb95-app.mb74-home .mb-tile:hover{box-shadow:0 3px 9px #14233a12}.mb95-app.mb74-home .mb-tile svg{color:var(--mb);stroke-width:1.65}\n.mb95-home-heading{margin:0 0 6px}.mb95-home-heading h1{font-size:23px;margin:0 0 9px;line-height:1.2}.mb95-home-heading h2{font-size:15px;margin:0;font-weight:750;color:#2a384c}\n.mb95-app .mb95-utilities,.mb95-app .mb95-directory-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;padding:4px;background:#fff;border:1px solid #e1e5ec;border-radius:12px;margin:9px 0;overflow:hidden}\n.mb95-app .mb95-utilities .btn,.mb95-app .mb95-directory-links .btn{display:flex;align-items:center;justify-content:center;gap:6px;min-width:0;min-height:44px;padding:7px 5px;border:0;background:none;box-shadow:none;white-space:normal;word-break:normal;text-align:center;color:#17263a;font-size:12px;font-weight:650;line-height:1.25}.mb95-app .mb95-utilities .btn+ .btn,.mb95-app .mb95-directory-links .btn+ .btn{border-left:1px solid #e7eaf0;border-radius:0}.mb95-app .mb95-utilities svg,.mb95-app .mb95-directory-links svg{width:18px;height:18px;flex:0 0 18px;color:var(--mb)}\n.mb95-class-card{padding:12px;background:#fff;border:1px solid #e1e5ec;border-radius:14px;box-shadow:0 2px 7px #14233a0a;margin:9px 0;display:grid;gap:10px;min-width:0}.mb95-class-card h2{font-size:16px;margin:0;font-weight:750}.mb95-class-row{min-width:0;display:flex;align-items:center;gap:8px;text-align:left;color:#17263a;border:0;background:transparent;width:100%;padding:0;cursor:pointer}.mb95-class-icon{display:grid;place-items:center;width:34px;height:34px;flex:0 0 34px;border-radius:9px;background:var(--mb-soft);color:var(--mb)}.mb95-class-icon svg{width:21px;height:21px}.mb95-class-label{display:grid;gap:3px;flex:1;min-width:0;overflow-wrap:anywhere}.mb95-class-label strong{font-size:14px;line-height:1.2}.mb95-class-label small{font-size:11px;color:#647286;line-height:1.3}.mb95-class-open{display:flex;align-items:center;gap:3px;color:var(--mb);font-size:11px;font-weight:750;white-space:normal;text-align:right;max-width:42%;line-height:1.2}.mb95-class-open svg{width:14px;height:14px;flex:none}\n.mb95-find,.mb95-class-primary{min-height:44px;width:100%;display:flex;justify-content:center;align-items:center;gap:8px;font-size:13px;font-weight:700;border:1px solid var(--mb);border-radius:10px;cursor:pointer}.mb95-find{background:#fff;color:var(--mb)}.mb95-find svg,.mb95-class-primary svg{width:19px;height:19px;flex:none}.mb95-app .mb95-class-primary{margin:0;min-height:46px}.mb95-app .mb93-page .mb93-actions{margin-top:0}\n.mb95-app .mb72-center-disc{box-shadow:0 3px 9px #14233a29}.mb95-app .mb72-nav{box-shadow:0 -2px 10px #14233a12!important}\n@media(max-width:350px){html[data-mb-role] .app .app-header.mb74-header.mb95-header{padding:8px 11px 10px!important;gap:4px 6px}.mb95-header-actions{gap:3px}.mb95-header.mb74-header-inner .mb95-identity-text{display:none}.mb95-home-heading h1{font-size:21px}.mb95-app.mb74-home .mb-tiles{gap:6px}.mb95-app.mb74-home .mb-tile{min-height:72px}.mb95-class-open{font-size:10px}.mb95-app .mb95-utilities .btn,.mb95-app .mb95-directory-links .btn{font-size:11px}}\n@media(min-width:1050px){html[data-mb-role] .app .app-header.mb74-header.mb95-header{width:calc(100% - 32px);grid-template-columns:minmax(0,1fr) minmax(0,2fr) auto;gap:12px;padding:10px 20px!important}.mb95-header.mb74-header-home .mb95-identity{grid-column:2;grid-row:1;justify-self:center;max-width:100%;padding:0}.mb95-header .mb95-header-actions{grid-column:3}.mb95-app.mb74-home .mb-tiles{gap:12px}.mb95-app.mb74-home .mb-tile{min-height:94px}}\n/* V97 : déconnexion toujours accessible, sans déplacer les autres commandes. */\n.mb74-header .mb97-logout{display:grid;place-items:center;flex:0 0 44px;width:44px;height:44px;min-height:44px;min-width:44px;padding:0;margin:0;border:0;border-radius:12px;background:#ffffff25;color:white;cursor:pointer}.mb74-header .mb97-logout svg{width:24px;height:24px;stroke:white;fill:none;stroke-width:1.8}.mb74-header .mb97-logout:hover{background:#ffffff38}.mb74-header .mb97-logout:disabled{opacity:.6;cursor:wait}\n@media(max-width:480px){.mb95-header.mb74-header-inner .mb95-identity-text{display:none}.mb95-header-actions{gap:5px}.mb95-header .brandname{font-size:16px!important}}\n/* V106 — accueil élève : 12 outils compacts et publicité intégralement visible. */\nhtml[data-mb-role] .app.mb106-student-home .app-body,html[data-mb-role] .app.mb106-student-home .main{min-height:0!important}\nhtml[data-mb-role] .app.mb106-student-home .main{padding:6px 12px calc(80px + env(safe-area-inset-bottom))!important}\n.mb106-student-home .screen{display:grid;gap:6px;align-content:start;max-width:1100px;min-width:0}\n.mb106-student-home .mb95-home-heading{display:flex;align-items:baseline;justify-content:space-between;margin:0;gap:8px}\n.mb106-student-home .mb95-home-heading h1{font-size:21px;margin:0;line-height:1.2}.mb106-student-home .mb95-home-heading h2{font-size:12px;color:#657184}\n.mb106-student-home.mb95-app.mb74-home .mb-tiles{grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin:0}\n.mb106-student-home.mb95-app.mb74-home .mb-tile{min-height:clamp(55px,9dvh,76px);gap:3px;padding:5px 2px;border-radius:11px;font-size:clamp(10px,2.8vw,12px);line-height:1.15;min-width:0;white-space:normal;overflow-wrap:anywhere}\n.mb106-student-home.mb95-app.mb74-home .mb-tile svg{width:21px;height:21px;flex:none;color:var(--mb)}\n.mb106-student-home .mb95-class-card{grid-template-columns:minmax(0,1fr) minmax(90px,34%);align-items:center;gap:6px;padding:6px 8px;margin:0;min-height:52px;border-radius:11px}\n.mb106-student-home .mb95-class-card h2{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.mb106-student-home .mb95-class-row{min-height:44px;gap:6px}.mb106-student-home .mb95-class-icon{width:29px;height:29px;flex-basis:29px}.mb106-student-home .mb95-class-label strong{font-size:12px}.mb106-student-home .mb95-class-label small{font-size:10px;line-height:1.15;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n.mb106-student-home .mb95-class-open{font-size:0;max-width:none}.mb106-student-home .mb95-find{font-size:11px;min-height:44px;gap:3px;padding:4px;line-height:1.15}.mb106-student-home .mb95-find svg{width:15px;height:15px;flex:none}\n.mb106-student-home .mb72-ad.ege-ad-banner.ege-ad-essential{margin:0!important}.mb106-student-home .mb72-banner-hit{min-height:0;height:clamp(90px,13dvh,108px);aspect-ratio:auto;grid-template-columns:minmax(0,1fr) minmax(0,30%);grid-template-rows:minmax(0,1fr);border-radius:12px}\n.mb106-student-home .mb72-ad-copy{padding:6px 8px;gap:2px;min-width:0;justify-content:center}.mb106-student-home .mb72-ad-copy small{font-size:8px;line-height:1.1;padding:2px 4px}.mb106-student-home .mb72-ad-copy strong{font-size:13px;line-height:1.2;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.mb106-student-home .mb72-ad-copy span{font-size:10px;line-height:1.15;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}.mb106-student-home .mb72-ad-copy .mb72-ad-extra{display:none}.mb106-student-home .mb72-ad-copy b{font-size:10px;padding:3px 6px;line-height:1.2;min-height:21px;margin:1px 0 0;flex:none}.mb106-student-home .mb72-banner-hit img{height:100%;min-height:0;object-fit:cover;object-position:center 24%;max-height:none!important;align-self:stretch}\n.mb106-student-home .mb72-ad .ege-ad-controls{margin:1px 0 0!important}.mb106-student-home .mb72-ad .ege-ad-arrow{min-height:26px;min-width:26px}\n.mb106-student-home.mb95-app .mb95-directory-links{margin:0;padding:0;border-radius:11px}.mb106-student-home.mb95-app .mb95-directory-links .btn{font-size:11px;min-height:44px;padding:4px 2px;gap:4px}\n.mb106-student-home .mb74-more{margin:0;max-width:none}.mb106-student-home .mb74-more .mb74-link{padding:5px 9px;min-height:44px;font-size:11px}\n.mb106-student-home .mb74-install{margin:0}.mb106-student-home .mb74-install:not(:has(button:not([hidden]))){display:none}\n.mb106-student-home .privacy-footer{margin:0!important;padding:0!important;border:0;gap:0 6px;flex-direction:row;justify-content:center;line-height:1.15}.mb106-student-home .privacy-footer .ege-footer-identity{display:flex;gap:5px;flex-wrap:wrap;justify-content:center}.mb106-student-home .privacy-footer p{font-size:9px;margin:0;line-height:1.2}.mb106-student-home .privacy-footer a{font-size:10px;min-height:24px;line-height:1.2}\n.mb106-secondary{display:grid;gap:6px;min-width:0}.mb106-home-switch{display:none;align-items:center;gap:7px;justify-content:space-between;min-height:44px;width:100%;border:1px solid #e1e5ec;background:#fff;border-radius:11px;padding:6px 10px;color:var(--mb);font-size:12px;font-weight:700;text-align:left}.mb106-home-switch span{flex:1}.mb106-home-switch svg{width:17px;height:17px}\n@media(max-width:810px){html[data-mb-role] .app.mb106-student-home .app-header.mb74-header.mb95-header{padding:5px 10px 6px!important;gap:1px 6px;margin:6px auto 0!important}.mb106-student-home .mb95-header .mb95-identity{min-height:43px;gap:7px;padding:0}.mb106-student-home .mb95-header .mb95-identity .ege-header-avatar{width:38px;height:38px;min-width:38px;flex-basis:38px}.mb106-student-home .mb95-header .mb95-identity-text strong{font-size:15px}.mb106-student-home .mb95-header .mb95-identity-text small{font-size:11px}}\n@media(min-width:811px){html[data-mb-role] .app.mb106-student-home .main{padding:12px 20px!important}.mb106-student-home.mb95-app.mb74-home .mb-tiles{grid-template-columns:repeat(6,minmax(0,1fr))}.mb106-student-home .mb72-banner-hit{max-width:640px;margin:auto}.mb106-student-home .mb72-banner-hit img{max-height:105px!important}}\n@media(max-width:810px) and (max-height:660px){.mb106-student-home .screen{gap:4px}.mb106-student-home .mb95-home-heading h1{font-size:18px}.mb106-student-home.mb95-app.mb74-home .mb-tile{min-height:54px;font-size:10px;gap:2px}.mb106-student-home.mb95-app.mb74-home .mb-tile svg{width:19px;height:19px}.mb106-student-home .mb95-class-card{padding:2px 6px}.mb106-student-home .mb95-class-label small{display:none}.mb106-student-home .privacy-footer .ege-footer-identity{display:none}.mb106-student-home .mb72-ad-copy strong{-webkit-line-clamp:1}}\n@media(max-width:810px) and (max-height:820px){.mb106-student-home .mb106-home-switch{display:flex}.mb106-student-home:not(.mb106-more-open) .mb106-secondary{display:none}.mb106-student-home.mb106-more-open .mb-tiles,.mb106-student-home.mb106-more-open [data-ege-ad-slot]{display:none!important}.mb106-student-home.mb106-more-open .mb95-home-heading{display:none}.mb106-student-home.mb106-more-open .mb106-home-switch{order:-1}.mb106-student-home:not(.mb106-more-open) .mb95-home-heading{margin:0}}\n@media(max-width:810px) and (max-height:660px){.mb106-student-home .mb95-home-heading{display:none}.mb106-student-home .mb72-banner-hit{height:90px}.mb106-student-home .mb106-home-switch{min-height:44px}.mb106-student-home .mb72-ad .ege-ad-controls{margin:0!important}}\n@media(max-width:810px) and (max-height:600px){.mb106-student-home:not(.mb106-more-open) .mb95-class-card{display:none}.mb106-student-home.mb95-app.mb74-home .mb-tile{min-height:50px}.mb106-student-home .mb95-header .mb95-identity{min-height:38px}.mb106-student-home .mb95-header .mb95-identity .ege-header-avatar{width:34px;height:34px;min-width:34px;flex-basis:34px}}\n.mb106-student-home.mb106-more-open .privacy-footer .ege-footer-identity{display:flex}\n@media(max-width:810px) and (max-height:480px) and (orientation:landscape){html[data-mb-role] .app.mb106-student-home .app-header.mb74-header.mb95-header{grid-template-columns:auto minmax(0,1fr) auto;gap:6px}.mb106-student-home .mb95-header .mb95-identity{grid-column:2;grid-row:1;justify-self:stretch}.mb106-student-home .mb95-header .mb95-header-actions{grid-column:3}.mb106-student-home.mb95-app.mb74-home .mb-tiles{grid-template-columns:repeat(6,minmax(0,1fr))}.mb106-student-home .mb72-banner-hit{height:77px}.mb106-student-home .mb72-ad-copy{padding:3px 8px}.mb106-student-home .mb72-ad-copy b{min-height:19px}.mb106-student-home .mb72-ad .ege-ad-arrow{min-height:24px}html[data-mb-role] .app.mb106-student-home .mb72-nav{height:calc(55px + env(safe-area-inset-bottom))}.mb106-student-home .mb72-center-disc{width:44px;height:44px}html[data-mb-role] .app.mb106-student-home .main{padding-bottom:calc(68px + env(safe-area-inset-bottom))!important}}\n"],"/mon-bac-v96.js":["application/javascript; charset=utf-8",false,"/* V96 — accueil épuré, accès unique, identité rouge et blanc pour tous. */\n(()=>{'use strict';\nconst previousWelcome=welcome,previousAuth=auth,previousLogin=doLogin,previousProfile=profile,previousRender=render;\nconst brand=()=>`<div class=\"mb96-brand\"><img src=\"./mon-bac-icon.svg\" alt=\"\" width=\"64\" height=\"64\"><strong>monAvenir</strong></div>`;\nconst back=()=>`<button type=\"button\" class=\"mb96-back\" data-act=\"goto\" data-to=\"welcome\" aria-label=\"Retour à l’accueil\">${I('left')}</button>`;\nconst action=(key,label,cls='')=>`<button type=\"button\" class=\"${cls}\" data-mb96=\"${key}\">${label}</button>`;\nconst premium=slot=>egeAdFor(slot)?adBanner(slot):'';\nwelcome=function(){if(st.user)return previousWelcome();return `<div class=\"mb96-welcome\">${brand()}<img class=\"mb96-hero\" src=\"./mon-bac-welcome-v98.webp\" width=\"650\" height=\"530\" alt=\"Deux élèves devant le lycée d’État de Djibouti, avec leurs cahiers et sacs à dos\"><h1>Réussir son bac,<br>ensemble.</h1><p class=\"mb96-tagline\">Cours, révisions et accompagnement.</p><div class=\"mb96-ctas\">${action('login','Se connecter','btn primary full')}${action('signup','Créer un compte','btn mb96-outline full')}</div><a class=\"mb96-support\" href=\"/annonces.html?onglet=soutien\">Découvrir les cours de soutien</a><button type=\"button\" class=\"mb96-install\" data-act=\"install\">${I('download')} Installer l’application</button><div class=\"mb96-public-extra\"><button type=\"button\" data-mb91=\"directory\">${I('search')} Trouver une classe</button></div>${premium('home')}</div>`};\nfunction loginScreen(){\n st.desired='eleve';\n const t=document.createElement('template');t.innerHTML=previousAuth();const passkey=t.content.querySelector('.mb90-access');\n if(passkey){const b=passkey.querySelector('[data-mb90=\"login\"]');if(b){const icon=b.querySelector('svg');b.textContent='Connexion par empreinte';if(icon)b.prepend(icon)}const small=passkey.querySelector('small');if(small)small.textContent='Sur appareil compatible';}\n return `<section class=\"mb96-auth-card\">${back()}${brand()}<h1>Connexion</h1><form id=\"authForm\" class=\"ege-forms mb96-form\"><label class=\"field\"><span>E-mail ou téléphone</span><input class=\"input\" id=\"mb96Identifier\" name=\"username\" type=\"text\" autocomplete=\"username\" autocapitalize=\"none\" spellcheck=\"false\" required placeholder=\"Votre e-mail ou numéro\"></label><input id=\"authEmail\" type=\"hidden\"><input id=\"authWhatsApp\" type=\"hidden\"><div class=\"field\"><label class=\"password-label\" for=\"authPassword\">Mot de passe</label><div class=\"password-wrap\"><input class=\"input\" id=\"authPassword\" name=\"password\" type=\"password\" required maxlength=\"72\" autocomplete=\"current-password\" placeholder=\"Votre mot de passe\"><button type=\"button\" class=\"password-toggle\" data-act=\"toggle-password\" data-target=\"authPassword\" aria-pressed=\"false\" aria-label=\"Afficher le mot de passe\">${I('eye')}</button></div></div>${action('forgot','Mot de passe oublié ?','mb96-forgot')}<button type=\"submit\" class=\"btn primary full\">Se connecter</button></form>${passkey?.outerHTML||''}<p class=\"mb96-switch\">Pas encore de compte ? ${action('signup','Créer un compte')}</p>${premium('auth')}</section>`;\n}\nauth=function(){if(st.user||st.pendingPasswordReset)return previousAuth();if(st.mode==='login')return loginScreen();if(st.mode==='choose-role')return `<section class=\"mb96-auth-card\">${back()}${brand()}<h1>Créer un compte</h1><p class=\"mb96-tagline\">Choisissez votre espace.</p><div class=\"mb96-role-list\">${action('eleve',I('cap')+' Élève '+I('chevron'),'btn mb96-outline full')}${action('enseignant',I('users')+' Enseignant '+I('chevron'),'btn mb96-outline full')}</div><p class=\"mb96-switch\">Déjà inscrit ? ${action('login','Se connecter')}</p></section>`;\n if(st.mode==='forgot')return `<section class=\"mb96-auth-card\">${back()}${brand()}<h1>Mot de passe oublié ?</h1><p class=\"mb96-tagline\">Comment avez-vous créé votre compte ?</p><div class=\"mb96-role-list\">${action('forgot-email','Avec mon e-mail','btn mb96-outline full')}${action('forgot-phone','Avec mon téléphone','btn mb96-outline full')}</div>${action('login','Retour à la connexion','mb96-forgot')}</section>`;\n return previousAuth();};\ndoLogin=async function(mode){const input=$('mb96Identifier');if(mode!=='login'||!input)return previousLogin(mode);const value=input.value.trim();st.desired='eleve';st.phoneEmailFallback=value.includes('@');$('authEmail').value=st.phoneEmailFallback?value:'';$('authWhatsApp').value=st.phoneEmailFallback?'':value;return previousLogin(mode)};\n// Keep original recovery flows; they depend on the account's original identifier.\nlet recovery=null;\nconst unifiedAuth=auth;\nauth=function(){if(st.mode==='forgot'&&recovery&&!st.user){return previousAuth()}return unifiedAuth()};\nfunction start(mode,role='eleve'){recovery=null;st.desired=role;st.mode=mode;st.phoneEmailFallback=false;st.lastError='';st.screen='auth';render()}\nfunction profileMenu(html){const t=document.createElement('template');t.innerHTML=html;const card=t.content.querySelector('.mb91-identity'),panel=card?.querySelector('.profile-photo-panel'),input=panel?.querySelector('#profilePhotoFile');if(!input)return html;\n const remove=panel.querySelector('[data-profile-photo-remove]'),state=panel.querySelector('#profilePhotoState');const pencil=document.createElement('button');pencil.type='button';pencil.className='mb96-photo-pencil';pencil.dataset.mb96='photo-menu';pencil.setAttribute('aria-label','Gérer ma photo de profil');pencil.setAttribute('aria-expanded','false');pencil.innerHTML=I('edit');panel.append(pencil);input.closest('label').hidden=true;\n const menu=document.createElement('div');menu.className='mb96-photo-menu';menu.hidden=true;menu.innerHTML=action('photo-choose',st.profile?.avatar_path?'Modifier la photo':'Ajouter une photo','btn');if(remove)menu.append(remove);card.append(menu);if(state)card.append(state);return t.innerHTML;\n}\nprofile=function(){return profileMenu(previousProfile())};\nrender=function(){const result=previousRender(),host=$('app');if(!host)return result;if(!st.user&&st.screen==='welcome'){host.classList.add('mb96-public');const extra=host.querySelector('.mb96-public-extra');for(const duplicate of host.querySelectorAll('.mb91-shortcuts'))duplicate.remove();if(extra)extra.classList.add('mb96-ready');}if(!st.user&&st.screen==='auth'&&host.querySelector('.mb96-auth-card'))host.classList.add('mb96-auth');return result};\ndocument.addEventListener('click',e=>{const b=e.target.closest?.('[data-mb96]');if(!b||st.busy)return;const key=b.dataset.mb96;e.preventDefault();if(key==='photo-menu'){const menu=b.closest('.mb91-identity')?.querySelector('.mb96-photo-menu');if(menu){menu.hidden=!menu.hidden;b.setAttribute('aria-expanded',String(!menu.hidden));}return}if(key==='photo-choose'){$('profilePhotoFile')?.click();return}if(st.user)return;if(key==='login')start('login');else if(key==='signup')start('choose-role');else if(key==='eleve'||key==='enseignant')start('signup',key);else if(key==='forgot')start('forgot');else if(key==='forgot-email'||key==='forgot-phone'){recovery=key;st.phoneEmailFallback=key==='forgot-email';st.mode='forgot';render()}});\ndocument.addEventListener('click',e=>{const b=e.target.closest?.('[data-act=\"mode\"],[data-to=\"welcome\"]');if(!b)return;if(b.dataset.mode==='login'||b.dataset.to==='welcome')recovery=null;},true);\n})();\n"],"/mon-bac-v96.css":["text/css; charset=utf-8",false,"/* V96 – surfaces blanches, identité rouge, illustration fondue sans bordure. */\n#app.mb96-public,#app.mb96-auth{background:#fff;min-height:100dvh;max-width:none;margin:0 auto}\n#app.mb96-public>.ege-shared-header,#app.mb96-auth>.ege-shared-header{display:none!important}\n#app.mb96-public .app-body,#app.mb96-auth .app-body{background:white!important;display:flex!important;flex:1;justify-content:center}\n#app.mb96-public .main.intro-main,#app.mb96-auth .main.login-main{width:100%;max-width:540px;margin:0 auto!important;padding:15px 20px max(16px,env(safe-area-inset-bottom))!important;background:#fff!important;box-sizing:border-box}\n#app.mb96-public .screen,#app.mb96-auth .screen{width:100%;max-width:none;min-width:0;display:flex;flex-direction:column;gap:0}\n.mb96-welcome,.mb96-auth-card{width:100%;min-width:0;max-width:480px;box-sizing:border-box;margin:0 auto;text-align:center;color:#14233a}\n.mb96-brand{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;margin:4px auto 0}\n.mb96-brand img{width:clamp(48px,8dvh,72px);height:clamp(48px,8dvh,72px);object-fit:contain;border-radius:14px}\n.mb96-brand strong{font-size:clamp(25px,5.3vw,34px);line-height:1.15;letter-spacing:-.8px;color:#14233a;font-weight:800}\n.mb96-hero{width:100%;max-width:460px;height:auto;max-height:35dvh;object-fit:contain;display:block;margin:0 auto;-webkit-mask-image:radial-gradient(ellipse 72% 74% at 50% 49%,#000 47%,transparent 100%);mask-image:radial-gradient(ellipse 72% 74% at 50% 49%,#000 47%,transparent 100%)}\n.mb96-welcome h1,.mb96-auth-card h1{font-size:clamp(27px,6.9vw,37px);letter-spacing:-.9px;line-height:1.09;margin:6px 0 7px;font-weight:800}\n.mb96-tagline{font-size:clamp(13px,3.6vw,16px);line-height:1.5;color:#667085;margin:0 0 15px}\n.mb96-ctas,.mb96-role-list{display:grid;gap:10px;margin:14px auto 8px;width:100%;max-width:440px}\n.mb96-welcome .btn,.mb96-auth-card .btn{min-height:48px;border-radius:12px;font-size:16px;box-shadow:none!important;font-weight:700;white-space:normal}\n.mb96-outline{background:white!important;color:#c60835!important;border:1.5px solid #c60835!important}\n.mb96-support,.mb96-install,.mb96-public-extra button{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;border:0;background:none;color:#14233a;font-weight:600;font-size:14px;text-align:center;text-decoration:underline;text-underline-offset:3px;cursor:pointer}\n.mb96-install{display:flex;margin:0 auto;color:#c60835;text-decoration:none}.mb96-install[hidden]{display:none!important}.mb96-install svg,.mb96-public-extra svg{width:18px;height:18px}\n.mb96-public-extra{margin:3px 0 8px}.mb96-public-extra button{color:#667085;font-size:13px;font-weight:500;text-decoration:none}\n.mb96-welcome [data-ege-ad-slot],.mb96-auth-card [data-ege-ad-slot]{margin:8px auto!important;max-width:100%;text-align:left}\n.mb96-auth-card{position:relative;padding:22px 0 10px}.mb96-auth-card .mb96-brand{margin:0 0 27px}.mb96-auth-card h1{margin:0 0 24px}.mb96-back{position:absolute;left:0;top:0;display:grid;place-items:center;background:white;border:0;width:44px;height:44px;color:#14233a;cursor:pointer;border-radius:10px}.mb96-back svg{width:25px;height:25px}\n.mb96-form{display:grid;gap:14px;text-align:left;margin:0}.mb96-form .field{margin:0;min-width:0}.mb96-form .field>span,.mb96-form .password-label{display:block;margin:0 0 7px;font-size:14px;font-weight:700;color:#14233a}.mb96-form .input{width:100%;min-width:0;min-height:49px;box-sizing:border-box;border:1px solid #c5cbd4;border-radius:10px;background:#fafbfc;font-size:16px}.mb96-form .password-toggle{color:#14233a}.mb96-forgot{justify-self:end;display:block;background:none;border:0;color:#c60835;font-size:14px;font-weight:650;min-height:40px;cursor:pointer;text-align:right}.mb96-form .mb96-forgot{margin-top:-8px}.mb96-form .btn.primary{margin:3px 0 0}\n.mb96-auth-card .mb90-access{margin:20px 0 0;border:0;padding:0}.mb96-auth-card .mb90-key{display:flex;align-items:center;justify-content:center;gap:8px;border:1.5px solid #c60835!important;background:white!important;color:#14233a!important;border-radius:12px;min-height:52px}.mb96-auth-card .mb90-key svg{color:#c60835;flex:none}.mb96-auth-card .mb90-access small{font-size:13px;color:#657184;margin:5px 0 0}.mb96-switch{font-size:14px;line-height:1.5;margin:21px auto 5px}.mb96-switch button{border:0;background:none;color:#c60835;font-weight:700;padding:8px 0;cursor:pointer}\n.mb96-role-list .btn{display:flex;align-items:center;justify-content:center;gap:9px}.mb96-role-list .btn svg{width:20px;height:20px}\n#app.mb96-public .privacy-footer,#app.mb96-auth .privacy-footer{margin:8px 0 0!important;opacity:.85;font-size:11px!important}\n/* Photo : menu dans le flux, pas de superposition avec la carte suivante. */\n.mb91-profile .mb91-identity{flex-wrap:wrap;align-items:center;gap:14px}.mb91-profile .mb91-identity .profile-photo-panel{flex:0 0 88px;width:88px}.mb91-profile .mb91-identity .profile-photo-portrait{width:88px;height:88px}.mb91-identity .profile-photo-body .field[hidden]{display:none!important}.mb96-photo-pencil{position:absolute;right:-3px;bottom:-3px;display:grid;place-items:center;z-index:1;background:white;border:1px solid #e2e6eb;border-radius:50%;width:32px;height:32px;color:#c60835;cursor:pointer;box-shadow:0 2px 5px #14233a13}.mb96-photo-pencil svg{width:17px;height:17px}.mb91-identity .mb96-photo-menu{flex:0 0 100%;display:flex;gap:8px;flex-wrap:wrap;box-sizing:border-box;padding-top:10px;border-top:1px solid #edf0f3}.mb91-identity .mb96-photo-menu[hidden]{display:none!important}.mb91-identity .mb96-photo-menu .btn{position:static;min-height:40px;padding:8px 12px;flex:1 1 130px;font-size:13px;white-space:normal}.mb91-identity .mb96-photo-menu [data-profile-photo-remove]{color:#c60835}.mb91-identity>.profile-photo-state{position:static;width:100%;flex:0 0 100%;background:none;margin:0;font-size:12px}.mb91-identity>.profile-photo-state:empty{display:none}\n@media(min-width:760px){#app.mb96-public .main.intro-main,#app.mb96-auth .main.login-main{padding-top:25px!important}.mb96-hero{max-height:360px}}\n@media(max-height:650px){.mb96-hero{max-height:31dvh}.mb96-auth-card{padding-top:12px}.mb96-auth-card .mb96-brand{margin-bottom:16px}.mb96-auth-card h1{margin-bottom:16px}.mb96-form{gap:10px}}\n"],"/mon-bac-welcome-v96.webp":["image/webp",true,""],"/mon-bac-welcome-v98.webp":["image/webp",true,""],"/mon-bac-challenge.js":["application/javascript; charset=utf-8",false,"/* monAvenir Challenge — real server-backed contests, disabled until admin activation. */\n(()=>{'use strict';\nconst modes=[['duel','Duel','Élève contre élève','users',10],['classes','Interclasses','Classe contre classe','users',20],['schools','Interlycées','Lycée contre lycée','cap',30],['national','Concours national','Tout Djibouti','star',40],['daily','Défi quotidien','5 questions du jour','calendar',5]],screens=['student-challenge','teacher-challenge','admin-challenge'];\nscreenList.push(...screens.map(s=>[s,'monAvenir Challenge']));\nconst E=esc,M=key=>modes.find(m=>m[0]===key)||modes[0],isAdmin=()=>st.role==='admin',isStudent=()=>st.role==='eleve',home=()=>homes[st.role],on=()=>screens.includes(st.screen),date=v=>v?new Intl.DateTimeFormat('fr-FR',{dateStyle:'short',timeStyle:'short',timeZone:'Africa/Djibouti'}).format(new Date(v)):'—';\nconst btn=(a,l,opts='')=>`<button type=\"button\" class=\"ch-btn ${opts.includes('primary')?'ch-primary':''}\" data-ch=\"${a}\" ${opts.replace('primary','')}>${l}</button>`;\nconst field=(l,h)=>`<label class=\"ch-field\"><span>${l}</span>${h}</label>`,input=(name,v='',more='')=>`<input name=\"${name}\" value=\"${E(v)}\" ${more}>`,select=(name,values,current)=>`<select name=\"${name}\">${values.map(([v,l])=>`<option value=\"${E(v)}\" ${v===current?'selected':''}>${E(l)}</option>`).join('')}</select>`;\nconst row=(label,sub,action='',id='')=>`<button class=\"ch-row\" type=\"button\" ${action?`data-ch=\"${action}\" data-id=\"${E(id)}\"`:'disabled'}><span><b>${E(label)}</b><small>${E(sub)}</small></span>${action?I('chevron'):''}</button>`;\nconst badge=(s,kind='')=>`<span class=\"ch-badge ${kind}\">${E(s)}</span>`,empty=s=>`<div class=\"ch-empty\">${E(s)}</div>`,stat=(v,l)=>`<div class=\"ch-stat\"><b>${E(v)}</b><small>${E(l)}</small></div>`;\nconst label=e=>e.status==='draft'?'Brouillon':e.status==='suspended'?'Suspendu':Date.now()<Date.parse(e.starts_at)?'Planifié':Date.now()>=Date.parse(e.ends_at)?'Terminé':'En cours';\nlet data={},page='home',mode='duel',eventId='',owner='',step=0,qindex=0,draft=null,run=null,selected=-1,loading=false,working=false,error='',notice='',offset=0,opponents=[],query='',scope='same',timer=null,rank=[],review=null,previewIndex=0,listFilter='all',result=null;\nconst events=()=>data.events||[],event=()=>events().find(e=>e.id===eventId),duels=()=>data.duels||[],modeActive=k=>data.modes?.[k]===true;\nasync function api(action,p={}){const r=await st.db.rpc('mon_bac_challenge',{p_action:action,p_data:p});if(r.error)throw Error(r.error.message||'Opération impossible');return r.data}\nfunction reset(){clearInterval(timer);data={};page='home';mode='duel';eventId='';step=0;qindex=0;draft=null;run=null;selected=-1;error='';notice='';offset=0;opponents=[];query='';scope='same';rank=[];review=null;result=null;listFilter='all'}\nasync function load(){const id=st.user?.id;if(!id)return;loading=true;error='';render();try{const next=await api('data');if(st.user?.id!==id||!on())return;data=next||{};}catch(e){if(st.user?.id===id)error=e.message;}finally{if(st.user?.id===id&&on()){loading=false;render()}}}\nfunction move(p){page=p;error='';notice='';offset=0;clearInterval(timer);render();if(typeof scrollTo==='function')scrollTo({top:0,behavior:'instant'})}\nconst title=(t,s='')=>`<h1>${E(t)}</h1>${s?`<p class=\"ch-sub\">${E(s)}</p>`:''}`;\nconst bar=(i,total)=>{if(page==='create'&&isAdmin()&&total===4){i++;total=5}return `<div class=\"ch-step\"><small>Étape ${i+1} sur ${total}</small><div>${Array.from({length:total},(_,x)=>`<i class=\"${x<=i?'active':''}\"></i>`).join('')}</div></div>`};\nconst actions=(a,b,label='Suivant')=>`<div class=\"ch-actions\">${btn(a,'← Précédent')}${btn(b,`${E(label)}${label==='Suivant'?' →':''}`,'primary')}</div>`;\n// The administrator selects the public independently of approved teacher specialties.\nlet audienceStep=false;\nconst distinct=values=>[...new Set(values.filter(Boolean))].sort((a,b)=>a.localeCompare(b,'fr'));\nconst multi=(name,values,chosen)=>`<select name=\"${name}\" multiple size=\"4\">${distinct([...values,...chosen]).map(v=>`<option value=\"${E(v)}\" ${chosen.includes(v)?'selected':''}>${E(v)}</option>`).join('')}</select>`;\nconst scopeLabel=(values,legacy,all)=>Array.isArray(values)?(values.length?values.join(', '):all):(legacy||all);\nconst audienceLabel=e=>`${scopeLabel(e.eligible_levels,e.academic_level,'Tous les niveaux')} · ${scopeLabel(e.eligible_series,e.series,'Toutes les séries')}`;\nconst audienceSummary=e=>`<div class=\"ch-note\"><b>${e.category==='interseries'?'Interséries':'Spécialisé'}</b><br>${E(audienceLabel(e))}<br>${E(scopeLabel(e.eligible_schools,'','Tous les établissements'))}</div>`;\nconst baseDraft=initDraft;initDraft=function(){audienceStep=false;if(!isAdmin())return baseDraft();const start=new Date(Date.now()+86400000),end=new Date(start.getTime()+3600000);draft={mode:'duel',title:'',category:'interseries',eligible_series:[],eligible_levels:[],eligible_schools:[],subjects:[],series:'',academic_level:'',subject:'',chapter:'',seconds:20,starts_at:localDate(start),ends_at:localDate(end),group_ids:[],questions:[]};step=0;qindex=0;move('create')};\nconst baseCreate=create;create=function(){if(!isAdmin())return baseCreate();if(step!==0){const html=baseCreate();return step===3?html.replace('<div class=\"ch-note\">Enregistrer en brouillon.',audienceSummary(draft)+'<div class=\"ch-note\">Enregistrer en brouillon.'):html}\n const next=`<div class=\"ch-actions\">${btn(audienceStep?'audience-back':'create-back','← Précédent')}<button type=\"submit\" class=\"ch-btn ch-primary\">Suivant →</button></div>`;\n if(!audienceStep)return bar(0,5)+title('Créer un concours','Définissez le contenu du concours.')+`<form id=\"chAudienceInfo\" class=\"ch-card\">${field('Nom du concours',input('title',draft.title,'required minlength=\"3\" maxlength=\"120\"'))}${field('Type',select('mode',modes.map(x=>[x[0],x[1]]),draft.mode))}${field('Catégorie',select('category',[['interseries','Interséries · connaissances communes'],['specialized','Spécialisé · matières d’une série']],draft.category))}${field('Matière(s)',input('subjects',draft.subjects.join('; '),'required placeholder=\"Ex. Culture générale ; Logique\" list=\"chSubjects\" maxlength=\"480\"'))}<datalist id=\"chSubjects\">${distinct([...(data.catalog?.subjects||[]),'Culture générale','Logique','Mathématiques','Français','Anglais','Histoire-Géographie','Sciences']).map(v=>`<option value=\"${E(v)}\"></option>`).join('')}</datalist><small class=\"ch-sub\">Séparez plusieurs matières par un point-virgule.</small>${field('Chapitre ou thème',input('chapter',draft.chapter,'required maxlength=\"120\"'))}${next}</form>`;\n const series=distinct([...(window.EGEAcademic?.series||['GFM','OGRH','IAG','S','ES','L']),...(data.catalog?.series||[]),...(data.specialties||[]).map(x=>x.series)]),schools=distinct([...(window.EGEAcademic?.schools||[]),...(data.catalog?.schools||[]),...(data.groups||[]).map(x=>x.school)]);\n return bar(1,5)+title('Qui peut participer ?','Choisissez le public éligible.')+`<form id=\"chAudience\" class=\"ch-card\">${field('Séries (aucune sélection = toutes)',multi('eligible_series',series,draft.eligible_series))}${field('Niveaux',select('levels',[['all','Première et Terminale'],['Première','Première'],['Terminale','Terminale']],draft.eligible_levels.length===1?draft.eligible_levels[0]:'all'))}${field('Établissements (aucune sélection = tous)',multi('eligible_schools',schools,draft.eligible_schools))}<small class=\"ch-sub\">Les concours interséries peuvent accueillir toutes les séries, y compris les futures. Les concours spécialisés ciblent au moins une série.</small>${next}</form>`;\n};\nconst baseDetails=details;details=function(){const e=event(),html=baseDetails();return e?html.replace(`${E(e.academic_level)} · ${E(e.series)}`,E(audienceLabel(e))).replace('<div class=\"ch-card\">',`<div class=\"ch-card\">${badge(e.category==='interseries'?'Interséries':'Spécialisé')}`):html};\nconst baseOpponentPage=opponentPage;opponentPage=function(){return baseOpponentPage().replace('Même série et même niveau.','Élèves éligibles à ce défi.')};\nconst baseManage=manage;manage=function(){const e=event();return e?baseManage().replace('<div class=\"ch-card\">','<div class=\"ch-card\">'+audienceSummary(e)):baseManage()};\ndocument.addEventListener('click',e=>{if(!on()||!isAdmin()||!e.target.closest?.('[data-ch=\"audience-back\"]'))return;e.preventDefault();e.stopImmediatePropagation();audienceStep=false;error='';render()},true);\ndocument.addEventListener('submit',e=>{if(!on()||!isAdmin()||!['chAudienceInfo','chAudience'].includes(e.target.id))return;e.preventDefault();e.stopImmediatePropagation();try{const f=new FormData(e.target);error='';if(e.target.id==='chAudienceInfo'){const old=draft.mode;for(const k of ['title','mode','category','chapter'])draft[k]=String(f.get(k)||'').trim();draft.subjects=distinct(String(f.get('subjects')||'').split(';').map(x=>x.trim()));if(!draft.title||!draft.chapter||!draft.subjects.length)throw Error('Complétez les informations.');draft.subject=draft.subjects.join(' · ');if(old!==draft.mode){draft.questions=[];draft.group_ids=[]}audienceStep=true}else{draft.eligible_series=f.getAll('eligible_series');draft.eligible_levels=f.get('levels')==='all'?[]:[String(f.get('levels'))];draft.eligible_schools=f.getAll('eligible_schools');if(draft.category==='specialized'&&!draft.eligible_series.length)throw Error('Choisissez au moins une série ou un concours interséries.');draft.series=scopeLabel(draft.eligible_series,'','Toutes les séries');draft.academic_level=scopeLabel(draft.eligible_levels,'','Tous les niveaux');step=1}render()}catch(err){error=err.message;render()}},true);\nconst gridItem=(m)=>`<button class=\"ch-tile\" data-ch=\"mode\" data-id=\"${m[0]}\"><span class=\"ch-icon\">${I(m[3])}</span><b>${m[1]}</b><small>${m[2]}</small>${isStudent()?badge(modeActive(m[0])?'Disponible':'Bientôt',modeActive(m[0])?'good':''):''}</button>`;\nfunction paged(arr,html){const chunks=arr.slice(offset,offset+4);return chunks.map(html).join('')+(arr.length>4?`<div class=\"ch-actions\">${btn('prev-page','← Précédent',offset===0?'disabled':'')}${badge(`${Math.floor(offset/4)+1} / ${Math.ceil(arr.length/4)}`)}${btn('next-page','Suivant →',offset+4>=arr.length?'disabled':'')}</div>`:'')}\nfunction studentHome(){return title('monAvenir Challenge','Révisez. Défiez. Progressez.')+`<div class=\"ch-hero\"><span class=\"ch-trophy\">🏆</span><div><b>À vous de jouer !</b><small>Choisissez un défi et testez vos connaissances.</small></div></div><div class=\"ch-grid\">${modes.map(gridItem).join('')}<button class=\"ch-tile\" data-ch=\"history\"><span class=\"ch-icon\">${I('chart')}</span><b>Mes résultats</b><small>Classements et historique</small></button></div>${btn('invitations',`Invitations ${duels().filter(d=>d.status==='pending'&&d.receiver===st.user.id).length?'· '+duels().filter(d=>d.status==='pending'&&d.receiver===st.user.id).length:''}`,'primary')}`}\nfunction managerHome(){return title('monAvenir Challenge',isAdmin()?'Pilotez les défis et concours.':'Animez les révisions de vos élèves.')+`<div class=\"ch-stats\">${stat(events().length,'Concours')}${stat(events().filter(e=>e.status==='published').length,'Publiés')}${isAdmin()?stat(Object.values(data.modes||{}).filter(Boolean).length+'/5','Modes actifs'):stat(events().filter(e=>e.status==='draft').length,'Brouillons')}</div><div class=\"ch-grid\">${isAdmin()?`<button class=\"ch-tile\" data-ch=\"activation\"><span class=\"ch-icon\">${I('settings')}</span><b>Activation</b><small>Contrôle des cinq modes</small></button>`:''}<button class=\"ch-tile\" data-ch=\"new\"><span class=\"ch-icon\">${I('plus')}</span><b>Créer un concours</b><small>Préparer une épreuve</small></button><button class=\"ch-tile\" data-ch=\"list\"><span class=\"ch-icon\">${I('folder')}</span><b>Mes concours</b><small>Brouillons et publications</small></button><button class=\"ch-tile\" data-ch=\"rank-list\"><span class=\"ch-icon\">${I('chart')}</span><b>Résultats</b><small>Classements et scores</small></button></div><div class=\"ch-note\">${isAdmin()?'Vous seul activez les modes et publiez les concours.':'Chaque concours reste en brouillon jusqu’à sa validation par l’administrateur.'}</div>`}\nfunction activation(){return title('Activation des modes','Les cinq modes sont indépendants.')+`<div class=\"ch-card\">${modes.map(m=>`<div class=\"ch-setting\"><span class=\"ch-icon\">${I(m[3])}</span><span><b>${m[1]}</b><small>${modeActive(m[0])?'Disponible':'Désactivé'}</small></span><button class=\"ch-switch ${modeActive(m[0])?'on':''}\" role=\"switch\" aria-checked=\"${modeActive(m[0])}\" aria-label=\"${E(m[1])}\" data-ch=\"toggle\" data-id=\"${m[0]}\"></button></div>`).join('')}</div><div class=\"ch-note\">Un mode activé n'ouvre aucun concours sans publication préalable.</div>${btn('home','Retour au tableau de bord','primary')}`}\nfunction listing(ranking=false){let items=events().filter(e=>ranking?e.status==='published':listFilter==='all'||e.status===listFilter);return title(ranking?'Classements':'Mes concours','Sélectionnez une épreuve.')+(!ranking?`<div class=\"ch-tabs\">${[['all','Tous'],['draft','Brouillons'],['published','Publiés'],['suspended','Suspendus']].map(([k,l])=>btn('filter',l,`data-id=\"${k}\" ${listFilter===k?'primary':''}`)).join('')}</div>`:'')+`<div class=\"ch-stack\">${paged(items,e=>row(e.title,`${M(e.mode)[1]} · ${label(e)} · ${date(e.starts_at)}`,ranking?'rank':'manage',e.id))||empty('Aucun concours pour le moment.')}</div>${!ranking?btn('new','+ Nouveau concours','primary'):''}`}\nfunction modeList(){const m=M(mode),items=events().filter(e=>e.mode===mode);return title(m[1],m[2])+(!modeActive(mode)?empty('Ce mode sera activé par l’administrateur prochainement.'):items.length?paged(items,e=>row(e.title,`${e.subject} · ${e.chapter} · ${label(e)}`,'event',e.id)):empty('Aucun concours publié pour ce mode.'))+btn('home','Retour aux défis')}\nfunction details(){const e=event();if(!e)return empty('Concours introuvable');const a=e.attempt,d=duels().find(x=>x.event_id===e.id&&x.status==='accepted');const ended=Date.now()>=Date.parse(e.ends_at);return title(e.title,`${M(e.mode)[1]} · ${label(e)}`)+`<div class=\"ch-card\"><b>${E(e.subject)} · ${E(e.chapter)}</b><p class=\"ch-sub\">${E(e.academic_level)} · ${E(e.series)}</p><div class=\"ch-stats\">${stat(e.count,'Questions')}${stat(e.seconds_per_question+' s','Par question')}${stat(e.count*10,'Points')}</div><p class=\"ch-sub\">Ouverture : ${date(e.starts_at)}<br>Clôture : ${date(e.ends_at)}</p><div class=\"ch-note\">Une seule tentative. +10 par bonne réponse. Aucun retour en arrière pendant le QCM.</div></div>${a?.finished_at?btn('result','Mes résultats','primary'):ended?empty('Ce concours est terminé.'):(e.mode==='duel'&&!d?btn('opponent','Choisir un adversaire','primary'):Date.now()<Date.parse(e.starts_at)?empty('Ouverture à la date indiquée.'):btn('start',a?'Reprendre mon épreuve':'Commencer','primary'))}${e.mode==='duel'?btn('invitations','Mes invitations'):''}${ended?btn('rank','Classement',`data-id=\"${e.id}\"`):''}${btn('mode-back','Retour')}`}\nfunction opponentPage(){return bar(1,3)+title('Choisir un adversaire','Même série et même niveau.')+`<form id=\"chSearch\" class=\"ch-card\"><div class=\"ch-tabs\">${btn('scope','Même lycée',`data-id=\"same\" ${scope==='same'?'primary':''}`)}${btn('scope','Autre lycée',`data-id=\"other\" ${scope==='other'?'primary':''}`)}</div>${field('Nom de l’élève',input('search',query,'required minlength=\"2\" maxlength=\"80\" placeholder=\"2 lettres minimum\"'))}<button class=\"ch-btn ch-primary\" type=\"submit\">Rechercher</button></form>${paged(opponents,p=>row(p.name,p.school||'Établissement non renseigné','pick',p.id))||empty('Recherchez un élève pour lancer un défi.')}${btn('event','← Précédent',`data-id=\"${eventId}\"`)}`}\nlet opponent=null;\nfunction confirmInvite(){return bar(2,3)+title('Confirmer le défi')+`<div class=\"ch-card ch-center\"><div class=\"ch-versus\"><div><span class=\"ch-avatar\">${E((st.profile?.full_name||'Moi').slice(0,1))}</span><b>Vous</b></div><strong>VS</strong><div><span class=\"ch-avatar\">${E(opponent?.name?.slice(0,1)||'?')}</span><b>${E(opponent?.name||'')}</b></div></div><p>${E(event()?.title||'')}</p><p class=\"ch-sub\">${event()?.count} questions · ${event()?.seconds_per_question} secondes</p></div>${actions('opponent','invite','Envoyer le défi')}`}\nfunction invitations(){return title('Mes invitations','Recevez et envoyez des défis.')+`<div class=\"ch-stack\">${paged(duels(),d=>{const sent=d.sender===st.user.id,other=sent?d.receiver_name:d.sender_name,e=events().find(e=>e.id===d.event_id);return `<div class=\"ch-card\"><div class=\"ch-line\"><b>${E(other)}</b>${badge({pending:'En attente',accepted:'Accepté',declined:'Refusé',cancelled:'Annulé'}[d.status],d.status==='accepted'?'good':'')}</div><p class=\"ch-sub\">${E(e?.title||'Duel')} · ${sent?'Envoyé':'Reçu'}</p>${d.status==='pending'?(sent?btn('cancel','Annuler',`data-id=\"${d.event_id}\" data-duel=\"${d.id}\"`):`<div class=\"ch-actions\">${btn('decline','Refuser',`data-id=\"${d.event_id}\" data-duel=\"${d.id}\"`)}${btn('accept','Accepter',`primary data-id=\"${d.event_id}\" data-duel=\"${d.id}\"`)}</div>`):d.status==='accepted'&&e?btn('event','Ouvrir le défi',`primary data-id=\"${e.id}\"`):''}</div>`})||empty('Aucune invitation.')}</div>${btn('home','Retour')}`}\nfunction quiz(){const q=run?.question;if(!q)return empty('Épreuve indisponible');return `<div class=\"ch-line\"><b>Question ${run.position} / ${run.count}</b><span class=\"ch-clock\" id=\"chClock\">—</span></div><div class=\"ch-progress\"><i style=\"width:${100*run.position/run.count}%\"></i></div><div class=\"ch-card\"><h2 data-mbl-original dir=\"auto\">${E(q.text)}</h2>${q.options.map((v,i)=>`<button type=\"button\" class=\"ch-option ${i===selected?'chosen':''}\" data-ch=\"choose\" data-id=\"${i}\" aria-pressed=\"${i===selected}\"><span>${'ABCD'[i]}</span>${E(v)}</button>`).join('')}${btn('answer',run.position===run.count?'Terminer':'Valider et suivant →',`primary ${selected<0?'disabled':''}`)}<p class=\"ch-sub ch-center\">Aucun retour en arrière.</p></div>`}\nfunction resultPage(){if(!result)return empty('Aucun résultat');return title('Résultat du défi')+`<div class=\"ch-card ch-center\"><span class=\"ch-trophy big\">🏆</span><strong class=\"ch-score\">${result.score}/${result.total}</strong><p>${result.score/10} bonne(s) réponse(s) sur ${result.total/10}</p><p class=\"ch-sub\">Temps : ${Math.round(result.elapsed_ms/1000)} s</p>${result.correction?btn('correction','Voir le corrigé','primary'):empty('Le corrigé et le classement seront disponibles à la clôture.')}${Date.now()>=Date.parse(event()?.ends_at)?btn('rank','Classement',`data-id=\"${eventId}\"`):''}</div>${btn('home','Retour aux défis')}`}\nfunction correction(){const q=result?.correction?.[previewIndex];return q?bar(previewIndex,result.correction.length)+title('Corrigé',`Question ${previewIndex+1}`)+`<div class=\"ch-card\"><h2 data-mbl-original dir=\"auto\">${E(q.text)}</h2>${q.options.map((o,i)=>`<div class=\"ch-answer ${i===q.correct?'correct':''}\">${E(o)} ${i===q.correct?'✓':''}</div>`).join('')}<p class=\"ch-sub\">Votre réponse : ${E(q.options[result.answers?.find(a=>a.index===previewIndex)?.choice]||'Non répondue')}</p></div>${actions('corr-back','corr-next',previewIndex===result.correction.length-1?'Terminer':'Suivant')}`:empty('Aucun corrigé')}\nfunction rankingPage(){return title('Classement',event()?.title||'')+`<div class=\"ch-card\">${paged(rank,(r,i)=>`<div class=\"ch-rank\"><span class=\"ch-rank-num\">${['🥇','🥈','🥉'][offset+rank.slice(offset,offset+4).indexOf(r)]||offset+rank.slice(offset,offset+4).indexOf(r)+1}</span><div><b>${E(r.name)}</b>${r.participants?`<small>${r.participants} participant(s)</small>`:''}</div><strong>${E(r.score)} pts</strong></div>`)||empty('Aucun résultat disponible.')}</div><p class=\"ch-sub\">${['classes','schools'].includes(event()?.mode)?'Moyenne des participants ayant terminé.':'Score décroissant, puis temps de réponse.'}</p>${btn('home','Retour')}`}\nfunction history(){const items=events().filter(e=>e.attempt?.finished_at);return title('Mes résultats','Vos participations terminées.')+paged(items,e=>row(e.title,`${e.attempt.score}/${e.count*10} · ${date(e.attempt.finished_at)}`,'result',e.id))+(!items.length?empty('Aucun résultat pour le moment.'):'')+btn('home','Retour')}\nfunction localDate(d){return new Date(d.getTime()+3*3600000).toISOString().slice(0,16)}\nfunction initDraft(){const start=new Date(Date.now()+86400000),end=new Date(start.getTime()+3600000),sp=data.specialties?.[0];draft={mode:'duel',title:'',series:sp?.series||'',academic_level:sp?.level||'',subject:sp?.subject||'',chapter:'',seconds:20,starts_at:localDate(start),ends_at:localDate(end),group_ids:[],questions:[]};step=0;qindex=0;move('create')}\nfunction create(){const m=M(draft.mode),qs=draft.questions,q=qs[qindex]||{text:'',options:['','','',''],correct:null};let s=bar(step,4)+title(['Créer un concours','Paramètres','Questions','Vérification'][step]);if(step===0){s+=`<form id=\"chStep\" class=\"ch-card\">${field('Nom du concours',input('title',draft.title,'required minlength=\"3\" maxlength=\"120\"'))}${field('Type',select('mode',modes.map(x=>[x[0],x[1]]),draft.mode))}${data.specialties?.length?field('Spécialité',select('specialty',[['','Sélectionner'],...data.specialties.map((x,i)=>[String(i),`${x.level} · ${x.series} · ${x.subject}`])],String(data.specialties.findIndex(x=>x.series===draft.series&&x.level===draft.academic_level&&x.subject===draft.subject)))):isAdmin()?field('Série',input('series',draft.series,'required'))+field('Niveau',input('academic_level',draft.academic_level,'required'))+field('Matière',input('subject',draft.subject,'required')):empty('Aucune spécialité approuvée.')}${field('Chapitre',input('chapter',draft.chapter,'required maxlength=\"120\"'))}<div class=\"ch-actions\">${btn('create-back','← Précédent')}<button type=\"submit\" class=\"ch-btn ch-primary\">Suivant →</button></div></form>`}else if(step===1){s+=`<form id=\"chStep\" class=\"ch-card\"><div class=\"ch-stats\">${stat(m[4],'Questions')}${stat(m[4]*10,'Points')}</div>${field('Temps par question',select('seconds',[[20,'20 secondes'],[30,'30 secondes'],[45,'45 secondes'],[60,'60 secondes']],draft.seconds))}${field('Ouverture (heure de Djibouti)',input('starts_at',draft.starts_at,'type=\"datetime-local\" required'))}${field('Clôture (heure de Djibouti)',input('ends_at',draft.ends_at,'type=\"datetime-local\" required'))}${['classes','schools'].includes(draft.mode)?`<label class=\"ch-field\"><span>Classes concernées (2 au minimum)</span><select name=\"group_ids\" multiple size=\"4\" required>${(data.groups||[]).map(g=>`<option value=\"${g.id}\" ${draft.group_ids.includes(g.id)?'selected':''}>${E(g.name)} · ${E(g.school)}</option>`).join('')}</select></label><small class=\"ch-sub\">Sélectionnez les classes autorisées.</small>`:''}<div class=\"ch-actions\">${btn('create-back','← Précédent')}<button type=\"submit\" class=\"ch-btn ch-primary\">Suivant →</button></div></form>`}else if(step===2){s+=`<form id=\"chStep\" class=\"ch-card\"><div class=\"ch-line\"><b>Question ${qindex+1}/${m[4]}</b>${badge('QCM')}</div>${field('Énoncé',`<textarea name=\"text\" rows=\"2\" required maxlength=\"1000\">${E(q.text)}</textarea>`)}${q.options.map((o,i)=>field(`Proposition ${'ABCD'[i]}`,input('opt'+i,o,'required maxlength=\"300\"'))).join('')}${field('Bonne réponse',select('correct',[['','Sélectionner'],...['A','B','C','D'].map((l,i)=>[String(i),l])],q.correct===null?'':String(q.correct)))}<div class=\"ch-actions\">${btn('create-back','← Précédent')}<button type=\"submit\" class=\"ch-btn ch-primary\">Suivant →</button></div></form>`}else{s+=`<div class=\"ch-card\"><h2>${E(draft.title)}</h2><p>${E(m[1])} · ${E(draft.subject)} · ${E(draft.chapter)}</p><div class=\"ch-stats\">${stat(qs.length,'Questions')}${stat(draft.seconds+' s','Par question')}${stat(draft.group_ids.length||'Tous','Classes')}</div><p class=\"ch-sub\">${E(draft.starts_at.replace('T',' '))} → ${E(draft.ends_at.replace('T',' '))}</p><div class=\"ch-note\">Enregistrer en brouillon. Seul l’administrateur publie le concours.</div></div>${actions('create-back','save','Enregistrer le brouillon')}`;}return s;}\nfunction manage(){const e=event();if(!e)return empty('Concours introuvable');return title(e.title,`${M(e.mode)[1]} · ${label(e)}`)+`<div class=\"ch-card\"><p><b>${E(e.subject)} · ${E(e.chapter)}</b></p><div class=\"ch-stats\">${stat(e.count,'Questions')}${stat(e.group_ids.length||'Tous','Classes')}${stat(e.seconds_per_question+' s','Temps')}</div><p class=\"ch-sub\">${date(e.starts_at)} → ${date(e.ends_at)}</p><div class=\"ch-note\">✓ Questions enregistrées<br>✓ Contrôle de l’éligibilité et du chronomètre côté serveur</div>${btn('preview','Prévisualiser les questions','primary')}${isAdmin()?e.status==='published'?btn('suspend','Suspendre le concours'):btn('publish','Activer le concours','primary'):badge('Validation administrateur requise')}${btn('rank','Voir les résultats',`data-id=\"${e.id}\"`)}</div>${btn('list','Retour aux concours')}`}\nfunction previewQuestions(){const q=review?.questions?.[previewIndex];return q?bar(previewIndex,review.questions.length)+title('Prévisualisation',`Question ${previewIndex+1}`)+`<div class=\"ch-card\"><h2 data-mbl-original dir=\"auto\">${E(q.text)}</h2>${q.options.map((o,i)=>`<div class=\"ch-answer ${i===q.correct?'correct':''}\">${E(o)} ${i===q.correct?'✓':''}</div>`).join('')}</div>${actions('preview-back','preview-next',previewIndex===review.questions.length-1?'Terminer':'Suivant')}`:empty('Aucune question');}\nfunction body(){if(loading)return empty('Chargement…');if(page==='home')return isStudent()?studentHome():managerHome();if(page==='activation'&&isAdmin())return activation();if(page==='list')return listing();if(page==='rank-list')return listing(true);if(page==='mode')return modeList();if(page==='event')return details();if(page==='opponent')return opponentPage();if(page==='invite-confirm')return confirmInvite();if(page==='invitations')return invitations();if(page==='quiz')return quiz();if(page==='result')return resultPage();if(page==='correction')return correction();if(page==='ranking')return rankingPage();if(page==='history')return history();if(page==='create'&&draft)return create();if(page==='manage')return manage();if(page==='preview')return previewQuestions();return empty('Écran indisponible')}\nconst oldView=view;view=function(){if(!on())return oldView();return `<div class=\"ch-shell\"><div class=\"ch-top\"><button type=\"button\" class=\"ch-back\" data-ch=\"exit\">${I('left')} Accueil</button>${btn('refresh','Actualiser')}</div>${error?`<div class=\"ch-error\" role=\"alert\">${E(error)}</div>`:''}${notice?`<div class=\"ch-note\" role=\"status\">${E(notice)}</div>`:''}${body()}</div>`};\nlet integrity=[];\nconst previousBody=body;body=function(){if(page==='integrity'&&isAdmin()&&!loading)return title('Contrôle des participations',event()?.title||'')+`<div class=\"ch-note\">Les sorties de l’écran sont des indications, pas une preuve de triche. Vérifiez avant toute sanction.</div>${paged(integrity,r=>`<div class=\"ch-card\"><div class=\"ch-line\"><b>${E(r.name)}</b>${badge(r.disqualified?'Disqualifié':r.warnings+' signalement(s)')}</div>${r.disqualified?`<p class=\"ch-sub\">${E(r.reason)}</p>`:btn('disqualify','Disqualifier',`data-id=\"${r.id}\"`)}</div>`)||empty('Aucune participation.')}${btn('manage','Retour',`data-id=\"${eventId}\"`)}`;return previousBody()};\nconst previousManage=manage;manage=function(){return previousManage()+(isAdmin()?btn('integrity','Contrôler les participations'):'')};\ndocument.addEventListener('visibilitychange',()=>{if(document.hidden&&on()&&page==='quiz'&&run&&!run.finished&&st.user)api('report',{id:eventId}).catch(()=>{})});\ndocument.addEventListener('click',async e=>{const b=e.target.closest?.('[data-ch=\"integrity\"],[data-ch=\"disqualify\"]');if(!b||!on()||!isAdmin())return;e.preventDefault();e.stopImmediatePropagation();if(working)return;working=true;try{if(b.dataset.ch==='disqualify'){const reason=await window.MBDialog.prompt('Motif de disqualification après vérification');if(!reason)return;await api('disqualify',{id:eventId,student:b.dataset.id,reason})}integrity=await api('integrity',{id:eventId});move('integrity')}catch(err){error=err.message;render()}finally{working=false}},true);\nconst oldGo=go;go=function(s){if(screens.includes(s)){reset();owner=st.user?.id||'';loading=true;const ret=oldGo(s);if(st.screen===s)load();return ret}clearInterval(timer);return oldGo(s)};\nconst oldRender=render;render=function(){const r=oldRender(),app=$('app');if(!app)return r;if(st.user?.id!==owner&&on())reset();if(on()){app.classList.add('ch-app');return r;}app.classList.remove('ch-app');if(!st.user||!st.loaded||EGEAccount.blocked(st.profile)||EGEAccount.incomplete(st.profile,st.role)||(st.role==='eleve'&&!st.profile?.avatar_path)||(st.role==='enseignant'&&st.teacher?.status!=='approved'))return r;\n const target={eleve:'student-challenge',enseignant:'teacher-challenge',admin:'admin-challenge'}[st.role];if(st.screen!==home()||!target)return r;const grid=app.querySelector('.mb-tiles');if(grid&&!grid.querySelector('[data-to=\"'+target+'\"]')){const b=document.createElement('button');b.type='button';b.className='mb-tile ch-entry';b.dataset.act='goto';b.dataset.to=target;b.innerHTML=`${I('star')}<span>Challenge</span>`;grid.append(b);}else if(!grid){const screen=app.querySelector('.screen');if(screen&&!screen.querySelector('[data-to=\"'+target+'\"]'))screen.insertAdjacentHTML('afterbegin',`<button class=\"ch-btn ch-entry\" data-act=\"goto\" data-to=\"${target}\">🏆 monAvenir Challenge</button>`);}return r;};\nfunction startClock(){clearInterval(timer);if(!run||run.finished)return;const deadline=Date.parse(run.deadline),delta=Date.now()-Date.parse(run.server_now);const tick=()=>{if(!on()||page!=='quiz'){clearInterval(timer);return;}const ms=Math.max(0,deadline-(Date.now()-delta)),clock=$('chClock');if(clock)clock.textContent=Math.ceil(ms/1000)+' s';if(ms<=0&&!working){clearInterval(timer);submitAnswer(-1)}};timer=setInterval(tick,200);tick()}\nasync function openRun(){run=await api('start',{id:eventId});selected=-1;if(run.finished){result=await api('result',{id:eventId});move('result')}else{move('quiz');startClock()}}\nasync function submitAnswer(v){if(working)return;working=true;try{run=await api('answer',{id:eventId,position:run.position,choice:v});selected=-1;if(run.finished){result=await api('result',{id:eventId});move('result')}else{move('quiz')}}catch(e){error=e.message;render()}finally{working=false;if(page==='quiz'&&!error)startClock()}}\nfunction captureQuestion(fd){const c=fd.get('correct');if(c===''||c===null)throw Error('Indiquez la bonne réponse.');const q={text:String(fd.get('text')).trim(),options:[0,1,2,3].map(i=>String(fd.get('opt'+i)).trim()),correct:Number(c)};if(!q.text||q.options.some(x=>!x)||new Set(q.options).size!==4)throw Error('Renseignez quatre réponses distinctes.');draft.questions[qindex]=q;}\ndocument.addEventListener('submit',async e=>{if(!on()||!['chStep','chSearch'].includes(e.target.id))return;e.preventDefault();e.stopImmediatePropagation();if(working)return;working=true;error='';try{const f=new FormData(e.target);if(e.target.id==='chSearch'){query=String(f.get('search'));opponents=await api('opponents',{id:eventId,search:query,scope});offset=0;render();return;}if(step===0){const old=draft.mode;for(const k of ['title','mode','chapter'])draft[k]=String(f.get(k)||'').trim();if(f.has('specialty')){const sp=data.specialties[Number(f.get('specialty'))];if(f.get('specialty')===''||!sp)throw Error('Choisissez une spécialité approuvée.');Object.assign(draft,{series:sp.series,academic_level:sp.level,subject:sp.subject});}else for(const k of ['series','academic_level','subject'])draft[k]=String(f.get(k)||'').trim();if(!draft.title||!draft.chapter||!draft.series||!draft.academic_level||!draft.subject)throw Error('Complétez les informations.');if(old!==draft.mode){draft.questions=[];draft.group_ids=[];}step=1;}else if(step===1){draft.seconds=Number(f.get('seconds'));draft.starts_at=String(f.get('starts_at'));draft.ends_at=String(f.get('ends_at'));draft.group_ids=f.getAll('group_ids');if(draft.ends_at<=draft.starts_at)throw Error('La clôture doit être après l’ouverture.');if(['classes','schools'].includes(draft.mode)&&draft.group_ids.length<2)throw Error('Sélectionnez au moins deux classes.');step=2;qindex=0;}else if(step===2){captureQuestion(f);if(qindex+1<M(draft.mode)[4])qindex++;else step=3;}render();}catch(err){error=err.message;render()}finally{working=false}},true);\ndocument.addEventListener('click',async e=>{const b=e.target.closest?.('[data-ch]');if(!b||!on()||!st.user)return;e.preventDefault();e.stopImmediatePropagation();if(working)return;const a=b.dataset.ch,id=b.dataset.id;error='';if(a==='answer'){submitAnswer(selected);return}working=true;try{if(a==='exit'){go(home());return}if(a==='refresh'){if(page==='quiz')await openRun();else await load();return}if(['home','activation','list','rank-list','history','invitations','opponent'].includes(a)){move(a);return}if(a==='new'){initDraft();return}if(a==='prev-page'||a==='next-page'){offset=Math.max(0,offset+(a==='prev-page'?-4:4));render();return}if(a==='filter'){listFilter=id;offset=0;render();return}if(a==='mode'){mode=id;move('mode');return}if(a==='mode-back'){move('mode');return}if(a==='event'||a==='manage'){eventId=id;mode=event()?.mode||mode;move(a);return}if(a==='scope'){scope=id;opponents=[];offset=0;render();return}if(a==='pick'){opponent=opponents.find(x=>x.id===id);move('invite-confirm');return}if(a==='invite'){await api('invite',{id:eventId,target:opponent.id});move('invitations');await load();return}if(['accept','decline','cancel'].includes(a)){await api(a,{id,duel_id:b.dataset.duel});await load();return}if(a==='toggle'&&isAdmin()){await api('mode',{mode:id,enabled:!modeActive(id)});await load();return}if(a==='choose'){selected=Number(id);render();return}if(a==='start'){await openRun();return}if(a==='result'){eventId=id||eventId;result=await api('result',{id:eventId});move('result');return}if(a==='rank'){eventId=id||eventId;rank=await api('ranking',{id:eventId});move('ranking');return}if(a==='correction'){previewIndex=0;move('correction');return}if(a==='corr-back'||a==='corr-next'){if(a==='corr-back'&&previewIndex===0||a==='corr-next'&&previewIndex===result.correction.length-1)move('result');else{previewIndex+=a==='corr-next'?1:-1;render()}return}if(a==='create-back'){if(step===2&&qindex>0)qindex--;else if(step===3){step=2;qindex=M(draft.mode)[4]-1}else if(step>0)step--;else{move('home');return}render();return}if(a==='save'){const payload={...draft,starts_at:draft.starts_at+':00+03:00',ends_at:draft.ends_at+':00+03:00'};const r=await api('create',payload);eventId=r.id;draft=null;move('manage');await load();return}if(a==='preview'){review=await api('preview',{id:eventId});previewIndex=0;move('preview');return}if(a==='preview-back'||a==='preview-next'){if(a==='preview-back'&&previewIndex===0||a==='preview-next'&&previewIndex===review.questions.length-1)move('manage');else{previewIndex+=a==='preview-next'?1:-1;render()}return}if((a==='publish'||a==='suspend')&&isAdmin()){if(!await window.MBDialog.confirm(a==='publish'?'Publier cette compétition ?':'Suspendre cette compétition ?'))return;await api(a,{id:eventId});await load();return}}catch(err){error=err.message||'Opération impossible';render()}finally{working=false;if(page==='quiz'&&run&&!run.finished&&!error)startClock()}},true);\nwindow.MBChallenge={api,load,modes};\n})();\n"],"/mon-bac-challenge.css":["text/css; charset=utf-8",false,"/* Compact, responsive screens; reuse the monAvenir red/white identity. */\n.ch-shell{--ch-red:#c60835;--ch-line:#e5e7ed;--ch-ink:#182638;--ch-muted:#697789;max-width:720px;margin:0 auto;color:var(--ch-ink);display:grid;gap:12px;min-width:0}.ch-shell h1{font-size:clamp(21px,5vw,27px);margin:0;letter-spacing:-.7px}.ch-shell h2{font-size:17px;line-height:1.35;margin:0 0 8px}.ch-shell p{margin:0;line-height:1.45}.ch-sub{font-size:12px;color:var(--ch-muted)}.ch-top,.ch-line,.ch-setting,.ch-rank,.ch-versus{display:flex;align-items:center;gap:10px;justify-content:space-between}.ch-top{margin-bottom:3px}.ch-back{color:var(--ch-red);font-weight:750;border:0;background:none;padding:9px 0;display:flex;align-items:center;gap:5px}.ch-btn{min-height:44px;border:1px solid var(--ch-line);color:var(--ch-red);font-size:13px;font-weight:750;border-radius:11px;padding:10px 12px;background:#fff;overflow-wrap:anywhere;min-width:0}.ch-primary{background:var(--ch-red);color:white;border-color:var(--ch-red)}.ch-btn:focus-visible,.ch-tile:focus-visible,.ch-row:focus-visible,.ch-option:focus-visible,.ch-switch:focus-visible{outline:3px solid #e58ca3;outline-offset:2px}.ch-top .ch-btn{min-height:36px;padding:7px 12px}.ch-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.ch-tile{background:#fff;border:1px solid var(--ch-line);text-align:left;padding:12px;display:flex;flex-direction:column;align-items:flex-start;gap:5px;border-radius:15px;color:var(--ch-ink);min-width:0;min-height:110px}.ch-tile b{font-size:14px;line-height:1.25;overflow-wrap:anywhere}.ch-tile small,.ch-setting small,.ch-rank small,.ch-row small,.ch-stat small,.ch-hero small{display:block;color:var(--ch-muted);font-size:11px;line-height:1.35}.ch-icon{display:grid;place-items:center;background:#fff0f3;color:var(--ch-red);width:35px;height:35px;border-radius:10px;flex:none}.ch-icon svg{width:20px;height:20px}.ch-badge{font-size:10px;display:inline-flex;font-weight:700;padding:4px 8px;border-radius:20px;background:#eef0f4;color:#586474;align-self:flex-start;white-space:nowrap}.ch-badge.good{background:#e5f5ec;color:#166743}.ch-hero{display:flex;align-items:center;gap:12px;padding:12px 16px;border:1px solid #f1d8e0;border-radius:15px;background:linear-gradient(115deg,#fff4f6,#fff);color:var(--ch-ink)}.ch-hero b{display:block;font-size:16px;margin-bottom:4px}.ch-trophy{font-size:31px}.ch-trophy.big{font-size:46px;display:block}.ch-stats{display:flex;gap:8px;margin:4px 0}.ch-stat{flex:1;min-width:0;background:#f8f9fc;text-align:center;border-radius:11px;padding:10px 4px}.ch-stat b{display:block;color:var(--ch-red);font-size:20px;overflow-wrap:anywhere}.ch-card{background:white;border:1px solid var(--ch-line);border-radius:15px;padding:14px;display:grid;gap:10px;min-width:0}.ch-card .ch-btn{width:100%}.ch-center{text-align:center}.ch-note,.ch-error,.ch-empty{font-size:12px;line-height:1.45;padding:11px 13px;border-radius:11px;overflow-wrap:anywhere}.ch-note{background:#fff0f3;color:#85263e}.ch-empty{border:1px dashed #dfe2e8;color:#5f6c7c;background:#fff;text-align:center}.ch-error{background:#fff0f2;color:#931431;border:1px solid #edcbd3}.ch-stack{display:grid;gap:8px}.ch-row{display:flex;width:100%;align-items:center;gap:10px;justify-content:space-between;background:white;border:1px solid var(--ch-line);color:var(--ch-ink);border-radius:12px;text-align:left;padding:13px;min-height:59px;min-width:0;overflow-wrap:anywhere}.ch-row b{font-size:14px}.ch-row svg{color:var(--ch-red);width:17px}.ch-setting{justify-content:flex-start;border-bottom:1px solid var(--ch-line);padding:9px 0}.ch-setting:last-child{border:0}.ch-setting>span:nth-child(2){flex:1;min-width:0}.ch-switch{border:0;width:46px;height:27px;border-radius:15px;background:#c6cad3;position:relative;flex:none}.ch-switch:after{content:'';position:absolute;left:4px;top:4px;width:19px;height:19px;background:#fff;border-radius:50%;box-shadow:0 1px 3px #0002}.ch-switch.on{background:var(--ch-red)}.ch-switch.on:after{left:23px}.ch-tabs{display:grid;grid-template-columns:repeat(auto-fit,minmax(80px,1fr));gap:5px}.ch-tabs button{font-size:11px;padding:9px 5px}.ch-actions{display:flex;gap:8px;align-items:center;justify-content:space-between}.ch-actions .ch-btn{flex:1;width:auto}.ch-step{display:grid;gap:6px}.ch-step small{color:var(--ch-red);font-size:11px;font-weight:750}.ch-step>div,.ch-progress{display:flex;gap:3px;height:5px;background:#e9ebf1;border-radius:12px;overflow:hidden}.ch-step i{flex:1;background:#dce0e8;border-radius:8px}.ch-step i.active,.ch-progress i{background:var(--ch-red)}.ch-field{display:grid;gap:4px;font-size:12px;font-weight:700;color:#314154;min-width:0}.ch-field input,.ch-field select,.ch-field textarea{display:block;width:100%;min-width:0;font-size:14px;font-weight:400;border:1px solid #dce0e6;border-radius:10px;padding:10px 11px;min-height:40px;background:#fafbfc;color:var(--ch-ink)}.ch-field textarea{resize:vertical}.ch-field select[multiple]{min-height:100px}.ch-clock{padding:7px 12px;background:#fff0f3;border-radius:24px;font-weight:800;color:var(--ch-red);font-variant-numeric:tabular-nums}.ch-option{display:flex;align-items:center;gap:10px;min-height:46px;background:#fff;border:1px solid var(--ch-line);border-radius:10px;text-align:left;color:var(--ch-ink);font-size:14px;padding:9px 10px;overflow-wrap:anywhere}.ch-option span{display:grid;place-items:center;width:26px;height:26px;background:#f0f2f6;border-radius:8px;font-weight:800;font-size:11px;flex:none}.ch-option.chosen{border-color:var(--ch-red);background:#fff0f3;color:var(--ch-red)}.ch-score{font-size:44px;letter-spacing:-1px;color:var(--ch-red)}.ch-versus{justify-content:space-evenly}.ch-versus>div{display:grid;gap:5px;justify-items:center}.ch-avatar{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;color:var(--ch-red);background:#fee5eb;font-size:23px;font-weight:800}.ch-answer{border:1px solid var(--ch-line);border-radius:8px;padding:9px;font-size:13px;overflow-wrap:anywhere}.ch-answer.correct{background:#e5f5ec;color:#166743;border-color:#b4e0c7}.ch-rank{padding:10px 0;border-bottom:1px solid var(--ch-line);font-size:13px}.ch-rank:last-child{border:0}.ch-rank-num{width:26px;text-align:center;flex:none}.ch-rank>div{flex:1;min-width:0}.ch-rank strong{color:var(--ch-red)}.ch-entry{color:#c60835}.ch-app .ege-footer{display:none!important}\n@media(min-width:700px){.ch-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.ch-tile{min-height:125px}.ch-shell{gap:15px}.ch-card{padding:18px}.ch-shell .ch-actions{max-width:100%}}\n@media(max-width:380px){.ch-shell{gap:8px}.ch-card{padding:11px;gap:8px}.ch-grid{gap:7px}.ch-tile{padding:10px;min-height:102px}.ch-tile b{font-size:13px}.ch-hero{padding:10px}.ch-field input,.ch-field select,.ch-field textarea{padding:8px 9px}.ch-btn{padding:9px 8px}.ch-actions{gap:6px}}\n"],"/mon-bac-push.js":["application/javascript; charset=utf-8",false,"/* monAvenir V103 — administrator-managed Web Push and private inbox. */\n(()=>{'use strict';\nconst kinds=[['information','📢 Information générale'],['concours','🏆 Concours'],['defi','⚔️ Défi'],['pedagogie','📚 Pédagogique'],['rappel','⏰ Rappel'],['ege','🎓 EGE'],['resultats','📊 Résultats'],['publicite','📣 Publicité'],['paiement','💳 Paiement'],['urgence','🚨 Urgente'],['motivation','💡 Motivation']];\nconst destinations=[['inbox','Notifications'],['challenge','Challenge'],['courses','Cours et sujets'],['ege','Dossiers EGE'],['support','Soutien scolaire'],['results','Résultats'],['profile','Profil']];\nconst screens=['student-notices','teacher-notices','admin-notices'],isAdmin=()=>st.role==='admin',on=()=>screens.includes(st.screen),roleScreen=()=>({eleve:'student-notices',enseignant:'teacher-notices',admin:'admin-notices'}[st.role]),E=esc;\nlet owner='',inbox={items:[],unread:0,devices:0},history=[],catalog={},found=[],draft=null,page='history',step=0,offset=0,error='',loading=false,busy=false,enabled=false,refreshAt=0,openId=null,sequence=0;\nconst kind=v=>kinds.find(k=>k[0]===v)?.[1]||'Information',date=v=>v?new Intl.DateTimeFormat('fr-FR',{dateStyle:'short',timeStyle:'short',timeZone:'Africa/Djibouti'}).format(new Date(v)):'',button=(a,t,c='')=>`<button type=\"button\" class=\"ch-btn ${c}\" data-push=\"${a}\">${t}</button>`,field=(label,contents)=>`<label class=\"ch-field\"><span>${label}</span>${contents}</label>`,input=(n,v='',attr='')=>`<input name=\"${n}\" value=\"${E(v)}\" ${attr}>`,select=(n,items,v='')=>`<select name=\"${n}\">${items.map(([k,label])=>`<option value=\"${E(k)}\" ${k===v?'selected':''}>${E(label)}</option>`).join('')}</select>`;\nconst multiKeys=['role','school','series','level','class'],options=values=>Array.from(new Set(values.filter(Boolean))).sort((a,b)=>a.localeCompare(b,'fr')).map(x=>[x,x]),selectionLabel=n=>n?`${n} sélectionné(s)`:'Tous';\nfunction multi(label,name,items,values=[]){return `<details class=\"mbpush-filter\" data-filter=\"${name}\"><summary><b>${label}</b><span data-filter-count>${selectionLabel(values.length)}</span></summary><div class=\"mbpush-options\">${items.length?items.map(([v,l])=>`<label><input type=\"checkbox\" name=\"${name}\" value=\"${E(v)}\" ${values.includes(v)?'checked':''}><span>${E(l)}</span></label>`).join(''):'<small>Aucun choix disponible</small>'}</div><small>Sans sélection : tous</small></details>`;}\nfunction reset(){if(owner===st.user?.id)return;owner=st.user?.id||'';inbox={items:[],unread:0,devices:0};history=[];catalog={};found=[];draft=null;page=isAdmin()?'history':'inbox';offset=0;step=0;error='';enabled=false;refreshAt=0;openId=null;sequence++;}\nasync function rpc(action,d={}){const r=await st.db.rpc('mon_bac_push',{action,d});if(r.error)throw Error(r.error.message||'Opération indisponible');return r.data}\nfunction supported(){return typeof Notification!=='undefined'&&'serviceWorker' in navigator&&'PushManager' in window;}\nasync function subscription(){if(!supported())return null;const reg=await navigator.serviceWorker.getRegistration();return reg?await reg.pushManager.getSubscription():null}\nasync function refresh(force=false){reset();if(!st.user||!st.db||st.offlineSession||loading||(!force&&Date.now()-refreshAt<30000))return;const uid=owner,seq=sequence;loading=true;try{const result=await rpc('inbox');if(owner!==uid||sequence!==seq)return;inbox=result||{items:[],unread:0};try{enabled=!!await subscription()&&localStorage.getItem('monbac-push-owner')===uid}catch{enabled=false}if(isAdmin()&&on()){const [h,c]=await Promise.all([rpc('history'),rpc('catalog')]);if(owner!==uid||sequence!==seq)return;history=h||[];catalog=c||{}}refreshAt=Date.now();error='';}catch(e){if(on())error=e.message}finally{loading=false;if(st.user?.id===uid){if(on()&&!composing())render();else updateBell()}}}\nfunction composing(){return isAdmin()&&on()&&page==='create'&&!!draft&&owner===st.user?.id;}\nfunction updateBell(){const b=document.querySelector('.mb95-notice');if(!b)return;const old=b.querySelector('.mb95-push-count');old?.remove();if(inbox.unread){const tag=document.createElement('span');tag.className='mb95-notice-count mb95-push-count';tag.textContent=inbox.unread>99?'99+':inbox.unread;b.querySelector('.mb95-notice-count')?.remove();b.append(tag);b.setAttribute('aria-label',`Notifications : ${inbox.unread} non lues`);}}\nfunction navigateDestination(dest){const role={eleve:'student',enseignant:'teacher',admin:'admin'}[st.role];const target=dest==='profile'?'profile':dest==='ege'?({eleve:'student-docs',enseignant:'teacher-review',admin:'admin-monitor'}[st.role]):role+'-'+({challenge:'challenge',courses:'learning',support:'support',results:'challenge'}[dest]||'');if(screenList.some(x=>x[0]===target)){go(target);return}go(roleScreen())}\nfunction deviceCard(){return `<div class=\"ch-card mbpush-device\"><div><b>Notifications sur ce téléphone</b><p class=\"ch-sub\">${enabled?'Activées sur cet appareil.':'Recevez les alertes même quand monAvenir est fermé.'}</p></div>${supported()?button(enabled?'disable':'enable',enabled?'Désactiver':'Activer',enabled?'':'ch-primary'): '<small class=\"ch-sub\">Sur iPhone, installez monAvenir sur l’écran d’accueil puis ouvrez-le pour activer les notifications.</small>'}</div>`}\nfunction paginate(items,draw){return items.slice(offset,offset+4).map(draw).join('')+(items.length>4?`<div class=\"ch-actions\">${button('previous','← Précédent')}${button('next','Suivant →')}</div>`:'')}\nfunction inboxPage(){const n=inbox.items.find(x=>x.id===openId);if(n)return `<div class=\"ch-card\"><small>${E(kind(n.kind))} · ${E(date(n.scheduled_at))}</small><h2>${E(n.title)}</h2>${n.image?`<img class=\"mbpush-image\" src=\"${E(n.image)}\" alt=\"Illustration\" referrerpolicy=\"no-referrer\">`:''}<p class=\"mbpush-body\">${E(n.body)}</p>${n.destination!=='inbox'?button('destination','Consulter →','ch-primary'):''}${button('back-inbox','← Retour')}</div>`;\n return deviceCard()+`<div class=\"ch-line\"><b>Mes notifications</b>${button('read-all','Tout marquer comme lu')}</div>`+(inbox.items.length?paginate(inbox.items,n=>`<button class=\"ch-row mbpush-row\" data-push=\"open\" data-id=\"${E(n.id)}\"><span><small>${E(kind(n.kind))} · ${E(date(n.scheduled_at))}</small><b>${E(n.title)}${!n.read_at?' <span class=\"mbpush-dot\" aria-label=\"Non lue\"></span>':''}</b><small>${E(n.body.slice(0,105))}</small></span>${I('chevron')}</button>`):'<div class=\"ch-empty\">Aucune nouvelle notification.</div>');}\nfunction wizard(){const a=draft.audience;const bar=`<div class=\"ch-step\"><small>Étape ${step+1} sur 3</small><div>${[0,1,2].map(i=>`<i class=\"${i<=step?'active':''}\"></i>`).join('')}</div></div>`;const nav=`<div class=\"ch-actions\">${button('back','← Précédent')}<button type=\"submit\" class=\"ch-btn ch-primary\">Suivant →</button></div>`;\n if(step===0)return bar+`<h2>Votre message</h2><form class=\"ch-card\" id=\"mbPushContent\">${field('Type',select('kind',kinds,draft.kind))}${field('Titre',input('title',draft.title,'required maxlength=\"100\"'))}${field('Message',`<textarea name=\"body\" required maxlength=\"500\" rows=\"3\">${E(draft.body)}</textarea>`)}${field('Photo (lien HTTPS facultatif)',input('image',draft.image,'type=\"url\" maxlength=\"1000\" placeholder=\"https://…\"'))}${field('Destination',select('destination',destinations,draft.destination))}${nav}</form>`;\n if(step===1)return bar+`<h2>Destinataires</h2><form class=\"ch-card\" id=\"mbPushAudience\">${multi('Public','role',[['eleve','Élèves'],['enseignant','Enseignants'],['admin','Administrateurs']],a.role)}${multi('Établissements','school',options([...(window.EGEAcademic?.schools||[]),...(catalog.schools||[])]),a.school)}${multi('Séries','series',options([...(window.EGEAcademic?.series||[]),...(catalog.series||[])]),a.series)}${multi('Niveaux','level',[['Première','Première'],['Terminale','Terminale']],a.level)}${multi('Classes','class',options(catalog.classes||[]),a.class)}${field('Utilisateur précis (facultatif)',input('query',draft.query,'placeholder=\"Nom ou prénom\"'))}${button('search','Rechercher')}${found.length?field('Sélectionner',select('user',[['','Tous les utilisateurs ciblés'],...found.map(p=>[p.user_id,p.full_name+' · '+p.school])],a.user)):a.user?`<p class=\"ch-note\">Utilisateur sélectionné</p>`:''}<small class=\"ch-sub\">Cochez un ou plusieurs choix par filtre. Les filtres se combinent. Sans sélection, tous sont inclus.</small>${nav}</form>`;\n return bar+`<h2>Vérifier et envoyer</h2><div class=\"ch-card mbpush-preview\"><div class=\"mbpush-brand\"><img src=\"./mon-bac-192.png\" alt=\"\"> <b>monAvenir</b><small>À l’instant</small></div><b>${E(draft.title)}</b><p>${E(draft.body)}</p>${draft.image?`<img class=\"mbpush-image\" src=\"${E(draft.image)}\" alt=\"Illustration\" referrerpolicy=\"no-referrer\">`:''}</div><form class=\"ch-card\" id=\"mbPushSend\"><div class=\"ch-stats\"><div class=\"ch-stat\"><b>${draft.count.recipients}</b><small>Destinataires</small></div><div class=\"ch-stat\"><b>${draft.count.devices}</b><small>Appareils inscrits</small></div></div><small class=\"ch-sub\">Nombre estimé actuellement. Le public est recalculé au moment de l’envoi.</small>${field('Envoi',select('timing',[['now','Maintenant'],['later','Programmer']],draft.timing))}${field('Date et heure de Djibouti (si programmé)',input('scheduled',draft.scheduled,'type=\"datetime-local\"'))}<div class=\"ch-actions\">${button('back','← Précédent')}<button class=\"ch-btn ch-primary\" type=\"submit\">Confirmer l’envoi</button></div></form>`;\n}\nfunction historyPage(){return `<div class=\"ch-actions\">${button('new','+ Nouvelle notification','ch-primary')}${button('inbox','Mes notifications')}</div>`+(history.length?paginate(history,n=>`<article class=\"ch-card\"><div class=\"ch-line\"><b>${E(kind(n.kind))}</b><small>${E(n.status==='queued'?'Programmé':n.status==='cancelled'?'Annulé':'Publié')}</small></div><b>${E(n.title)}</b><small>${E(date(n.scheduled_at))}</small><div class=\"ch-stats\"><div class=\"ch-stat\"><b>${n.recipients}</b><small>Boîtes</small></div><div class=\"ch-stat\"><b>${n.sent}</b><small>Push acceptés</small></div><div class=\"ch-stat\"><b>${n.reads}</b><small>Lectures</small></div></div><small class=\"ch-sub\">${n.pending} en attente · ${n.failed} échecs push</small>${n.status==='queued'?`<button class=\"ch-btn\" data-push=\"cancel\" data-id=\"${E(n.id)}\">Annuler l’envoi</button>`:''}</article>`):'<div class=\"ch-empty\">Aucune notification envoyée.</div>')}\nconst previousView=view;view=function(){reset();if(!on()||!st.user||st.screen!==roleScreen())return previousView();const legacy=previousView();return `<div class=\"ch-shell mbpush-shell\"><div class=\"ch-top\"><button class=\"ch-back\" data-act=\"goto\" data-to=\"${homes[st.role]}\">← Accueil</button>${button('refresh','Actualiser')}</div><h1>Notifications</h1>${error?`<div class=\"ch-error\" role=\"alert\">${E(error)}</div>`:''}${loading&&!inbox.items.length?'<p class=\"ch-sub\">Actualisation…</p>':''}${isAdmin()?(page==='create'?wizard():page==='inbox'?button('history','← Gestion')+inboxPage():historyPage()):inboxPage()}${(isAdmin()&&page==='history'||!isAdmin()&&!openId)?`<details class=\"ch-card mbpush-legacy\"><summary>Messages de classe et anciens messages</summary>${legacy}</details>`:''}</div>`};\nconst previousGo=go;go=function(s){reset();if(s===roleScreen()){page=isAdmin()?'history':'inbox';offset=0;openId=null;step=0;}const r=previousGo(s);if(s===roleScreen()&&st.screen===s)void refresh(true);return r};\nconst previousRender=render;render=function(){captureActiveForm();const r=previousRender();updateBell();return r};\nconst oldLoad=loadAll;loadAll=async function(){const r=await oldLoad();await refresh(true);incoming();return r};\nasync function unsubscribe(){const sub=await subscription();if(sub){try{if(!st.offlineSession&&navigator.onLine)await rpc('unsubscribe',{endpoint:sub.endpoint})}finally{await sub.unsubscribe()}}localStorage.removeItem('monbac-push-owner');enabled=false;}\nconst previousSignOut=signOut;signOut=async function(){try{if(st.user&&supported())await unsubscribe()}catch{/* Local unsubscribe attempted even when server is offline. */}return previousSignOut()};\nfunction bytes(key){return Uint8Array.from(atob(key.replace(/-/g,'+').replace(/_/g,'/').padEnd(Math.ceil(key.length/4)*4,'=')),c=>c.charCodeAt(0))}\nasync function enable(){if(!supported())throw Error('Les notifications push ne sont pas disponibles sur cet appareil.');const permitted=await Notification.requestPermission();if(permitted!=='granted')throw Error('Autorisez les notifications dans les réglages du téléphone.');const {key}=await rpc('key');if(!key)throw Error('Service de notifications en cours de préparation. Réessayez dans une minute.');const reg=await navigator.serviceWorker.ready;let sub=await reg.pushManager.getSubscription();if(!sub)sub=await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:bytes(key)});const j=sub.toJSON();try{await rpc('subscribe',{endpoint:j.endpoint,p256dh:j.keys.p256dh,auth:j.keys.auth});localStorage.setItem('monbac-push-owner',owner);enabled=true}catch(e){await sub.unsubscribe();throw e}}\nfunction captureAudience(f){for(const k of multiKeys)draft.audience[k]=f.getAll(k).map(String);if(f.has('user'))draft.audience.user=String(f.get('user')||'');draft.query=String(f.get('query')||'');}\nfunction captureForm(f){if(!f||!composing())return;const fd=new FormData(f);if(f.id==='mbPushContent'&&step===0){for(const k of ['kind','title','body','image','destination'])draft[k]=String(fd.get(k)??'');}else if(f.id==='mbPushAudience'&&step===1){captureAudience(fd);}else if(f.id==='mbPushSend'&&step===2){draft.timing=String(fd.get('timing')??'now');draft.scheduled=String(fd.get('scheduled')??'');}}\nfunction captureActiveForm(){if(!composing())return;captureForm(document.getElementById(['mbPushContent','mbPushAudience','mbPushSend'][step]));}\nfunction rememberField(e){const f=e.target.closest?.('#mbPushContent,#mbPushAudience,#mbPushSend');if(!f||!composing())return;captureForm(f);if(f.id==='mbPushAudience'){const filter=e.target.closest('[data-filter]');if(filter)filter.querySelector('[data-filter-count]').textContent=selectionLabel(draft.audience[filter.dataset.filter].length);}}\ndocument.addEventListener('input',rememberField,true);\ndocument.addEventListener('change',rememberField,true);\ndocument.addEventListener('submit',async e=>{const f=e.target;if(!on()||!isAdmin()||!['mbPushContent','mbPushAudience','mbPushSend'].includes(f.id))return;e.preventDefault();e.stopImmediatePropagation();if(busy)return;busy=true;error='';try{const fd=new FormData(f);if(f.id==='mbPushContent'){for(const k of ['kind','title','body','image','destination'])draft[k]=String(fd.get(k)||'').trim();if(!draft.title||!draft.body)throw Error('Renseignez le titre et le message.');step=1}else if(f.id==='mbPushAudience'){captureAudience(fd);draft.count=await rpc('count',{audience:draft.audience});step=2}else{draft.timing=String(fd.get('timing'));draft.scheduled=String(fd.get('scheduled'));if(draft.timing==='later'&&!draft.scheduled)throw Error('Choisissez une date.');if(draft.timing==='later'&&Date.parse(draft.scheduled+':00+03:00')<=Date.now())throw Error('Choisissez une date future.');if(!await window.MBDialog.confirm(`Confirmer cette notification pour ${draft.count.recipients} destinataire(s) estimé(s) ?`))return;await rpc('create',{...draft,scheduled_at:draft.timing==='later'?draft.scheduled+':00+03:00':null});page='history';offset=0;draft=null;await refresh(true);toast('Notification enregistrée. Envoi automatique à l’heure choisie.')} }catch(err){error=err.message}finally{busy=false;render()}},true);\ndocument.addEventListener('click',async e=>{const b=e.target.closest?.('[data-push]');if(!b||!on()||!st.user)return;e.preventDefault();e.stopImmediatePropagation();if(busy)return;captureActiveForm();busy=true;error='';try{const a=b.dataset.push;if(a==='enable'){await enable();await refresh(true)}else if(a==='disable'){await unsubscribe();await refresh(true)}else if(a==='refresh')await refresh(true);else if(a==='read-all'){await rpc('read_all');await refresh(true)}else if(a==='open'){openId=b.dataset.id;await rpc('read',{id:openId});await refresh(true)}else if(a==='back-inbox')openId=null;else if(a==='destination'){const item=inbox.items.find(n=>n.id===openId);if(item)navigateDestination(item.destination)}else if(a==='previous')offset=Math.max(0,offset-4);else if(a==='next'){const items=page==='history'&&isAdmin()?history:inbox.items;offset=Math.min(Math.max(0,Math.floor((items.length-1)/4)*4),offset+4)}else if(isAdmin()){if(a==='new'){draft={kind:'information',title:'',body:'',image:'',destination:'inbox',audience:{role:[],school:[],series:[],level:[],class:[],user:''},query:'',count:{},timing:'now',scheduled:''};found=[];step=0;page='create'}else if(a==='back'){if(step>0)step--;else page='history'}else if(a==='history'||a==='inbox'){page=a;offset=0;openId=null}else if(a==='search'){const form=document.querySelector('#mbPushAudience');captureAudience(new FormData(form));found=await rpc('search',{q:draft.query});if(!found.length)throw Error('Aucun utilisateur trouvé.')}else if(a==='cancel'){if(await window.MBDialog.confirm('Annuler cet envoi programmé ?')){await rpc('cancel',{id:b.dataset.id});await refresh(true)}}}}catch(err){error=err.message}finally{busy=false;if(on())render()}},true);\nfunction incoming(){if(!st.user||!st.loaded)return;const u=new URL(location.href),id=u.searchParams.get('notification');if(!id||!(/^[0-9a-f-]{36}$/i.test(id)))return;u.searchParams.delete('notification');window.history.replaceState(null,'',u.href);go(roleScreen());page='inbox';openId=id;void rpc('read',{id}).then(()=>refresh(true)).catch(()=>{});render()}\nwindow.addEventListener('focus',()=>{if(!composing()){void refresh(true);incoming()}});document.addEventListener('visibilitychange',()=>{if(!document.hidden&&!composing()){void refresh(true);incoming()}});setInterval(()=>{if(st.user&&!document.hidden&&!composing()){void refresh();incoming()}},30000);\nif(navigator.serviceWorker)navigator.serviceWorker.addEventListener('message',e=>{if(e.data?.type==='monbac-push-click'){const u=new URL(location.href);u.searchParams.set('notification',e.data.id);window.history.replaceState(null,'',u.href);incoming()}});\nwindow.MBPush={refresh,enable,unsubscribe};\n})();\n"],"/mon-bac-push.css":["text/css; charset=utf-8",false,".mbpush-shell .ch-card{display:grid;gap:10px}.mbpush-shell .ch-card h2,.mbpush-shell .ch-card p{margin:0}.mbpush-shell .mbpush-device{grid-template-columns:minmax(0,1fr) auto;align-items:center}.mbpush-device .ch-btn{min-width:100px}.mbpush-row{margin:7px 0}.mbpush-row span{min-width:0}.mbpush-row b,.mbpush-row small{overflow-wrap:anywhere}.mbpush-dot{display:inline-block;background:#c8102e;width:8px;height:8px;border-radius:50%;vertical-align:middle}.mbpush-image{width:100%;max-height:200px;object-fit:contain;border-radius:12px}.mbpush-body{white-space:pre-wrap;overflow-wrap:anywhere}.mbpush-brand{display:flex;align-items:center;gap:8px}.mbpush-brand img{width:34px;height:34px;border-radius:9px}.mbpush-brand small{margin-left:auto;color:#667085}.mbpush-preview{background:#fff5f6;border:1px solid #efd1d8}.mbpush-legacy summary{cursor:pointer;font-weight:600;color:#a60c2b}.mbpush-shell .ch-btn{white-space:normal;min-height:44px}.mbpush-shell textarea{width:100%;resize:vertical}.mbpush-shell .ch-field input,.mbpush-shell .ch-field select{min-width:0;width:100%}.mbpush-shell .ch-card small{overflow-wrap:anywhere}@media(max-width:360px){.mbpush-shell .mbpush-device{grid-template-columns:1fr}.mbpush-shell .ch-stats{grid-template-columns:repeat(2,minmax(0,1fr))}}\n.mbpush-filter{border:1px solid #e3e5e9;border-radius:12px;background:#fff;min-width:0}.mbpush-filter summary{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:11px 12px;cursor:pointer;list-style:none;min-height:44px}.mbpush-filter summary::-webkit-details-marker{display:none}.mbpush-filter summary span{color:#a60c2b;font-size:13px;text-align:right}.mbpush-filter summary span::after{content:' ▾'}.mbpush-filter[open] summary span::after{content:' ▴'}.mbpush-options{display:grid;gap:4px;max-height:168px;overflow:auto;padding:2px 12px 8px}.mbpush-options label{display:flex;gap:10px;align-items:center;min-height:40px;cursor:pointer;overflow-wrap:anywhere}.mbpush-options input[type=checkbox]{width:19px;height:19px;flex:0 0 19px;accent-color:#c8102e}.mbpush-filter>small{display:block;padding:0 12px 10px;color:#667085}.mbpush-filter:not([open])>small{display:none}\n"],"/mon-bac-interactive.js":["text/javascript; charset=utf-8",false,"/* monAvenir — exercices interactifs, avec correction IA facultative et quota gratuit. */\n(()=>{'use strict';\nconst E=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst A=(name,value)=>`data-i-act=\"${name}\"${value==null?'':` data-i-value=\"${E(value)}\"`}`;\nconst B=(name,label,value,primary=false)=>`<button type=\"button\" class=\"mbi-button ${primary?'mbi-primary':''}\" ${A(name,value)}>${E(label)}</button>`;\nconst select=(key,values,current)=>`<select data-i-field=\"${key}\">${values.map(v=>`<option ${String(v)===String(current)?'selected':''}>${E(v)}</option>`).join('')}</select>`;\nconst field=(label,html)=>`<label class=\"mbi-field\"><span>${E(label)}</span>${html}</label>`;\nconst input=(key,value,placeholder='',type='text')=>`<input type=\"${type}\" data-i-field=\"${key}\" value=\"${E(value)}\" placeholder=\"${E(placeholder)}\">`;\nconst area=(key,value,placeholder='')=>`<textarea rows=\"3\" lang=\"fr\" spellcheck=\"true\" autocorrect=\"on\" autocapitalize=\"sentences\" data-i-field=\"${key}\" placeholder=\"${E(placeholder)}\">${E(value)}</textarea>`;\nconst newQuestion=()=>({type:'text',prompt:'',points:1,answer:'',hint:'',options:['',''],columns:['Libellé','Montant'],rows:['Ligne 1']});\nconst types={text:'Réponse rédigée',number:'Calcul / nombre',choice:'QCM (un choix)',table:'Tableau à compléter'};\nconst status={draft:'Brouillon',pending:'À valider',published:'Publié',review:'À corriger',graded:'Corrigé'};\nlet m={};let root=null;let uid=null;let previousFocus=null;let busy=false;\nconst teacher=()=>st.role==='enseignant'||st.role==='admin';\nconst call=async(action,data={})=>{if(st.user?.id!==uid)throw Error('Reconnectez-vous.');const r=await st.db.rpc('mon_bac_interactive',{p_action:action,p_data:data});if(r.error)throw Error(r.error.message);return r.data;};\nconst key=(kind,id='new')=>`monbac-interactive:${uid}:${kind}:${id}`;\nconst read=(kind,id)=>{try{return JSON.parse(localStorage.getItem(key(kind,id))||'null')}catch{return null}};\nconst write=(kind,id,value)=>{try{localStorage.setItem(key(kind,id),JSON.stringify(value))}catch{}};\nconst remove=(kind,id)=>{try{localStorage.removeItem(key(kind,id))}catch{}};\nconst persist=()=>{if(m.page==='edit')write('editor',m.exercise.id||'new',{exercise:m.exercise,step:m.step,index:m.index});if(m.page==='play')write('attempt',m.exercise.id,{answers:m.answers,index:m.index});};\nconst close=()=>{persist();root?.remove();root=null;document.documentElement.classList.remove('mbi-open');previousFocus?.focus?.();};\nconst show=async()=>{if(root)return;uid=st.user?.id;if(!uid)return;previousFocus=document.activeElement;m={page:'list',rows:[],loading:true,filter:''};root=document.createElement('div');root.id='mbi-root';root.setAttribute('role','dialog');root.setAttribute('aria-modal','true');root.setAttribute('aria-label','Exercices interactifs');document.body.append(root);document.documentElement.classList.add('mbi-open');root.addEventListener('click',click);root.addEventListener('input',change);root.addEventListener('change',change);root.addEventListener('keydown',ev=>{if(ev.key==='Escape'&&!busy)close()});draw();await reload();};\nasync function reload(){m.page='list';m.loading=true;draw();try{m.rows=await call('list');m.specialties=teacher()?await call('specialties'):[];m.error='';}catch(e){m.error=e.message}finally{m.loading=false;draw()}}\nconst badge=s=>`<span class=\"mbi-badge\">${E(status[s]||s)}</span>`;\nconst progress=(n,total)=>`<div class=\"mbi-progress\" aria-label=\"Étape ${n} sur ${total}\"><i style=\"width:${n/total*100}%\"></i></div>`;\nfunction list(){let rows=m.rows.filter(x=>!m.filter||x.subject===m.filter);let subjects=[...new Set(m.rows.map(x=>x.subject))];return `<div class=\"mbi-intro\"><h2>${teacher()?'Mes exercices':'À vous de jouer !'}</h2><p>${teacher()?'Créez, publiez et corrigez les activités.':'Entraînez-vous à votre rythme, question par question.'}</p></div>${teacher()?B('new','＋  Créer un exercice',null,true):''}${subjects.length?field('Matière',`<select data-i-field=\"filter\"><option value=\"\">Toutes les matières</option>${subjects.map(s=>`<option ${s===m.filter?'selected':''}>${E(s)}</option>`).join('')}</select>`):''}${m.loading?'<p>Chargement…</p>':!rows.length?'<div class=\"mbi-empty\">Aucun exercice pour le moment.</div>':rows.map(x=>`<button class=\"mbi-item\" ${A('open',x.id)}><span><small>${E(x.subject)} · ${E(x.series)} · ${E(x.academic_level)}</small><strong>${E(x.title)}</strong><small>${x.question_count} question(s) · ${x.mode==='exam'?'Évaluation':'Entraînement'}</small></span>${teacher()?badge(x.status):x.attempt?badge(x.attempt.status):'<span class=\"mbi-arrow\">›</span>'}</button>`).join('')}`}\nfunction editor(){let e=m.exercise,q=e.questions[m.index];let bar=progress(m.step+1,3);if(m.step===0){let specs=m.specialties||[],specific=st.role!=='admin';return `${bar}<h2>1. Le sujet</h2>${specific?field('Classe et matière',`<select data-i-field=\"specialty\">${specs.map((s,i)=>`<option value=\"${i}\" ${s.series===e.series&&s.academic_level===e.academic_level&&s.subject===e.subject?'selected':''}>${E(s.academic_level+' '+s.series+' · '+s.subject)}</option>`).join('')}</select>`):field('Série',select('series',['GFM','OGRH','IAG','S','ES','L'],e.series))+field('Niveau',select('academic_level',['Première','Terminale'],e.academic_level))+field('Matière',input('subject',e.subject,'Ex. Gestion financière'))}${field('Titre',input('title',e.title,'Ex. Facture avec remise'))}${field('Consignes / contexte',area('instructions',e.instructions,'Saisir ou coller le sujet'))}${field('Mode',`<select data-i-field=\"mode\"><option value=\"training\" ${e.mode==='training'?'selected':''}>Entraînement</option><option value=\"exam\" ${e.mode==='exam'?'selected':''}>Évaluation</option></select>`)}`}\nif(m.step===1)return `${bar}<div class=\"mbi-row\"><h2>2. Question ${m.index+1}/${e.questions.length}</h2>${badge(e.questions.length+' bloc(s)')}</div>${field('Type',`<select data-i-field=\"q.type\">${Object.entries(types).map(([k,v])=>`<option value=\"${k}\" ${q.type===k?'selected':''}>${E(v)}</option>`).join('')}</select>`)}${field('Énoncé',area('q.prompt',q.prompt,'Écrire la question'))}${field('Barème (points)',input('q.points',q.points,'1','number'))}${q.type==='choice'?field('Choix (un par ligne)',area('q.options',(q.options||[]).join('\\n')))+field('Bonne réponse (recopier un choix)',input('q.answer',q.answer)):q.type==='table'?field('Colonnes (une par ligne)',area('q.columns',(q.columns||[]).join('\\n')))+field('Lignes (une par ligne)',area('q.rows',(q.rows||[]).join('\\n')))+`<div class=\"mbi-row\">${B('template','Facture','invoice')}${B('template','Journal 5 colonnes','journal')}</div>`+field('Corrigé de référence (enseignant)',area('q.answer',q.answer)):field(q.type==='number'?'Réponse numérique':'Réponse attendue / critères',q.type==='number'?input('q.answer',q.answer,'Ex. 512050'):area('q.answer',q.answer,'Les autres formulations seront à vérifier'))}${e.mode==='training'?field('Indice (facultatif)',area('q.hint',q.hint)):''}<div class=\"mbi-row\">${B('qprev','‹ Précédente')}${B('qnext','Suivante ›')}${B('add','＋ Question')}${e.questions.length>1?B('deleteq','Retirer'):''}</div>`;\nreturn `${bar}<h2>3. Vérification</h2><div class=\"mbi-notice\"><strong>${E(e.title||'Sans titre')}</strong><p>${E(e.academic_level+' '+e.series+' · '+e.subject)}</p><p>${e.questions.length} question(s) · ${e.questions.reduce((s,q)=>s+Number(q.points||0),0)} points</p></div>${e.questions.map((q,i)=>`<button class=\"mbi-item\" ${A('editq',i)}><span><strong>${i+1}. ${E(q.prompt||'Question vide')}</strong><small>${E(types[q.type])} · ${E(q.points)} pt</small></span><span>›</span></button>`).join('')}<p class=\"mbi-muted\">Les copies rédigées et les tableaux sont contrôlés par l’enseignant. Aucune IA payante n’est utilisée.</p>`}\nfunction play(){let e=m.exercise,q=e.questions[m.index],v=m.answers[m.index];let control;if(q.type==='choice')control=(q.options||[]).map(o=>`<label class=\"mbi-choice\"><input type=\"radio\" name=\"mbi-answer\" data-i-field=\"answer\" value=\"${E(o)}\" ${v===o?'checked':''}><span>${E(o)}</span></label>`).join('');else if(q.type==='table')control=`<div class=\"mbi-table-wrap\"><table class=\"mbi-table\"><thead><tr><th>Ligne</th>${q.columns.map(c=>`<th>${E(c)}</th>`).join('')}</tr></thead><tbody>${q.rows.map((r,i)=>`<tr><th>${E(r)}</th>${q.columns.map((c,j)=>`<td><input aria-label=\"${E(r+' '+c)}\" data-i-field=\"cell:${i}:${j}\" value=\"${E(v?.[i]?.[j]||'')}\"></td>`).join('')}</tr>`).join('')}</tbody></table></div>`;else control=field('Votre réponse',q.type==='number'?input('answer',v,'Saisir le résultat','text'):area('answer',v,'Rédigez votre réponse…'));\nreturn `${progress(m.index+1,e.questions.length)}<div class=\"mbi-row\"><span class=\"mbi-muted\">Question ${m.index+1} / ${e.questions.length}</span>${badge(q.points+' pt')}</div>${e.instructions?`<details class=\"mbi-notice\"><summary>Consignes et contexte</summary><p>${E(e.instructions)}</p></details>`:''}<h2 data-mbl-original dir=\"auto\">${E(q.prompt)}</h2>${control}${q.hint?`<details class=\"mbi-notice\"><summary>💡 Voir un indice</summary><p>${E(q.hint)}</p></details>`:''}${q.type==='number'?`<details class=\"mbi-notice\"><summary>Calculatrice</summary><div class=\"mbi-row\"><input data-i-field=\"calcA\" inputmode=\"decimal\" placeholder=\"Nombre\"><select data-i-field=\"calcOp\"><option>+</option><option>−</option><option>×</option><option>÷</option></select><input data-i-field=\"calcB\" inputmode=\"decimal\" placeholder=\"Nombre\">${B('calc','=')}</div><output id=\"mbi-calc\"></output></details>`:''}<small class=\"mbi-muted\">Votre progression est enregistrée sur cet appareil.</small>`}\nfunction detail(){let e=m.exercise;return `<h2 data-mbl-original dir=\"auto\">${E(e.title)}</h2><p>${E(e.academic_level+' '+e.series+' · '+e.subject)}</p>${badge(e.status)}<div class=\"mbi-notice\"><p>${E(e.instructions||'Aucune consigne supplémentaire.')}</p><strong>${e.questions.length} questions</strong></div>${e.questions.map((q,i)=>`<div class=\"mbi-item\"><span><strong>${i+1}. ${E(q.prompt)}</strong><small>${E(types[q.type])} · ${q.points} pt</small></span></div>`).join('')}${e.status==='published'?B('attempts','Voir les copies',null,true):''}`}\nfunction result(){let r=m.result;return `<div class=\"mbi-result\"><span>${r.status==='review'?'Score provisoire':'Résultat'}</span><strong>${E(r.score)} / ${E(r.total)}</strong><p>${r.status==='review'?'Certaines réponses attendent la correction de votre enseignant.':'Votre exercice a été corrigé.'}</p></div>${r.grades?.map((g,i)=>`<div class=\"mbi-item\"><span>Question ${i+1}</span>${badge(g==null?'À vérifier':`${g} pt`)}</div>`).join('')||''}`}\nfunction attempts(){return `<h2>Copies reçues</h2>${m.attempts.length?m.attempts.map(a=>`<button class=\"mbi-item\" ${A('review',a.id)}><span><strong>${E(a.full_name||'Élève')}</strong><small>${a.score}/${a.total} · ${E(status[a.status])}</small></span><span>›</span></button>`).join(''):'<div class=\"mbi-empty\">Aucune copie reçue.</div>'}`}\nfunction review(){let a=m.attempt,q=m.exercise.questions[m.index],v=a.answers[m.index];return `${progress(m.index+1,m.exercise.questions.length)}<h2>${E(a.full_name||'Élève')} · Question ${m.index+1}</h2><p>${E(q.prompt)}</p><div class=\"mbi-notice\"><strong>Réponse élève</strong><p>${E(Array.isArray(v)?v.map(row=>Array.isArray(row)?row.join(' | '):row).join('\\n'):v||'Sans réponse')}</p></div><div class=\"mbi-notice\"><strong>Réponse attendue</strong><p>${E(q.answer||'À apprécier')}</p></div>${field('Note sur '+q.points,input('grade',m.grades[m.index]??'','0','number'))}`}\nfunction draw(){if(!root)return;let content='',footer='';switch(m.page){case'list':content=list();break;case'edit':content=editor();footer=B('back',m.step===0?'Mes exercices':'‹ Retour')+(m.step<2?B('next','Continuer ›',null,true):B('save','Enregistrer',null,true));break;case'play':content=play();footer=B('playprev',m.index===0?'Quitter':'‹ Retour')+B(m.index===m.exercise.questions.length-1?'submit':'playnext',m.index===m.exercise.questions.length-1?'Envoyer':'Suivant ›',null,true);break;case'detail':content=detail();footer=B('list','‹ Retour')+(m.exercise.status==='draft'?B('edit','Modifier'):'')+(m.exercise.status==='draft'||m.exercise.status==='pending'&&st.role==='admin'?B('publish',st.role==='admin'?'Publier':'Soumettre',null,true):'')+(m.exercise.status==='pending'&&st.role==='admin'?B('return','Renvoyer'):'');break;case'result':content=result();footer=B('list','Mes exercices',null,true);break;case'attempts':content=attempts();footer=B('detail','‹ Retour');break;case'review':content=review();footer=B('rprev',m.index?'‹ Retour':'Copies')+B(m.index===m.exercise.questions.length-1?'grade':'rnext',m.index===m.exercise.questions.length-1?'Valider les notes':'Suivant ›',null,true);break;}\nroot.innerHTML=`<div class=\"mbi-shell\"><header class=\"mbi-header\"><button class=\"mbi-close\" ${A('close')} aria-label=\"Fermer\">‹</button><div><strong>Exercices interactifs</strong><small>monAvenir</small></div><span class=\"mbi-logo\">MB</span></header><main class=\"mbi-main\">${m.error?`<div class=\"mbi-error\" role=\"alert\">${E(m.error)}</div>`:''}${content}</main>${footer?`<footer class=\"mbi-footer\">${footer}</footer>`:''}</div>`;if(busy)root.querySelectorAll('button').forEach(b=>b.disabled=true);}\nfunction change(ev){let k=ev.target.dataset.iField;if(!k)return;let v=ev.target.value;if(k==='filter'){m.filter=v;draw();return}if(k==='specialty'){Object.assign(m.exercise,m.specialties[Number(v)]);persist();return}if(k.startsWith('q.')){let q=m.exercise.questions[m.index],p=k.slice(2);q[p]=['options','columns','rows'].includes(p)?v.split('\\n'):p==='points'?v:v;if(p==='type'){q.answer='';if(v==='choice')q.options=['',''];draw()}persist();return}if(k==='answer'){m.answers[m.index]=v;persist();return}if(k.startsWith('cell:')){let [,i,j]=k.split(':').map((x,n)=>n?Number(x):x);let q=m.exercise.questions[m.index];if(!Array.isArray(m.answers[m.index]))m.answers[m.index]=q.rows.map(()=>q.columns.map(()=>''));m.answers[m.index][i][j]=v;persist();return}if(k==='grade'){m.grades[m.index]=v===''?null:Number(v);return}if(k.startsWith('calc'))return;if(m.page==='edit'){m.exercise[k]=v;persist()}}\nfunction validQuestion(q){if(!q.prompt.trim()||!(Number(q.points)>0&&Number(q.points)<=100))throw Error('Complétez l’énoncé et le barème.');if(q.type==='number'&&!/^[+-]?\\d+(\\.\\d+)?$/.test(String(q.answer).replace(',','.')))throw Error('Saisissez une réponse numérique valide.');if(q.type==='choice'){q.options=q.options.map(x=>x.trim()).filter(Boolean);q.answer=q.answer.trim();if(q.options.length<2||!q.options.includes(q.answer))throw Error('Ajoutez au moins deux choix et une bonne réponse identique à un choix.')}if(q.type==='table'){q.columns=q.columns.map(x=>x.trim()).filter(Boolean);q.rows=q.rows.map(x=>x.trim()).filter(Boolean);if(!q.columns.length||!q.rows.length)throw Error('Complétez les colonnes et lignes du tableau.')}q.points=Number(q.points);if(q.type==='number')q.answer=String(q.answer).replace(',','.');}\nasync function click(ev){const btn=ev.target.closest('[data-i-act]');if(!btn||busy)return;let a=btn.dataset.iAct,v=btn.dataset.iValue;m.error='';if(a==='close'){close();return}if(a==='calc'){let get=k=>root.querySelector(`[data-i-field=\"${k}\"]`).value;let x=Number(get('calcA').replace(',','.')),y=Number(get('calcB').replace(',','.')),op=get('calcOp');let res=op==='+'?x+y:op==='−'?x-y:op==='×'?x*y:x/y;root.querySelector('#mbi-calc').textContent=Number.isFinite(res)?String(res):'Calcul impossible';return}busy=true;try{switch(a){case'list':await reload();break;case'new':{if(st.role==='enseignant'&&!m.specialties.length)throw Error('Aucune matière approuvée. Contactez l’administration.');let old=read('editor','new');m.exercise=old?.exercise||{title:'',series:'GFM',academic_level:'Terminale',subject:'',instructions:'',mode:'training',questions:[newQuestion()],...(m.specialties[0]||{})};m.step=old?.step||0;m.index=old?.index||0;m.page='edit';break}case'open':{m.exercise=await call('open',{id:v});if(teacher()){m.page='detail'}else{if(m.rows.find(x=>x.id===v)?.attempt){m.result=await call('result',{id:v});m.page='result'}else{let draft=read('attempt',v);m.answers=draft?.answers||m.exercise.questions.map(()=>null);m.index=Math.min(draft?.index||0,m.exercise.questions.length-1);m.page='play'}}break}case'edit':{let d=read('editor',m.exercise.id);if(d)m.exercise=d.exercise;m.step=d?.step||0;m.index=d?.index||0;m.page='edit';break}case'back':if(m.step>0)m.step--;else{persist();await reload()}break;case'next':if(m.step===0&&(!m.exercise.title.trim()||!m.exercise.subject.trim()))throw Error('Indiquez le titre et la matière.');if(m.step===1)m.exercise.questions.forEach(validQuestion);m.step++;break;case'editq':m.index=Number(v);m.step=1;break;case'qprev':m.index=Math.max(0,m.index-1);break;case'qnext':m.index=Math.min(m.exercise.questions.length-1,m.index+1);break;case'add':validQuestion(m.exercise.questions[m.index]);if(m.exercise.questions.length>=50)throw Error('50 questions maximum.');m.exercise.questions.push(newQuestion());m.index=m.exercise.questions.length-1;break;case'deleteq':m.exercise.questions.splice(m.index,1);m.index=Math.max(0,m.index-1);break;case'template':{let q=m.exercise.questions[m.index];if(v==='invoice'){q.columns=['Montant (FDJ)'];q.rows=['Montant brut HT','Remise','Net commercial HT','Escompte','Net financier HT','TVA','Net à payer TTC']}else{q.columns=['Débit (compte)','Crédit (compte)','Date / intitulé','Débit (FDJ)','Crédit (FDJ)'];q.rows=['Écriture 1','Écriture 2','Écriture 3','Écriture 4']};break}case'save':{m.exercise.questions.forEach(validQuestion);let old=m.exercise.id||'new';let r=await call('save',m.exercise);remove('editor',old);m.exercise=await call('open',{id:r.id});m.page='detail';break}case'publish':if(!confirm(st.role==='admin'?'Publier pour cette série et ce niveau ?':'Envoyer à l’administrateur pour validation ?'))break;await call('publish',{id:m.exercise.id});await reload();break;case'return':await call('return',{id:m.exercise.id});await reload();break;case'playprev':if(m.index>0)m.index--;else{persist();await reload()}break;case'playnext':m.index++;break;case'submit':if(!confirm('Envoyer définitivement votre copie ?'))break;m.result=await call('submit',{id:m.exercise.id,answers:m.answers});remove('attempt',m.exercise.id);m.page='result';break;case'attempts':m.attempts=await call('attempts',{id:m.exercise.id});m.page='attempts';break;case'detail':m.page='detail';break;case'review':m.attempt=m.attempts.find(x=>x.id===v);m.grades=[...m.attempt.grades];m.index=0;m.page='review';break;case'rprev':if(m.index>0)m.index--;else m.page='attempts';break;case'rnext':if(m.grades[m.index]==null)throw Error('Indiquez une note.');m.index++;break;case'grade':if(m.grades.some((g,i)=>g==null||!Number.isFinite(g)||g<0||g>Number(m.exercise.questions[i].points)))throw Error('Vérifiez toutes les notes et les barèmes.');await call('grade',{id:m.exercise.id,attempt_id:m.attempt.id,grades:m.grades});m.attempts=await call('attempts',{id:m.exercise.id});m.page='attempts';break;}persist()}catch(e){m.error=e.message||'Une erreur est survenue. Réessayez.'}finally{busy=false;draw()}}\nfunction mount(){if(root&&st.user?.id!==uid){close();return}if(!st.user||!['eleve','enseignant','admin'].includes(st.role)||!['student-home','teacher-home','admin-home'].includes(st.screen)||st.role==='enseignant'&&st.teacher?.status!=='approved')return;let tiles=document.querySelector('#app .mb-tiles');if(!tiles||tiles.querySelector('[data-mbi-launch]'))return;let b=document.createElement('button');b.type='button';b.className='mb-tile mbi-launch';b.dataset.mbiLaunch='1';b.innerHTML='<span class=\"mbi-launch-icon\" aria-hidden=\"true\">✎</span><span>Exercices interactifs</span>';b.addEventListener('click',show);tiles.prepend(b)}\n// Preserve existing wizard state while importing documents and illustrations.\nconst originalDraw=draw;\nfunction importImage(q,host,editable){if(!q?.image||!/^data:image\\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(q.image))return;const box=document.createElement('div');box.className='mbi-import-image';const img=document.createElement('img');img.src=q.image;img.alt='Document de la question';img.loading='lazy';box.append(img);const link=document.createElement('button');link.className='mbi-button';link.type='button';link.textContent='Agrandir le document';link.onclick=()=>{const d=document.createElement('dialog');d.className='mbi-image-dialog';const big=img.cloneNode();const b=document.createElement('button');b.type='button';b.className='mbi-button';b.textContent='Fermer';b.onclick=()=>d.close();d.append(b,big);document.body.append(d);d.addEventListener('close',()=>d.remove(),{once:true});d.showModal()};box.append(link);if(editable){const b=document.createElement('button');b.type='button';b.className='mbi-button';b.textContent='Retirer l’image';b.onclick=()=>{delete q.image;persist();draw()};box.append(b)}host.after(box)}\ndraw=function(){originalDraw();if(!root||!window.MBIImport)return;const main=root.querySelector('.mbi-main');if(!main)return;const e=m.exercise,q=e?.questions?.[m.index];if(m.page==='edit'&&(m.step===0||m.step===1)){const stage=m.step;const field=main.querySelector(stage===0?'[data-i-field=\"instructions\"]':'[data-i-field=\"q.prompt\"]');if(!field)return;const container=document.createElement('div');container.innerHTML=MBIImport.panel(stage);const panel=container.firstElementChild;field.closest('label').before(panel);MBIImport.attach(root,stage,{text(t){t=t.trim();const limit=stage===0?30000:5000;if(t.length>limit)throw Error('Le texte dépasse '+limit+' caractères. Réduisez l’aperçu avant de l’insérer.');const previous=stage===0?e.instructions:q.prompt;if(previous&&previous.trim()&&!confirm('Remplacer le texte actuel par le document importé ?'))return;if(stage===0)e.instructions=t;else q.prompt=t;persist();draw()},questions(list){const existing=e.questions.filter(x=>x.prompt.trim());if(existing.length+list.length>50)throw Error('Maximum 50 questions.');e.questions=[...existing,...list.map(prompt=>({...newQuestion(),prompt}))];m.step=1;m.index=existing.length;persist();draw()},correction(t){if(!q)throw Error('Aucune question sélectionnée.');if(t.length>20000)throw Error('Corrigé trop long.');if(q.answer&&!confirm('Remplacer le corrigé actuel ?'))return;q.answer=t.trim();persist();draw()},image(data){if(q.image&&!confirm('Remplacer l’illustration actuelle ?'))return;q.image=data;persist();draw()}});if(stage===1)importImage(q,panel,true)}else if(m.page==='play'||m.page==='review'){const anchor=main.querySelector('h2');if(anchor)importImage(q,anchor,false)}};\n\n// Optional teacher-controlled AI: private, bounded, and no automatic grading.\nconst drawBeforeAI=draw;\ndraw=function(){\n drawBeforeAI();\n if(!root||m.page!=='review'||!teacher())return;\n const q=m.exercise?.questions?.[m.index],answer=m.attempt?.answers?.[m.index],grade=root.querySelector('[data-i-field=\"grade\"]');\n if(!q||q.type!=='text'||!grade||q.image||!String(q.answer||'').trim()||typeof answer!=='string'||!answer.trim()||[q.prompt,q.answer,answer].some(x=>String(x).length>1400))return;\n const languageCode=(document.documentElement.lang||'fr').toLowerCase().slice(0,2), tr=(fr,en,ar)=>languageCode==='ar'?ar:languageCode==='en'?en:fr;\n const state=m,sessionUid=uid,idx=m.index,attempt=m.attempt.id,exercise=m.exercise.id,key=attempt+':'+idx;\n const cache=state.aiResults||(state.aiResults={});\n const box=document.createElement('section');box.className='mbi-ai';box.dir=languageCode==='ar'?'rtl':'ltr';\n const label=document.createElement('div');label.className='mbi-ai-heading';label.textContent=tr('✦ Correction assistée par IA','✦ AI-assisted grading','✦ التصحيح بمساعدة الذكاء الاصطناعي');\n const small=document.createElement('small');small.textContent=tr('Suggestion uniquement. Vous gardez la décision finale.','Suggestion only. You make the final decision.','اقتراح فقط. القرار النهائي لك.');\n const statusEl=document.createElement('div');statusEl.setAttribute('aria-live','polite');statusEl.className='mbi-ai-status';\n const button=document.createElement('button');button.type='button';button.className='mbi-button mbi-ai-action';button.textContent=tr('Analyser la réponse','Analyze answer','تحليل الإجابة');\n const result=document.createElement('div');result.className='mbi-ai-result';result.hidden=true;\n box.append(label,small,button,statusEl,result);grade.closest('label').before(box);\n const current=()=>root&&m===state&&uid===sessionUid&&st.user?.id===sessionUid&&m.page==='review'&&m.attempt?.id===attempt&&m.index===idx;\n function render(value){\n  result.replaceChildren();result.hidden=false;button.hidden=true;statusEl.textContent='';button.disabled=false;\n  const heading=document.createElement('strong');heading.textContent=tr('Note proposée : ','Suggested mark: ','الدرجة المقترحة: ')+value.score+' / '+value.points;\n  const reason=document.createElement('p');reason.textContent=value.explanation;\n  const lang=document.createElement('p');const title=document.createElement('strong');title.textContent=tr('Orthographe et grammaire : ','Spelling and grammar: ','الإملاء والنحو: ');lang.append(title,document.createTextNode(value.language));\n  const apply=document.createElement('button');apply.type='button';apply.className='mbi-button mbi-primary';apply.textContent=tr('Utiliser cette note','Use this mark','استخدام هذه الدرجة');\n  apply.onclick=()=>{if(!current())return;const field=root.querySelector('[data-i-field=\"grade\"]');if(!field)return;m.grades[idx]=value.score;field.value=String(value.score);statusEl.textContent=tr('Note proposée reportée. Validez la copie à la fin.','Suggested mark entered. Validate the submission at the end.','تم إدخال الدرجة المقترحة. اعتمد التصحيح في النهاية.')};\n  const quota=document.createElement('small');quota.textContent=Number.isInteger(value.remaining)?tr('Analyses restantes aujourd’hui : ','Analyses remaining today: ','التحليلات المتبقية اليوم: ')+value.remaining:'';\n  result.append(heading,reason,lang,apply,quota);\n }\n if(cache[key]?.data){render(cache[key].data);return}\n if(cache[key]?.pending){button.disabled=true;statusEl.textContent=tr('Analyse en cours…','Analyzing…','جارٍ التحليل…')}\n button.onclick=async()=>{\n   if(!current()||busy||cache[key]?.pending)return;\n   if(!confirm(tr('Seuls l’énoncé, le corrigé et la réponse seront analysés par Cloudflare. Vérifiez qu’ils ne contiennent aucune information personnelle ou sensible. Continuer ?','Cloudflare will analyze only the question, expected answer and student answer. Confirm they contain no personal or sensitive information. Continue?','سيحلل Cloudflare السؤال والإجابة النموذجية وإجابة الطالب فقط. تأكد من خلوها من المعلومات الشخصية أو الحساسة. هل تريد المتابعة؟')))return;\n   cache[key]={pending:true};button.disabled=true;statusEl.textContent=tr('Analyse en cours…','Analyzing…','جارٍ التحليل…');\n   try{\n    const {data,error}=await st.db.auth.getSession();if(error||!data?.session?.access_token)throw Error(tr('Reconnectez-vous pour continuer.','Sign in again to continue.','سجّل الدخول مجددًا للمتابعة.'));\n    if(!current())throw Error(tr('Correction interrompue.','Grading interrupted.','تم إيقاف التصحيح.'));\n    const response=await fetch('/api/interactive-ai',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+data.session.access_token},body:JSON.stringify({exercise,attempt,index:idx})});\n    const value=await response.json();if(!response.ok)throw Error((languageCode==='fr'&&value.error)|| (response.status===429?tr('Quota gratuit atteint.','Free daily quota reached.','تم بلوغ الحد المجاني اليومي.'):tr('IA momentanément indisponible.','AI is temporarily unavailable.','الذكاء الاصطناعي غير متاح مؤقتًا.')) ||tr('IA momentanément indisponible.','AI is temporarily unavailable.','الذكاء الاصطناعي غير متاح مؤقتًا.'));\n    cache[key]={data:value};if(current())draw();\n   }catch(err){delete cache[key];if(current()){const live=root.querySelector('.mbi-ai-status');const b=root.querySelector('.mbi-ai-action');if(live)live.textContent=err.message||tr('Correction manuelle disponible.','Manual grading is available.','التصحيح اليدوي متاح.');if(b)b.disabled=false}}\n };\n};\n\nconst observer=new MutationObserver(()=>mount());observer.observe(document.getElementById('app')||document.body,{childList:true,subtree:true});mount();window.MonBacInteractive={open:show};\n})();\n"],"/mon-bac-interactive.css":["text/css; charset=utf-8",false,"#mbi-root{position:fixed;inset:0;z-index:99999;background:#f6f7fa;color:#20262d;font-family:system-ui,-apple-system,sans-serif;overscroll-behavior:contain;display:flex;justify-content:center;box-sizing:border-box}#mbi-root *{box-sizing:border-box}html.mbi-open{overflow:hidden}#mbi-root .mbi-shell{width:100%;max-width:760px;height:100%;height:100dvh;display:flex;flex-direction:column;min-height:0;background:#fff}#mbi-root .mbi-header{display:flex;align-items:center;gap:12px;flex:none;background:#c60835;color:#fff;padding:12px 16px;padding-top:max(12px,env(safe-area-inset-top));min-height:64px}#mbi-root .mbi-header>div{flex:1;min-width:0}#mbi-root .mbi-header strong{display:block;font-size:17px;line-height:1.2}#mbi-root .mbi-header small{display:block;font-size:11px;opacity:.85}#mbi-root .mbi-close{color:#fff;background:#ffffff24;border:0;border-radius:12px;width:44px;height:44px;font-size:30px;line-height:1;cursor:pointer;flex:none}#mbi-root .mbi-logo{font-weight:800;border:1px solid #ffffff70;border-radius:11px;padding:7px;flex:none;font-size:13px}#mbi-root .mbi-main{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;padding:18px clamp(14px,4vw,30px);display:flex;flex-direction:column;gap:12px}#mbi-root h2{font-size:clamp(19px,5vw,26px);line-height:1.27;margin:0;overflow-wrap:anywhere}#mbi-root p{margin:4px 0;color:#575e68;line-height:1.5;overflow-wrap:anywhere;white-space:pre-wrap}#mbi-root .mbi-footer{flex:none;display:flex;gap:8px;justify-content:flex-end;padding:12px 16px max(12px,env(safe-area-inset-bottom));box-shadow:0 -4px 20px #20262d0d;background:#fff;border-top:1px solid #ebedf1;flex-wrap:wrap}#mbi-root .mbi-button{border:1px solid #dddfe5;color:#333;background:#fff;border-radius:12px;padding:10px 14px;min-height:44px;font-size:14px;font-weight:650;cursor:pointer;line-height:1.25;white-space:normal;overflow-wrap:anywhere}#mbi-root .mbi-primary{color:#fff;background:#c60835;border-color:#c60835}#mbi-root .mbi-footer .mbi-button{flex:1;min-width:0}#mbi-root button:disabled{opacity:.5;pointer-events:none}#mbi-root button:focus-visible,#mbi-root input:focus-visible,#mbi-root select:focus-visible,#mbi-root textarea:focus-visible{outline:3px solid #e788a0;outline-offset:2px}#mbi-root .mbi-field{display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:650;color:#343a45}#mbi-root input:not([type=radio]),#mbi-root textarea,#mbi-root select{width:100%;max-width:100%;min-width:0;min-height:44px;border:1px solid #dfe1e7;border-radius:10px;background:#fafbfc;padding:10px 12px;color:#222;font:inherit;font-size:16px;line-height:1.3}#mbi-root textarea{resize:vertical;min-height:75px;max-height:180px}#mbi-root .mbi-row{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}#mbi-root .mbi-row input,#mbi-root .mbi-row select{flex:1;width:auto;min-width:65px}#mbi-root .mbi-item{display:flex;align-items:center;justify-content:space-between;gap:10px;text-align:left;padding:14px;border:1px solid #e6e8ed;border-radius:14px;background:white;color:#242a32;width:100%;min-width:0;font:inherit}#mbi-root button.mbi-item{cursor:pointer}#mbi-root .mbi-item>span:first-child{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px;overflow-wrap:anywhere}#mbi-root .mbi-item small,.mbi-muted{font-size:12px;color:#646c79}#mbi-root .mbi-badge{font-size:11px;font-weight:700;background:#fcebf0;color:#a80730;padding:5px 8px;border-radius:20px;max-width:40%;white-space:normal;overflow-wrap:anywhere;flex:none}#mbi-root .mbi-progress{height:6px;background:#f0e5e8;border-radius:10px;overflow:hidden;flex:none}#mbi-root .mbi-progress i{display:block;height:100%;background:#c60835;border-radius:10px}#mbi-root .mbi-empty,#mbi-root .mbi-notice,#mbi-root .mbi-error,#mbi-root .mbi-result{padding:14px;background:#f6f7fa;border-radius:12px;overflow-wrap:anywhere}#mbi-root .mbi-error{color:#a20d2c;background:#fff0f2;font-size:13px}#mbi-root .mbi-notice summary{cursor:pointer;font-weight:650;font-size:14px}#mbi-root .mbi-choice{display:flex;align-items:center;gap:10px;border:1px solid #e0e3e8;padding:12px;border-radius:12px;min-height:48px;font-weight:500;overflow-wrap:anywhere}#mbi-root .mbi-choice:has(input:checked){border-color:#c60835;background:#fff4f7}#mbi-root .mbi-choice input{accent-color:#c60835;flex:none;width:19px;height:19px}#mbi-root .mbi-table-wrap{overflow-x:auto;max-width:100%;border:1px solid #e6e8ee;border-radius:10px}#mbi-root .mbi-table{border-collapse:collapse;font-size:12px;min-width:100%;width:max-content}#mbi-root .mbi-table th,#mbi-root .mbi-table td{padding:6px;border:1px solid #e4e5e9;text-align:left;max-width:140px;white-space:normal}#mbi-root .mbi-table th{background:#f6f7fa}#mbi-root .mbi-table input{width:95px;min-height:36px;padding:5px;font-size:14px}#mbi-root .mbi-result{text-align:center;background:#fdf0f3;padding:25px 15px}#mbi-root .mbi-result strong{display:block;font-size:40px;color:#c60835;margin:10px 0}#app .mbi-launch-icon{font-size:23px;font-weight:800;color:#c60835;line-height:1}#app .mbi-launch span{overflow-wrap:normal;white-space:normal}@media(min-width:800px){#mbi-root .mbi-shell{height:calc(100dvh - 32px);margin:16px 0;border-radius:18px;overflow:hidden;box-shadow:0 10px 50px #1f243322}}@media(max-width:350px){#mbi-root .mbi-footer{padding:8px}#mbi-root .mbi-button{padding:9px 8px;font-size:13px}#mbi-root .mbi-header{gap:8px;padding:8px 10px}}@media(max-height:480px){#mbi-root .mbi-header{min-height:48px;padding:5px 12px}#mbi-root .mbi-close{width:38px;height:38px}#mbi-root .mbi-main{padding-block:10px;gap:8px}}\n\n#mbi-root .mbi-ai{display:flex;flex-direction:column;gap:7px;padding:12px;background:#f8f5ff;border:1px solid #e5dbfa;border-radius:12px;min-width:0;overflow-wrap:anywhere}#mbi-root .mbi-ai-heading{font-size:14px;font-weight:750;color:#624092}#mbi-root .mbi-ai small{font-size:12px;color:#5f586d}#mbi-root .mbi-ai .mbi-button{width:100%;min-width:0;white-space:normal}#mbi-root .mbi-ai-status{font-size:12px;color:#68438f}#mbi-root .mbi-ai-status:empty{display:none}#mbi-root .mbi-ai-result{display:flex;flex-direction:column;gap:8px;font-size:13px;line-height:1.45}#mbi-root .mbi-ai-result[hidden],#mbi-root .mbi-ai-action[hidden]{display:none!important}#mbi-root .mbi-ai-result p{margin:0;white-space:pre-wrap}#mbi-root .mbi-ai-result>strong{color:#4a247b;font-size:15px}\n.mbi-timer{padding:11px 14px;margin:0 0 14px;background:#f0f8f8;border:1px solid #a9d7d3;border-radius:12px;color:#126b67;font-weight:700;font-variant-numeric:tabular-nums;text-align:center;direction:auto}.mbi-timer[data-expired=yes]{background:#fff1f0;border-color:#ffc2bc;color:#ae302c}\n\n\n/* monAvenir v2 — interface pédagogique fidèle au journal djiboutien */\n#mbi-root .mbi-intro h2{font-size:clamp(20px,5vw,27px);letter-spacing:-.4px;color:#202839}\n#mbi-root .mbi-intro p{font-size:13px;color:#626b77}\n#mbi-root .mbi-category-chips{display:flex;gap:8px;overflow-x:auto;scrollbar-width:thin;padding:4px 1px 9px;flex:none}\n#mbi-root .mbi-chip{border:1px solid #e5dfe4;background:#fff;color:#343a42;border-radius:22px;padding:9px 13px;font-weight:700;font-size:12px;white-space:nowrap;min-height:40px;cursor:pointer}\n#mbi-root .mbi-chip.is-active{background:#c60835;color:white;border-color:#c60835}\n#mbi-root .mbi-activity{box-shadow:0 4px 15px #2930440b}\n#mbi-root .mbi-exercise-head small{color:#9b1239;font-size:12px;font-weight:800}\n#mbi-root .mbi-exercise-head h2{font-size:19px;line-height:1.35}\n#mbi-root .mbi-situation,#mbi-root .mbi-question,#mbi-root .mbi-journal,#mbi-root .mbi-assign,#mbi-root .mbi-correct-card{background:#fff;border:1px solid #e6e7ed;border-radius:14px;padding:13px;box-shadow:0 3px 15px #141d3008;min-width:0}\n#mbi-root .mbi-situation{background:#fff4f7;border-color:#f4d9e1}\n#mbi-root .mbi-situation strong{color:#ac0b36;font-size:14px}\n#mbi-root .mbi-situation p{font-size:13px;color:#353d47;line-height:1.5}\n#mbi-root .mbi-question{display:flex;align-items:flex-start;gap:10px}\n#mbi-root .mbi-question-number{display:flex;flex:none;align-items:center;justify-content:center;width:29px;height:29px;border-radius:50%;background:#c60835;color:#fff;font-size:14px;font-weight:800}\n#mbi-root .mbi-question h2{font-size:16px;line-height:1.4}\n#mbi-root .mbi-sheet{padding:0;overflow:hidden;border:1px solid #e2e4ea;border-radius:14px;background:#fff;box-shadow:0 3px 12px #19243a0a}\n#mbi-root .mbi-sheet-head{display:flex;justify-content:space-between;gap:9px;align-items:center;padding:13px 13px 8px}\n#mbi-root .mbi-sheet-head div{display:flex;flex-direction:column;gap:3px;min-width:0}\n#mbi-root .mbi-sheet-head small{font-size:10px;letter-spacing:.4px;font-weight:800;color:#a20932}\n#mbi-root .mbi-sheet-head strong{font-size:15px;color:#252b37}\n#mbi-root .mbi-sheet-head>span{font-size:10px;background:#f3f4f6;border-radius:7px;padding:5px 7px;white-space:nowrap}\n#mbi-root .mbi-sheet-meta{display:flex;justify-content:space-between;gap:8px;padding:0 13px 10px;color:#5e6573;font-size:12px}\n#mbi-root .mbi-sheet-table,#mbi-root .mbi-sheet-calc{width:100%;border-collapse:collapse;table-layout:fixed;font-size:12px}\n#mbi-root .mbi-sheet-table th,#mbi-root .mbi-sheet-table td{border:1px solid #e6e8ec;text-align:center;padding:9px 5px}\n#mbi-root .mbi-sheet-table th{background:#f4f5f7}\n#mbi-root .mbi-sheet-tag{display:inline-block;background:#fdeff3;border-radius:7px;padding:5px 8px;margin:7px 0 7px 8px;color:#ac0b39;font-weight:700;font-size:11px}\n#mbi-root .mbi-sheet-calc th,#mbi-root .mbi-sheet-calc td{border:1px solid #e7e9ed;padding:9px 7px;vertical-align:middle}\n#mbi-root .mbi-sheet-calc th{background:#fafbfc;width:52%;font-weight:700;text-align:left}\n#mbi-root .mbi-sheet-calc td{text-align:right;font-variant-numeric:tabular-nums}\n#mbi-root .mbi-sheet-active{background:#fff3f7}\n#mbi-root .mbi-sheet-active th{background:#ffe8ef;color:#a40a33}\n#mbi-root .mbi-sheet-calc td input{width:100%!important;min-height:42px!important;font-size:15px!important;text-align:right!important;border:2px solid #c60835!important;background:white!important}\n#mbi-root .mbi-sheet-empty{color:#999faa;font-size:12px;font-style:italic}\n#mbi-root .mbi-sheet-details summary{font-weight:700;color:#a30b34;cursor:pointer;padding:10px 0}\n#mbi-root .mbi-sheet-details .mbi-sheet{box-shadow:none}\n#mbi-root .mbi-journal{display:flex;flex-direction:column;gap:10px;padding:10px}\n#mbi-root .mbi-journal-title{display:flex;justify-content:space-between;gap:7px;flex-wrap:wrap}\n#mbi-root .mbi-journal-title strong{font-size:15px;color:#9b0c34}\n#mbi-root .mbi-journal-title small{font-size:10px;color:#65717d}\n#mbi-root .mbi-journal-wrap{max-width:100%;overflow-x:auto;border:1px solid #eed9de;border-radius:9px}\n#mbi-root .mbi-journal-table{min-width:570px;width:100%;table-layout:fixed;border-collapse:collapse;font-size:12px}\n#mbi-root .mbi-journal-table th{background:#c60835;color:#fff;text-align:center;font-size:11px;padding:11px 4px}\n#mbi-root .mbi-journal-table th:nth-child(1),#mbi-root .mbi-journal-table th:nth-child(2){width:12%}\n#mbi-root .mbi-journal-table th:nth-child(3){width:36%}\n#mbi-root .mbi-journal-table th:nth-child(4),#mbi-root .mbi-journal-table th:nth-child(5){width:20%}\n#mbi-root .mbi-journal-table td{max-width:none;padding:5px;text-align:left;border:1px solid #e2e3e8;font-size:12px;overflow-wrap:anywhere}\n#mbi-root .mbi-journal-table input{width:100%!important;min-width:0!important;max-width:100%!important;min-height:37px!important;padding:5px!important;font-size:13px!important}\n#mbi-root .mbi-journal-date td{text-align:center;background:#fff5f8}\n#mbi-root .mbi-journal-label td{text-align:center;background:#f8f9fb;font-size:11px;font-style:italic;padding:8px}\n#mbi-root .mbi-journal-totals{background:#f6f7fa;border-radius:9px;padding:10px;font-weight:750;font-size:12px;text-align:center;font-variant-numeric:tabular-nums}\n#mbi-root .mbi-journal .mbi-button{align-self:center}\n#mbi-root .mbi-hint{border:1px solid #eddcae;background:#fffbf0;border-radius:12px;padding:11px}\n#mbi-root .mbi-hint summary{cursor:pointer;color:#8f6915;font-weight:750}\n#mbi-root .mbi-option-tag{display:inline-flex;align-items:center;justify-content:center;width:27px;height:27px;background:#fde9ef;border-radius:50%;color:#9f0d36;font-weight:800;font-size:12px}\n#mbi-root .mbi-choice.mbi-true:has(input:checked){background:#edf9f2;border-color:#289a58}\n#mbi-root .mbi-choice.mbi-false:has(input:checked){background:#fff1f3;border-color:#d13a54}\n#mbi-root .mbi-feedback{padding:12px 13px;border-radius:11px;border:1px solid #eee0d5;font-size:13px;line-height:1.45}\n#mbi-root .mbi-feedback.mbi-good{background:#edf9f1;color:#187c43;border-color:#c6e8d1}\n#mbi-root .mbi-feedback.mbi-warning{background:#fff9ee;color:#815518;border-color:#f2dfbd}\n#mbi-root .mbi-assign h3{margin:0 0 7px;font-size:15px;color:#a50b35}\n#mbi-root .mbi-group-choice{display:flex;align-items:center;gap:10px;border:1px solid #e6e7ee;border-radius:10px;padding:10px;margin:7px 0;cursor:pointer}\n#mbi-root .mbi-group-choice input{width:18px;height:18px;accent-color:#c60835}\n#mbi-root .mbi-group-choice span{display:flex;flex-direction:column;gap:2px}\n#mbi-root .mbi-group-choice small{font-size:11px;color:#686f7b}\n#mbi-root .mbi-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}\n#mbi-root .mbi-stats>div{border:1px solid #eceef0;border-radius:11px;text-align:center;padding:12px 4px;display:flex;flex-direction:column;gap:4px}\n#mbi-root .mbi-stats strong{font-size:19px;color:#ae0b35}\n#mbi-root .mbi-stats small{font-size:10px;color:#5b6573}\n#mbi-root .mbi-answer{background:#f5f7fa;padding:12px;border-radius:10px;display:flex;flex-direction:column;gap:5px}\n#mbi-root .mbi-answer strong{font-size:16px;color:#a50a35;overflow-wrap:anywhere}\n#mbi-root .mbi-correct-card{display:flex;flex-direction:column;gap:10px}\n#mbi-root .mbi-correct-card p{font-size:13px}\n@media(max-width:400px){#mbi-root .mbi-main{padding:12px 11px;gap:11px}#mbi-root .mbi-badge{max-width:50%}#mbi-root .mbi-stats strong{font-size:17px}#mbi-root .mbi-footer{gap:7px}}\n\n\n\n#mbi-root .mbi-overview{border:1px solid #eedde3;background:linear-gradient(155deg,#fff7f9,#fff);padding:13px;border-radius:14px;display:flex;flex-direction:column;gap:12px}\n#mbi-root .mbi-overview .mbi-row strong{color:#a70b36}\n#mbi-root .mbi-overview-numbers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}\n#mbi-root .mbi-overview-numbers>div{border-radius:10px;background:white;border:1px solid #eee7e9;padding:9px 5px;display:flex;flex-direction:column;gap:3px;text-align:center}\n#mbi-root .mbi-overview-numbers strong{font-size:20px;color:#b40b37;font-variant-numeric:tabular-nums}\n#mbi-root .mbi-overview-numbers small{font-size:10px;color:#5f6877}\n#mbi-root .mbi-review-suggestions{border-top:1px solid #eadfe3;padding-top:9px}\n#mbi-root .mbi-review-suggestions summary{cursor:pointer;font-size:13px;color:#a60d38;font-weight:700}\n#mbi-root .mbi-suggestion{width:100%;display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;border:0;border-bottom:1px solid #eee;background:transparent;padding:10px 3px;font-size:12px;color:#37414e;cursor:pointer}\n#mbi-root .mbi-suggestion span{font-weight:800;color:#b10e39;white-space:nowrap}\n"],"/mon-bac-import.js":["text/javascript; charset=utf-8",false,"/* Document imports: files are parsed locally; no paid OCR or AI service. */\n(()=>{'use strict';\nconst esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst clean=s=>String(s).replace(/\\r/g,'').replace(/\\u0000/g,'').replace(/\\n{3,}/g,'\\n\\n').trim();\nconst readDocx=async file=>{if(!window.JSZip)await new Promise((resolve,reject)=>{let s=document.createElement('script');s.src='/vendor/jszip-3.10.1.min.js';s.onload=resolve;s.onerror=()=>reject(Error('Bibliothèque Word indisponible.'));document.head.append(s)});let zip=await JSZip.loadAsync(await file.arrayBuffer());let entry=zip.file('word/document.xml');if(!entry)throw Error('Document Word invalide.');let xml=await entry.async('string');if(xml.length>4e6)throw Error('Document trop volumineux.');let doc=new DOMParser().parseFromString(xml,'application/xml');if(doc.querySelector('parsererror'))throw Error('Document Word illisible.');let body=doc.getElementsByTagNameNS('*','body')[0];let out=[];const para=e=>Array.from(e.getElementsByTagNameNS('*','t')).map(n=>n.textContent).join('');for(const node of body.children){if(node.localName==='p')out.push(para(node));if(node.localName==='tbl'){for(const row of node.getElementsByTagNameNS('*','tr'))out.push(Array.from(row.children).filter(n=>n.localName==='tc').map(n=>Array.from(n.getElementsByTagNameNS('*','p')).map(para).join(' ')).join(' | '));out.push('')}}return clean(out.join('\\n'))};\nconst readHTML=async file=>{let doc=new DOMParser().parseFromString(await file.text(),'text/html');doc.querySelectorAll('script,style,template,noscript,iframe,object,embed,link,meta').forEach(n=>n.remove());doc.querySelectorAll('br').forEach(n=>n.replaceWith('\\n'));doc.querySelectorAll('p,div,h1,h2,h3,h4,li,tr').forEach(n=>n.append('\\n'));doc.querySelectorAll('td,th').forEach(n=>n.append(' | '));return clean(doc.body.textContent)};\nconst openPDF=async file=>{let lib=await import('/vendor/mon-bac-pdf-5.6.205.mjs');lib.GlobalWorkerOptions.workerSrc='/vendor/mon-bac-pdf-worker-5.6.205.mjs';return lib.getDocument({data:new Uint8Array(await file.arrayBuffer()),isEvalSupported:false,enableXfa:false}).promise};\nconst readPDF=async file=>{let doc=await openPDF(file);try{if(doc.numPages>60)throw Error('Limite : 60 pages. Importez le document en plusieurs parties.');let pages=[];for(let i=1;i<=doc.numPages;i++){let p=await doc.getPage(i);let x=await p.getTextContent();let t=x.items.map(v=>(v.str||'')+(v.hasEOL?'\\n':' ')).join('');if(t.trim())pages.push('Page '+i+'\\n'+t.trim())}let result=clean(pages.join('\\n\\n'));if(!result)throw Error('PDF numérisé sans texte. À l’étape Questions, joignez la page comme image.');return result}finally{await doc.destroy()}};\nconst imageData=canvas=>{for(let q of [.86,.72,.58,.45]){let data=canvas.toDataURL('image/jpeg',q);if(data.length<=220000)return data}throw Error('Image trop détaillée. Recadrez-la ou choisissez une image plus petite.')};\nconst photo=async file=>{let img=await createImageBitmap(file);try{let ratio=Math.min(1,1500/Math.max(img.width,img.height));let c=document.createElement('canvas');c.width=Math.max(1,Math.round(img.width*ratio));c.height=Math.max(1,Math.round(img.height*ratio));let x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.drawImage(img,0,0,c.width,c.height);return imageData(c)}finally{img.close()}};\nconst pdfImage=async(file,pageno)=>{let d=await openPDF(file);try{if(!Number.isInteger(pageno)||pageno<1||pageno>d.numPages)throw Error('Page inexistante (1 à '+d.numPages+').');let p=await d.getPage(pageno),v=p.getViewport({scale:1}),ratio=Math.min(2,1500/Math.max(v.width,v.height)),vp=p.getViewport({scale:ratio});let c=document.createElement('canvas');c.width=Math.ceil(vp.width);c.height=Math.ceil(vp.height);await p.render({canvasContext:c.getContext('2d'),viewport:vp}).promise;return imageData(c)}finally{await d.destroy()}};\nfunction questions(text){let lines=text.split('\\n'),list=[],current=null;for(let l of lines){let match=l.trim().match(/^(?:question\\s*)?(\\d+(?:\\.\\d+)*[.)\\-:]|[a-zA-Z][.)])\\s+(.+)/i);if(match){current=match[2].trim();list.push(current)}else if(current&&l.trim()&&!/^page\\s+\\d+$/i.test(l.trim())){list[list.length-1]+='\\n'+l.trim()}}return list.filter(x=>x.length<=5000).slice(0,50)}\nasync function extract(file){if(!file||file.size>20*1024*1024)throw Error('Fichier limité à 20 Mo.');let ext=file.name.split('.').pop().toLowerCase();if(ext==='docx')return readDocx(file);if(ext==='pdf')return readPDF(file);if(['html','htm'].includes(ext))return readHTML(file);if(['txt','csv','md'].includes(ext))return clean(await file.text());throw Error('Format non pris en charge. Utilisez Word .docx, PDF, HTML ou texte.')}\nfunction panel(stage){return `<details class=\"mbi-notice mbi-import\"><summary>📎 Importer un document</summary><p>Word (.docx), PDF, HTML, texte ou CSV${stage===1?' ; photo ou page PDF en illustration':''}.</p><label class=\"mbi-field\"><span>Document</span><input type=\"file\" data-import-file accept=\".docx,.pdf,.html,.htm,.txt,.csv,.md${stage===1?',image/jpeg,image/png,image/webp':''}\"></label>${stage===1?'<label class=\"mbi-field\"><span>Page PDF (pour une image)</span><input type=\"number\" min=\"1\" value=\"1\" data-import-page></label>':''}<div class=\"mbi-row\"><button type=\"button\" class=\"mbi-button\" data-import-action=\"text\">Extraire le texte</button>${stage===1?'<button type=\"button\" class=\"mbi-button\" data-import-action=\"image\">Joindre comme image</button>':''}</div><div data-import-status aria-live=\"polite\"></div></details>`}\nfunction attach(root,stage,api){let p=root.querySelector('.mbi-import');if(!p)return;p.addEventListener('click',async e=>{let b=e.target.closest('[data-import-action]');if(!b)return;let f=p.querySelector('[data-import-file]').files[0],out=p.querySelector('[data-import-status]');if(!f){out.textContent='Choisissez un fichier.';return;}let buttons=p.querySelectorAll('button');buttons.forEach(x=>x.disabled=true);out.textContent='Importation en cours…';try{if(f.size>20*1024*1024)throw Error('Fichier limité à 20 Mo.');if(b.dataset.importAction==='image'){let d=f.name.toLowerCase().endsWith('.pdf')?await pdfImage(f,Number(p.querySelector('[data-import-page]').value)):await photo(f);api.image(d);return}let t=await extract(f);if(!t)throw Error('Aucun texte trouvé.');out.innerHTML=`<label class=\"mbi-field\"><span>Aperçu modifiable</span><textarea data-import-preview rows=\"6\" spellcheck=\"true\" lang=\"fr\">${esc(t)}</textarea></label><div class=\"mbi-row\"><button class=\"mbi-button mbi-primary\" type=\"button\" data-use-text>${stage===0?'Insérer dans le sujet':'Insérer dans la question'}</button>${stage===0?'<button class=\"mbi-button\" type=\"button\" data-use-questions>Repérer les questions numérotées</button>':'<button class=\"mbi-button\" type=\"button\" data-use-correction>Insérer dans le corrigé</button>'}</div><small>Relisez l’extraction : la mise en page et les formules peuvent varier.</small>`;let preview=()=>out.querySelector('[data-import-preview]').value;out.querySelector('[data-use-text]').onclick=()=>{try{api.text(preview())}catch(err){out.textContent=err.message}};out.querySelector('[data-use-questions]')?.addEventListener('click',()=>{try{let list=questions(preview());if(!list.length)throw Error('Aucune question numérotée détectée. Insérez le texte puis créez les questions manuellement.');if(!confirm('Ajouter '+list.length+' questions à relire et compléter ?'))return;api.questions(list)}catch(err){out.textContent=err.message}});out.querySelector('[data-use-correction]')?.addEventListener('click',()=>{try{api.correction(preview())}catch(err){out.textContent=err.message}})}catch(err){out.textContent=err.message||'Import impossible.'}finally{buttons.forEach(x=>x.disabled=false)}})}\nwindow.MBIImport={panel,attach,extract,questions};\n})();\n"],"/mon-bac-import.css":["text/css; charset=utf-8",false,"#mbi-root .mbi-import{padding:12px;overflow:visible;border:1px solid #e6e8ee;background:#fafbfc}#mbi-root .mbi-import summary{color:#b60834;font-weight:700}#mbi-root .mbi-import[open]{display:flex;flex-direction:column;gap:10px}#mbi-root .mbi-import[open]>*{margin-top:8px}#mbi-root .mbi-import input[type=file]{font-size:13px;overflow:hidden;padding:8px;width:100%;min-width:0}#mbi-root .mbi-import input[type=file]::file-selector-button{border:0;background:#fbe6ec;border-radius:8px;padding:8px;color:#a80730;font-weight:650;margin-right:7px}#mbi-root .mbi-import [data-import-status]{display:flex;flex-direction:column;gap:8px;font-size:13px}#mbi-root .mbi-import [data-import-preview]{min-height:130px;max-height:200px}#mbi-root .mbi-import .mbi-row>.mbi-button{flex:1;min-width:0}#mbi-root .mbi-import-image{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:center;padding:10px;border:1px solid #e6e8ed;border-radius:12px;background:#fafbfc}#mbi-root .mbi-import-image img{display:block;width:100%;max-height:min(45dvh,420px);object-fit:contain;background:white;border-radius:6px}#mbi-root .mbi-import-image .mbi-button{flex:1;min-width:0}.mbi-image-dialog{z-index:100000;max-height:95dvh;max-width:95vw;width:auto;border:0;border-radius:12px;padding:10px;overflow:auto;background:white}.mbi-image-dialog::backdrop{background:#16181ccc}.mbi-image-dialog>img{display:block;max-width:100%;height:auto;object-fit:contain}.mbi-image-dialog>button{position:sticky;top:0;display:block;padding:10px 15px;border:0;border-radius:8px;background:#c60835;color:#fff;margin-bottom:8px;font-weight:700}\n"],"/mon-bac-language.js":["application/javascript; charset=utf-8",false,"/* monAvenir: reviewed interface labels; original educational records stay in French or their source language. */\n(()=>{\n'use strict';\nconst rows=`\nAccueil|Home|الرئيسية\nAccueil élève|Student home|واجهة الطالب\nAccueil enseignant|Teacher home|واجهة المعلّم\nAccueil administration|Administration home|واجهة الإدارة\nAccueil général|Main home|الرئيسية العامة\nBienvenue|Welcome|مرحبًا\nRéussir son bac,|Pass your baccalaureate,|لننجح في البكالوريا\nensemble.|together.|معًا.\nCours, révisions et accompagnement.|Lessons, revision and support.|دروس ومراجعة ومواكبة دراسية.\nSe connecter|Sign in|تسجيل الدخول\nConnexion|Sign in|تسجيل الدخول\nCréer un compte|Create an account|إنشاء حساب\nCréer mon compte|Create my account|إنشاء حسابي\nDécouvrir les cours de soutien|Explore tutoring|اكتشف دروس الدعم\nInstaller l’application|Install the app|تثبيت التطبيق\nInstaller l’App|Install the app|تثبيت التطبيق\nInstaller|Install|تثبيت\nTrouver une classe|Find a class|البحث عن صف\nChoisissez votre espace.|Choose your space.|اختر مساحتك.\nChoisissez votre espace|Choose your space|اختر مساحتك\nÉlève|Student|طالب\nÉlèves|Students|الطلاب\nEnseignant|Teacher|معلّم\nEnseignants|Teachers|المعلّمون\nAdministrateur|Administrator|مسؤول النظام\nAdministrateurs|Administrators|مسؤولو النظام\nAdministration|Administration|الإدارة\nEspace enseignant|Teacher area|مساحة المعلّم\nMon espace enseignant|My teacher area|مساحتي كمعلّم\nMon espace|My area|مساحتي\nAccéder à mon espace|Go to my area|الدخول إلى مساحتي\nE-mail ou téléphone|Email or phone|البريد الإلكتروني أو الهاتف\nVotre e-mail ou numéro|Your email or phone number|بريدك الإلكتروني أو رقم هاتفك\nAdresse e-mail|Email address|البريد الإلكتروني\nE-mail|Email|البريد الإلكتروني\nTéléphone|Phone|الهاتف\nNuméro de téléphone|Phone number|رقم الهاتف\nMot de passe|Password|كلمة المرور\nVotre mot de passe|Your password|كلمة المرور الخاصة بك\nAfficher le mot de passe|Show password|إظهار كلمة المرور\nMasquer le mot de passe|Hide password|إخفاء كلمة المرور\nMot de passe oublié ?|Forgot your password?|هل نسيت كلمة المرور؟\nNouveau mot de passe|New password|كلمة مرور جديدة\nConfirmer le mot de passe|Confirm password|تأكيد كلمة المرور\nPas encore de compte ?|Don't have an account yet?|ليس لديك حساب بعد؟\nDéjà inscrit ?|Already registered?|هل لديك حساب؟\nConnexion par empreinte|Sign in with fingerprint|الدخول ببصمة الإصبع\nSur appareil compatible|On compatible devices|على الأجهزة المتوافقة\nComment avez-vous créé votre compte ?|How did you create your account?|كيف أنشأت حسابك؟\nAvec mon e-mail|With my email|ببريدي الإلكتروني\nAvec mon téléphon