='resources';const ts=tabs([['resources','Mes ressources'],['add','Ajouter'],['qcm','QCM'],['stats','Statistiques'],['requests',`Demandes${(data.requests||[]).filter(r=>r.status==='pending').length?' • '+(data.requests||[]).filter(r=>r.status==='pending').length:''}`]]);if(tab==='add'||tab==='qcm')return ts+wizard();if(tab==='requests')return ts+pagination((data.requests||[]).filter(r=>r.status==='pending'),r=>row(r.student_name,r.group_name,`<div class=\"lr-inline\">${actions('approve','Approuver',r.id,'btn primary')}${actions('refuse','Refuser',r.id)}</div>`));if(tab==='stats')return ts+stats();return ts+search(data.resources||[])+`<div id=\"lrList\">${pagination((data.resources||[]).filter(matches),r=>row(r.title,`${kinds[r.kind]} · ${r.subject} · ${price(r)} · ${r.published?'Publié':'Brouillon'}`,`<div class=\"lr-inline\">${r.published?actions('archive','Archiver',r.id):actions('publish','Publier',r.id,'btn primary')}${actions('teacher-open','Voir',r.id)}</div>`))}</div>`}\nfunction newDraft(qcm=false){draft={title:'',series:'',academic_level:'',subject:'',kind:qcm?'qcm':'fiche',description:'',price:0,duration:0,due_at:'',audience:'classes',group_ids:[],student_ids:[],questions:[],file:null,id:null};draftStep=0;qEdit=0}\nfunction wizard(){if(!draft)newDraft(tab==='qcm');const d=draft, is=interactive(d.kind), steps=['Informations',is?'Questions':'Document','Destinataires'];const header=`<div class=\"lr-steps\">${steps.map((s,i)=>`<span class=\"${i===draftStep?'active':''}\">${i+1}. ${s}</span>`).join('')}</div>`;let body='';if(draftStep===0){body=field('Titre',input('title',d.title,'required maxlength=\"160\"'))+specialtyFields(d)+field('Type',select('kind',Object.entries(kinds).filter(([k])=>tab==='qcm'?interactive(k):!interactive(k)),d.kind))+field('Description (facultative)',`<textarea class=\"textarea\" name=\"description\" rows=\"2\" maxlength=\"3000\">${E(d.description)}</textarea>`)+field('Prix en FDJ (0 = gratuit)',input('price',d.price,'type=\"number\" min=\"0\" max=\"1000000\" required'))+(tab==='qcm'?field('Durée en minutes (0 = libre)',input('duration',d.duration,'type=\"number\" min=\"0\" max=\"180\" required')):'')+field('Date limite (facultative)',input('due_at',d.due_at,'type=\"datetime-local\"'))}\nelse if(draftStep===1){if(is){const q=d.questions[qEdit]||{type:'single',text:'',options:['',''],correct:0,points:1,explanation:'',hint:''};let answer=Array.isArray(q.correct)?q.correct.join('\\n'):String(q.correct??'');body=`<div class=\"lr-inline\"><strong>Question ${qEdit+1} / ${Math.max(d.questions.length,qEdit+1)}</strong>${qEdit>0?actions('question-prev','‹'):''}${qEdit<d.questions.length-1?actions('question-next','›'):''}</div>`+field('Type de réponse',select('qtype',[['single','Choix unique'],['multi','Choix multiples'],['boolean','Vrai / Faux'],['number','Nombre'],['text','Texte court'],['table','Tableau à compléter']],q.type))+field('Question',`<textarea class=\"textarea\" name=\"qtext\" required rows=\"3\">${E(q.text)}</textarea>`)+field('Options / lignes (une par ligne)',`<textarea class=\"textarea\" name=\"qoptions\" rows=\"3\" placeholder=\"Option 1&#10;Option 2\">${E(q.options?.join('\\n')||'')}</textarea>`)+field('Bonne réponse',input('qcorrect',q.type==='single'?Number(q.correct)+1:q.type==='multi'?(q.correct||[]).map(x=>Number(x)+1).join(','):q.type==='boolean'?(q.correct===1?'2':'1'):answer,'required placeholder=\"1 ou 1,2 ; texte / nombre\"'))+`<small>Choix : numéro(s) des options ; Vrai/Faux : 1 ou 2 ; tableau : valeurs séparées par |.</small>`+field('Points',input('qpoints',q.points,'type=\"number\" min=\"0.1\" max=\"100\" step=\"0.1\" required'))+field('Explication du corrigé',input('qexplanation',q.explanation||''))+field('Indice (exercice non chronométré)',input('qhint',q.hint||''))+actions('question-add','+ Ajouter une question')}\nelse body=field('Importer un PDF, Word (.docx) ou une image',`<input type=\"file\" class=\"input\" name=\"file\" accept=\".pdf,.docx,.png,.jpg,.jpeg,.webp\">`)+`<p class=\"lr-empty\">${d.file?E(d.file.name):'25 Mo maximum. Lecture intégrée.'}</p>`}\nelse body=field('Partager avec',select('audience',[['classes','Toutes mes classes'],['groups','Une ou plusieurs classes'],['students','Un ou plusieurs élèves']],d.audience))+`<div id=\"lrRecipients\">${recipients(d)}</div><p class=\"lr-empty\">${d.price?'Payant : consultation et téléchargement après paiement confirmé.':'Gratuit : consultation dans monAvenir.'}</p>`;\nreturn `<section class=\"lr-panel\">${header}<form id=\"lrWizard\">${body}<div class=\"lr-inline lr-form-actions\">${draftStep?actions('wizard-back','Retour'):''}<button class=\"btn primary\" type=\"submit\">${draftStep===2?'Publier':'Continuer'}</button></div></form></section>`}\nfunction recipients(d){if(d.audience==='classes')return '<small>Tous vos élèves approuvés.</small>';const group=d.audience==='groups',list=group?(data.groups||[]):[...new Map((data.students||[]).map(s=>[s.id,s])).values()];return `<div class=\"lr-recipients\">${list.length?list.map(x=>`<label><input type=\"checkbox\" name=\"recipient\" value=\"${E(x.id)}\" ${(group?d.group_ids:d.student_ids).includes(x.id)?'checked':''}> ${E(x.name)}</label>`).join(''):empty('Aucun destinataire. Ajoutez une classe ou des élèves.')}</div>`}\nfunction capture(){const f=$('lrWizard');if(!f||!draft)return;const fd=new FormData(f),d=draft;if(draftStep===0){for(const k of ['title','series','academic_level','subject','kind','description','due_at'])d[k]=String(f.elements.namedItem(k)?.value||'');for(const k of ['price','duration'])d[k]=Number(fd.get(k)||0)}else if(draftStep===1&&!interactive(d.kind)){const file=f.elements.file?.files?.[0];if(file)d.file=file}else if(draftStep===2){d.audience=String(fd.get('audience'));d.group_ids=d.audience==='groups'?fd.getAll('recipient'):[];d.student_ids=d.audience==='students'?fd.getAll('recipient'):[]}}\nfunction saveQuestion(){const f=$('lrWizard'),fd=new FormData(f);if(!f.reportValidity())throw Error('Complétez la question.');const type=String(fd.get('qtype')),raw=String(fd.get('qcorrect')).trim();let options=String(fd.get('qoptions')).split('\\n').map(s=>s.trim()).filter(Boolean),correct=raw;if(type==='boolean'){options=['Vrai','Faux'];correct=Number(raw)-1}else if(type==='single')correct=Number(raw)-1;else if(type==='multi')correct=raw.split(',').map(n=>Number(n.trim())-1);else if(type==='number'){correct=Number(raw.replace(',','.'));if(!Number.isFinite(correct))throw Error('Nombre invalide.')}else if(type==='table')correct=raw.split('|').map(s=>s.trim());if(['single','multi','boolean','table'].includes(type)&&options.length<2)throw Error('Ajoutez au moins deux options / lignes.');if(['single','boolean'].includes(type)&&(!Number.isInteger(correct)||correct<0||correct>=options.length)||type==='multi'&&(!correct.length||correct.some(n=>!Number.isInteger(n)||n<0||n>=options.length))||type==='table'&&correct.length!==options.length)throw Error('Corrigé invalide.');draft.questions[qEdit]={type,text:String(fd.get('qtext')).trim(),options,correct,points:Number(fd.get('qpoints')),explanation:String(fd.get('qexplanation')),hint:String(fd.get('qhint'))}}\nfunction stats(){const orders=data.orders||[],pending=orders.filter(o=>!o.payout_at);return `<div class=\"lr-kpis\"><div><strong>${(data.stats||[]).reduce((n,s)=>n+Number(s.views),0)}</strong><small>Consultations</small></div><div><strong>${(data.results||[]).length}</strong><small>Tests terminés</small></div><div><strong>${money(pending.reduce((n,o)=>n+o.amount-o.commission,0))}</strong><small>À reverser</small></div></div>${actions('results','Résultats des élèves')}${actions('works','Devoirs reçus')}${actions('earnings','Revenus')}<div>${pagination(data.stats||[],s=>row((data.resources||[]).find(r=>r.id===s.id)?.title||'Ressource',`${s.viewers} élèves · ${s.views} vues · ${s.attempts} réponses${s.avg!=null?' · '+s.avg+' %':''}`))}</div>`}\nfunction admin(){if(!tab)tab='pending';const orders=data.orders||[],cfg=data.settings||{},ts=tabs([['pending','À valider'],['paid','Encaissements'],['payout','Reversements'],['accounts','Comptes'],['settings','Tarifs']]);const notice=settingsNotice?`<p class=\"lr-specialty-ok\" role=\"status\">${E(settingsNotice)}</p>`:'';if(tab==='accounts')return ts+`<form id=\"lrPaymentSettings\" class=\"lr-panel\"><h2>Comptes de paiement</h2><p class=\"lr-specialty-note\">Renseignez les coordonnées de réception de monAvenir. Laissez vide pour désactiver un moyen. Ne saisissez aucun code PIN, CVV ni mot de passe.</p>${paymentMethods.map(k=>`<div class=\"lr-payment-field\">${paymentBadge(k)}${field(k,input(k,cfg.methods?.[k]||'','maxlength=\"300\" placeholder=\"Numéro / code marchand ou instructions\"'))}</div>`).join('')}${notice}<p class=\"lr-error\" id=\"lrPaymentError\" hidden></p><button class=\"btn primary full\" type=\"submit\">Enregistrer les comptes</button></form>`;if(tab==='settings')return ts+`<form id=\"lrSettings\" class=\"lr-panel\">${field('Commission (%)',input('commission',Number(cfg.commission_bp??1000)/100,'type=\"number\" min=\"0\" max=\"100\" step=\"0.01\" required'))}${field('Gratuité de lancement jusqu’au',input('launch',String(cfg.launch_until||'').slice(0,10),'type=\"date\" required'))}${actions('tab','Configurer les comptes de paiement','accounts')}${notice}<p class=\"lr-error\" id=\"lrPaymentError\" hidden></p><button class=\"btn primary full\" type=\"submit\">Enregistrer les tarifs</button></form>`;const list=orders.filter(o=>tab==='pending'?o.status==='pending':tab==='payout'?o.status==='paid'&&!o.payout_at:o.status==='paid');return ts+`<div class=\"lr-kpis\"><div><strong>${list.length}</strong><small>Opérations</small></div><div><strong>${money(list.reduce((n,o)=>n+o.amount,0))}</strong><small>Montant</small></div></div>`+pagination(list,o=>row(o.title,`${o.student_name} · ${money(o.amount)} · ${o.method||''}`,actions('admin-order','Ouvrir',o.id,'btn primary')))}\nfunction close(){if(timer)clearInterval(timer);timer=null;for(const u of urls)URL.revokeObjectURL(u);urls=[];modal?.remove();modal=null}\nfunction dialog(title,body,full=false){close();modal=document.createElement('dialog');modal.className='lr-dialog'+(full?' lr-full':'');modal.innerHTML=`<header><strong>${E(title)}</strong>${actions('close','Fermer')}</header><div class=\"lr-dialog-body\">${body}</div>`;document.body.append(modal);modal.showModal();modal.addEventListener('cancel',e=>{e.preventDefault();close()});return modal.querySelector('.lr-dialog-body')}\nfunction message(text){if(modal){const body=modal.querySelector('.lr-dialog-body');let p=body.querySelector('.lr-error');if(!p){p=document.createElement('p');p.className='lr-error';body.prepend(p)}p.textContent=text}else toast(text)}\nasync function publicCatalogue(){const rows=await api('catalogue');dialog('Ressources pédagogiques',`<p class=\"lr-empty\">Créez un compte et rejoignez une classe pour accéder aux activités.</p>${rows.slice(0,5).map(r=>row(r.title,`${r.subject} · ${r.teacher_name} · ${price(r)}`,`<span class=\"lr-lock\">${I('lock')}</span>`)).join('')||empty('Aucune ressource publiée.')}<div class=\"lr-inline\">${actions('signup','Créer un compte','','btn primary')}${actions('login','Se connecter')}</div>`)}\nasync function invoice(id){const o=await api('invoice',{id}), methods=Object.entries(o.methods||{});dialog('Facture monAvenir',`<div class=\"lr-invoice\"><small>FACTURE · ${E(o.invoice)}</small><h2>${money(o.amount)}</h2><p>${E(o.title)}</p><span class=\"lr-pill\">${status[o.status]||o.status}</span></div>${o.status==='paid'?actions('open','Accéder à mon achat',id,'btn primary full'):o.status==='pending'?empty('Paiement déclaré. L’administration vérifie votre encaissement.'): `<form id=\"lrPay\" data-id=\"${o.id}\">${o.refusal_reason?`<p class=\"lr-error\">${E(o.refusal_reason)}</p>`:''}${field('Moyen de paiement',select('method',methods.map(([k])=>[k,k]),methods[0]?.[0]))}<div class=\"lr-pay-instructions\">${methods.map(([k,v])=>`<p><strong>${E(k)}</strong> : ${E(v)}</p>`).join('')}</div>${field('Référence de la transaction',input('reference','','required minlength=\"3\" maxlength=\"100\"'))}<p class=\"lr-empty\">Effectuez le paiement au compte indiqué, puis saisissez sa référence.</p><button class=\"btn primary full\" type=\"submit\">Déclarer mon paiement</button></form>`}${paymentFooter(methods)}`)}\nasync function join(id){const groups=await api('join_groups',{id});dialog('Rejoindre une classe',groups.map(g=>row(g.name,(g.school||'')+(g.code?' · Code : '+g.code:''),g.status==='pending'?'<span class=\"lr-pill\">En attente</span>':g.status==='approved'?'<span class=\"lr-pill\">Approuvé</span>':g.mode==='visible_code'?`<button type=\"button\" class=\"btn primary\" data-mb91=\"resource-join\" data-id=\"${E(g.id)}\" data-code=\"${E(g.code)}\">Demander</button>`:actions('request','Demander',g.id,'btn primary'))).join('')||empty('Aucune classe publique disponible. Demandez le code privé à l’enseignant.'))}\nasync function openResource(id,teacherView=false){const r=teacherView?(data.resources||[]).find(x=>x.id===id):await api('open',{id});if(!r)throw Error('Ressource introuvable');if(interactive(r.kind)){if(teacherView){dialog(r.title,r.questions.map((q,i)=>row(`${i+1}. ${q.text}`,`${q.points} pt · ${q.type}`)).join(''));return}const old=(data.attempts||[]).find(a=>a.resource_id===id);dialog(r.title,`<div class=\"lr-invoice\"><strong>${r.questions.length} questions</strong><p>${r.duration?`${r.duration} minutes · chronométré`:'Sans chronomètre'} · ${price(r)}</p></div>${actions('start',old?'Reprendre / résultat':'Commencer',id,'btn primary full')}`);return}await reader(r,teacherView)}\nasync function reader(r,teacherView){const body=dialog(r.title,'<p class=\"lr-empty\">Chargement du document…</p>',true);const result=await st.db.storage.from('mon-bac-learning').download(r.id+'/document.'+r.file_ext);if(result.error)throw Error('Document inaccessible.');const blob=result.data;if(!body.isConnected)return;const u=URL.createObjectURL(blob);urls.push(u);body.innerHTML=`<nav class=\"lr-reader-bar\"><button type=\"button\" class=\"btn\" data-reader=\"minus\">−</button><span id=\"lrPage\">Lecture</span><button type=\"button\" class=\"btn\" data-reader=\"plus\">+</button>${r.price>0&&!teacherView?`<a class=\"btn\" download=\"${E(r.title)}.${r.file_ext}\" href=\"${u}\">Télécharger</a>`:''}${r.kind==='devoir'&&!teacherView?actions('submit-work','Remettre',r.id):''}</nav><div class=\"lr-document\" id=\"lrDocument\"></div>`;const wrap=body.querySelector('#lrDocument');if(r.file_ext==='pdf'){const pdfjs=await import('./vendor/mon-bac-pdf-5.6.205.mjs');pdfjs.GlobalWorkerOptions.workerSrc=new URL('./vendor/mon-bac-pdf-worker-5.6.205.mjs',location.href).href;const pdf=await pdfjs.getDocument({data:new Uint8Array(await blob.arrayBuffer())}).promise;let p=1,zoom=1,seq=0;const nav=body.querySelector('.lr-reader-bar');nav.insertAdjacentHTML('afterbegin','<button type=\"button\" class=\"btn\" data-reader=\"prev\">‹</button><button type=\"button\" class=\"btn\" data-reader=\"next\">›</button>');async function paint(){const token=++seq,pg=await pdf.getPage(p),base=pg.getViewport({scale:1}),width=Math.max(220,wrap.clientWidth-12),vp=pg.getViewport({scale:width/base.width*zoom}),c=document.createElement('canvas'),ratio=Math.min(devicePixelRatio||1,2);c.width=vp.width*ratio;c.height=vp.height*ratio;c.style.width=vp.width+'px';c.style.height=vp.height+'px';await pg.render({canvasContext:c.getContext('2d'),viewport:vp,transform:ratio===1?null:[ratio,0,0,ratio,0,0]}).promise;if(token===seq&&wrap.isConnected){wrap.replaceChildren(c);body.querySelector('#lrPage').textContent=`${p} / ${pdf.numPages}`}}nav.addEventListener('click',e=>{switch(e.target.dataset.reader){case'prev':p=Math.max(1,p-1);break;case'next':p=Math.min(pdf.numPages,p+1);break;case'plus':zoom=Math.min(3,zoom+.25);break;case'minus':zoom=Math.max(.5,zoom-.25);break;default:return}paint().catch(e=>message(e.message))});await paint()}else if(r.file_ext==='docx'){if(!window.JSZip)await new Promise((resolve,reject)=>{const s=document.createElement('script');s.src='./vendor/jszip-3.10.1.min.js';s.onload=resolve;s.onerror=reject;document.head.append(s)});const zip=await JSZip.loadAsync(blob),xml=await zip.file('word/document.xml').async('string'),doc=new DOMParser().parseFromString(xml,'application/xml');const ns='http://schemas.openxmlformats.org/wordprocessingml/2006/main';wrap.innerHTML='<article class=\"lr-word\">'+Array.from(doc.getElementsByTagNameNS(ns,'p')).map(p=>'<p>'+E(Array.from(p.getElementsByTagNameNS(ns,'t')).map(t=>t.textContent).join(''))+'</p>').join('')+'</article>'}else{const img=document.createElement('img');img.src=u;img.alt=r.title;wrap.append(img)}if(r.file_ext!=='pdf'){let z=100;body.querySelector('.lr-reader-bar').addEventListener('click',e=>{if(['plus','minus'].includes(e.target.dataset.reader)){z=Math.max(70,Math.min(250,z+(e.target.dataset.reader==='plus'?20:-20)));wrap.firstElementChild.style.width=z+'%'}})}}\nlet run=null;\nasync function start(id){const r=await api('open',{id});run={r,a:await api('start',{id}),index:0};showQuestion()}\nfunction showQuestion(){const {r,a,index}=run;if(a.finished_at){dialog('Résultat',`<div class=\"lr-invoice\"><h2>${Number(a.score)} / ${Number(a.maximum)}</h2><p>${Math.round(100*a.score/a.maximum)} % de réussite</p></div>${a.correction.map((c,i)=>row(`${i+1}. ${r.questions[i].text}`,`${c.earned}/${c.points} pt · ${c.explanation||'Réponse : '+JSON.stringify(c.correct)}`)).join('')}`);return}const q=r.questions[index],prev=a.answers?.[index];let html='';if(['single','multi','boolean'].includes(q.type))html=q.options.map((o,i)=>`<label class=\"lr-option\"><input type=\"${q.type==='multi'?'checkbox':'radio'}\" name=\"answer\" value=\"${i}\" ${q.type==='multi'?prev?.includes?.(i)?'checked':'':prev===i?'checked':''}>${E(o)}</label>`).join('');else if(q.type==='table')html=q.options.map((o,i)=>field(o,input('answer',prev?.[i]||''))).join('');else html=field('Votre réponse',input('answer',prev??'',q.type==='number'?'inputmode=\"decimal\"':''));const body=dialog(r.title,`<div class=\"lr-progress\"><span>Question ${index+1} / ${r.questions.length}</span><strong id=\"lrTime\"></strong></div><progress value=\"${index+1}\" max=\"${r.questions.length}\"></progress><h2>${E(q.text)}</h2><form id=\"lrAnswer\">${html}${q.hint?`<details><summary>Indice</summary><p>${E(q.hint)}</p></details>`:''}<div class=\"lr-inline lr-form-actions\">${index?actions('previous','Précédent'):''}<button class=\"btn primary\" type=\"submit\">${index===r.questions.length-1?'Terminer':'Suivant'}</button></div></form>`,true);if(a.deadline){const tick=()=>{const seconds=Math.max(0,Math.ceil((new Date(a.deadline)-Date.now())/1000)),el=body.querySelector('#lrTime');if(el)el.textContent=`${Math.floor(seconds/60)}:${String(seconds%60).padStart(2,'0')}`;if(!seconds){clearInterval(timer);timer=null;api('finish',{id:r.id}).then(x=>{run.a=x;showQuestion()}).catch(e=>message(e.message))}};timer=setInterval(tick,1000);tick()}}\nasync function saveAnswer(){const q=run.r.questions[run.index],fd=new FormData($('lrAnswer'));let a=q.type==='multi'?fd.getAll('answer').map(Number):q.type==='table'?fd.getAll('answer'):fd.get('answer');if(['single','boolean'].includes(q.type))a=a===null?null:Number(a);run.a=await api('answer',{id:run.r.id,index:run.index,answer:a})}\nconst oldView=view;view=function(){if(!screens.includes(st.screen))return oldView();reset();return `<div class=\"lr-shell\"><div class=\"lr-heading\"><button type=\"button\" class=\"btn\" data-act=\"goto\" data-to=\"${st.screen.split('-')[0]}-home\">‹ Accueil</button><h1>${{ 'student-learning':'Réviser et travailler','teacher-learning':'Ressources pédagogiques','admin-learning':'Achats et paiements'}[st.screen]}</h1>${actions('refresh','Actualiser')}</div>${loading?empty('Chargement…'):error?`<p class=\"lr-error\">${E(error)}</p>${actions('refresh','Réessayer')}`:st.screen==='student-learning'?student():st.screen==='teacher-learning'?teacher():admin()}</div>`};\nconst oldGo=go;go=function(s){if(screens.includes(s)){tab='';filter='';query='';page=0;data={};catalogue=[];loading=true;const ret=oldGo(s);if(st.screen===s)load();return ret}return oldGo(s)};\nconst oldRender=render;render=function(){const v=oldRender(),app=$('app');if(!app)return v;const s=st.screen,grid=app.querySelector('.mb-tiles');if(grid&&!app.classList.contains('mb70-photo-gate')){const target={'student-home':['student-learning','Travailler','book'],'teacher-home':['teacher-learning','Ressources','book'],'admin-home':['admin-learning','Achats et paiements','credit-card']}[s];if(target&&(s!=='teacher-home'||st.teacher?.status==='approved'))grid.insertAdjacentHTML('afterbegin',`<button class=\"mb-tile lr-shortcut\" data-act=\"goto\" data-to=\"${target[0]}\">${I(target[2])}<span>${target[1]}</span></button>`)}if(s==='admin-settings'&&st.role==='admin'){app.querySelector('.screen')?.insertAdjacentHTML('afterbegin',`<div class=\"lr-settings-shortcut\">${actions('payment-settings-open','Configurer les comptes de paiement','','btn primary full')}</div>`)}if(s==='student-home'||s==='student-learning'){const b=app.querySelector('.mb72-center');if(b){delete b.dataset.mb72;b.dataset.act='goto';b.dataset.to='student-learning'}}if(s==='welcome'&&!st.user){const anchor=app.querySelector('.mb83-directory');anchor?.insertAdjacentHTML('afterend',`<button type=\"button\" class=\"mb83-directory lr-public\" data-lr=\"catalogue\"><span class=\"mb83-directory-icon\">${I('book')}</span><span><strong>Ressources pédagogiques</strong><small>Découvrir les activités</small></span>${I('chevron')}</button>`)}if(s==='teacher-learning'&&draft&&draftStep===0&&$('lrWizard'))for(const k of ['series','academic_level','subject','kind']){const el=$('lrWizard').elements.namedItem(k);if(el)el.value=draft[k]}if(st.role==='eleve')app.querySelectorAll('[data-mbc=\"download-exam\"]').forEach(b=>b.remove());return v};\nconst oldOut=signOut;signOut=async function(){close();owner='';data={};catalogue=[];draft=null;run=null;return oldOut()};\njoinGroup=async function(){const code=$('joinCode')?.value.trim();if(!code)throw Error('Saisissez le code de la classe.');await api('join_code',{code});try{const saved=JSON.parse(localStorage.getItem('ege2027_invitation')||'null');if(saved?.code===code.toUpperCase())localStorage.removeItem('ege2027_invitation')}catch(_){}toast('Demande envoyée. Attendez l’approbation de l’enseignant.');if(st.screen==='student-group')render()};\ndocument.addEventListener('change',e=>{if(e.target.matches('[data-lr-filter]')){filter=e.target.value;page=0;render()}if(['series','academic_level','subject'].includes(e.target.name)&&$('lrWizard')&&draftStep===0){capture();draft[e.target.name]=e.target.value;if(e.target.name!=='subject')draft.subject='';render();return}if(e.target.name==='audience'&&$('lrWizard')){draft.audience=e.target.value;$('lrRecipients').innerHTML=recipients(draft)}if(e.target.name==='file'&&$('lrWizard'))capture()});\ndocument.addEventListener('input',e=>{if(e.target.matches('[data-lr-query]')){query=e.target.value;page=0;const list=$('lrList');if(list){const parent=document.createElement('div');parent.innerHTML=st.screen==='student-learning'?student():teacher();list.innerHTML=parent.querySelector('#lrList')?.innerHTML||''}}});\ndocument.addEventListener('click',async e=>{const b=e.target.closest?.('[data-lr]');if(!b||b.disabled)return;const a=b.dataset.lr,id=b.dataset.id;try{if(a==='payment-settings-open'){go('admin-learning');tab='accounts';settingsNotice='';render();return}if(a==='request-specialty'){capture();b.disabled=true;try{await api('request_specialty',{series:draft.series,academic_level:draft.academic_level,subject:draft.subject});await load()}finally{b.disabled=false}return}if(a==='close'){close();return}if(a==='tab'){if($('lrWizard'))capture();tab=id;settingsNotice='';page=0;query='';filter='';if(['add','qcm'].includes(tab)&&(!draft||interactive(draft.kind)!==(tab==='qcm')))newDraft(tab==='qcm');render();return}if(a==='page'){page=Math.max(0,page+Number(id));render();return}if(a==='refresh'){await load();return}if(a==='catalogue'){await publicCatalogue();return}if(a==='signup'||a==='login'){close();st.desired='eleve';st.mode=a==='signup'?'signup':'login';st.screen='auth';render();return}if(a==='open'||a==='teacher-open'){await openResource(id,a==='teacher-open');return}if(a==='invoice'){await invoice(id);return}if(a==='join'){await join(id);return}if(a==='request'){await api('request_join',{id});close();toast('Demande envoyée.');await load();return}if(['approve','refuse','archive','publish'].includes(a)){if(a==='archive'&&!await window.MBDialog.confirm('Archiver cette ressource ?'))return;await api({approve:'approve_join',refuse:'refuse_join',archive:'archive',publish:'publish'}[a],{id});await load();return}if(a==='wizard-back'){capture();draftStep--;render();return}if(['question-add','question-prev','question-next'].includes(a)){saveQuestion();qEdit=a==='question-add'?draft.questions.length:qEdit+(a==='question-prev'?-1:1);render();return}if(a==='start'){await start(id);return}if(a==='previous'){await saveAnswer();if(!run.a.finished_at)run.index--;showQuestion();return}if(a==='my-results'||a==='results'){const rows=a==='my-results'?(data.attempts||[]).filter(x=>x.finished_at):data.results||[];dialog('Résultats',rows.map(x=>row(x.title,`${x.student_name||x.subject||''} · ${x.score}/${x.maximum}`)).join('')||empty('Aucun résultat.'));return}if(a==='earnings'){dialog('Revenus',(data.orders||[]).map(o=>row(o.title,`${money(o.amount-o.commission)} · ${o.payout_at?'Reversé':'En attente de reversement'}`)).join('')||empty('Aucune vente.'));return}if(a==='works'){dialog('Devoirs reçus',(data.submissions||[]).map(w=>row(w.student_name,w.title,`<button type=\"button\" class=\"btn\" data-lr=\"review-work\" data-id=\"${w.resource_id}\" data-student=\"${w.student_id}\">Corriger</button>`)).join('')||empty('Aucun devoir remis.'));return}if(a==='review-work'){const w=(data.submissions||[]).find(x=>x.resource_id===id&&x.student_id===b.dataset.student);if(!w)return;const res=await st.db.storage.from('mon-bac-learning').download(id+'/'+w.student_id+'/travail.'+w.file_ext);if(res.error)throw res.error;const body=dialog('Corriger le devoir',`<form id=\"lrReview\" data-id=\"${id}\" data-student=\"${w.student_id}\">${field('Note / 20',input('grade',w.grade??'','type=\"number\" min=\"0\" max=\"20\" step=\"0.25\" required'))}${field('Commentaire',input('feedback',w.feedback||''))}<button type=\"submit\" class=\"btn primary\">Enregistrer</button></form>`);const u=URL.createObjectURL(res.data);urls.push(u);body.insertAdjacentHTML('afterbegin',`<a class=\"btn\" href=\"${u}\" target=\"_blank\" rel=\"noopener\">Consulter le travail remis</a>`);return}if(a==='submit-work'){dialog('Remettre mon devoir',`<form id=\"lrWork\" data-id=\"${id}\">${field('PDF ou photo',`<input class=\"input\" required type=\"file\" name=\"file\" accept=\".pdf,.png,.jpg,.jpeg,.webp\">`)}<button class=\"btn primary full\" type=\"submit\">Remettre</button></form>`);return}if(a==='admin-order'){const o=(data.orders||[]).find(x=>x.id===id);if(!o)return;dialog('Encaissement',`<div class=\"lr-invoice\"><small>${E(o.invoice)}</small><h2>${money(o.amount)}</h2><p>${E(o.student_name)} · ${E(o.teacher_name)}</p><p>${E(o.method||'')} · ${E(o.transaction_ref||'')}</p><p>Commission : ${money(o.commission)} · À reverser : ${money(o.amount-o.commission)}</p></div>${o.status==='pending'?`<form id=\"lrConfirm\" data-id=\"${id}\"><label class=\"lr-option\"><input type=\"checkbox\" name=\"verified\" required> J’ai vérifié l’encaissement réel sur le compte de la plateforme.</label><button class=\"btn primary full\" type=\"submit\">Confirmer le paiement</button></form>${actions('refuse-payment','Refuser',id)}`:o.payout_at?empty('Reversement enregistré le '+date(o.payout_at)):`<form id=\"lrPayout\" data-id=\"${id}\">${field('Référence du reversement effectué',input('reference','','required minlength=\"3\"'))}<button class=\"btn primary\" type=\"submit\">Enregistrer le reversement</button></form>`}`);return}if(a==='refuse-payment'){const reason=await window.MBDialog.prompt('Motif du refus');if(reason===null)return;await api('refuse_payment',{id,reason});close();await load()}}catch(err){message(err.message||'Opération impossible.')}});\ndocument.addEventListener('submit',async e=>{const f=e.target;if(!['lrWizard','lrSettings','lrPaymentSettings','lrPay','lrConfirm','lrPayout','lrAnswer','lrWork','lrReview'].includes(f.id))return;e.preventDefault();e.stopImmediatePropagation();const btn=f.querySelector('[type=\"submit\"]');if(btn)btn.disabled=true;try{const fd=new FormData(f),id=f.dataset.id;if(f.id==='lrWizard'){capture();if(draftStep===0){if(!draft.title.trim()||!draft.series||!draft.academic_level||!draft.subject)throw Error('Indiquez le titre, la série, le niveau et la matière.');if(!specialty(draft)?.approved)throw Error('Demandez la validation de cette spécialité avant de continuer.');draftStep++;render();return}if(draftStep===1){if(interactive(draft.kind))saveQuestion();else if(!draft.file)throw Error('Importez un document.');draftStep++;render();return}if(draft.audience!=='classes'&&!draft.group_ids.length&&!draft.student_ids.length)throw Error('Choisissez les destinataires.');const ext=draft.file?.name.split('.').pop().toLowerCase().replace('jpeg','jpg')||null;if(draft.file&&draft.file.size>26214400)throw Error('Fichier trop volumineux.');if(!draft.id){const r=await api('create',{...draft,file:undefined,file_ext:ext,due_at:draft.due_at?new Date(draft.due_at).toISOString():null});draft.id=r.id}if(draft.file){const res=await st.db.storage.from('mon-bac-learning').upload(draft.id+'/document.'+ext,draft.file,{upsert:true});if(res.error)throw res.error}await api('publish',{id:draft.id});draft=null;tab='resources';toast('Ressource publiée.');await load();return}if(f.id==='lrAnswer'){await saveAnswer();if(run.a.finished_at)showQuestion();else if(run.index===run.r.questions.length-1){run.a=await api('finish',{id:run.r.id});showQuestion()}else{run.index++;showQuestion()}return}if(f.id==='lrPaymentSettings'){const methods={};for(const k of paymentMethods){const v=String(fd.get(k)||'').trim();if(v)methods[k]=v}data.settings=await api('payment_methods',{methods});settingsNotice='Comptes enregistrés avec succès.';render();return}if(f.id==='lrSettings'){data.settings=await api('tariff_settings',{commission_bp:Math.round(Number(fd.get('commission'))*100),launch_until:new Date(String(fd.get('launch'))+'T23:59:59').toISOString()});settingsNotice='Tarifs enregistrés.';render();return}if(f.id==='lrPay')await api('declare',{id,method:fd.get('method'),reference:fd.get('reference')});if(f.id==='lrConfirm')await api('confirm_payment',{id,verified:fd.get('verified')==='on'});if(f.id==='lrPayout')await api('payout',{id,reference:fd.get('reference')});if(f.id==='lrReview')await api('review_submission',{id,student:f.dataset.student,grade:Number(fd.get('grade')),feedback:fd.get('feedback')});if(f.id==='lrWork'){const file=fd.get('file'),extension=file.name.split('.').pop().toLowerCase().replace('jpeg','jpg');if(file.size>26214400)throw Error('Fichier trop volumineux.');await api('prepare_submission',{id,extension});const res=await st.db.storage.from('mon-bac-learning').upload(id+'/'+st.user.id+'/travail.'+extension,file,{upsert:true});if(res.error)throw res.error;await api('submit_work',{id})}close();toast('Enregistré.');await load()}catch(err){const p=$('lrPaymentError')||$('lrWizardError');if(p){p.hidden=false;p.textContent=err.message||'Opération impossible.'}else message(err.message||'Opération impossible.');if(btn)btn.disabled=false}},true);\nwindow.MB85={api,load};\n})();\n"],"/mon-bac-v85.css":["text/css; charset=utf-8",false,"/* monAvenir — compact, touch-friendly learning screens. */\n.lr-shell{max-width:920px;margin:auto;display:grid;gap:12px;color:#142338}.lr-heading{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.lr-heading h1{flex:1;font-size:clamp(20px,4vw,30px);margin:0;line-height:1.15}.lr-heading .btn{min-height:38px;padding:8px 12px;font-size:13px}.lr-tabs{display:flex;gap:6px;overflow-x:auto;scrollbar-width:thin;padding:4px 0 8px;position:sticky;top:0;background:#f5f7fa;z-index:2}.lr-tabs button{white-space:nowrap;border:1px solid #dce2e8;background:white;color:#354154;border-radius:12px;padding:11px 13px;font-weight:700;cursor:pointer;min-height:44px}.lr-tabs button[aria-pressed=true]{background:var(--accent,#0b795b);color:white;border-color:transparent}.lr-filter{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px;margin-bottom:8px}.lr-filter .input,.lr-filter .select{min-width:0;width:100%;font-size:14px}.lr-row{display:flex;align-items:center;gap:10px;padding:12px 4px;border-bottom:1px solid #e1e6eb;min-width:0}.lr-row>div:first-of-type{flex:1;min-width:0}.lr-row strong,.lr-row small{display:block;overflow-wrap:anywhere}.lr-row strong{font-size:15px}.lr-row small{font-size:12px;color:#617085;margin-top:3px}.lr-row .btn{font-size:12px;min-height:38px;padding:7px 10px;flex-shrink:0}.lr-list,.lr-panel,.lr-shell>#lrList{background:white;border:1px solid #e3e6eb;border-radius:16px;padding:10px 12px;min-width:0}.lr-symbol{width:39px;height:39px;border-radius:10px;background:#e8f4ee;color:#087355;display:grid;place-items:center;flex-shrink:0}.lr-locked .lr-symbol{background:#edf0f4;color:#8390a1}.lr-locked .lr-row strong,.lr-locked strong{color:#647080}.lr-inline,.lr-links,.lr-pagination{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.lr-pagination{justify-content:center;padding:12px 0 2px;color:#657082}.lr-pagination .btn{min-width:42px}.lr-links{justify-content:center}.lr-field{display:grid;gap:5px;margin:12px 0}.lr-field>span{font-size:13px;font-weight:700}.lr-field .input,.lr-field .select,.lr-field .textarea{width:100%;box-sizing:border-box;min-width:0;min-height:42px}.lr-form-actions{justify-content:space-between;margin-top:16px}.lr-form-actions .primary{flex:1}.lr-steps{display:flex;gap:5px;justify-content:space-between;font-size:11px;color:#8a97a6;padding-bottom:10px;border-bottom:1px solid #dce2e8}.lr-steps .active{font-weight:800;color:var(--accent,#077454)}.lr-recipients{max-height:220px;overflow:auto;display:grid;gap:5px}.lr-recipients label,.lr-option{display:flex;align-items:center;gap:10px;padding:11px;background:#f5f7fa;border:1px solid #e1e6eb;border-radius:12px;font-size:14px;margin:5px 0}.lr-recipients input,.lr-option input{width:19px;height:19px;accent-color:#087355;flex-shrink:0}.lr-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(90px,1fr));gap:7px}.lr-kpis>div{background:#fff;border:1px solid #e1e6eb;border-radius:13px;padding:10px}.lr-kpis strong,.lr-kpis small{display:block;overflow-wrap:anywhere}.lr-kpis strong{font-size:clamp(14px,3vw,22px)}.lr-kpis small{font-size:11px;color:#627184}.lr-empty{font-size:13px;color:#64748b;line-height:1.5;padding:8px 0}.lr-error{background:#fff0f2;color:#a31636;border-radius:10px;padding:10px;font-size:13px}.lr-pill{background:#edf3f9;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:700;color:#275381;white-space:nowrap}.lr-dialog{border:0;border-radius:18px;padding:0;width:min(94vw,640px);max-width:100%;max-height:90dvh;color:#142338;background:#fff;box-shadow:0 15px 55px #0c172744;overflow:hidden}.lr-dialog::backdrop{background:#11182788}.lr-dialog[open]{display:flex;flex-direction:column}.lr-dialog>header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;background:#fff;border-bottom:1px solid #e3e7ec;flex-shrink:0}.lr-dialog>header strong{font-size:17px;overflow-wrap:anywhere}.lr-dialog>header .btn{font-size:13px;min-height:38px}.lr-dialog-body{padding:14px 16px;overflow:auto;min-height:0;flex:1}.lr-dialog-body h2{font-size:clamp(17px,4vw,24px);overflow-wrap:anywhere}.lr-full{width:min(100vw,1100px);height:98dvh;max-height:98dvh;border-radius:12px}.lr-full .lr-dialog-body{padding:9px;display:flex;flex-direction:column;gap:8px}.lr-reader-bar{display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:center;flex-shrink:0}.lr-reader-bar .btn{min-height:34px;font-size:13px;padding:6px 10px}.lr-document{flex:1;overflow:auto;background:#f0f2f6;border-radius:8px;min-height:250px;text-align:center}.lr-document canvas{display:block;margin:6px auto;max-width:none}.lr-document img{width:100%;height:auto;max-width:none;display:block;margin:auto}.lr-word{text-align:left;background:white;padding:20px;line-height:1.65;max-width:none}.lr-invoice{background:#f3f7f7;border:1px solid #dce8e4;border-radius:14px;padding:16px;margin-bottom:12px;overflow-wrap:anywhere}.lr-invoice h2{font-size:30px;margin:6px 0}.lr-invoice small{font-size:11px}.lr-pay-instructions{background:#f5f7fa;border-radius:10px;padding:8px 12px;font-size:13px;overflow-wrap:anywhere}.lr-progress{display:flex;justify-content:space-between;gap:8px;color:#475569;font-size:13px}.lr-dialog progress{width:100%;height:8px;accent-color:#087355}.lr-public{width:100%;text-align:left;cursor:pointer}.lr-shortcut{box-shadow:0 2px 9px #0478571a}.mb-reader{width:min(100vw,1100px)!important;height:97dvh!important;max-height:97dvh!important;max-width:100vw!important;padding:8px!important}.mb-reader #mbCanvasWrap{flex:1;min-height:0;width:100%;overflow:auto}.mb-reader #mbCanvas{max-width:100%;height:auto}@media(max-width:480px){.lr-row{gap:7px}.lr-row .lr-inline{flex-direction:column;gap:4px}.lr-dialog.lr-full{width:100vw;height:100dvh;max-height:100dvh;border-radius:0;margin:0}.lr-heading h1{order:-1;width:100%;flex-basis:100%}.lr-tabs{margin-inline:-4px}.lr-shell{gap:8px}.lr-dialog-body{padding:12px}.lr-row strong{font-size:14px}}\n"],"/mon-bac-v86.css":["text/css; charset=utf-8",false,"/* V86 — Premium : fond blanc, accent monAvenir et portrait sans dégradé. */\n.mb72-ad .mb72-banner-hit,\n.mb72-ad[style*=\"--mb-ad-image\"] .mb72-banner-hit,\n.mb72-photo-preview {\n  background: #fff !important;\n  color: #192638;\n  border: 1px solid #e7e6e9;\n  box-shadow: 0 3px 12px #2029380d;\n  grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);\n  border-radius: 16px;\n}\n.mb72-ad-copy, .mb72-photo-preview > div { gap: 5px; }\n.mb72-ad-copy small, .mb72-photo-preview small {\n  color: #79530e;\n  background: #fff3d6;\n  border-radius: 6px;\n  padding: 3px 6px;\n  letter-spacing: .25px;\n  line-height: 1.35;\n}\n.mb72-ad-copy strong, .mb72-photo-preview strong { color: #192638; }\n.mb72-ad-copy span, .mb72-photo-preview span { color: #536174; }\n.mb72-ad-copy b, .mb72-photo-preview b {\n  color: #fff;\n  background: #c81038;\n  border-radius: 8px;\n  padding: 6px 9px;\n  font-weight: 750;\n}\n.mb72-ad .mb72-banner-hit img, .mb72-photo-preview > img {\n  mask-image: none;\n  -webkit-mask-image: none;\n  object-fit: cover;\n  object-position: center 24%;\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n.mb72-ad .ege-ad-dot.active { background: transparent !important; }\n.mb72-ad .ege-ad-dot.active::after { background: #c81038; }\n.mb72-ad .ege-ad-arrow { color: #b81039 !important; }\n.mb83-banner {\n  background: #fff;\n  border-color: #e7e6e9;\n  box-shadow: 0 3px 12px #2029380d;\n}\n.mb83-ad-nav { border-color: #eeeef1; }\n.mb83-ad-nav button { color: #b81039; }\n"],"/mon-bac-v87.css":["text/css; charset=utf-8",false,".lr-payment-badge{width:110px;height:38px;display:block;flex:none}\n.lr-payment-field{display:grid;grid-template-columns:110px minmax(0,1fr);align-items:center;gap:12px;margin:12px 0}\n.lr-payment-field .lr-field{margin:0;min-width:0}\n.lr-payment-footer{margin-top:20px;padding-top:14px;border-top:1px solid #e2e6eb}\n.lr-payment-footer>div{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}\n.lr-specialty-note,.lr-specialty-ok{padding:12px;border-radius:10px;background:#f4f6f8;font-size:.9rem;margin:8px 0;color:#394b5e}\n.lr-specialty-ok{background:#e8f5ed;color:#086a4b}\n.lr-specialty-note button{margin-top:8px}\n.lr-settings-shortcut{margin:0 0 12px}\n.lr-error[hidden]{display:none!important}\n@media(max-width:370px){.lr-payment-field{grid-template-columns:1fr;gap:4px}}\n"],"/mon-bac-v88.css":["text/css; charset=utf-8",false,"/* V88 — responsive section navigation, without horizontal scrolling. */\n.lr-shell{width:100%;min-width:0;grid-template-columns:minmax(0,1fr)}\n.lr-shell>*{min-width:0;max-width:100%}\n.lr-tabs,.mb80-statuses,.mb80-settings-tabs{\n  display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,122px),1fr));\n  gap:6px;align-items:stretch;width:100%;min-width:0;max-width:100%;\n  margin-inline:0;overflow:visible;scrollbar-width:auto;\n}\n.lr-tabs{position:static;padding:4px 0 8px;background:transparent}\n.lr-tabs>button,.mb80-statuses>.mb80-chip,.mb80-settings-tabs>.mb80-chip{\n  width:100%;min-width:0;max-width:100%;min-height:44px;\n  padding:9px 7px;white-space:normal;overflow-wrap:anywhere;\n  line-height:1.25;text-align:center;font-size:clamp(13px,1.8vw,15px);\n}\n.lr-tabs>button[aria-pressed=true]{background:var(--mb,var(--accent,#0b795b));color:#fff}\n.lr-tabs>button:focus-visible,.mb80-chip:focus-visible{outline:2px solid var(--mb,#1954a6);outline-offset:2px}\n.mb76-tabs,.mb77-tabs,.mb82-tabs,.tabset,.admin-resource-tabs{\n  flex-wrap:wrap;min-width:0;max-width:100%;\n}\n.mb76-tabs>button,.mb77-tabs>button,.mb82-tabs>button,.tabset>button,.admin-resource-tabs>.btn{\n  flex:1 1 105px;min-width:0;max-width:100%;white-space:normal;overflow-wrap:anywhere;\n}\n.mb73-tabs>button,.mb78-tabs>button{white-space:normal;overflow-wrap:anywhere;min-width:0}\n.lr-field,.lr-filter>*{min-width:0;max-width:100%}\n.lr-heading h1{min-width:0;overflow-wrap:anywhere}\n.lr-payment-field .lr-payment-badge{max-width:100%}\n@media(max-width:420px){\n  .lr-tabs,.mb80-statuses,.mb80-settings-tabs{grid-template-columns:repeat(2,minmax(0,1fr))}\n  .lr-filter{grid-template-columns:minmax(0,1fr)}\n}\n@media(max-width:260px){\n  .lr-tabs,.mb80-statuses,.mb80-settings-tabs{grid-template-columns:minmax(0,1fr)}\n}\n"],"/mon-bac-v90.js":["application/javascript; charset=utf-8",false,"/* monAvenir V90 — clés d'accès WebAuthn natives Supabase Auth. */\n(()=>{'use strict';\nconst origin='https://monbac.janagaleh.com';\nlet working=false;\nconst supported=()=>location.origin===origin&&window.isSecureContext&&typeof window.PublicKeyCredential==='function'&&!!navigator.credentials;\nconst online=()=>supported()&&navigator.onLine&&!st.offlineSession&&!!st.db?.auth;\nconst isLogin=()=>!st.user&&st.screen==='auth'&&st.mode==='login'&&!st.pendingPasswordReset;\nconst isProfile=()=>!!st.user&&st.screen==='profile'&&!st.pendingPasswordReset&&!EGEAccount.blocked(st.profile||{});\nconst message=e=>{const s=String(e?.message||'');if(/disabled|not enabled|not configured|passkey_not_enabled|webauthn.*config/i.test(s+' '+(e?.code||'')))return 'Connexion par clé d’accès non activée sur monAvenir.';if(/abort|cancel|notallowed|not allowed|timed out/i.test(s+' '+e?.name))return 'Opération annulée ou expirée. Vous pouvez réessayer.';return 'Clé d’accès indisponible. Vérifiez votre appareil et votre connexion, ou utilisez votre mot de passe.'};\nconst oldAuth=auth,oldProfile=profile;\nauth=function(){const html=oldAuth();if(!isLogin()||!supported())return html;const template=document.createElement('template');template.innerHTML=html;const form=template.content.querySelector('#authForm');if(!form)return html;const box=document.createElement('div');box.className='mb90-access';box.innerHTML=`<button type=\"button\" class=\"btn full mb90-key\" data-mb90=\"login\">${fingerprint()} Connexion par clé d’accès</button><small>Empreinte, visage ou code de l’appareil.</small><p class=\"mb90-feedback\" role=\"status\" aria-live=\"polite\"></p>`;form.after(box);return template.innerHTML};\nfunction fingerprint(){return '<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><path d=\"M3 12a9 9 0 0 1 18 0M6 12a6 6 0 0 1 12 0v3m-9-3a3 3 0 0 1 6 0c0 4-1 7-3 9M6 15c0 2-.4 3-1 4m4-4c0 2-.5 5-2 6m11-3-1 3m-5-9v3\"/></svg>'}\nprofile=function(){const html=oldProfile();if(!isProfile()||!supported())return html;return html+`<section class=\"card mb90-profile\" aria-label=\"Sécurité du compte\"><h2>Sécurité du compte</h2><p>Activez une clé d’accès pour vous connecter rapidement avec votre empreinte, votre visage ou le code de votre appareil.</p><button type=\"button\" class=\"btn primary full mb90-key\" data-mb90=\"register\">${fingerprint()} Activer une clé d’accès</button><button type=\"button\" class=\"btn full\" data-mb90=\"list\">Gérer mes clés d’accès</button><small>Votre empreinte ne quitte pas votre appareil. Votre mot de passe reste utilisable.</small><p class=\"mb90-feedback\" role=\"status\" aria-live=\"polite\"></p><div class=\"mb90-list\"></div></section>`};\nfunction feedback(text){const node=document.querySelector('.mb90-feedback');if(node)node.textContent=text;else toast(text)}\nfunction requireOK(result){if(result?.error)throw result.error;return result?.data}\nasync function login(){\n const desired=st.desired;\n const result=requireOK(await st.db.auth.signInWithPasskey());\n if(!result?.session)throw Error('Session absente');\n try{\n  const verified=requireOK(await st.db.auth.getUser());if(!verified?.user)throw Error('Compte non vérifié');\n  st.user=verified.user;st.role=await resolveRole();\n  if(desired==='admin'&&st.role!=='admin'||desired==='enseignant'&&st.role==='eleve')throw Error('wrong-role');\n }catch(e){await st.db.auth.signOut({scope:'local'}).catch(()=>{});Object.assign(st,{user:null,profile:null,staff:null,teacher:null,role:'eleve',screen:'auth'});throw e}\n st.screen=homes[st.role];st.phoneEmailFallback=false;status('Connexion réussie.');await loadAll();render();\n}\nasync function list(){const result=requireOK(await st.db.auth.passkey.list());const entries=Array.isArray(result)?result:result?.passkeys;if(!Array.isArray(entries))throw Error('Liste indisponible');const box=document.querySelector('.mb90-list');if(!box)return;box.replaceChildren();if(!entries.length){box.textContent='Aucune clé enregistrée.';return}for(const entry of entries){if(typeof entry.id!=='string')continue;const row=document.createElement('div');row.className='mb90-entry';const name=document.createElement('span');name.textContent=entry.friendly_name||entry.name||'Clé d’accès';const btn=document.createElement('button');btn.type='button';btn.className='btn';btn.dataset.mb90='delete';btn.dataset.keyId=entry.id;btn.textContent='Retirer';row.append(name,btn);box.append(row)}}\nasync function act(e){const button=e.target.closest?.('[data-mb90]');if(!button)return;e.preventDefault();const action=button.dataset.mb90;if(working||st.busy||!online()||!(action==='login'?isLogin():isProfile())){feedback('Connexion Internet et appareil compatible nécessaires.');return}if(action==='delete'&&!await window.MBDialog.confirm('Retirer cette clé d’accès ? Votre mot de passe reste disponible.'))return;working=true;st.busy=true;button.disabled=true;feedback('Veuillez patienter…');try{if(action==='login')await login();else if(action==='register'){requireOK(await st.db.auth.registerPasskey());feedback('Clé d’accès enregistrée.');}else if(action==='list'){await list();feedback('');}else if(action==='delete'){requireOK(await st.db.auth.passkey.delete({passkeyId:button.dataset.keyId}));await list();feedback('Clé d’accès retirée.')}}catch(e){feedback(e?.message==='wrong-role'?'Cette clé appartient à un autre espace. Choisissez le bon espace.':message(e))}finally{working=false;st.busy=false;if(button.isConnected)button.disabled=false}}\ndocument.addEventListener('click',act);\n})();\n"],"/mon-bac-v90.css":["text/css; charset=utf-8",false,".mb90-access,.mb90-profile{display:grid;gap:10px;min-width:0;max-width:700px}.mb90-access{margin-top:14px}.mb90-profile{margin-top:16px}.mb90-profile h2,.mb90-profile p,.mb90-access p{margin:0}.mb9