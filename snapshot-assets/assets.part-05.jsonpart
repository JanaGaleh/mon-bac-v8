l.7 2.3L22 20l-2.3.7L19 23l-.7-2.3L16 20l2.3-.7z\"/>',\n chart:'<path d=\"M4 20V4M4 20h17M8 16v-5m5 5V7m5 9V3\"/>',\n warning:'<path d=\"m12 3 10 18H2zM12 9v5m0 3v.1\"/>',\n menu:'<path d=\"M4 7h16M4 12h16M4 17h16\"/>',\n monitor:'<rect x=\"3\" y=\"4\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M8 21h8M12 17v4\"/>',\n phone:'<rect x=\"6\" y=\"2\" width=\"12\" height=\"20\" rx=\"2\"/><path d=\"M11 19h2\"/>',\n tablet:'<rect x=\"4\" y=\"2\" width=\"16\" height=\"20\" rx=\"2\"/><path d=\"M11 19h2\"/>'\n};\nconst I=(name,cls='')=>`<svg class=\"${cls}\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">${paths[name]||paths.file}</svg>`;\nconst esc=s=>String(s??'').replace(/[&<>\"']/g,x=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[x]));\n\n\n'use strict';\nconst DB_URL=\"https://nwcatsmfbkcgvgbanwyl.supabase.co\";\nconst DB_PUBLIC=\"sb_publishable_vXuRHP_lqGqtV9d1C_oZWw_SetdoY7L\";\nconst appBase=location.origin+\"/\";\nconst initialAuthHash=new URLSearchParams(location.hash.slice(1));\nconst screenList=[\n[\"welcome\",\"Accueil\"],[\"pricing\",\"Tarifs\"],[\"auth\",\"Connexion\"],[\"ads-directory\",\"Annonces des enseignants\"],[\"student-home\",\"Accueil élève\"],[\"student-docs\",\"Mes dossiers\"],\n[\"student-wizard\",\"Parcours guidé\"],[\"student-terrain\",\"Partie terrain\"],[\"student-annex\",\"Mes annexes\"],[\"student-group\",\"Mon groupe\"],\n[\"teacher-home\",\"Accueil enseignant\"],[\"teacher-groups\",\"Mes groupes\"],[\"teacher-students\",\"Mes élèves\"],[\"teacher-review\",\"Corriger\"],\n[\"admin-home\",\"Accueil administration\"],[\"admin-users\",\"Utilisateurs\"],[\"admin-groups\",\"Groupes\"],[\"admin-monitor\",\"Dossiers et sécurité\"],[\"profile\",\"Profil\"]\n];\nconst navs={\neleve:[[\"student-home\",\"Accueil\",\"home\"],[\"student-docs\",\"Dossiers\",\"folder\"],[\"student-group\",\"Groupe\",\"users\"],[\"profile\",\"Profil\",\"user\"]],\nenseignant:[[\"teacher-home\",\"Accueil\",\"home\"],[\"teacher-groups\",\"Groupes\",\"users\"],[\"teacher-review\",\"Corrections\",\"edit\"],[\"profile\",\"Profil\",\"user\"]],\nadmin:[[\"admin-home\",\"Accueil\",\"home\"],[\"admin-users\",\"Utilisateurs\",\"users\"],[\"admin-monitor\",\"Contrôle\",\"shield\"],[\"profile\",\"Profil\",\"user\"]]\n};\nconst homes={eleve:\"student-home\",enseignant:\"teacher-home\",admin:\"admin-home\"};\nconst st={screen:\"welcome\",role:\"eleve\",desired:\"eleve\",user:null,db:null,staff:null,teacher:null,docs:[],groups:[],members:[],shares:[],reviews:[],requests:[],audit:[],ads:[],adError:'',settings:null,pricing:null,pricingError:'',selectedDocId:null,selectedGroupId:null,selectedStudentId:null,annex:1,reviewAnnex:1,wizardStep:1,adminTab:\"dossiers\",filter:\"\",mode:\"login\",busy:false,saving:false,saveTimer:null,saveBadge:\"Non enregistré\",warning:\"\",notice:\"\",lastError:\"\",draft:null,teacherOpen:false,adminOpen:false,expandedGroup:false,loaded:false,pendingPasswordReset:false};\nconst $=id=>document.getElementById(id);\nconst cleaned=v=>String(v??\"\").trim();\nconst shortDate=v=>v?new Date(v).toLocaleDateString(\"fr-FR\"):\"—\";\nconst longDate=v=>v?new Date(v).toLocaleString(\"fr-FR\"):\"—\";\nconst badge=(t,type=\"\")=>`<span class=\"badge ${type}\">${esc(t)}</span>`;\nconst btn=(text,act,cls=\"btn\",icon=\"\",data=\"\")=>`<button type=\"button\" class=\"${cls}\" data-act=\"${esc(act)}\" ${data}>${icon?I(icon):\"\"}${esc(text)}</button>`;\nconst title=(eyebrow,name,desc,tools=\"\")=>`<div class=\"page-head\"><div><div class=\"page-eyebrow\">${esc(eyebrow)}</div><h1>${esc(name)}</h1><p>${esc(desc)}</p></div><div class=\"inline-actions\">${tools}</div></div>`;\nconst box=(s)=>`<div class=\"card\">${s}</div>`;\nconst emptyCard=(msg)=>`<div class=\"empty\">${esc(msg)}</div>`;\nconst stateSafe=()=>st.db&&st.user;\nconst currentDoc=()=>st.docs.find(d=>d.id===st.selectedDocId)||null;\nconst currentGroup=()=>st.groups.find(g=>g.id===st.selectedGroupId)||null;\nconst currentTeacherDoc=()=>st.docs.find(d=>d.id===st.selectedDocId)||null;\nconst entityDoc=(id)=>st.docs.find(d=>d.id===id)||null;\nconst docTitle=d=>cleaned(d?.title)||cleaned(d?.payload?.problem)||\"Mon dossier EGE\";\nconst displayStudent=d=>cleaned(d?.payload?.student)||cleaned(d?.student)||\"Élève\";\nconst status=v=>{st.notice=String(v||\"\");st.lastError=\"\";if(st.notice===\"Connexion réussie.\")window.MBTools?.beginLoginMessage?.();};\nconst fail=e=>{st.lastError=String(e?.message||e||\"Erreur inconnue\");st.notice=\"\";if(window.MBDialog)void window.MBDialog.notice('Une erreur est survenue',st.lastError,'error');else toast(\"Opération non aboutie : \"+st.lastError);};\nconst toast=s=>{const message=String(s);if(window.MBDialog&&/^(Dossier (?:archivé|créé|associé)|Travail validé|Correction transmise|Décision enregistrée|Modification enregistrée|Demande envoyée|Classe (?:créée|rejointe)|Groupe créé|Élève retiré)/i.test(message)){void window.MBDialog.notice(message.split(/[.!]/)[0],message,'success');return}const el=$(\"toast\");if(!el)return;el.textContent=message;el.classList.add(\"show\");clearTimeout(window.__egeToastTimer);window.__egeToastTimer=setTimeout(()=>el.classList.remove(\"show\"),3500)};\nconst markPending=s=>{st.saveBadge=s;const b=$(\"saveState\");if(b)b.textContent=s;};\nconst csvCount=n=>Number(n||0).toLocaleString(\"fr-FR\");\nconst emptyPayload=()=>({study:{},series:EGEAcademic.seriesOf(st.user?.user_metadata),mode:\"individuel\",student:cleaned(st.user?.user_metadata?.full_name),partner:\"\",className:cleaned(st.user?.user_metadata?.class_name),school:cleaned(st.user?.user_metadata?.school),teacher:\"\",theme:null,subtheme:null,problem:\"\",problemMode:\"custom\",annexes:{},annexTitles:{},sources:{},sourceChecks:{},researchEvidence:{},annexBackup:{},company:\"\",terrain:EGETerrain.empty(),candidates:Array(7).fill(\"\"),resumeAt:\"student\",step:\"welcome\"});\nfunction docProgress(d){\n const p=d?.payload||{},items=[!!cleaned(p.student),Number.isInteger(p.theme),Number.isInteger(p.subtheme),!!cleaned(p.problem)];\n const count=p.mode===\"binome\"?4:3;\n for(let n=1;n<=count;n++)items.push(!!cleaned(p.annexes?.[n])&&!!cleaned(p.sources?.[n]));\n return Math.round(items.filter(Boolean).length/items.length*100);\n}\nfunction getTitle(n,p){return cleaned(p?.annexTitles?.[n])||([\"\",\"Les notions générales\",\"Comprendre le sous-thème\",\"Éléments de réponse à la problématique\",\"Conditions et limites\"][n]);}\nfunction saveLocalDraft(){\n if(!st.user||!st.draft||!st.selectedDocId)return;\n try{localStorage.setItem(`ege27_draft_${st.user.id}_${st.selectedDocId}`,JSON.stringify({payload:st.draft,modifiedAt:Date.now()}))}catch(_){}\n}\nfunction clearLocalDraft(){\n if(!st.user||!st.selectedDocId)return;\n try{localStorage.removeItem(`ege27_draft_${st.user.id}_${st.selectedDocId}`)}catch(_){}\n}\nfunction restoreLocalDraft(){\n if(!st.user||!st.selectedDocId||!st.draft)return;\n try{\n  const data=JSON.parse(localStorage.getItem(`ege27_draft_${st.user.id}_${st.selectedDocId}`)||\"null\");\n  if(data?.payload&&JSON.stringify(data.payload)!==JSON.stringify(st.draft)){\n   st.warning=\"Un brouillon local différent existe. Vous pouvez l'importer sans écraser le dossier en ligne.\";\n   st.localCandidate=data.payload; markPending(\"Brouillon local à récupérer\");\n  }else{st.localCandidate=null;st.warning=\"\";}\n }catch(_){}\n}\nfunction selectDoc(id){\n const d=entityDoc(id);if(!d)throw Error(\"Ce dossier n'est pas accessible.\");\n st.selectedDocId=d.id;st.draft=JSON.parse(JSON.stringify(d.payload||emptyPayload()));st.wizardStep=1;st.annex=1;\n st.draft.series=EGEAcademic.seriesOf(d.payload);\n st.draft.terrain=EGETerrain.normalize(d.payload?.terrain,d.payload);\n st.saveBadge=\"Enregistré en ligne\";st.warning=\"\";st.localCandidate=null;restoreLocalDraft();\n}\nfunction go(screen){\n if(!screenList.some(x=>x[0]===screen))return;\n if(st.busy)return;\n const scope=screen.split(\"-\")[0];\n if([\"student\",\"teacher\",\"admin\"].includes(scope)){\n  const role={student:\"eleve\",teacher:\"enseignant\",admin:\"admin\"}[scope];\n  if(!st.user){st.desired=role;st.screen=\"auth\";render();return;}\n  if(st.role!==role){toast(\"Cet espace n'est pas autorisé pour ce compte.\");return}\n }\n st.screen=screen;st.notice=\"\";st.lastError=\"\";render();\n if(typeof scrollTo===\"function\")scrollTo({top:0,behavior:\"instant\"});\n}\nasync function resolveRole(){\n if(!st.user)return null;\n const [a,b]=await Promise.all([\n  st.db.from(\"ege2027_staff\").select(\"role\").eq(\"user_id\",st.user.id).maybeSingle(),\n  st.db.from(\"ege2027_teacher_requests\").select(\"user_id,full_name,school,status,rejection_reason\").eq(\"user_id\",st.user.id).maybeSingle()\n ]);\n if(a.error)throw a.error;if(b.error)throw b.error;\n st.staff=a.data||null;st.teacher=b.data||null;\n if(a.data?.role===\"admin\")return \"admin\";\n if(b.data||a.data?.role===\"enseignant\"||st.user.app_metadata?.ege2027_account_kind===\"enseignant\"||st.user.user_metadata?.requested_role===\"enseignant\")return \"enseignant\";\n return \"eleve\";\n}\nasync function readRows(table,columns=\"*\",configure=null){\n let q=st.db.from(table).select(columns);\n if(configure)q=configure(q);\n const {data,error}=await q;if(error)throw error;return data||[];\n}\nasync function loadAll(){\n if(!st.user)return;\n st.loaded=false;\n const role=st.role;\n try{\n  if(role===\"eleve\"){\n   st.docs=await readRows(\"ege2027_dossiers\",\"id,owner_id,title,student,payload,updated_at,archived_at,suspended_at,deleted_at\",q=>q.eq(\"owner_id\",st.user.id).is(\"archived_at\",null).order(\"updated_at\",{ascending:false}).limit(300));\n   st.members=await readRows(\"ege2027_group_members\",\"group_id,student_id,student_name,teacher_id,joined_at\",q=>q.eq(\"student_id\",st.user.id));\n   const gids=[...new Set(st.members.map(m=>m.group_id))];\n   st.groups=gids.length?await readRows(\"ege2027_teacher_groups\",\"id,name,school,subject,teacher_id,join_code,active,archived_at,suspended_at,deleted_at,updated_at\",q=>q.in(\"id\",gids)):[];\n   st.shares=await readRows(\"ege2027_group_submissions\",\"id,group_id,dossier_id,student_id\",q=>q.eq(\"student_id\",st.user.id));\n   const ids=st.docs.map(d=>d.id);\n   st.reviews=ids.length?await readRows(\"ege2027_reviews\",\"id,dossier_id,decision,observation,annex_number,created_at\",q=>q.in(\"dossier_id\",ids).order(\"created_at\",{ascending:false}).limit(500)):[];\n  } else if(role===\"enseignant\"){\n   const request=await st.db.from(\"ege2027_teacher_requests\").select(\"user_id,full_name,school,status,rejection_reason\").eq(\"user_id\",st.user.id).maybeSingle();if(request.error)throw request.error;st.teacher=request.data||null;\n   if(st.teacher?.status!==\"approved\"){st.docs=[];st.groups=[];st.members=[];st.shares=[];st.reviews=[];await loadAds();st.loaded=true;render();return;}\n   st.groups=await readRows(\"ege2027_teacher_groups\",\"id,name,school,subject,join_code,active,archived_at,suspended_at,deleted_at,updated_at,teacher_id,created_at\",q=>q.eq(\"teacher_id\",st.user.id).order(\"created_at\",{ascending:false}));\n   const gids=st.groups.map(x=>x.id);\n   st.members=gids.length?await readRows(\"ege2027_group_members\",\"group_id,student_id,student_name,joined_at\",q=>q.in(\"group_id\",gids)):[];\n   st.shares=gids.length?await readRows(\"ege2027_group_submissions\",\"group_id,student_id,dossier_id,submitted_at\",q=>q.in(\"group_id\",gids)):[];\n   const ids=[...new Set(st.shares.map(x=>x.dossier_id))];\n   st.docs=ids.length?await readRows(\"ege2027_dossiers\",\"id,owner_id,title,student,payload,updated_at,archived_at,suspended_at,deleted_at\",q=>q.in(\"id\",ids).is(\"archived_at\",null).limit(500)):[];\n   st.reviews=ids.length?await readRows(\"ege2027_reviews\",\"id,dossier_id,decision,observation,annex_number,created_at\",q=>q.in(\"dossier_id\",ids).order(\"created_at\",{ascending:false}).limit(500)):[];\n  } else {\n   st.requests=await readRows(\"ege2027_teacher_requests\",\"user_id,full_name,school,status,created_at,reviewed_at,rejection_reason\",q=>q.order(\"created_at\",{ascending:false}).limit(300));\n   st.docs=await readRows(\"ege2027_dossiers\",\"id,owner_id,title,student,payload,updated_at,archived_at,suspended_at,deleted_at\",q=>q.order(\"updated_at\",{ascending:false}).limit(1000));\n   st.groups=await readRows(\"ege2027_teacher_groups\",\"id,teacher_id,name,school,subject,join_code,active,archived_at,suspended_at,deleted_at,updated_at,created_at\",q=>q.order(\"created_at\",{ascending:false}).limit(500));\n   st.members=await readRows(\"ege2027_group_members\",\"group_id,student_id,student_name,joined_at\",q=>q.limit(1000));\n   st.shares=await readRows(\"ege2027_group_submissions\",\"group_id,student_id,dossier_id\",q=>q.limit(1500));\n   st.reviews=await readRows(\"ege2027_reviews\",\"id,dossier_id,decision,observation,annex_number,created_at\",q=>q.order(\"created_at\",{ascending:false}).limit(500));\n   st.audit=await readRows(\"ege2027_audit_log\",\"id,action,entity_type,created_at,details\",q=>q.order(\"created_at\",{ascending:false}).limit(70));\n   const sets=await readRows(\"ege2027_settings\",\"app_title,academic_year,student_message\",q=>q.eq(\"id\",1).limit(1));\n   st.settings=sets[0]||null;\n  }\n  if(!entityDoc(st.selectedDocId)){\n   st.selectedDocId=st.docs[0]?.id||null;\n   st.draft=null;\n  }\n  if(st.selectedDocId&&st.role===\"eleve\"&&!st.draft)selectDoc(st.selectedDocId);\n  if(!st.groups.some(g=>g.id===st.selectedGroupId))st.selectedGroupId=st.groups[0]?.id||null;\n  await Promise.all([loadAds(),loadPricing()]);\n  st.loaded=true;render();\n }catch(e){st.loaded=true;fail(e);render()}\n}\nasync function initApp(){\n const privacyRoute=location.pathname.endsWith(\"/confidentialite.html\");\n if(privacyRoute)st.screen=\"privacy\";\n render();\n const factory=window.supabase?.createClient;\n if(!factory){st.lastError=\"Impossible de charger le service de connexion. Vérifiez Internet.\";render();return}\n st.db=factory(DB_URL,DB_PUBLIC,{auth:{experimental:{passkey:true}}});\n if(!navigator.onLine&&await window.EGEStudyUI?.boot())return;\n if(initialAuthHash.has(\"error\")){st.mode=\"confirm\";st.screen=\"auth\";st.lastError=EGEAccount.authMessage(initialAuthHash.get(\"error_description\")||\"Lien expiré\");history.replaceState(null,\"\",location.pathname);}\n await Promise.all([loadAds(),loadPricing()]);\n st.db.auth.onAuthStateChange((event)=>{if(event===\"PASSWORD_RECOVERY\"){st.pendingPasswordReset=true;st.screen=\"auth\";render()}});\n try{\n  const {data,error}=await st.db.auth.getUser();\n  if(error&&error.name!==\"AuthSessionMissingError\"&&!/auth session missing/i.test(error.message||\"\"))throw error;\n  st.user=data?.user||null;\n  if(st.user){\n   st.role=await resolveRole();\n   if(st.role===\"enseignant\"&&!st.teacher){\n    const m=st.user.user_metadata||{};\n    if(m.full_name&&m.school){\n     const {error:reqError}=await st.db.from(\"ege2027_teacher_requests\").insert({user_id:st.user.id,full_name:m.full_name,school:m.school,status:\"pending\"});\n     if(reqError)throw reqError;st.role=await resolveRole();\n    }\n   }\n   if(privacyRoute){st.screen=\"privacy\";}\n   else if(st.pendingPasswordReset||initialAuthHash.get(\"type\")===\"recovery\"){st.pendingPasswordReset=true;st.screen=\"auth\";}\n   else if(new URLSearchParams(location.search).get(\"profil\")===\"1\"){st.screen=\"profile\";}\n   else if(new URLSearchParams(location.search).get(\"choisir\")===\"1\"){st.screen=\"welcome\";}\n   else if(new URLSearchParams(location.hash.slice(1)).get(\"type\")===\"recovery\"){st.pendingPasswordReset=true;st.screen=\"auth\";}\n   else st.screen=location.pathname.endsWith(\"/annonces.html\")?\"ads-directory\":homes[st.role];\n   await loadAll();\n   const request=new URLSearchParams(location.search),requestedDoc=request.get('dossier');\n   if(st.role==='eleve'&&request.get('vue')==='terrain'&&entityDoc(requestedDoc)){selectDoc(requestedDoc);st.screen='student-terrain';render()}\n  } else {\n   if(privacyRoute)st.screen=\"privacy\";\n   else if(location.pathname.endsWith(\"/annonces.html\"))st.screen=\"ads-directory\";\n   else if(new URLSearchParams(location.search).get(\"connexion\")===\"1\"){st.screen=\"auth\";st.mode=\"login\";}\n   else if(new URLSearchParams(location.search).get(\"inscription\")===\"1\"){st.screen=\"auth\";st.mode=\"signup\";st.desired=\"eleve\"}\n   render();\n  }\n }catch(e){if(!await window.EGEStudyUI?.boot()){fail(e);render();}}\n if(\"serviceWorker\" in navigator)navigator.serviceWorker.register(\"./service-worker-ege-2027.js\").catch(()=>{});\n}\nasync function doLogin(mode){\n const email=cleaned($(\"authEmail\")?.value).toLowerCase();\n const password=$(\"authPassword\")?.value||\"\";\n const full_name=cleaned($(\"authFullName\")?.value);\n const school=cleaned($(\"authSchool\")?.value);\n const series=cleaned($(\"authSeries\")?.value);\n const class_name=cleaned($(\"authClass\")?.value);\n if(!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email))throw Error(\"Saisissez une adresse e-mail valide.\");\n if(mode!==\"forgot\"&&password.length<(mode===\"signup\"?12:6))throw Error(mode===\"signup\"?\"Le mot de passe doit contenir au moins 12 caractères.\":\"Vérifiez votre mot de passe.\");\n if(mode===\"forgot\"){\n  const {error}=await st.db.auth.resetPasswordForEmail(email,{redirectTo:appBase});if(error)throw error;\n  status(\"Si le compte existe, un e-mail de réinitialisation a été demandé. Vérifiez votre boîte de réception et les courriers indésirables.\");return;\n }\n if(mode===\"signup\"){\n  if(!full_name||!EGEAcademic.schools.includes(school))throw Error(\"Indiquez votre nom et choisissez votre établissement.\");\n  if(st.desired===\"eleve\"&&(!EGEAcademic.series.includes(series)||!EGEAcademic.classes[series].includes(class_name)))throw Error(\"Choisissez votre série et une classe de cette série.\");\n  const metadata={requested_role:st.desired,full_name,school};\n  if(st.desired===\"eleve\")metadata.whatsapp_number=EGEAccount.whatsapp($(\"authWhatsApp\")?.value);\n  if(st.desired===\"eleve\")Object.assign(metadata,{series,class_name});\n  const {data,error}=await st.db.auth.signUp({email,password,options:{emailRedirectTo:appBase,data:metadata}});\n  if(error)throw error;\n  if(!data.session){st.confirmEmail=email;st.mode=\"confirm\";st.confirmSentAt=Date.now();return}\n }else{\n  const {error}=await st.db.auth.signInWithPassword({email,password});\n  if(error){if(/email.*not.*confirmed/i.test(error.message)){st.confirmEmail=email;st.mode=\"confirm\";st.screen=\"auth\";render()}throw Error(EGEAccount.authMessage(error));}\n }\n const {data,error}=await st.db.auth.getUser();if(error)throw error;\n st.user=data.user;st.role=await resolveRole();\n if(st.desired===\"admin\"&&st.role!==\"admin\")throw Error(\"Ce compte ne possède pas les droits administrateur.\");\n if(st.desired===\"enseignant\"&&st.role===\"eleve\")throw Error(\"Ce compte n'a pas de profil enseignant.\");\n if(st.role===\"enseignant\"&&!st.teacher){\n  const info=st.user.user_metadata||{};\n  if(info.full_name&&info.school){\n   const {error:requestError}=await st.db.from(\"ege2027_teacher_requests\").insert({user_id:st.user.id,full_name:info.full_name,school:info.school,status:\"pending\"});\n   if(requestError)throw requestError;\n   st.role=await resolveRole();\n  }\n }\n st.screen=homes[st.role];status(\"Connexion réussie.\");await loadAll();\n}\nasync function recoverPassword(){\n const password=$(\"newPassword\")?.value||\"\";\n if(password.length<12)throw Error(\"Le nouveau mot de passe doit contenir au moins 12 caractères.\");\n const {error}=await st.db.auth.updateUser({password});if(error)throw error;\n history.replaceState(null,\"\",location.pathname);st.pendingPasswordReset=false;\n toast(\"Mot de passe modifié.\");st.screen=homes[st.role]||\"welcome\";render();\n}\nasync function signOut(){\n if(st.db){const {error}=await st.db.auth.signOut({scope:st.offlineSession?\"local\":\"global\"});if(error)throw error}\n clearTimeout(st.saveTimer);\n egeTerrainImages.clear();\n Object.assign(st,{user:null,staff:null,teacher:null,role:\"eleve\",desired:\"eleve\",docs:[],groups:[],members:[],shares:[],reviews:[],requests:[],audit:[],ads:[],selectedDocId:null,selectedGroupId:null,draft:null,screen:\"welcome\",loaded:false});\n await loadAds();\n render();\n}\nasync function createDoc(){\n if(!stateSafe()||st.role!==\"eleve\")throw Error(\"Connectez-vous dans l'espace élève.\");\n const payload=emptyPayload();\n const {data,error}=await st.db.from(\"ege2027_dossiers\").insert({owner_id:st.user.id,title:\"Nouveau dossier EGE\",student:\"\",payload}).select(\"id,owner_id,title,student,payload,updated_at,archived_at,suspended_at,deleted_at\").single();\n if(error)throw error;\n st.docs.unshift(data);selectDoc(data.id);st.wizardStep=1;go(\"student-wizard\");toast(\"Nouveau dossier créé.\");\n}\nasync function setDraftField(name,value){\n if(!st.draft||st.role!==\"eleve\")return;\n const map={dMode:\"mode\",dStudent:\"student\",dPartner:\"partner\",dClass:\"className\",dSchool:\"school\",dTeacher:\"teacher\",dProblem:\"problem\"};\n if(map[name])st.draft[map[name]]=value;\n if(name===\"dSeries\"){\n  const old=EGEAcademic.seriesOf(st.draft);\n  if(!EGEAcademic.series.includes(value)||value===old)return;\n  const hasStudy=Number.isInteger(st.draft.theme)||cleaned(st.draft.problem)||Object.values(st.draft.annexes||{}).some(v=>cleaned(v));\n  if(hasStudy&&!await window.MBDialog.confirm(\"Changer la série de ce dossier effacera son sujet, sa problématique et ses annexes. Pour conserver ce travail, créez plutôt un nouveau dossier. Continuer ?\")){\n   const select=$(\"dSeries\");if(select)select.value=old;return;\n  }\n  Object.assign(st.draft,{series:value,className:\"\",theme:null,subtheme:null,problem:\"\",annexes:{},annexTitles:{},sources:{},sourceChecks:{},researchEvidence:{},annexBackup:{}});\n  render();\n }\n if(name===\"dTheme\"){st.draft.theme=value===\"\"?null:Number(value);st.draft.subtheme=null}\n if(name===\"dSubtheme\")st.draft.subtheme=value===\"\"?null:Number(value);\n const annex=/^annex_(title|body|source|checked)_(\\d+)$/.exec(name);\n if(annex){const type=annex[1],n=annex[2];\n  if(type===\"title\")st.draft.annexTitles[n]=value;\n  if(type===\"body\")st.draft.annexes[n]=value;\n  if(type===\"source\")st.draft.sources[n]=value;\n  if(type===\"checked\")st.draft.sourceChecks[n]=Boolean(value);\n }\n saveLocalDraft();markPending(navigator.onLine?\"Modifications en attente\":\"Hors connexion\");\n clearTimeout(st.saveTimer);st.saveTimer=setTimeout(()=>saveDoc().catch(fail),1300);\n}\nasync function saveDoc(opts={}){\n if(!st.user||st.role!==\"eleve\"||!st.draft)return false;\n if(st.saving)return false;\n if(!navigator.onLine){markPending(\"Hors connexion — brouillon conservé\");saveLocalDraft();return false;}\n const d=currentDoc();if(!d)return false;\n const cloned=JSON.parse(JSON.stringify(st.draft));\n st.saving=true;markPending(\"Enregistrement en cours…\");\n try{\n  const changes={payload:cloned,student:cleaned(cloned.student),title:cleaned(d.title)||\"Dossier EGE\",updated_at:new Date().toISOString()};\n  const {data,error}=await st.db.from(\"ege2027_dossiers\").update(changes).eq(\"id\",d.id).eq(\"owner_id\",st.user.id).eq(\"updated_at\",d.updated_at).select(\"id,owner_id,title,student,payload,updated_at,archived_at,suspended_at,deleted_at\").maybeSingle();\n  if(error)throw error;\n  if(!data){st.warning=\"Une autre version a été enregistrée sur un autre appareil. Votre brouillon local est conservé : ne l'écrasez pas.\";markPending(\"Conflit de sauvegarde\");saveLocalDraft();throw Error(st.warning)}\n  const idx=st.docs.findIndex(x=>x.id===d.id);st.docs[idx]=data;\n  if(JSON.stringify(st.draft)===JSON.stringify(cloned)){clearLocalDraft();st.warning=\"\";markPending(\"Enregistré en ligne\");}\n  else{markPending(\"Modifications en attente\");clearTimeout(st.saveTimer);st.saveTimer=setTimeout(()=>saveDoc().catch(fail),800);}\n  if(!opts.silent)toast(\"Enregistré en ligne.\");return true;\n }catch(e){saveLocalDraft();fail(e);return false;}\n finally{st.saving=false;}\n}\nasync function archiveDoc(id){\n if(!await window.MBDialog.confirm(\"Archiver ce dossier ? Il ne sera pas supprimé et restera récupérable dans les archives.\"))return;\n const {error}=await st.db.from(\"ege2027_dossiers\").update({archived_at:new Date().toISOString()}).eq(\"id\",id).eq(\"owner_id\",st.user.id);if(error)throw error;\n if(st.selectedDocId===id){st.selectedDocId=null;st.draft=null}await loadAll();toast(\"Dossier archivé.\");\n}\nasync function selectAndGoDoc(id,screen=\"student-wizard\"){\n if(st.draft&&st.selectedDocId!==id&&st.saveBadge!==\"Enregistré en ligne\"){\n  const ok=await saveDoc({silent:true});if(!ok)throw Error(\"Le brouillon précédent n'est pas synchronisé. Sauvegardez-le avant de changer de dossier.\");\n }\n selectDoc(id);go(screen);\n}\nasync function legacyEditor(){\n if(st.role!==\"eleve\"||!currentDoc()||!st.draft)throw Error(\"Ouvrez un dossier avant de l'exporter.\");\n if(st.saveBadge!==\"Enregistré en ligne\"){\n  const ok=await saveDoc({silent:true});if(!ok&&!window.EGEOffline?.enabled(st.user.id))throw Error(\"Le dossier n'est pas synchronisé. Sauvegardez ou résolvez le conflit avant l'export.\");\n  await window.EGEOffline?.flush();\n }\n const d=currentDoc();\n localStorage.setItem(\"ege-gfm-2027-v3\",JSON.stringify({...emptyPayload(),...st.draft}));\n localStorage.setItem(\"ege2027_dossier_selection_\"+st.user.id,JSON.stringify({id:d.id,title:d.title,updated_at:d.updated_at}));\n location.assign(new URL(\"./assistant-dossier-gfm-2027.html\",location.href).href);\n}\nasync function joinGroup(){\n const p_code=cleaned($(\"joinCode\")?.value).toUpperCase(),p_student_name=cleaned(st.draft?.student)||cleaned(st.user?.email?.split(\"@\")[0]);\n if(!p_code)throw Error(\"Saisissez le code transmis par votre enseignant.\");\n const {error}=await st.db.rpc(\"ege2027_join_group\",{p_code,p_student_name});\n if(error)throw error;\n await loadAll();toast(\"Classe rejointe. Associez votre dossier pour que le professeur puisse le consulter.\");\n}\nasync function associateDoc(){\n const gid=$(\"shareGroup\")?.value,did=$(\"shareDoc\")?.value;\n if(!gid||!did)throw Error(\"Choisissez votre groupe et un dossier.\");\n if(!st.docs.some(d=>d.id===did)||!st.members.some(m=>m.group_id===gid))throw Error(\"L'accès à ce groupe ou dossier n'est pas autorisé.\");\n if(!await window.MBDialog.confirm(\"Autoriser l'enseignant de cette classe à consulter ce dossier et toutes ses futures sauvegardes ? Vos autres dossiers resteront privés.\"))return;\n const {error}=await st.db.from(\"ege2027_group_submissions\").insert({group_id:gid,dossier_id:did,student_id:st.user.id});\n if(error&&error.code!==\"23505\")throw error;\n await loadAll();void window.MBDialog.notice('Dossier associé','Votre dossier EGE est désormais associé à votre enseignant.','success');\n}\nasync function leaveGroup(groupId){\n if(!await window.MBDialog.confirm(\"Quitter ce groupe ? L'enseignant perdra l'accès aux dossiers associés à ce groupe. Vos dossiers restent enregistrés.\"))return;\n const {error}=await st.db.from(\"ege2027_group_members\").delete().eq(\"group_id\",groupId).eq(\"student_id\",st.user.id);\n if(error)throw error;await loadAll();toast(\"Vous avez quitté le groupe.\");\n}\nasync function createGroup(){\n if(st.role!==\"enseignant\"||st.teacher?.status!==\"approved\")throw Error(\"Votre compte enseignant doit être approuvé.\");\n const name=cleaned($(\"groupName\")?.value),school=cleaned($(\"groupSchool\")?.value);\n if(name.length<2)throw Error(\"Indiquez le nom de la classe.\");\n const subject=cleaned($(\"groupSubject\")?.value);\n if(!subject)throw Error(\"Choisissez la matière de cette classe.\");\n const {error}=await st.db.from(\"ege2027_teacher_groups\").insert({teacher_id:st.user.id,name,school,subject});\n if(error)throw error;st.teacherOpen=false;await loadAll();toast(\"Groupe créé.\");\n}\nasync function teacherDecision(docId,decision){\n const doc=entityDoc(docId);if(!doc)throw Error(\"Le dossier n'est pas accessible.\");\n const observation=cleaned($(\"teacherComment\")?.value),annex=$(\"reviewAnnex\")?.value;\n if(decision===\"a_corriger\"&&!observation)throw Error(\"Indiquez l'observation à transmettre.\");\n const payload={dossier_id:docId,staff_id:st.user.id,decision,observation,annex_number:annex?Number(annex):null};\n const {error}=await st.db.from(\"ege2027_reviews\").insert(payload);if(error)throw error;\n await loadAll();toast(decision===\"valide\"?\"Travail validé.\":\"Correction transmise à l'élève.\");\n}\nasync function removeStudent(groupId,studentId){\n if(!await window.MBDialog.confirm(\"Retirer cet élève de la classe ? Ses dossiers personnels seront conservés et l'accès enseignant sera révoqué.\"))return;\n const {error}=await st.db.from(\"ege2027_group_members\").delete().eq(\"group_id\",groupId).eq(\"student_id\",studentId);\n if(error)throw error;await loadAll();toast(\"Élève retiré du groupe.\");\n}\nasync function changeGroup(groupId,action){\n const g=st.groups.find(x=>x.id===groupId);if(!g)throw Error(\"Groupe introuvable.\");\n if(st.role!==\"admin\"&&(g.suspended_at||g.deleted_at))throw Error(\"Ce groupe a été suspendu ou supprimé par l’administration.\");\n let changes;\n if(action===\"rename\"){const name=await window.MBDialog.prompt(\"Nom du groupe\",g.name);if(name===null)return;const v=cleaned(name);if(v.length<2)throw Error(\"Nom trop court.\");changes={name:v}}\n else {if(!await window.MBDialog.confirm(g.active?\"Suspendre les nouvelles inscriptions dans ce groupe ?\":\"Réactiver les inscriptions ?\"))return;changes={active:!g.active}}\n const {error}=await st.db.from(\"ege2027_teacher_groups\").update(changes).eq(\"id\",g.id);if(error)throw error;\n await loadAll();toast(\"Groupe mis à jour.\");\n}\nasync function approveTeacher(userId,status){\n if(st.role!==\"admin\")throw Error(\"Droits administrateur nécessaires.\");\n const r=st.requests.find(x=>x.user_id===userId);if(!r)throw Error(\"Demande introuvable.\");\n if(!await window.MBDialog.confirm((status===\"approved\"?\"Approuver\":status===\"suspended\"?\"Suspendre\":\"Refuser\")+\" l'enseignant \"+r.full_name+\" ?\"))return;\n let rejection_reason=\"\";\n if(status!==\"approved\"){const reason=await window.MBDialog.prompt(\"Motif à communiquer à l'enseignant\",r.rejection_reason||\"\");if(reason===null)return;if(!cleaned(reason))throw Error(\"Indiquez un motif.\");rejection_reason=cleaned(reason)}\n const {error}=await st.db.from(\"ege2027_teacher_requests\").update({status,rejection_reason,reviewed_at:new Date().toISOString(),reviewed_by:st.user.id}).eq(\"user_id\",userId);\n if(error)throw error;await loadAll();toast(\"Décision enregistrée.\");\n}\nasync function adminGroupCreate(){\n const teacher_id=$(\"adminTeacher\")?.value,name=cleaned($(\"adminGroupName\")?.value),school=cleaned($(\"adminGroupSchool\")?.value);\n if(!st.requests.some(r=>r.user_id===teacher_id&&r.status===\"approved\")||name.length<2)throw Error(\"Choisissez un enseignant approuvé et un nom de classe.\");\n const {error}=await st.db.from(\"ege2027_teacher_groups\").insert({teacher_id,name,school});if(error)throw error;\n st.adminOpen=false;await loadAll();toast(\"Groupe créé.\");\n}\nasync function saveSettings(){\n if(st.role!==\"admin\")throw Error(\"Accès administrateur requis.\");\n const academic_year=cleaned($(\"settingsYear\")?.value),student_message=cleaned($(\"settingsMessage\")?.value);\n if(!academic_year)throw Error(\"Indiquez l'année scolaire.\");\n const {error}=await st.db.from(\"ege2027_settings\").update({academic_year,student_message,updated_at:new Date().toISOString(),updated_by:st.user.id}).eq(\"id\",1);\n if(error)throw error;await loadAll();toast(\"Paramètres enregistrés.\");\n}\nfunction choiceRole(role){\n st.desired=role;\n if(st.user){\n  if(st.role!==role){toast(\"Ce compte est lié à un autre espace. Utilisez un compte autorisé pour ce rôle.\");st.screen=\"auth\";}\n  else st.screen=homes[role];\n }else {st.screen=\"auth\";st.mode=\"login\";}\n render();\n}\n// Installation PWA : le prompt natif ne peut être déclenché que par un clic réel.\nlet egeInstallPrompt=null;\nlet egeInstallInProgress=false;\nlet egeAppInstalled=false;\nconst egeIsInstalled=()=>egeAppInstalled||window.matchMedia?.(\"(display-mode: standalone)\")?.matches===true||navigator.standalone===true;\nconst egeIsIOS=()=>/iPad|iPhone|iPod/.test(navigator.userAgent)||navigator.platform===\"MacIntel\"&&navigator.maxTouchPoints>1;\nfunction refreshInstallButtons(){\n const installed=egeIsInstalled();\n for(const el of document.querySelectorAll('[data-act=\"install\"],[data-ege-header=\"install\"]')){\n  el.hidden=installed;\n  el.disabled=egeInstallInProgress;\n }\n}\nfunction explainInstall(){\n const content=document.getElementById(\"egeInstallInstructions\");\n const dialog=document.getElementById(\"egeInstallDialog\");\n if(!content||!dialog){toast(\"Ouvrez cette page dans Safari ou Chrome, puis utilisez le menu du navigateur pour l’ajouter à l’écran d’accueil.\");return}\n if(egeIsIOS()){\n  content.textContent=\"Sur iPhone ou iPad : ouvrez cette adresse dans Safari, appuyez sur Partager, choisissez « Sur l’écran d’accueil », puis « Ajouter ».\";\n }else if(/Android/i.test(navigator.userAgent)){\n  content.textContent=\"Sur Android : ouvrez EGE 2027 dans Chrome, appuyez sur le menu ⋮, puis choisissez « Installer l’application » ou « Ajouter à l’écran d’accueil ». Si vous utilisez un navigateur intégré à une autre application, ouvrez d’abord le lien dans Chrome.\";\n }else{\n  content.textContent=\"Ouvrez EGE 2027 dans un navigateur compatible. Utilisez l’option « Installer l’application » dans la barre d’adresse ou dans le menu du navigateur.\";\n }\n if(typeof dialog.showModal===\"function\")dialog.showModal();\n else dialog.setAttribute(\"open\",\"\");\n}\nasync function installEGE(){\n if(egeIsInstalled()){toast(\"EGE 2027 est déjà installée sur cet appareil.\");refreshInstallButtons();return}\n if(egeInstallInProgress)return;\n if(!egeInstallPrompt){explainInstall();return}\n const prompt=egeInstallPrompt;egeInstallPrompt=null;\n egeInstallInProgress=true;\n refreshInstallButtons();\n try{\n  await prompt.prompt();\n  const result=await prompt.userChoice;\n  if(result?.outcome===\"accepted\")toast(\"Installation acceptée. Suivez les indications de votre appareil.\");\n  else toast(\"Installation annulée. Vous pouvez réessayer depuis le navigateur.\");\n }catch(err){egeInstallPrompt=null;explainInstall()}\n finally{egeInstallInProgress=false;refreshInstallButtons()}\n}\nwindow.addEventListener(\"beforeinstallprompt\",event=>{\n event.preventDefault();\n egeInstallPrompt=event;\n refreshInstallButtons();\n});\nwindow.addEventListener(\"appinstalled\",()=>{\n egeAppInstalled=true;egeInstallPrompt=null;\n toast(\"EGE 2027 est installée.\");\n refreshInstallButtons();\n});\n\nasync function dispatchClick(e){\n const el=e.target.closest(\"[data-act]\");if(!el)return;\n e.preventDefault();const a=el.dataset.act,id=el.dataset.id,mode=el.dataset.mode;\n if(st.terrainUploading){toast('Patientez pendant l’importation de l’image.');return}\n try{\n  if(a.startsWith('terrain-')){await terrainAction(a,el);return}\n  if(a===\"toggle-password\"){\n   const input=$(el.dataset.target);\n   if(!input||![\"authPassword\",\"newPassword\"].includes(input.id))return;\n   const visible=input.type===\"password\";\n   input.type=visible?\"text\":\"password\";\n   el.setAttribute(\"aria-label\",visible?\"Masquer le mot de passe\":\"Afficher le mot de passe\");\n   el.setAttribute(\"title\",visible?\"Masquer le mot de passe\":\"Afficher le mot de passe\");\n   el.setAttribute(\"aria-pressed\",visible?\"true\":\"false\");\n   el.innerHTML=I(visible?\"eye-off\":\"eye\");\n   input.focus({preventScroll:true});\n   return;\n  }\n  if(a===\"install\"){await installEGE();return}\n  if(a===\"close-install\"){\n   const dialog=document.getElementById(\"egeInstallDialog\");\n   if(dialog?.close)dialog.close();else dialog?.removeAttribute(\"open\");\n   return;\n  }\n  if(a===\"ad-next\"||a===\"ad-prev\"||a===\"ad-slide\"){\n   const place=el.dataset.slot;\n   if(!EGE_AD_SLOTS.some(item=>item.id===place))return;\n   const step=a===\"ad-prev\"?-1:1;\n   const ix=a===\"ad-slide\"?Number(el.dataset.slide):null;\n   if(ix!==null&&!Number.isInteger(ix))return;\n   egeMoveCarousel(place,step,ix,true,e.detail===0);\n   return;\n  }\n  if(a===\"refresh-ads\"){await loadAds();render();return}\n  if(a===\"ad-info\"){egeShowAdInfo(id);return}\n  if(a===\"ad-close\"){const dialog=document.getElementById(\"egeAdDialog\");if(dialog?.close)dialog.close();else dialog?.removeAttribute(\"open\");return}\n  if([\"ad-approve\",\"ad-save-positions\",\"ad-pause\",\"ad-reject\"].includes(a)){\n   await egeAdminUpdateAd(id,a===\"ad-approve\"?\"approve\":a===\"ad-pause\"?\"pause\":a===\"ad-reject\"?\"reject\":\"save\");\n   return;\n  }\n  if(a===\"goto\"){go(el.dataset.to);return}\n  if(a===\"role\"){choiceRole(el.dataset.role);return}\n  if(a===\"mode\"){st.mode=mode;if(st.screen===\"profile\"){st.screen=\"auth\";st.desired=st.role}render();return}\n  if(a===\"refresh\"){await loadAll();toast(\"Données actualisées.\");return}\n  if(a===\"logout\"){if(await window.MBDialog.confirm('Voulez-vous vous déconnecter de monAvenir ?'))await signOut();return}\n  if(a===\"newdoc\"){\n   if(st.draft&&st.saveBadge!==\"Enregistré en ligne\"){\n    const done=await saveDoc({silent:true});if(!done)throw Error(\"Votre brouillon actuel n'est pas synchronisé. Sauvegardez-le avant de créer un autre dossier.\");\n   }\n   await createDoc();return\n  }\n  if(a===\"opendoc\"){await selectAndGoDoc(id,el.dataset.to||\"student-wizard\");return}\n  if(a===\"annex\"){st.annex=Number(el.dataset.n)||1;if(st.screen!==\"student-annex\")st.screen=\"student-annex\";render();return}\n  if(a===\"legacy\"){await legacyEditor();return}\n  if(a===\"archive\"){await archiveDoc(id);return}\n  if(a===\"wizard\"){st.wizardStep=Number(el.dataset.n)||1;render();return}\n  if(a===\"wizard-next\"){EGEStage.mark([\"\",\"identity\",\"subject\",\"problem\"][st.wizardStep],st.draft);st.wizardStep=Math.min(4,st.wizardStep+1);await saveDoc({silent:true});render();return}\n  if(a===\"wizard-prev\"){st.wizardStep=Math.max(1,st.wizardStep-1);render();return}\n  if(a===\"save\"){await saveDoc();render();return}\n  if(a===\"restore-draft\"){if(!st.localCandidate)return;st.draft=st.localCandidate;st.localCandidate=null;st.warning=\"Brouillon local récupéré, à synchroniser.\";markPending(\"À synchroniser\");saveLocalDraft();render();return}\n  if(a===\"join\"){await joinGroup();return}\n  if(a===\"associate\"){await associateDoc();return}\n  if(a===\"leave\"){await leaveGroup(id);return}\n  if(a===\"teacher-create\"){st.teacherOpen=!st.teacherOpen;if(st.screen!==\"teacher-groups\"){st.screen=\"teacher-groups\"}render();return}\n  if(a===\"teacher-select\"){st.selectedGroupId=id;go(\"teacher-students\");return}\n  if(a===\"teacher-review\"){st.selectedDocId=id;st.reviewAnnex=1;go(\"teacher-review\");return}\n  if(a===\"teacher-annex\"){st.reviewAnnex=Number(el.dataset.n)||1;render();return}\n  if(a===\"remove-student\"){await removeStudent(el.dataset.group,id);return}\n  if(a===\"group-rename\"||a===\"group-toggle\"){await changeGroup(id,a===\"group-rename\"?\"rename\":\"toggle\");return}\n  if(a===\"copy\"){const code=el.dataset.code;if(!code)return;if(navigator.clipboard?.writeText)await navigator.clipboard.writeText(code);toast(\"Code copié : \"+code);return}\n  if(a===\"request-status\"){await approveTeacher(id,el.dataset.status);return}\n  if(a===\"review\"){await teacherDecision(id,el.dataset.decision);return}\n  if(a===\"admin-create\"){st.adminOpen=!st.adminOpen;render();return}\n  if(a===\"admin-group\"){st.selectedGroupId=id;go(\"admin-groups\");return}\n  if(a===\"admin-tab\"){st.adminTab=mode;render();return}\n  if(a===\"admin-read\"){st.selectedDocId=id;st.adminTab=\"preview\";go(\"admin-monitor\");return}\n  if(a===\"save-settings\"){await saveSettings();return}\n  if(a===\"reset-password\"){await recoverPassword();return}\n  if(a===\"profile-changepass\"){st.pendingPasswordReset=true;go(\"auth\");return}\n  if(a===\"preview\"){document.querySelector(\"#paper\")?.scrollIntoView({block:\"start\",behavior:\"smooth\"});return}\n  if(a===\"signup-info\"){toast(\"Utilisez le formulaire d'inscription pour créer votre compte.\");return}\n }catch(error){fail(error);render()}\n}\nasync function dispatchSubmit(e){\n if(![\"authForm\",\"studentProfileForm\",\"pricingAdminForm\",\"groupJoinForm\",\"groupShareForm\",\"teacherNewGroupForm\",\"adminNewGroupForm\",\"egeAdTeacherForm\",\"egeAdAdminForm\"].includes(e.target.id))return;\n e.preventDefault();\n if(st.busy)return;st.busy=true;\n const adForm=[\"egeAdTeacherForm\",\"egeAdAdminForm\"].includes(e.target.id)?e.target:null;\n const retainedForm=adForm||([\"authForm\",\"studentProfileForm\",\"pricingAdminForm\"].includes(e.target.id)?e.target:null);\n let succeeded=false;\n const submitButton=retainedForm?.querySelector('[type=\"submit\"]');\n const buttonLabel=submitButton?.textContent;\n retainedForm?.querySelector('[data-ad-error]')?.remove();\n if(submitButton){submitButton.disabled=true;submitButton.textContent=\"Envoi en cours…\"}\n try{\n  if(e.target.id===\"authForm\"){await doLogin(st.mode)}\n  else if(e.target.id===\"studentProfileForm\")await saveStudentProfile();\n  else if(e.target.id===\"pricingAdminForm\")await savePricing();\n  else if(e.target.id===\"groupJoinForm\")await joinGroup();\n  else if(e.target.id===\"groupShareForm\")await associateDoc();\n  else if(e.target.id===\"teacherNewGroupForm\")await createGroup();\n  else if(e.target.id===\"adminNewGroupForm\")await adminGroupCreate();\n  else if(e.target.id===\"egeAdTeacherForm\")await egeSubmitTeacherAd();\n  else if(e.target.id===\"egeAdAdminForm\")await egeAdminCreateAd();\n  succeeded=true;\n }catch(error){\n  fail(error);\n  if(retainedForm){\n   const message=document.createElement(\"p\");message.dataset.adError=\"\";\n   message.setAttribute(\"role\",\"alert\");message.textContent=error.message||\"L’envoi a échoué. Vos informations sont conservées. Réessayez.\";\n   retainedForm.append(message);\n  }\n }\n finally{\n  st.busy=false;\n  if(submitButton){submitButton.disabled=false;submitButton.textContent=buttonLabel}\n  if(!adForm&&(succeeded||!retainedForm))render();\n }\n}\nfunction dispatchInput(e){\n const el=e.target,field=el.dataset.field;\n if(field){void setDraftField(field,el.type===\"checkbox\"?el.checked:el.value).catch(fail);\n  if(field.startsWith(\"annex_\")){\n   const key=field.split(\"_\")[1],v=el.value,previewEl=key===\"title\"?$(\"paperTitle\"):key===\"body\"?$(\"paperBody\"):key===\"source\"?$(\"paperSource\"):null;\n   if(previewEl)previewEl.textContent=v||\"À renseigner\";\n   const wc=$(\"wordCount\");if(wc&&key===\"body\")wc.textContent=(cleaned(v).match(/\\S+/g)||[]).length+\" mots\";\n  }\n }\n if(el.id===\"docSearch\"){st.filter=el.value;const list=$(\"docsList\");if(list)list.innerHTML=docRows()}\n if(el.id===\"groupSelect\"){st.selectedGroupId=el.value;render();}\n if(el.id===\"adminTeacherFilter\"){st.selectedGroupId=el.value;render();}\n}\ndocument.addEventListener(\"click\",dispatchClick);\ndocument.addEventListener(\"submit\",dispatchSubmit);\ndocument.addEventListener(\"input\",dispatchInput);\ndocument.addEventListener(\"change\",e=>{\n const el=e.target;\n if(el.id===\"authSeries\"||el.id===\"profileSeries\"){\n  const select=$(el.id===\"authSeries\"?\"authClass\":\"profileClass\");\n  if(select){select.innerHTML=EGEAcademic.options(EGEAcademic.classes[el.value]||[],\"\",\"Choisir une classe\");select.disabled=!EGEAcademic.series.includes(el.value)}\n }\n if(el.id===\"annexTab\"){st.annex=Number(el.value);render()}\n if(el.id===\"groupSelect\"){st.selectedGroupId=el.value;render()}\n if(el.id===\"dTheme\"){render()}\n if(el.dataset.field===\"dMode\"){render()}\n});\nasync function saveStudentProfile(){\n if(!st.user||st.role!==\"eleve\")throw Error(\"Connectez-vous à votre espace élève.\");\n const series=cleaned($(\"profileSeries\")?.value),class_name=cleaned($(\"profileClass\")?.value),school=cleaned($(\"profileSchool\")?.value);\n if(!EGEAcademic.series.includes(series)||!EGEAcademic.classes[series].includes(class_name))throw Error(\"Choisissez votre série et une classe de cette série.\");\n if(!EGEAcademic.schools.includes(school))throw Error(\"Choisissez votre établissement.\");\n const {data,error}=await st.db.auth.updateUser({data:{series,class_name,school}});\n if(error)throw error;\n st.user=data.user;toast(\"Profil enregistré. Ces informations seront reprises dans vos nouveaux dossiers.\");\n}\nwindow.addEventListener(\"online\",()=>{if(window.EGEStudyUI&&window.EGEOffline?.enabled(st.user?.id)){EGEStudyUI.reconnect();return}if(st.role===\"eleve\"&&st.draft&&st.saveBadge!==\"Enregistré en ligne\")saveDoc({silent:true}).then(()=>render())});\ndocument.addEventListener(\"DOMContentLoaded\",()=>initApp());\n\n// Tarifs futurs. Cette version ne contient aucun encaissement ni contrôle d'accès payant.\nconst EGE_PRICING_COLUMNS='student_monthly_fdj,premium_weekly_fdj,premium_monthly_fdj,standard_ad_fdj,payment_methods,payment_instructions,monetization_enabled';\nconst EGE_PRICING_DEFAULTS=Object.freeze({student_monthly_fdj:300,premium_weekly_fdj:1000,premium_monthly_fdj:3000,standard_ad_fdj:500,payment_methods:[],payment_instructions:'',monetization_enabled:false});\nasync function loadPricing(){\n if(!st.db)return;\n try{\n  const {data,error}=await st.db.from('ege2027_settings').select(EGE_PRICING_COLUMNS).eq('id',1).single();\n  if(error)throw error;\n  st.pricing={...EGE_PRICING_DEFAULTS,...data,monetization_enabled:false};st.pricingError='';\n }catch(error){st.pricing={...EGE_PRICING_DEFAULTS};st.pricingError='Les tarifs enregistrés sont momentanément indisponibles.';}\n}\nfunction egePricing(){return st.pricing||EGE_PRICING_DEFAULTS}\nfunction egeFDJ(amount){return new Intl.NumberFormat('fr-FR').format(amount)+' FDJ'}\nasync function savePricing(){\n if(st.role!=='admin'||!st.user||!st.db)throw Error('Accès administrateur nécessaire.');\n if(st.pricingError)throw Error('Actualisez les tarifs enregistrés avant de les modifier.');\n const changes={updated_by:st.user.id,updated_at:new Date().toISOString()};\n for(const field of ['student_monthly_fdj','premium_weekly_fdj','premium_monthly_fdj','standard_ad_fdj']){\n  const raw=cleaned($('fee_'+field)?.value);\n  const value=Number(raw);\n  if(raw===''||!Number.isInteger(value)||value<0||value>100000000)throw Error('Saisissez des montants entiers entre 0 et 100 000 000 FDJ.');\n  changes[field]=value;\n }\n const methods=[...new Set(cleaned($('fee_payment_methods')?.value).split(/\\r?\\n/).map(cleaned).filter(Boolean))];\n if(methods.length>5||methods.some(value=>value.length>80))throw Error('Indiquez au maximum cinq moyens de paiement, un par ligne (80 caractères chacun).');\n const instructions=cleaned($('fee_payment_instructions')?.value);\n if(instructions.length>1200)throw Error('Les consignes doivent contenir au maximum 1 200 caractères.');\n changes.payment_methods=methods;changes.payment_instructions=instructions;\n // Aucun champ d'activation n'est transmis. La gratuité est également imposée en base.\n const {data,error}=await st.db.from('ege2027_settings').update(changes).eq('id',1).select(EGE_PRICING_COLUMNS).single();\n if(error)throw error;\n st.pricing={...data,monetization_enabled:false};st.pricingError='';\n toast('Tarifs futurs enregistrés. L’application reste gratuite.');render();\n}\n\nconst egeTerrainTabs=[['enterprise','Entreprise'],['professional','Professionnel'],['interview','Guide d’entretien'],['comparison','Tableau comparatif'],['synthesis','Synthèse']];\nlet egeTerrainTab='enterprise';\nconst egeTerrainImages=new Map();\nfunction terrainTopic(payload){const series=EGEAcademic.seriesOf(payload),catalog=EGEAcademic.catalogFor(payload,official);return catalog[payload.theme]?.subthemes?.[payload.subtheme]||''}\nfunction terrainField(key,t,{type='text',textarea=false,help=''}={}){\n const [label,max]=EGETerrain.fields[key];\n return `<label class=\"field\"><span>${esc(label)}</span>${textarea?`<textarea class=\"textarea\" data-terrain-field=\"${key}\" maxlength=\"${max}\" rows=\"${key==='synthesis'?18:4}\">${esc(t[key])}</textarea>`:`<input class=\"input\" type=\"${type}\" data-terrain-field=\"${key}\" maxlength=\"${max}\" value=\"${esc(t[key])}\">`}${help?`<small class=\"muted\">${esc(help)}</small>`:''}</label>`;\n}\nfunction terrainImagePicker(kind,label,t){\n return `<div class=\"card\" style=\"padding:16px\"><h3>${label}</h3>${t[kind]?`<img data-terrain-imagepath=\"${esc(t[kind].path)}\" alt=\"${label} fourni par l’élève\" style=\"display:block;max-width:100%;max-height:330px;object-fit:contain;margin:12px auto\"><button type=\"button\" class=\"btn smol\" data-act=\"terrain-remove-image\" data-kind=\"${kind}\">Retirer cette image du dossier</button>`:''}<label class=\"field\"><span>${t[kind]?'Remplacer':'Importer'} l’image</span><input type=\"file\" data-terrain-file=\"${kind}\" accept=\"image/jpeg,image/png,image/webp\" ${st.terrainUploading?'disabled':''}><small class=\"muted\">JPG, PNG ou WebP. Image stockée dans l’espace privé du dossier.</small></label></div>`;\n}\nfunction terrainPage(){\n if(!st.draft)return `${title('Partie terrain','Ouvrir un dossier','Choisissez le dossier auquel rattacher votre entreprise et votre entretien.')}${box(btn('Mes dossiers','goto','btn primary','folder','data-to=\"student-docs\"'))}`;\n const p=st.draft,t=EGETerrain.normalize(p.terrain,p),progress=EGETerrain.progress(p),count=p.mode==='binome'?4:3;\n let content='';\n if(egeTerrainTab==='enterprise')content=`<h2>Présentation de l’entreprise</h2><p class=\"small muted\">Historique, fiche d’identité, vision et stratégie, logo et organigramme, selon la structure du modèle Nassima.</p>${['organizationName','legalForm','creationDate','address','employees','turnover','activities','scope','history','visionStrategy','organizationSource'].map(key=>terrainField(key,t,{textarea:['activities','history','visionStrategy','organizationSource'].includes(key)})).join('')}${terrainImagePicker('logo','Logo de l’entreprise',t)}${terrainImagePicker('organizationChart','Organigramme',t)}${terrainField('organizationChartText',t,{textarea:true,help:'Décrivez la direction, les services et les liens hiérarchiques, notamment si vous n’avez pas d’image.'})}`;\n if(egeTerrainTab==='professional')content=`<h2>Le professionnel interrogé</h2>${terrainField('professionalName',t)}${terrainField('professionalRole',t)}<label class=\"field\"><span>Statut de l’entretien</span><select class=\"select\" data-terrain-field=\"interviewStatus\"><option value=\"planned\" ${t.interviewStatus!=='done'?'selected':''}>À préparer</option><option value=\"done\" ${t.interviewStatus==='done'?'selected':''}>Réalisé</option></select></label>${terrainField('interviewDate',t,{type:'date',help:'Indiquez la date réelle une fois l’entretien effectué.'})}${terrainField('interviewMethod',t,{help:'Ex. : face à face, téléphone ou visioconférence.'})}${terrainField('interviewDifficulties',t,{textarea:true})}`;\n if(egeTerrainTab==='interview')content=`<h2>Guide d’entretien</h2><p class=\"small muted\">Saisissez vos propres questions et les réponses réellement données par le professionnel. Le rattachement à une annexe permet de préparer un tableau comparatif pertinent.</p>${t.questions.map((q,i)=>`<fieldset style=\"border:1px solid #dbe2ea;border-radius:14px;padding:16px;margin:10px 0\"><legend>Question ${i+1}</legend><label class=\"field\"><span>Question de l’élève</span><textarea class=\"textarea\" rows=\"2\" data-terrain-question=\"${i}\" data-part=\"question\" maxlength=\"1200\">${esc(q.question)}</textarea></label><label class=\"field\"><span>Réponse du professionnel</span><textarea class=\"textarea\" rows=\"4\" data-terrain-question=\"${i}\" data-part=\"answer\" maxlength=\"6000\">${esc(q.answer)}</textarea></label><label class=\"field\"><span>Annexe concernée</span><select class=\"select\" data-terrain-question=\"${i}\" data-part=\"annex\"><option value=\"0\">${q.question.trim().replace(/’/g,\"'\")===\"Quelle est l'activité principale de votre entreprise ?\"?'Présentation de l’entreprise':'Proposer un rapprochement, à vérifier'}</option>${Array.from({length:count},(_,n)=>`<option value=\"${n+1}\" ${q.annex===n+1?'selected':''}>Annexe ${n+1} — ${esc(getTitle(n+1,p))}</option>`).join('')}</select></label><button class=\"btn smol\" type=\"button\" data-act=\"terrain-remove-question\" data-index=\"${i}\">Retirer cette question</button></fieldset>`).join('')}<button type=\"button\" class=\"btn\" data-act=\"terrain-add-question\" ${t.questions.length>=20?'disabled':''}>Ajouter une question</button>`;\n if(egeTerrainTab==='comparison'){\n  const stale=!!(t.comparisonSignature&&t.comparisonSignature!==EGETerrain.comparisonSignature(p));\n  content=`<h2>Tableau comparatif</h2><p class=\"small muted\">L’application rapproche les extraits de vos annexes et les réponses de l’entretien. Vérifiez chaque rapprochement et corrigez les textes. Les similitudes et différences doivent décrire ce que vos informations permettent réellement de constater.</p>${stale?'<p class=\"ege-feedback\" role=\"status\">Les sources ont changé depuis la préparation du tableau. Actualisez-le ou relisez et corrigez ses lignes.</p>':''}<button type=\"button\" class=\"btn primary\" data-act=\"terrain-generate-comparison\">${t.comparisons.length?'Actualiser':'Préparer'} le tableau</button>${t.comparisons.map((r,i)=>`<section style=\"border:1px solid #dbe2ea;border-radius:14px;padding:16px;margin:15px 0\"><h3>Annexe ${i+1} — ${esc(getTitle(i+1,p))}</h3><label class=\"field\"><span>Recherches documentaires</span><textarea class=\"textarea\" data-terrain-comparison=\"${i}\" data-part=\"theory\" maxlength=\"6000\" rows=\"5\">${esc(r.theory)}</textarea></label><label class=\"field\"><span>Contextualisation sur le terrain</span><textarea class=\"textarea\" data-terrain-comparison=\"${i}\" data-part=\"practice\" maxlength=\"12000\" rows=\"5\" placeholder=\"Rattachez une réponse du professionnel à cette annexe.\">${esc(r.practice)}</textarea></label></section>`).join('')}${terrainField('similarities',t,{textarea:true})}${terrainField('differences',t,{textarea:true})}<label style=\"display:flex;gap:10px;align-items:flex-start\"><input type=\"checkbox\" data-terrain-review=\"comparisonReviewed\" ${t.comparisonReviewed&&!stale?'checked':''}> J’ai relu les deux colonnes et vérifié que les réponses correspondent aux annexes.</label>`;\n }\n if(egeTerrainTab==='synthesis'){\n  const stale=!!(t.synthesisSignature&&t.synthesisSignature!==EGETerrain.synthesisSignature(p));\n  content=`<h2>Synthèse rédigée</h2><p class=\"small muted\">Introduction, recherche documentaire, contextualisation sur le terrain et conclusion, selon le modèle Nassima. La proposition reprend vos informations et vos réponses ; complétez la réponse personnelle à la problématique et vérifiez les conclusions.</p>${stale?'<p class=\"ege-feedback\" role=\"status\">Des informations ont changé depuis la dernière synthèse. Relisez et actualisez ce texte.</p>':''}<button class=\"btn primary\" type=\"button\" data-act=\"terrain-generate-synthesis\">Préparer une proposition de synthèse</button>${terrainField('synthesis',t,{textarea:true})}<label style=\"display:flex;gap:10px;align-items:flex-start\"><input type=\"checkbox\" data-terrain-review=\"synthesisReviewed\" ${t.synthesisReviewed&&!stale?'checked':''}> J’ai relu, corrigé et complété la synthèse et sa conclusion.</label><p class=\"small muted\">La relecture de l’élève ne remplace pas la validation du professeur.</p>`;\n }\n const issues=EGETerrain.interviewIssues(t);\n return `${title('Contextualisation de la théorie','Ma partie terrain','Entreprise → professionnel → entretien → comparaison → synthèse.',btn('Enregistrer','save','btn primary','check'))}${st.warning?`<div class=\"ege-feedback\" role=\"status\">${esc(st.warning)}</div>`:''}<div class=\"notice info\"><span>Avancement : ${progress.done} / ${progress.total} rubriques préparées et relues. <strong id=\"saveState\">${esc(st.saveBadge)}</strong></span></div><div class=\"tabset\" style=\"flex-wrap:wrap\">${egeTerrainTabs.map(([key,label])=>`<button type=\"button\" class=\"tab ${egeTerrainTab===key?'active':''}\" data-act=\"terrain-tab\" data-tab=\"${key}\">${label}</button>`).join('')}</div>${issues.length?`<p class=\"ege-feedback\" role=\"status\">${issues.map(esc).join(' ')}</p>`:''}${st.terrainUploading?'<p role=\"status\">Importation de l’image en cours…</p>':''}<section class=\"card ege-forms\" style=\"max-width:960px\">${content}</section><div class=\"inline-actions\" style=\"margin-top:18px\">${btn('Ouvrir le Word complet','legacy','btn primary','download')}${btn('Mes annexes','goto','btn','file','data-to=\"student-annex\"')}</div>`;\n}\nfunction touchTerrain(){\n saveLocalDraft();markPending(navigator.onLine?'Modifications en attente':'Hors connexion — brouillon conservé');\n clearTimeout(st.saveTimer);st.saveTimer=setTimeout(()=>saveDoc({silent:true}).catch(fail),1300);\n}\nfunction terrainInput(event){\n const el=event.target;if(!el?.dataset||st.role!=='eleve'||!st.draft)return;\n const d=el.dataset;if(!('terrainField' in d||'terrainQuestion' in d||'terrainComparison' in d||'terrainReview' in d))return;\n const t=EGETerrain.normalize(st.draft.terrain,st.draft);\n if(d.terrainField){\n  const key=d.terrainField;\n  if(key==='interviewStatus')t[key]=el.value==='done'?'done':'planned';\n  else if(EGETerrain.fields[key])t[key]=el.value.slice(0,EGETerrain.fields[key][1]);else return;\n  if(key==='organizationName')st.draft.company=t.organizationName;\n  t.synthesisReviewed=false;\n }\n if('terrainQuestion' in d){const q=t.questions[Number(d.terrainQuestion)];if(!q||!['question','answer','annex'].includes(d.part))return;q[d.part]=d.part==='annex'?Number(el.value):el.value.slice(0,d.part==='question'?1200:6000);t.comparisonReviewed=false;t.synthesisReviewed=false;}\n if('terrainComparison' in d){const row=t.comparisons[Number(d.terrainComparison)];if(!row||!['theory','practice'].includes(d.part))return;row[d.part]=el.value.slice(0,d.part==='theory'?6000:12000);t.comparisonReviewed=false;t.synthesisReviewed=false;}\n if('terrainReview' in d){\n  if(d.terrainReview==='comparisonReviewed'){if(!t.comparisons.length){el.checked=false;toast('Préparez d’abord le tableau.');return}t.comparisonReviewed=el.checked;t.comparisonSignature=EGETerrain.comparisonSignature({...st.draft,terrain:t});t.synthesisReviewed=false;}\n  else if(d.terrainReview==='synthesisReviewed'){if(!t.synthesis.trim()){el.checked=false;toast('Préparez d’abord la synthèse.');return}t.synthesisReviewed=el.checked;t.synthesisSignature=EGETerrain.synthesisSignature({...st.draft,terrain:t});}\n }\n st.draft.terrain=t;\n if(d.terrainField==='synthesis')t.synthesisSignature=EGETerrain.synthesisSignature(st.draft);\n touchTerrain();\n}\nasync function terrainAction(action,el){\n if(st.role!=='eleve'||!st.draft)throw Error('Ouvrez votre dossier dans l’espace élève.');\n if(st.terrainUploading)throw Error('Patientez pendant l’importation de l’image.');\n if(action==='terrain-tab'){egeTerrainTab=egeTerrainTabs.some(([k])=>k===el.dataset.tab)?el.dataset.tab:'enterprise';render();return}\n const t=EGETerrain.normalize(st.draft.terrain,st.draft);\n if(action==='terrain-add-question'){if(t.questions.length>=20)return;t.questions.push({question:'',answer:'',annex:0})}\n if(action==='terrain-remove-question'){const i=Number(el.dataset.index),q=t.questions[i];if(!q)return;if((q.question||q.answer)&&!await window.MBDialog.confirm('Retirer cette question et sa réponse du dossier ?'))return;t.questions.splice(i,1);t.comparisonReviewed=false;t.synthesisReviewed=false;}\n if(action==='terrain-remove-image'){const kind=el.dataset.kind;if(!['logo','organizationChart'].includes(kind))return;t[kind]=null;t.synthesisReviewed=false;}\n if(action==='terrain-generate-comparison'){\n  if(t.comparisons.some(r=>r.theory||r.practice)&&!await window.MBDialog.confirm('Remplacer les lignes actuelles du tableau par une nouvelle proposition à partir des annexes et de l’entretien ?'))return;\n  const result=EGETerrain.prepareComparison(st.draft);st.draft.terrain=result.terrain;\n  touchTerrain();render();toast(result.unmatched.length?'Tableau préparé. Réponses à rattacher : '+result.unmatched.join(', ')+'.':'Tableau préparé : relisez les rapprochements proposés.');return;\n }\n if(action==='terrain-generate-synthesis'){\n  if(t.synthesis&&!await window.MBDialog.confirm('Remplacer la synthèse actuelle par une nouvelle proposition ?'))return;\n  st.draft.terrain=EGETerrain.generateSynthesis(st.draft,terrainTopic(st.draft));touchTerrain();render();toast('Proposition préparée. Relisez, complétez et validez le texte.');return;\n }\n st.draft.terrain=t;touchTerrain();render();\n}\nasync function terrainFile(event){\n const el=event.target,kind=el?.dataset?.terrainFile,file=el?.files?.[0];\n if(!navigator.onLine||st.offlineSession){toast('L’ajout d’images nécessite Internet. Vous pouvez continuer à rédiger.');return}\n if(!kind||!file)return;\n if(st.role!=='eleve'||!st.draft||st.terrainUploading){el.value='';return}\n const dossierId=st.selectedDocId,userId=st.user?.id;st.terrainUploading=true;el.disabled=true;\n try{\n  const asset=await EGETerrain.uploadImage(file,kind,{db:st.db,userId,dossierId});\n  if(st.selectedDocId!==dossierId||st.user?.id!==userId)throw Error('Le dossier ouvert a changé. Rouvrez le dossier initial pour y ajouter cette image.');\n  st.draft.terrain=EGETerrain.normalize(st.draft.terrain,st.draft);st.draft.terrain[kind]=asset;touchTerrain();\n  await saveDoc({silent:true});toast('Image ajoutée au dossier.');\n }catch(error){fail(error)}finally{st.terrainUploading=false;el.disabled=false;el.value='';render()}\n}\nasync function refreshTerrainImages(){\n const nodes=[...document.querySelectorAll('[data-terrain-imagepath]')];\n await Promise.allSettled(nodes.map(async node=>{\n  const path=node.dataset.terrainImagepath;let cached=egeTerrainImages.get(path);\n  if(!navigator.onLine||st.offlineSession){const local=await window.EGEOffline?.imageURL(path);if(local&&node.isConnected){node.src=local;return}if(node.isConnected)node.alt=\"Image non préparée sur cet appareil. Reconnectez-vous pour la charger.\";return}\n  try{\n   if(!cached||cached.expires<Date.now()){\n    const {data,error}=await st.db.storage.from(EGETerrain.BUCKET).createSignedUrl(path,120);if(error)throw error;\n    cached={url:data.signedUrl,expires:Date.now()+90000};egeTerrainImages.set(path,cached);\n   }\n   if(node.isConnected)node.src=cached.url;\n  }catch(_){if(node.isConnected)node.alt='Image privée indisponible : reconnectez-vous ou ajoutez-la de nouveau.';}\n }));\n}\ndocument.addEventListener('input',terrainInput);\ndocument.addEventListener('change',event=>{if(event.target?.dataset?.terrainFile)terrainFile(event);else if(event.target?.type==='checkbox')terrainInput(event)});\n"],"/mon-bac-ege-ai-article-r2-interview-r1-titles-r1.js":["application/javascript; charset=utf-8",false,"\n(()=>{'use strict';\nconst EGE_INTRO_QUESTION=\"Quelle est l'activité principale de votre entreprise ?\";\nfunction egeIntroQuestion(q){const s=String(q?.question||q||'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().replace(/[’']/g,' ').replace(/[^\\p{L}\\p{N} ]/gu,' ').replace(/\\s+/g,' ').trim();return s==='quelle est l activite principale de votre entreprise'}\nconst names={problem:'3 problématiques',annex:'Une annexe',interview:'Les questions d’entretien',comparison:'Le tableau comparatif',synthesis:'La synthèse'};\nconst stageFor=k=>k==='topic'?'problem':/^a[1-4]$/.test(k)?'annex':['interview','comparison','synthesis'].includes(k)?k:'';\nconst owner=()=>st.role==='eleve'&&!!st.user&&!!st.draft&&currentDoc()?.owner_id===st.user.id;\nfunction panel(k){const s=stageFor(k);if(!s)return '';return '<details class=\"card\" style=\"margin:0 0 12px;padding:12px\"><summary style=\"cursor:pointer;font-weight:700\">Suggestion IA · '+esc(names[s])+'</summary><p class=\"small muted\" style=\"margin:8px 0\">Gratuite dans la limite du quota quotidien. Vérifiez les propositions et les sources ; aucune donnée de terrain n’est inventée.</p><button type=\"button\" class=\"btn primary\" data-ege-ai=\"'+esc(k)+'\" style=\"width:100%\">Proposer</button><p class=\"small muted\" data-ege-ai-status role=\"status\"></p></details>'}\nfunction redactor(p,t){const identities=[p.student,p.partner,p.teacher,p.company,t.professionalName,t.organizationName,st.profile?.full_name,st.profile?.email,st.profile?.whatsapp_number].filter(x=>typeof x==='string'&&x.trim().length>=4).map(x=>x.trim());return (x,max=0)=>{let s=String(x||'');for(const x of identities)s=s.split(x).join('[identité retirée]');s=s.replace(/[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}/g,'[courriel retiré]').replace(/(?:\\+253[\\s.-]*(?:\\d[\\s.-]*){8}|(?:tél(?:éphone)?|portable|whatsapp)\\s*[:.]?\\s*(?:\\d[\\s.-]*){8,12})/gi,'[numéro retiré]');return max?s.slice(0,max):s}}\nfunction collect(k){\n if(!owner())throw Error('Ouvrez votre dossier EGE personnel.');\n const p=st.draft,t=EGETerrain.normalize(p.terrain,p),topic=EGEStudy.topic(p,official),s=stageFor(k),mode=p.mode==='binome'?'binome':'individuel',n=mode==='binome'?4:3,red=redactor(p,t);\n if(!topic.theme||!topic.subtheme)throw Error('Choisissez le thème et le sous-thème officiels.');\n const data={mode,theme:topic.theme,subtheme:topic.subtheme};\n if(s==='problem')return data;\n if(!p.problem?.trim())throw Error('Rédigez ou choisissez votre problématique.');\n data.problem=red(p.problem);\n if(s==='annex')data.annex=Number(k.slice(1));\n const limit=s==='annex'?850:s==='interview'?1200:750;\n const interviewExcerpt=x=>{const v=red(x);if(v.length<=limit)return v;const middle=Math.floor(v.length/2),first=Math.floor(limit*.36),half=Math.floor(limit*.14),last=Math.floor(limit*.32);return v.slice(0,first)+' … '+v.slice(middle-half,middle+half)+' … '+v.slice(-last)};\n data.annexes=Array.from({length:n},(_,i)=>({number:i+1,title:red(getTitle(i+1,p),190),text:['interview','annex'].includes(s)?interviewExcerpt(p.annexes?.[i+1]):red(p.annexes?.[i+1],limit),...(s==='annex'?{source:safeSource(String(p.sources?.[i+1]||'').match(/https:\\/\\/[^\\s<>\"']+/i)?.[0])}: {})})).filter(a=>s!=='annex'||a.number!==data.annex);\n if(s==='interview'&&t.questions.some(q=>q.answer.trim()))throw Error('Des réponses existent déjà. Pour les conserver, modifiez les questions manuellement.');\n if(s==='interview'&&data.annexes.some(a=>!a.text.trim()))throw Error('Rédigez d’abord les annexes afin de préparer des questions pertinentes.');\n if(['comparison','synthesis'].includes(s)){\n  if(t.interviewStatus!=='done')throw Error('Indiquez que l’entretien a réellement été réalisé dans Professionnel.');\n  if(t.questions.some(q=>q.answer.trim()&&(!q.question.trim()||(!egeIntroQuestion(q)&&(q.annex<1||q.annex>n)))))throw Error('Rattachez chaque réponse réelle à une question et à une annexe.');\n  const intro=t.questions.find(q=>egeIntroQuestion(q)&&q.answer.trim());if(intro)data.companyActivity=red(intro.answer,300);const answered=t.questions.filter(q=>q.question.trim()&&q.answer.trim()&&!egeIntroQuestion(q));\n  if(!answered.length)throw Error('Renseignez au moins une réponse réelle aux questions liées aux annexes.');\n  if(data.annexes.some(a=>!a.text.trim()))throw Error('Complétez les annexes avant de comparer.');\n  data.excerptNotice='Les extraits sont limités en longueur ; ne déduis jamais de faits non présents.';data.excerptNotice='Les extraits sont limités en longueur ; ne déduis jamais de faits non présents.';data.answers=answered.map(q=>({annex:q.annex,question:red(q.question,220),answer:red(q.answer,420)}));\n  if(s==='synthesis'){\n   if(!t.comparisonReviewed||t.comparisonSignature!==EGETerrain.comparisonSignature(p))throw Error('Préparez et relisez le tableau comparatif avant la synthèse.');\n   data.similarities=red(t.similarities,500);data.differences=red(t.differences,500);\n  }\n }\n return data;\n}\nconst EGE_SOURCE_CATALOG=[[\"fidélis\",\"fidélis|satisfaction|client|relation|rétention\",\"Bpifrance Création — Comment fidéliser vos clients ?\",\"https://bpifrance-creation.fr/moment-de-vie/comment-fideliser-vos-clients\",\"Satisfaction, relation durable, connaissance des besoins, suivi de la clientèle.\"],[\"fidélis\",\"rentabil|marge|coût|chiffre\",\"Bpifrance Création — Le seuil de rentabilité\",\"https://bpifrance-creation.fr/encyclopedie/previsions-financieres-business-plan/previsions-financieres/seuil-rentabilite\",\"Charges fixes et variables, marge, seuil d’activité.\"],[\"financement\",\"financement|investissement|besoin|ressource\",\"Bpifrance Création — Plan de financement initial\",\"https://bpifrance-creation.fr/encyclopedie/etapes-creation-dune-entreprise/previsions-financieres/plan-financement-initial-dun\",\"Besoins durables, ressources et équilibre du financement.\"],[\"financement\",\"emprunt|banque|dette|credit\",\"Bpifrance Création — Recourir à un prêt bancaire\",\"https://bpifrance-creation.fr/encyclopedie/financements/lemprunt/recourir-a-pret-bancaire-financer-son-projet-creation\",\"Prêt bancaire, apport propre, capacité de remboursement.\"],[\"financement\",\"capital|autofinancement|fonds|financ\",\"Bpifrance Création — Comment financer un projet de création d'entreprise ?\",\"https://bpifrance-creation.fr/encyclopedie/financements/panorama-financements/comment-financer-projet-creation-dentreprise\",\"Diversité des financements, fonds propres et apports.\"],[\"gestion de la marque\",\"marque|identité|protection|logo|propriété\",\"INPI — Les conditions de validité d’une marque\",\"https://www.inpi.fr/realiser-demarches/propriete-intellectuelle/conditions-de-validite-dune-marque\",\"Distinctivité, disponibilité et signe distinctif ; ne pas transposer les règles françaises à Djibouti.\"],[\"gestion de la marque\",\"concurrent|nom|logo|disponib|image\",\"INPI — Disponibilité d’une marque, d’un logo, d’un nom\",\"https://www.inpi.fr/disponibilite-dune-marque-dun-logo-dun-nom-de-societe-dun-nom-de-domaine\",\"Identité distinctive et recherche de disponibilité.\"],[\"gestion de la marque\",\"capital|fonds|financement\",\"Bpifrance Création — Comment financer un projet de création d'entreprise ?\",\"https://bpifrance-creation.fr/encyclopedie/financements/panorama-financements/comment-financer-projet-creation-dentreprise\",\"Apports en capital et ressources de financement.\"],[\"politique de prix\",\"prix|concurrence|demande|offre|psychologique\",\"Bpifrance Création — Comment fixer ses prix ?\",\"https://bpifrance-creation.fr/encyclopedie/letude-marche/determiner-sa-strategie/comment-fixer-ses-prix-projet-creation\",\"Coûts, concurrence et perception des clients dans la fixation des prix.\"],[\"politique de prix\",\"rentabil|marge|coût|seuil\",\"Bpifrance Création — Le seuil de rentabilité\",\"https://bpifrance-creation.fr/encyclopedie/previsions-financieres-business-plan/previsions-financieres/seuil-rentabilite\",\"Charges et seuil de rentabilité.\"],[\"ia dans la gestion|intelligence artificielle dans la gestion\",\"finance|gestion|risque|decision|automatis\",\"ACPR — Intelligence artificielle : enjeux pour le secteur financier\",\"https://acpr.banque-france.fr/document-de-reflexion-intelligence-artificielle-enjeux-pour-le-secteur-financier\",\"Automatisation, efficience, risques et gouvernance des outils IA.\"],[\"gestion des risques\",\"risque|trésorerie|liquidité|paiement\",\"Bpifrance Création — Que faire face à des problèmes de trésorerie ?\",\"https://bpifrance-creation.fr/moment-de-vie/que-faire-face-a-problemes-tresorerie\",\"Anticipation des flux et suivi de la trésorerie.\"],[\"gestion des risques\",\"impay|créance|recouvrement\",\"Bpifrance Création — Comment faire face aux impayés ?\",\"https://bpifrance-creation.fr/entrepreneur/actualites/comment-faire-face-aux-impayes\",\"Prévention et gestion des retards de paiement.\"],[\"nouvelles formes d emploi|nouvelles formes d’emploi\",\"emploi|automatis|ia|travail\",\"OIT — L’intelligence artificielle\",\"https://www.ilo.org/fr/themes-et-secteurs/lintelligence-artificielle\",\"Automatisation, complémentarité humaine et transformation du travail.\"],[\"nouvelles formes d emploi|nouvelles formes d’emploi\",\"transition|formation|compétence\",\"OIT — Intelligence artificielle générative et emploi : comment assurer la transition\",\"https://www.ilo.org/fr/publications/intelligence-artificielle-generative-et-emploi-comment-assurer-la\",\"Transition professionnelle et évolution des tâches.\"],[\"cybersécurité|protection des données\",\"donnée|confidential|sécurité|protection\",\"CNIL — Sécurité des données : les règles essentielles\",\"https://www.cnil.fr/fr/securite-des-donnees-les-regles-essentielles\",\"Protection des données, accès, sauvegardes et sécurité.\"],[\"cybersécurité|protection des données\",\"attaque|hygiene|mot de passe|sauvegarde|cyber\",\"ANSSI — Guide d’hygiène informatique\",\"https://messervices.cyber.gouv.fr/guides/guide-dhygiene-informatique\",\"Mesures de base de sécurité informatique.\"],[\"compétences du\",\"compétence|formation|adaptation|numérique\",\"OIT — Des compétences anciennes pour de nouvelles technologies ?\",\"https://www.ilo.org/fr/resource/article/old-skills-new-technologies\",\"Importance des compétences fondamentales et adaptation au numérique.\"],[\"identité numérique|marque employeur\",\"marque|attractiv|recrutement|image|communication\",\"Apec — Développer sa marque employeur\",\"https://www.apec.fr/recruteur/attirer-les-candidats/strategie-de-recrutement/fiches-avis/10-conseils-pour-ameliorer-votre-marque-employeur-avec-la-page-entreprise-apec-fr.html\",\"Visibilité, image employeur et attractivité.\"],[\"identité numérique|marque employeur\",\"donnée|identité|vie privée|internet\",\"CNIL — Protéger ses informations personnelles lors d’un recrutement\",\"https://www.cnil.fr/fr/candidats-adoptez-les-4-bons-reflexes-pour-proteger-vos-informations-personnelles-lors-dun\",\"Protection des informations personnelles et identité numérique.\"],[\"environnements de travail\",\"travail|qualité|conditions|dialogue|performance\",\"Anact — Guide dialogue social et qualité de vie au travail\",\"https://www.anact.fr/sites/default/files/2023-12/Guide-Dialogue-social-QVT-aide-a-domicile-et-insertion.pdf\",\"Organisation, dialogue social et qualité de vie au travail.\"],[\"accessibilité|inclusion professionnelle\",\"handicap|inclus|accessib|adaptation|égalité\",\"Agefiph — Inclure le handicap dans la politique RH\",\"https://www.agefiph.fr/centre-aide/inclure-le-handicap-la-politique-ressources-humaines\",\"Inclusion, aménagement, accompagnement et politique RH.\"],[\"ia dans la gestion|intelligence artificielle dans la gestion\",\"marketing|mercatique|client|segmentation|persona\",\"Bpifrance Création — Créer un persona marketing en 3 étapes\",\"https://bpifrance-creation.fr/encyclopedie/letude-marche/outils-danalyse/creer-persona-marketing-3-etapes\",\"Profils de clientèle, ciblage et aide de l’IA à la création de persona.\"],[\"gestion des risques\",\"marché|concurrence|mercatique|commercial\",\"Bpifrance Création — Diagnostic de l’activité de l’entreprise\",\"https://bpifrance-creation.fr/encyclopedie/reprendre-entreprise-etapes/diagnostiquer-evaluer/diagnostic-lactivite-lentreprise-a\",\"Potentiel du marché, concurrence et risques commerciaux.\"],[\"gestion de la marque\",\"valeur|capital|immatériel\",\"INPI — Diagnostic propriété intellectuelle\",\"https://www.inpi.fr/nos-solutions/etablir-son-plan-dactions/prediagnostic-pi\",\"Marques et autres actifs immatériels, valorisation.\"]];\nfunction mbEgeSource(p){\n const norm=s=>String(s||'').toLowerCase().replace(/[’']/g,' ');\n const theme=norm(p.theme),context=norm(p.subtheme+' '+p.problem);\n const group=EGE_SOURCE_CATALOG.filter(r=>new RegExp(r[0],'i').test(theme));\n if(!group.length)return null;\n if(p.annex===1)return group[0];\n const scored=group.map((r,i)=>({r,i,n:r[1].split('|').filter(k=>context.includes(k)).length}));\n scored.sort((x,y)=>y.n-x.n||((x.i+group.length-(p.annex-1)%group.length)%group.length)-((y.i+group.length-(p.annex-1)%group.length)%group.length));\n return scored[0].r;\n}\nfunction egeArticleBody(raw){\n const parts=(Array.isArray(raw)?raw:[raw]).filter(x=>typeof x==='string').flatMap(x=>x.replace(/\\r\\n?/g,'\\n').replace(/\\\\n/g,'\\n').split(/\\n+/)).map(x=>x.trim()).filter(Boolean);\n if(parts.length>=5)return parts.join('\\n\\n');\n let text=parts.join(' ');if(!text)return '';\n let sentences;\n try{sentences=Array.from(new Intl.Segmenter('fr',{granularity:'sentence'}).segment(text),x=>x.segment.trim()).filter(Boolean)}catch{sentences=text.match(/[^.!?]+(?:[.!?]+(?=\\s|$)|$)/g)?.map(x=>x.trim()).filter(Boolean)||[text]}\n if(sentences.length<5)return parts.join('\\n\\n');\n let result=[],chunk=[],remaining=sentences.reduce((n,s)=>n+s.length,0),target=Math.min(6,Math.max(5,Math.round(text.length/550)));\n for(let i=0;i<sentences.length;i++){const s=sentences[i];chunk.push(s);const count=chunk.join(' ').length,left=target-result.length;\n if(left>1&&sentences.length-i-1>=left-1&&(count>=remaining/left*.85||sentences.length-i-1===left-1)){result.push(chunk.join(' '));remaining-=count;chunk=[]}}\n if(chunk.length)result.push(chunk.join(' '));return result.join('\\n\\n');\n}\nfunction safeSource(v){try{const u=new URL(String(v||''));return u.protocol==='https:'&&!u.username&&!u.password?u.href:''}catch{return ''}}\nfunction sourceKey(v){try{const u=new URL(v);return u.hostname.toLowerCase().replace(/^www\\./,'')+decodeURIComponent(u.pathname).replace(/_/g,' ').replace(/\\/+$/,'').toLowerCase()}catch{return ''}}\nfunction duplicateSource(n,url,p){const key=sourceKey(url);return !!key&&Object.entries(p.sources||{}).some(([i,v])=>Number(i)!==n&&sourceKey(safeSource(String(v||'').match(/https:\\/\\/[^\\s<>\"']+/i)?.[0]))===key)}\nfunction proposalSource(n,r,p=st.draft){const url=safeSource(r?.sourceUrl);return {url:url&&!duplicateSource(n,url,p)?url:'',title:r?.sourceTitle||'Document de référence'}}\nfunction sourceField(n,p){const existing=String(p.sources?.[n]||'').match(/https:\\/\\/[^\\s<>\"']+/i)?.[0],url=safeSource(existing);if(url)return '<p class=\"small\" style=\"margin:4px 0 12px\"><a href=\"'+esc(url)+'\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"overflow-wrap:anywhere\">Consulter la source web ↗</a>'+(duplicateSource(n,url,p)?'<br><span style=\"color:#a33\">Ce lien est déjà utilisé dans une autre annexe. Recherchez une source différente.</span>':'')+'</p>';return '<p class=\"small muted\">La proposition IA recherchera une page web distincte. Vous pouvez aussi saisir le lien HTTPS d’un document que vous avez consulté.</p>'}\n\nfunction annexChoices(r){const list=Array.isArray(r?.titles)?r.titles:[];const choices=list.filter(v=>v&&typeof v.title==='string'&&v.title.trim()).slice(0,3);return choices.length?choices:[{title:r.title||'Annexe documentaire',reason:''}]}\nfunction apply(k,r,index){\n const p=st.draft,t=EGETerrain.normalize(p.terrain,p),s=stageFor(k),w=p.study||={};w.workspace||={};\n if(s==='problem'){if(p.problem?.trim()&&p.problem!==r.problems[index]&&!confirm('Remplacer la problématique actuelle ? Relisez les annexes déjà rédigées.'))return false;p.problem=r.problems[index];t.comparisonReviewed=false;t.synthesisReviewed=false;p.terrain=t}\n if(s==='annex'){const n=Number(k.slice(1));if((p.annexes?.[n]?.trim()||p.sources?.[n]?.trim())&&!confirm('Remplacer le titre et le contenu de cette annexe ? La source devra être vérifiée de nouveau.'))return false;p.annexTitles||={};p.annexes||={};p.sources||={};p.sourceChecks||={};p.annexTitles[n]=annexChoices(r)[index]?.title||annexChoices(r)[0].title;p.annexes[n]=egeArticleBody(r.body);p.sources[n]=proposalSource(n,r,p).url||'';p.sourceChecks[n]=false;t.comparisonReviewed=false;t.synthesisReviewed=false;p.terrain=t}\n if(s==='interview'){if(t.questions.some(q=>q.answer.trim()))throw Error('Les réponses existantes sont protégées.');if(t.questions.some(q=>q.question.trim())&&!confirm('Remplacer les questions actuelles par cette proposition ?'))return false;t.questions=r.questions.map(q=>({question:q.question,answer:'',annex:q.annex}));t.comparisonReviewed=false;t.synthesisReviewed=false;w.workspace.interviewIndex=0;p.terrain=t}\n if(s==='comparison'){\n  if(t.comparisons.length&&!confirm('Remplacer le tableau actuel et les similitudes/différences ?'))return false;\n  const n=p.mode==='binome'?4:3;t.comparisons=Array.from({length:n},(_,i)=>({annex:i+1,theory:String(p.annexes?.[i+1]||'').slice(0,6000),practice:t.questions.filter(q=>q.annex===i+1&&q.answer.trim()).map(q=>q.question+'\\n'+q.answer).join('\\n\\n').slice(0,12000)}));\n  t.similarities=r.similarities;t.differences=r.differences;t.comparisonReviewed=false;t.synthesisReviewed=false;p.terrain=t;t.comparisonSignature=EGETerrain.comparisonSignature(p);w.workspace.comparisonIndex=0;\n }\n if(s==='synthesis'){if((t.synthesis.trim()||Object.values(w.workspace.synthesis||{}).some(x=>String(x||'').trim()))&&!confirm('Remplacer la synthèse actuelle ?'))return false;w.workspace.synthesis={intro:r.intro,development:r.development,conclusion:r.conclusion};t.synthesis=[r.intro,r.development,r.conclusion].join('\\n\\n');t.synthesisReviewed=false;p.terrain=t;t.synthesisSignature=EGETerrain.synthesisSignature(p)}\n touchTerrain();render();toast('Proposition intégrée au brouillon. Relisez-la avant validation.');return true;\n}\nfunction preview(k,r,stamp,id,versions=[r],index=versions.length-1){\n const s=stageFor(k);let dlg=document.querySelector('#mb-ege-ai-dialog');if(dlg)dlg.remove();\n dlg=document.createElement('dialog');dlg.id='mb-ege-ai-dialog';dlg.style.cssText='width:min(94vw,650px);max-height:88dvh;overflow:auto;border:0;border-radius:16px;padding:18px;color:inherit;background:var(--card,#fff);box-shadow:0 18px 70px #0005';\n const line=(label,txt)=>'<h3 style=\"font-size:1rem;margin:14px 0 6px\">'+esc(label)+'</h3><p style=\"white-space:pre-wrap;overflow-wrap:anywhere\">'+esc(txt)+'</p>';\n const use=i=>'<button type=\"button\" class=\"btn primary\" data-mb-ege-use=\"'+i+'\" style=\"margin:8px 0 12px\">Utiliser cette proposition</button>';\n const tr=(fr,en,ar)=>document.documentElement.lang==='ar'?ar:document.documentElement.lang==='en'?en:fr;\n const labels={another:tr('Une autre version','Another version','نسخة أخرى'),previous:tr('Précédente','Previous','السابقة'),next:tr('Suivante','Next','التالية'),version:tr('Version','Version','النسخة'),busy:tr('Préparation d’une autre version…','Generating another version…','جارٍ إعداد نسخة أخرى…'),same:tr('L’IA a proposé la même version. La proposition est conservée.','The AI returned the same version. Your proposal is kept.','قدّم الذكاء الاصطناعي النسخة نفسها. تم الاحتفاظ بالمقترح.')};\n let html='<div style=\"display:flex;align-items:center;justify-content:space-between;gap:8px\"><h2 style=\"font-size:1.15rem;margin:0\">Proposition IA</h2><button type=\"button\" class=\"btn smol\" data-mb-ege-close>Fermer</button></div><p class=\"small muted\">Brouillon à vérifier par l’élève et son enseignant.</p>';\n html+='<div style=\"display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0\"><button type=\"button\" class=\"btn\" data-mb-ege-another style=\"flex:1;min-width:140px\">'+esc(labels.another)+'</button><span class=\"small muted\">'+esc(labels.version)+' '+(index+1)+' / '+versions.length+'</span></div>';\n if(versions.length>1)html+='<div style=\"display:flex;gap:8px;flex-wrap:wrap\"><button type=\"button\" class=\"btn smol\" data-mb-ege-nav=\"-1\" '+(index===0?'disabled':'')+'>'+esc(labels.previous)+'</button><button type=\"button\" class=\"btn smol\" data-mb-ege-nav=\"1\" '+(index===versions.length-1?'disabled':'')+'>'+esc(labels.next)+'</button></div>';\n html+='<p class=\"small muted\" role=\"status\" data-mb-ege-variant-status></p>';\n if(s==='problem')html+=r.problems.map((x,i)=>line('Option '+(i+1),x)+use(i)).join('');\n if(s==='annex'){const source=proposalSource(Number(k.slice(1)),r),url=source.url;const titles=annexChoices(r);const rankLabels=[tr('Le plus recommandé','Most recommended','الأكثر توصية'),tr('Très pertinent','Very relevant','ملائم جدًا'),tr('Alternative pertinente','Relevant alternative','بديل ملائم')];const choices='<fieldset style=\"border:0;padding:0;margin:12px 0\"><legend style=\"font-weight:700;margin-bottom:8px\">'+esc(tr('Choisissez un titre','Choose a title','اختر عنوانًا'))+'</legend><p class=\"small muted\">'+esc(tr('Classement pédagogique indicatif selon la cohérence du titre, du texte et de la source proposée.','Indicative ranking by fit with the text and suggested source.','ترتيب إرشادي حسب توافق العنوان والنص والمصدر المقترح.'))+'</p>'+titles.map((o,i)=>'<label style=\"display:flex;gap:9px;align-items:flex-start;padding:10px;margin:7px 0;border:1px solid #d5dbe4;border-radius:10px;cursor:pointer\"><input type=\"radio\" name=\"mb-annex-title\" value=\"'+i+'\" '+(i===0?'checked':'')+'><span style=\"min-width:0;flex:1\"><small style=\"display:block;font-weight:600;color:var(--primary,#b80b38)\">'+(i+1)+' · '+esc(rankLabels[i])+'</small><strong style=\"display:block;overflow-wrap:anywhere\">'+esc(o.title)+'</strong>'+(o.reason?'<small class=\"muted\" style=\"display:block;margin-top:3px\">'+esc(o.reason)+'</small>':'')+'</span></label>').join('')+'</fieldset>';const article=choices+'<h3 data-mb-annex-current-title style=\"font-size:1rem;margin:14px 0 6px\">'+esc(titles[0].title)+'</h3>'+egeArticleBody(r.body).split('\\n\\n').map(p=>'<p style=\"line-height:1.55;margin:0 0 1em;overflow-wrap:anywhere\">'+esc(p)+'</p>').join('');html+=article+(url?'<h3 style=\"font-size:1rem;margin:14px 0 6px\">Source documentaire (HTTPS)</h3><p class=\"small\">'+esc(source.title)+'</p><a href=\"'+esc(url)+'\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"display:block;overflow-wrap:anywhere\">'+esc(url)+'</a><p class=\"small muted\">Consultez le document et confirmez la source dans votre annexe.</p>':line('Source à compléter',r.research))+use(0);}\n if(s==='interview')html+=r.questions.map((q,i)=>line('Question '+(i+1)+(egeIntroQuestion(q)?' · Présentation de l’entreprise':' · Annexe '+q.annex),q.question)).join('')+use(0);\n if(s==='comparison')html+=line('Recherches documentaires / Terrain','Les colonnes reprendront les annexes et vos réponses réellement saisies, rattachées à chaque annexe. Les cases sans réponse resteront vides.')+line('Similitudes proposées',r.similarities)+line('Différences proposées',r.differences)+use(0);\n if(s==='synthesis')html+=line('Introduction',r.intro)+line('Développement',r.development)+line('Conclusion',r.conclusion)+use(0);\n dlg.innerHTML=html;document.body.append(dlg);dlg.showModal();\n dlg.addEventListener('close',()=>dlg.remove(),{once:true});if(s==='annex')dlg.addEventListener('change',e=>{if(e.target?.name==='mb-annex-title'){const selected=annexChoices(r)[Number(e.target.value)];const head=dlg.querySelector('[data-mb-annex-current-title]');if(selected&&head)head.textContent=selected.title}});dlg.addEventListener('click',async e=>{\n  if(e.target.closest('[data-mb-ege-close]')){dlg.close();return}\n  if(pending)return;\n  const nav=e.target.closest('[data-mb-ege-nav]');if(nav){const next=index+Number(nav.dataset.mbEgeNav);if(versions[next])preview(k,versions[next],stamp,id,versions,next);return}\n  const another=e.target.closest('[data-mb-ege-another]');\n  if(another){const status=dlg.querySelector('[data-mb-ege-variant-status]');try{\n   if(!owner()||id!==st.selectedDocId||JSON.stringify(collect(k))!==stamp)throw Error('Le dossier a changé. Demandez une nouvelle proposition.');\n   if(!navigator.onLine)throw Error('Connexion Internet requise.');\n   if(versions.length>=20)throw Error('Limite de versions atteinte pour cet aperçu.');\n   pending=true;another.disabled=true;status.textContent=labels.busy;\n   const json=await requestProposal(k,collect(k),id,versions.length);\n   if(!dlg.open||!dlg.isConnected)return;\n   if(!owner()||id!==st.selectedDocId||JSON.stringify(collect(k))!==stamp)throw Error('Dossier modifié pendant l’analyse. Recommencez.');\n   if(versions.some(v=>JSON.stringify(v)===JSON.stringify(json.result))){status.textContent=labels.same;return}\n   const updated=versions.concat([json.result]);preview(k,json.result,stamp,id,updated,updated.length-1);\n  }catch(err){status.textContent=err.message||'Proposition indisponible.'}finally{pending=false;another.disabled=false}return}\n  const b=e.target.closest('[data-mb-ege-use]');if(!b)return;try{if(!owner()||id!==st.selectedDocId||JSON.stringify(collect(k))!==stamp)throw Error('Le dossier a changé. Demandez une nouvelle proposition.');const choice=s==='annex'?Number(dlg.querySelector('input[name=\"mb-annex-title\"]:checked')?.value||0):Number(b.dataset.mbEgeUse);if(apply(k,r,choice))dlg.close()}catch(err){toast(err.message)}\n });\n}\nasync function requestProposal(k,data,id,variant=0){\n const {data:session}=await st.db.auth.getSession();if(!session?.session?.access_token)throw Error('Reconnectez-vous.');\n const res=await fetch('/api/ege-ai',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+session.session.access_token},body:JSON.stringify({dossier:id,stage:stageFor(k),data,variant})}),json=await res.json();\n if(!res.ok)throw Error(json.error||'Proposition indisponible.');if(stageFor(k)==='annex'&&json.result){const source=proposalSource(Number(k.slice(1)),json.result);json.result.sourceUrl=source.url;json.result.sourceTitle=source.title;json.result.body=egeArticleBody(json.result.body??json.result.paragraphs)}return json\n}\nlet pending=false;\ndocument.addEventListener('click',async e=>{\n const b=e.target.closest?.('[data-ege-ai]');if(!b||pending)return;e.preventDefault();const k=b.dataset.egeAi,status=b.parentElement.querySelector('[data-ege-ai-status]');let data,id,stamp;\n try{data=collect(k);id=st.selectedDocId;stamp=JSON.stringify(data);if(!navigator.onLine)throw Error('Connexion Internet requise.');if(!confirm('L’IA recevra uniquement les éléments pédagogiques utiles. Assurez-vous que vos textes ne contiennent aucun nom, numéro, adresse personnelle ou information confidentielle. Continuer ?'))return;\n pending=true;b.disabled=true;status.textContent='Préparation de la proposition…';\n const json=await requestProposal(k,data,id,0);\n if(!owner()||id!==st.selectedDocId||JSON.stringify(collect(k))!==stamp)throw Error('Dossier modifié pendant l’analyse. Recommencez.');\n status.textContent='Proposition prête.';preview(k,json.result,stamp,id);\n }catch(err){if(status)status.textContent=err.message||'Proposition indisponible.';else toast(err.message)}finally{pending=false;b.disabled=false}\n},true);\nwindow.MBEgeAI={panel,sourceField};\n})();\n"],"/mon-bac-ege-ai-article-r2-interview-r1-titles-r1-sources-r1.js":["application/javascript; charset=utf-8",false,"\n(()=>{'use strict';\nconst EGE_INTRO_QUESTION=\"Quelle est l'activité principale de votre entreprise ?\";\nfunction egeIntroQuestion(q){const s=String(q?.question||q||'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().replace(/[’']/g,' ').replace(/[^\\p{L}\\p{N} ]/gu,' ').replace(/\\s+/g,' ').trim();return s==='quelle est l activite principale de votre entreprise'}\nconst names={problem:'3 problématiques',annex:'Une annexe',interview:'Les questions d’entretien',comparison:'Le tableau comparatif',synthesis:'La synthèse'};\nconst stageFor=k=>k==='topic'?'problem':/^a[1-4]$/.test(k)?'annex':['interview','comparison','synthesis'].includes(k)?k:'';\nconst owner=()=>st.role==='eleve'&&!!st.user&&!!st.draft&&currentDoc()?.owner_id===st.user.id;\nfunction panel(k){const s=stageFor(k);if(!s)return '';return '<details class=\"card\" style=\"margin:0 0 12px;padding:12px\"><summary style=\"cursor:pointer;font-weight:700\">Suggestion IA · '+esc(names[s])+'</summary><p class=\"small muted\" style=\"margin:8px 0\">Gratuite dans la limite du quota quotidien. Vérifiez les propositions et les sources ; aucune donnée de terrain n’est inventée.</p><button type=\"button\" class=\"btn primary\" data-ege-ai=\"'+esc(k)+'\" style=\"width:100%\">Proposer</button><p class=\"small muted\" data-ege-ai-status role=\"status\"></p></details>'}\nfunction redactor(p,t){const identities=[p.student,p.partner,p.teacher,p.company,t.professionalName,t.organizationName,st.profile?.full_name,st.profile?.email,st.profile?.whatsapp_number].filter(x=>typeof x==='string'&&x.trim().length>=4).map(x=>x.trim());return (x,max=0)=>{let s=String(x||'');for(const x of identities)s=s.split(x).join('[identité retirée]');s=s.replace(/[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}/g,'[courriel retiré]').replace(/(?:\\+253[\\s.-]*(?:\\d[\\s.-]*){8}|(?:tél(?:éphone)?|portable|whatsapp)\\s*[:.]?\\s*(?:\\d[\\s.-]*){8,12})/gi,'[numéro retiré]');return max?s.slice(0,max):s}}\nfunction collect(k){\n if(!owner())throw Error('Ouvrez votre dossier EGE personnel.');\n const p=st.draft,t=EGETerrain.normalize(p.terrain,p),topic=EGEStudy.topic(p,official),s=stageFor(k),mode=p.mode==='binome'?'binome':'individuel',n=mode==='binome'?4:3,red=redactor(p,t);\n if(!topic.theme||!topic.subtheme)throw Error('Choisissez le thème et le sous-thème officiels.');\n const data={mode,theme:topic.theme,subtheme:topic.subtheme};\n if(s==='problem')return data;\n if(!p.problem?.trim())throw Error('Rédigez ou choisissez votre problématique.');\n data.problem=red(p.problem);\n if(s==='annex')data.annex=Number(k.slice(1));\n const limit=s==='annex'?850:s==='interview'?1200:750;\n const interviewExcerpt=x=>{const v=red(x);if(v.length<=limit)return v;const middle=Math.floor(v.length/2),first=Math.floor(limit*.36),half=Math.floor(limit*.14),last=Math.floor(limit*.32);return v.slice(0,first)+' … '+v.slice(middle-half,middle+half)+' … '+v.slice(-last)};\n data.annexes=Array.from({length:n},(_,i)=>({number:i+1,title:red(getTitle(i+1,p),190),text:['interview','annex'].includes(s)?interviewExcerpt(p.annexes?.[i+1]):red(p.annexes?.[i+1],limit),...(s==='annex'?{source:safeSource(String(p.sources?.[i+1]||'').match(/https:\\/\\/[^\\s<>\"']+/i)?.[0])}: {})})).filter(a=>s!=='annex'||a.number!==data.annex);\n if(s==='interview'&&t.questions.some(q=>q.answer.trim()))throw Error('Des réponses existent déjà. Pour les conserver, modifiez les questions manuellement.');\n if(s==='interview'&&data.annexes.some(a=>!a.text.trim()))throw Error('Rédigez d’abord les annexes afin de préparer des questions pertinentes.');\n if(['comparison','synthesis'].includes(s)){\n  if(t.interviewStatus!=='done')throw Error('Indiquez que l’entretien a réellement été réalisé dans Professionnel.');\n  if(t.questions.some(q=>q.answer.trim()&&(!q.question.trim()||(!egeIntroQuestion(q)&&(q.annex<1||q.annex>n)))))throw Error('Rattachez chaque réponse réelle à une question et à une annexe.');\n  const intro=t.questions.find(q=>egeIntroQuestion(q)&&q.answer.trim());if(intro)data.companyActivity=red(intro.answer,300);const answered=t.questions.filter(q=>q.question.trim()&&q.answer.trim()&&!egeIntroQuestion(q));\n  if(!answered.length)throw Error('Renseignez au moins une réponse réelle aux questions liées aux annexes.');\n  if(data.annexes.some(a=>!a.text.trim()))throw Error('Complétez les annexes avant de comparer.');\n  data.excerptNotice='Les extraits sont limités en longueur ; ne déduis jamais de faits non présents.';data.excerptNotice='Les extraits sont limités en longueur ; ne déduis jamais de faits non présents.';data.answers=answered.map(q=>({annex:q.annex,question:red(q.question,220),answer:red(q.answer,420)}));\n  if(s==='synthesis'){\n   if(!t.comparisonReviewed||t.comparisonSignature!==EGETerrain.comparisonSignature(p))throw Error('Préparez et relisez le tableau comparatif avant la synthèse.');\n   data.similarities=red(t.similarities,500);data.differences=red(t.differences,500);\n  }\n }\n return data;\n}\nconst EGE_SOURCE_CATALOG=[[\"fidélis\",\"fidélis|satisfaction|client|relation|rétention\",\"Bpifrance Création — Comment fidéliser vos clients ?\",\"https://bpifrance-creation.fr/moment-de-vie/comment-fideliser-vos-clients\",\"Satisfaction, relation durable, connaissance des besoins, suivi de la clientèle.\"],[\"fidélis\",\"rentabil|marge|coût|chiffre\",\"Bpifrance Création — Le seuil de rentabilité\",\"https://bpifrance-creation.fr/encyclopedie/previsions-financieres-business-plan/previsions-financieres/seuil-rentabilite\",\"Charges fixes et variables, marge, seuil d’activité.\"],[\"financement\",\"financement|investissement|besoin|ressource\",\"Bpifrance Création — Plan de financement initial\",\"https://bpifrance-creation.fr/encyclopedie/etapes-creation-dune-entreprise/previsions-financieres/plan-financement-initial-dun\",\"Besoins durables, ressources et équilibre du financement.\"],[\"financement\",\"emprunt|banque|dette|credit\",\"Bpifrance Création — Recourir à un prêt bancaire\",\"https://bpifrance-creation.fr/encyclopedie/financements/lemprunt/recourir-a-pret-bancaire-financer-son-projet-creation\",\"Prêt bancaire, apport propre, capacité de remboursement.\"],[\"financement\",\"capital|autofinancement|fonds|financ\",\"Bpifrance Création — Comment financer un projet de création d'entreprise ?\",\"https://bpifrance-creation.fr/encyclopedie/financements/panorama-financements/comment-financer-projet-creation-dentreprise\",\"Diversité des financements, fonds propres et apports.\"],[\"gestion de la marque\",\"marque|identité|protection|logo|propriété\",\"INPI — Les conditions de validité d’une marque\",\"https://www.inpi.fr/realiser-demarches/propriete-intellectuelle/conditions-de-validite-dune-marque\",\"Distinctivité, disponibilité et signe distinctif ; ne pas transposer les règles françaises à Djibouti.\"],[\"gestion de la marque\",\"concurrent|nom|logo|disponib|image\",\"INPI — Disponibilité d’une marque, d’un logo, d’un nom\",\"https://www.inpi.fr/disponibilite-dune-marque-dun-logo-dun-nom-de-societe-dun-nom-de-domaine\",\"Identité distinctive et recherche de disponibilité.\"],[\"gestion de la marque\",\"capital|fonds|financement\",\"Bpifrance Création — Comment financer un projet de création d'entreprise ?\",\"https://bpifrance-creation.fr/encyclopedie/financements/panorama-financements/comment-financer-projet-creation-dentreprise\",\"Apports en capital et ressources de financement.\"],[\"politique de prix\",\"prix|concurrence|demande|offre|psychologique\",\"Bpifrance Création — Comment fixer ses prix ?\",\"https://bpifrance-creation.fr/encyclopedie/letude-marche/determiner-sa-strategie/comment-fixer-ses-prix-projet-creation\",\"Coûts, concurrence et perception des clients dans la fixation des prix.\"],[\"politique de prix\",\"rentabil|marge|coût|seuil\",\"Bpifrance Création — Le seuil de rentabilité\",\"https://bpifrance-creation.fr/encyclopedie/previsions-financieres-business-plan/previsions-financieres/seuil-rentabilite\",\"Charges et seuil de rentabilité.\"],[\"ia dans la gestion|intelligence artificielle dans la gestion\",\"finance|gestion|risque|decision|automatis\",\"ACPR — Intelligence artificielle : enjeux pour le secteur financier\",\"https://acpr.banque-france.fr/document-de-reflexion-intelligence-artificielle-enjeux-pour-le-secteur-financier\",\"Automatisation, efficience, risques et gouvernance des outils IA.\"],[\"gestion des risques\",\"risque|trésorerie|liquidité|paiement\",\"Bpifrance Création — Que faire face à des problèmes de trésorerie ?\",\"https://bpifrance-creation.fr/moment-de-vie/que-faire-face-a-problemes-tresorerie\",\"Anticipation des flux et suivi de la trésorerie.\"],[\"gestion des risques\",\"impay|créance|recouvrement\",\"Bpifrance Création — Comment faire face aux impayés ?\",\"https://bpifrance-creation.fr/entrepreneur/actualites/comment-faire-face-aux-impayes\",\"Prévention et gestion des retards de paiement.\"],[\"nouvelles formes d emploi|nouvelles formes d’emploi\",\"emploi|automatis|ia|travail\",\"OIT — L’intelligence artificielle\",\"https://www.ilo.org/fr/themes-et-secteurs/lintelligence-artificielle\",\"Automatisation, complémentarité humaine et transformation du travail.\"],[\"nouvelles formes d emploi|nouvelles formes d’emploi\",\"transition|formation|compétence\",\"OIT — Intelligence artificielle générative et emploi : comment assurer la transition\",\"https://www.ilo.org/fr/publications/intelligence-artificielle-generative-et-emploi-comment-assurer-la\",\"Transition professionnelle et évolution des tâches.\"],[\"cybersécurité|protection des données\",\"donnée|confidential|sécurité|protection\",\"CNIL — Sécurité des données : les règles essentielles\",\"https://www.cnil.fr/fr/securite-des-donnees-les-regles-essentielles\",\"Protection des données, accès, sauvegardes et sécurité.\"],[\"cybersécurité|protection des données\",\"attaque|hygiene|mot de passe|sauvegarde|cyber\",\"ANSSI — Guide d’hygiène informatique\",\"https://messervices.cyber.gouv.fr/guides/guide-dhygiene-informatique\",\"Mesures de base de sécurité informatique.\"],[\"compétences du\",\"compétence|formation|adaptation|numérique\",\"OIT — Des compétences anciennes pour de nouvelles technologies ?\",\"https://www.ilo.org/fr/resource/article/old-skills-new-technologies\",\"Importance des compétences fondamentales et adaptation au numérique.\"],[\"identité numérique|marque employeur\",\"marque|attractiv|recrutement|image|communication\",\"Apec — Développer sa marque employeur\",\"https://www.apec.fr/recruteur/attirer-les-candidats/strategie-de-recrutement/fiches-avis/10-conseils-pour-ameliorer-votre-marque-employeur-avec-la-page-entreprise-apec-fr.html\",\"Visibilité, image employeur et attractivité.\"],[\"identité numérique|marque employeur\",\"donnée|identité|vie privée|internet\",\"CNIL — Protéger ses informations personnelles lors d’un recrutement\",\"https://www.cnil.fr/fr/candidats-adoptez-les-4-bons-reflexes-pour-proteger-vos-informations-personnelles-lors-dun\",\"Protection des informations personnelles et identité numérique.\"],[\"environnements de travail\",\"travail|qualité|conditions|dialogue|performance\",\"Anact — Guide dialogue social et qualité de vie au travail\",\"https://www.anact.fr/sites/default/files/2023-12/Guide-Dialogue-social-QVT-aide-a-domicile-et-insertion.pdf\",\"Organisation, dialogue social et qualité de vie au travail.\"],[\"accessibilité|inclusion professionnelle\",\"handicap|inclus|accessib|adaptation|égalité\",\"Agefiph — Inclure le handicap dans la politique RH\",\"https://www.agefiph.fr/centre-aide/inclure-le-handicap-la-politique-ressources-humaines\",\"Inclusion, aménagement, accompagnement et politique RH.\"],[\"ia dans la gestion|intelligence artificielle dans la gestion\",\"marketing|mercatique|client|segmentation|persona\",\"Bpifrance Création — Créer un persona marketing en 3 étapes\",\"https://bpifrance-creation.fr/encyclopedie/letude-marche/outils-danalyse/creer-persona-marketing-3-etapes\",\"Profils de clientèle, ciblage et aide de l’IA à la création de persona.\"],[\"gestion des risques\",\"marché|concurrence|mercatique|commercial\",\"Bpifrance Création — Diagnostic de l’activité de l’entreprise\",\"https://bpifrance-creation.fr/encyclopedie/reprendre-entreprise-etapes/diagnostiquer-evaluer/diagnostic-lactivite-lentreprise-a\",\"Potentiel du marché, concurrence et risques commerciaux.\"],[\"gestion de la marque\",\"valeur|capital|immatériel\",\"INPI — Diagnostic propriété intellectuelle\",\"https://www.inpi.fr/nos-solutions/etablir-son-plan-dactions/prediagnostic-pi\",\"Marques et autres actifs immatériels, valorisation.\"]];\nfunction mbEgeSource(p){\n const norm=s=>String(s||'').toLowerCase().replace(/[’']/g,' ');\n const theme=norm(p.theme),context=norm(p.subtheme+' '+p.problem);\n const group=EGE_SOURCE_CATALOG.filter(r=>new RegExp(r[0],'i').test(theme));\n if(!group.length)return null;\n if(p.annex===1)return group[0];\n const scored=group.map((r,i)=>({r,i,n:r[1].split('|').filter(k=>context.includes(k)).length}));\n scored.sort((x,y)=>y.n-x.n||((x.i+group.length-(p.annex-1)%group.length)%group.length)-((y.i+group.length-(p.annex-1)%group.length)%group.length));\n return scored[0].r;\n}\nfunction egeArticleBody(raw){\n const parts=(Array.isArray(raw)?raw:[raw]).filter(x=>typeof x==='string').flatMap(x=>x.replace(/\\r\\n?/g,'\\n').replace(/\\\\n/g,'\\n').split(/\\n+/)).map(x=>x.trim()).filter(Boolean);\n if(parts.length>=5)return parts.join('\\n\\n');\n let text=parts.join(' ');if(!text)return '';\n let sentences;\n try{sentences=Array.from(new Intl.Segmenter('fr',{granularity:'sentence'}).segment(text),x=>x.segment.trim()).filter(Boolean)}catch{sentences=text.match(/[^.!?]+(?:[.!?]+(?=\\s|$)|$)/g)?.map(x=>x.trim()).filter(Boolean)||[text]}\n if(sentences.length<5)return parts.join('\\n\\n');\n let result=[],chunk=[],remaining=sentences.reduce((n,s)=>n+s.length,0),target=Math.min(6,Math.max(5,Math.round(text.length/550)));\n for(let i=0;i<sentences.length;i++){const s=sentences[i];chunk.push(s);const count=chunk.join(' ').length,left=target-result.length;\n if(left>1&&sentences.length-i-1>=left-1&&(count>=remaining/left*.85||sentences.length-i-1===left-1)){result.push(chunk.join(' '));remaining-=count;chunk=[]}}\n if(chunk.length)result.push(chunk.join(' '));return result.join('\\n\\n');\n}\nfunction safeSource(v){try{const u=new URL(String(v||''));return u.protocol==='https:'&&!u.username&&!u.password?u.href:''}catch{return ''}}\nfunction sourceKey(v){try{const u=new URL(v);return u.hostname.toLowerCase().replace(/^www\\./,'')+decodeURIComponent(u.pathname).replace(/_/g,' ').replace(/\\/+$/,'').toLowerCase()}catch{return ''}}\nfunction duplicateSource(n,url,p){const key=sourceKey(url);return !!key&&Object.entries(p.sources||{}).some(([i,v])=>Number(i)!==n&&sourceKey(safeSource(String(v||'').match(/https:\\/\\/[^\\s<>\"']+/i)?.[0]))===key)}\nfunction proposalSource(n,r,p=st.draft){const url=safeSource(r?.sourceUrl);return {url:url&&!duplicateSource(n,url,p)?url:'',title:r?.sourceTitle||'Document de référence'}}\nfunction sourceField(n,p){const existing=String(p.sources?.[n]||'').match(/https:\\/\\/[^\\s<>\"']+/i)?.[0],url=safeSource(existing);if(url)return '<p class=\"small\" style=\"margin:4px 0 12px\"><a href=\"'+esc(url)+'\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"overflow-wrap:anywhere\">Consulter la source web ↗</a>'+(duplicateSource(n,url,p)?'<br><span style=\"color:#a33\">Ce lien est déjà utilisé dans une autre annexe. Recherchez une source différente.</span>':'')+'</p>';return '<p class=\"small muted\">La proposition IA recherchera une page web distincte. Vous pouvez aussi saisir le lien HTTPS d’un document que vous avez consulté.</p>'}\n\nfunction annexChoices(r){const list=Array.isArray(r?.titles)?r.titles:[];const choices=list.filter(v=>v&&typeof v.title==='string'&&v.title.trim()).slice(0,3);return choices.length?choices:[{title:r.title||'Annexe documentaire',reason:''}]}\nfunction apply(k,r,index){\n const p=st.draft,t=EGETerrain.normalize(p.terrain,p),s=stageFor(k),w=p.study||={};w.workspace||={};\n if(s==='problem'){if(p.problem?.trim()&&p.problem!==r.problems[index]&&!confirm('Remplacer la problématique actuelle ? Relisez les annexes déjà rédigées.'))return false;p.problem=r.problems[index];t.comparisonReviewed=false;t.synthesisReviewed=false;p.terrain=t}\n if(s==='annex'){const n=Number(k.slice(1));if((p.annexes?.[n]?.trim()||p.sources?.[n]?.trim())&&!confirm('Remplacer le titre et le contenu de cette annexe ? La source devra être vérifiée de nouveau.'))return false;p.annexTitles||={};p.annexes||={};p.sources||={};p.sourceChecks||={};p.annexTitles[n]=annexChoices(r)[index]?.title||annexChoices(r)[0].title;p.annexes[n]=egeArticleBody(r.body);p.sources[n]=proposalSource(n,r,p).url||'';p.sourceChecks[n]=false;t.comparisonReviewed=false;t.synthesisReviewed=false;p.terrain=t}\n if(s==='interview'){if(t.questions.some(q=>q.answer.trim()))throw Error('Les réponses existantes sont protégées.');if(t.questions.some(q=>q.question.trim())&&!confirm('Remplacer les questions actuelles par cette proposition ?'))return false;t.questions=r.questions.map(q=>({question:q.question,answer:'',annex:q.annex}));t.comparisonReviewed=false;t.synthesisReviewed=false;w.workspace.interviewIndex=0;p.terrain=t}\n if(s==='comparison'){\n  if(t.comparisons.length&&!confirm('Remplacer le tableau actuel et les similitudes/différences ?'))return false;\n  const n=p.mode==='binome'?4:3;t.comparisons=Array.from({length:n},(_,i)=>({annex:i+1,theory:String(p.annexes?.[i+1]||'').slice(0,6000),practice:t.questions.filter(q=>q.annex===i+1&&q.answer.trim()).map(q=>q.question+'\\n'+q.answer).join('\\n\\n').slice(0,12000)}));\n  t.similarities=r.similarities;t.differences=r.differences;t.comparisonReviewed=false;t.synthesisReviewed=false;p.terrain=t;t.comparisonSignature=EGETerrain.comparisonSignature(p);w.workspace.comparisonIndex=0;\n }\n if(s==='synthesis'){if((t.synthesis.trim()||Object.values(w.workspace.synthesis||{}).some(x=>String(x||'').trim()))&&!confirm('Remplacer la synthèse actuelle ?'))return false;w.workspace.synthesis={intro:r.intro,development:r.development,conclusion:r.conclusion};t.synthesis=[r.intro,r.development,r.conclusion].join('\\n\\n');t.synthesisReviewed=false;p.terrain=t;t.synthesisSignature=EGETerrain.synthesisSignature(p)}\n touchTerrain();render();toast('Proposition intégrée au brouillon. Relisez-la avant validation.');return true;\n}\nfunction preview(k,r,stamp,id,versions=[r],index=versions.length-1){\n const s=stageFor(k);let dlg=document.querySelector('#mb-ege-ai-dialog');if(dlg)dlg.remove();\n dlg=document.createElement('dialog');dlg.id='mb-ege-ai-dialog';dlg.style.cssText='width:min(94vw,650px);max-height:88dvh;overflow:auto;border:0;border-radius:16px;padding:18px;color:inherit;background:var(--card,#fff);box-shadow:0 18px 70px #0005';\n const line=(label,txt)=>'<h3 style=\"font-size:1rem;margin:14px 0 6px\">'+esc(label)+'</h3><p style=\"white-space:pre-wrap;overflow-wrap:anywhere\">'+esc(txt)+'</p>';\n const use=i=>'<button type=\"button\" class=\"btn primary\" data-mb-ege-use=\"'+i+'\" style=\"margin:8px 0 12px\">Utiliser cette proposition</button>';\n const tr=(fr,en,ar)=>document.documentElement.lang==='ar'?ar:document.documentElement.lang==='en'?en:fr;\n const labels={another:tr('Une autre version','Another version','نسخة أخرى'),previous:tr('Précédente','Previous','السابقة'),next:tr('Suivante','Next','التالية'),version:tr('Version','Version','النسخة'),busy:tr('Préparation d’une autre version…','Generating another version…','جارٍ إعداد نسخة أخرى…'),same:tr('L’IA a proposé la même version. La proposition est conservée.','The AI returned the same version. Your proposal is kept.','قدّم الذكاء الاصطناعي النسخة نفسها. تم الاحتفاظ بالمقترح.')};\n let html='<div style=\"display:flex;align-items:center;justify-content:space-between;gap:8px\"><h2 style=\"font-size:1.15rem;margin:0\">Proposition IA</h2><button type=\"button\" class=\"btn smol\" data-mb-ege-close>Fermer</button></div><p class=\"small muted\">Brouillon à vérifier par l’élève et son enseignant.</p>';\n html+='<div style=\"display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0\"><button type=\"button\" class=\"btn\" data-mb-ege-another style=\"flex:1;min-width:140px\">'+esc(labels.another)+'</button><span class=\"small muted\">'+esc(labels.version)+' '+(index+1)+' / '+versions.length+'</span></div>';\n if(versions.length>1)html+='<div style=\"display:flex;gap:8px;flex-wrap:wrap\"><button type=\"button\" class=\"btn smol\" data-mb-ege-nav=\"-1\" '+(index===0?'disabled':'')+'>'+esc(labels.previous)+'</button><button type=\"button\" class=\"btn smol\" data-mb-ege-nav=\"1\" '+(index===versions.length-1?'disabled':'')+'>'+esc(labels.next)+'</button></div>';\n html+='<p class=\"small muted\" role=\"status\" data-mb-ege-variant-status></p>';\n if(s==='problem')html+=r.problems.map((x,i)=>line('Option '+(i+1),x)+use(i)).join('');\n if(s==='annex'){const source=proposalSource(Number(k.slice(1)),r),url=source.url;const titles=annexChoices(r);const rankLabels=[tr('Le plus recommandé','Most recommended','الأكثر توصية'),tr('Très pertinent','Very relevant','ملائم جدًا'),tr('Alternative pertinente','Relevant alternative','بديل ملائم')];const choices='<fieldset style=\"border:0;padding:0;margin:12px 0\"><legend style=\"font-weight:700;margin-bottom:8px\">'+esc(tr('Choisissez un titre','Choose a title','اختر عنوانًا'))+'</legend><p class=\"small muted\">'+esc(tr('Classement pédagogique indicatif selon la cohérence du titre, du texte et de la source proposée.','Indicative ranking by fit with the text and suggested source.','ترتيب إرشادي حسب توافق العنوان والنص والمصدر المقترح.'))+'</p>'+titles.map((o,i)=>'<label style=\"display:flex;gap:9px;align-items:flex-start;padding:10px;margin:7px 0;border:1px solid #d5dbe4;border-radius:10px;cursor:pointer\"><input type=\"radio\" name=\"mb-annex-title\" value=\"'+i+'\" '+(i===0?'checked':'')+'><span style=\"min-width:0;flex:1\"><small style=\"display:block;font-weight:600;color:var(--primary,#b80b38)\">'+(i+1)+' · '+esc(rankLabels[i])+'</small><strong style=\"display:block;overflow-wrap:anywhere\">'+esc(o.title)+'</strong>'+(o.reason?'<small class=\"muted\" style=\"display:block;margin-top:3px\">'+esc(o.reason)+'</small>':'')+'</span></label>').join('')+'</fieldset>';const article=choices+'<h3 data-mb-annex-current-title style=\"font-size:1rem;margin:14px 0 6px\">'+esc(titles[0].title)+'</h3>'+egeArticleBody(r.body).split('\\n\\n').map(p=>'<p style=\"line-height:1.55;margin:0 0 1em;overflow-wrap:anywhere\">'+esc(p)+'</p>').join('');html+=article+(url?'<h3 style=\"font-size:1rem;margin:14px 0 6px\">Source documentaire (HTTPS)</h3><p class=\"small\">'+esc(source.title)+'</p><a href=\"'+esc(url)+'\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"display:block;overflow-wrap:anywhere\">'+esc(url)+'</a><p class=\"small muted\">Consultez le document et confirmez la source dans votre annexe.</p>':line('Source à compléter',r.research))+use(0);}\n if(s==='interview')html+=r.questions.map((q,i)=>line('Question '+(i+1)+(egeIntroQuestion(q)?' · Présentation de l’entreprise':' · Annexe '+q.annex),q.question)).join('')+use(0);\n if(s==='comparison')html+=line('Recherches documentaires / Terrain','Les colonnes reprendront les annexes et vos réponses réellement saisies, rattachées à chaque annexe. Les cases sans réponse resteront vides.')+line('Similitudes proposées',r.similarities)+line('Différences proposées',r.differences)+use(0);\n if(s==='synthesis')html+=line('Introduction',r.intro)+line('Développement',r.development)+line('Conclusion',r.conclusion)+use(0);\n dlg.innerHTML=html;document.body.append(dlg);dlg.showModal();\n dlg.addEventListener('close',()=>dlg.remove(),{once:true});if(s==='annex')dlg.addEventListener('change',e=>{if(e.target?.name==='mb-annex-title'){const selected=annexChoices(r)[Number(e.target.value)];const head=dlg.querySelector('[data-mb-annex-current-title]');if(selected&&head)head.textContent=selected.title}});dlg.addEventListener('click',async e=>{\n  if(e.target.closest('[data-mb-ege-close]')){dlg.close();return}\n  if(pending)return;\n  const nav=e.target.closest('[data-mb-ege-nav]');if(nav){const next=index+Number(nav.dataset.mbEgeNav);if(versions[next])preview(k,versions[next],stamp,id,versions,next);return}\n  const another=e.target.closest('[data-mb-ege-another]');\n  if(another){const status=dlg.querySelector('[data-mb-ege-variant-status]');try{\n   if(!owner()||id!==st.selectedDocId||JSON.stringify(collect(k))!==stamp)throw Error('Le dossier a changé. Demandez une nouvelle proposition.');\n   if(!navigator.onLine)throw Error('Connexion Internet requise.');\n   if(versions.length>=20)throw Error('Limite de versions atteinte pour cet aperçu.');\n   pending=true;another.disabled=true;status.textContent=labels.busy;\n   const json=await requestProposal(k,collect(k),id,versions.length);\n   if(!dlg.open||!dlg.isConnected)return;\n   if(!owner()||id!==st.selectedDocId||JSON.stringify(collect(k))!==stamp)throw Error('Dossier modifié pendant l’analyse. Recommencez.');\n   if(versions.some(v=>JSON.stringify(v)===JSON.stringify(json.result))){status.textContent=labels.same;return}\n   const updated=versions.concat([json.result]);preview(k,json.result,stamp,id,updated,updated.length-1);\n  }catch(err){status.textContent=err.message||'Proposition indisponible.'}finally{pending=false;another.disabled=false}return}\n  const b=e.target.closest('[data-mb-ege-use]');if(!b)return;try{if(!owner()||id!==st.selectedDocId||JSON.stringify(collect(k))!==stamp)throw Error('Le dossier a changé. Demandez une nouvelle proposition.');const choice=s==='annex'?Number(dlg.querySelector('input[name=\"mb-annex-title\"]:checked')?.value||0):Number(b.dataset.mbEgeUse);if(apply(k,r,choice))dlg.close()}catch(err){toast(err.message)}\n });\n}\nasync function requestProposal(k,data,id,variant=0){\n const {data:session}=await st.db.auth.getSession();if(!session?.session?.access_token)throw Error('Reconnectez-vous.');\n const res=await fetch('/api/ege-ai',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+session.session.access_token},body:JSON.stringify({dossier:id,stage:stageFor(k),data,variant})}),json=await res.json();\n if(!res.ok)throw Error(json.error||'Proposition indisponible.');if(stageFor(k)==='annex'&&json.result){const source=proposalSource(Number(k.slice(1)),json.result);json.result.sourceUrl=source.url;json.result.sourceTitle=source.title;json.result.body=egeArticleBody(json.result.body??json.result.paragraphs)}return json\n}\nlet pending=false;\ndocument.addEventListener('click',async e=>{\n const b=e.target.closest?.('[data-ege-ai]');if(!b||pending)return;e.preventDefault();const k=b.dataset.egeAi,status=b.parentElement.querySelector('[data-ege-ai-status]');let data,id,stamp;\n try{data=collect(k);id=st.selectedDocId;stamp=JSON.stringify(data);if(!navigator.onLine)throw Error('Connexion Internet requise.');if(!confirm('L’IA recevra uniquement les éléments pédagogiques utiles. Assurez-vous que vos textes ne contiennent aucun nom, numéro, adresse personnelle ou information confidentielle. Continuer ?'))return;\n pending=true;b.disabled=true;status.textContent='Préparation de la proposition…';\n const json=await requestProposal(k,data,id,0);\n if(!owner()||id!==st.selectedDocId||JSON.stringify(collect(k))!==stamp)throw Error('Dossier modifié pendant l’analyse. Recommencez.');\n status.textContent='Proposition prête.';preview(k,json.result,stamp,id);\n }catch(err){if(status)status.textContent=err.message||'Proposition indisponible.';else toast(err.message)}finally{pending=false;b.disabled=false}\n},true);\nwindow.MBEgeAI={panel,sourceField};\n})();\n"],"/ege-workspace-export-r2.js":["application/javascript; charset=utf-8",false,"/* Un même plan paginé pour Word et PDF. Les textes restent éditables dans Word. */\n(()=>{'use strict';\nconst X=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&apos;'}[c]));\nconst value=v=>String(v||'À renseigner');\nconst candidates=p=>[p.student,p.mode==='binome'?p.partner:''].filter(Boolean).join(' et ');\nconst year=p=>p.academicYear||p.schoolYear||p.year||'2026–2027';\nfunction totalHours(rows){let minutes=0,unknown=0;for(const r of rows){const s=String(r.duration||'').trim().toLowerCase().replace(',','.');if(!s){unknown++;continue}const h=s.match(/^(\\d+(?:\\.\\d+)?)\\s*(?:h(?:eures?)?)?\\s*(\\d{1,2})?\\s*(?:min)?$/),m=s.match(/^(\\d+)\\s*min(?:utes?)?$/),c=s.match(/^(\\d+):(\\d{2})$/);if(m)minutes+=Number(m[1]);else if(c)minutes+=Number(c[1])*60+Number(c[2]);else if(h)minutes+=Number(h[1])*60+Number(h[2]||0);else unknown++}const a=Math.round(minutes);return `${Math.floor(a/60)} h${a%60?' '+String(a%60).padStart(2,'0')+' min':''}${unknown?' (durées à compléter : '+unknown+')':''}`}\nfunction blocks(p,catalog){const w=p.study?.workspace||{},t=EGETerrain.normalize(p.terrain,p),topic=EGEStudy.topic(p,catalog),n=p.mode==='binome'?4:3,annex=i=>p.annexTitles?.[i]||getTitle(i,p);const b=(label,v)=>({label,text:value(v)});return [\n {title:'ÉTUDE DE GESTION ENCADRÉE',cover:true,items:[b('Baccalauréat – Session 2027',p.series),b('Candidat(s)',[p.student,p.mode==='binome'?p.partner:''].filter(Boolean).join(' et ')),b('Classe',p.className),b('Établissement',p.school),b('Encadreur',p.teacher),b('Thème',topic.theme),b('Sous-thème',topic.subtheme),b('Problématique',p.problem)]},\n {title:'SOMMAIRE',toc:true,items:[]},\n {title:'REMERCIEMENTS',items:[b('',w.thanksText)]},\n {title:'FICHE D’ÉTUDE',items:[b('Candidat(s)',[p.student,p.mode==='binome'?p.partner:''].filter(Boolean).join(' et ')),b('Classe et établissement',[p.className,p.school].filter(Boolean).join(' · ')),b('Thème et sous-thème',[topic.theme,topic.subtheme].filter(Boolean).join(' · ')),b('Problématique',p.problem),b('Calendrier des tâches',(w.calendar||[]).map(r=>[r.date,r.duration,r.task].filter(Boolean).join(' | ')).join('\\n')),b('Annexes et sources',Array.from({length:n},(_,i)=>`${i+1}. ${annex(i+1)} — ${value(p.sources?.[i+1])}`).join('\\n')),b('Méthodes',w.methods),b('Outils utilisés',w.tools),b('Documents produits',w.produced),b('Observations',w.observations),b('Encadreur et date',[p.teacher,w.signatureDate].filter(Boolean).join(' · ')),b('Signature de l’encadreur            Cachet de l’établissement','\\n\\n')]},\n ...(p.mode==='binome'?[{title:'RÉPARTITION DES TÂCHES',items:[b('Tâches / Responsable / Date',(w.tasks||[]).map(r=>[r.task,r.person,r.date].filter(Boolean).join(' | ')).join('\\n'))]}]:[]),\n ...Array.from({length:n},(_,i)=>({title:'ANNEXE '+(i+1)+' – '+annex(i+1),annex:true,items:[b('',p.annexes?.[i+1]),b('Source',p.sources?.[i+1])]})),\n {title:'PRÉSENTATION DE L’ENTREPRISE',items:[...(t.logo?[{image:t.logo,label:'Logo'}]:[]),...['organizationName','legalForm','creationDate','address','employees','turnover','activities','scope','history','visionStrategy','organizationSource'].map(k=>b(EGETerrain.fields[k][0],t[k])),...(t.organizationChart?[{image:t.organizationChart,label:'Organigramme'}]:[]),b('Description de l’organigramme',t.organizationChartText)]},\n {title:'ENTRETIEN AVEC LE PROFESSIONNEL',items:[...['professionalName','professionalRole','interviewDate','interviewMethod','interviewDifficulties'].map(k=>b(EGETerrain.fields[k][0],t[k])),...t.questions.map((q,i)=>b('Question '+(i+1)+(q.annex?' · Annexe '+q.annex:''),value(q.question)+'\\nRéponse : '+value(q.answer)))]},\n {title:'TABLEAU COMPARATIF',items:[...t.comparisons.flatMap(r=>[b('Annexe '+r.annex+' — Recherche documentaire',r.theory),b('Contextualisation sur le terrain',r.practice)]),b('Similitudes',t.similarities),b('Différences',t.differences)]},\n {title:'SYNTHÈSE',items:w.synthesis?[b('Introduction',w.synthesis.intro),b('Développement',w.synthesis.development),b('Conclusion',w.synthesis.conclusion)]:[b('',t.synthesis)]}\n ]}\nasync function assets(sections,db){for(const s of sections)for(const i of s.items)if(i.image){let blob=await window.EGEOffline?.image(i.image.path);if(!blob&&db&&navigator.onLine){const r=await db.storage.from(EGETerrain.BUCKET).download(i.image.path);if(r.error)throw r.error;blob=r.data}if(!blob)throw Error('Image indisponible : reconnectez-vous pour exporter.');i.bytes=new Uint8Array(await blob.arrayBuffer());const w=Math.min(i.label==='Logo'?42:155,i.image.width*.264);i.w=w;i.h=w*i.image.height/i.image.width;if(i.h>115){i.w*=115/i.h;i.h=115}}}\nconst baseBlocks=blocks;blocks=function(p,catalog){const ss=baseBlocks(p,catalog),w=p.study?.workspace||{},t=EGETerrain.normalize(p.terrain,p),n=p.mode==='binome'?4:3;const f=ss.find(x=>x.title==='FICHE D’ÉTUDE');f.items=f.items.flatMap(i=>i.label==='Calendrier des tâches'?[{label:i.label,text:''},{cells:['Date','Durée','Travaux réalisés'],bold:true},...(w.calendar||[]).map(r=>({cells:[value(r.date),value(r.duration),value(r.task)]}))]:i.label==='Annexes et sources'?[{label:i.label,text:''},{cells:['Titre de l’annexe','Source'],bold:true},...Array.from({length:n},(_,j)=>({cells:[(j+1)+'. '+getTitle(j+1,p),value(p.sources?.[j+1])]}))]:i.label?.startsWith('Signature de')?[{cells:['Signature de l’encadreur','Cachet de l’établissement'],bold:true},{cells:['','']},{cells:['','']},{cells:['','']}]:[i]);const c=ss.find(x=>x.title==='TABLEAU COMPARATIF');c.items=[{cells:['Recherche documentaire','Contextualisation sur le terrain'],bold:true},...Array.from({length:n},(_,j)=>{const row=t.comparisons[j]||{};return [{label:'Annexe '+(j+1),text:''},{cells:[value(row.theory),value(row.practice)]}]}).flat(),{label:'Similitudes',text:value(t.similarities)},{label:'Différences',text:value(t.differences)}];const tasks=ss.find(x=>x.title==='RÉPARTITION DES TÂCHES');if(tasks)tasks.items=[{cells:['Tâche','Responsable','Date'],bold:true},...(w.tasks||[]).map(r=>({cells:[value(r.task),value(r.person),value(r.date)]}))];return ss};\nconst ns='http://schemas.openxmlformats.org/wordprocessingml/2006/main',rels='http://schemas.openxmlformats.org/package/2006/relationships',office='http://schemas.openxmlformats.org/officeDocument/2006/relationships/';\n/* Préliminaires : modèle institutionnel et calendrier détaillé commun aux deux exports. */\nconst legacyBlocks=blocks;blocks=function(p,catalog){\n const ss=legacyBlocks(p,catalog),w=p.study?.workspace||{},topic=EGEStudy.topic(p,catalog),n=p.mode==='binome'?4:3,calendar=Array.isArray(w.calendar)?w.calendar:[],b=(label,text)=>({label,text:value(text)}),cell=(...cells)=>({cells}),title=i=>p.annexTitles?.[i]||getTitle(i,p);\n const cover=ss[0];cover.title='DOSSIER D’ÉPREUVE DE GESTION ET D’ÉCONOMIE';cover.items=[{center:true,text:'BACCALAURÉAT GÉNÉRAL – SESSION 2027',bold:true},{center:true,text:'Série : '+value(p.series),bold:true},{center:true,text:'Année scolaire '+year(p)},{space:12},cell('Thème',value(topic.theme)),cell('Sous-thème',value(topic.subtheme)),cell('Problématique',value(p.problem)),{space:10},cell('Préparé par',value(candidates(p))),cell('Classe',value(p.className)),cell('Établissement',value(p.school)),cell('Encadré par',value(p.teacher))];\n const f=ss.find(x=>x.title==='FICHE D’ÉTUDE');f.compact=true;f.items=[cell('Candidat(s)',value(candidates(p))),cell('Série / Classe',[p.series,p.className].filter(Boolean).join(' · ')||'À renseigner'),cell('Établissement',value(p.school)),cell('Année scolaire',year(p)),...(p.candidateNumber||w.candidateNumber?[cell('N° de candidat',p.candidateNumber||w.candidateNumber)]:[]),cell('Thème',value(topic.theme)),cell('Sous-thème',value(topic.subtheme)),cell('Problématique',value(p.problem)),{label:'Calendrier des travaux',text:''},cell('Période',calendar.length?[calendar[0]?.date,calendar.at(-1)?.date].filter(Boolean).join(' au ')||'À renseigner':'À renseigner'),cell('Durée totale',calendar.length?totalHours(calendar):'À renseigner'),{label:'Recherche documentaire : annexes et sources',text:''},{cells:['Titre de l’annexe','Source consultée'],bold:true},...Array.from({length:n},(_,j)=>cell((j+1)+'. '+title(j+1),value(p.sources?.[j+1]))),{label:'Démarche et résultats',text:''},cell('Méthodes de recherche',value(w.methods)),cell('Technologies et outils',value(w.tools)),cell('Documents produits',value(w.produced)),cell('Observations',value(w.observations)),cell('Validé par / Date',[p.teacher,w.signatureDate].filter(Boolean).join(' · ')||'À renseigner'),{cells:['Signature de l’encadreur','Cachet de l’établissement'],bold:true},{cells:['',''],minHeight:15}];\n const steps=['Choix du sujet et de la problématique','Recherche documentaire','Sélection et analyse des documents','Rédaction des annexes','Préparation de l’entretien','Visite et collecte des informations','Comparaison théorie / terrain','Rédaction de la synthèse'];\n const dashboard={title:'TABLEAU DE BORD DE L’ÉLÈVE',dashboard:true,items:[b('Candidat(s)',candidates(p)),{cells:['Date','Durée','Travaux réalisés'],bold:true},...(calendar.length?calendar.map(r=>cell(value(r.date),value(r.duration),value(r.task))):steps.map(t=>cell('','',t))),{cells:['Total',calendar.length?totalHours(calendar):'À renseigner',''],bold:true}]};ss.splice(ss.indexOf(f)+1,0,dashboard);\n return ss;\n};\nasync function download(p,format,catalog,db){const pages=await plan(p,catalog,db),name='EGE-2027-'+String(p.student||'dossier').replace(/[^\\p{L}\\p{N}_-]+/gu,'-').slice(0,60);if(format==='pdf'){(await pdf(p,pages)).save(name+'.pdf');return}const blob=await word(p,pages),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name+'.docx';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}\n/* Layout v2: measure real glyph widths, paginate atomic blocks and preserve\n   source links even when an appendix spans multiple sheets. */\nconst mmTwip=v=>Math.round(v*1440/25.4), pageWidth=174, bodyBudget=234;\nfunction fontDoc(){const d=new jspdf.jsPDF({unit:'mm',format:'a4',compress:true});for(const [style,data] of Object.entries(EGEFonts)){d.addFileToVFS('EGE-'+style+'.ttf',data);d.addFont('EGE-'+style+'.ttf','EGE',style)}return d}\nfunction measured(d,s,width,size,bold=false){d.setFont('EGE',bold?'bold':'normal');d.setFontSize(size);return String(s??'').split('\\n').flatMap(t=>t?d.splitTextToSize(t,width):[''])}\nfunction textItems(d,it,width,size=11,gap=1.8,step=5){\n const out=[],s=String(it.text??'');if(it.label)out.push({kind:'text',lines:measured(d,it.label,width,size,true),size,bold:true,step,gap:.6,keep:true});\n if(!s.trim())return out;\n const source=it.label==='Source';\n for(const par of s.split(/\\n\\s*\\n/).filter(x=>x.trim())){\n  if(source){\n   const parts=par.split(/(https:\\/\\/[^\\s<>\"']+)/gi);\n   for(const part of parts.filter(x=>x.trim())){const url=/^https:\\/\\//i.test(part)?part:undefined;out.push({kind:'text',lines:measured(d,part.trim(),width,10),size:10,step:4.5,gap:1,url})}\n  }else out.push({kind:'text',lines:measured(d,par,width,size),size,step,gap});\n }return out;\n}\nfunction rowItem(d,cells,{header=false,widths=null,compact=false,minHeight=0}={}){\n widths=widths||cells.map(()=>pageWidth/cells.length);\n const size=compact?10.5:10,step=compact?4.2:4.1,lines=cells.map((v,j)=>measured(d,v,widths[j]-6,size,header)),urls=cells.map(v=>String(v).trim().match(/^https:\\/\\/[^\\s<>\"']+$/i)?.[0]);\n return {kind:'row',cells:lines,rawCells:cells,widths,size,step,pad:compact?1.25:1.8,header,urls,minHeight};\n}\nconst height=i=>i.kind==='space'?i.h:i.kind==='image'?i.h+3:i.kind==='row'?Math.max(i.minHeight||0,Math.max(...i.cells.map(a=>a.length))*i.step+2*i.pad):i.lines.length*i.step+i.gap;\nfunction layout(s,d){\n const pages=[],toc=[];\n for(const section of s){\n  const title=section.title, isCompare=title==='TABLEAU COMPARATIF', isFiche=title==='FICHE D’ÉTUDE';\n  let budget=bodyBudget;\n  const newPage=()=>{const heading=current?title+' (suite)':title;budget=(section.cover?195:bodyBudget)-Math.max(0,measured(d,heading,pageWidth,14,true).length-1)*6;return {title:heading,items:[],annex:!!section.annex,cover:!!section.cover,toc:!!section.toc,budget}};\n  let current=null,used=0,activeHeader=null,activeLabel=null;\n  function open(continuation=false){current=newPage();pages.push(current);used=0;if(continuation&&activeHeader){current.items.push(activeHeader);used+=height(activeHeader)}if(continuation&&activeLabel){const label={...activeLabel,lines:[activeLabel.lines[0]+' (suite)'],keep:false};current.items.push(label);used+=height(label)}}\n  function put(i){current.items.push(i);used+=height(i)}\n  open();if(!section.cover&&!section.toc)toc.push([title,pages.length-1]);\n  if(section.toc)continue;\n  if(section.annex){\n   const content=section.items.flatMap(it=>textItems(d,it,pageWidth-8,11,2.2,4.8));\n   // 98% of the usable annex area, without inflating short/incomplete text.\n   const raw=content.reduce((n,i)=>n+height(i),0),target=(budget-5)*.98;\n   if(raw<=target&&raw>target*.65){const add=Math.min(2.5,(target-raw)/Math.max(1,content.reduce((n,i)=>n+i.lines.length,0)));for(const i of content)i.step+=add}\n   for(let j=0;j<content.length;j++){\n    let i=content[j];if(i.keep&&j+1<content.length&&used+height(i)+Math.min(height(content[j+1]),10)>budget-5)open(true);\n    while(height(i)>budget-5-used){const count=Math.floor((budget-5-used-i.gap)/i.step);if(count<2){open(true);continue}const cut=Math.min(count,i.lines.length-1);if(cut<1){open(true);continue}put({...i,lines:i.lines.slice(0,cut),gap:0});i={...i,lines:i.lines.slice(cut)};open(true)}\n    put(i);\n   }continue;\n  }\n  const items=[];\n  for(const it of section.items){\n   if(it.space){items.push({kind:'space',h:it.space});continue}\n   if(it.image){items.push({kind:'image',...it});continue}\n   if(it.cells){\n    const widths=it.cells.length===3?(isFiche||section.dashboard?[35,32,107]:[92,47,35]):it.cells.length===2?(isFiche?[60,114]:section.cover?[52,122]:[87,87]):null;\n    items.push(rowItem(d,it.cells,{header:!!it.bold,widths,compact:!!section.compact,minHeight:it.minHeight||0}));continue;\n   }\n   const lines=textItems(d,it,pageWidth,isFiche?9.5:11,isFiche?.6:1.8,isFiche?3.8:5);if(it.center)for(const i of lines){i.center=true;i.bold=!!it.bold}items.push(...lines);\n  }\n  // Les valeurs extrêmes restent intégrales : compacter seulement dans les limites de lisibilité.\n  if(isFiche){const sum=items.reduce((a,i)=>a+height(i),0);if(sum>budget){for(const i of items){if(i.kind==='row'){i.pad=.7;i.step=3.65;i.size=9.5;i.cells=i.rawCells.map((v,j)=>measured(d,v,i.widths[j]-6,i.size,i.header))}else if(i.kind==='text'){i.step=3.65;i.size=9.5}}}}\n  for(let j=0;j<items.length;j++){\n   let i=items[j],next=items[j+1];\n   if(i.kind==='row'&&i.header){activeHeader=i;activeLabel=null}\n   if(isCompare&&i.kind==='text'&&i.bold&&/^Annexe \\d/.test(i.lines[0])){activeLabel=i;const estimate=next?(height(next)+height(i)+(activeHeader?height(activeHeader):0)<=budget?height(next):25):0;if(used+height(i)+estimate>budget){activeLabel=null;open(true);activeLabel=i}}\n   if(isCompare&&i.kind==='text'&&i.bold&&/^(Similitudes|Différences)$/.test(i.lines[0])){activeHeader=null;activeLabel=null}\n   if(i.keep&&next&&used+height(i)+Math.min(height(next),12)>budget)open(true);\n   if(i.kind==='row'){\n    // One cell per real comparison, with continuation rows only when needed.\n    if(i.header&&used+height(i)+10>budget){activeHeader=null;open();activeHeader=i}\n    while(height(i)>budget-used){\n     const num=Math.floor((budget-used-2*i.pad)/i.step);\n     if(num<3){open(true);continue}\n     put({...i,cells:i.cells.map(a=>a.slice(0,num))});i={...i,cells:i.cells.map(a=>a.slice(num))};open(true)\n    }put(i);continue;\n   }\n   if(i.kind==='image'||i.kind==='space'){if(used+height(i)>budget)open(true);put(i);continue}\n   if(!isCompare&&i.bold&&activeHeader&&(!next||next.kind!=='row')){activeHeader=null;activeLabel=null}\n   while(height(i)>budget-used){\n    const num=Math.floor((budget-used-i.gap)/i.step);\n    if(num<2){open(true);continue}\n    const cut=Math.min(num,i.lines.length-1);if(cut<1){open(true);continue}\n    put({...i,lines:i.lines.slice(0,cut),gap:0});i={...i,lines:i.lines.slice(cut)};open(true)\n   }put(i)\n  }\n }\n const tocPage=pages.find(x=>x.toc);const entry=(title,n)=>({kind:'toc',lines:measured(d,title,pageWidth-19,10.5),size:10.5,step:4.5,gap:1.3,n});const group=s=>({kind:'text',lines:measured(d,s,pageWidth,10.5,true),bold:true,size:10.5,step:5,gap:1.5});tocPage.items=[group('PARTIES PRÉLIMINAIRES'),entry('Page de garde','—'),entry('Sommaire',1)];for(const [title,n] of toc){if(/^ANNEXE 1 /i.test(title))tocPage.items.push(group('PARTIE I : RECHERCHE DOCUMENTAIRE'));if(title==='PRÉSENTATION DE L’ENTREPRISE')tocPage.items.push(group('PARTIE II : CONTEXTUALISATION DE LA THÉORIE SUR LE TERRAIN'));if(title==='SYNTHÈSE')tocPage.items.push(group('PARTIE III : SYNTHÈSE'));tocPage.items.push(entry(title,n));if(title==='PRÉSENTATION DE L’ENTREPRISE'){const chart=pages.findIndex((pg,k)=>k>=n&&pg.title.startsWith(title)&&pg.items.some(i=>i.label==='Organigramme'||i.lines?.some(l=>l==='Description de l’organigramme')));tocPage.items.push(entry('Organigramme',chart>=0?chart:n))}}\n return pages;\n}\nasync function plan(p,catalog,db){await EGEPDF.prepare();const s=blocks(p,catalog);await assets(s,db);return layout(s,fontDoc())}\nasync function pdf(p,pages){await EGEPDF.prepare();const d=fontDoc();for(let idx=0;idx<pages.length;idx++){\n const pg=pages[idx];if(idx)d.addPage();d.setTextColor(0,0,0);d.setFont('EGE','bold');d.setFontSize(14);\n const title=measured(d,pg.title,pageWidth,14,true);if(pg.cover){d.setFontSize(12);d.text('RÉPUBLIQUE DE DJIBOUTI',105,22,{align:'center'});d.setFont('EGE','normal');d.setFontSize(10);d.text('Unité – Égalité – Paix',105,28,{align:'center'});d.text('Ministère de l’Éducation nationale et de la Formation professionnelle',105,36,{align:'center'});d.setFont('EGE','bold');d.setFontSize(14)}d.text(title,105,pg.cover?52:22,{align:'center'});let y=(pg.cover?65:34)+(title.length-1)*6;\n if(pg.annex){d.setDrawColor(80,80,80);d.setLineWidth(.3);d.rect(18,y,pageWidth,pg.budget);y+=3}\n for(const i of pg.items){\n  if(i.kind==='space'){y+=i.h;continue}\n  if(i.kind==='image'){d.addImage(i.bytes,'JPEG',(210-i.w)/2,y,i.w,i.h);y+=height(i);continue}\n  d.setFont('EGE',(i.bold||i.header)?'bold':'normal');d.setFontSize(i.size);\n  if(i.kind==='row'){\n   const h=height(i);let x=18;d.setDrawColor(185,185,185);d.setLineWidth(.18);\n   i.cells.forEach((lines,j)=>{const w=i.widths[j];if(i.header){d.setFillColor(235,235,235);d.rect(x,y,w,h,'FD')}else d.rect(x,y,w,h);const link=i.urls?.[j];d.setTextColor(...(link?[21,70,130]:[0,0,0]));lines.forEach((li