ournal-title small{font-size:10px;color:#65717d}\n#mbi-root .mbi-journal-wrap{max-width:100%;overflow-x:auto;border:1px solid #eed9de;border-radius:9px}\n#mbi-root .mbi-journal-table{min-width:570px;width:100%;table-layout:fixed;border-collapse:collapse;font-size:12px}\n#mbi-root .mbi-journal-table th{background:#c60835;color:#fff;text-align:center;font-size:11px;padding:11px 4px}\n#mbi-root .mbi-journal-table th:nth-child(1),#mbi-root .mbi-journal-table th:nth-child(2){width:12%}\n#mbi-root .mbi-journal-table th:nth-child(3){width:36%}\n#mbi-root .mbi-journal-table th:nth-child(4),#mbi-root .mbi-journal-table th:nth-child(5){width:20%}\n#mbi-root .mbi-journal-table td{max-width:none;padding:5px;text-align:left;border:1px solid #e2e3e8;font-size:12px;overflow-wrap:anywhere}\n#mbi-root .mbi-journal-table input{width:100%!important;min-width:0!important;max-width:100%!important;min-height:37px!important;padding:5px!important;font-size:13px!important}\n#mbi-root .mbi-journal-date td{text-align:center;background:#fff5f8}\n#mbi-root .mbi-journal-label td{text-align:center;background:#f8f9fb;font-size:11px;font-style:italic;padding:8px}\n#mbi-root .mbi-journal-totals{background:#f6f7fa;border-radius:9px;padding:10px;font-weight:750;font-size:12px;text-align:center;font-variant-numeric:tabular-nums}\n#mbi-root .mbi-journal .mbi-button{align-self:center}\n#mbi-root .mbi-hint{border:1px solid #eddcae;background:#fffbf0;border-radius:12px;padding:11px}\n#mbi-root .mbi-hint summary{cursor:pointer;color:#8f6915;font-weight:750}\n#mbi-root .mbi-option-tag{display:inline-flex;align-items:center;justify-content:center;width:27px;height:27px;background:#fde9ef;border-radius:50%;color:#9f0d36;font-weight:800;font-size:12px}\n#mbi-root .mbi-choice.mbi-true:has(input:checked){background:#edf9f2;border-color:#289a58}\n#mbi-root .mbi-choice.mbi-false:has(input:checked){background:#fff1f3;border-color:#d13a54}\n#mbi-root .mbi-feedback{padding:12px 13px;border-radius:11px;border:1px solid