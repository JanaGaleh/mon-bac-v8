target.name==='file'&&$('lrWizard'))capture()});\ndocument.addEventListener('input',e=>{if(e.target.matches('[data-lr-query]')){query=e.target.value;page=0;const list=$('lrList');if(list){const parent=document.createElement('div');parent.innerHTML=st.screen==='student-learning'?student():teacher();list.innerHTML=parent.querySelector('#lrList')?.innerHTML||''}}});\ndocument.addEventListener('click',async e=>{const b=e.target.closest?.('[data-lr]');if(!b||b.disabled)return;const a=b.dataset.lr,id=b.dataset.id;try{if(a==='payment-settings-open'){go('admin-learning');tab='accounts';settingsNotice='';render();return}if(a==='request-specialty'){capture();b.disabled=true;try{await api('request_specialty',{series:draft.series,academic_level:draft.academic_level,subject:draft.subject});await load()}finally{b.disabled=false}return}if(a==='close'){close();return}if(a==='tab'){if($('lrWizard'))capture();tab=id;settingsNotice='';page=0;query='';filter='';if(['add','qcm'].includes(tab)&&(!draft||interactive(draft.kind)!==(tab==='qcm')))newDraft(tab==='qcm');render();return}if(a==='page'){page=Math.max(0,page+Number(id));render();return}if(a==='refresh'){await load();return}if(a==='catalogue'){await publicCatalogue();return}if(a==='signup'||a==='login'){close();st.desired='eleve';st.mode=a==='signup'?'signup':'login';st.screen='auth';render();return}if(a==='interactive-open'){if(!window.MonBacInteractive?.openExercise)throw Error('Exercices interactifs indisponibles');await window.MonBacInteractive.openExercise(id);return}if(a==='open'||a==='teacher-open'){await openResource(id,a==='teacher-open');return}if(a==='invoice'){await invoice(id);return}if(a==='join'){await join(id);return}if(a==='request'){await api('request_join',{id});close();toast('Demande envoyée.');await load();return}if(['approve','refuse','archive','publish'].includes(a)){if(a==='archive'&&!await window.MBDialog.confirm('Archiver cette ressource ?'))return;await api({approve:'approve_join',refuse:'refuse_join',ar