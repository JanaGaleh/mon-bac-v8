ex-direction:column;gap:3px;text-align:center}\n#mbi-root .mbi-overview-numbers strong{font-size:20px;color:#b40b37;font-variant-numeric:tabular-nums}\n#mbi-root .mbi-overview-numbers small{font-size:10px;color:#5f6877}\n#mbi-root .mbi-review-suggestions{border-top:1px solid #eadfe3;padding-top:9px}\n#mbi-root .mbi-review-suggestions summary{cursor:pointer;font-size:13px;color:#a60d38;font-weight:700}\n#mbi-root .mbi-suggestion{width:100%;display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;border:0;border-bottom:1px solid #eee;background:transparent;padding:10px 3px;font-size:12px;color:#37414e;cursor:pointer}\n#mbi-root .mbi-suggestion span{font-weight:800;color:#b10e39;white-space:nowrap}\n\n\n/* monAvenir - écran intégré à Travailler, maquette rouge et blanc */\n#mbi-root{font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n#mbi-root .mbi-shell{background:#fff}\n#mbi-root .mbi-intro h2{color:#17263e}\n#mbi-root .mbi-category-chips{flex-wrap:nowrap;overflow-x:auto;display:flex;gap:8px;padding:7px 2px 12px}\n#mbi-root .mbi-chip{font:700 13px/1.25 inherit;border-radius:12px;border:1px solid #ead6dd;background:#fff;color:#9f1339;white-space:nowrap;min-height:42px;padding:9px 14px}\n#mbi-root .mbi-chip.is-active{background:#c60835;color:#fff;border-color:#c60835}\n#mbi-root .mbi-overview{display:block;padding:14px 15px;background:#fff6f8;border:1px solid #f4dae2;border-radius:16px}\n#mbi-root .mbi-overview>.mbi-row{display:flex;align-items:center;justify-content:space-between;gap:9px}\n#mbi-root .mbi-overview-numbers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}\n#mbi-root .mbi-overview-numbers>div{min-width:0;display:flex;flex-direction:column;gap:4px;text-align:center;border-radius:10px;padding:9px 5px;background:#fff;border:1px solid #f0e5e9}\n#mbi-root .mbi-overview-numbers strong{display:block;font-size:20px;color:#bb103d}\n#mbi-root .mbi-overview-numbers small{font-size:10px;line-height:1.4;color:#65717f}\n#mbi-root .mbi-sheet .mbi-sheet-head{display:flex;justify-content:space-between;align-items:center;gap:9px}\n#mbi-root .mbi-sheet .mbi-sheet-table{width:100%;display:table;border-collapse:collapse}\n#mbi-root .mbi-sheet .mbi-sheet-table th,#mbi-root .mbi-sheet .mbi-sheet-table td{border:1px solid #e5e7ec;padding:10px 7px}\n#mbi-root .mbi-question{display:flex;align-items:start;gap:11px}\n#mbi-root .mbi-situation{border-radius:14px;background:#fff5f7;border:1px solid #f3d8df;padding:14px}\n#mbi-root .mbi-journal-wrap{overflow-x:auto;max-width:100%}\n#mbi-root .mbi-journal-table{min-width:570px;table-layout:fixed}\n#mbi-root .mbi-journal-table th{background:#c60835!important;color:white!important}\n#mbi-root .mbi-footer{position:relative;flex-wrap:nowrap}\n#mbi-root .mbi-button{display:inline-flex;align-items:center;justify-content:center;border-radius:11px}\n#mbi-root .mbi-feedback{padding:11px 12px;border-radius:12px}\n.lr-native-interactive{border:1px solid #ece7eb!important;border-radius:14px!important;padding:13px!important;margin:8px 0;background:#fff;box-shadow:0 4px 14px #10182809}\n.lr-native-interactive>.lr-symbol{background:#fff0f4!important;color:#c60835!important}\n.lr-native-interactive>div{flex:1;min-width:0}\n.lr-native-interactive .btn{border-radius:11px;min-height:42px;background:#c60835;color:white}\n.lr-tabs button[aria-pressed=true]{background:#c60835!important;border-color:#c60835!important;color:#fff!important}\n@media(max-width:520px){\n #mbi-root .mbi-main{padding:14px 12px;gap:10px}\n #mbi-root .mbi-situation p{font-size:13px}\n #mbi-root .mbi-question h2{font-size:16px}\n #mbi-root .mbi-sheet-head strong{font-size:14px}\n .lr-native-interactive{display:grid!important;grid-template-columns:39px minmax(0,1fr);gap:9px!important}\n .lr-native-interactive>.lr-symbol{grid-row:1;grid-column:1}\n .lr-native-interactive>div{grid-column:2;grid-row:1}\n .lr-native-interactive>.btn{grid-column:1/-1;width:100%;margin-top:5px}\n}\n"],"/mon-bac-v85-travailler-20261119-sans-sujets.js":["application/javascript; charset=utf-8",false,"/* monAvenir V85 — ressources, activités, achats et approbations. */\n(()=>{'use strict';\nconst kinds={fiche:'Fiche de cours',resume:'Résumé',exercice:'Exercice',corrige:'Corrigé',devoir:'Devoir à rendre',bac:'Sujet BAC',qcm:'QCM',test:'Test',interactif:'Exercice interactif'}, interactive=k=>['qcm','test','interactif'].includes(k), money=n=>Number(n||0).toLocaleString('fr-FR')+' FDJ', date=s=>s?new Date(s).toLocaleDateString('fr-FR'):'', E=esc;\nconst actions=(key,label,id='',cls='btn')=>`<button type=\"button\" class=\"${cls}\" data-lr=\"${key}\" data-id=\"${E(id)}\">${E(label)}</button>`, link=(screen,label)=>`<button type=\"button\" class=\"btn\" data-act=\"goto\" data-to=\"${screen}\">${E(label)}</button>`, row=(head,sub,tail='')=>`<div class=\"lr-row\"><div><strong>${E(head)}</strong><small>${E(sub)}</small></div>${tail}</div>`, empty=s=>`<p class=\"lr-empty\">${E(s)}</p>`, opts=(values,selected='')=>values.map(([v,l])=>`<option value=\"${E(v)}\" ${v===selected?'selected':''}>${E(l)}</option>`).join(''), field=(label,html)=>`<label class=\"lr-field\"><span>${E(label)}</span>${html}</label>`, input=(name,value='',more='')=>`<input class=\"input\" name=\"${name}\" value=\"${E(value)}\" ${more}>`, select=(name,values,value='')=>`<select class=\"select\" name=\"${name}\">${opts(values,value)}</select>`, price=r=>r.price?money(r.price):'Gratuit', status={unpaid:'À payer',pending:'En vérification',paid:'Payé',refused:'Refusé',approved:'Approuvé'};\nlet owner='', data={}, catalogue=[], interactiveCatalogue=[], tab='', filter='', query='', page=0, loading=false, error='', draft=null, draftStep=0, qEdit=0, modal=null, timer=null, urls=[];\nconst seriesList=['GFM','OGRH','IAG','S','ES','L'],levelList=['Première','Terminale'],commonSubjects=['Mathématiques','Physique et Chimie','SVT','Français','Anglais','Arabe','SES','Philosophie','Chinois','Russe'],managementSubjects=['Gestion Financière','Mercatique','OGRH','IAG','Économie et Droit','Management des Organisations','Communication','Principes de gestion'],paymentMethods=['Waafi','CacPay','D-Money','SabaPay','Espèces'];\nconst specialty=d=>(data.specialties||[]).find(s=>s.series===d.series&&s.academic_level===d.academic_level&&s.subject.toLowerCase()===d.subject.toLowerCase());\nfunction subjectOptions(d){const own=(data.specialties||[]).filter(s=>s.series===d.series&&s.academic_level===d.academic_level).map(s=>s.subject);return [...new Map([...own,...(seriesList.slice(0,3).includes(d.series)?managementSubjects:[]),...commonSubjects].reverse().map(s=>[s.toLowerCase(),s])).values()].sort((a,b)=>a.localeCompare(b,'fr')).map(s=>[s,s])}\nfunction specialtyFields(d){const s=specialty(d);return field('Série',select('series',[['','Choisir la série'],...seriesList.map(x=>[x,x])],d.series))+field('Niveau',select('academic_level',[['','Choisir le niveau'],...levelList.map(x=>[x,x])],d.academic_level))+field('Matière',select('subject',[['','Choisir la matière'],...subjectOptions(d)],d.subject))+(d.series&&d.academic_level&&d.subject?(s?.approved?'<p class=\"lr-specialty-ok\">✓ Spécialité approuvée</p>':s?'<p class=\"lr-specialty-note\">Validation de cette spécialité en attente.</p>':`<div class=\"lr-specialty-note\">Cette spécialité doit être validée avant la publication. ${actions('request-specialty','Demander la validation')}</div>`):'<p class=\"lr-specialty-note\">Choisissez la série, le niveau et la matière.</p>')+`<p class=\"lr-error\" id=\"lrWizardError\" hidden></p>`}\nconst paymentColors={'Waafi':'#087d63','CacPay':'#1766a8','D-Money':'#e56b14','SabaPay':'#71409d','Espèces':'#506273'};\nfunction paymentBadge(k){const c=paymentColors[k]||'#506273';return `<svg class=\"lr-payment-badge\" viewBox=\"0 0 110 38\" role=\"img\" aria-label=\"${E(k)}\"><rect x=\"1\" y=\"1\" width=\"108\" height=\"36\" rx=\"8\" fill=\"#fff\" stroke=\"#dce1e7\"/><rect x=\"8\" y=\"8\" width=\"22\" height=\"22\" rx=\"6\" fill=\"${c}\"/><path d=\"M15 12h8v14h-8z M18 23h2\" fill=\"none\" stroke=\"white\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><text x=\"36\" y=\"23\" font-family=\"system-ui,sans-serif\" font-weight=\"700\" font-size=\"12\" fill=\"${c}\">${E(k)}</text></svg>`}\nfunction paymentFooter(methods){return methods.length?`<footer class=\"lr-payment-footer\"><small>Moyens de paiement de monAvenir</small><div>${methods.map(([k])=>paymentBadge(k)).join('')}</div></footer>`:''}\nlet settingsNotice='';\nconst screens=['student-learning','teacher-learning','admin-learning'];\nscreenList.push(['student-learning','Réviser et travailler'],['teacher-learning','Ressources pédagogiques'],['admin-learning','Achats et paiements']);\nfunction reset(){const key=st.user?.id||'';if(key!==owner){owner=key;data={};catalogue=[];interactiveCatalogue=[];tab='';draft=null;filter='';query='';page=0;close()}}\nasync function api(action,p_data={}){const result=await st.db.rpc(action==='catalogue'&&!st.user?'mon_bac_learning_catalogue':'mon_bac_learning',action==='catalogue'&&!st.user?{}:{p_action:action,p_data});if(result.error)throw Error(result.error.message||'Service indisponible');return result.data}\nasync function load(){reset();const screen=st.screen,uid=owner;loading=true;error='';try{if(screen==='teacher-learning')data=await api('teacher_data');else if(screen==='admin-learning')data=await api('admin_data');else if(screen==='student-learning'){[catalogue,data,interactiveCatalogue]=await Promise.all([api('catalogue'),api('student_data'),(async()=>{try{const result=await st.db.rpc('mon_bac_interactive',{p_action:'list',p_data:{}});return result.error?[]:Array.isArray(result.data)?result.data:[]}catch{return []}})()])}}catch(e){error=e.message}finally{loading=false;if(st.screen===screen&&owner===uid)render()}}\nfunction tabs(items){return `<nav class=\"lr-tabs\" aria-label=\"Sections\">${items.map(([k,l])=>`<button type=\"button\" data-lr=\"tab\" data-id=\"${k}\" aria-pressed=\"${tab===k}\">${E(l)}</button>`).join('')}</nav>`}\nfunction pagination(items,make){const size=5, p=Math.min(page,Math.max(0,Math.ceil(items.length/size)-1));return items.length?items.slice(p*size,p*size+size).map(make).join('')+`<div class=\"lr-pagination\">${p>0?actions('page','‹','-1'):''}<small>${p+1} / ${Math.max(1,Math.ceil(items.length/size))} · ${items.length}</small>${(p+1)*size<items.length?actions('page','›','1'):''}</div>`:empty('Aucun élément pour le moment.')}\nfunction search(items,category=''){return `<div class=\"lr-filter\"><input class=\"input\" data-lr-query placeholder=\"Rechercher…\" value=\"${E(query)}\"><select class=\"select\" data-lr-filter aria-label=\"Matière\">${opts([['','Toutes les matières'],...Array.from(new Set(items.map(x=>x.subject).filter(Boolean))).sort().map(x=>[x,x])],filter)}</select></div>`}\nfunction matches(r){return (!filter||r.subject===filter)&&(!query||[r.title,r.subject,r.teacher_name].join(' ').toLowerCase().includes(query.toLowerCase()))}\n\nfunction monbacVirtual(){\n  return (interactiveCatalogue||[]).filter(x=>x&&x.status==='published').map(x=>{\n    const t=String(x.title||'');\n    const isTest=/^(QCM|Vrai ou faux|Défi chronométré)(?:\\s|$)/i.test(t);\n    return {...x,isNativeInteractive:true,kind:isTest?'test':'interactif',teacher_name:'monAvenir',accessible:true,eligible:true,price:0,duration:0};\n  });\n}\n\nfunction student(){if(!tab||tab==='bac')tab='all';const groups=[['all','Tout'],['learn','Fiches'],['practice','Exercices'],['tests','Tests & QCM'],['orders','Mes achats']];let merged=[...catalogue,...monbacVirtual()].filter(r=>r.kind!=='bac');let list=merged.filter(matches).filter(r=>tab==='all'||tab==='learn'&&['fiche','resume','corrige'].includes(r.kind)||tab==='practice'&&['exercice','interactif','devoir'].includes(r.kind)||tab==='tests'&&['qcm','test'].includes(r.kind));if(tab==='orders')return tabs(groups)+pagination(data.orders||[],o=>row(o.title,`${money(o.amount)} · ${status[o.status]||o.status}`,actions('invoice','Facture',o.resource_id)));return tabs(groups)+search(merged)+`<div class=\"lr-list\" id=\"lrList\">${pagination(list,studentRow)}</div><div class=\"lr-links\">${link('student-group','Mes classes')}${actions('my-results','Mes résultats')}</div>`}\nfunction studentRow(r){if(r.isNativeInteractive){\n  const kindLabel=r.kind==='test'?'Test / QCM':'Exercice interactif';\n  const score=r.attempt?(' · Note : '+r.attempt.score+'/'+r.attempt.total):'';\n  return '<div class=\"lr-row lr-native-interactive\"><span class=\"lr-symbol\">'+I('clipboard-check')+'</span><div><strong>'+E(r.title)+'</strong><small>'+E(r.academic_level+' '+r.series+' · '+r.subject)+'</small><small>'+kindLabel+' · '+r.question_count+' questions'+score+'</small></div>'+actions('interactive-open',r.attempt?'Ouvrir le résultat':'Commencer',r.id,'btn primary')+'</div>';\n}\nconst label=r.accessible?'Ouvrir':r.eligible?(r.order_status==='pending'?'En attente':'Acheter'):'Rejoindre';return `<div class=\"lr-row ${r.eligible?'':'lr-locked'}\"><span class=\"lr-symbol\">${r.accessible?I(interactive(r.kind)?'clipboard-check':'file'):I('lock')}</span><div><strong>${E(r.title)}</strong><small>${E(r.subject)} · ${E(kinds[r.kind])}</small><small>${E(r.teacher_name||'')} · ${r.duration?`${r.duration} min · `:''}${price(r)}</small></div>${actions(r.accessible?'open':r.eligible?'invoice':'join',label,r.id,'btn '+(r.accessible?'primary':''))}</div>`}\nfunction teacher(){if(!tab)tab='resources';const ts=tabs([['resources','Mes ressources'],['add','Ajouter'],['qcm','QCM'],['stats','Statistiques'],['requests',`Demandes${(data.requests||[]).filter(r=>r.status==='pending').length?' • '+(data.requests||[]).filter(r=>r.status==='pending').length:''}`]]);if(tab==='add'||tab==='qcm')return ts+wizard();if(tab==='requests')return ts+pagination((data.requests||[]).filter(r=>r.status==='pending'),r=>row(r.student_name,r.group_name,`<div class=\"lr-inline\">${actions('approve','Approuver',r.id,'btn primary')}${actions('refuse','Refuser',r.id)}</div>`));if(tab==='stats')return ts+stats();return ts+search(data.resources||[])+`<div id=\"lrList\">${pagination((data.resources||[]).filter(matches),r=>row(r.title,`${kinds[r.kind]} · ${r.subject} · ${price(r)} · ${r.published?'Publié':'Brouillon'}`,`<div class=\"lr-inline\">${r.published?actions('archive','Archiver',r.id):actions('publish','Publier',r.id,'btn primary')}${actions('teacher-open','Voir',r.id)}</div>`))}</div>`}\nfunction newDraft(qcm=false){draft={title:'',series:'',academic_level:'',subject:'',kind:qcm?'qcm':'fiche',description:'',price:0,duration:0,due_at:'',audience:'classes',group_ids:[],student_ids:[],questions:[],file:null,id:null};draftStep=0;qEdit=0}\nfunction wizard(){if(!draft)newDraft(tab==='qcm');const d=draft, is=interactive(d.kind), steps=['Informations',is?'Questions':'Document','Destinataires'];const header=`<div class=\"lr-steps\">${steps.map((s,i)=>`<span class=\"${i===draftStep?'active':''}\">${i+1}. ${s}</span>`).join('')}</div>`;let body='';if(draftStep===0){body=field('Titre',input('title',d.title,'required maxlength=\"160\"'))+specialtyFields(d)+field('Type',select('kind',Object.entries(kinds).filter(([k])=>tab==='qcm'?interactive(k):!interactive(k)),d.kind))+field('Description (facultative)',`<textarea class=\"textarea\" name=\"description\" rows=\"2\" maxlength=\"3000\">${E(d.description)}</textarea>`)+field('Prix en FDJ (0 = gratuit)',input('price',d.price,'type=\"number\" min=\"0\" max=\"1000000\" required'))+(tab==='qcm'?field('Durée en minutes (0 = libre)',input('duration',d.duration,'type=\"number\" min=\"0\" max=\"180\" required')):'')+field('Date limite (facultative)',input('due_at',d.due_at,'type=\"datetime-local\"'))}\nelse if(draftStep===1){if(is){const q=d.questions[qEdit]||{type:'single',text:'',options:['',''],correct:0,points:1,explanation:'',hint:''};let answer=Array.isArray(q.correct)?q.correct.join('\\n'):String(q.correct??'');body=`<div class=\"lr-inline\"><strong>Question ${qEdit+1} / ${Math.max(d.questions.length,qEdit+1)}</strong>${qEdit>0?actions('question-prev','‹'):''}${qEdit<d.questions.length-1?actions('question-next','›'):''}</div>`+field('Type de réponse',select('qtype',[['single','Choix unique'],['multi','Choix multiples'],['boolean','Vrai / Faux'],['number','Nombre'],['text','Texte court'],['table','Tableau à compléter']],q.type))+field('Question',`<textarea class=\"textarea\" name=\"qtext\" required rows=\"3\">${E(q.text)}</textarea>`)+field('Options / lignes (une par ligne)',`<textarea class=\"textarea\" name=\"qoptions\" rows=\"3\" placeholder=\"Option 1&#10;Option 2\">${E(q.options?.join('\\n')||'')}</textarea>`)+field('Bonne réponse',input('qcorrect',q.type==='single'?Number(q.correct)+1:q.type==='multi'?(q.correct||[]).map(x=>Number(x)+1).join(','):q.type==='boolean'?(q.correct===1?'2':'1'):answer,'required placeholder=\"1 ou 1,2 ; texte / nombre\"'))+`<small>Choix : numéro(s) des options ; Vrai/Faux : 1 ou 2 ; tableau : valeurs séparées par |.</small>`+field('Points',input('qpoints',q.points,'type=\"number\" min=\"0.1\" max=\"100\" step=\"0.1\" required'))+field('Explication du corrigé',input('qexplanation',q.explanation||''))+field('Indice (exercice non chronométré)',input('qhint',q.hint||''))+actions('question-add','+ Ajouter une question')}\nelse body=field('Importer un PDF, Word (.docx) ou une image',`<input type=\"file\" class=\"input\" name=\"file\" accept=\".pdf,.docx,.png,.jpg,.jpeg,.webp\">`)+`<p class=\"lr-empty\">${d.file?E(d.file.name):'25 Mo maximum. Lecture intégrée.'}</p>`}\nelse body=field('Partager avec',select('audience',[['classes','Toutes mes classes'],['groups','Une ou plusieurs classes'],['students','Un ou plusieurs élèves']],d.audience))+`<div id=\"lrRecipients\">${recipients(d)}</div><p class=\"lr-empty\">${d.price?'Payant : consultation et téléchargement après paiement confirmé.':'Gratuit : consultation dans monAvenir.'}</p>`;\nreturn `<section class=\"lr-panel\">${header}<form id=\"lrWizard\">${body}<div class=\"lr-inline lr-form-actions\">${draftStep?actions('wizard-back','Retour'):''}<button class=\"btn primary\" type=\"submit\">${draftStep===2?'Publier':'Continuer'}</button></div></form></section>`}\nfunction recipients(d){if(d.audience==='classes')return '<small>Tous vos élèves approuvés.</small>';const group=d.audience==='groups',list=group?(data.groups||[]):[...new Map((data.students||[]).map(s=>[s.id,s])).values()];return `<div class=\"lr-recipients\">${list.length?list.map(x=>`<label><input type=\"checkbox\" name=\"recipient\" value=\"${E(x.id)}\" ${(group?d.group_ids:d.student_ids).includes(x.id)?'checked':''}> ${E(x.name)}</label>`).join(''):empty('Aucun destinataire. Ajoutez une classe ou des élèves.')}</div>`}\nfunction capture(){const f=$('lrWizard');if(!f||!draft)return;const fd=new FormData(f),d=draft;if(draftStep===0){for(const k of ['title','series','academic_level','subject','kind','description','due_at'])d[k]=String(f.elements.namedItem(k)?.value||'');for(const k of ['price','duration'])d[k]=Number(fd.get(k)||0)}else if(draftStep===1&&!interactive(d.kind)){const file=f.elements.file?.files?.[0];if(file)d.file=file}else if(draftStep===2){d.audience=String(fd.get('audience'));d.group_ids=d.audience==='groups'?fd.getAll('recipient'):[];d.student_ids=d.audience==='students'?fd.getAll('recipient'):[]}}\nfunction saveQuestion(){const f=$('lrWizard'),fd=new FormData(f);if(!f.reportValidity())throw Error('Complétez la question.');const type=String(fd.get('qtype')),raw=String(fd.get('qcorrect')).trim();let options=String(fd.get('qoptions')).split('\\n').map(s=>s.trim()).filter(Boolean),correct=raw;if(type==='boolean'){options=['Vrai','Faux'];correct=Number(raw)-1}else if(type==='single')correct=Number(raw)-1;else if(type==='multi')correct=raw.split(',').map(n=>Number(n.trim())-1);else if(type==='number'){correct=Number(raw.replace(',','.'));if(!Number.isFinite(correct))throw Error('Nombre invalide.')}else if(type==='table')correct=raw.split('|').map(s=>s.trim());if(['single','multi','boolean','table'].includes(type)&&options.length<2)throw Error('Ajoutez au moins deux options / lignes.');if(['single','boolean'].includes(type)&&(!Number.isInteger(correct)||correct<0||correct>=options.length)||type==='multi'&&(!correct.length||correct.some(n=>!Number.isInteger(n)||n<0||n>=options.length))||type==='table'&&correct.length!==options.length)throw Error('Corrigé invalide.');draft.questions[qEdit]={type,text:String(fd.get('qtext')).trim(),options,correct,points:Number(fd.get('qpoints')),explanation:String(fd.get('qexplanation')),hint:String(fd.get('qhint'))}}\nfunction stats(){const orders=data.orders||[],pending=orders.filter(o=>!o.payout_at);return `<div class=\"lr-kpis\"><div><strong>${(data.stats||[]).reduce((n,s)=>n+Number(s.views),0)}</strong><small>Consultations</small></div><div><strong>${(data.results||[]).length}</strong><small>Tests terminés</small></div><div><strong>${money(pending.reduce((n,o)=>n+o.amount-o.commission,0))}</strong><small>À reverser</small></div></div>${actions('results','Résultats des élèves')}${actions('works','Devoirs reçus')}${actions('earnings','Revenus')}<div>${pagination(data.stats||[],s=>row((data.resources||[]).find(r=>r.id===s.id)?.title||'Ressource',`${s.viewers} élèves · ${s.views} vues · ${s.attempts} réponses${s.avg!=null?' · '+s.avg+' %':''}`))}</div>`}\nfunction admin(){if(!tab)tab='pending';const orders=data.orders||[],cfg=data.settings||{},ts=tabs([['pending','À valider'],['paid','Encaissements'],['payout','Reversements'],['accounts','Comptes'],['settings','Tarifs']]);const notice=settingsNotice?`<p class=\"lr-specialty-ok\" role=\"status\">${E(settingsNotice)}</p>`:'';if(tab==='accounts')return ts+`<form id=\"lrPaymentSettings\" class=\"lr-panel\"><h2>Comptes de paiement</h2><p class=\"lr-specialty-note\">Renseignez les coordonnées de réception de monAvenir. Laissez vide pour désactiver un moyen. Ne saisissez aucun code PIN, CVV ni mot de passe.</p>${paymentMethods.map(k=>`<div class=\"lr-payment-field\">${paymentBadge(k)}${field(k,input(k,cfg.methods?.[k]||'','maxlength=\"300\" placeholder=\"Numéro / code marchand ou instructions\"'))}</div>`).join('')}${notice}<p class=\"lr-error\" id=\"lrPaymentError\" hidden></p><button class=\"btn primary full\" type=\"submit\">Enregistrer les comptes</button></form>`;if(tab==='settings')return ts+`<form id=\"lrSettings\" class=\"lr-panel\">${field('Commission (%)',input('commission',Number(cfg.commission_bp??1000)/100,'type=\"number\" min=\"0\" max=\"100\" step=\"0.01\" required'))}${field('Gratuité de lancement jusqu’au',input('launch',String(cfg.launch_until||'').slice(0,10),'type=\"date\" required'))}${actions('tab','Configurer les comptes de paiement','accounts')}${notice}<p class=\"lr-error\" id=\"lrPaymentError\" hidden></p><button class=\"btn primary full\" type=\"submit\">Enregistrer les tarifs</button></form>`;const list=orders.filter(o=>tab==='pending'?o.status==='pending':tab==='payout'?o.status==='paid'&&!o.payout_at:o.status==='paid');return ts+`<div class=\"lr-kpis\"><div><strong>${list.length}</strong><small>Opérations</small></div><div><strong>${money(list.reduce((n,o)=>n+o.amount,0))}</strong><small>Montant</small></div></div>`+pagination(list,o=>row(o.title,`${o.student_name} · ${money(o.amount)} · ${o.method||''}`,actions('admin-order','Ouvrir',o.id,'btn primary')))}\nfunction close(){if(timer)clearInterval(timer);timer=null;for(const u of urls)URL.revokeObjectURL(u);urls=[];modal?.remove();modal=null}\nfunction dialog(title,body,full=false){close();modal=document.createElement('dialog');modal.className='lr-dialog'+(full?' lr-full':'');modal.innerHTML=`<header><strong>${E(title)}</strong>${actions('close','Fermer')}</header><div class=\"lr-dialog-body\">${body}</div>`;document.body.append(modal);modal.showModal();modal.addEventListener('cancel',e=>{e.preventDefault();close()});return modal.querySelector('.lr-dialog-body')}\nfunction message(text){if(modal){const body=modal.querySelector('.lr-dialog-body');let p=body.querySelector('.lr-error');if(!p){p=document.createElement('p');p.className='lr-error';body.prepend(p)}p.textContent=text}else toast(text)}\nasync function publicCatalogue(){const rows=await api('catalogue');dialog('Ressources pédagogiques',`<p class=\"lr-empty\">Créez un compte et rejoignez une classe pour accéder aux activités.</p>${rows.slice(0,5).map(r=>row(r.title,`${r.subject} · ${r.teacher_name} · ${price(r)}`,`<span class=\"lr-lock\">${I('lock')}</span>`)).join('')||empty('Aucune ressource publiée.')}<div class=\"lr-inline\">${actions('signup','Créer un compte','','btn primary')}${actions('login','Se connecter')}</div>`)}\nasync function invoice(id){const o=await api('invoice',{id}), methods=Object.entries(o.methods||{});dialog('Facture monAvenir',`<div class=\"lr-invoice\"><small>FACTURE · ${E(o.invoice)}</small><h2>${money(o.amount)}</h2><p>${E(o.title)}</p><span class=\"lr-pill\">${status[o.status]||o.status}</span></div>${o.status==='paid'?actions('open','Accéder à mon achat',id,'btn primary full'):o.status==='pending'?empty('Paiement déclaré. L’administration vérifie votre encaissement.'): `<form id=\"lrPay\" data-id=\"${o.id}\">${o.refusal_reason?`<p class=\"lr-error\">${E(o.refusal_reason)}</p>`:''}${field('Moyen de paiement',select('method',methods.map(([k])=>[k,k]),methods[0]?.[0]))}<div class=\"lr-pay-instructions\">${methods.map(([k,v])=>`<p><strong>${E(k)}</strong> : ${E(v)}</p>`).join('')}</div>${field('Référence de la transaction',input('reference','','required minlength=\"3\" maxlength=\"100\"'))}<p class=\"lr-empty\">Effectuez le paiement au compte indiqué, puis saisissez sa référence.</p><button class=\"btn primary full\" type=\"submit\">Déclarer mon paiement</button></form>`}${paymentFooter(methods)}`)}\nasync function join(id){const groups=await api('join_groups',{id});dialog('Rejoindre une classe',groups.map(g=>row(g.name,(g.school||'')+(g.code?' · Code : '+g.code:''),g.status==='pending'?'<span class=\"lr-pill\">En attente</span>':g.status==='approved'?'<span class=\"lr-pill\">Approuvé</span>':g.mode==='visible_code'?`<button type=\"button\" class=\"btn primary\" data-mb91=\"resource-join\" data-id=\"${E(g.id)}\" data-code=\"${E(g.code)}\">Demander</button>`:actions('request','Demander',g.id,'btn primary'))).join('')||empty('Aucune classe publique disponible. Demandez le code privé à l’enseignant.'))}\nasync function openResource(id,teacherView=false){const r=teacherView?(data.resources||[]).find(x=>x.id===id):await api('open',{id});if(!r)throw Error('Ressource introuvable');if(interactive(r.kind)){if(teacherView){dialog(r.title,r.questions.map((q,i)=>row(`${i+1}. ${q.text}`,`${q.points} pt · ${q.type}`)).join(''));return}const old=(data.attempts||[]).find(a=>a.resource_id===id);dialog(r.title,`<div class=\"lr-invoice\"><strong>${r.questions.length} questions</strong><p>${r.duration?`${r.duration} minutes · chronométré`:'Sans chronomètre'} · ${price(r)}</p></div>${actions('start',old?'Reprendre / résultat':'Commencer',id,'btn primary full')}`);return}await reader(r,teacherView)}\nasync function reader(r,teacherView){const body=dialog(r.title,'<p class=\"lr-empty\">Chargement du document…</p>',true);const result=await st.db.storage.from('mon-bac-learning').download(r.id+'/document.'+r.file_ext);if(result.error)throw Error('Document inaccessible.');const blob=result.data;if(!body.isConnected)return;const u=URL.createObjectURL(blob);urls.push(u);body.innerHTML=`<nav class=\"lr-reader-bar\"><button type=\"button\" class=\"btn\" data-reader=\"minus\">−</button><span id=\"lrPage\">Lecture</span><button type=\"button\" class=\"btn\" data-reader=\"plus\">+</button>${r.price>0&&!teacherView?`<a class=\"btn\" download=\"${E(r.title)}.${r.file_ext}\" href=\"${u}\">Télécharger</a>`:''}${r.kind==='devoir'&&!teacherView?actions('submit-work','Remettre',r.id):''}</nav><div class=\"lr-document\" id=\"lrDocument\"></div>`;const wrap=body.querySelector('#lrDocument');if(r.file_ext==='pdf'){const pdfjs=await import('./vendor/mon-bac-pdf-5.6.205.mjs');pdfjs.GlobalWorkerOptions.workerSrc=new URL('./vendor/mon-bac-pdf-worker-5.6.205.mjs',location.href).href;const pdf=await pdfjs.getDocument({data:new Uint8Array(await blob.arrayBuffer())}).promise;let p=1,zoom=1,seq=0;const nav=body.querySelector('.lr-reader-bar');nav.insertAdjacentHTML('afterbegin','<button type=\"button\" class=\"btn\" data-reader=\"prev\">‹</button><button type=\"button\" class=\"btn\" data-reader=\"next\">›</button>');async function paint(){const token=++seq,pg=await pdf.getPage(p),base=pg.getViewport({scale:1}),width=Math.max(220,wrap.clientWidth-12),vp=pg.getViewport({scale:width/base.width*zoom}),c=document.createElement('canvas'),ratio=Math.min(devicePixelRatio||1,2);c.width=vp.width*ratio;c.height=vp.height*ratio;c.style.width=vp.width+'px';c.style.height=vp.height+'px';await pg.render({canvasContext:c.getContext('2d'),viewport:vp,transform:ratio===1?null:[ratio,0,0,ratio,0,0]}).promise;if(token===seq&&wrap.isConnected){wrap.replaceChildren(c);body.querySelector('#lrPage').textContent=`${p} / ${pdf.numPages}`}}nav.addEventListener('click',e=>{switch(e.target.dataset.reader){case'prev':p=Math.max(1,p-1);break;case'next':p=Math.min(pdf.numPages,p+1);break;case'plus':zoom=Math.min(3,zoom+.25);break;case'minus':zoom=Math.max(.5,zoom-.25);break;default:return}paint().catch(e=>message(e.message))});await paint()}else if(r.file_ext==='docx'){if(!window.JSZip)await new Promise((resolve,reject)=>{const s=document.createElement('script');s.src='./vendor/jszip-3.10.1.min.js';s.onload=resolve;s.onerror=reject;document.head.append(s)});const zip=await JSZip.loadAsync(blob),xml=await zip.file('word/document.xml').async('string'),doc=new DOMParser().parseFromString(xml,'application/xml');const ns='http://schemas.openxmlformats.org/wordprocessingml/2006/main';wrap.innerHTML='<article class=\"lr-word\">'+Array.from(doc.getElementsByTagNameNS(ns,'p')).map(p=>'<p>'+E(Array.from(p.getElementsByTagNameNS(ns,'t')).map(t=>t.textContent).join(''))+'</p>').join('')+'</article>'}else{const img=document.createElement('img');img.src=u;img.alt=r.title;wrap.append(img)}if(r.file_ext!=='pdf'){let z=100;body.querySelector('.lr-reader-bar').addEventListener('click',e=>{if(['plus','minus'].includes(e.target.dataset.reader)){z=Math.max(70,Math.min(250,z+(e.target.dataset.reader==='plus'?20:-20)));wrap.firstElementChild.style.width=z+'%'}})}}\nlet run=null;\nasync function start(id){const r=await api('open',{id});run={r,a:await api('start',{id}),index:0};showQuestion()}\nfunction showQuestion(){const {r,a,index}=run;if(a.finished_at){dialog('Résultat',`<div class=\"lr-invoice\"><h2>${Number(a.score)} / ${Number(a.maximum)}</h2><p>${Math.round(100*a.score/a.maximum)} % de réussite</p></div>${a.correction.map((c,i)=>row(`${i+1}. ${r.questions[i].text}`,`${c.earned}/${c.points} pt · ${c.explanation||'Réponse : '+JSON.stringify(c.correct)}`)).join('')}`);return}const q=r.questions[index],prev=a.answers?.[index];let html='';if(['single','multi','boolean'].includes(q.type))html=q.options.map((o,i)=>`<label class=\"lr-option\"><input type=\"${q.type==='multi'?'checkbox':'radio'}\" name=\"answer\" value=\"${i}\" ${q.type==='multi'?prev?.includes?.(i)?'checked':'':prev===i?'checked':''}>${E(o)}</label>`).join('');else if(q.type==='table')html=q.options.map((o,i)=>field(o,input('answer',prev?.[i]||''))).join('');else html=field('Votre réponse',input('answer',prev??'',q.type==='number'?'inputmode=\"decimal\"':''));const body=dialog(r.title,`<div class=\"lr-progress\"><span>Question ${index+1} / ${r.questions.length}</span><strong id=\"lrTime\"></strong></div><progress value=\"${index+1}\" max=\"${r.questions.length}\"></progress><h2>${E(q.text)}</h2><form id=\"lrAnswer\">${html}${q.hint?`<details><summary>Indice</summary><p>${E(q.hint)}</p></details>`:''}<div class=\"lr-inline lr-form-actions\">${index?actions('previous','Précédent'):''}<button class=\"btn primary\" type=\"submit\">${index===r.questions.length-1?'Terminer':'Suivant'}</button></div></form>`,true);if(a.deadline){const tick=()=>{const seconds=Math.max(0,Math.ceil((new Date(a.deadline)-Date.now())/1000)),el=body.querySelector('#lrTime');if(el)el.textContent=`${Math.floor(seconds/60)}:${String(seconds%60).padStart(2,'0')}`;if(!seconds){clearInterval(timer);timer=null;api('finish',{id:r.id}).then(x=>{run.a=x;showQuestion()}).catch(e=>message(e.message))}};timer=setInterval(tick,1000);tick()}}\nasync function saveAnswer(){const q=run.r.questions[run.index],fd=new FormData($('lrAnswer'));let a=q.type==='multi'?fd.getAll('answer').map(Number):q.type==='table'?fd.getAll('answer'):fd.get('answer');if(['single','boolean'].includes(q.type))a=a===null?null:Number(a);run.a=await api('answer',{id:run.r.id,index:run.index,answer:a})}\nconst oldView=view;view=function(){if(!screens.includes(st.screen))return oldView();reset();return `<div class=\"lr-shell\"><div class=\"lr-heading\"><button type=\"button\" class=\"btn\" data-act=\"goto\" data-to=\"${st.screen.split('-')[0]}-home\">‹ Accueil</button><h1>${{ 'student-learning':'Réviser et travailler','teacher-learning':'Ressources pédagogiques','admin-learning':'Achats et paiements'}[st.screen]}</h1>${actions('refresh','Actualiser')}</div>${loading?empty('Chargement…'):error?`<p class=\"lr-error\">${E(error)}</p>${actions('refresh','Réessayer')}`:st.screen==='student-learning'?student():st.screen==='teacher-learning'?teacher():admin()}</div>`};\nconst oldGo=go;go=function(s){if(screens.includes(s)){tab='';filter='';query='';page=0;data={};catalogue=[];loading=true;const ret=oldGo(s);if(st.screen===s)load();return ret}return oldGo(s)};\nconst oldRender=render;render=function(){const v=oldRender(),app=$('app');if(!app)return v;const s=st.screen,grid=app.querySelector('.mb-tiles');if(grid&&!app.classList.contains('mb70-photo-gate')){const target={'student-home':['student-learning','Travailler','book'],'teacher-home':['teacher-learning','Ressources','book'],'admin-home':['admin-learning','Achats et paiements','credit-card']}[s];if(target&&(s!=='teacher-home'||st.teacher?.status==='approved'))grid.insertAdjacentHTML('afterbegin',`<button class=\"mb-tile lr-shortcut\" data-act=\"goto\" data-to=\"${target[0]}\">${I(target[2])}<span>${target[1]}</span></button>`)}if(s==='admin-settings'&&st.role==='admin'){app.querySelector('.screen')?.insertAdjacentHTML('afterbegin',`<div class=\"lr-settings-shortcut\">${actions('payment-settings-open','Configurer les comptes de paiement','','btn primary full')}</div>`)}if(s==='student-home'||s==='student-learning'){const b=app.querySelector('.mb72-center');if(b){delete b.dataset.mb72;b.dataset.act='goto';b.dataset.to='student-learning'}}if(s==='welcome'&&!st.user){const anchor=app.querySelector('.mb83-directory');anchor?.insertAdjacentHTML('afterend',`<button type=\"button\" class=\"mb83-directory lr-public\" data-lr=\"catalogue\"><span class=\"mb83-directory-icon\">${I('book')}</span><span><strong>Ressources pédagogiques</strong><small>Découvrir les activités</small></span>${I('chevron')}</button>`)}if(s==='teacher-learning'&&draft&&draftStep===0&&$('lrWizard'))for(const k of ['series','academic_level','subject','kind']){const el=$('lrWizard').elements.namedItem(k);if(el)el.value=draft[k]}if(st.role==='eleve')app.querySelectorAll('[data-mbc=\"download-exam\"]').forEach(b=>b.remove());return v};\nconst oldOut=signOut;signOut=async function(){close();owner='';data={};catalogue=[];draft=null;run=null;return oldOut()};\njoinGroup=async function(){const code=$('joinCode')?.value.trim();if(!code)throw Error('Saisissez le code de la classe.');await api('join_code',{code});try{const saved=JSON.parse(localStorage.getItem('ege2027_invitation')||'null');if(saved?.code===code.toUpperCase())localStorage.removeItem('ege2027_invitation')}catch(_){}toast('Demande envoyée. Attendez l’approbation de l’enseignant.');if(st.screen==='student-group')render()};\ndocument.addEventListener('change',e=>{if(e.target.matches('[data-lr-filter]')){filter=e.target.value;page=0;render()}if(['series','academic_level','subject'].includes(e.target.name)&&$('lrWizard')&&draftStep===0){capture();draft[e.target.name]=e.target.value;if(e.target.name!=='subject')draft.subject='';render();return}if(e.target.name==='audience'&&$('lrWizard')){draft.audience=e.target.value;$('lrRecipients').innerHTML=recipients(draft)}if(e.target.name==='file'&&$('lrWizard'))capture()});\ndocument.addEventListener('input',e=>{if(e.target.matches('[data-lr-query]')){query=e.target.value;page=0;const list=$('lrList');if(list){const parent=document.createElement('div');parent.innerHTML=st.screen==='student-learning'?student():teacher();list.innerHTML=parent.querySelector('#lrList')?.innerHTML||''}}});\ndocument.addEventListener('click',async e=>{const b=e.target.closest?.('[data-lr]');if(!b||b.disabled)return;const a=b.dataset.lr,id=b.dataset.id;try{if(a==='payment-settings-open'){go('admin-learning');tab='accounts';settingsNotice='';render();return}if(a==='request-specialty'){capture();b.disabled=true;try{await api('request_specialty',{series:draft.series,academic_level:draft.academic_level,subject:draft.subject});await load()}finally{b.disabled=false}return}if(a==='close'){close();return}if(a==='tab'){if($('lrWizard'))capture();tab=id;settingsNotice='';page=0;query='';filter='';if(['add','qcm'].includes(tab)&&(!draft||interactive(draft.kind)!==(tab==='qcm')))newDraft(tab==='qcm');render();return}if(a==='page'){page=Math.max(0,page+Number(id));render();return}if(a==='refresh'){await load();return}if(a==='catalogue'){await publicCatalogue();return}if(a==='signup'||a==='login'){close();st.desired='eleve';st.mode=a==='signup'?'signup':'login';st.screen='auth';render();return}if(a==='interactive-open'){if(!window.MonBacInteractive?.openExercise)throw Error('Exercices interactifs indisponibles');await window.MonBacInteractive.openExercise(id);return}if(a==='open'||a==='teacher-open'){await openResource(id,a==='teacher-open');return}if(a==='invoice'){await invoice(id);return}if(a==='join'){await join(id);return}if(a==='request'){await api('request_join',{id});close();toast('Demande envoyée.');await load();return}if(['approve','refuse','archive','publish'].includes(a)){if(a==='archive'&&!await window.MBDialog.confirm('Archiver cette ressource ?'))return;await api({approve:'approve_join',refuse:'refuse_join',archive:'archive',publish:'publish'}[a],{id});await load();return}if(a==='wizard-back'){capture();draftStep--;render();return}if(['question-add','question-prev','question-next'].includes(a)){saveQuestion();qEdit=a==='question-add'?draft.questions.length:qEdit+(a==='question-prev'?-1:1);render();return}if(a==='start'){await start(id);return}if(a==='previous'){await saveAnswer();if(!run.a.finished_at)run.index--;showQuestion();return}if(a==='my-results'||a==='results'){const rows=a==='my-results'?(data.attempts||[]).filter(x=>x.finished_at):data.results||[];dialog('Résultats',rows.map(x=>row(x.title,`${x.student_name||x.subject||''} · ${x.score}/${x.maximum}`)).join('')||empty('Aucun résultat.'));return}if(a==='earnings'){dialog('Revenus',(data.orders||[]).map(o=>row(o.title,`${money(o.amount-o.commission)} · ${o.payout_at?'Reversé':'En attente de reversement'}`)).join('')||empty('Aucune vente.'));return}if(a==='works'){dialog('Devoirs reçus',(data.submissions||[]).map(w=>row(w.student_name,w.title,`<button type=\"button\" class=\"btn\" data-lr=\"review-work\" data-id=\"${w.resource_id}\" data-student=\"${w.student_id}\">Corriger</button>`)).join('')||empty('Aucun devoir remis.'));return}if(a==='review-work'){const w=(data.submissions||[]).find(x=>x.resource_id===id&&x.student_id===b.dataset.student);if(!w)return;const res=await st.db.storage.from('mon-bac-learning').download(id+'/'+w.student_id+'/travail.'+w.file_ext);if(res.error)throw res.error;const body=dialog('Corriger le devoir',`<form id=\"lrReview\" data-id=\"${id}\" data-student=\"${w.student_id}\">${field('Note / 20',input('grade',w.grade??'','type=\"number\" min=\"0\" max=\"20\" step=\"0.25\" required'))}${field('Commentaire',input('feedback',w.feedback||''))}<button type=\"submit\" class=\"btn primary\">Enregistrer</button></form>`);const u=URL.createObjectURL(res.data);urls.push(u);body.insertAdjacentHTML('afterbegin',`<a class=\"btn\" href=\"${u}\" target=\"_blank\" rel=\"noopener\">Consulter le travail remis</a>`);return}if(a==='submit-work'){dialog('Remettre mon devoir',`<form id=\"lrWork\" data-id=\"${id}\">${field('PDF ou photo',`<input class=\"input\" required type=\"file\" name=\"file\" accept=\".pdf,.png,.jpg,.jpeg,.webp\">`)}<button class=\"btn primary full\" type=\"submit\">Remettre</button></form>`);return}if(a==='admin-order'){const o=(data.orders||[]).find(x=>x.id===id);if(!o)return;dialog('Encaissement',`<div class=\"lr-invoice\"><small>${E(o.invoice)}</small><h2>${money(o.amount)}</h2><p>${E(o.student_name)} · ${E(o.teacher_name)}</p><p>${E(o.method||'')} · ${E(o.transaction_ref||'')}</p><p>Commission : ${money(o.commission)} · À reverser : ${money(o.amount-o.commission)}</p></div>${o.status==='pending'?`<form id=\"lrConfirm\" data-id=\"${id}\"><label class=\"lr-option\"><input type=\"checkbox\" name=\"verified\" required> J’ai vérifié l’encaissement réel sur le compte de la plateforme.</label><button class=\"btn primary full\" type=\"submit\">Confirmer le paiement</button></form>${actions('refuse-payment','Refuser',id)}`:o.payout_at?empty('Reversement enregistré le '+date(o.payout_at)):`<form id=\"lrPayout\" data-id=\"${id}\">${field('Référence du reversement effectué',input('reference','','required minlength=\"3\"'))}<button class=\"btn primary\" type=\"submit\">Enregistrer le reversement</button></form>`}`);return}if(a==='refuse-payment'){const reason=await window.MBDialog.prompt('Motif du refus');if(reason===null)return;await api('refuse_payment',{id,reason});close();await load()}}catch(err){message(err.message||'Opération impossible.')}});\ndocument.addEventListener('submit',async e=>{const f=e.target;if(!['lrWizard','lrSettings','lrPaymentSettings','lrPay','lrConfirm','lrPayout','lrAnswer','lrWork','lrReview'].includes(f.id))return;e.preventDefault();e.stopImmediatePropagation();const btn=f.querySelector('[type=\"submit\"]');if(btn)btn.disabled=true;try{const fd=new FormData(f),id=f.dataset.id;if(f.id==='lrWizard'){capture();if(draftStep===0){if(!draft.title.trim()||!draft.series||!draft.academic_level||!draft.subject)throw Error('Indiquez le titre, la série, le niveau et la matière.');if(!specialty(draft)?.approved)throw Error('Demandez la validation de cette spécialité avant de continuer.');draftStep++;render();return}if(draftStep===1){if(interactive(draft.kind))saveQuestion();else if(!draft.file)throw Error('Importez un document.');draftStep++;render();return}if(draft.audience!=='classes'&&!draft.group_ids.length&&!draft.student_ids.length)throw Error('Choisissez les destinataires.');const ext=draft.file?.name.split('.').pop().toLowerCase().replace('jpeg','jpg')||null;if(draft.file&&draft.file.size>26214400)throw Error('Fichier trop volumineux.');if(!draft.id){const r=await api('create',{...draft,file:undefined,file_ext:ext,due_at:draft.due_at?new Date(draft.due_at).toISOString():null});draft.id=r.id}if(draft.file){const res=await st.db.storage.from('mon-bac-learning').upload(draft.id+'/document.'+ext,draft.file,{upsert:true});if(res.error)throw res.error}await api('publish',{id:draft.id});draft=null;tab='resources';toast('Ressource publiée.');await load();return}if(f.id==='lrAnswer'){await saveAnswer();if(run.a.finished_at)showQuestion();else if(run.index===run.r.questions.length-1){run.a=await api('finish',{id:run.r.id});showQuestion()}else{run.index++;showQuestion()}return}if(f.id==='lrPaymentSettings'){const methods={};for(const k of paymentMethods){const v=String(fd.get(k)||'').trim();if(v)methods[k]=v}data.settings=await api('payment_methods',{methods});settingsNotice='Comptes enregistrés avec succès.';render();return}if(f.id==='lrSettings'){data.settings=await api('tariff_settings',{commission_bp:Math.round(Number(fd.get('commission'))*100),launch_until:new Date(String(fd.get('launch'))+'T23:59:59').toISOString()});settingsNotice='Tarifs enregistrés.';render();return}if(f.id==='lrPay')await api('declare',{id,method:fd.get('method'),reference:fd.get('reference')});if(f.id==='lrConfirm')await api('confirm_payment',{id,verified:fd.get('verified')==='on'});if(f.id==='lrPayout')await api('payout',{id,reference:fd.get('reference')});if(f.id==='lrReview')await api('review_submission',{id,student:f.dataset.student,grade:Number(fd.get('grade')),feedback:fd.get('feedback')});if(f.id==='lrWork'){const file=fd.get('file'),extension=file.name.split('.').pop().toLowerCase().replace('jpeg','jpg');if(file.size>26214400)throw Error('Fichier trop volumineux.');await api('prepare_submission',{id,extension});const res=await st.db.storage.from('mon-bac-learning').upload(id+'/'+st.user.id+'/travail.'+extension,file,{upsert:true});if(res.error)throw res.error;await api('submit_work',{id})}close();toast('Enregistré.');await load()}catch(err){const p=$('lrPaymentError')||$('lrWizardError');if(p){p.hidden=false;p.textContent=err.message||'Opération impossible.'}else message(err.message||'Opération impossible.');if(btn)btn.disabled=false}},true);\nwindow.MB85={api,load};\n})();\n"],"/mon-bac-interactive-travailler-maths-20261119.js":["application/javascript; charset=utf-8",false,"/* monAvenir — exercices interactifs, avec correction IA facultative et quota gratuit. */\n(()=>{'use strict';\nconst E=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst A=(name,value)=>`data-i-act=\"${name}\"${value==null?'':` data-i-value=\"${E(value)}\"`}`;\nconst B=(name,label,value,primary=false)=>`<button type=\"button\" class=\"mbi-button ${primary?'mbi-primary':''}\" ${A(name,value)}>${E(label)}</button>`;\nconst select=(key,values,current)=>`<select data-i-field=\"${key}\">${values.map(v=>`<option ${String(v)===String(current)?'selected':''}>${E(v)}</option>`).join('')}</select>`;\nconst field=(label,html)=>`<label class=\"mbi-field\"><span>${E(label)}</span>${html}</label>`;\nconst input=(key,value,placeholder='',type='text')=>`<input type=\"${type}\" data-i-field=\"${key}\" value=\"${E(value)}\" placeholder=\"${E(placeholder)}\">`;\nconst area=(key,value,placeholder='')=>`<textarea rows=\"3\" lang=\"fr\" spellcheck=\"true\" autocorrect=\"on\" autocapitalize=\"sentences\" data-i-field=\"${key}\" placeholder=\"${E(placeholder)}\">${E(value)}</textarea>`;\nconst newQuestion=()=>({type:'text',prompt:'',points:1,answer:'',hint:'',options:['',''],columns:['Libellé','Montant'],rows:['Ligne 1']});\nconst types={text:'Réponse rédigée',number:'Calcul / nombre',choice:'QCM (un choix)',table:'Tableau à compléter'};\nconst status={draft:'Brouillon',pending:'À valider',published:'Publié',review:'À corriger',graded:'Corrigé'};\nlet m={};let root=null;let uid=null;let previousFocus=null;let busy=false;\nconst teacher=()=>st.role==='enseignant'||st.role==='admin';\nconst call=async(action,data={})=>{if(st.user?.id!==uid)throw Error('Reconnectez-vous.');const r=await st.db.rpc('mon_bac_interactive',{p_action:action,p_data:data});if(r.error)throw Error(r.error.message);return r.data;};\nconst key=(kind,id='new')=>`monbac-interactive:${uid}:${kind}:${id}`;\nconst read=(kind,id)=>{try{return JSON.parse(localStorage.getItem(key(kind,id))||'null')}catch{return null}};\nconst write=(kind,id,value)=>{try{localStorage.setItem(key(kind,id),JSON.stringify(value))}catch{}};\nconst remove=(kind,id)=>{try{localStorage.removeItem(key(kind,id))}catch{}};\nconst persist=()=>{if(m.page==='edit')write('editor',m.exercise.id||'new',{exercise:m.exercise,step:m.step,index:m.index});if(m.page==='play')write('attempt',m.exercise.id,{answers:m.answers,index:m.index});};\nconst close=()=>{persist();root?.remove();root=null;document.documentElement.classList.remove('mbi-open');previousFocus?.focus?.();};\nconst show=async()=>{if(root)return;uid=st.user?.id;if(!uid)return;previousFocus=document.activeElement;m={page:'list',rows:[],loading:true,filter:''};root=document.createElement('div');root.id='mbi-root';root.setAttribute('role','dialog');root.setAttribute('aria-modal','true');root.setAttribute('aria-label','Exercices interactifs');document.body.append(root);document.documentElement.classList.add('mbi-open');root.addEventListener('click',click);root.addEventListener('input',change);root.addEventListener('change',change);root.addEventListener('keydown',ev=>{if(ev.key==='Escape'&&!busy)close()});draw();await reload();};\nasync function reload(){m.page='list';m.loading=true;draw();try{m.rows=await call('list');m.specialties=teacher()?await call('specialties'):[];m.groups=teacher()?await call('groups'):[];m.error='';}catch(e){m.error=e.message}finally{m.loading=false;draw()}}\nconst badge=s=>`<span class=\"mbi-badge\">${E(status[s]||s)}</span>`;\nconst progress=(n,total)=>`<div class=\"mbi-progress\" aria-label=\"Étape ${n} sur ${total}\"><i style=\"width:${n/total*100}%\"></i></div>`;\nfunction mbClassFields(e){\n const groups=(m.groups||[]).filter(g=>!g.subject||!e.subject||g.subject===e.subject);\n const selected=e.target_class_names||[];\n const classes=st.role==='admin'?field('Classes destinataires',area('target_class_csv',selected.join(', '),'Ex. TGFM1, TGFM6, TGFM7')):groups.length?groups.map((g,i)=>`<label class=\"mbi-group-choice\"><input type=\"checkbox\" data-i-field=\"group:${(m.groups||[]).indexOf(g)}\" ${selected.includes(g.name)&&String(e.target_school).toLowerCase()===String(g.school).toLowerCase()?'checked':''}><span><strong>${E(g.name)}</strong><small>${E(g.school)}</small></span></label>`).join(''):'<p class=\"mbi-muted\">Créez d’abord votre classe dans monAvenir pour lui attribuer cet exercice.</p>';\n return `<section class=\"mbi-assign\"><h3>Affectation pédagogique</h3><p class=\"mbi-muted\">Seuls les élèves de la série, du niveau, de l’établissement et des classes indiqués pourront accéder à l’activité.</p>${field('Établissement',input('target_school',e.target_school||'','Établissement des élèves'))}<div class=\"mbi-class-list\">${classes}</div><small class=\"mbi-muted\">Les noms des classes doivent correspondre aux profils des élèves. Un enseignant ne peut sélectionner que ses propres classes.</small></section>`;\n}\nfunction mbReviewTable(e,q,v){\n const heads=['Débit','Crédit','Date / Intitulé des comptes','Débit (FDJ)','Crédit (FDJ)'];\n const date=e?.source_document?.date||'jj/mm/N';\n const rows=Array.isArray(v)?v:[];\n return `<div class=\"mbi-table-wrap mbi-journal-wrap\" dir=\"ltr\"><table class=\"mbi-table mbi-journal-table\"><thead><tr>${heads.map(h=>`<th>${E(h)}</th>`).join('')}</tr></thead><tbody><tr class=\"mbi-journal-date\"><td></td><td></td><td>${E(date)}</td><td></td><td></td></tr>${rows.map(r=>`<tr>${heads.map((_,j)=>`<td>${E(r?.[j]||'')}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;\n}\nfunction list(){\n const categories=[['','Tous'],['Exercice guidé','Guidés'],['QCM','QCM'],['Vrai ou faux','Vrai / Faux'],['Texte à trous','Textes à trous'],['Étude de cas','Études de cas'],['Défi chronométré','Défis']];\n const rows=m.rows.filter(x=>(!m.filter||x.subject===m.filter)&&(!m.kind||x.title.startsWith(m.kind)));\n const subjects=[...new Set(m.rows.map(x=>x.subject))];\n const accessible=m.rows.filter(x=>!m.filter||x.subject===m.filter);\n const finished=accessible.filter(x=>x.attempt?.status==='graded');\n const submitted=accessible.filter(x=>x.attempt);\n const avg=finished.length?Math.round(20*finished.reduce((sum,x)=>sum+Number(x.attempt.score)/Math.max(1,Number(x.attempt.total)),0)/finished.length*10)/10:0;\n const toReview=finished.filter(x=>Number(x.attempt.score)/Math.max(1,Number(x.attempt.total))<.65);\n const overview=!teacher()?`<section class=\"mbi-overview\"><div class=\"mbi-row\"><strong>Ma progression</strong><span class=\"mbi-muted\">${submitted.length} / ${accessible.length} activités commencées</span></div><div class=\"mbi-overview-numbers\"><div><strong>${finished.length}</strong><small>Terminées et corrigées</small></div><div><strong>${finished.length?avg.toLocaleString('fr-FR')+'/20':'—'}</strong><small>Moyenne actuelle</small></div><div><strong>${toReview.length}</strong><small>À renforcer</small></div></div>${toReview.length?`<details class=\"mbi-review-suggestions\"><summary>Exercices à retravailler</summary>${toReview.slice(0,3).map(x=>`<button type=\"button\" class=\"mbi-suggestion\" ${A('open',x.id)}>${E(x.title)} <span>${E(x.attempt.score)}/${E(x.attempt.total)}</span></button>`).join('')}</details>`:''}</section>`:'';\n return `<div class=\"mbi-intro\"><h2>${teacher()?'Mes activités pédagogiques':'Exercices interactifs'}</h2><p>${teacher()?'Préparez les activités, choisissez vos classes et corrigez les copies.':'Apprenez avec des documents, des calculs et des corrections adaptés à votre niveau.'}</p></div>${overview}${teacher()?B('new','＋ Créer une activité',null,true):''}<div class=\"mbi-category-chips\">${categories.map(([key,label])=>`<button class=\"mbi-chip ${m.kind===key||(!m.kind&&!key)?'is-active':''}\" ${A('kind',key)}>${E(label)}</button>`).join('')}</div>${subjects.length>1?field('Matière',`<select data-i-field=\"filter\"><option value=\"\">Toutes les matières</option>${subjects.map(s=>`<option ${s===m.filter?'selected':''}>${E(s)}</option>`).join('')}</select>`):''}<small class=\"mbi-muted\">${rows.length} activité(s) ${m.kind?'dans ce type':'disponibles'}</small>${m.loading?'<p>Chargement…</p>':!rows.length?'<div class=\"mbi-empty\">Aucune activité dans cette catégorie.</div>':rows.map(x=>`<button class=\"mbi-item mbi-activity\" ${A('open',x.id)}><span><small>${E(x.academic_level+' '+x.series+' · '+x.subject)}</small><strong>${E(x.title)}</strong><small>${x.question_count} question(s) · ${x.mode==='exam'?'Évaluation':'Entraînement'}${x.attempt?' · Note : '+x.attempt.score+'/'+x.attempt.total:''}</small></span>${teacher()?badge(x.status):x.attempt?badge(x.attempt.status):'<span class=\"mbi-arrow\">›</span>'}</button>`).join('')}`;\n}\nfunction editor(){let e=m.exercise,q=e.questions[m.index];let bar=progress(m.step+1,3);if(m.step===0){let specs=m.specialties||[],specific=st.role!=='admin';return `${bar}<h2>1. Le sujet</h2>${specific?field('Classe et matière',`<select data-i-field=\"specialty\">${specs.map((s,i)=>`<option value=\"${i}\" ${s.series===e.series&&s.academic_level===e.academic_level&&s.subject===e.subject?'selected':''}>${E(s.academic_level+' '+s.series+' · '+s.subject)}</option>`).join('')}</select>`):field('Série',select('series',['GFM','OGRH','IAG','S','ES','L'],e.series))+field('Niveau',select('academic_level',['Première','Terminale'],e.academic_level))+field('Matière',input('subject',e.subject,'Ex. Gestion financière'))}${field('Titre',input('title',e.title,'Ex. Facture avec remise'))}${field('Consignes / contexte',area('instructions',e.instructions,'Saisir ou coller le sujet'))}${mbClassFields(e)}${field('Mode',`<select data-i-field=\"mode\"><option value=\"training\" ${e.mode==='training'?'selected':''}>Entraînement</option><option value=\"exam\" ${e.mode==='exam'?'selected':''}>Évaluation</option></select>`)}`}\nif(m.step===1)return `${bar}<div class=\"mbi-row\"><h2>2. Question ${m.index+1}/${e.questions.length}</h2>${badge(e.questions.length+' bloc(s)')}</div>${field('Type',`<select data-i-field=\"q.type\">${Object.entries(types).map(([k,v])=>`<option value=\"${k}\" ${q.type===k?'selected':''}>${E(v)}</option>`).join('')}</select>`)}${field('Énoncé',area('q.prompt',q.prompt,'Écrire la question'))}${field('Barème (points)',input('q.points',q.points,'1','number'))}${q.type==='choice'?field('Choix (un par ligne)',area('q.options',(q.options||[]).join('\\n')))+field('Bonne réponse (recopier un choix)',input('q.answer',q.answer)):q.type==='table'?field('Colonnes (une par ligne)',area('q.columns',(q.columns||[]).join('\\n')))+field('Lignes (une par ligne)',area('q.rows',(q.rows||[]).join('\\n')))+`<div class=\"mbi-row\">${B('template','Facture','invoice')}${B('template','Journal 5 colonnes','journal')}</div>`+field('Corrigé de référence (enseignant)',area('q.answer',q.answer)):field(q.type==='number'?'Réponse numérique':'Réponse attendue / critères',q.type==='number'?input('q.answer',q.answer,'Ex. 512050'):area('q.answer',q.answer,'Les autres formulations seront à vérifier'))}${e.mode==='training'?field('Indice (facultatif)',area('q.hint',q.hint)):''}<div class=\"mbi-row\">${B('qprev','‹ Précédente')}${B('qnext','Suivante ›')}${B('add','＋ Question')}${e.questions.length>1?B('deleteq','Retirer'):''}</div>`;\nreturn `${bar}<h2>3. Vérification</h2><div class=\"mbi-notice\"><strong>${E(e.title||'Sans titre')}</strong><p>${E(e.academic_level+' '+e.series+' · '+e.subject)}</p><p>${e.questions.length} question(s) · ${e.questions.reduce((s,q)=>s+Number(q.points||0),0)} points</p></div>${e.questions.map((q,i)=>`<button class=\"mbi-item\" ${A('editq',i)}><span><strong>${i+1}. ${E(q.prompt||'Question vide')}</strong><small>${E(types[q.type])} · ${E(q.points)} pt</small></span><span>›</span></button>`).join('')}<p class=\"mbi-muted\">Les copies rédigées et les tableaux sont contrôlés par l’enseignant. Aucune IA payante n’est utilisée.</p>`}\nfunction mbMoney(n){return Number(n||0).toLocaleString('fr-FR')+' FDJ'}\nfunction mbSheet(e,editable){\n const d=e?.source_document;if(!d)return '';\n const guided=!!editable;\n const data=['Montant brut HT','Remise commerciale','Base taxable HT','TVA (10 %)','Net TTC'];\n const row=data.map((label,i)=>{\n   const v=m.answers?.[i],prev=v!==undefined&&v!==null&&v!=='';\n   const value=guided&&m.index===i?`<input type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" data-i-field=\"answer\" aria-label=\"${E(label)}\" placeholder=\"Votre calcul (FDJ)\" value=\"${E(prev?v:'')}\">`:guided&&m.index>i&&prev?`<strong>${E(mbMoney(v))}</strong>`:'<span class=\"mbi-sheet-empty\">À compléter</span>';\n   return guided?`<tr class=\"${m.index===i?'mbi-sheet-active':''}\"><th scope=\"row\">${E(label)}</th><td>${value}</td></tr>`:'';\n }).join('');\n const subtitle=d.regulation==='remise_oubliee'?'Facture initiale — avoir de remise oubliée':d.type==='AVOIR'?'Facture AVOIR — retour de marchandises':'Facture DOIT';\n return `<section class=\"mbi-sheet\" dir=\"ltr\"><div class=\"mbi-sheet-head\"><div><small>DOCUMENT COMPTABLE · SIMULATION</small><strong>${E(subtitle)}</strong></div><span>${E(d.number||'SIM')}</span></div><div class=\"mbi-sheet-meta\"><span>Date : ${E(d.date||'N')}</span><span>TVA : ${E(d.tva_percent||10)} %</span></div><table class=\"mbi-sheet-table\"><thead><tr><th>Désignation</th><th>Quantité</th><th>Prix unitaire</th></tr></thead><tbody><tr><td>Marchandises</td><td>${E(d.quantity||10)}</td><td>${E(mbMoney(d.unit_price))}</td></tr></tbody></table>${d.discount_percent?`<div class=\"mbi-sheet-tag\">Remise : ${E(d.discount_percent)} %</div>`:''}${d.escompte_percent?`<div class=\"mbi-sheet-tag\">Escompte : ${E(d.escompte_percent)} %</div>`:''}${d.transport_ht?`<div class=\"mbi-sheet-tag\">Transport : ${E(mbMoney(d.transport_ht))}</div>`:''}${guided?`<table class=\"mbi-sheet-calc\"><tbody>${row}</tbody></table>`:'<p class=\"mbi-muted\">Complétez les calculs demandés en vous appuyant sur le document.</p>'}</section>`;\n}\nfunction mbSums(v){\n const num=s=>{const x=Number(String(s??'').replace(/[\\s\\u00a0\\u202f]/g,'').replace(',','.'));return Number.isFinite(x)?x:NaN};\n let debit=0,credit=0,invalid=false;\n for(const row of Array.isArray(v)?v:[]){for(const [j,key] of [[3,'debit'],[4,'credit']]){const raw=row?.[j];if(raw!==undefined&&raw!==null&&String(raw).trim()!==''){const n=num(raw);if(!Number.isFinite(n)||n<0)invalid=true;else if(key==='debit')debit+=n;else credit+=n;}}}\n return {debit,credit,invalid};\n}\nfunction mbJournal(e,q,v){\n const d=e.source_document||{};\n const values=Array.isArray(v)?v:[];\n const totals=mbSums(values);\n const names=['Débit','Crédit','Date / Intitulé des comptes','Débit (FDJ)','Crédit (FDJ)'];\n const rows=(q.rows||[]).map((label,i)=>`<tr>${names.map((name,j)=>`<td><input aria-label=\"${E('Ligne '+(i+1)+' — '+name)}\" inputmode=\"${j===2?'text':'decimal'}\" placeholder=\"${j===2?'Intitulé':j<2?'N°':'0'}\" data-i-field=\"cell:${i}:${j}\" value=\"${E(values?.[i]?.[j]||'')}\"></td>`).join('')}</tr>`).join('');\n return `<section class=\"mbi-journal\"><div class=\"mbi-journal-title\"><strong>Journal comptable · 5 colonnes</strong><small>Format des lycées de Djibouti</small></div><p class=\"mbi-muted\">Déplacez le tableau horizontalement si nécessaire.</p><div class=\"mbi-table-wrap mbi-journal-wrap\" dir=\"ltr\"><table class=\"mbi-table mbi-journal-table\"><thead><tr>${names.map(n=>`<th scope=\"col\">${E(n)}</th>`).join('')}</tr></thead><tbody><tr class=\"mbi-journal-date\"><td></td><td></td><td><strong>${E(d.date||'jj/mm/N')}</strong></td><td></td><td></td></tr>${rows}<tr class=\"mbi-journal-label\"><td colspan=\"5\">Libellé : ${E((d.type||'Facture')+' n° '+(d.number||'...'))}</td></tr></tbody></table></div><div id=\"mbi-journal-totals\" class=\"mbi-journal-totals\">Débit : ${E(mbMoney(totals.debit))} · Crédit : ${E(mbMoney(totals.credit))}</div>${B('verifyjournal','Contrôler mon journal',null,false)}${m.journalFeedback?`<p class=\"mbi-feedback\">${E(m.journalFeedback)}</p>`:''}<small class=\"mbi-muted\">L’équilibre ne suffit pas : le professeur vérifiera aussi les comptes et leurs montants.</small></section>`;\n}\nfunction mbJournalCorrect(e,q){\n const d=e?.source_document||{};\n const lines=String(q.answer||'').split('\\n').filter(Boolean).map(s=>s.split('|').map(x=>x.trim()));\n return `<div class=\"mbi-table-wrap mbi-journal-wrap\" dir=\"ltr\"><table class=\"mbi-table mbi-journal-table\"><thead><tr><th>Débit</th><th>Crédit</th><th>Date / Intitulé des comptes</th><th>Débit (FDJ)</th><th>Crédit (FDJ)</th></tr></thead><tbody><tr class=\"mbi-journal-date\"><td></td><td></td><td><strong>${E(d.date||'jj/mm/N')}</strong></td><td></td><td></td></tr>${lines.map(r=>`<tr>${[0,1,2,3,4].map(j=>`<td>${E(r[j]==='—'?'':r[j]||'')}</td>`).join('')}</tr>`).join('')}<tr class=\"mbi-journal-label\"><td colspan=\"5\">${E((d.type||'Facture')+' n° '+(d.number||'...'))}</td></tr></tbody></table></div>`;\n}\nfunction play(){\n const e=m.exercise,q=e.questions[m.index],v=m.answers[m.index];\n const guided=!!(e.source_document&&e.title.startsWith('Exercice guidé')&&q.type==='number');\n let control='';\n if(q.type==='choice'){\n   control=(q.options||[]).map((o,i)=>`<label class=\"mbi-choice ${o==='Vrai'?'mbi-true':o==='Faux'?'mbi-false':''}\"><input type=\"radio\" name=\"mbi-answer\" data-i-field=\"answer\" value=\"${E(o)}\" ${v===o?'checked':''}><span class=\"mbi-option-tag\">${'ABCD'[i]||'•'}</span><span>${E(o)}</span></label>`).join('');\n }else if(q.type==='table'){\n   control=mbJournal(e,q,v);\n }else if(!guided){\n   control=field('Votre réponse',q.type==='number'?input('answer',v||'',e.source_document?'Saisir le montant en FDJ':'Saisir la valeur numérique','text'):input('answer',v||'',e.source_document?'Saisir le mot ou le numéro de compte':'Saisir votre réponse','text'));\n }\n const intro=(e.instructions||'').split('\\n\\n')[0];\n const sheet=e.source_document?(guided?mbSheet(e,true):`<details class=\"mbi-sheet-details\" ${q.type==='table'?'':'open'}><summary>Document commercial de l’exercice</summary>${mbSheet(e,false)}</details>`):'';\n const feedback=m.feedback?.[m.index];\n const hint=q.hint&&e.mode==='training'?`<details class=\"mbi-hint\"><summary>Voir un indice</summary><p>${E(q.hint)}</p></details>`:'';\n const verify=e.mode==='training'&&['text','choice','number'].includes(q.type)?B('check','Vérifier ma réponse'):''; \n return `<section class=\"mbi-exercise-head\"><small>${E(e.academic_level+' '+e.series)} · ${E(e.subject)}</small><h2>${E(e.title)}</h2></section>${progress(m.index+1,e.questions.length)}<div class=\"mbi-row\"><span class=\"mbi-muted\">Étape ${m.index+1} sur ${e.questions.length}</span>${badge(q.points+' points')}</div><section class=\"mbi-situation\"><strong>Situation</strong><p>${E(intro)}</p></section><section class=\"mbi-question\"><span class=\"mbi-question-number\">${m.index+1}</span><h2 data-mbl-original dir=\"auto\">${E(q.prompt)}</h2></section>${sheet}${control}${feedback?`<div class=\"mbi-feedback ${feedback.correct?'mbi-good':'mbi-warning'}\" role=\"status\">${E(feedback.feedback)}</div>`:''}${hint}${verify}${q.type==='number'?`<details class=\"mbi-notice\"><summary>Calculatrice</summary><div class=\"mbi-row\"><input data-i-field=\"calcA\" inputmode=\"decimal\" placeholder=\"Nombre\"><select data-i-field=\"calcOp\"><option>+</option><option>−</option><option>×</option><option>÷</option></select><input data-i-field=\"calcB\" inputmode=\"decimal\" placeholder=\"Nombre\">${B('calc','=')}</div><output id=\"mbi-calc\"></output></details>`:''}<small class=\"mbi-muted\">Progression sauvegardée sur cet appareil. ${e.mode==='exam'?'Aucun indice pendant le défi.':''}</small>`;\n}\nfunction detail(){\n const e=m.exercise,classes=e.target_class_names||[];\n return `<div class=\"mbi-intro\"><h2>${E(e.title)}</h2><p>${E(e.academic_level+' '+e.series+' · '+e.subject)}</p></div>${badge(e.status)}<section class=\"mbi-situation\"><strong>Consignes</strong><p>${E(e.instructions||'Aucune consigne supplémentaire.')}</p></section>${e.source_document?mbSheet(e,false):''}<section class=\"mbi-assign\"><h3>Destinataires</h3><p>${E(e.target_school||'Tous les établissements')} · ${E(classes.length?classes.join(', '):'Toutes les classes du niveau')}</p></section><small class=\"mbi-muted\">${e.questions.length} questions · ${e.questions.reduce((s,q)=>s+Number(q.points||0),0)} points</small>${e.questions.map((q,i)=>`<div class=\"mbi-item\"><span><strong>${i+1}. ${E(q.prompt)}</strong><small>${E(types[q.type])} · ${q.points} pt</small></span></div>`).join('')}${e.status==='published'?B('attempts','Copies des élèves',null,true):''}${e.status==='published'&&e.mode==='exam'?B('release',e.correction_released?'Masquer le corrigé':'Autoriser le corrigé'):''}`;\n}\nfunction result(){\n const r=m.result,e=m.exercise,grades=r.grades||[];\n const valid=grades.filter(x=>x!=null&&Number(x)>0).length,wrong=grades.filter(x=>x===0).length;\n const canRetry=e.mode==='training'&&r.status==='graded';\n const correction=e.mode==='training'||e.correction_released;\n return `<section class=\"mbi-result\"><span>${r.status==='review'?'Résultat provisoire':'Résultat de votre exercice'}</span><strong>${E(r.score)} / ${E(r.total)}</strong><p>${r.status==='review'?'Le journal ou des réponses rédigées attendent la correction de votre professeur.':'Votre travail a été corrigé.'}</p></section><div class=\"mbi-stats\"><div><strong>${valid}</strong><small>Réponses réussies</small></div><div><strong>${wrong}</strong><small>Réponses à améliorer</small></div><div><strong>${E(Math.round(100*Number(r.score)/Math.max(1,Number(r.total))))} %</strong><small>Points obtenus</small></div></div>${grades.map((g,i)=>`<div class=\"mbi-item\"><span><strong>Question ${i+1}</strong><small>${E(e.questions?.[i]?.prompt||'')}</small></span>${badge(g==null?'À vérifier':g+' / '+e.questions[i].points)}</div>`).join('')}${r.status==='graded'&&correction?B('correction','Revoir le corrigé',null,true):''}${r.status==='graded'&&!correction?'<div class=\"mbi-notice\">Le professeur communiquera le corrigé de cette évaluation.</div>':''}${B('history','Historique des tentatives')}${canRetry?B('retry','Refaire cet entraînement',null,true):''}`;\n}\nfunction correction(){\n const list=m.correction||[],e=m.exercise,r=m.result||{},grades=r.grades||[];\n return `<div class=\"mbi-intro\"><h2>Correction détaillée</h2><p>Examinez chaque question, sa réponse attendue et les conseils associés.</p></div>${list.map((q,i)=>`<section class=\"mbi-correct-card\"><div class=\"mbi-row\"><strong>Question ${i+1}</strong>${badge(grades[i]==null?'En attente':grades[i]+' / '+q.points)}</div><p>${E(q.prompt||'')}</p>${q.type==='table'?mbJournalCorrect(e,q):`<div class=\"mbi-answer\"><small>Réponse attendue</small><strong>${E(q.answer||'À apprécier par le professeur')}</strong></div>`}${q.explanation||q.hint?`<p class=\"mbi-muted\">${E(q.explanation||q.hint)}</p>`:''}</section>`).join('')}`;\n}\nfunction history(){\n const h=m.history||[];\n return `<div class=\"mbi-intro\"><h2>Mes tentatives</h2><p>${E(m.exercise?.title||'')}</p></div>${h.length?h.map((v,i)=>`<div class=\"mbi-item\"><span><strong>Tentative ${h.length-i}</strong><small>${E(new Date(v.at).toLocaleString('fr-FR'))}</small></span><strong>${E(v.score)} / ${E(v.total)}</strong></div>`).join(''):'<div class=\"mbi-empty\">Aucune tentative enregistrée.</div>'}`;\n}\nfunction attempts(){return `<h2>Copies reçues</h2>${m.attempts.length?m.attempts.map(a=>`<button class=\"mbi-item\" ${A('review',a.id)}><span><strong>${E(a.full_name||'Élève')}</strong><small>${a.score}/${a.total} · ${E(status[a.status])}</small></span><span>›</span></button>`).join(''):'<div class=\"mbi-empty\">Aucune copie reçue.</div>'}`}\nfunction review(){\n const e=m.exercise,a=m.attempt,q=e.questions[m.index],v=a.answers[m.index];\n return `${progress(m.index+1,e.questions.length)}<h2>${E(a.full_name||'Élève')} · Question ${m.index+1}</h2><p>${E(q.prompt)}</p><section class=\"mbi-correct-card\"><strong>Travail de l’élève</strong>${q.type==='table'?mbReviewTable(e,q,v):`<p>${E(v||'Sans réponse')}</p>`}</section><section class=\"mbi-correct-card\"><strong>Corrigé de référence</strong>${q.type==='table'?mbJournalCorrect(e,q):`<p>${E(q.answer||'À apprécier')}</p>`}</section>${field('Note sur '+q.points,input('grade',m.grades[m.index]??'','0','number'))}`;\n}\nfunction draw(){if(!root)return;let content='',footer='';switch(m.page){case'list':content=list();break;case'edit':content=editor();footer=B('back',m.step===0?'Mes exercices':'‹ Retour')+(m.step<2?B('next','Continuer ›',null,true):B('save','Enregistrer',null,true));break;case'play':content=play();footer=B('playprev',m.index===0?'Quitter':'‹ Retour')+B(m.index===m.exercise.questions.length-1?'submit':'playnext',m.index===m.exercise.questions.length-1?'Envoyer':'Suivant ›',null,true);break;case'detail':content=detail();footer=B('list','‹ Retour')+(m.exercise.status==='draft'?B('edit','Modifier'):'')+(m.exercise.status==='draft'||m.exercise.status==='pending'&&st.role==='admin'?B('publish',st.role==='admin'?'Publier':'Soumettre',null,true):'')+(m.exercise.status==='pending'&&st.role==='admin'?B('return','Renvoyer'):'');break;case'result':content=result();footer=B('list','Mes exercices',null,true);break;case'correction':content=correction();footer=B('result','‹ Résultat',null,true);break;case'history':content=history();footer=B('result','‹ Résultat',null,true);break;case'attempts':content=attempts();footer=B('detail','‹ Retour');break;case'review':content=review();footer=B('rprev',m.index?'‹ Retour':'Copies')+B(m.index===m.exercise.questions.length-1?'grade':'rnext',m.index===m.exercise.questions.length-1?'Valider les notes':'Suivant ›',null,true);break;}\nroot.innerHTML=`<div class=\"mbi-shell\"><header class=\"mbi-header\"><button class=\"mbi-close\" ${A('close')} aria-label=\"Fermer\">‹</button><div><strong>Exercices interactifs</strong><small>monAvenir</small></div><span class=\"mbi-logo\">MB</span></header><main class=\"mbi-main\">${m.error?`<div class=\"mbi-error\" role=\"alert\">${E(m.error)}</div>`:''}${content}</main>${footer?`<footer class=\"mbi-footer\">${footer}</footer>`:''}</div>`;if(m.page==='play'&&m.deadline&&m.exercise?.time_limit_seconds){const e=document.createElement('div');e.id='mbi-timer';e.className='mbi-timer';e.setAttribute('role','timer');e.setAttribute('aria-live','off');root.querySelector('.mbi-main')?.prepend(e);tickCountdown()}if(busy)root.querySelectorAll('button').forEach(b=>b.disabled=true);}\nfunction tickCountdown(){if(!root||m.page!=='play'||!m.deadline||!m.exercise?.time_limit_seconds)return;const remaining=Math.max(0,Math.ceil((m.deadline-Date.now())/1000)),lang=window.MBLang?.get?.()||'fr',label=lang==='ar'?'الوقت المتبقي':lang==='en'?'Time remaining':'Temps restant';const el=root.querySelector('#mbi-timer');if(el){el.textContent='⏱ '+label+' : '+Math.floor(remaining/60).toString().padStart(2,'0')+':'+(remaining%60).toString().padStart(2,'0');el.dataset.expired=remaining===0?'yes':'no';}if(remaining===0&&!busy&&!m.timerAutoDone&&m.page==='play'){m.timerAutoDone=true;busy=true;call('submit',{id:m.exercise.id,answers:m.answers}).then(x=>{m.result=x;remove('attempt',m.exercise.id);m.page='result';m.error='';}).catch(err=>{m.error=err.message||'Temps écoulé';m.page='list';}).finally(()=>{busy=false;draw()});}}\nsetInterval(tickCountdown,1000);\nfunction change(ev){let k=ev.target.dataset.iField;if(!k)return;let v=ev.target.value;if(k==='filter'){m.filter=v;draw();return}if(k==='target_class_csv'){m.exercise.target_class_names=v.split(',').map(x=>x.trim()).filter(Boolean);persist();return}\nif(k.startsWith('group:')){const g=m.groups?.[Number(k.slice(6))];if(!g)return;let selected=Array.isArray(m.exercise.target_class_names)?m.exercise.target_class_names:[];if(ev.target.checked){if(String(m.exercise.target_school||'').toLowerCase()!==String(g.school).toLowerCase())selected=[];if(!selected.includes(g.name))selected.push(g.name);m.exercise.target_school=g.school}else{selected=selected.filter(x=>x!==g.name)}m.exercise.target_class_names=selected;persist();return}\nif(k==='specialty'){Object.assign(m.exercise,m.specialties[Number(v)]);persist();return}if(k.startsWith('q.')){let q=m.exercise.questions[m.index],p=k.slice(2);q[p]=['options','columns','rows'].includes(p)?v.split('\\n'):p==='points'?v:v;if(p==='type'){q.answer='';if(v==='choice')q.options=['',''];draw()}persist();return}if(k==='answer'){m.answers[m.index]=v;if(m.feedback)delete m.feedback[m.index];persist();return}if(k.startsWith('cell:')){let [,i,j]=k.split(':').map((x,n)=>n?Number(x):x);let q=m.exercise.questions[m.index];if(!Array.isArray(m.answers[m.index]))m.answers[m.index]=q.rows.map(()=>q.columns.map(()=>''));m.answers[m.index][i][j]=v;m.journalFeedback='';persist();const totals=root?.querySelector('#mbi-journal-totals');if(totals){const sums=mbSums(m.answers[m.index]);totals.textContent='Débit : '+mbMoney(sums.debit)+' · Crédit : '+mbMoney(sums.credit)}return}if(k==='grade'){m.grades[m.index]=v===''?null:Number(v);return}if(k.startsWith('calc'))return;if(m.page==='edit'){m.exercise[k]=v;persist()}}\nfunction validQuestion(q){if(!q.prompt.trim()||!(Number(q.points)>0&&Number(q.points)<=100))throw Error('Complétez l’énoncé et le barème.');if(q.type==='number'&&!/^[+-]?\\d+(\\.\\d+)?$/.test(String(q.answer).replace(',','.')))throw Error('Saisissez une réponse numérique valide.');if(q.type==='choice'){q.options=q.options.map(x=>x.trim()).filter(Boolean);q.answer=q.answer.trim();if(q.options.length<2||!q.options.includes(q.answer))throw Error('Ajoutez au moins deux choix et une bonne réponse identique à un choix.')}if(q.type==='table'){q.columns=q.columns.map(x=>x.trim()).filter(Boolean);q.rows=q.rows.map(x=>x.trim()).filter(Boolean);if(!q.columns.length||!q.rows.length)throw Error('Complétez les colonnes et lignes du tableau.')}q.points=Number(q.points);if(q.type==='number')q.answer=String(q.answer).replace(',','.');}\nasync function click(ev){const btn=ev.target.closest('[data-i-act]');if(!btn||busy)return;let a=btn.dataset.iAct,v=btn.dataset.iValue;m.error='';if(a==='close'){close();return}if(a==='calc'){let get=k=>root.querySelector(`[data-i-field=\"${k}\"]`).value;let x=Number(get('calcA').replace(',','.')),y=Number(get('calcB').replace(',','.')),op=get('calcOp');let res=op==='+'?x+y:op==='−'?x-y:op==='×'?x*y:x/y;root.querySelector('#mbi-calc').textContent=Number.isFinite(res)?String(res):'Calcul impossible';return}busy=true;try{switch(a){case'list':await reload();break;\ncase 'kind':m.kind=v||'';break;\ncase 'check':{\n if(m.exercise.mode!=='training')throw Error('Vérification indisponible pendant un défi.');\n const ans=m.answers?.[m.index];\n if(ans==null||String(ans).trim()==='')throw Error('Saisissez votre réponse avant de vérifier.');\n const verdict=await call('check',{id:m.exercise.id,index:m.index,answer:ans});\n (m.feedback||(m.feedback={}))[m.index]=verdict;\n break;\n}\ncase 'verifyjournal':{\n const rows=m.answers?.[m.index];\n const totals=mbSums(rows);\n const count=m.exercise.questions[m.index].rows.length;\n const filled=Array.isArray(rows)&&rows.length===count&&rows.every(row=>Array.isArray(row)&&(String(row[0]||'').trim()||String(row[1]||'').trim())&&String(row[2]||'').trim()&&(String(row[3]||'').trim()||String(row[4]||'').trim()));\n const mixed=Array.isArray(rows)&&rows.some(row=>String(row?.[0]||'').trim()&&String(row?.[1]||'').trim());\n if(!filled)m.journalFeedback='Complétez les comptes, les intitulés et les montants.';\n else if(mixed)m.journalFeedback='Un compte doit être placé soit au débit, soit au crédit.';\n else if(totals.invalid)m.journalFeedback='Utilisez des montants numériques positifs ou nuls.';\n else if(totals.debit<=0||Math.abs(totals.debit-totals.credit)>0.000001)m.journalFeedback='Le journal n’est pas équilibré : vérifiez les totaux.';\n else m.journalFeedback='Les totaux sont égaux. Le professeur doit encore vérifier les comptes et les montants.';\n break;\n}\ncase 'correction':m.correction=await call('correction',{id:m.exercise.id});m.page='correction';break;\ncase 'history':m.history=await call('history',{id:m.exercise.id});m.page='history';break;\ncase 'result':m.page='result';break;\ncase 'retry':{\n if(m.exercise.mode!=='training'||m.result?.status!=='graded')throw Error('Attendez la correction avant de refaire l’exercice.');\n m.exercise=await call('open',{id:m.exercise.id});\n m.answers=m.exercise.questions.map(()=>null);\n m.index=0;m.feedback={};m.journalFeedback='';\n remove('attempt',m.exercise.id);m.result=null;m.page='play';break;\n}\ncase 'release':{\n if(!teacher()||m.exercise.mode!=='exam')throw Error('Action réservée à l’enseignant.');\n await call('release',{id:m.exercise.id,release:!m.exercise.correction_released});\n m.exercise=await call('open',{id:m.exercise.id});\n m.page='detail';break;\n}\ncase'new':{if(st.role==='enseignant'&&!m.specialties.length)throw Error('Aucune matière approuvée. Contactez l’administration.');let old=read('editor','new');m.exercise=old?.exercise||{title:'',series:'GFM',academic_level:'Terminale',subject:'',instructions:'',mode:'training',questions:[newQuestion()],...(m.specialties[0]||{})};m.step=old?.step||0;m.index=old?.index||0;m.page='edit';break}case'open':{m.exercise=await call('open',{id:v});if(teacher()){m.page='detail'}else{if(m.rows.find(x=>x.id===v)?.attempt){m.result=await call('result',{id:v});m.page='result'}else{let draft=read('attempt',v);m.answers=draft?.answers||m.exercise.questions.map(()=>null);m.index=Math.min(draft?.index||0,m.exercise.questions.length-1);if(m.exercise.time_limit_seconds){const started=await call('start',{id:v});m.deadline=Date.parse(started.deadline);m.timerAutoDone=false;}m.page='play'}}break}case'edit':{let d=read('editor',m.exercise.id);if(d)m.exercise=d.exercise;m.step=d?.step||0;m.index=d?.index||0;m.page='edit';break}case'back':if(m.step>0)m.step--;else{persist();await reload()}break;case'next':if(m.step===0&&(!m.exercise.title.trim()||!m.exercise.subject.trim()))throw Error('Indiquez le titre et la matière.');if(m.step===1)m.exercise.questions.forEach(validQuestion);m.step++;break;case'editq':m.index=Number(v);m.step=1;break;case'qprev':m.index=Math.max(0,m.index-1);break;case'qnext':m.index=Math.min(m.exercise.questions.length-1,m.index+1);break;case'add':validQuestion(m.exercise.questions[m.index]);if(m.exercise.questions.length>=50)throw Error('50 questions maximum.');m.exercise.questions.push(newQuestion());m.index=m.exercise.questions.length-1;break;case'deleteq':m.exercise.questions.splice(m.index,1);m.index=Math.max(0,m.index-1);break;case'template':{let q=m.exercise.questions[m.index];if(v==='invoice'){q.columns=['Montant (FDJ)'];q.rows=['Montant brut HT','Remise','Net commercial HT','Escompte','Net financier HT','TVA','Net à payer TTC']}else{q.columns=['Débit (compte)','Crédit (compte)','Date / intitulé','Débit (FDJ)','Crédit (FDJ)'];q.rows=['Écriture 1','Écriture 2','Écriture 3','Écriture 4']};break}case'save':{m.exercise.questions.forEach(validQuestion);let old=m.exercise.id||'new';let r=await call('save',m.exercise);remove('editor',old);m.exercise=await call('open',{id:r.id});m.page='detail';break}case'publish':if(!confirm(st.role==='admin'?'Publier pour cette série et ce niveau ?':'Envoyer à l’administrateur pour validation ?'))break;await call('publish',{id:m.exercise.id});await reload();break;case'return':await call('return',{id:m.exercise.id});await reload();break;case'playprev':if(m.index>0)m.index--;else{persist();await reload()}break;case'playnext':m.index++;break;case'submit':if(!confirm('Envoyer définitivement votre copie ?'))break;m.result=await call('submit',{id:m.exercise.id,answers:m.answers});remove('attempt',m.exercise.id);m.page='result';break;case'attempts':m.attempts=await call('attempts',{id:m.exercise.id});m.page='attempts';break;case'detail':m.page='detail';break;case'review':m.attempt=m.attempts.find(x=>x.id===v);m.grades=[...m.attempt.grades];m.index=0;m.page='review';break;case'rprev':if(m.index>0)m.index--;else m.page='attempts';break;case'rnext':if(m.grades[m.index]==null)throw Error('Indiquez une note.');m.index++;break;case'grade':if(m.grades.some((g,i)=>g==null||!Number.isFinite(g)||g<0||g>Number(m.exercise.questions[i].points)))throw Error('Vérifiez toutes les notes et les barèmes.');await call('grade',{id:m.exercise.id,attempt_id:m.attempt.id,grades:m.grades});m.attempts=await call('attempts',{id:m.exercise.id});m.page='attempts';break;}persist()}catch(e){m.error=e.message||'Une erreur est survenue. Réessayez.'}finally{busy=false;draw()}}\nfunction mount(){if(st.role==='eleve'){document.querySelectorAll('#app [data-mbi-launch]').forEach(el=>el.remove());return}if(root&&st.user?.id!==uid){close();return}if(!st.user||!['eleve','enseignant','admin'].includes(st.role)||!['student-home','teacher-home','admin-home'].includes(st.screen)||st.role==='enseignant'&&st.teacher?.status!=='approved')return;let tiles=document.querySelector('#app .mb-tiles');if(!tiles||tiles.querySelector('[data-mbi-launch]'))return;let b=document.createElement('button');b.type='button';b.className='mb-tile mbi-launch';b.dataset.mbiLaunch='1';b.innerHTML='<span class=\"mbi-launch-icon\" aria-hidden=\"true\">✎</span><span>Exercices interactifs</span>';b.addEventListener('click',show);tiles.prepend(b)}\n// Preserve existing wizard state while importing documents and illustrations.\nconst originalDraw=draw;\nfunction importImage(q,host,editable){if(!q?.image||!/^data:image\\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(q.image))return;const box=document.createElement('div');box.className='mbi-import-image';const img=document.createElement('img');img.src=q.image;img.alt='Document de la question';img.loading='lazy';box.append(img);const link=document.createElement('button');link.className='mbi-button';link.type='button';link.textContent='Agrandir le document';link.onclick=()=>{const d=document.createElement('dialog');d.className='mbi-image-dialog';const big=img.cloneNode();const b=document.createElement('button');b.type='button';b.className='mbi-button';b.textContent='Fermer';b.onclick=()=>d.close();d.append(b,big);document.body.append(d);d.addEventListener('close',()=>d.remove(),{once:true});d.showModal()};box.append(link);if(editable){const b=document.createElement('button');b.type='button';b.className='mbi-button';b.textContent='Retirer l’image';b.onclick=()=>{delete q.image;persist();draw()};box.append(b)}host.after(box)}\ndraw=function(){originalDraw();if(!root||!window.MBIImport)return;const main=root.querySelector('.mbi-main');if(!main)return;const e=m.exercise,q=e?.questions?.[m.index];if(m.page==='edit'&&(m.step===0||m.step===1)){const stage=m.step;const field=main.querySelector(stage===0?'[data-i-field=\"instructions\"]':'[data-i-field=\"q.prompt\"]');if(!field)return;const container=document.createElement('div');container.innerHTML=MBIImport.panel(stage);const panel=container.firstElementChild;field.closest('label').before(panel);MBIImport.attach(root,stage,{text(t){t=t.trim();const limit=stage===0?30000:5000;if(t.length>limit)throw Error('Le texte dépasse '+limit+' caractères. Réduisez l’aperçu avant de l’insérer.');const previous=stage===0?e.instructions:q.prompt;if(previous&&previous.trim()&&!confirm('Remplacer le texte actuel par le document importé ?'))return;if(stage===0)e.instructions=t;else q.prompt=t;persist();draw()},questions(list){const existing=e.questions.filter(x=>x.prompt.trim());if(existing.length+list.length>50)throw Error('Maximum 50 questions.');e.questions=[...existing,...list.map(prompt=>({...newQuestion(),prompt}))];m.step=1;m.index=existing.length;persist();draw()},correction(t){if(!q)throw Error('Aucune question sélectionnée.');if(t.length>20000)throw Error('Corrigé trop long.');if(q.answer&&!confirm('Remplacer le corrigé actuel ?'))return;q.answer=t.trim();persist();draw()},image(data){if(q.image&&!confirm('Remplacer l’illustration actuelle ?'))return;q.image=data;persist();draw()}});if(stage===1)importImage(q,panel,true)}else if(m.page==='play'||m.page==='review'){const anchor=main.querySelector('h2');if(anchor)importImage(q,anchor,false)}};\n\n// Optional teacher-controlled AI: private, bounded, and no automatic grading.\nconst drawBeforeAI=draw;\ndraw=function(){\n drawBeforeAI();\n if(!root||m.page!=='review'||!teacher())return;\n const q=m.exercise?.questions?.[m.index],answer=m.attempt?.answers?.[m.index],grade=root.querySelector('[data-i-field=\"grade\"]');\n if(!q||q.type!=='text'||!grade||q.image||!String(q.answer||'').trim()||typeof answer!=='string'||!answer.trim()||[q.prompt,q.answer,answer].some(x=>String(x).length>1400))return;\n const languageCode=(document.documentElement.lang||'fr').toLowerCase().slice(0,2), tr=(fr,en,ar)=>languageCode==='ar'?ar:languageCode==='en'?en:fr;\n const state=m,sessionUid=uid,idx=m.index,attempt=m.attempt.id,exercise=m.exercise.id,key=attempt+':'+idx;\n const cache=state.aiResults||(state.aiResults={});\n const box=document.createElement('section');box.className='mbi-ai';box.dir=languageCode==='ar'?'rtl':'ltr';\n const label=document.createElement('div');label.className='mbi-ai-heading';label.textContent=tr('✦ Correction assistée par IA','✦ AI-assisted grading','✦ التصحيح بمساعدة الذكاء الاصطناعي');\n const small=document.createElement('small');small.textContent=tr('Suggestion uniquement. Vous gardez la décision finale.','Suggestion only. You make the final decision.','اقتراح فقط. القرار النهائي لك.');\n const statusEl=document.createElement('div');statusEl.setAttribute('aria-live','polite');statusEl.className='mbi-ai-status';\n const button=document.createElement('button');button.type='button';button.className='mbi-button mbi-ai-action';button.textContent=tr('Analyser la réponse','Analyze answer','تحليل الإجابة');\n const result=document.createElement('div');result.className='mbi-ai-result';result.hidden=true;\n box.append(label,small,button,statusEl,result);grade.closest('label').before(box);\n const current=()=>root&&m===state&&uid===sessionUid&&st.user?.id===sessionUid&&m.page==='review'&&m.attempt?.id===attempt&&m.index===idx;\n function render(value){\n  result.replaceChildren();result.hidden=false;button.hidden=true;statusEl.textContent='';button.disabled=false;\n  const heading=document.createElement('strong');heading.textContent=tr('Note proposée : ','Suggested mark: ','الدرجة المقترحة: ')+value.score+' / '+value.points;\n  const reason=document.createElement('p');reason.textContent=value.explanation;\n  const lang=document.createElement('p');const title=document.createElement('strong');title.textContent=tr('Orthographe et grammaire : ','Spelling and grammar: ','الإملاء والنحو: ');lang.append(title,document.createTextNode(value.language));\n  const apply=document.createElement('button');apply.type='button';apply.className='mbi-button mbi-primary';apply.textContent=tr('Utiliser cette note','Use this mark','استخدام هذه الدرجة');\n  apply.onclick=()=>{if(!current())return;const field=root.querySelector('[data-i-field=\"grade\"]');if(!field)return;m.grades[idx]=value.score;field.value=String(value.score);statusEl.textContent=tr('Note proposée reportée. Validez la copie à la fin.','Suggested mark entered. Validate the submission at the end.','تم إدخال الدرجة المقترحة. اعتمد التصحيح في النهاية.')};\n  const quota=document.createElement('small');quota.textContent=Number.isInteger(value.remaining)?tr('Analyses restantes aujourd’hui : ','Analyses remaining today: ','التحليلات المتبقية اليوم: ')+value.remaining:'';\n  result.append(heading,reason,lang,apply,quota);\n }\n if(cache[key]?.data){render(cache[key].data);return}\n if(cache[key]?.pending){button.disabled=true;statusEl.textContent=tr('Analyse en cours…','Analyzing…','جارٍ التحليل…')}\n button.onclick=async()=>{\n   if(!current()||busy||cache[key]?.pending)return;\n   if(!confirm(tr('Seuls l’énoncé, le corrigé et la réponse seront analysés par Cloudflare. Vérifiez qu’ils ne contiennent aucune information personnelle ou sensible. Continuer ?','Cloudflare will analyze only the question, expected answer and student answer. Confirm they contain no personal or sensitive information. Continue?','سيحلل Cloudflare السؤال والإجابة النموذجية وإجابة الطالب فقط. تأكد من خلوها من المعلومات الشخصية أو الحساسة. هل تريد المتابعة؟')))return;\n   cache[key]={pending:true};button.disabled=true;statusEl.textContent=tr('Analyse en cours…','Analyzing…','جارٍ التحليل…');\n   try{\n    const {data,error}=await st.db.auth.getSession();if(error||!data?.session?.access_token)throw Error(tr('Reconnectez-vous pour continuer.','Sign in again to continue.','سجّل الدخول مجددًا للمتابعة.'));\n    if(!current())throw Error(tr('Correction interrompue.','Grading interrupted.','تم إيقاف التصحيح.'));\n    const response=await fetch('/api/interactive-ai',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+data.session.access_token},body:JSON.stringify({exercise,attempt,index:idx})});\n    const value=await response.json();if(!response.ok)throw Error((languageCode==='fr'&&value.error)|| (response.status===429?tr('Quota gratuit atteint.','Free daily quota reached.','تم بلوغ الحد المجاني اليومي.'):tr('IA momentanément indisponible.','AI is temporarily unavailable.','الذكاء الاصطناعي غير متاح مؤقتًا.')) ||tr('IA momentanément indisponible.','AI is temporarily unavailable.','الذكاء الاصطناعي غير متاح مؤقتًا.'));\n    cache[key]={data:value};if(current())draw();\n   }catch(err){delete cache[key];if(current()){const live=root.querySelector('.mbi-ai-status');const b=root.querySelector('.mbi-ai-action');if(live)live.textContent=err.message||tr('Correction manuelle disponible.','Manual grading is available.','التصحيح اليدوي متاح.');if(b)b.disabled=false}}\n };\n};\n\nconst observer=new MutationObserver(()=>mount());observer.observe(document.getElementById('app')||document.body,{childList:true,subtree:true});mount();\nwindow.MonBacInteractive={\n open:show,\n openExercise:async function(id){\n   await show();\n   if(!root)throw Error('Impossible d’ouvrir les exercices interactifs.');\n   const button=Array.from(root.querySelectorAll('button[data-i-act=\"open\"]')).find(el=>el.dataset.iValue===String(id));\n   if(!button){close();throw Error('Cet exercice ne figure pas dans votre liste autorisée.');}\n   button.click();\n }\n};\n\n})();\n"],"/mon-bac-interactive-focus-20261119.js":["text/javascript; charset=utf-8",false,"/* monAvenir — exercices interactifs, avec correction IA facultative et quota gratuit. */\n(()=>{'use strict';\nconst E=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst A=(name,value)=>`data-i-act=\"${name}\"${value==null?'':` data-i-value=\"${E(value)}\"`}`;\nconst B=(name,label,value,primary=false)=>`<button type=\"button\" class=\"mbi-button ${primary?'mbi-primary':''}\" ${A(name,value)}>${E(label)}</button>`;\nconst select=(key,values,current)=>`<select data-i-field=\"${key}\">${values.map(v=>`<option ${String(v)===String(current)?'selected':''}>${E(v)}</option>`).join('')}</select>`;\nconst field=(label,html)=>`<label class=\"mbi-field\"><span>${E(label)}</span>${html}</label>`;\nconst input=(key,value,placeholder='',type='text')=>`<input type=\"${type}\" data-i-field=\"${key}\" value=\"${E(value)}\" placeholder=\"${E(placeholder)}\">`;\nconst area=(key,value,placeholder='')=>`<textarea rows=\"3\" lang=\"fr\" spellcheck=\"true\" autocorrect=\"on\" autocapitalize=\"sentences\" data-i-field=\"${key}\" placeholder=\"${E(placeholder)}\">${E(value)}</textarea>`;\nconst newQuestion=()=>({type:'text',prompt:'',points:1,answer:'',hint:'',options:['',''],columns:['Libellé','Montant'],rows:['Ligne 1']});\nconst types={text:'Réponse rédigée',number:'Calcul / nombre',choice:'QCM (un choix)',table:'Tableau à compléter'};\nconst status={draft:'Brouillon',pending:'À valider',published:'Publié',review:'À corriger',graded:'Corrigé'};\nlet m={};let root=null;let uid=null;let previousFocus=null;let busy=false;\nconst teacher=()=>st.role==='enseignant'||st.role==='admin';\nconst call=async(action,data={})=>{if(st.user?.id!==uid)throw Error('Reconnectez-vous.');const r=await st.db.rpc('mon_bac_interactive',{p_action:action,p_data:data});if(r.error)throw Error(r.error.message);return r.data;};\nconst key=(kind,id='new')=>`monbac-interactive:${uid}:${kind}:${id}`;\nconst read=(kind,id)=>{try{return JSON.parse(localStorage.getItem(key(kind,id))||'null')}catch{return null}};\nconst write=(kind,id,value)=>{try{localStorage.setItem(key(kind,id),JSON.stringify(value))}catch{}};\nconst remove=(kind,id)=>{try{localStorage.removeItem(key(kind,id))}catch{}};\nconst persist=()=>{if(m.page==='edit')write('editor',m.exercise.id||'new',{exercise:m.exercise,step:m.step,index:m.index});if(m.page==='play')write('attempt',m.exercise.id,{answers:m.answers,index:m.index});};\nconst close=()=>{persist();root?.remove();root=null;document.documentElement.classList.remove('mbi-open');previousFocus?.focus?.();};\nconst show=async()=>{if(root)return;uid=st.user?.id;if(!uid)return;previousFocus=document.activeElement;m={page:'list',rows:[],loading:true,filter:''};root=document.createElement('div');root.id='mbi-root';root.setAttribute('role','dialog');root.setAttribute('aria-modal','true');root.setAttribute('aria-label','Exercices interactifs');document.body.append(root);document.documentElement.classList.add('mbi-open');root.addEventListener('click',click);root.addEventListener('input',change);root.addEventListener('change',change);root.addEventListener('keydown',ev=>{if(ev.key==='Escape'&&!busy)close()});draw();await reload();};\nasync function reload(){m.page='list';m.loading=true;draw();try{m.rows=await call('list');m.specialties=teacher()?await call('specialties'):[];m.groups=teacher()?await call('groups'):[];m.error='';}catch(e){m.error=e.message}finally{m.loading=false;draw()}}\nconst badge=s=>`<span class=\"mbi-badge\">${E(status[s]||s)}</span>`;\nconst progress=(n,total)=>`<div class=\"mbi-progress\" role=\"progressbar\" aria-valuemin=\"0\" aria-valuemax=\"${total}\" aria-valuenow=\"${n}\" aria-label=\"Étape ${n} sur ${total}\"><i style=\"width:${n/total*100}%\"></i></div>`;\nfunction mbClassFields(e){\n const groups=(m.groups||[]).filter(g=>!g.subject||!e.subject||g.subject===e.subject);\n const selected=e.target_class_names||[];\n const classes=st.role==='admin'?field('Classes destinataires',area('target_class_csv',selected.join(', '),'Ex. TGFM1, TGFM6, TGFM7')):groups.length?groups.map((g,i)=>`<label class=\"mbi-group-choice\"><input type=\"checkbox\" data-i-field=\"group:${(m.groups||[]).indexOf(g)}\" ${selected.includes(g.name)&&String(e.target_school).toLowerCase()===String(g.school).toLowerCase()?'checked':''}><span><strong>${E(g.name)}</strong><small>${E(g.school)}</small></span></label>`).join(''):'<p class=\"mbi-muted\">Créez d’abord votre classe dans monAvenir pour lui attribuer cet exercice.</p>';\n return `<section class=\"mbi-assign\"><h3>Affectation pédagogique</h3><p class=\"mbi-muted\">Seuls les élèves de la série, du niveau, de l’établissement et des classes indiqués pourront accéder à l’activité.</p>${field('Établissement',input('target_school',e.target_school||'','Établissement des élèves'))}<div class=\"mbi-class-list\">${classes}</div><small class=\"mbi-muted\">Les noms des classes doivent correspondre aux profils des élèves. Un enseignant ne peut sélectionner que ses propres classes.</small></section>`;\n}\nfunction mbReviewTable(e,q,v){\n const heads=['Débit','Crédit','Date / Intitulé des comptes','Débit (FDJ)','Crédit (FDJ)'];\n const date=e?.source_document?.date||'jj/mm/N';\n const rows=Array.isArray(v)?v:[];\n return `<div class=\"mbi-table-wrap mbi-journal-wrap\" dir=\"ltr\"><table class=\"mbi-table mbi-journal-table\"><thead><tr>${heads.map(h=>`<th>${E(h)}</th>`).join('')}</tr></thead><tbody><tr class=\"mbi-journal-date\"><td></td><td></td><td>${E(date)}</td><td></td><td></td></tr>${rows.map(r=>`<tr>${heads.map((_,j)=>`<td>${E(r?.[j]||'')}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;\n}\nfunction list(){\n const categories=[['','Tous'],['Exercice guidé','Guidés'],['QCM','QCM'],['Vrai ou faux','Vrai / Faux'],['Texte à trous','Textes à trous'],['Étude de cas','Études de cas'],['Défi chronométré','Défis']];\n const rows=m.rows.filter(x=>(!m.filter||x.subject===m.filter)&&(!m.kind||x.title.startsWith(m.kind)));\n const subjects=[...new Set(m.rows.map(x=>x.subject))];\n const accessible=m.rows.filter(x=>!m.filter||x.subject===m.filter);\n const finished=accessible.filter(x=>x.attempt?.status==='graded');\n const submitted=accessible.filter(x=>x.attempt);\n const avg=finished.length?Math.round(20*finished.reduce((sum,x)=>sum+Number(x.attempt.score)/Math.max(1,Number(x.attempt.total)),0)/finished.length*10)/10:0;\n const toReview=finished.filter(x=>Number(x.attempt.score)/Math.max(1,Number(x.attempt.total))<.65);\n const overview=!teacher()?`<section class=\"mbi-overview\"><div class=\"mbi-row\"><strong>Ma progression</strong><span class=\"mbi-muted\">${submitted.length} / ${accessible.length} activités commencées</span></div><div class=\"mbi-overview-numbers\"><div><strong>${finished.length}</strong><small>Terminées et corrigées</small></div><div><strong>${finished.length?avg.toLocaleString('fr-FR')+'/20':'—'}</strong><small>Moyenne actuelle</small></div><div><strong>${toReview.length}</strong><small>À renforcer</small></div></div>${toReview.length?`<details class=\"mbi-review-suggestions\"><summary>Exercices à retravailler</summary>${toReview.slice(0,3).map(x=>`<button type=\"button\" class=\"mbi-suggestion\" ${A('open',x.id)}>${E(x.title)} <span>${E(x.attempt.score)}/${E(x.attempt.total)}</span></button>`).join('')}</details>`:''}</section>`:'';\n return `<div class=\"mbi-intro\"><h2>${teacher()?'Mes activités pédagogiques':'Exercices interactifs'}</h2><p>${teacher()?'Préparez les activités, choisissez vos classes et corrigez les copies.':'Apprenez avec des documents, des calculs et des corrections adaptés à votre niveau.'}</p></div>${overview}${teacher()?B('new','＋ Créer une activité',null,true):''}<div class=\"mbi-category-chips\">${categories.map(([key,label])=>`<button class=\"mbi-chip ${m.kind===key||(!m.kind&&!key)?'is-active':''}\" ${A('kind',key)}>${E(label)}</button>`).join('')}</div>${subjects.length>1?field('Matière',`<select data-i-field=\"filter\"><option value=\"\">Toutes les matières</option>${subjects.map(s=>`<option ${s===m.filter?'selected':''}>${E(s)}</option>`).join('')}</select>`):''}<small class=\"mbi-muted\">${rows.length} activité(s) ${m.kind?'dans ce type':'disponibles'}</small>${m.loading?'<p>Chargement…</p>':!rows.length?'<div class=\"mbi-empty\">Aucune activité dans cette catégorie.</div>':rows.map(x=>`<button class=\"mbi-item mbi-activity\" ${A('open',x.id)}><span><small>${E(x.academic_level+' '+x.series+' · '+x.subject)}</small><strong>${E(x.title)}</strong><small>${x.question_count} question(s) · ${x.mode==='exam'?'Évaluation':'Entraînement'}${x.attempt?' · Note : '+x.attempt.score+'/'+x.attempt.total:''}</small></span>${teacher()?badge(x.status):x.attempt?badge(x.attempt.status):'<span class=\"mbi-arrow\">›</span>'}</button>`).join('')}`;\n}\nfunction editor(){let e=m.exercise,q=e.questions[m.index];let bar=progress(m.step+1,3);if(m.step===0){let specs=m.specialties||[],specific=st.role!=='admin';return `${bar}<h2>1. Le sujet</h2>${specific?field('Classe et matière',`<select data-i-field=\"specialty\">${specs.map((s,i)=>`<option value=\"${i}\" ${s.series===e.series&&s.academic_level===e.academic_level&&s.subject===e.subject?'selected':''}>${E(s.academic_level+' '+s.series+' · '+s.subject)}</option>`).join('')}</select>`):field('Série',select('series',['GFM','OGRH','IAG','S','ES','L'],e.series))+field('Niveau',select('academic_level',['Première','Terminale'],e.academic_level))+field('Matière',input('subject',e.subject,'Ex. Gestion financière'))}${field('Titre',input('title',e.title,'Ex. Facture avec remise'))}${field('Consignes / contexte',area('instructions',e.instructions,'Saisir ou coller le sujet'))}${mbClassFields(e)}${field('Mode',`<select data-i-field=\"mode\"><option value=\"training\" ${e.mode==='training'?'selected':''}>Entraînement</option><option value=\"exam\" ${e.mode==='exam'?'selected':''}>Évaluation</option></select>`)}`}\nif(m.step===1)return `${bar}<div class=\"mbi-row\"><h2>2. Question ${m.index+1}/${e.questions.length}</h2>${badge(e.questions.length+' bloc(s)')}</div>${field('Type',`<select data-i-field=\"q.type\">${Object.entries(types).map(([k,v])=>`<option value=\"${k}\" ${q.type===k?'selected':''}>${E(v)}</option>`).join('')}</select>`)}${field('Énoncé',area('q.prompt',q.prompt,'Écrire la question'))}${field('Barème (points)',input('q.points',q.points,'1','number'))}${q.type==='choice'?field('Choix (un par ligne)',area('q.options',(q.options||[]).join('\\n')))+field('Bonne réponse (recopier un choix)',input('q.answer',q.answer)):q.type==='table'?field('Colonnes (une par ligne)',area('q.columns',(q.columns||[]).join('\\n')))+field('Lignes (une par ligne)',area('q.rows',(q.rows||[]).join('\\n')))+`<div class=\"mbi-row\">${B('template','Facture','invoice')}${B('template','Journal 5 colonnes','journal')}</div>`+field('Corrigé de référence (enseignant)',area('q.answer',q.answer)):field(q.type==='number'?'Réponse numérique':'Réponse attendue / critères',q.type==='number'?input('q.answer',q.answer,'Ex. 512050'):area('q.answer',q.answer,'Les autres formulations seront à vérifier'))}${e.mode==='training'?field('Indice (facultatif)',area('q.hint',q.hint)):''}<div class=\"mbi-row\">${B('qprev','‹ Précédente')}${B('qnext','Suivante ›')}${B('add','＋ Question')}${e.questions.length>1?B('deleteq','Retirer'):''}</div>`;\nreturn `${bar}<h2>3. Vérification</h2><div class=\"mbi-notice\"><strong>${E(e.title||'Sans titre')}</strong><p>${E(e.academic_level+' '+e.series+' · '+e.subject)}</p><p>${e.questions.length} question(s) · ${e.questions.reduce((s,q)=>s+Number(q.points||0),0)} points</p></div>${e.questions.map((q,i)=>`<button class=\"mbi-item\" ${A('editq',i)}><span><strong>${i+1}. ${E(q.prompt||'Question vide')}</strong><small>${E(types[q.type])} · ${E(q.points)} pt</small></span><span>›</span></button>`).join('')}<p class=\"mbi-muted\">Les copies rédigées et les tableaux sont contrôlés par l’enseignant. Aucune IA payante n’est utilisée.</p>`}\nfunction mbMoney(n){return Number(n||0).toLocaleString('fr-FR')+' FDJ'}\nfunction mbSheet(e,editable){\n const d=e?.source_document;if(!d)return '';\n const guided=!!editable;\n const data=['Montant brut HT','Remise commerciale','Base taxable HT','TVA (10 %)','Net TTC'];\n const row=data.map((label,i)=>{\n   const v=m.answers?.[i],prev=v!==undefined&&v!==null&&v!=='';\n   const value=guided&&m.index===i?`<input type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" data-i-field=\"answer\" aria-label=\"${E(label)}\" placeholder=\"Votre calcul (FDJ)\" value=\"${E(prev?v:'')}\">`:guided&&m.index>i&&prev?`<strong>${E(mbMoney(v))}</strong>`:'<span class=\"mbi-sheet-empty\">À compléter</span>';\n   return guided?`<tr class=\"${m.index===i?'mbi-sheet-active':''}\"><th scope=\"row\">${E(label)}</th><td>${value}</td></tr>`:'';\n }).join('');\n const subtitle=d.regulation==='remise_oubliee'?'Facture initiale — avoir de remise oubliée':d.type==='AVOIR'?'Facture AVOIR — retour de marchandises':'Facture DOIT';\n return `<section class=\"mbi-sheet\" dir=\"ltr\"><div class=\"mbi-sheet-head\"><div><small>DOCUMENT COMPTABLE · SIMULATION</small><strong>${E(subtitle)}</strong></div><span>${E(d.number||'SIM')}</span></div><div class=\"mbi-sheet-meta\"><span>Date : ${E(d.date||'N')}</span><span>TVA : ${E(d.tva_percent||10)} %</span></div><table class=\"mbi-sheet-table\"><thead><tr><th>Désignation</th><th>Quantité</th><th>Prix unitaire</th></tr></thead><tbody><tr><td>Marchandises</td><td>${E(d.quantity||10)}</td><td>${E(mbMoney(d.unit_price))}</td></tr></tbody></table>${d.discount_percent?`<div class=\"mbi-sheet-tag\">Remise : ${E(d.discount_percent)} %</div>`:''}${d.escompte_percent?`<div class=\"mbi-sheet-tag\">Escompte : ${E(d.escompte_percent)} %</div>`:''}${d.transport_ht?`<div class=\"mbi-sheet-tag\">Transport : ${E(mbMoney(d.transport_ht))}</div>`:''}${guided?`<table class=\"mbi-sheet-calc\"><tbody>${row}</tbody></table>`:'<p class=\"mbi-muted\">Complétez les calculs demandés en vous appuyant sur le document.</p>'}</section>`;\n}\nfunction mbSums(v){\n const num=s=>{const x=Number(String(s??'').replace(/[\\s\\u00a0\\u202f]/g,'').replace(',','.'));return Number.isFinite(x)?x:NaN};\n let debit=0,credit=0,invalid=false;\n for(const row of Array.isArray(v)?v:[]){for(const [j,key] of [[3,'debit'],[4,'credit']]){const raw=row?.[j];if(raw!==undefined&&raw!==null&&String(raw).trim()!==''){const n=num(raw);if(!Number.isFinite(n)||n<0)invalid=true;else if(key==='debit')debit+=n;else credit+=n;}}}\n return {debit,credit,invalid};\n}\nfunction mbJournal(e,q,v){\n const d=e.source_document||{};\n const values=Array.isArray(v)?v:[];\n const totals=mbSums(values);\n const names=['Débit','Crédit','Date / Intitulé des comptes','Débit (FDJ)','Crédit (FDJ)'];\n const rows=(q.rows||[]).map((label,i)=>`<tr>${names.map((name,j)=>`<td><input aria-label=\"${E('Ligne '+(i+1)+' — '+name)}\" inputmode=\"${j===2?'text':'decimal'}\" placeholder=\"${j===2?'Intitulé':j<2?'N°':'0'}\" data-i-field=\"cell:${i}:${j}\" value=\"${E(values?.[i]?.[j]||'')}\"></td>`).join('')}</tr>`).join('');\n return `<section class=\"mbi-journal\"><div class=\"mbi-journal-title\"><strong>Journal comptable · 5 colonnes</strong><small>Format des lycées de Djibouti</small></div><p class=\"mbi-muted\">Déplacez le tableau horizontalement si nécessaire.</p><div class=\"mbi-table-wrap mbi-journal-wrap\" dir=\"ltr\"><table class=\"mbi-table mbi-journal-table\"><thead><tr>${names.map(n=>`<th scope=\"col\">${E(n)}</th>`).join('')}</tr></thead><tbody><tr class=\"mbi-journal-date\"><td></td><td></td><td><strong>${E(d.date||'jj/mm/N')}</strong></td><td></td><td></td></tr>${rows}<tr class=\"mbi-journal-label\"><td colspan=\"5\">Libellé : ${E((d.type||'Facture')+' n° '+(d.number||'...'))}</td></tr></tbody></table></div><div id=\"mbi-journal-totals\" class=\"mbi-journal-totals\">Débit : ${E(mbMoney(totals.debit))} · Crédit : ${E(mbMoney(totals.credit))}</div>${B('verifyjournal','Contrôler mon journal',null,false)}${m.journalFeedback?`<p class=\"mbi-feedback\">${E(m.journalFeedback)}</p>`:''}<small class=\"mbi-muted\">L’équilibre ne suffit pas : le professeur vérifiera aussi les comptes et leurs montants.</small></section>`;\n}\nfunction mbJournalCorrect(e,q){\n const d=e?.source_document||{};\n const lines=String(q.answer||'').split('\\n').filter(Boolean).map(s=>s.split('|').map(x=>x.trim()));\n return `<div class=\"mbi-table-wrap mbi-journal-wrap\" dir=\"ltr\"><table class=\"mbi-table mbi-journal-table\"><thead><tr><th>Débit</th><th>Crédit</th><th>Date / Intitulé des comptes</th><th>Débit (FDJ)</th><th>Crédit (FDJ)</th></tr></thead><tbody><tr class=\"mbi-journal-date\"><td></td><td></td><td><strong>${E(d.date||'jj/mm/N')}</strong></td><td></td><td></td></tr>${lines.map(r=>`<tr>${[0,1,2,3,4].map(j=>`<td>${E(r[j]==='—'?'':r[j]||'')}</td>`).join('')}</tr>`).join('')}<tr class=\"mbi-journal-label\"><td colspan=\"5\">${E((d.type||'Facture')+' n° '+(d.number||'...'))}</td></tr></tbody></table></div>`;\n}\n// A table belongs to its own subject; the five-column journal is a special case.\nfunction mbIsJournal(q){const c=q?.columns||[];return c.length===5&&/d[ée]bit/i.test(c[0])&&/cr[ée]dit/i.test(c[1])&&/compte|intitul/i.test(c[2]);}\nfunction mbGenericTable(q,v,editable=false){\n const columns=Array.isArray(q.columns)?q.columns:[],rows=Array.isArray(q.rows)?q.rows:[];\n if(!columns.length||!rows.length)return `<p>${E('Tableau non renseigné.')}</p>`;\n return `<div class=\"mbi-table-wrap\" tabindex=\"0\" role=\"region\" aria-label=\"Tableau de l’exercice\"><table class=\"mbi-table\"><thead><tr><th scope=\"col\">Ligne</th>${columns.map(c=>`<th scope=\"col\" dir=\"auto\">${E(c)}</th>`).join('')}</tr></thead><tbody>${rows.map((r,i)=>`<tr><th scope=\"row\" dir=\"auto\">${E(r)}</th>${columns.map((c,j)=>`<td>${editable?`<input dir=\"auto\" aria-label=\"${E(r+' — '+c)}\" data-i-field=\"cell:${i}:${j}\" value=\"${E(v?.[i]?.[j]??'')}\">`:E(v?.[i]?.[j]??'')}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;\n}\nfunction mbTableCorrection(e,q){if(mbIsJournal(q))return mbJournalCorrect(e,q);const answer=String(q.answer??'');const matrix=answer.split('\\n').map(line=>line.split('|').map(s=>s.trim()));return matrix.length===q.rows?.length&&matrix.every(row=>row.length===q.columns?.length)?mbGenericTable(q,matrix):`<div class=\"mbi-answer\"><small>Réponse attendue</small><strong dir=\"auto\">${E(answer||'À apprécier par le professeur')}</strong></div>`;}\nfunction play(){\n const e=m.exercise,q=e.questions[m.index],v=m.answers[m.index];\n const guided=!!(e.source_document&&e.title.startsWith('Exercice guidé')&&q.type==='number');\n let control='';\n if(q.type==='choice'){\n   control=(q.options||[]).map((o,i)=>`<label class=\"mbi-choice ${o==='Vrai'?'mbi-true':o==='Faux'?'mbi-false':''}\"><input type=\"radio\" name=\"mbi-answer\" data-i-field=\"answer\" value=\"${E(o)}\" ${v===o?'checked':''}><span class=\"mbi-option-tag\">${'ABCD'[i]||'•'}</span><span>${E(o)}</span></label>`).join('');\n }else if(q.type==='table'){\n   control=mbIsJournal(q)?mbJournal(e,q,v):mbGenericTable(q,v,true);\n }else if(!guided){\n   control=field('Votre réponse',q.type==='number'?`<input type=\"text\" inputmode=\"decimal\" dir=\"ltr\" data-i-field=\"answer\" value=\"${E(v??'')}\" placeholder=\"${E(e.source_document?'Saisir le montant en FDJ':'Saisir la valeur numérique')}\">`:e.source_document||e.title.startsWith('Texte à trous')?input('answer',v??'','Saisir votre réponse','text'):`<textarea rows=\"4\" dir=\"auto\" data-i-field=\"answer\" placeholder=\"Rédigez votre réponse…\">${E(v??'')}</textarea>`);\n }\n const intro=(e.instructions||'').split('\\n\\n')[0];\n const sheet=e.source_document?(guided?mbSheet(e,true):`<details class=\"mbi-sheet-details\" ${q.type==='table'?'':'open'}><summary>Document commercial de l’exercice</summary>${mbSheet(e,false)}</details>`):'';\n const feedback=m.feedback?.[m.index];\n const hint=q.hint&&e.mode==='training'?`<details class=\"mbi-hint\"><summary>Voir un indice</summary><p>${E(q.hint)}</p></details>`:'';\n const verify=e.mode==='training'&&['text','choice','number'].includes(q.type)?B('check','Vérifier ma réponse'):''; \n return `<section class=\"mbi-exercise-head\"><small>${E(e.academic_level+' '+e.series)} · ${E(e.subject)}</small><h2>${E(e.title)}</h2></section>${progress(m.index+1,e.questions.length)}<div class=\"mbi-row\"><span class=\"mbi-muted\">Étape ${m.index+1} sur ${e.questions.length}</span>${badge(q.points+' points')}</div><section class=\"mbi-situation\"><strong>Situation</strong><p>${E(intro)}</p></section><section class=\"mbi-question\"><span class=\"mbi-question-number\">${m.index+1}</span><h2 data-mbl-original dir=\"auto\">${E(q.prompt)}</h2></section>${sheet}${control}${feedback?`<div class=\"mbi-feedback ${feedback.correct?'mbi-good':'mbi-warning'}\" role=\"status\">${E(feedback.feedback)}</div>`:''}${hint}${verify}${q.type==='number'?`<details class=\"mbi-notice\"><summary>Calculatrice</summary><div class=\"mbi-row\"><input data-i-field=\"calcA\" inputmode=\"decimal\" placeholder=\"Nombre\"><select data-i-field=\"calcOp\"><option>+</option><option>−</option><option>×</option><option>÷</option></select><input data-i-field=\"calcB\" inputmode=\"decimal\" placeholder=\"Nombre\">${B('calc','=')}</div><output id=\"mbi-calc\"></output></details>`:''}<small class=\"mbi-muted\">Progression sauvegardée sur cet appareil. ${e.mode==='exam'?'Aucun indice pendant le défi.':''}</small>`;\n}\nfunction detail(){\n const e=m.exercise,classes=e.target_class_names||[];\n return `<div class=\"mbi-intro\"><h2>${E(e.title)}</h2><p>${E(e.academic_level+' '+e.series+' · '+e.subject)}</p></div>${badge(e.status)}<section class=\"mbi-situation\"><strong>Consignes</strong><p>${E(e.instructions||'Aucune consigne supplémentaire.')}</p></section>${e.source_document?mbSheet(e,false):''}<section class=\"mbi-assign\"><h3>Destinataires</h3><p>${E(e.target_school||'Tous les établissements')} · ${E(classes.length?classes.join(', '):'Toutes les classes du niveau')}</p></section><small class=\"mbi-muted\">${e.questions.length} questions · ${e.questions.reduce((s,q)=>s+Number(q.points||0),0)} points</small>${e.questions.map((q,i)=>`<div class=\"mbi-item\"><span><strong>${i+1}. ${E(q.prompt)}</strong><small>${E(types[q.type])} · ${q.points} pt</small></span></div>`).join('')}${e.status==='published'?B('attempts','Copies des élèves',null,true):''}${e.status==='published'&&e.mode==='exam'?B('release',e.correction_released?'Masquer le corrigé':'Autoriser le corrigé'):''}`;\n}\nfunction result(){\n const r=m.result,e=m.exercise,grades=r.grades||[];\n const valid=grades.filter(x=>x!=null&&Number(x)>0).length,wrong=grades.filter(x=>x===0).length;\n const canRetry=e.mode==='training'&&r.status==='graded';\n const correction=e.mode==='training'||e.correction_released;\n return `<section class=\"mbi-result\"><span>${r.status==='review'?'Résultat provisoire':'Résultat de votre exercice'}</span><strong>${E(r.score)} / ${E(r.total)}</strong><p>${r.status==='review'?'Le journal ou des réponses rédigées attendent la correction de votre professeur.':'Votre travail a été corrigé.'}</p></section><div class=\"mbi-stats\"><div><strong>${valid}</strong><small>Réponses réussies</small></div><div><strong>${wrong}</strong><small>Réponses à améliorer</small></div><div><strong>${E(Math.round(100*Number(r.score)/Math.max(1,Number(r.total))))} %</strong><small>Points obtenus</small></div></div>${grades.map((g,i)=>`<div class=\"mbi-item\"><span><strong>Question ${i+1}</strong><small>${E(e.questions?.[i]?.prompt||'')}</small></span>${badge(g==null?'À vérifier':g+' / '+e.questions[i].points)}</div>`).join('')}${r.status==='graded'&&correction?B('correction','Revoir le corrigé',null,true):''}${r.status==='graded'&&!correction?'<div class=\"mbi-notice\">Le professeur communiquera le corrigé de cette évaluation.</div>':''}${B('history','Historique des tentatives')}${canRetry?B('retry','Refaire cet entraînement',null,true):''}`;\n}\nfunction correction(){\n const list=m.correction||[],e=m.exercise,r=m.result||{},grades=r.grades||[];\n return `<div class=\"mbi-intro\"><h2>Correction détaillée</h2><p>Examinez chaque question, sa réponse attendue et les conseils associés.</p></div>${list.map((q,i)=>`<section class=\"mbi-correct-card\"><div class=\"mbi-row\"><strong>Question ${i+1}</strong>${badge(grades[i]==null?'En attente':grades[i]+' / '+q.points)}</div><p>${E(q.prompt||'')}</p>${q.type==='table'?mbTableCorrection(e,q):`<div class=\"mbi-answer\"><small>Réponse attendue</small><strong>${E(q.answer||'À apprécier par le professeur')}</strong></div>`}${q.explanation||q.hint?`<p class=\"mbi-muted\">${E(q.explanation||q.hint)}</p>`:''}</section>`).join('')}`;\n}\nfunction history(){\n const h=m.history||[];\n return `<div class=\"mbi-intro\"><h2>Mes tentatives</h2><p>${E(m.exercise?.title||'')}</p></div>${h.length?h.map((v,i)=>`<div class=\"mbi-item\"><span><strong>Tentative ${h.length-i}</strong><small>${E(new Date(v.at).toLocaleString('fr-FR'))}</small></span><strong>${E(v.score)} / ${E(v.total)}</strong></div>`).join(''):'<div class=\"mbi-empty\">Aucune tentative enregistrée.</div>'}`;\n}\nfunction attempts(){return `<h2>Copies reçues</h2>${m.attempts.length?m.attempts.map(a=>`<button class=\"mbi-item\" ${A('review',a.id)}><span><strong>${E(a.full_name||'Élève')}</strong><small>${a.score}/${a.total} · ${E(status[a.status])}</small></span><span>›</span></button>`).join(''):'<div class=\"mbi-empty\">Aucune copie reçue.</div>'}`}\nfunction review(){\n const e=m.exercise,a=m.attempt,q=e.questions[m.index],v=a.answers[m.index];\n return `${progress(m.index+1,e.questions.length)}<h2>${E(a.full_name||'Élève')} · Question ${m.index+1}</h2><p>${E(q.prompt)}</p><section class=\"mbi-correct-card\"><strong>Travail de l’élève</strong>${q.type==='table'?(mbIsJournal(q)?mbReviewTable(e,q,v):mbGenericTable(q,v)):`<p>${E(v||'Sans réponse')}</p>`}</section><section class=\"mbi-correct-card\"><strong>Corrigé de référence</strong>${q.type==='table'?mbTableCorrection(e,q):`<p>${E(q.answer||'À apprécier')}</p>`}</section>${field('Note sur '+q.points,input('grade',m.grades[m.index]??'','0','number'))}`;\n}\nfunction draw(){if(!root)return;let content='',footer='';switch(m.page){case'list':content=list();break;case'edit':content=editor();footer=B('back',m.step===0?'Mes exercices':'‹ Retour')+(m.step<2?B('next','Continuer ›',null,true):B('save','Enregistrer',null,true));break;case'play':content=play();footer=B('playprev',m.index===0?'Quitter':'‹ Retour')+B(m.index===m.exercise.questions.length-1?'submit':'playnext',m.index===m.exercise.questions.length-1?'Envoyer':'Suivant ›',null,true);break;case'detail':content=detail();footer=B('list','‹ Retour')+(m.exercise.status==='draft'?B('edit','Modifier'):'')+(m.exercise.status==='draft'||m.exercise.status==='pending'&&st.role==='admin'?B('publish',st.role==='admin'?'Publier':'Soumettre',null,true):'')+(m.exercise.status==='pending'&&st.role==='admin'?B('return','Renvoyer'):'');break;case'result':content=result();footer=B('list','Mes exercices',null,true);break;case'correction':content=correction();footer=B('result','‹ Résultat',null,true);break;case'history':content=history();footer=B('result','‹ Résultat',null,true);break;case'attempts':content=attempts();footer=B('detail','‹ Retour');break;case'review':content=review();footer=B('rprev',m.index?'‹ Retour':'Copies')+B(m.index===m.exercise.questions.length-1?'grade':'rnext',m.index===m.exercise.questions.length-1?'Valider les notes':'Suivant ›',null,true);break;}\nroot.innerHTML=`<div class=\"mbi-shell\" data-page=\"${E(m.page)}\"><header class=\"mbi-header\"><button class=\"mbi-close\" ${A('close')} aria-label=\"Fermer\">‹</button><div><strong>Exercices interactifs</strong><small>monAvenir</small></div><span class=\"mbi-logo\">MB</span></header><main class=\"mbi-main\">${m.error?`<div class=\"mbi-error\" role=\"alert\">${E(m.error)}</div>`:''}${content}</main>${footer?`<footer class=\"mbi-footer\">${footer}</footer>`:''}</div>`;if(m.page==='play'&&m.deadline&&m.exercise?.time_limit_seconds){const e=document.createElement('div');e.id='mbi-timer';e.className='mbi-timer';e.setAttribute('role','timer');e.setAttribute('aria-live','off');root.querySelector('.mbi-main')?.prepend(e);tickCountdown()}if(busy)root.querySelectorAll('button').forEach(b=>b.disabled=true);}\nfunction tickCountdown(){if(!root||m.page!=='play'||!m.deadline||!m.exercise?.time_limit_seconds)return;const remaining=Math.max(0,Math.ceil((m.deadline-Date.now())/1000)),lang=window.MBLang?.get?.()||'fr',label=lang==='ar'?'الوقت المتبقي':lang==='en'?'Time remaining':'Temps restant';const el=root.querySelector('#mbi-timer');if(el){el.textContent='⏱ '+label+' : '+Math.floor(remaining/60).toString().padStart(2,'0')+':'+(remaining%60).toString().padStart(2,'0');el.dataset.expired=remaining===0?'yes':'no';}if(remaining===0&&!busy&&!m.timerAutoDone&&m.page==='play'){m.timerAutoDone=true;busy=true;call('submit',{id:m.exercise.id,answers:m.answers}).then(x=>{m.result=x;remove('attempt',m.exercise.id);m.page='result';m.error='';}).catch(err=>{m.error=err.message||'Temps écoulé';m.page='list';}).finally(()=>{busy=false;draw()});}}\nsetInterval(tickCountdown,1000);\nfunction change(ev){let k=ev.target.dataset.iField;if(!k)return;let v=ev.target.value;if(k==='filter'){m.filter=v;draw();return}if(k==='target_class_csv'){m.exercise.target_class_names=v.split(',').map(x=>x.trim()).filter(Boolean);persist();return}\nif(k.startsWith('group:')){const g=m.groups?.[Number(k.slice(6))];if(!g)return;let selected=Array.isArray(m.exercise.target_class_names)?m.exercise.target_class_names:[];if(ev.target.checked){if(String(m.exercise.target_school||'').toLowerCase()!==String(g.school).toLowerCase())selected=[];if(!selected.includes(g.name))selected.push(g.name);m.exercise.target_school=g.school}else{selected=selected.filter(x=>x!==g.name)}m.exercise.target_class_names=selected;persist();return}\nif(k==='specialty'){Object.assign(m.exercise,m.specialties[Number(v)]);persist();return}if(k.startsWith('q.')){let q=m.exercise.questions[m.index],p=k.slice(2);q[p]=['options','columns','rows'].includes(p)?v.split('\\n'):p==='points'?v:v;if(p==='type'){q.answer='';if(v==='choice')q.options=['',''];draw()}persist();return}if(k==='answer'){m.answers[m.index]=v;if(m.feedback)delete m.feedback[m.index];persist();return}if(k.startsWith('cell:')){let [,i,j]=k.split(':').map((x,n)=>n?Number(x):x);let q=m.exercise.questions[m.index];if(!Array.isArray(m.answers[m.index]))m.answers[m.index]=q.rows.map(()=>q.columns.map(()=>''));m.answers[m.index][i][j]=v;m.journalFeedback='';persist();const totals=root?.querySelector('#mbi-journal-totals');if(totals){const sums=mbSums(m.answers[m.index]);totals.textContent='Débit : '+mbMoney(sums.debit)+' · Crédit : '+mbMoney(sums.credit)}return}if(k==='grade'){m.grades[m.index]=v===''?null:Number(v);return}if(k.startsWith('calc'))return;if(m.page==='edit'){m.exercise[k]=v;persist()}}\nfunction validQuestion(q){if(!q.prompt.trim()||!(Number(q.points)>0&&Number(q.points)<=100))throw Error('Complétez l’énoncé et le barème.');if(q.type==='number'&&!/^[+-]?\\d+(\\.\\d+)?$/.test(String(q.answer).replace(',','.')))throw Error('Saisissez une réponse numérique valide.');if(q.type==='choice'){q.options=q.options.map(x=>x.trim()).filter(Boolean);q.answer=q.answer.trim();if(q.options.length<2||!q.options.includes(q.answer))throw Error('Ajoutez au moins deux choix et une bonne réponse identique à un choix.')}if(q.type==='table'){q.columns=q.columns.map(x=>x.trim()).filter(Boolean);q.rows=q.rows.map(x=>x.trim()).filter(Boolean);if(!q.columns.length||!q.rows.length)throw Error('Complétez les colonnes et lignes du tableau.')}q.points=Number(q.points);if(q.type==='number')q.answer=String(q.answer).replace(',','.');}\nasync function click(ev){const btn=ev.target.closest('[data-i-act]');if(!btn||busy)return;let a=btn.dataset.iAct,v=btn.dataset.iValue;m.error='';if(a==='close'){close();return}if(a==='calc'){let get=k=>root.querySelector(`[data-i-field=\"${k}\"]`).value;let x=Number(get('calcA').replace(',','.')),y=Number(get('calcB').replace(',','.')),op=get('calcOp');let res=op==='+'?x+y:op==='−'?x-y:op==='×'?x*y:x/y;root.querySelector('#mbi-calc').textContent=Number.isFinite(res)?String(res):'Calcul impossible';return}busy=true;try{switch(a){case'list':await reload();break;\ncase 'kind':m.kind=v||'';break;\ncase 'check':{\n if(m.exercise.mode!=='training')throw Error('Vérification indisponible pendant un défi.');\n const ans=m.answers?.[m.index];\n if(ans==null||String(ans).trim()==='')throw Error('Saisissez votre réponse avant de vérifier.');\n const verdict=await call('check',{id:m.exercise.id,index:m.index,answer:ans});\n (m.feedback||(m.feedback={}))[m.index]=verdict;\n break;\n}\ncase 'verifyjournal':{\n const rows=m.answers?.[m.index];\n const totals=mbSums(rows);\n const count=m.exercise.questions[m.index].rows.length;\n const filled=Array.isArray(rows)&&rows.length===count&&rows.every(row=>Array.isArray(row)&&(String(row[0]||'').trim()||String(row[1]||'').trim())&&String(row[2]||'').trim()&&(String(row[3]||'').trim()||String(row[4]||'').trim()));\n const mixed=Array.isArray(rows)&&rows.some(row=>String(row?.[0]||'').trim()&&String(row?.[1]||'').trim());\n if(!filled)m.journalFeedback='Complétez les comptes, les intitulés et les montants.';\n else if(mixed)m.journalFeedback='Un compte doit être placé soit au débit, soit au crédit.';\n else if(totals.invalid)m.journalFeedback='Utilisez des montants numériques positifs ou nuls.';\n else if(totals.debit<=0||Math.abs(totals.debit-totals.credit)>0.000001)m.journalFeedback='Le journal n’est pas équilibré : vérifiez les totaux.';\n else m.journalFeedback='Les totaux sont égaux. Le professeur doit encore vérifier les comptes et les montants.';\n break;\n}\ncase 'correction':m.correction=await call('correction',{id:m.exercise.id});m.page='correction';break;\ncase 'history':m.history=await call('history',{id:m.exercise.id});m.page='history';break;\ncase 'result':m.page='result';break;\ncase 'retry':{\n if(m.exercise.mode!=='training'||m.result?.status!=='graded')throw Error('Attendez la correction avant de refaire l’exercice.');\n m.exercise=await call('open',{id:m.exercise.id});\n m.answers=m.exercise.questions.map(()=>null);\n m.index=0;m.feedback={};m.journalFeedback='';\n remove('attempt',m.exercise.id);m.result=null;m.page='play';break;\n}\ncase 'release':{\n if(!teacher()||m.exercise.mode!=='exam')throw Error('Action réservée à l’enseignant.');\n await call('release',{id:m.exercise.id,release:!m.exercise.correction_released});\n m.exercise=await call('open',{id:m.exercise.id});\n m.page='detail';break;\n}\ncase'new':{if(st.role==='enseignant'&&!m.specialties.length)throw Error('Aucune matière approuvée. Contactez l’administration.');let old=read('editor','new');m.exercise=old?.exercise||{title:'',series:'GFM',academic_level:'Terminale',subject:'',instructions:'',mode:'training',questions:[newQuestion()],...(m.specialties[0]||{})};m.step=old?.step||0;m.index=old?.index||0;m.page='edit';break}case'open':{m.exercise=await call('open',{id:v});if(teacher()){m.page='detail'}else{if(m.rows.find(x=>x.id===v)?.attempt){m.result=await call('result',{id:v});m.page='result'}else{let draft=read('attempt',v);m.answers=draft?.answers||m.exercise.questions.map(()=>null);m.index=Math.min(draft?.index||0,m.exercise.questions.length-1);if(m.exercise.time_limit_seconds){const started=await call('start',{id:v});m.deadline=Date.parse(started.deadline);m.timerAutoDone=false;}m.page='play'}}break}case'edit':{let d=read('editor',m.exercise.id);if(d)m.exercise=d.exercise;m.step=d?.step||0;m.index=d?.index||0;m.page='edit';break}case'back':if(m.step>0)m.step--;else{persist();await reload()}break;case'next':if(m.step===0&&(!m.exercise.title.trim()||!m.exercise.subject.trim()))throw Error('Indiquez le titre et la matière.');if(m.step===1)m.exercise.questions.forEach(validQuestion);m.step++;break;case'editq':m.index=Number(v);m.step=1;break;case'qprev':m.index=Math.max(0,m.index-1);break;case'qnext':m.index=Math.min(m.exercise.questions.length-1,m.index+1);break;case'add':validQuestion(m.exercise.questions[m.index]);if(m.exercise.questions.length>=50)throw Error('50 questions maximum.');m.exercise.questions.push(newQuestion());m.index=m.exercise.questions.length-1;break;case'deleteq':m.exercise.questions.splice(m.index,1);m.index=Math.max(0,m.index-1);break;case'template':{let q=m.exercise.questions[m.index];if(v==='invoice'){q.columns=['Montant (FDJ)'];q.rows=['Montant brut HT','Remise','Net commercial HT','Escompte','Net financier HT','TVA','Net à payer TTC']}else{q.columns=['Débit (compte)','Crédit (compte)','Date / intitulé','Débit (FDJ)','Crédit (FDJ)'];q.rows=['Écriture 1','Écriture 2','Écriture 3','Écriture 4']};break}case'save':{m.exercise.questions.forEach(validQuestion);let old=m.exercise.id||'new';let r=await call('save',m.exercise);remove('editor',old);m.exercise=await call('open',{id:r.id});m.page='detail';break}case'publish':if(!confirm(st.role==='admin'?'Publier pour cette série et ce niveau ?':'Envoyer à l’administrateur pour validation ?'))break;await call('publish',{id:m.exercise.id});await reload();break;case'return':await call('return',{id:m.exercise.id});await reload();break;case'playprev':if(m.index>0)m.index--;else{persist();await reload()}break;case'playnext':m.index++;break;case'submit':if(!confirm('Envoyer définitivement votre copie ?'))break;m.result=await call('submit',{id:m.exercise.id,answers:m.answers});remove('attempt',m.exercise.id);m.page='result';break;case'attempts':m.attempts=await call('attempts',{id:m.exercise.id});m.page='attempts';break;case'detail':m.page='detail';break;case'review':m.attempt=m.attempts.find(x=>x.id===v);m.grades=[...m.attempt.grades];m.index=0;m.page='review';break;case'rprev':if(m.index>0)m.index--;else m.page='attempts';break;case'rnext':if(m.grades[m.index]==null)throw Error('Indiquez une note.');m.index++;break;case'grade':if(m.grades.some((g,i)=>g==null||!Number.isFinite(g)||g<0||g>Number(m.exercise.questions[i].points)))throw Error('Vérifiez toutes les notes et les barèmes.');await call('grade',{id:m.exercise.id,attempt_id:m.attempt.id,grades:m.grades});m.attempts=await call('attempts',{id:m.exercise.id});m.page='attempts';break;}persist()}catch(e){m.error=e.message||'Une erreur est survenue. Réessayez.'}finally{busy=false;draw()}}\nfunction mount(){if(st.role==='eleve'){document.querySelectorAll('#app [data-mbi-launch]').forEach(el=>el.remove());return}if(root&&st.user?.id!==uid){close();return}if(!st.user||!['eleve','enseignant','admin'].includes(st.role)||!['student-home','teacher-home','admin-home'].includes(st.screen)||st.role==='enseignant'&&st.teacher?.status!=='approved')return;let tiles=document.querySelector('#app .mb-tiles');if(!tiles||tiles.querySelector('[data-mbi-launch]'))return;let b=document.createElement('button');b.type='button';b.className='mb-tile mbi-launch';b.dataset.mbiLaunch='1';b.innerHTML='<span class=\"mbi-launch-icon\" aria-hidden=\"true\">✎</span><span>Exercices interactifs</span>';b.addEventListener('click',show);tiles.prepend(b)}\n// Preserve existing wizard state while importing documents and illustrations.\nconst originalDraw=draw;\nfunction importImage(q,host,editable){if(!q?.image||!/^data:image\\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(q.image))return;const box=document.createElement('div');box.className='mbi-import-image';const img=document.createElement('img');img.src=q.image;img.alt='Document de la question';img.loading='lazy';box.append(img);const link=document.createElement('button');link.className='mbi-button';link.type='button';link.textContent='Agrandir le document';link.onclick=()=>{const d=document.createElement('dialog');d.className='mbi-image-dialog';const big=img.cloneNode();const b=document.createElement('button');b.type='button';b.className='mbi-button';b.textContent='Fermer';b.onclick=()=>d.close();d.append(b,big);document.body.append(d);d.addEventListener('close',()=>d.remove(),{once:true});d.showModal()};box.append(link);if(editable){const b=document.createElement('button');b.type='button';b.className='mbi-button';b.textContent='Retirer l’image';b.onclick=()=>{delete q.image;persist();draw()};box.append(b)}host.after(box)}\ndraw=function(){originalDraw();if(!root||!window.MBIImport)return;const main=root.querySelector('.mbi-main');if(!main)return;const e=m.exercise,q=e?.questions?.[m.index];if(m.page==='edit'&&(m.step===0||m.step===1)){const stage=m.step;const field=main.querySelector(stage===0?'[data-i-field=\"instructions\"]':'[data-i-field=\"q.prompt\"]');if(!field)return;const container=document.createElement('div');container.innerHTML=MBIImport.panel(stage);const panel=container.firstElementChild;field.closest('label').before(panel);MBIImport.attach(root,stage,{text(t){t=t.trim();const limit=stage===0?30000:5000;if(t.length>limit)throw Error('Le texte dépasse '+limit+' caractères. Réduisez l’aperçu avant de l’insérer.');const previous=stage===0?e.instructions:q.prompt;if(previous&&previous.trim()&&!confirm('Remplacer le texte actuel par le document importé ?'))return;if(stage===0)e.instructions=t;else q.prompt=t;persist();draw()},questions(list){const existing=e.questions.filter(x=>x.prompt.trim());if(existing.length+list.length>50)throw Error('Maximum 50 questions.');e.questions=[...existing,...list.map(prompt=>({...newQuestion(),prompt}))];m.step=1;m.index=existing.length;persist();draw()},correction(t){if(!q)throw Error('Aucune question sélectionnée.');if(t.length>20000)throw Error('Corrigé trop long.');if(q.answer&&!confirm('Remplacer le corrigé actuel ?'))return;q.answer=t.trim();persist();draw()},image(data){if(q.image&&!confirm('Remplacer l’illustration actuelle ?'))return;q.image=data;persist();draw()}});if(stage===1)importImage(q,panel,true)}else if(m.page==='play'||m.page==='review'){const anchor=main.querySelector('h2');if(anchor)importImage(q,anchor,false)}};\n\n// Optional teacher-controlled AI: private, bounded, and no automatic grading.\nconst drawBeforeAI=draw;\ndraw=function(){\n drawBeforeAI();\n if(!root||m.page!=='review'||!teacher())return;\n const q=m.exercise?.questions?.[m.index],answer=m.attempt?.answers?.[m.index],grade=root.querySelector('[data-i-field=\"grade\"]');\n if(!q||q.type!=='text'||!grade||q.image||!String(q.answer||'').trim()||typeof answer!=='string'||!answer.trim()||[q.prompt,q.answer,answer].some(x=>String(x).length>1400))return;\n const languageCode=(document.documentElement.lang||'fr').toLowerCase().slice(0,2), tr=(fr,en,ar)=>languageCode==='ar'?ar:languageCode==='en'?en:fr;\n const state=m,sessionUid=uid,idx=m.index,attempt=m.attempt.id,exercise=m.exercise.id,key=attempt+':'+idx;\n const cache=state.aiResults||(state.aiResults={});\n const box=document.createElement('section');box.className='mbi-ai';box.dir=languageCode==='ar'?'rtl':'ltr';\n const label=document.createElement('div');label.className='mbi-ai-heading';label.textContent=tr('✦ Correction assistée par IA','✦ AI-assisted grading','✦ التصحيح بمساعدة الذكاء الاصطناعي');\n const small=document.createElement('small');small.textContent=tr('Suggestion uniquement. Vous gardez la décision finale.','Suggestion only. You make the final decision.','اقتراح فقط. القرار النهائي لك.');\n const statusEl=document.createElement('div');statusEl.setAttribute('aria-live','polite');statusEl.className='mbi-ai-status';\n const button=document.createElement('button');button.type='button';button.className='mbi-button mbi-ai-action';button.textContent=tr('Analyser la réponse','Analyze answer','تحليل الإجابة');\n const result=document.createElement('div');result.className='mbi-ai-result';result.hidden=true;\n box.append(label,small,button,statusEl,result);grade.closest('label').before(box);\n const current=()=>root&&m===state&&uid===sessionUid&&st.user?.id===sessionUid&&m.page==='review'&&m.attempt?.id===attempt&&m.index===idx;\n function render(value){\n  result.replaceChildren();result.hidden=false;button.hidden=true;statusEl.textContent='';button.disabled=false;\n  const heading=document.createElement('strong');heading.textContent=tr('Note proposée : ','Suggested mark: ','الدرجة المقترحة: ')+value.score+' / '+value.points;\n  const reason=document.createElement('p');reason.textContent=value.explanation;\n  const lang=document.createElement('p');const title=document.createElement('strong');title.textContent=tr('Orthographe et grammaire : ','Spelling and grammar: ','الإملاء والنحو: ');lang.append(title,document.createTextNode(value.language));\n  const apply=document.createElement('button');apply.type='button';apply.className='mbi-button mbi-primary';apply.textContent=tr('Utiliser cette note','Use this mark','استخدام هذه الدرجة');\n  apply.onclick=()=>{if(!current())return;const field=root.querySelector('[data-i-field=\"grade\"]');if(!field)return;m.grades[idx]=value.score;field.value=String(value.score);statusEl.textContent=tr('Note proposée reportée. Validez la copie à la fin.','Suggested mark entered. Validate the submission at the end.','تم إدخال الدرجة المقترحة. اعتمد التصحيح في النهاية.')};\n  const quota=document.createElement('small');quota.textContent=Number.isInteger(value.remaining)?tr('Analyses restantes aujourd’hui : ','Analyses remaining today: ','التحليلات المتبقية اليوم: ')+value.remaining:'';\n  result.append(heading,reason,lang,apply,quota);\n }\n if(cache[key]?.data){render(cache[key].data);return}\n if(cache[key]?.pending){button.disabled=true;statusEl.textContent=tr('Analyse en cours…','Analyzing…','جارٍ التحليل…')}\n button.onclick=async()=>{\n   if(!current()||busy||cache[key]?.pending)return;\n   if(!confirm(tr('Seuls l’énoncé, le corrigé et la réponse seront analysés par Cloudflare. Vérifiez qu’ils ne contiennent aucune information personnelle ou sensible. Continuer ?','Cloudflare will analyze only the question, expected answer and student answer. Confirm they contain no personal or sensitive information. Continue?','سيحلل Cloudflare السؤال والإجابة النموذجية وإجابة الطالب فقط. تأكد من خلوها من المعلومات الشخصية أو الحساسة. هل تريد المتابعة؟')))return;\n   cache[key]={pending:true};button.disabled=true;statusEl.textContent=tr('Analyse en cours…','Analyzing…','جارٍ التحليل…');\n   try{\n    const {data,error}=await st.db.auth.getSession();if(error||!data?.session?.access_token)throw Error(tr('Reconnectez-vous pour continuer.','Sign in again to continue.','سجّل الدخول مجددًا للمتابعة.'));\n    if(!current())throw Error(tr('Correction interrompue.','Grading interrupted.','تم إيقاف التصحيح.'));\n    const response=await fetch('/api/interactive-ai',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+data.session.access_token},body:JSON.stringify({exercise,attempt,index:idx})});\n    const value=await response.json();if(!response.ok)throw Error((languageCode==='fr'&&value.error)|| (response.status===429?tr('Quota gratuit atteint.','Free daily quota reached.','تم بلوغ الحد المجاني اليومي.'):tr('IA momentanément indisponible.','AI is temporarily unavailable.','الذكاء الاصطناعي غير متاح مؤقتًا.')) ||tr('IA momentanément indisponible.','AI is temporarily unavailable.','الذكاء الاصطناعي غير متاح مؤقتًا.'));\n    cache[key]={data:value};if(current())draw();\n   }catch(err){delete cache[key];if(current()){const live=root.querySelector('.mbi-ai-status');const b=root.querySelector('.mbi-ai-action');if(live)live.textContent=err.message||tr('Correction manuelle disponible.','Manual grading is available.','التصحيح اليدوي متاح.');if(b)b.disabled=false}}\n };\n};\n\nconst observer=new MutationObserver(()=>mount());observer.observe(document.getElementById('app')||document.body,{childList:true,subtree:true});mount();\nwindow.MonBacInteractive={\n open:show,\n openExercise:async function(id){\n   await show();\n   if(!root)throw Error('Impossible d’ouvrir les exercices interactifs.');\n   const button=Array.from(root.querySelectorAll('button[data-i-act=\"open\"]')).find(el=>el.dataset.iValue===String(id));\n   if(!button){close();throw Error('Cet exercice ne figure pas dans votre liste autorisée.');}\n   button.click();\n }\n};\n\n})();\n\n"],"/mon-bac-focus-20261119.css":["text/css; charset=utf-8",false,"/* monAvenir — espace de concentration, toutes matières. */\n#mbi-root{--mb-bg:#F8F7F4;--mb-ink:#24313F;--mb-blue:#E8F0FB;--mb-sage:#E5F3E8;--mb-amber:#FFF1D7;--mb-lavender:#EEE5FA;--mb-brand:#B80B38;--mb-line:#dce3e8;background:var(--mb-bg);color:var(--mb-ink);font-size:16px}\n#mbi-root .mbi-shell{max-width:880px;width:100%;height:100%;height:100dvh;min-width:0;background:var(--mb-bg)}\n#mbi-root .mbi-header{background:#fff;color:var(--mb-ink);border-bottom:1px solid var(--mb-line);padding:12px clamp(14px,4vw,30px);padding-top:max(12px,env(safe-area-inset-top));min-height:64px}\n#mbi-root .mbi-header strong{font-size:18px;line-height:1.3;overflow-wrap:anywhere}\n#mbi-root .mbi-header small{font-size:12px;color:#526577;opacity:1}\n#mbi-root .mbi-close,#mbi-root .mbi-logo{background:var(--mb-blue);color:#28486a;border:0;border-radius:12px}\n#mbi-root .mbi-main{padding:clamp(16px,4vw,32px);gap:clamp(12px,2vw,20px);overflow-x:hidden;min-width:0;scroll-padding:16px;scrollbar-width:thin}\n#mbi-root .mbi-main>*{min-width:0;max-width:100%;flex-shrink:0}\n#mbi-root h2,#mbi-root .mbi-intro h2{color:var(--mb-ink);font-size:clamp(21px,3vw,28px);line-height:1.35;letter-spacing:-.3px}\n#mbi-root p,#mbi-root .mbi-intro p,#mbi-root .mbi-situation p,#mbi-root .mbi-correct-card p{font-size:15px;line-height:1.65;color:#394c5e;overflow-wrap:anywhere}\n#mbi-root .mbi-muted,#mbi-root .mbi-item small{color:#536577;font-size:13px;line-height:1.45}\n#mbi-root .mbi-item,#mbi-root .mbi-situation,#mbi-root .mbi-question,#mbi-root .mbi-journal,#mbi-root .mbi-assign,#mbi-root .mbi-correct-card,#mbi-root .mbi-sheet{border:1px solid var(--mb-line);border-radius:16px;box-shadow:none;background:#fff}\n#mbi-root .mbi-item{padding:16px;min-height:62px;gap:12px;align-items:center;line-height:1.4}\n#mbi-root .mbi-item strong{font-size:16px;color:var(--mb-ink);overflow-wrap:anywhere}\n#mbi-root .mbi-arrow{color:#375e85}\n#mbi-root .mbi-category-chips{flex-wrap:wrap;overflow:visible;gap:8px;padding:0}\n#mbi-root .mbi-chip{white-space:normal;min-width:0;min-height:44px;font-size:13px;color:#344b63;border-color:#d9e4f2;padding:9px 12px}\n#mbi-root .mbi-chip.is-active{background:#D7E7FA;color:#234a73;border-color:#92b3d7}\n#mbi-root .mbi-overview,#mbi-root .mbi-result{background:var(--mb-sage);border:1px solid #c3ddc9;border-radius:16px;padding:18px;box-shadow:none;color:#254c35}\n#mbi-root .mbi-overview .mbi-row strong,#mbi-root .mbi-overview-numbers strong,#mbi-root .mbi-result strong,#mbi-root .mbi-stats strong{color:#28613f}\n#mbi-root .mbi-overview-numbers,#mbi-root .mbi-stats{gap:8px}\n#mbi-root .mbi-overview-numbers>div,#mbi-root .mbi-stats>div{background:#fff;border:1px solid #d8e6da;padding:13px 6px;border-radius:12px;min-width:0;overflow-wrap:anywhere}\n#mbi-root .mbi-overview-numbers small,#mbi-root .mbi-stats small{font-size:12px;color:#486050;line-height:1.4}\n#mbi-root .mbi-review-suggestions summary,#mbi-root .mbi-suggestion span{color:#28613f}\n#mbi-root .mbi-exercise-head small{font-size:13px;font-weight:700;color:#416181;line-height:1.5}\n#mbi-root .mbi-exercise-head h2{font-size:clamp(20px,3.5vw,27px);line-height:1.35}\n#mbi-root .mbi-progress{height:9px;background:#e1e7e3;border-radius:12px;flex:none}\n#mbi-root .mbi-progress i{background:#3b8960;border-radius:12px}\n#mbi-root .mbi-situation{background:var(--mb-blue);border-color:#d0e1f4;padding:16px}\n#mbi-root .mbi-situation strong{color:#2b5076;font-size:14px}\n#mbi-root .mbi-question{padding:18px;align-items:flex-start;gap:12px}\n#mbi-root .mbi-question-number{width:34px;height:34px;background:var(--mb-blue);color:#234e78;flex:none;font-size:16px;border-radius:11px}\n#mbi-root .mbi-question h2{font-size:clamp(18px,3vw,23px);line-height:1.5;min-width:0;color:var(--mb-ink);overflow-wrap:anywhere}\n#mbi-root .mbi-badge{background:var(--mb-blue);color:#244b72;font-size:12px;padding:6px 10px;max-width:min(48%,180px);line-height:1.3}\n#mbi-root .mbi-field{font-size:14px;color:var(--mb-ink);gap:8px;min-width:0}\n#mbi-root input:not([type=radio]):not([type=checkbox]),#mbi-root textarea,#mbi-root select{background:#fff;border:1px solid #a9bccc;border-radius:12px;min-height:48px;padding:12px;color:var(--mb-ink);font-size:16px;line-height:1.5}\n#mbi-root textarea{min-height:120px;max-height:none;resize:vertical}\n#mbi-root .mbi-choice{background:#fff;border:1px solid #cbd8e4;border-radius:14px;padding:14px;min-height:56px;gap:10px;line-height:1.5;cursor:pointer}\n#mbi-root .mbi-choice span:last-child{min-width:0;overflow-wrap:anywhere}\n#mbi-root .mbi-choice input,#mbi-root .mbi-group-choice input{accent-color:#356c9b;flex:none}\n#mbi-root .mbi-option-tag{background:var(--mb-blue);color:#31587d;flex:none}\n#mbi-root .mbi-choice:has(input:checked),#mbi-root .mbi-choice.mbi-true:has(input:checked),#mbi-root .mbi-choice.mbi-false:has(input:checked){background:var(--mb-blue);border-color:#527fa8;color:#24313f}\n#mbi-root .mbi-hint{background:var(--mb-amber);border:1px solid #ead4a3;padding:14px;border-radius:14px}\n#mbi-root .mbi-hint summary{color:#704a0b}\n#mbi-root .mbi-notice,#mbi-root .mbi-empty,#mbi-root .mbi-answer{background:#eef3f8;border:1px solid #d6e2ed;padding:14px;border-radius:14px;color:#314e6a}\n#mbi-root .mbi-answer strong{color:#264966}\n#mbi-root .mbi-ai{background:var(--mb-lavender);border-color:#d6c7ec;padding:15px}\n#mbi-root .mbi-feedback.mbi-good{background:var(--mb-sage);color:#285c39;border-color:#badbc3;padding:14px}\n#mbi-root .mbi-feedback.mbi-warning{background:var(--mb-amber);color:#714e17;border-color:#e7c98c;padding:14px}\n#mbi-root .mbi-error{background:#fff1f3;color:#8c1733;border:1px solid #efc6d0}\n#mbi-root .mbi-assign h3,#mbi-root .mbi-sheet-head small,#mbi-root .mbi-journal-title strong{color:#355b80}\n#mbi-root .mbi-sheet-tag,#mbi-root .mbi-sheet-calc .mbi-sheet-active th,#mbi-root .mbi-journal-date td{background:var(--mb-blue);color:#29486b}\n#mbi-root .mbi-journal-table th{background:#355675!important;color:white!important}\n#mbi-root .mbi-table-wrap{width:100%;max-width:100%;min-width:0;overflow-x:auto;overscroll-behavior-inline:contain;background:#fff;border:1px solid var(--mb-line);border-radius:12px;scrollbar-width:thin}\n#mbi-root .mbi-table th,#mbi-root .mbi-table td{padding:9px;border-color:#dce3e8;line-height:1.45;overflow-wrap:anywhere}\n#mbi-root .mbi-table th{background:#edf2f7;color:#28496b}\n#mbi-root .mbi-table input:not([type=radio]){min-height:44px;padding:8px;font-size:16px}\n#mbi-root .mbi-timer{background:var(--mb-blue);color:#244b72;border-color:#cadcf0;margin:0}\n#mbi-root .mbi-timer[data-expired=yes]{background:var(--mb-amber);color:#714e17;border-color:#e7c98c}\n#mbi-root .mbi-footer{position:relative;flex-wrap:wrap;gap:10px;padding:12px clamp(14px,4vw,30px) max(12px,env(safe-area-inset-bottom));background:#fff;border-top:1px solid var(--mb-line);box-shadow:none;min-width:0}\n#mbi-root .mbi-button{min-height:48px;border:1px solid #b9c9d9;background:#fff;color:#294968;font-size:15px;font-weight:700;border-radius:12px;padding:11px 15px;line-height:1.35;overflow-wrap:anywhere;white-space:normal}\n#mbi-root .mbi-primary{background:var(--mb-brand);border-color:var(--mb-brand);color:#fff}\n#mbi-root .mbi-footer .mbi-button{flex:1 1 112px;min-width:0;max-width:100%}\n#mbi-root button:focus-visible,#mbi-root input:focus-visible,#mbi-root select:focus-visible,#mbi-root textarea:focus-visible,#mbi-root summary:focus-visible{outline:3px solid #356c9b;outline-offset:2px}\n#mbi-root .mbi-import-image img{display:block;max-width:100%;height:auto;object-fit:contain}\n#mbi-root .mbi-import{background:var(--mb-blue);border-color:#d0e1f4}\n#mbi-root .mbi-import summary{color:#31587d}\n.lr-native-interactive{border-color:#dce3e8!important;box-shadow:none!important}\n.lr-native-interactive>.lr-symbol{background:#E8F0FB!important;color:#31587d!important}\n.lr-native-interactive>.btn{background:#B80B38!important;color:#fff!important;min-height:48px;white-space:normal;overflow-wrap:anywhere}\n@media(min-width:900px){#mbi-root .mbi-shell{height:calc(100dvh - 32px);margin:16px 0;border-radius:20px;overflow:hidden;box-shadow:0 8px 40px #24313f14}}\n@media(max-width:420px){#mbi-root .mbi-main{padding:14px;gap:13px}#mbi-root .mbi-question,#mbi-root .mbi-situation{padding:14px}#mbi-root .mbi-activity{padding:13px}#mbi-root .mbi-footer{padding-inline:12px}#mbi-root .mbi-button{padding:10px 11px;font-size:14px}#mbi-root .mbi-overview-numbers small,#mbi-root .mbi-stats small{font-size:11px}}\n@media(max-height:480px){#mbi-root .mbi-header{min-height:48px;padding-block:5px}#mbi-root .mbi-main{padding-block:10px;gap:9px}#mbi-root .mbi-footer{padding-block:6px}#mbi-root .mbi-button{min-height:44px}}\n@media(prefers-reduced-motion:reduce){#mbi-root *,#mbi-root *::before,#mbi-root *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\n"],"/mon-bac-interactive-quality-20261119.js":["text/javascript; charset=utf-8",false,"/* monAvenir — exercices interactifs, avec correction IA facultative et quota gratuit. */\n(()=>{'use strict';\nconst E=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst A=(name,value)=>`data-i-act=\"${name}\"${value==null?'':` data-i-value=\"${E(value)}\"`}`;\nconst B=(name,label,value,primary=false)=>`<button type=\"button\" class=\"mbi-button ${primary?'mbi-primary':''}\" ${A(name,value)}>${E(label)}</button>`;\nconst select=(key,values,current)=>`<select data-i-field=\"${key}\">${values.map(v=>`<option ${String(v)===String(current)?'selected':''}>${E(v)}</option>`).join('')}</select>`;\nconst field=(label,html)=>`<label class=\"mbi-field\"><span>${E(label)}</span>${html}</label>`;\nconst input=(key,value,placeholder='',type='text')=>`<input type=\"${type}\" data-i-field=\"${key}\" value=\"${E(value)}\" placeholder=\"${E(placeholder)}\">`;\nconst area=(key,value,placeholder='')=>`<textarea rows=\"3\" lang=\"fr\" spellcheck=\"true\" autocorrect=\"on\" autocapitalize=\"sentences\" data-i-field=\"${key}\" placeholder=\"${E(placeholder)}\">${E(value)}</textarea>`;\nconst newQuestion=()=>({type:'text',prompt:'',points:1,answer:'',hint:'',explanation:'',options:['',''],columns:['Libellé','Montant'],rows:['Ligne 1']});\nconst types={text:'Réponse rédigée',number:'Calcul / nombre',choice:'QCM (un choix)',table:'Tableau à compléter'};\nconst status={draft:'Brouillon',pending:'À valider',published:'Publié',review:'À corriger',graded:'Corrigé'};\nlet m={};let root=null;let uid=null;let previousFocus=null;let busy=false;\nconst teacher=()=>st.role==='enseignant'||st.role==='admin';\nconst call=async(action,data={})=>{if(st.user?.id!==uid)throw Error('Reconnectez-vous.');const r=await st.db.rpc('mon_bac_interactive',{p_action:action,p_data:data});if(r.error)throw Error(r.error.message);return r.data;};\nconst key=(kind,id='new')=>`monbac-interactive:${uid}:${kind}:${id}`;\nconst read=(kind,id)=>{try{return JSON.parse(localStorage.getItem(key(kind,id))||'null')}catch{return null}};\nconst write=(kind,id,value)=>{try{localStorage.setItem(key(kind,id),JSON.stringify(value))}catch{}};\nconst remove=(kind,id)=>{try{localStorage.removeItem(key(kind,id))}catch{}};\nconst persist=()=>{if(m.page==='edit')write('editor',m.exercise.id||'new',{exercise:m.exercise,step:m.step,index:m.index});if(m.page==='play')write('attempt',m.exercise.id,{answers:m.answers,index:m.index});};\nconst close=()=>{persist();root?.remove();root=null;document.documentElement.classList.remove('mbi-open');previousFocus?.focus?.();};\nconst show=async()=>{if(root)return;uid=st.user?.id;if(!uid)return;previousFocus=document.activeElement;m={page:'list',rows:[],loading:true,filter:''};root=document.createElement('div');root.id='mbi-root';root.setAttribute('role','dialog');root.setAttribute('aria-modal','true');root.setAttribute('aria-label','Exercices interactifs');document.body.append(root);document.documentElement.classList.add('mbi-open');root.addEventListener('click',click);root.addEventListener('input',change);root.addEventListener('change',change);root.addEventListener('keydown',ev=>{if(ev.key==='Escape'&&!busy)close()});draw();await reload();};\nasync function reload(){m.page='list';m.loading=true;draw();try{m.rows=await call('list');m.specialties=teacher()?await call('specialties'):[];m.groups=teacher()?await call('groups'):[];m.error='';}catch(e){m.error=e.message}finally{m.loading=false;draw()}}\nconst badge=s=>`<span class=\"mbi-badge\">${E(status[s]||s)}</span>`;\nconst progress=(n,total)=>`<div class=\"mbi-progress\" role=\"progressbar\" aria-valuemin=\"0\" aria-valuemax=\"${total}\" aria-valuenow=\"${n}\" aria-label=\"Étape ${n} sur ${total}\"><i style=\"width:${n/total*100}%\"></i></div>`;\nfunction mbClassFields(e){\n const groups=(m.groups||[]).filter(g=>!g.subject||!e.subject||g.subject===e.subject);\n const selected=e.target_class_names||[];\n const classes=st.role==='admin'?field('Classes destinataires',area('target_class_csv',selected.join(', '),'Ex. TGFM1, TGFM6, TGFM7')):groups.length?groups.map((g,i)=>`<label class=\"mbi-group-choice\"><input type=\"checkbox\" data-i-field=\"group:${(m.groups||[]).indexOf(g)}\" ${selected.includes(g.name)&&String(e.target_school).toLowerCase()===String(g.school).toLowerCase()?'checked':''}><span><strong>${E(g.name)}</strong><small>${E(g.school)}</small></span></label>`).join(''):'<p class=\"mbi-muted\">Créez d’abord votre classe dans monAvenir pour lui attribuer cet exercice.</p>';\n return `<section class=\"mbi-assign\"><h3>Affectation pédagogique</h3><p class=\"mbi-muted\">Seuls les élèves de la série, du niveau, de l’établissement et des classes indiqués pourront accéder à l’activité.</p>${field('Établissement',input('target_school',e.target_school||'','Établissement des élèves'))}<div class=\"mbi-class-list\">${classes}</div><small class=\"mbi-muted\">Les noms des classes doivent correspondre aux profils des élèves. Un enseignant ne peut sélectionner que ses propres classes.</small></section>`;\n}\nfunction mbReviewTable(e,q,v){\n const heads=['Débit','Crédit','Date / Intitulé des comptes','Débit (FDJ)','Crédit (FDJ)'];\n const date=e?.source_document?.date||'jj/mm/N';\n const rows=Array.isArray(v)?v:[];\n return `<div class=\"mbi-table-wrap mbi-journal-wrap\" dir=\"ltr\"><table class=\"mbi-table mbi-journal-table\"><thead><tr>${heads.map(h=>`<th>${E(h)}</th>`).join('')}</tr></thead><tbody><tr class=\"mbi-journal-date\"><td></td><td></td><td>${E(date)}</td><td></td><td></td></tr>${rows.map(r=>`<tr>${heads.map((_,j)=>`<td>${E(r?.[j]||'')}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;\n}\nfunction list(){\n const categories=[['','Tous'],['Exercice guidé','Guidés'],['QCM','QCM'],['Vrai ou faux','Vrai / Faux'],['Texte à trous','Textes à trous'],['Étude de cas','Études de cas'],['Défi chronométré','Défis']];\n const rows=m.rows.filter(x=>(!m.filter||x.subject===m.filter)&&(!m.kind||x.title.startsWith(m.kind)));\n const subjects=[...new Set(m.rows.map(x=>x.subject))];\n const accessible=m.rows.filter(x=>!m.filter||x.subject===m.filter);\n const finished=accessible.filter(x=>x.attempt?.status==='graded');\n const submitted=accessible.filter(x=>x.attempt);\n const avg=finished.length?Math.round(20*finished.reduce((sum,x)=>sum+Number(x.attempt.score)/Math.max(1,Number(x.attempt.total)),0)/finished.length*10)/10:0;\n const toReview=finished.filter(x=>Number(x.attempt.score)/Math.max(1,Number(x.attempt.total))<.65);\n const overview=!teacher()?`<section class=\"mbi-overview\"><div class=\"mbi-row\"><strong>Ma progression</strong><span class=\"mbi-muted\">${submitted.length} / ${accessible.length} activités commencées</span></div><div class=\"mbi-overview-numbers\"><div><strong>${finished.length}</strong><small>Terminées et corrigées</small></div><div><strong>${finished.length?avg.toLocaleString('fr-FR')+'/20':'—'}</strong><small>Moyenne actuelle</small></div><div><strong>${toReview.length}</strong><small>À renforcer</small></div></div>${toReview.length?`<details class=\"mbi-review-suggestions\"><summary>Exercices à retravailler</summary>${toReview.slice(0,3).map(x=>`<button type=\"button\" class=\"mbi-suggestion\" ${A('open',x.id)}>${E(x.title)} <span>${E(x.attempt.score)}/${E(x.attempt.total)}</span></button>`).join('')}</details>`:''}</section>`:'';\n return `<div class=\"mbi-intro\"><h2>${teacher()?'Mes activités pédagogiques':'Exercices interactifs'}</h2><p>${teacher()?'Préparez les activités, choisissez vos classes et corrigez les copies.':'Apprenez avec des documents, des calculs et des corrections adaptés à votre niveau.'}</p></div>${overview}${teacher()?B('new','＋ Créer une activité',null,true):''}<div class=\"mbi-category-chips\">${categories.map(([key,label])=>`<button class=\"mbi-chip ${m.kind===key||(!m.kind&&!key)?'is-active':''}\" ${A('kind',key)}>${E(label)}</button>`).join('')}</div>${subjects.length>1?field('Matière',`<select data-i-field=\"filter\"><option value=\"\">Toutes les matières</option>${subjects.map(s=>`<option ${s===m.filter?'selected':''}>${E(s)}</option>`).join('')}</select>`):''}<small class=\"mbi-muted\">${rows.length} activité(s) ${m.kind?'dans ce type':'disponibles'}</small>${m.loading?'<p>Chargement…</p>':!rows.length?'<div class=\"mbi-empty\">Aucune activité dans cette catégorie.</div>':rows.map(x=>`<button class=\"mbi-item mbi-activity\" ${A('open',x.id)}><span><small>${E(x.academic_level+' '+x.series+' · '+x.subject)}</small><strong>${E(x.title)}</strong>${x.source_label?`<small class=\"mbi-source\">${E(x.source_label)}</small>`:''}<small>${x.question_count} question(s) · ${x.mode==='exam'?'Évaluation':'Entraînement'}${x.attempt?' · Note : '+x.attempt.score+'/'+x.attempt.total:''}</small></span>${teacher()?badge(x.status):x.attempt?badge(x.attempt.status):'<span class=\"mbi-arrow\">›</span>'}</button>`).join('')}`;\n}\nfunction editor(){let e=m.exercise,q=e.questions[m.index];let bar=progress(m.step+1,3);if(m.step===0){let specs=m.specialties||[],specific=st.role!=='admin';return `${bar}<h2>1. Le sujet</h2>${specific?field('Classe et matière',`<select data-i-field=\"specialty\">${specs.map((s,i)=>`<option value=\"${i}\" ${s.series===e.series&&s.academic_level===e.academic_level&&s.subject===e.subject?'selected':''}>${E(s.academic_level+' '+s.series+' · '+s.subject)}</option>`).join('')}</select>`):field('Série',select('series',['GFM','OGRH','IAG','S','ES','L'],e.series))+field('Niveau',select('academic_level',['Première','Terminale'],e.academic_level))+field('Matière',input('subject',e.subject,'Ex. Gestion financière'))}${field('Titre',input('title',e.title,'Ex. Facture avec remise'))}${field('Consignes / contexte (obligatoire)',area('instructions',e.instructions,'Donnez les données, le travail demandé, les unités et les arrondis.'))}${mbClassFields(e)}${field('Mode',`<select data-i-field=\"mode\"><option value=\"training\" ${e.mode==='training'?'selected':''}>Entraînement</option><option value=\"exam\" ${e.mode==='exam'?'selected':''}>Évaluation</option></select>`)}`}\nif(m.step===1)return `${bar}<div class=\"mbi-row\"><h2>2. Question ${m.index+1}/${e.questions.length}</h2>${badge(e.questions.length+' bloc(s)')}</div>${field('Type',`<select data-i-field=\"q.type\">${Object.entries(types).map(([k,v])=>`<option value=\"${k}\" ${q.type===k?'selected':''}>${E(v)}</option>`).join('')}</select>`)}${field('Énoncé',area('q.prompt',q.prompt,'Écrire la question'))}${field('Barème (points)',input('q.points',q.points,'1','number'))}${q.type==='choice'?field('Choix (un par ligne)',area('q.options',(q.options||[]).join('\\n')))+field('Bonne réponse (recopier un choix)',input('q.answer',q.answer)):q.type==='table'?field('Colonnes (une par ligne)',area('q.columns',(q.columns||[]).join('\\n')))+field('Lignes (une par ligne)',area('q.rows',(q.rows||[]).join('\\n')))+`<div class=\"mbi-row\">${B('template','Facture','invoice')}${B('template','Journal 5 colonnes','journal')}</div>`+field('Corrigé de référence (enseignant)',area('q.answer',q.answer)):field(q.type==='number'?'Réponse numérique':'Réponse attendue / critères',q.type==='number'?input('q.answer',q.answer,'Ex. 512050'):area('q.answer',q.answer,'Les autres formulations seront à vérifier'))}${field('Indice pédagogique (obligatoire)',area('q.hint',q.hint,'Orientez l’élève sans donner directement la réponse.'))}${field('Explication vérifiable (obligatoire)',area('q.explanation',q.explanation,'Justifiez la réponse : formule, étapes, calcul ou source vérifiable.'))}<div class=\"mbi-row\">${B('qprev','‹ Précédente')}${B('qnext','Suivante ›')}${B('add','＋ Question')}${e.questions.length>1?B('deleteq','Retirer'):''}</div>`;\nreturn `${bar}<h2>3. Vérification</h2><div class=\"mbi-notice\"><strong>${E(e.title||'Sans titre')}</strong><p>${E(e.academic_level+' '+e.series+' · '+e.subject)}</p><p>${e.questions.length} question(s) · ${e.questions.reduce((s,q)=>s+Number(q.points||0),0)} points</p></div>${e.questions.map((q,i)=>`<button class=\"mbi-item\" ${A('editq',i)}><span><strong>${i+1}. ${E(q.prompt||'Question vide')}</strong><small>${E(types[q.type])} · ${E(q.points)} pt</small></span><span>›</span></button>`).join('')}<p class=\"mbi-notice\">Vérifiez chaque énoncé, la réponse de référence, le calcul ou la justification, et l’indice avant de publier. En mode évaluation, les indices et le corrigé restent masqués jusqu’à la correction autorisée.</p>`}\nfunction mbMoney(n){return Number(n||0).toLocaleString('fr-FR')+' FDJ'}\nfunction mbSheet(e,editable){\n const d=e?.source_document;if(!d)return '';\n const guided=!!editable;\n const data=['Montant brut HT','Remise commerciale','Base taxable HT','TVA (10 %)','Net TTC'];\n const row=data.map((label,i)=>{\n   const v=m.answers?.[i],prev=v!==undefined&&v!==null&&v!=='';\n   const value=guided&&m.index===i?`<input type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" data-i-field=\"answer\" aria-label=\"${E(label)}\" placeholder=\"Votre calcul (FDJ)\" value=\"${E(prev?v:'')}\">`:guided&&m.index>i&&prev?`<strong>${E(mbMoney(v))}</strong>`:'<span class=\"mbi-sheet-empty\">À compléter</span>';\n   return guided?`<tr class=\"${m.index===i?'mbi-sheet-active':''}\"><th scope=\"row\">${E(label)}</th><td>${value}</td></tr>`:'';\n }).join('');\n const subtitle=d.regulation==='remise_oubliee'?'Facture initiale — avoir de remise oubliée':d.type==='AVOIR'?'Facture AVOIR — retour de marchandises':'Facture DOIT';\n return `<section class=\"mbi-sheet\" dir=\"ltr\"><div class=\"mbi-sheet-head\"><div><small>DOCUMENT COMPTABLE · SIMULATION</small><strong>${E(subtitle)}</strong></div><span>${E(d.number||'SIM')}</span></div><div class=\"mbi-sheet-meta\"><span>Date : ${E(d.date||'N')}</span><span>TVA : ${E(d.tva_percent||10)} %</span></div><table class=\"mbi-sheet-table\"><thead><tr><th>Désignation</th><th>Quantité</th><th>Prix unitaire</th></tr></thead><tbody><tr><td>Marchandises</td><td>${E(d.quantity||10)}</td><td>${E(mbMoney(d.unit_price))}</td></tr></tbody></table>${d.discount_percent?`<div class=\"mbi-sheet-tag\">Remise : ${E(d.discount_percent)} %</div>`:''}${d.escompte_percent?`<div class=\"mbi-sheet-tag\">Escompte : ${E(d.escompte_percent)} %</div>`:''}${d.transport_ht?`<div class=\"mbi-sheet-tag\">Transport : ${E(mbMoney(d.transport_ht))}</div>`:''}${guided?`<table class=\"mbi-sheet-calc\"><tbody>${row}</tbody></table>`:'<p class=\"mbi-muted\">Complétez les calculs demandés en vous appuyant sur le document.</p>'}</section>`;\n}\nfunction mbSums(v){\n const num=s=>{const x=Number(String(s??'').replace(/[\\s\\u00a0\\u202f]/g,'').replace(',','.'));return Number.isFinite(x)?x:NaN};\n let debit=0,credit=0,invalid=false;\n for(const row of Array.isArray(v)?v:[]){for(const [j,key] of [[3,'debit'],[4,'credit']]){const raw=row?.[j];if(raw!==undefined&&raw!==null&&String(raw).trim()!==''){const n=num(raw);if(!Number.isFinite(n)||n<0)invalid=true;else if(key==='debit')debit+=n;else credit+=n;}}}\n return {debit,credit,invalid};\n}\nfunction mbJournal(e,q,v){\n const d=e.source_document||{};\n const values=Array.isArray(v)?v:[];\n const totals=mbSums(values);\n const names=['Débit','Crédit','Date / Intitulé des comptes','Débit (FDJ)','Crédit (FDJ)'];\n const rows=(q.rows||[]).map((label,i)=>`<tr>${names.map((name,j)=>`<td><input aria-label=\"${E('Ligne '+(i+1)+' — '+name)}\" inputmode=\"${j===2?'text':'decimal'}\" placeholder=\"${j===2?'Intitulé':j<2?'N°':'0'}\" data-i-field=\"cell:${i}:${j}\" value=\"${E(values?.[i]?.[j]||'')}\"></td>`).join('')}</tr>`).join('');\n return `<section class=\"mbi-journal\"><div class=\"mbi-journal-title\"><strong>Journal comptable · 5 colonnes</strong><small>Format des lycées de Djibouti</small></div><p class=\"mbi-muted\">Déplacez le tableau horizontalement si nécessaire.</p><div class=\"mbi-table-wrap mbi-journal-wrap\" dir=\"ltr\"><table class=\"mbi-table mbi-journal-table\"><thead><tr>${names.map(n=>`<th scope=\"col\">${E(n)}</th>`).join('')}</tr></thead><tbody><tr class=\"mbi-journal-date\"><td></td><td></td><td><strong>${E(d.date||'jj/mm/N')}</strong></td><td></td><td></td></tr>${rows}<tr class=\"mbi-journal-label\"><td colspan=\"5\">Libellé : ${E((d.type||'Facture')+' n° '+(d.number||'...'))}</td></tr></tbody></table></div><div id=\"mbi-journal-totals\" class=\"mbi-journal-totals\">Débit : ${E(mbMoney(totals.debit))} · Crédit : ${E(mbMoney(totals.credit))}</div>${B('verifyjournal','Contrôler mon journal',null,false)}${m.journalFeedback?`<p class=\"mbi-feedback\">${E(m.journalFeedback)}</p>`:''}<small class=\"mbi-muted\">L’équilibre ne suffit pas : le professeur vérifiera aussi les comptes et leurs montants.</small></section>`;\n}\nfunction mbJournalCorrect(e,q){\n const d=e?.source_document||{};\n const lines=String(q.answer||'').split('\\n').filter(Boolean).map(s=>s.split('|').map(x=>x.trim()));\n return `<div class=\"mbi-table-wrap mbi-journal-wrap\" dir=\"ltr\"><table class=\"mbi-table mbi-journal-table\"><thead><tr><th>Débit</th><th>Crédit</th><th>Date / Intitulé des comptes</th><th>Débit (FDJ)</th><th>Crédit (FDJ)</th></tr></thead><tbody><tr class=\"mbi-journal-date\"><td></td><td></td><td><strong>${E(d.date||'jj/mm/N')}</strong></td><td></td><td></td></tr>${lines.map(r=>`<tr>${[0,1,2,3,4].map(j=>`<td>${E(r[j]==='—'?'':r[j]||'')}</td>`).join('')}</tr>`).join('')}<tr class=\"mbi-journal-label\"><td colspan=\"5\">${E((d.type||'Facture')+' n° '+(d.number||'...'))}</td></tr></tbody></table></div>`;\n}\n// A table belongs to its own subject; the five-column journal is a special case.\nfunction mbIsJournal(q){const c=q?.columns||[];return c.length===5&&/d[ée]bit/i.test(c[0])&&/cr[ée]dit/i.test(c[1])&&/compte|intitul/i.test(c[2]);}\nfunction mbGenericTable(q,v,editable=false){\n const columns=Array.isArray(q.columns)?q.columns:[],rows=Array.isArray(q.rows)?q.rows:[];\n if(!columns.length||!rows.length)return `<p>${E('Tableau non renseigné.')}</p>`;\n return `<div class=\"mbi-table-wrap\" tabindex=\"0\" role=\"region\" aria-label=\"Tableau de l’exercice\"><table class=\"mbi-table\"><thead><tr><th scope=\"col\">Ligne</th>${columns.map(c=>`<th scope=\"col\" dir=\"auto\">${E(c)}</th>`).join('')}</tr></thead><tbody>${rows.map((r,i)=>`<tr><th scope=\"row\" dir=\"auto\">${E(r)}</th>${columns.map((c,j)=>`<td>${editable?`<input dir=\"auto\" aria-label=\"${E(r+' — '+c)}\" data-i-field=\"cell:${i}:${j}\" value=\"${E(v?.[i]?.[j]??'')}\">`:E(v?.[i]?.[j]??'')}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;\n}\nfunction mbTableCorrection(e,q){if(mbIsJournal(q))return mbJournalCorrect(e,q);const answer=String(q.answer??'');const matrix=answer.split('\\n').map(line=>line.split('|').map(s=>s.trim()));return matrix.length===q.rows?.length&&matrix.every(row=>row.length===q.columns?.length)?mbGenericTable(q,matrix):`<div class=\"mbi-answer\"><small>Réponse attendue</small><strong dir=\"auto\">${E(answer||'À apprécier par le professeur')}</strong></div>`;}\nfunction play(){\n const e=m.exercise,q=e.questions[m.index],v=m.answers[m.index];\n const guided=!!(e.source_document&&e.title.startsWith('Exercice guidé')&&q.type==='number');\n let control='';\n if(q.type==='choice'){\n   control=(q.options||[]).map((o,i)=>`<label class=\"mbi-choice ${o==='Vrai'?'mbi-true':o==='Faux'?'mbi-false':''}\"><input type=\"radio\" name=\"mbi-answer\" data-i-field=\"answer\" value=\"${E(o)}\" ${v===o?'checked':''}><span class=\"mbi-option-tag\">${'ABCD'[i]||'•'}</span><span>${E(o)}</span></label>`).join('');\n }else if(q.type==='table'){\n   control=mbIsJournal(q)?mbJournal(e,q,v):mbGenericTable(q,v,true);\n }else if(!guided){\n   control=field('Votre réponse',q.type==='number'?`<input type=\"text\" inputmode=\"decimal\" dir=\"ltr\" data-i-field=\"answer\" value=\"${E(v??'')}\" placeholder=\"${E(e.source_document?'Saisir le montant en FDJ':'Saisir la valeur numérique')}\">`:e.source_document||e.title.startsWith('Texte à trous')?input('answer',v??'','Saisir votre réponse','text'):`<textarea rows=\"4\" dir=\"auto\" data-i-field=\"answer\" placeholder=\"Rédigez votre réponse…\">${E(v??'')}</textarea>`);\n }\n const rawInstructions=e.instructions||''; const sourceLabel=rawInstructions.startsWith(\"Banque d'exercices – Livre MENFOP\\n\")?\"Banque d'exercices – Livre MENFOP\":''; const parts=(sourceLabel?rawInstructions.slice(sourceLabel.length+1):rawInstructions).split('\\n\\n'); const intro=parts[0]; const additional=parts.slice(1).join('\\n\\n');\n const sheet=e.source_document?(guided?mbSheet(e,true):`<details class=\"mbi-sheet-details\" ${q.type==='table'?'':'open'}><summary>Document commercial de l’exercice</summary>${mbSheet(e,false)}</details>`):'';\n const feedback=m.feedback?.[m.index];\n const hint=q.hint&&e.mode==='training'?`<details class=\"mbi-hint\"><summary>Voir un indice</summary><p>${E(q.hint)}</p></details>`:'';\n const verify=e.mode==='training'&&['text','choice','number'].includes(q.type)?B('check','Vérifier ma réponse'):''; \n return `<section class=\"mbi-exercise-head\"><small>${E(e.academic_level+' '+e.series)} · ${E(e.subject)}</small><h2>${E(e.title)}</h2>${sourceLabel?`<span class=\"mbi-source\">${E(sourceLabel)}</span>`:''}</section>${progress(m.index+1,e.questions.length)}<div class=\"mbi-row\"><span class=\"mbi-muted\">Étape ${m.index+1} sur ${e.questions.length}</span>${badge(q.points+' points')}</div><section class=\"mbi-situation\"><strong>Consigne et situation</strong><p style=\"white-space:pre-line\">${E(intro)}</p>${additional?`<details class=\"mbi-instructions\"><summary>Consignes complémentaires et source</summary><p style=\"white-space:pre-line\">${E(additional)}</p></details>`:''}</section><section class=\"mbi-question\"><span class=\"mbi-question-number\">${m.index+1}</span><h2 data-mbl-original dir=\"auto\">${E(q.prompt)}</h2></section>${sheet}${control}${feedback?`<div class=\"mbi-feedback ${feedback.correct?'mbi-good':'mbi-warning'}\" role=\"status\">${E(feedback.feedback)}</div>`:''}${hint}${verify}${q.type==='number'?`<details class=\"mbi-notice\"><summary>Calculatrice</summary><div class=\"mbi-row\"><input data-i-field=\"calcA\" inputmode=\"decimal\" placeholder=\"Nombre\"><select data-i-field=\"calcOp\"><option>+</option><option>−</option><option>×</option><option>÷</option></select><input data-i-field=\"calcB\" inputmode=\"decimal\" placeholder=\"Nombre\">${B('calc','=')}</div><output id=\"mbi-calc\"></output></details>`:''}<small class=\"mbi-muted\">Progression sauvegardée sur cet appareil. ${e.mode==='exam'?'Aucun indice pendant le défi.':''}</small>`;\n}\nfunction detail(){\n const e=m.exercise,classes=e.target_class_names||[];\n return `<div class=\"mbi-intro\"><h2>${E(e.title)}</h2><p>${E(e.academic_level+' '+e.series+' · '+e.subject)}</p></div>${badge(e.status)}<section class=\"mbi-situation\"><strong>Consignes</strong><p>${E(e.instructions||'Aucune consigne supplémentaire.')}</p></section>${e.source_document?mbSheet(e,false):''}<section class=\"mbi-assign\"><h3>Destinataires</h3><p>${E(e.target_school||'Tous les établissements')} · ${E(classes.length?classes.join(', '):'Toutes les classes du niveau')}</p></section><small class=\"mbi-muted\">${e.questions.length} questions · ${e.questions.reduce((s,q)=>s+Number(q.points||0),0)} points</small>${e.questions.map((q,i)=>`<div class=\"mbi-item\"><span><strong>${i+1}. ${E(q.prompt)}</strong><small>${E(types[q.type])} · ${q.points} pt</small></span></div><details class=\"mbi-notice\"><summary>Vérifier le corrigé et l’indice</summary><p style=\"white-space:pre-line\"><strong>Réponse :</strong> ${E(q.answer||'Non renseignée')}</p><p style=\"white-space:pre-line\"><strong>Indice :</strong> ${E(q.hint||'Non renseigné')}</p><p style=\"white-space:pre-line\"><strong>Explication :</strong> ${E(q.explanation||'Non renseignée')}</p></details>`).join('')}${e.status==='published'?B('attempts','Copies des élèves',null,true):''}${e.status==='published'&&e.mode==='exam'?B('release',e.correction_released?'Masquer le corrigé':'Autoriser le corrigé'):''}`;\n}\nfunction result(){\n const r=m.result,e=m.exercise,grades=r.grades||[];\n const valid=grades.filter(x=>x!=null&&Number(x)>0).length,wrong=grades.filter(x=>x===0).length;\n const canRetry=e.mode==='training'&&r.status==='graded';\n const correction=e.mode==='training'||e.correction_released;\n return `<section class=\"mbi-result\"><span>${r.status==='review'?'Résultat provisoire':'Résultat de votre exercice'}</span><strong>${E(r.score)} / ${E(r.total)}</strong><p>${r.status==='review'?'Le journal ou des réponses rédigées attendent la correction de votre professeur.':'Votre travail a été corrigé.'}</p></section><div class=\"mbi-stats\"><div><strong>${valid}</strong><small>Réponses réussies</small></div><div><strong>${wrong}</strong><small>Réponses à améliorer</small></div><div><strong>${E(Math.round(100*Number(r.score)/Math.max(1,Number(r.total))))} %</strong><small>Points obtenus</small></div></div>${grades.map((g,i)=>`<div class=\"mbi-item\"><span><strong>Question ${i+1}</strong><small>${E(e.questions?.[i]?.prompt||'')}</small></span>${badge(g==null?'À vérifier':g+' / '+e.questions[i].points)}</div>`).join('')}${r.status==='graded'&&correction?B('correction','Revoir le corrigé',null,true):''}${r.status==='graded'&&!correction?'<div class=\"mbi-notice\">Le professeur communiquera le corrigé de cette évaluation.</div>':''}${B('history','Historique des tentatives')}${canRetry?B('retry','Refaire cet entraînement',null,true):''}`;\n}\nfunction correction(){\n const list=m.correction||[],e=m.exercise,r=m.result||{},grades=r.grades||[];\n return `<div class=\"mbi-intro\"><h2>Correction détaillée</h2><p>Examinez chaque question, sa réponse attendue et les conseils associés.</p></div>${list.map((q,i)=>`<section class=\"mbi-correct-card\"><div class=\"mbi-row\"><strong>Question ${i+1}</strong>${badge(grades[i]==null?'En attente':grades[i]+' / '+q.points)}</div><p>${E(q.prompt||'')}</p>${q.type==='table'?mbTableCorrection(e,q):`<div class=\"mbi-answer\"><small>Réponse attendue</small><strong>${E(q.answer||'À apprécier par le professeur')}</strong></div>`}${q.explanation?`<div class=\"mbi-notice\"><strong>Explication</strong><p style=\"white-space:pre-line\">${E(q.explanation)}</p></div>`:''}${q.hint?`<details class=\"mbi-hint\"><summary>Indice pour réviser</summary><p>${E(q.hint)}</p></details>`:''}</section>`).join('')}`;\n}\nfunction history(){\n const h=m.history||[];\n return `<div class=\"mbi-intro\"><h2>Mes tentatives</h2><p>${E(m.exercise?.title||'')}</p></div>${h.length?h.map((v,i)=>`<div class=\"mbi-item\"><span><strong>Tentative ${h.length-i}</strong><small>${E(new Date(v.at).toLocaleString('fr-FR'))}</small></span><strong>${E(v.score)} / ${E(v.total)}</strong></div>`).join(''):'<div class=\"mbi-empty\">Aucune tentative enregistrée.</div>'}`;\n}\nfunction attempts(){return `<h2>Copies reçues</h2>${m.attempts.length?m.attempts.map(a=>`<button class=\"mbi-item\" ${A('review',a.id)}><span><strong>${E(a.full_name||'Élève')}</strong><small>${a.score}/${a.total} · ${E(status[a.status])}</small></span><span>›</span></button>`).join(''):'<div class=\"mbi-empty\">Aucune copie reçue.</div>'}`}\nfunction review(){\n const e=m.exercise,a=m.attempt,q=e.questions[m.index],v=a.answers[m.index];\n return `${progress(m.index+1,e.questions.length)}<h2>${E(a.full_name||'Élève')} · Question ${m.index+1}</h2><p>${E(q.prompt)}</p><section class=\"mbi-correct-card\"><strong>Travail de l’élève</strong>${q.type==='table'?(mbIsJournal(q)?mbReviewTable(e,q,v):mbGenericTable(q,v)):`<p>${E(v||'Sans réponse')}</p>`}</section><section class=\"mbi-correct-card\"><strong>Corrigé de référence</strong>${q.type==='table'?mbTableCorrection(e,q):`<p>${E(q.answer||'À apprécier')}</p>`}</section>${field('Note sur '+q.points,input('grade',m.grades[m.index]??'','0','number'))}`;\n}\nfunction draw(){if(!root)return;let content='',footer='';switch(m.page){case'list':content=list();break;case'edit':content=editor();footer=B('back',m.step===0?'Mes exercices':'‹ Retour')+(m.step<2?B('next','Continuer ›',null,true):B('save','Enregistrer',null,true));break;case'play':content=play();footer=B('playprev',m.index===0?'Quitter':'‹ Retour')+B(m.index===m.exercise.questions.length-1?'submit':'playnext',m.index===m.exercise.questions.length-1?'Envoyer':'Suivant ›',null,true);break;case'detail':content=detail();footer=B('list','‹ Retour')+(m.exercise.status==='draft'?B('edit','Modifier'):'')+(m.exercise.status==='draft'||m.exercise.status==='pending'&&st.role==='admin'?B('publish',st.role==='admin'?'Publier':'Soumettre',null,true):'')+(m.exercise.status==='pending'&&st.role==='admin'?B('return','Renvoyer'):'');break;case'result':content=result();footer=B('list','Mes exercices',null,true);break;case'correction':content=correction();footer=B('result','‹ Résultat',null,true);break;case'history':content=history();footer=B('result','‹ Résultat',null,true);break;case'attempts':content=attempts();footer=B('detail','‹ Retour');break;case'review':content=review();footer=B('rprev',m.index?'‹ Retour':'Copies')+B(m.index===m.exercise.questions.length-1?'grade':'rnext',m.index===m.exercise.questions.length-1?'Valider les notes':'Suivant ›',null,true);break;}\nroot.innerHTML=`<div class=\"mbi-shell\" data-page=\"${E(m.page)}\"><header class=\"mbi-header\"><button class=\"mbi-close\" ${A('close')} aria-label=\"Fermer\">‹</button><div><strong>Exercices interactifs</strong><small>monAvenir</small></div><span class=\"mbi-logo\">MB</span></header><main class=\"mbi-main\">${m.error?`<div class=\"mbi-error\" role=\"alert\">${E(m.error)}</div>`:''}${content}</main>${footer?`<footer class=\"mbi-footer\">${footer}</footer>`:''}</div>`;if(m.page==='play'&&m.deadline&&m.exercise?.time_limit_seconds){const e=document.createElement('div');e.id='mbi-timer';e.className='mbi-timer';e.setAttribute('role','timer');e.setAttribute('aria-live','off');root.querySelector('.mbi-main')?.prepend(e);tickCountdown()}if(busy)root.querySelectorAll('button').forEach(b=>b.disabled=true);}\nfunction tickCountdown(){if(!root||m.page!=='play'||!m.deadline||!m.exercise?.time_limit_seconds)return;const remaining=Math.max(0,Math.ceil((m.deadline-Date.now())/1000)),lang=window.MBLang?.get?.()||'fr',label=lang==='ar'?'الوقت المتبقي':lang==='en'?'Time remaining':'Temps restant';const el=root.querySelector('#mbi-timer');if(el){el.textContent='⏱ '+label+' : '+Math.floor(remaining/60).toString().padStart(2,'0')+':'+(remaining%60).toString().padStart(2,'0');el.dataset.expired=remaining===0?'yes':'no';}if(remaining===0&&!busy&&!m.timerAutoDone&&m.page==='play'){m.timerAutoDone=true;busy=true;call('submit',{id:m.exercise.id,answers:m.answers}).then(x=>{m.result=x;remove('attempt',m.exercise.id);m.page='result';m.error='';}).catch(err=>{m.error=err.message||'Temps écoulé';m.page='list';}).finally(()=>{busy=false;draw()});}}\nsetInterval(tickCountdown,1000);\nfunction change(ev){let k=ev.target.dataset.iField;if(!k)return;let v=ev.target.value;if(k==='filter'){m.filter=v;draw();return}if(k==='target_class_csv'){m.exercise.target_class_names=v.split(',').map(x=>x.trim()).filter(Boolean);persist();return}\nif(k.startsWith('group:')){const g=m.groups?.[Number(k.slice(6))];if(!g)return;let selected=Array.isArray(m.exercise.target_class_names)?m.exercise.target_class_names:[];if(ev.target.checked){if(String(m.exercise.target_school||'').toLowerCase()!==String(g.school).toLowerCase())selected=[];if(!selected.includes(g.name))selected.push(g.name);m.exercise.target_school=g.school}else{selected=selected.filter(x=>x!==g.name)}m.exercise.target_class_names=selected;persist();return}\nif(k==='specialty'){Object.assign(m.exercise,m.specialties[Number(v)]);persist();return}if(k.startsWith('q.')){let q=m.exercise.questions[m.index],p=k.slice(2);q[p]=['options','columns','rows'].includes(p)?v.split('\\n'):p==='points'?v:v;if(p==='type'){q.answer='';if(v==='choice')q.options=['',''];draw()}persist();return}if(k==='answer'){m.answers[m.index]=v;if(m.feedback)delete m.feedback[m.index];persist();return}if(k.startsWith('cell:')){let [,i,j]=k.split(':').map((x,n)=>n?Number(x):x);let q=m.exercise.questions[m.index];if(!Array.isArray(m.answers[m.index]))m.answers[m.index]=q.rows.map(()=>q.columns.map(()=>''));m.answers[m.index][i][j]=v;m.journalFeedback='';persist();const totals=root?.querySelector('#mbi-journal-totals');if(totals){const sums=mbSums(m.answers[m.index]);totals.textContent='Débit : '+mbMoney(sums.debit)+' · Crédit : '+mbMoney(sums.credit)}return}if(k==='grade'){m.grades[m.index]=v===''?null:Number(v);return}if(k.startsWith('calc'))return;if(m.page==='edit'){m.exercise[k]=v;persist()}}\nfunction validQuestion(q){if(!String(q.answer??'').trim())throw Error('Complétez la réponse de référence.');if(String(q.hint??'').trim().length<8)throw Error('Ajoutez un indice pédagogique précis.');if(String(q.explanation??'').trim().length<12)throw Error('Ajoutez une explication vérifiable : méthode, calcul ou justification.');if(!q.prompt.trim()||!(Number(q.points)>0&&Number(q.points)<=100))throw Error('Complétez l’énoncé et le barème.');if(q.type==='number'&&!/^[+-]?\\d+(\\.\\d+)?$/.test(String(q.answer).replace(',','.')))throw Error('Saisissez une réponse numérique valide.');if(q.type==='choice'){q.options=q.options.map(x=>x.trim()).filter(Boolean);q.answer=q.answer.trim();if(q.options.length<2||!q.options.includes(q.answer))throw Error('Ajoutez au moins deux choix et une bonne réponse identique à un choix.')}if(q.type==='table'){q.columns=q.columns.map(x=>x.trim()).filter(Boolean);q.rows=q.rows.map(x=>x.trim()).filter(Boolean);if(!q.columns.length||!q.rows.length)throw Error('Complétez les colonnes et lignes du tableau.')}q.points=Number(q.points);if(q.type==='number')q.answer=String(q.answer).replace(',','.');}\nasync function click(ev){const btn=ev.target.closest('[data-i-act]');if(!btn||busy)return;let a=btn.dataset.iAct,v=btn.dataset.iValue;m.error='';if(a==='close'){close();return}if(a==='calc'){let get=k=>root.querySelector(`[data-i-field=\"${k}\"]`).value;let x=Number(get('calcA').replace(',','.')),y=Number(get('calcB').replace(',','.')),op=get('calcOp');let res=op==='+'?x+y:op==='−'?x-y:op==='×'?x*y:x/y;root.querySelector('#mbi-calc').textContent=Number.isFinite(res)?String(res):'Calcul impossible';return}busy=true;try{switch(a){case'list':await reload();break;\ncase 'kind':m.kind=v||'';break;\ncase 'check':{\n if(m.exercise.mode!=='training')throw Error('Vérification indisponible pendant un défi.');\n const ans=m.answers?.[m.index];\n if(ans==null||String(ans).trim()==='')throw Error('Saisissez votre réponse avant de vérifier.');\n const verdict=await call('check',{id:m.exercise.id,index:m.index,answer:ans});\n (m.feedback||(m.feedback={}))[m.index]=verdict;\n break;\n}\ncase 'verifyjournal':{\n const rows=m.answers?.[m.index];\n const totals=mbSums(rows);\n const count=m.exercise.questions[m.index].rows.length;\n const filled=Array.isArray(rows)&&rows.length===count&&rows.every(row=>Array.isArray(row)&&(String(row[0]||'').trim()||String(row[1]||'').trim())&&String(row[2]||'').trim()&&(String(row[3]||'').trim()||String(row[4]||'').trim()));\n const mixed=Array.isArray(rows)&&rows.some(row=>String(row?.[0]||'').trim()&&String(row?.[1]||'').trim());\n if(!filled)m.journalFeedback='Complétez les comptes, les intitulés et les montants.';\n else if(mixed)m.journalFeedback='Un compte doit être placé soit au débit, soit au crédit.';\n else if(totals.invalid)m.journalFeedback='Utilisez des montants numériques positifs ou nuls.';\n else if(totals.debit<=0||Math.abs(totals.debit-totals.credit)>0.000001)m.journalFeedback='Le journal n’est pas équilibré : vérifiez les totaux.';\n else m.journalFeedback='Les totaux sont égaux. Le professeur doit encore vérifier les comptes et les montants.';\n break;\n}\ncase 'correction':m.correction=await call('correction',{id:m.exercise.id});m.page='correction';break;\ncase 'history':m.history=await call('history',{id:m.exercise.id});m.page='history';break;\ncase 'result':m.page='result';break;\ncase 'retry':{\n if(m.exercise.mode!=='training'||m.result?.status!=='graded')throw Error('Attendez la correction avant de refaire l’exercice.');\n m.exercise=await call('open',{id:m.exercise.id});\n m.answers=m.exercise.questions.map(()=>null);\n m.index=0;m.feedback={};m.journalFeedback='';\n remove('attempt',m.exercise.id);m.result=null;m.page='play';break;\n}\ncase 'release':{\n if(!teacher()||m.exercise.mode!=='exam')throw Error('Action réservée à l’enseignant.');\n await call('release',{id:m.exercise.id,release:!m.exercise.correction_released});\n m.exercise=await call('open',{id:m.exercise.id});\n m.page='detail';break;\n}\ncase'new':{if(st.role==='enseignant'&&!m.specialties.length)throw Error('Aucune matière approuvée. Contactez l’administration.');let old=read('editor','new');m.exercise=old?.exercise||{title:'',series:'GFM',academic_level:'Terminale',subject:'',instructions:'',mode:'training',questions:[newQuestion()],...(m.specialties[0]||{})};m.step=old?.step||0;m.index=old?.index||0;m.page='edit';break}case'open':{m.exercise=await call('open',{id:v});if(teacher()){m.page='detail'}else{if(m.rows.find(x=>x.id===v)?.attempt){m.result=await call('result',{id:v});m.page='result'}else{let draft=read('attempt',v);m.answers=draft?.answers||m.exercise.questions.map(()=>null);m.index=Math.min(draft?.index||0,m.exercise.questions.length-1);if(m.exercise.time_limit_seconds){const started=await call('start',{id:v});m.deadline=Date.parse(started.deadline);m.timerAutoDone=false;}m.page='play'}}break}case'edit':{let d=read('editor',m.exercise.id);if(d)m.exercise=d.exercise;m.step=d?.step||0;m.index=d?.index||0;m.page='edit';break}case'back':if(m.step>0)m.step--;else{persist();await reload()}break;case'next':if(m.step===0&&(!m.exercise.title.trim()||!m.exercise.subject.trim()||String(m.exercise.instructions||'').trim().length<8))throw Error('Indiquez le titre, la matière et une consigne claire.');if(m.step===1){for(let i=0;i<m.exercise.questions.length;i++){try{validQuestion(m.exercise.questions[i])}catch(err){m.index=i;throw Error('Question '+(i+1)+' : '+err.message)}}}m.step++;break;case'editq':m.index=Number(v);m.step=1;break;case'qprev':m.index=Math.max(0,m.index-1);break;case'qnext':m.index=Math.min(m.exercise.questions.length-1,m.index+1);break;case'add':validQuestion(m.exercise.questions[m.index]);if(m.exercise.questions.length>=50)throw Error('50 questions maximum.');m.exercise.questions.push(newQuestion());m.index=m.exercise.questions.length-1;break;case'deleteq':m.exercise.questions.splice(m.index,1);m.index=Math.max(0,m.index-1);break;case'template':{let q=m.exercise.questions[m.index];if(v==='invoice'){q.columns=['Montant (FDJ)'];q.rows=['Montant brut HT','Remise','Net commercial HT','Escompte','Net financier HT','TVA','Net à payer TTC']}else{q.columns=['Débit (compte)','Crédit (compte)','Date / intitulé','Débit (FDJ)','Crédit (FDJ)'];q.rows=['Écriture 1','Écriture 2','Écriture 3','Écriture 4']};break}case'save':{if(String(m.exercise.instructions||'').trim().length<8)throw Error('Consigne générale obligatoire.');m.exercise.questions.forEach(validQuestion);let old=m.exercise.id||'new';let r=await call('save',m.exercise);remove('editor',old);m.exercise=await call('open',{id:r.id});m.page='detail';break}case'publish':if(!confirm('Je confirme avoir vérifié les consignes, chaque réponse, indice et explication (calcul, méthode ou référence). '+(st.role==='admin'?'Publier pour cette série et ce niveau ?':'Soumettre à la validation de l’administrateur ?')))break;await call('publish',{id:m.exercise.id,verified:true});await reload();break;case'return':await call('return',{id:m.exercise.id});await reload();break;case'playprev':if(m.index>0)m.index--;else{persist();await reload()}break;case'playnext':m.index++;break;case'submit':if(!confirm('Envoyer définitivement votre copie ?'))break;m.result=await call('submit',{id:m.exercise.id,answers:m.answers});remove('attempt',m.exercise.id);m.page='result';break;case'attempts':m.attempts=await call('attempts',{id:m.exercise.id});m.page='attempts';break;case'detail':m.page='detail';break;case'review':m.attempt=m.attempts.find(x=>x.id===v);m.grades=[...m.attempt.grades];m.index=0;m.page='review';break;case'rprev':if(m.index>0)m.index--;else m.page='attempts';break;case'rnext':if(m.grades[m.index]==null)throw Error('Indiquez une note.');m.index++;break;case'grade':if(m.grades.some((g,i)=>g==null||!Number.isFinite(g)||g<0||g>Number(m.exercise.questions[i].points)))throw Error('Vérifiez toutes les notes et les barèmes.');await call('grade',{id:m.exercise.id,attempt_id:m.attempt.id,grades:m.grades});m.attempts=await call('attempts',{id:m.exercise.id});m.page='attempts';break;}persist()}catch(e){m.error=e.message||'Une erreur est survenue. Réessayez.'}finally{busy=false;draw()}}\nfunction mount(){if(st.role==='eleve'){document.querySelectorAll('#app [data-mbi-launch]').forEach(el=>el.remove());return}if(root&&st.user?.id!==uid){close();return}if(!st.user||!['eleve','enseignant','admin'].includes(st.role)||!['student-home','teacher-home','admin-home'].includes(st.screen)||st.role==='enseignant'&&st.teacher?.status!=='approved')return;let tiles=document.querySelector('#app .mb-tiles');if(!tiles||tiles.querySelector('[data-mbi-launch]'))return;let b=document.createElement('button');b.type='button';b.className='mb-tile mbi-launch';b.dataset.mbiLaunch='1';b.innerHTML='<span class=\"mbi-launch-icon\" aria-hidden=\"true\">✎</span><span>Exercices interactifs</span>';b.addEventListener('click',show);tiles.prepend(b)}\n// Preserve existing wizard state while importing documents and illustrations.\nconst originalDraw=draw;\nfunction importImage(q,host,editable){if(!q?.image||!/^data:image\\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(q.image))return;const box=document.createElement('div');box.className='mbi-import-image';const img=document.createElement('img');img.src=q.image;img.alt='Document de la question';img.loading='lazy';box.append(img);const link=document.createElement('button');link.className='mbi-button';link.type='button';link.textContent='Agrandir le document';link.onclick=()=>{const d=document.createElement('dialog');d.className='mbi-image-dialog';const big=img.cloneNode();const b=document.createElement('button');b.type='button';b.className='mbi-button';b.textContent='Fermer';b.onclick=()=>d.close();d.append(b,big);document.body.append(d);d.addEventListener('close',()=>d.remove(),{once:true});d.showModal()};box.append(link);if(editable){const b=document.createElement('button');b.type='button';b.className='mbi-button';b.textContent='Retirer l’image';b.onclick=()=>{delete q.image;persist();draw()};box.append(b)}host.after(box)}\ndraw=function(){originalDraw();if(!root||!window.MBIImport)return;const main=root.querySelector('.mbi-main');if(!main)return;const e=m.exercise,q=e?.questions?.[m.index];if(m.page==='edit'&&(m.step===0||m.step===1)){const stage=m.step;const field=main.querySelector(stage===0?'[data-i-field=\"instructions\"]':'[data-i-field=\"q.prompt\"]');if(!field)return;const container=document.createElement('div');container.innerHTML=MBIImport.panel(stage);const panel=container.firstElementChild;field.closest('label').before(panel);MBIImport.attach(root,stage,{text(t){t=t.trim();const limit=stage===0?30000:5000;if(t.length>limit)throw Error('Le texte dépasse '+limit+' caractères. Réduisez l’aperçu avant de l’insérer.');const previous=stage===0?e.instructions:q.prompt;if(previous&&previous.trim()&&!confirm('Remplacer le texte actuel par le document importé ?'))return;if(stage===0)e.instructions=t;else q.prompt=t;persist();draw()},questions(list){const existing=e.questions.filter(x=>x.prompt.trim());if(existing.length+list.length>50)throw Error('Maximum 50 questions.');e.questions=[...existing,...list.map(prompt=>({...newQuestion(),prompt}))];m.step=1;m.index=existing.length;persist();draw()},correction(t){if(!q)throw Error('Aucune question sélectionnée.');if(t.length>20000)throw Error('Corrigé trop long.');if(q.answer&&!confirm('Remplacer le corrigé actuel ?'))return;q.answer=t.trim();persist();draw()},image(data){if(q.image&&!confirm('Remplacer l’illustration actuelle ?'))return;q.image=data;persist();draw()}});if(stage===1)importImage(q,panel,true)}else if(m.page==='play'||m.page==='review'){const anchor=main.querySelector('h2');if(anchor)importImage(q,anchor,false)}};\n\n// Optional teacher-controlled AI: private, bounded, and no automatic grading.\nconst drawBeforeAI=draw;\ndraw=function(){\n drawBeforeAI();\n if(!root||m.page!=='review'||!teacher())return;\n const q=m.exercise?.questions?.[m.index],answer=m.attempt?.answers?.[m.index],grade=root.querySelector('[data-i-field=\"grade\"]');\n if(!q||q.type!=='text'||!grade||q.image||!String(q.answer||'').trim()||typeof answer!=='string'||!answer.trim()||[q.prompt,q.answer,answer].some(x=>String(x).length>1400))return;\n const languageCode=(document.documentElement.lang||'fr').toLowerCase().slice(0,2), tr=(fr,en,ar)=>languageCode==='ar'?ar:languageCode==='en'?en:fr;\n const state=m,sessionUid=uid,idx=m.index,attempt=m.attempt.id,exercise=m.exercise.id,key=attempt+':'+idx;\n const cache=state.aiResults||(state.aiResults={});\n const box=document.createElement('section');box.className='mbi-ai';box.dir=languageCode==='ar'?'rtl':'ltr';\n const label=document.createElement('div');label.className='mbi-ai-heading';label.textContent=tr('✦ Correction assistée par IA','✦ AI-assisted grading','✦ التصحيح بمساعدة الذكاء الاصطناعي');\n const small=document.createElement('small');small.textContent=tr('Suggestion uniquement. Vous gardez la décision finale.','Suggestion only. You make the final decision.','اقتراح فقط. القرار النهائي لك.');\n const statusEl=document.createElement('div');statusEl.setAttribute('aria-live','polite');statusEl.className='mbi-ai-status';\n const button=document.createElement('button');button.type='button';button.className='mbi-button mbi-ai-action';button.textContent=tr('Analyser la réponse','Analyze answer','تحليل الإجابة');\n const result=document.createElement('div');result.className='mbi-ai-result';result.hidden=true;\n box.append(label,small,button,statusEl,result);grade.closest('label').before(box);\n const current=()=>root&&m===state&&uid===sessionUid&&st.user?.id===sessionUid&&m.page==='review'&&m.attempt?.id===attempt&&m.index===idx;\n function render(value){\n  result.replaceChildren();result.hidden=false;button.hidden=true;statusEl.textContent='';button.disabled=false;\n  const heading=document.createElement('strong');heading.textContent=tr('Note proposée : ','Suggested mark: ','الدرجة المقترحة: ')+value.score+' / '+value.points;\n  const reason=document.createElement('p');reason.textContent=value.explanation;\n  const lang=document.createElement('p');const title=document.createElement('strong');title.textContent=tr('Orthographe et grammaire : ','Spelling and grammar: ','الإملاء والنحو: ');lang.append(title,document.createTextNode(value.language));\n  const apply=document.createElement('button');apply.type='button';apply.className='mbi-button mbi-primary';apply.textContent=tr('Utiliser cette note','Use this mark','استخدام هذه الدرجة');\n  apply.onclick=()=>{if(!current())return;const field=root.querySelector('[data-i-field=\"grade\"]');if(!field)return;m.grades[idx]=value.score;field.value=String(value.score);statusEl.textContent=tr('Note proposée reportée. Validez la copie à la fin.','Suggested mark entered. Validate the submission at the end.','تم إدخال الدرجة المقترحة. اعتمد التصحيح في النهاية.')};\n  const quota=document.createElement('small');quota.textContent=Number.isInteger(value.remaining)?tr('Analyses restantes aujourd’hui : ','Analyses remaining today: ','التحليلات المتبقية اليوم: ')+value.remaining:'';\n  result.append(heading,reason,lang,apply,quota);\n }\n if(cache[key]?.data){render(cache[key].data);return}\n if(cache[key]?.pending){button.disabled=true;statusEl.textContent=tr('Analyse en cours…','Analyzing…','جارٍ التحليل…')}\n button.onclick=async()=>{\n   if(!current()||busy||cache[key]?.pending)return;\n   if(!confirm(tr('Seuls l’énoncé, le corrigé et la réponse seront analysés par Cloudflare. Vérifiez qu’ils ne contiennent aucune information personnelle ou sensible. Continuer ?','Cloudflare will analyze only the question, expected answer and student answer. Confirm they contain no personal or sensitive information. Continue?','سيحلل Cloudflare السؤال والإجابة النموذجية وإجابة الطالب فقط. تأكد من خلوها من المعلومات الشخصية أو الحساسة. هل تريد المتابعة؟')))return;\n   cache[key]={pending:true};button.disabled=true;statusEl.textContent=tr('Analyse en cours…','Analyzing…','جارٍ التحليل…');\n   try{\n    const {data,error}=await st.db.auth.getSession();if(error||!data?.session?.access_token)throw Error(tr('Reconnectez-vous pour continuer.','Sign in again to continue.','سجّل الدخول مجددًا للمتابعة.'));\n    if(!current())throw Error(tr('Correction interrompue.','Grading interrupted.','تم إيقاف التصحيح.'));\n    const response=await fetch('/api/interactive-ai',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+data.session.access_token},body:JSON.stringify({exercise,attempt,index:idx})});\n    const value=await response.json();if(!response.ok)throw Error((languageCode==='fr'&&value.error)|| (response.status===429?tr('Quota gratuit atteint.','Free daily quota reached.','تم بلوغ الحد المجاني اليومي.'):tr('IA momentanément indisponible.','AI is temporarily unavailable.','الذكاء الاصطناعي غير متاح مؤقتًا.')) ||tr('IA momentanément indisponible.','AI is temporarily unavailable.','الذكاء الاصطناعي غير متاح مؤقتًا.'));\n    cache[key]={data:value};if(current())draw();\n   }catch(err){delete cache[key];if(current()){const live=root.querySelector('.mbi-ai-status');const b=root.querySelector('.mbi-ai-action');if(live)live.textContent=err.message||tr('Correction manuelle disponible.','Manual grading is available.','التصحيح اليدوي متاح.');if(b)b.disabled=false}}\n };\n};\n\nconst observer=new MutationObserver(()=>mount());observer.observe(document.getElementById('app')||document.body,{childList:true,subtree:true});mount();\nwindow.MonBacInteractive={\n open:show,\n openExercise:async function(id){\n   await show();\n   if(!root)throw Error('Impossible d’ouvrir les exercices interactifs.');\n   const button=Array.from(root.querySelectorAll('button[data-i-act=\"open\"]')).find(el=>el.dataset.iValue===String(id));\n   if(!button){close();throw Error('Cet exercice ne figure pas dans votre liste autorisée.');}\n   button.click();\n }\n};\n\n})();\n\n"],"/mon-bac-v85-travailler-quality-20261119.js":["application/javascript; charset=utf-8",false,"/* monAvenir V85 — ressources, activités, achats et approbations. */\n(()=>{'use strict';\nconst kinds={fiche:'Fiche de cours',resume:'Résumé',exercice:'Exercice',corrige:'Corrigé',devoir:'Devoir à rendre',bac:'Sujet BAC',qcm:'QCM',test:'Test',interactif:'Exercice interactif'}, interactive=k=>['qcm','test','interactif'].includes(k), money=n=>Number(n||0).toLocaleString('fr-FR')+' FDJ', date=s=>s?new Date(s).toLocaleDateString('fr-FR'):'', E=esc;\nconst actions=(key,label,id='',cls='btn')=>`<button type=\"button\" class=\"${cls}\" data-lr=\"${key}\" data-id=\"${E(id)}\">${E(label)}</button>`, link=(screen,label)=>`<button type=\"button\" class=\"btn\" data-act=\"goto\" data-to=\"${screen}\">${E(label)}</button>`, row=(head,sub,tail='')=>`<div class=\"lr-row\"><div><strong>${E(head)}</strong><small>${E(sub)}</small></div>${tail}</div>`, empty=s=>`<p class=\"lr-empty\">${E(s)}</p>`, opts=(values,selected='')=>values.map(([v,l])=>`<option value=\"${E(v)}\" ${v===selected?'selected':''}>${E(l)}</option>`).join(''), field=(label,html)=>`<label class=\"lr-field\"><span>${E(label)}</span>${html}</label>`, input=(name,value='',more='')=>`<input class=\"input\" name=\"${name}\" value=\"${E(value)}\" ${more}>`, select=(name,values,value='')=>`<select class=\"select\" name=\"${name}\">${opts(values,value)}</select>`, price=r=>r.price?money(r.price):'Gratuit', status={unpaid:'À payer',pending:'En vérification',paid:'Payé',refused:'Refusé',approved:'Approuvé'};\nlet owner='', data={}, catalogue=[], interactiveCatalogue=[], tab='', filter='', query='', page=0, loading=false, error='', draft=null, draftStep=0, qEdit=0, modal=null, timer=null, urls=[];\nconst seriesList=['GFM','OGRH','IAG','S','ES','L'],levelList=['Première','Terminale'],commonSubjects=['Mathématiques','Physique et Chimie','SVT','Français','Anglais','Arabe','SES','Philosophie','Chinois','Russe'],managementSubjects=['Gestion Financière','Mercatique','OGRH','IAG','Économie et Droit','Management des Organisations','Communication','Principes de gestion'],paymentMethods=['Waafi','CacPay','D-Money','SabaPay','Espèces'];\nconst specialty=d=>(data.specialties||[]).find(s=>s.series===d.series&&s.academic_level===d.academic_level&&s.subject.toLowerCase()===d.subject.toLowerCase());\nfunction subjectOptions(d){const own=(data.specialties||[]).filter(s=>s.series===d.series&&s.academic_level===d.academic_level).map(s=>s.subject);return [...new Map([...own,...(seriesList.slice(0,3).includes(d.series)?managementSubjects:[]),...commonSubjects].reverse().map(s=>[s.toLowerCase(),s])).values()].sort((a,b)=>a.localeCompare(b,'fr')).map(s=>[s,s])}\nfunction specialtyFields(d){const s=specialty(d);return field('Série',select('series',[['','Choisir la série'],...seriesList.map(x=>[x,x])],d.series))+field('Niveau',select('academic_level',[['','Choisir le niveau'],...levelList.map(x=>[x,x])],d.academic_level))+field('Matière',select('subject',[['','Choisir la matière'],...subjectOptions(d)],d.subject))+(d.series&&d.academic_level&&d.subject?(s?.approved?'<p class=\"lr-specialty-ok\">✓ Spécialité approuvée</p>':s?'<p class=\"lr-specialty-note\">Validation de cette spécialité en attente.</p>':`<div class=\"lr-specialty-note\">Cette spécialité doit être validée avant la publication. ${actions('request-specialty','Demander la validation')}</div>`):'<p class=\"lr-specialty-note\">Choisissez la série, le niveau et la matière.</p>')+`<p class=\"lr-error\" id=\"lrWizardError\" hidden></p>`}\nconst paymentColors={'Waafi':'#087d63','CacPay':'#1766a8','D-Money':'#e56b14','SabaPay':'#71409d','Espèces':'#506273'};\nfunction paymentBadge(k){const c=paymentColors[k]||'#506273';return `<svg class=\"lr-payment-badge\" viewBox=\"0 0 110 38\" role=\"img\" aria-label=\"${E(k)}\"><rect x=\"1\" y=\"1\" width=\"108\" height=\"36\" rx=\"8\" fill=\"#fff\" stroke=\"#dce1e7\"/><rect x=\"8\" y=\"8\" width=\"22\" height=\"22\" rx=\"6\" fill=\"${c}\"/><path d=\"M15 12h8v14h-8z M18 23h2\" fill=\"none\" stroke=\"white\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><text x=\"36\" y=\"23\" font-family=\"system-ui,sans-serif\" font-weight=\"700\" font-size=\"12\" fill=\"${c}\">${E(k)}</text></svg>`}\nfunction paymentFooter(methods){return methods.length?`<footer class=\"lr-payment-footer\"><small>Moyens de paiement de monAvenir</small><div>${methods.map(([k])=>paymentBadge(k)).join('')}</div></footer>`:''}\nlet settingsNotice='';\nconst screens=['student-learning','teacher-learning','admin-learning'];\nscreenList.push(['student-learning','Réviser et travailler'],['teacher-learning','Ressources pédagogiques'],['admin-learning','Achats et paiements']);\nfunction reset(){const key=st.user?.id||'';if(key!==owner){owner=key;data={};catalogue=[];interactiveCatalogue=[];tab='';draft=null;filter='';query='';page=0;close()}}\nasync function api(action,p_data={}){const result=await st.db.rpc(action==='catalogue'&&!st.user?'mon_bac_learning_catalogue':'mon_bac_learning',action==='catalogue'&&!st.user?{}:{p_action:action,p_data});if(result.error)throw Error(result.error.message||'Service indisponible');return result.data}\nasync function load(){reset();const screen=st.screen,uid=owner;loading=true;error='';try{if(screen==='teacher-learning')data=await api('teacher_data');else if(screen==='admin-learning')data=await api('admin_data');else if(screen==='student-learning'){[catalogue,data,interactiveCatalogue]=await Promise.all([api('catalogue'),api('student_data'),(async()=>{try{const result=await st.db.rpc('mon_bac_interactive',{p_action:'list',p_data:{}});return result.error?[]:Array.isArray(result.data)?result.data:[]}catch{return []}})()])}}catch(e){error=e.message}finally{loading=false;if(st.screen===screen&&owner===uid)render()}}\nfunction tabs(items){return `<nav class=\"lr-tabs\" aria-label=\"Sections\">${items.map(([k,l])=>`<button type=\"button\" data-lr=\"tab\" data-id=\"${k}\" aria-pressed=\"${tab===k}\">${E(l)}</button>`).join('')}</nav>`}\nfunction pagination(items,make){const size=5, p=Math.min(page,Math.max(0,Math.ceil(items.length/size)-1));return items.length?items.slice(p*size,p*size+size).map(make).join('')+`<div class=\"lr-pagination\">${p>0?actions('page','‹','-1'):''}<small>${p+1} / ${Math.max(1,Math.ceil(items.length/size))} · ${items.length}</small>${(p+1)*size<items.length?actions('page','›','1'):''}</div>`:empty('Aucun élément pour le moment.')}\nfunction search(items,category=''){return `<div class=\"lr-filter\"><input class=\"input\" data-lr-query placeholder=\"Rechercher…\" value=\"${E(query)}\"><select class=\"select\" data-lr-filter aria-label=\"Matière\">${opts([['','Toutes les matières'],...Array.from(new Set(items.map(x=>x.subject).filter(Boolean))).sort().map(x=>[x,x])],filter)}</select></div>`}\nfunction matches(r){return (!filter||r.subject===filter)&&(!query||[r.title,r.subject,r.teacher_name].join(' ').toLowerCase().includes(query.toLowerCase()))}\n\nfunction monbacVirtual(){\n  return (interactiveCatalogue||[]).filter(x=>x&&x.status==='published').map(x=>{\n    const t=String(x.title||'');\n    const isTest=/^(QCM|Vrai ou faux|Défi chronométré)(?:\\s|$)/i.test(t);\n    return {...x,isNativeInteractive:true,kind:isTest?'test':'interactif',teacher_name:'monAvenir',accessible:true,eligible:true,price:0,duration:0};\n  });\n}\n\nfunction student(){if(!tab||tab==='bac')tab='all';const groups=[['all','Tout'],['learn','Fiches'],['practice','Exercices'],['tests','Tests & QCM'],['orders','Mes achats']];let merged=[...catalogue,...monbacVirtual()].filter(r=>r.kind!=='bac');let list=merged.filter(matches).filter(r=>tab==='all'||tab==='learn'&&['fiche','resume','corrige'].includes(r.kind)||tab==='practice'&&['exercice','interactif','devoir'].includes(r.kind)||tab==='tests'&&['qcm','test'].includes(r.kind));if(tab==='orders')return tabs(groups)+pagination(data.orders||[],o=>row(o.title,`${money(o.amount)} · ${status[o.status]||o.status}`,actions('invoice','Facture',o.resource_id)));return tabs(groups)+search(merged)+`<div class=\"lr-list\" id=\"lrList\">${pagination(list,studentRow)}</div><div class=\"lr-links\">${link('student-group','Mes classes')}${actions('my-results','Mes résultats')}</div>`}\nfunction studentRow(r){if(r.isNativeInteractive){\n  const kindLabel=r.kind==='test'?'Test / QCM':'Exercice interactif';\n  const score=r.attempt?(' · Note : '+r.attempt.score+'/'+r.attempt.total):'';\n  return '<div class=\"lr-row lr-native-interactive\"><span class=\"lr-symbol\">'+I('clipboard-check')+'</span><div><strong>'+E(r.title)+'</strong><small>'+E(r.academic_level+' '+r.series+' · '+r.subject)+'</small>'+(r.source_label?'<small class=\"mbi-source\">'+E(r.source_label)+'</small>':'')+'<small>'+kindLabel+' · '+r.question_count+' questions'+score+'</small></div>'+actions('interactive-open',r.attempt?'Ouvrir le résultat':'Commencer',r.id,'btn primary')+'</div>';\n}\nconst label=r.accessible?'Ouvrir':r.eligible?(r.order_status==='pending'?'En attente':'Acheter'):'Rejoindre';return `<div class=\"lr-row ${r.eligible?'':'lr-locked'}\"><span class=\"lr-symbol\">${r.accessible?I(interactive(r.kind)?'clipboard-check':'file'):I('lock')}</span><div><strong>${E(r.title)}</strong><small>${E(r.subject)} · ${E(kinds[r.kind])}</small><small>${E(r.teacher_name||'')} · ${r.duration?`${r.duration} min · `:''}${price(r)}</small></div>${actions(r.accessible?'open':r.eligible?'invoice':'join',label,r.id,'btn '+(r.accessible?'primary':''))}</div>`}\nfunction teacher(){if(!tab)tab='resources';const ts=tabs([['resources','Mes ressources'],['add','Ajouter'],['qcm','QCM'],['stats','Statistiques'],['requests',`Demandes${(data.requests||[]).filter(r=>r.status==='pending').length?' • '+(data.requests||[]).filter(r=>r.status==='pending').length:''}`]]);if(tab==='add'||tab==='qcm')return ts+wizard();if(tab==='requests')return ts+pagination((data.requests||[]).filter(r=>r.status==='pending'),r=>row(r.student_name,r.group_name,`<div class=\"lr-inline\">${actions('approve','Approuver',r.id,'btn primary')}${actions('refuse','Refuser',r.id)}</div>`));if(tab==='stats')return ts+stats();return ts+search(data.resources||[])+`<div id=\"lrList\">${pagination((data.resources||[]).filter(matches),r=>row(r.title,`${kinds[r.kind]} · ${r.subject} · ${price(r)} · ${r.published?'Publié':'Brouillon'}`,`<div class=\"lr-inline\">${r.published?actions('archive','Archiver',r.id):actions('publish','Publier',r.id,'btn primary')}${actions('teacher-open','Voir',r.id)}</div>`))}</div>`}\nfunction newDraft(qcm=false){draft={title:'',series:'',academic_level:'',subject:'',kind:qcm?'qcm':'fiche',description:'',price:0,duration:0,due_at:'',audience:'classes',group_ids:[],student_ids:[],questions:[],file:null,id:null};draftStep=0;qEdit=0}\nfunction wizard(){if(!draft)newDraft(tab==='qcm');const d=draft, is=interactive(d.kind), steps=['Informations',is?'Questions':'Document','Destinataires'];const header=`<div class=\"lr-steps\">${steps.map((s,i)=>`<span class=\"${i===draftStep?'active':''}\">${i+1}. ${s}</span>`).join('')}</div>`;let body='';if(draftStep===0){body=field('Titre',input('title',d.title,'required maxlength=\"160\"'))+specialtyFields(d)+field('Type',select('kind',Object.entries(kinds).filter(([k])=>tab==='qcm'?interactive(k):!interactive(k)),d.kind))+field('Description (facultative)',`<textarea class=\"textarea\" name=\"description\" rows=\"2\" maxlength=\"3000\">${E(d.description)}</textarea>`)+field('Prix en FDJ (0 = gratuit)',input('price',d.price,'type=\"number\" min=\"0\" max=\"1000000\" required'))+(tab==='qcm'?field('Durée en minutes (0 = libre)',input('duration',d.duration,'type=\"number\" min=\"0\" max=\"180\" required')):'')+field('Date limite (facultative)',input('due_at',d.due_at,'type=\"datetime-local\"'))}\nelse if(draftStep===1){if(is){const q=d.questions[qEdit]||{type:'single',text:'',options:['',''],correct:0,points:1,explanation:'',hint:''};let answer=Array.isArray(q.correct)?q.correct.join('\\n'):String(q.correct??'');body=`<div class=\"lr-inline\"><strong>Question ${qEdit+1} / ${Math.max(d.questions.length,qEdit+1)}</strong>${qEdit>0?actions('question-prev','‹'):''}${qEdit<d.questions.length-1?actions('question-next','›'):''}</div>`+field('Type de réponse',select('qtype',[['single','Choix unique'],['multi','Choix multiples'],['boolean','Vrai / Faux'],['number','Nombre'],['text','Texte court'],['table','Tableau à compléter']],q.type))+field('Question',`<textarea class=\"textarea\" name=\"qtext\" required rows=\"3\">${E(q.text)}</textarea>`)+field('Options / lignes (une par ligne)',`<textarea class=\"textarea\" name=\"qoptions\" rows=\"3\" placeholder=\"Option 1&#10;Option 2\">${E(q.options?.join('\\n')||'')}</textarea>`)+field('Bonne réponse',input('qcorrect',q.type==='single'?Number(q.correct)+1:q.type==='multi'?(q.correct||[]).map(x=>Number(x)+1).join(','):q.type==='boolean'?(q.correct===1?'2':'1'):answer,'required placeholder=\"1 ou 1,2 ; texte / nombre\"'))+`<small>Choix : numéro(s) des options ; Vrai/Faux : 1 ou 2 ; tableau : valeurs séparées par |.</small>`+field('Points',input('qpoints',q.points,'type=\"number\" min=\"0.1\" max=\"100\" step=\"0.1\" required'))+field('Explication du corrigé',input('qexplanation',q.explanation||''))+field('Indice (exercice non chronométré)',input('qhint',q.hint||''))+actions('question-add','+ Ajouter une question')}\nelse body=field('Importer un PDF, Word (.docx) ou une image',`<input type=\"file\" class=\"input\" name=\"file\" accept=\".pdf,.docx,.png,.jpg,.jpeg,.webp\">`)+`<p class=\"lr-empty\">${d.file?E(d.file.name):'25 Mo maximum. Lecture intégrée.'}</p>`}\nelse body=field('Partager avec',select('audience',[['classes','Toutes mes classes'],['groups','Une ou plusieurs classes'],['students','Un ou plusieurs élèves']],d.audience))+`<div id=\"lrRecipients\">${recipients(d)}</div><p class=\"lr-empty\">${d.price?'Payant : consultation et téléchargement après paiement confirmé.':'Gratuit : consultation dans monAvenir.'}</p>`;\nreturn `<section class=\"lr-panel\">${header}<form id=\"lrWizard\">${body}<div class=\"lr-inline lr-form-actions\">${draftStep?actions('wizard-back','Retour'):''}<button class=\"btn primary\" type=\"submit\">${draftStep===2?'Publier':'Continuer'}</button></div></form></section>`}\nfunction recipients(d){if(d.audience==='classes')return '<small>Tous vos élèves approuvés.</small>';const group=d.audience==='groups',list=group?(data.groups||[]):[...new Map((data.students||[]).map(s=>[s.id,s])).values()];return `<div class=\"lr-recipients\">${list.length?list.map(x=>`<label><input type=\"checkbox\" name=\"recipient\" value=\"${E(x.id)}\" ${(group?d.group_ids:d.student_ids).includes(x.id)?'checked':''}> ${E(x.name)}</label>`).join(''):empty('Aucun destinataire. Ajoutez une classe ou des élèves.')}</div>`}\nfunction capture(){const f=$('lrWizard');if(!f||!draft)return;const fd=new FormData(f),d=draft;if(draftStep===0){for(const k of ['title','series','academic_level','subject','kind','description','due_at'])d[k]=String(f.elements.namedItem(k)?.value||'');for(const k of ['price','duration'])d[k]=Number(fd.get(k)||0)}else if(draftStep===1&&!interactive(d.kind)){const file=f.elements.file?.files?.[0];if(file)d.file=file}else if(draftStep===2){d.audience=String(fd.get('audience'));d.group_ids=d.audience==='groups'?fd.getAll('recipient'):[];d.student_ids=d.audience==='students'?fd.getAll('recipient'):[]}}\nfunction saveQuestion(){const f=$('lrWizard'),fd=new FormData(f);if(!f.reportValidity())throw Error('Complétez la question.');const type=String(fd.get('qtype')),raw=String(fd.get('qcorrect')).trim();let options=String(fd.get('qoptions')).split('\\n').map(s=>s.trim()).filter(Boolean),correct=raw;if(type==='boolean'){options=['Vrai','Faux'];correct=Number(raw)-1}else if(type==='single')correct=Number(raw)-1;else if(type==='multi')correct=raw.split(',').map(n=>Number(n.trim())-1);else if(type==='number'){correct=Number(raw.replace(',','.'));if(!Number.isFinite(correct))throw Error('Nombre invalide.')}else if(type==='table')correct=raw.split('|').map(s=>s.trim());if(['single','multi','boolean','table'].includes(type)&&options.length<2)throw Error('Ajoutez au moins deux options / lignes.');if(['single','boolean'].includes(type)&&(!Number.isInteger(correct)||correct<0||correct>=options.length)||type==='multi'&&(!correct.length||correct.some(n=>!Number.isInteger(n)||n<0||n>=options.length))||type==='table'&&correct.length!==options.length)throw Error('Corrigé invalide.');draft.questions[qEdit]={type,text:String(fd.get('qtext')).trim(),options,correct,points:Number(fd.get('qpoints')),explanation:String(fd.get('qexplanation')),hint:String(fd.get('qhint'))}}\nfunction stats(){const orders=data.orders||[],pending=orders.filter(o=>!o.payout_at);return `<div class=\"lr-kpis\"><div><strong>${(data.stats||[]).reduce((n,s)=>n+Number(s.views),0)}</strong><small>Consultations</small></div><div><strong>${(data.results||[]).length}</strong><small>Tests terminés</small></div><div><strong>${money(pending.reduce((n,o)=>n+o.amount-o.commission,0))}</strong><small>À reverser</small></div></div>${actions('results','Résultats des élèves')}${actions('works','Devoirs reçus')}${actions('earnings','Revenus')}<div>${pagination(data.stats||[],s=>row((data.resources||[]).find(r=>r.id===s.id)?.title||'Ressource',`${s.viewers} élèves · ${s.views} vues · ${s.attempts} réponses${s.avg!=null?' · '+s.avg+' %':''}`))}</div>`}\nfunction admin(){if(!tab)tab='pending';const orders=data.orders||[],cfg=data.settings||{},ts=tabs([['pending','À valider'],['paid','Encaissements'],['payout','Reversements'],['accounts','Comptes'],['settings','Tarifs']]);const notice=settingsNotice?`<p class=\"lr-specialty-ok\" role=\"status\">${E(settingsNotice)}</p>`:'';if(tab==='accounts')return ts+`<form id=\"lrPaymentSettings\" class=\"lr-panel\"><h2>Comptes de paiement</h2><p class=\"lr-specialty-note\">Renseignez les coordonnées de réception de monAvenir. Laissez vide pour désactiver un moyen. Ne saisissez aucun code PIN, CVV ni mot de passe.</p>${paymentMethods.map(k=>`<div class=\"lr-payment-field\">${paymentBadge(k)}${field(k,input(k,cfg.methods?.[k]||'','maxlength=\"300\" placeholder=\"Numéro / code marchand ou instructions\"'))}</div>`).join('')}${notice}<p class=\"lr-error\" id=\"lrPaymentError\" hidden></p><button class=\"btn primary full\" type=\"submit\">Enregistrer les comptes</button></form>`;if(tab==='settings')return ts+`<form id=\"lrSettings\" class=\"lr-panel\">${field('Commission (%)',input('commission',Number(cfg.commission_bp??1000)/100,'type=\"number\" min=\"0\" max=\"100\" step=\"0.01\" required'))}${field('Gratuité de lancement jusqu’au',input('launch',String(cfg.launch_until||'').slice(0,10),'type=\"date\" required'))}${actions('tab','Configurer les comptes de paiement','accounts')}${notice}<p class=\"lr-error\" id=\"lrPaymentError\" hidden></p><button class=\"btn primary full\" type=\"submit\">Enregistrer les tarifs</button></form>`;const list=orders.filter(o=>tab==='pending'?o.status==='pending':tab==='payout'?o.status==='paid'&&!o.payout_at:o.status==='paid');return ts+`<div class=\"lr-kpis\"><div><strong>${list.length}</strong><small>Opérations</small></div><div><strong>${money(list.reduce((n,o)=>n+o.amount,0))}</strong><small>Montant</small></div></div>`+pagination(list,o=>row(o.title,`${o.student_name} · ${money(o.amount)} · ${o.method||''}`,actions('admin-order','Ouvrir',o.id,'btn primary')))}\nfunction close(){if(timer)clearInterval(timer);timer=null;for(const u of urls)URL.revokeObjectURL(u);urls=[];modal?.remove();modal=null}\nfunction dialog(title,body,full=false){close();modal=document.createElement('dialog');modal.className='lr-dialog'+(full?' lr-full':'');modal.innerHTML=`<header><strong>${E(title)}</strong>${actions('close','Fermer')}</header><div class=\"lr-dialog-body\">${body}</div>`;document.body.append(modal);modal.showModal();modal.addEventListener('cancel',e=>{e.preventDefault();close()});return modal.querySelector('.lr-dialog-body')}\nfunction message(text){if(modal){const body=modal.querySelector('.lr-dialog-body');let p=body.querySelector('.lr-error');if(!p){p=document.createElement('p');p.className='lr-error';body.prepend(p)}p.textContent=text}else toast(text)}\nasync function publicCatalogue(){const rows=await api('catalogue');dialog('Ressources pédagogiques',`<p class=\"lr-empty\">Créez un compte et rejoignez une classe pour accéder aux activités.</p>${rows.slice(0,5).map(r=>row(r.title,`${r.subject} · ${r.teacher_name} · ${price(r)}`,`<span class=\"lr-lock\">${I('lock')}</span>`)).join('')||empty('Aucune ressource publiée.')}<div class=\"lr-inline\">${actions('signup','Créer un compte','','btn primary')}${actions('login','Se connecter')}</div>`)}\nasync function invoice(id){const o=await api('invoice',{id}), methods=Object.entries(o.methods||{});dialog('Facture monAvenir',`<div class=\"lr-invoice\"><small>FACTURE · ${E(o.invoice)}</small><h2>${money(o.amount)}</h2><p>${E(o.title)}</p><span class=\"lr-pill\">${status[o.status]||o.status}</span></div>${o.status==='paid'?actions('open','Accéder à mon achat',id,'btn primary full'):o.status==='pending'?empty('Paiement déclaré. L’administration vérifie votre encaissement.'): `<form id=\"lrPay\" data-id=\"${o.id}\">${o.refusal_reason?`<p class=\"lr-error\">${E(o.refusal_reason)}</p>`:''}${field('Moyen de paiement',select('method',methods.map(([k])=>[k,k]),methods[0]?.[0]))}<div class=\"lr-pay-instructions\">${methods.map(([k,v])=>`<p><strong>${E(k)}</strong> : ${E(v)}</p>`).join('')}</div>${field('Référence de la transaction',input('reference','','required minlength=\"3\" maxlength=\"100\"'))}<p class=\"lr-empty\">Effectuez le paiement au compte indiqué, puis saisissez sa référence.</p><button class=\"btn primary full\" type=\"submit\">Déclarer mon paiement</button></form>`}${paymentFooter(methods)}`)}\nasync function join(id){const groups=await api('join_groups',{id});dialog('Rejoindre une classe',groups.map(g=>row(g.name,(g.school||'')+(g.code?' · Code : '+g.code:''),g.status==='pending'?'<span class=\"lr-pill\">En attente</span>':g.status==='approved'?'<span class=\"lr-pill\">Approuvé</span>':g.mode==='visible_code'?`<button type=\"button\" class=\"btn primary\" data-mb91=\"resource-join\" data-id=\"${E(g.id)}\" data-code=\"${E(g.code)}\">Demander</button>`:actions('request','Demander',g.id,'btn primary'))).join('')||empty('Aucune classe publique disponible. Demandez le code privé à l’enseignant.'))}\nasync function openResource(id,teacherView=false){const r=teacherView?(data.resources||[]).find(x=>x.id===id):await api('open',{id});if(!r)throw Error('Ressource introuvable');if(interactive(r.kind)){if(teacherView){dialog(r.title,r.questions.map((q,i)=>row(`${i+1}. ${q.text}`,`${q.points} pt · ${q.type}`)).join(''));return}const old=(data.attempts||[]).find(a=>a.resource_id===id);dialog(r.title,`<div class=\"lr-invoice\"><strong>${r.questions.length} questions</strong><p>${r.duration?`${r.duration} minutes · chronométré`:'Sans chronomètre'} · ${price(r)}</p></div>${actions('start',old?'Reprendre / résultat':'Commencer',id,'btn primary full')}`);return}await reader(r,teacherView)}\nasync function reader(r,teacherView){const body=dialog(r.title,'<p class=\"lr-empty\">Chargement du document…</p>',true);const result=await st.db.storage.from('mon-bac-learning').download(r.id+'/document.'+r.file_ext);if(result.error)throw Error('Document inaccessible.');const blob=result.data;if(!body.isConnected)return;const u=URL.createObjectURL(blob);urls.push(u);body.innerHTML=`<nav class=\"lr-reader-bar\"><button type=\"button\" class=\"btn\" data-reader=\"minus\">−</button><span id=\"lrPage\">Lecture</span><button type=\"button\" class=\"btn\" data-reader=\"plus\">+</button>${r.price>0&&!teacherView?`<a class=\"btn\" download=\"${E(r.title)}.${r.file_ext}\" href=\"${u}\">Télécharger</a>`:''}${r.kind==='devoir'&&!teacherView?actions('submit-work','Remettre',r.id):''}</nav><div class=\"lr-document\" id=\"lrDocument\"></div>`;const wrap=body.querySelector('#lrDocument');if(r.file_ext==='pdf'){const pdfjs=await import('./vendor/mon-bac-pdf-5.6.205.mjs');pdfjs.GlobalWorkerOptions.workerSrc=new URL('./vendor/mon-bac-pdf-worker-5.6.205.mjs',location.href).href;const pdf=await pdfjs.getDocument({data:new Uint8Array(await blob.arrayBuffer())}).promise;let p=1,zoom=1,seq=0;const nav=body.querySelector('.lr-reader-bar');nav.insertAdjacentHTML('afterbegin','<button type=\"button\" class=\"btn\" data-reader=\"prev\">‹</button><button type=\"button\" class=\"btn\" data-reader=\"next\">›</button>');async function paint(){const token=++seq,pg=await pdf.getPage(p),base=pg.getViewport({scale:1}),width=Math.max(220,wrap.clientWidth-12),vp=pg.getViewport({scale:width/base.width*zoom}),c=document.createElement('canvas'),ratio=Math.min(devicePixelRatio||1,2);c.width=vp.width*ratio;c.height=vp.height*ratio;c.style.width=vp.width+'px';c.style.height=vp.height+'px';await pg.render({canvasContext:c.getContext('2d'),viewport:vp,transform:ratio===1?null:[ratio,0,0,ratio,0,0]}).promise;if(token===seq&&wrap.isConnected){wrap.replaceChildren(c);body.querySelector('#lrPage').textContent=`${p} / ${pdf.numPages}`}}nav.addEventListener('click',e=>{switch(e.target.dataset.reader){case'prev':p=Math.max(1,p-1);break;case'next':p=Math.min(pdf.numPages,p+1);break;case'plus':zoom=Math.min(3,zoom+.25);break;case'minus':zoom=Math.max(.5,zoom-.25);break;default:return}paint().catch(e=>message(e.message))});await paint()}else if(r.file_ext==='docx'){if(!window.JSZip)await new Promise((resolve,reject)=>{const s=document.createElement('script');s.src='./vendor/jszip-3.10.1.min.js';s.onload=resolve;s.onerror=reject;document.head.append(s)});const zip=await JSZip.loadAsync(blob),xml=await zip.file('word/document.xml').async('string'),doc=new DOMParser().parseFromString(xml,'application/xml');const ns='http://schemas.openxmlformats.org/wordprocessingml/2006/main';wrap.innerHTML='<article class=\"lr-word\">'+Array.from(doc.getElementsByTagNameNS(ns,'p')).map(p=>'<p>'+E(Array.from(p.getElementsByTagNameNS(ns,'t')).map(t=>t.textContent).join(''))+'</p>').join('')+'</article>'}else{const img=document.createElement('img');img.src=u;img.alt=r.title;wrap.append(img)}if(r.file_ext!=='pdf'){let z=100;body.querySelector('.lr-reader-bar').addEventListener('click',e=>{if(['plus','minus'].includes(e.target.dataset.reader)){z=Math.max(70,Math.min(250,z+(e.target.dataset.reader==='plus'?20:-20)));wrap.firstElementChild.style.width=z+'%'}})}}\nlet run=null;\nasync function start(id){const r=await api('open',{id});run={r,a:await api('start',{id}),index:0};showQuestion()}\nfunction showQuestion(){const {r,a,index}=run;if(a.finished_at){dialog('Résultat',`<div class=\"lr-invoice\"><h2>${Number(a.score)} / ${Number(a.maximum)}</h2><p>${Math.round(100*a.score/a.maximum)} % de réussite</p></div>${a.correction.map((c,i)=>row(`${i+1}. ${r.questions[i].text}`,`${c.earned}/${c.points} pt · ${c.explanation||'Réponse : '+JSON.stringify(c.correct)}`)).join('')}`);return}const q=r.questions[index],prev=a.answers?.[index];let html='';if(['single','multi','boolean'].includes(q.type))html=q.options.map((o,i)=>`<label class=\"lr-option\"><input type=\"${q.type==='multi'?'checkbox':'radio'}\" name=\"answer\" value=\"${i}\" ${q.type==='multi'?prev?.includes?.(i)?'checked':'':prev===i?'checked':''}>${E(o)}</label>`).join('');else if(q.type==='table')html=q.options.map((o,i)=>field(o,input('answer',prev?.[i]||''))).join('');else html=field('Votre réponse',input('answer',prev??'',q.type==='number'?'inputmode=\"decimal\"':''));const body=dialog(r.title,`<div class=\"lr-progress\"><span>Question ${index+1} / ${r.questions.length}</span><strong id=\"lrTime\"></strong></div><progress value=\"${index+1}\" max=\"${r.questions.length}\"></progress><h2>${E(q.text)}</h2><form id=\"lrAnswer\">${html}${q.hint?`<details><summary>Indice</summary><p>${E(q.hint)}</p></details>`:''}<div class=\"lr-inline lr-form-actions\">${index?actions('previous','Précédent'):''}<button class=\"btn primary\" type=\"submit\">${index===r.questions.length-1?'Terminer':'Suivant'}</button></div></form>`,true);if(a.deadline){const tick=()=>{const seconds=Math.max(0,Math.ceil((new Date(a.deadline)-Date.now())/1000)),el=body.querySelector('#lrTime');if(el)el.textContent=`${Math.floor(seconds/60)}:${String(seconds%60).padStart(2,'0')}`;if(!seconds){clearInterval(timer);timer=null;api('finish',{id:r.id}).then(x=>{run.a=x;showQuestion()}).catch(e=>message(e.message))}};timer=setInterval(tick,1000);tick()}}\nasync function saveAnswer(){const q=run.r.questions[run.index],fd=new FormData($('lrAnswer'));let a=q.type==='multi'?fd.getAll('answer').map(Number):q.type==='table'?fd.getAll('answer'):fd.get('answer');if(['single','boolean'].includes(q.type))a=a===null?null:Number(a);run.a=await api('answer',{id:run.r.id,index:run.index,answer:a})}\nconst oldView=view;view=function(){if(!screens.includes(st.screen))return oldView();reset();return `<div class=\"lr-shell\"><div class=\"lr-heading\"><button type=\"button\" class=\"btn\" data-act=\"goto\" data-to=\"${st.screen.split('-')[0]}-home\">‹ Accueil</button><h1>${{ 'student-learning':'Réviser et travailler','teacher-learning':'Ressources pédagogiques','admin-learning':'Achats et paiements'}[st.screen]}</h1>${actions('refresh','Actualiser')}</div>${loading?empty('Chargement…'):error?`<p class=\"lr-error\">${E(error)}</p>${actions('refresh','Réessayer')}`:st.screen==='student-learning'?student():st.screen==='teacher-learning'?teacher():admin()}</div>`};\nconst oldGo=go;go=function(s){if(screens.includes(s)){tab='';filter='';query='';page=0;data={};catalogue=[];loading=true;const ret=oldGo(s);if(st.screen===s)load();return ret}return oldGo(s)};\nconst oldRender=render;render=function(){const v=oldRender(),app=$('app');if(!app)return v;const s=st.screen,grid=app.querySelector('.mb-tiles');if(grid&&!app.classList.contains('mb70-photo-gate')){const target={'student-home':['student-learning','Travailler','book'],'teacher-home':['teacher-learning','Ressources','book'],'admin-home':['admin-learning','Achats et paiements','credit-card']}[s];if(target&&(s!=='teacher-home'||st.teacher?.status==='approved'))grid.insertAdjacentHTML('afterbegin',`<button class=\"mb-tile lr-shortcut\" data-act=\"goto\" data-to=\"${target[0]}\">${I(target[2])}<span>${target[1]}</span></button>`)}if(s==='admin-settings'&&st.role==='admin'){app.querySelector('.screen')?.insertAdjacentHTML('afterbegin',`<div class=\"lr-settings-shortcut\">${actions('payment-settings-open','Configurer les comptes de paiement','','btn primary full')}</div>`)}if(s==='student-home'||s==='student-learning'){const b=app.querySelector('.mb72-center');if(b){delete b.dataset.mb72;b.dataset.act='goto';b.dataset.to='student-learning'}}if(s==='welcome'&&!st.user){const anchor=app.querySelector('.mb83-directory');anchor?.insertAdjacentHTML('afterend',`<button type=\"button\" class=\"mb83-directory lr-public\" data-lr=\"catalogue\"><span class=\"mb83-directory-icon\">${I('book')}</span><span><strong>Ressources pédagogiques</strong><small>Découvrir les activités</small></span>${I('chevron')}</button>`)}if(s==='teacher-learning'&&draft&&draftStep===0&&$('lrWizard'))for(const k of ['series','academic_level','subject','kind']){const el=$('lrWizard').elements.namedItem(k);if(el)el.value=draft[k]}if(st.role==='eleve')app.querySelectorAll('[data-mbc=\"download-exam\"]').forEach(b=>b.remove());return v};\nconst oldOut=signOut;signOut=async function(){close();owner='';data={};catalogue=[];draft=null;run=null;return oldOut()};\njoinGroup=async function(){const code=$('joinCode')?.value.trim();if(!code)throw Error('Saisissez le code de la classe.');await api('join_code',{code});try{const saved=JSON.parse(localStorage.getItem('ege2027_invitation')||'null');if(saved?.code===code.toUpperCase())localStorage.removeItem('ege2027_invitation')}catch(_){}toast('Demande envoyée. Attendez l’approbation de l’enseignant.');if(st.screen==='student-group')render()};\ndocument.addEventListener('change',e=>{if(e.target.matches('[data-lr-filter]')){filter=e.target.value;page=0;render()}if(['series','academic_level','subject'].includes(e.target.name)&&$('lrWizard')&&draftStep===0){capture();draft[e.target.name]=e.target.value;if(e.target.name!=='subject')draft.subject='';render();return}if(e.target.name==='audience'&&$('lrWizard')){draft.audience=e.target.value;$('lrRecipients').innerHTML=recipients(draft)}if(e.target.name==='file'&&$('lrWizard'))capture()});\ndocument.addEventListener('input',e=>{if(e.target.matches('[data-lr-query]')){query=e.target.value;page=0;const list=$('lrList');if(list){const parent=document.createElement('div');parent.innerHTML=st.screen==='student-learning'?student():teacher();list.innerHTML=parent.querySelector('#lrList')?.innerHTML||''}}});\ndocument.addEventListener('click',async e=>{const b=e.target.closest?.('[data-lr]');if(!b||b.disabled)return;const a=b.dataset.lr,id=b.dataset.id;try{if(a==='payment-settings-open'){go('admin-learning');tab='accounts';settingsNotice='';render();return}if(a==='request-specialty'){capture();b.disabled=true;try{await api('request_specialty',{series:draft.series,academic_level:draft.academic_level,subject:draft.subject});await load()}finally{b.disabled=false}return}if(a==='close'){close();return}if(a==='tab'){if($('lrWizard'))capture();tab=id;settingsNotice='';page=0;query='';filter='';if(['add','qcm'].includes(tab)&&(!draft||interactive(draft.kind)!==(tab==='qcm')))newDraft(tab==='qcm');render();return}if(a==='page'){page=Math.max(0,page+Number(id));render();return}if(a==='refresh'){await load();return}if(a==='catalogue'){await publicCatalogue();return}if(a==='signup'||a==='login'){close();st.desired='eleve';st.mode=a==='signup'?'signup':'login';st.screen='auth';render();return}if(a==='interactive-open'){if(!window.MonBacInteractive?.openExercise)throw Error('Exercices interactifs indisponibles');await window.MonBacInteractive.openExercise(id);return}if(a==='open'||a==='teacher-open'){await openResource(id,a==='teacher-open');return}if(a==='invoice'){await invoice(id);return}if(a==='join'){await join(id);return}if(a==='request'){await api('request_join',{id});close();toast('Demande envoyée.');await load();return}if(['approve','refuse','archive','publish'].includes(a)){if(a==='archive'&&!await window.MBDialog.confirm('Archiver cette ressource ?'))return;await api({approve:'approve_join',refuse:'refuse_join',archive:'archive',publish:'publish'}[a],{id});await load();return}if(a==='wizard-back'){capture();draftStep--;render();return}if(['question-add','question-prev','question-next'].includes(a)){saveQuestion();qEdit=a==='question-add'?draft.questions.length:qEdit+(a==='question-prev'?-1:1);render();return}if(a==='start'){await start(id);return}if(a==='previous'){await saveAnswer();if(!run.a.finished_at)run.index--;showQuestion();return}if(a==='my-results'||a==='results'){const rows=a==='my-results'?(data.attempts||[]).filter(x=>x.finished_at):data.results||[];dialog('Résultats',rows.map(x=>row(x.title,`${x.student_name||x.subject||''} · ${x.score}/${x.maximum}`)).join('')||empty('Aucun résultat.'));return}if(a==='earnings'){dialog('Revenus',(data.orders||[]).map(o=>row(o.title,`${money(o.amount-o.commission)} · ${o.payout_at?'Reversé':'En attente de reversement'}`)).join('')||empty('Aucune vente.'));return}if(a==='works'){dialog('Devoirs reçus',(data.submissions||[]).map(w=>row(w.student_name,w.title,`<button type=\"button\" class=\"btn\" data-lr=\"review-work\" data-id=\"${w.resource_id}\" data-student=\"${w.student_id}\">Corriger</button>`)).join('')||empty('Aucun devoir remis.'));return}if(a==='review-work'){const w=(data.submissions||[]).find(x=>x.resource_id===id&&x.student_id===b.dataset.student);if(!w)return;const res=await st.db.storage.from('mon-bac-learning').download(id+'/'+w.student_id+'/travail.'+w.file_ext);if(res.error)throw res.error;const body=dialog('Corriger le devoir',`<form id=\"lrReview\" data-id=\"${id}\" data-student=\"${w.student_id}\">${field('Note / 20',input('grade',w.grade??'','type=\"number\" min=\"0\" max=\"20\" step=\"0.25\" required'))}${field('Commentaire',input('feedback',w.feedback||''))}<button type=\"submit\" class=\"btn primary\">Enregistrer</button></form>`);const u=URL.createObjectURL(res.data);urls.push(u);body.insertAdjacentHTML('afterbegin',`<a class=\"btn\" href=\"${u}\" target=\"_blank\" rel=\"noopener\">Consulter le travail remis</a>`);return}if(a==='submit-work'){dialog('Remettre mon devoir',`<form id=\"lrWork\" data-id=\"${id}\">${field('PDF ou photo',`<input class=\"input\" required type=\"file\" name=\"file\" accept=\".pdf,.png,.jpg,.jpeg,.webp\">`)}<button class=\"btn primary full\" type=\"submit\">Remettre</button></form>`);return}if(a==='admin-order'){const o=(data.orders||[]).find(x=>x.id===id);if(!o)return;dialog('Encaissement',`<div class=\"lr-invoice\"><small>${E(o.invoice)}</small><h2>${money(o.amount)}</h2><p>${E(o.student_name)} · ${E(o.teacher_name)}</p><p>${E(o.method||'')} · ${E(o.transaction_ref||'')}</p><p>Commission : ${money(o.commission)} · À reverser : ${money(o.amount-o.commission)}</p></div>${o.status==='pending'?`<form id=\"lrConfirm\" data-id=\"${id}\"><label class=\"lr-option\"><input type=\"checkbox\" name=\"verified\" required> J’ai vérifié l’encaissement réel sur le compte de la plateforme.</label><button class=\"btn primary full\" type=\"submit\">Confirmer le paiement</button></form>${actions('refuse-payment','Refuser',id)}`:o.payout_at?empty('Reversement enregistré le '+date(o.payout_at)):`<form id=\"lrPayout\" data-id=\"${id}\">${field('Référence du reversement effectué',input('reference','','required minlength=\"3\"'))}<button class=\"btn primary\" type=\"submit\">Enregistrer le reversement</button></form>`}`);return}if(a==='refuse-payment'){const reason=await window.MBDialog.prompt('Motif du refus');if(reason===null)return;await api('refuse_payment',{id,reason});close();await load()}}catch(err){message(err.message||'Opération impossible.')}});\ndocument.addEventListener('submit',async e=>{const f=e.target;if(!['lrWizard','lrSettings','lrPaymentSettings','lrPay','lrConfirm','lrPayout','lrAnswer','lrWork','lrReview'].includes(f.id))return;e.preventDefault();e.stopImmediatePropagation();const btn=f.querySelector('[type=\"submit\"]');if(btn)btn.disabled=true;try{const fd=new FormData(f),id=f.dataset.id;if(f.id==='lrWizard'){capture();if(draftStep===0){if(!draft.title.trim()||!draft.series||!draft.academic_level||!draft.subject)throw Error('Indiquez le titre, la série, le niveau et la matière.');if(!specialty(draft)?.approved)throw Error('Demandez la validation de cette spécialité avant de continuer.');draftStep++;render();return}if(draftStep===1){if(interactive(draft.kind))saveQuestion();else if(!draft.file)throw Error('Importez un document.');draftStep++;render();return}if(draft.audience!=='classes'&&!draft.group_ids.length&&!draft.student_ids.length)throw Error('Choisissez les destinataires.');const ext=draft.file?.name.split('.').pop().toLowerCase().replace('jpeg','jpg')||null;if(draft.file&&draft.file.size>26214400)throw Error('Fichier trop volumineux.');if(!draft.id){const r=await api('create',{...draft,file:undefined,file_ext:ext,due_at:draft.due_at?new Date(draft.due_at).toISOString():null});draft.id=r.id}if(draft.file){const res=await st.db.storage.from('mon-bac-learning').upload(draft.id+'/document.'+ext,draft.file,{upsert:true});if(res.error)throw res.error}await api('publish',{id:draft.id});draft=null;tab='resources';toast('Ressource publiée.');await load();return}if(f.id==='lrAnswer'){await saveAnswer();if(run.a.finished_at)showQuestion();else if(run.index===run.r.questions.length-1){run.a=await api('finish',{id:run.r.id});showQuestion()}else{run.index++;showQuestion()}return}if(f.id==='lrPaymentSettings'){const methods={};for(const k of paymentMethods){const v=String(fd.get(k)||'').trim();if(v)methods[k]=v}data.settings=await api('payment_methods',{methods});settingsNotice='Comptes enregistrés avec succès.';render();return}if(f.id==='lrSettings'){data.settings=await api('tariff_settings',{commission_bp:Math.round(Number(fd.get('commission'))*100),launch_until:new Date(String(fd.get('launch'))+'T23:59:59').toISOString()});settingsNotice='Tarifs enregistrés.';render();return}if(f.id==='lrPay')await api('declare',{id,method:fd.get('method'),reference:fd.get('reference')});if(f.id==='lrConfirm')await api('confirm_payment',{id,verified:fd.get('verified')==='on'});if(f.id==='lrPayout')await api('payout',{id,reference:fd.get('reference')});if(f.id==='lrReview')await api('review_submission',{id,student:f.dataset.student,grade:Number(fd.get('grade')),feedback:fd.get('feedback')});if(f.id==='lrWork'){const file=fd.get('file'),extension=file.name.split('.').pop().toLowerCase().replace('jpeg','jpg');if(file.size>26214400)throw Error('Fichier trop volumineux.');await api('prepare_submission',{id,extension});const res=await st.db.storage.from('mon-bac-learning').upload(id+'/'+st.user.id+'/travail.'+extension,file,{upsert:true});if(res.error)throw res.error;await api('submit_work',{id})}close();toast('Enregistré.');await load()}catch(err){const p=$('lrPaymentError')||$('lrWizardError');if(p){p.hidden=false;p.textContent=err.message||'Opération impossible.'}else message(err.message||'Opération impossible.');if(btn)btn.disabled=false}},true);\nwindow.MB85={api,load};\n})();\n"],"/mon-bac-quality-20261119.css":["text/css; charset=utf-8",false,"/* monAvenir — espace de concentration, toutes matières. */\n#mbi-root{--mb-bg:#F8F7F4;--mb-ink:#24313F;--mb-blue:#E8F0FB;--mb-sage:#E5F3E8;--mb-amber:#FFF1D7;--mb-lavender:#EEE5FA;--mb-brand:#B80B38;--mb-line:#dce3e8;background:var(--mb-bg);color:var(--mb-ink);font-size:16px}\n#mbi-root .mbi-shell{max-width:880px;width:100%;height:100%;height:100dvh;min-width:0;background:var(--mb-bg)}\n#mbi-root .mbi-header{background:#fff;color:var(--mb-ink);border-bottom:1px solid var(--mb-line);padding:12px clamp(14px,4vw,30px);padding-top:max(12px,env(safe-area-inset-top));min-height:64px}\n#mbi-root .mbi-header strong{font-size:18px;line-height:1.3;overflow-wrap:anywhere}\n#mbi-root .mbi-header small{font-size:12px;color:#526577;opacity:1}\n#mbi-root .mbi-close,#mbi-root .mbi-logo{background:var(--mb-blue);color:#28486a;border:0;border-radius:12px}\n#mbi-root .mbi-main{padding:clamp(16px,4vw,32px);gap:clamp(12px,2vw,20px);overflow-x:hidden;min-width:0;scroll-padding:16px;scrollbar-width:thin}\n#mbi-root .mbi-main>*{min-width:0;max-width:100%;flex-shrink:0}\n#mbi-root h2,#mbi-root .mbi-intro h2{color:var(--mb-ink);font-size:clamp(21px,3vw,28px);line-height:1.35;letter-spacing:-.3px}\n#mbi-root p,#mbi-root .mbi-intro p,#mbi-root .mbi-situation p,#mbi-root .mbi-correct-card p{font-size:15px;line-height:1.65;color:#394c5e;overflow-wrap:anywhere}\n#mbi-root .mbi-muted,#mbi-root .mbi-item small{color:#536577;font-size:13px;line-height:1.45}\n#mbi-root .mbi-item,#mbi-root .mbi-situation,#mbi-root .mbi-question,#mbi-root .mbi-journal,#mbi-root .mbi-assign,#mbi-root .mbi-correct-card,#mbi-root .mbi-sheet{border:1px solid var(--mb-line);border-radius:16px;box-shadow:none;background:#fff}\n#mbi-root .mbi-item{padding:16px;min-height:62px;gap:12px;align-items:center;line-height:1.4}\n#mbi-root .mbi-item strong{font-size:16px;color:var(--mb-ink);overflow-wrap:anywhere}\n#mbi-root .mbi-arrow{color:#375e85}\n#mbi-root .mbi-category-chips{flex-wrap:wrap;overflow:visible;gap:8px;padding:0}\n#mbi-root .mbi-chip{white-space:normal;min-width:0;min-height:44px;font-size:13px;color:#344b63;border-color:#d9e4f2;padding:9px 12px}\n#mbi-root .mbi-chip.is-active{background:#D7E7FA;color:#234a73;border-color:#92b3d7}\n#mbi-root .mbi-overview,#mbi-root .mbi-result{background:var(--mb-sage);border:1px solid #c3ddc9;border-radius:16px;padding:18px;box-shadow:none;color:#254c35}\n#mbi-root .mbi-overview .mbi-row strong,#mbi-root .mbi-overview-numbers strong,#mbi-root .mbi-result strong,#mbi-root .mbi-stats strong{color:#28613f}\n#mbi-root .mbi-overview-numbers,#mbi-root .mbi-stats{gap:8px}\n#mbi-root .mbi-overview-numbers>div,#mbi-root .mbi-stats>div{background:#fff;border:1px solid #d8e6da;padding:13px 6px;border-radius:12px;min-width:0;overflow-wrap:anywhere}\n#mbi-root .mbi-overview-numbers small,#mbi-root .mbi-stats small{font-size:12px;color:#486050;line-height:1.4}\n#mbi-root .mbi-review-suggestions summary,#mbi-root .mbi-suggestion span{color:#28613f}\n#mbi-root .mbi-exercise-head small{font-size:13px;font-weight:700;color:#416181;line-height:1.5}\n#mbi-root .mbi-exercise-head h2{font-size:clamp(20px,3.5vw,27px);line-height:1.35}\n#mbi-root .mbi-progress{height:9px;background:#e1e7e3;border-radius:12px;flex:none}\n#mbi-root .mbi-progress i{background:#3b8960;border-radius:12px}\n#mbi-root .mbi-situation{background:var(--mb-blue);border-color:#d0e1f4;padding:16px}\n#mbi-root .mbi-situation strong{color:#2b5076;font-size:14px}\n#mbi-root .mbi-question{padding:18px;align-items:flex-start;gap:12px}\n#mbi-root .mbi-question-number{width:34px;height:34px;background:var(--mb-blue);color:#234e78;flex:none;font-size:16px;border-radius:11px}\n#mbi-root .mbi-question h2{font-size:clamp(18px,3vw,23px);line-height:1.5;min-width:0;color:var(--mb-ink);overflow-wrap:anywhere}\n#mbi-root .mbi-badge{background:var(--mb-blue);color:#244b72;font-size:12px;padding:6px 10px;max-width:min(48%,180px);line-height:1.3}\n#mbi-root .mbi-field{font-size:14px;color:var(--mb-ink);gap:8px;min-width:0}\n#mbi-root input:not([type=radio]):not([type=checkbox]),#mbi-root textarea,#mbi-root select{background:#fff;border:1px solid #a9bccc;border-radius:12px;min-height:48px;padding:12px;color:var(--mb-ink);font-size:16px;line-height:1.5}\n#mbi-root textarea{min-height:120px;max-height:none;resize:vertical}\n#mbi-root .mbi-choice{background:#fff;border:1px solid #cbd8e4;border-radius:14px;padding:14px;min-height:56px;gap:10px;line-height:1.5;cursor:pointer}\n#mbi-root .mbi-choice span:last-child{min-width:0;overflow-wrap:anywhere}\n#mbi-root .mbi-choice input,#mbi-root .mbi-group-choice input{accent-color:#356c9b;flex:none}\n#mbi-root .mbi-option-tag{background:var(--mb-blue);color:#31587d;flex:none}\n#mbi-root .mbi-choice:has(input:checked),#mbi-root .mbi-choice.mbi-true:has(input:checked),#mbi-root .mbi-choice.mbi-false:has(input:checked){background:var(--mb-blue);border-color:#527fa8;color:#24313f}\n#mbi-root .mbi-hint{background:var(--mb-amber);border:1px solid #ead4a3;padding:14px;border-radius:14px}\n#mbi-root .mbi-hint summary{color:#704a0b}\n#mbi-root .mbi-notice,#mbi-root .mbi-empty,#mbi-root .mbi-answer{background:#eef3f8;border:1px solid #d6e2ed;padding:14px;border-radius:14px;color:#314e6a}\n#mbi-root .mbi-answer strong{color:#264966}\n#mbi-root .mbi-ai{background:var(--mb-lavender);border-color:#d6c7ec;padding:15px}\n#mbi-root .mbi-feedback.mbi-good{background:var(--mb-sage);color:#285c39;border-color:#badbc3;padding:14px}\n#mbi-root .mbi-feedback.mbi-warning{background:var(--mb-amber);color:#714e17;border-color:#e7c98c;padding:14px}\n#mbi-root .mbi-error{background:#fff1f3;color:#8c1733;border:1px solid #efc6d0}\n#mbi-root .mbi-assign h3,#mbi-root .mbi-sheet-head small,#mbi-root .mbi-journal-title strong{color:#355b80}\n#mbi-root .mbi-sheet-tag,#mbi-root .mbi-sheet-calc .mbi-sheet-active th,#mbi-root .mbi-journal-date td{background:var(--mb-blue);color:#29486b}\n#mbi-root .mbi-journal-table th{background:#355675!important;color:white!important}\n#mbi-root .mbi-table-wrap{width:100%;max-width:100%;min-width:0;overflow-x:auto;overscroll-behavior-inline:contain;background:#fff;border:1px solid var(--mb-line);border-radius:12px;scrollbar-width:thin}\n#mbi-root .mbi-table th,#mbi-root .mbi-table td{padding:9px;border-color:#dce3e8;line-height:1.45;overflow-wrap:anywhere}\n#mbi-root .mbi-table th{background:#edf2f7;color:#28496b}\n#mbi-root .mbi-table input:not([type=radio]){min-height:44px;padding:8px;font-size:16px}\n#mbi-root .mbi-timer{background:var(--mb-blue);color:#244b72;border-color:#cadcf0;margin:0}\n#mbi-root .mbi-timer[data-expired=yes]{background:var(--mb-amber);color:#714e17;border-color:#e7c98c}\n#mbi-root .mbi-footer{position:relative;flex-wrap:wrap;gap:10px;padding:12px clamp(14px,4vw,30px) max(12px,env(safe-area-inset-bottom));background:#fff;border-top:1px solid var(--mb-line);box-shadow:none;min-width:0}\n#mbi-root .mbi-button{min-height:48px;border:1px solid #b9c9d9;background:#fff;color:#294968;font-size:15px;font-weight:700;border-radius:12px;padding:11px 15px;line-height:1.35;overflow-wrap:anywhere;white-space:normal}\n#mbi-root .mbi-primary{background:var(--mb-brand);border-color:var(--mb-brand);color:#fff}\n#mbi-root .mbi-footer .mbi-button{flex:1 1 112px;min-width:0;max-width:100%}\n#mbi-root button:focus-visible,#mbi-root input:focus-visible,#mbi-root select:focus-visible,#mbi-root textarea:focus-visible,#mbi-root summary:focus-visible{outline:3px solid #356c9b;outline-offset:2px}\n#mbi-root .mbi-import-image img{display:block;max-width:100%;height:auto;object-fit:contain}\n#mbi-root .mbi-import{background:var(--mb-blue);border-color:#d0e1f4}\n#mbi-root .mbi-import summary{color:#31587d}\n.lr-native-interactive{border-color:#dce3e8!important;box-shadow:none!important}\n.lr-native-interactive>.lr-symbol{background:#E8F0FB!important;color:#31587d!important}\n.lr-native-interactive>.btn{background:#B80B38!important;color:#fff!important;min-height:48px;white-space:normal;overflow-wrap:anywhere}\n@media(min-width:900px){#mbi-root .mbi-shell{height:calc(100dvh - 32px);margin:16px 0;border-radius:20px;overflow:hidden;box-shadow:0 8px 40px #24313f14}}\n@media(max-width:420px){#mbi-root .mbi-main{padding:14px;gap:13px}#mbi-root .mbi-question,#mbi-root .mbi-situation{padding:14px}#mbi-root .mbi-activity{padding:13px}#mbi-root .mbi-footer{padding-inline:12px}#mbi-root .mbi-button{padding:10px 11px;font-size:14px}#mbi-root .mbi-overview-numbers small,#mbi-root .mbi-stats small{font-size:11px}}\n@media(max-height:480px){#mbi-root .mbi-header{min-height:48px;padding-block:5px}#mbi-root .mbi-main{padding-block:10px;gap:9px}#mbi-root .mbi-footer{padding-block:6px}#mbi-root .mbi-button{min-height:44px}}\n@media(prefers-reduced-motion:reduce){#mbi-root *,#mbi-root *::before,#mbi-root *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\n\n/* monAvenir — pédagogique */\n#mbi-root .mbi-source,.lr-native-interactive .mbi-source{display:block;margin-block:4px;color:#28614a!important;font-size:12px;font-weight:650;white-space:normal;overflow-wrap:anywhere}\n#mbi-root .mbi-exercise-head .mbi-source{display:inline-block;padding:5px 9px;border-radius:8px;background:#e7f4ec;color:#245b41!important}\n#mbi-root .mbi-instructions{margin-top:10px;color:var(--mb-ink,#263343);font-size:14px}#mbi-root .mbi-instructions summary{cursor:pointer;font-weight:600;color:#31587d}\n#mbi-root .mbi-feedback{white-space:pre-line;overflow-wrap:anywhere}\n#mbi-root .mbi-notice p{overflow-wrap:anywhere}\n"],"/mon-bac-language-quality-20261119.js":["application/javascript; charset=utf-8",false,"/* monAvenir: reviewed interface labels; original educational records stay in French or their source language. */\n(()=>{\n'use strict';\nconst rows=`\nConsignes / contexte (obligatoire)|Instructions / context (required)|التعليمات / السياق (إلزامي)\nDonnez les données, le travail demandé, les unités et les arrondis.|Provide the data, task, units and rounding rules.|اذكر المعطيات والمطلوب والوحدات وقواعد التقريب.\nIndice pédagogique (obligatoire)|Learning hint (required)|تلميح تعليمي (إلزامي)\nOrientez l’élève sans donner directement la réponse.|Guide the student without revealing the answer.|وجّه الطالب دون كشف الإجابة مباشرة.\nExplication vérifiable (obligatoire)|Verifiable explanation (required)|شرح قابل للتحقق (إلزامي)\nJustifiez la réponse : formule, étapes, calcul ou source vérifiable.|Justify the answer with a formula, steps, calculation or verifiable source.|برّر الإجابة بصيغة أو خطوات أو حساب أو مصدر قابل للتحقق.\nConsigne et situation|Instructions and context|التعليمات والسياق\nConsignes complémentaires et source|Additional instructions and source|تعليمات إضافية ومصدر\nVérifier le corrigé et l’indice|Review the answer key and hint|مراجعة الإجابة النموذجية والتلميح\nIndice pour réviser|Revision hint|تلميح للمراجعة\nExplication|Explanation|الشرح\nRéponse :|Answer:|الإجابة:\nIndice :|Hint:|التلميح:\nExplication :|Explanation:|الشرح:\nVérifiez chaque énoncé, la réponse de référence, le calcul ou la justification, et l’indice avant de publier. En mode évaluation, les indices et le corrigé restent masqués jusqu’à la correction autorisée.|Review every question, model answer, calculation or justification and hint before publishing. In assessment mode, hints and answers remain hidden until correction is released.|راجع كل سؤال وإجابة نموذجية وحساب أو تبرير وتلميح قبل النشر. في وضع التقييم، تبقى التلميحات والإجابات مخفية حتى إتاحة التصحيح.\nComplétez la réponse de référence.|Complete the model answer.|أكمل الإجابة النموذجية.\nAjoutez un indice pédagogique précis.|Add a specific learning hint.|أضف تلميحًا تعليميًا محددًا.\nAjoutez une explication vérifiable : méthode, calcul ou justification.|Add a verifiable explanation: method, calculation or justification.|أضف شرحًا قابلًا للتحقق: طريقة أو حساب أو تبرير.\nIndiquez le titre, la matière et une consigne claire.|Enter the title, subject and clear instructions.|أدخل العنوان والمادة وتعليمات واضحة.\nConsigne générale obligatoire.|General instructions are required.|التعليمات العامة إلزامية.\nJe confirme avoir vérifié les consignes, chaque réponse, indice et explication (calcul, méthode ou référence). Publier pour cette série et ce niveau ?|I confirm that I have checked the instructions, each answer, hint and explanation (calculation, method or reference). Publish for this series and grade?|أؤكد أنني راجعت التعليمات وكل إجابة وتلميح وشرح (الحساب أو الطريقة أو المرجع). هل أنشر لهذه الشعبة والمستوى؟\nJe confirme avoir vérifié les consignes, chaque réponse, indice et explication (calcul, méthode ou référence). Soumettre à la validation de l’administrateur ?|I confirm that I have checked the instructions, each answer, hint and explanation (calculation, method or reference). Submit for administrator approval?|أؤكد أنني راجعت التعليمات وكل إجابة وتلميح وشرح (الحساب أو الطريقة أو المرجع). هل أرسلها لاعتماد المسؤول؟\nAccueil|Home|الرئيسية\nAccueil élève|Student home|واجهة الطالب\nAccueil enseignant|Teacher home|واجهة المعلّم\nAccueil administration|Administration home|واجهة الإدارة\nAccueil général|Main home|الرئيسية العامة\nBienvenue|Welcome|مرحبًا\nRéussir son bac,|Pass your baccalaureate,|لننجح في البكالوريا\nensemble.|together.|معًا.\nCours, révisions et accompagnement.|Lessons, revision and support.|دروس ومراجعة ومواكبة دراسية.\nSe connecter|Sign in|تسجيل الدخول\nConnexion|Sign in|تسجيل الدخول\nCréer un compte|Create an account|إنشاء حساب\nCréer mon compte|Create my account|إنشاء حسابي\nDécouvrir les cours de soutien|Explore tutoring|اكتشف دروس الدعم\nInstaller l’application|Install the app|تثبيت التطبيق\nInstaller l’App|Install the app|تثبيت التطبيق\nInstaller|Install|تثبيت\nTrouver une classe|Find a class|البحث عن صف\nChoisissez votre espace.|Choose your space.|اختر مساحتك.\nChoisissez votre espace|Choose your space|اختر مساحتك\nÉlève|Student|طالب\nÉlèves|Students|الطلاب\nEnseignant|Teacher|معلّم\nEnseignants|Teachers|المعلّمون\nAdministrateur|Administrator|مسؤول النظام\nAdministrateurs|Administrators|مسؤولو النظام\nAdministration|Administration|الإدارة\nEspace enseignant|Teacher area|مساحة المعلّم\nMon espace enseignant|My teacher area|مساحتي كمعلّم\nMon espace|My area|مساحتي\nAccéder à mon espace|Go to my area|الدخول إلى مساحتي\nE-mail ou téléphone|Email or phone|البريد الإلكتروني أو الهاتف\nVotre e-mail ou numéro|Your email or phone number|بريدك الإلكتروني أو رقم هاتفك\nAdresse e-mail|Email address|البريد الإلكتروني\nE-mail|Email|البريد الإلكتروني\nTéléphone|Phone|الهاتف\nNuméro de téléphone|Phone number|رقم الهاتف\nMot de passe|Password|كلمة المرور\nVotre mot de passe